# Limen grammar in GBNF (llama.cpp grammar format), for constrained decoding.
#
# It follows SPEC.md section 15 at the character level, including the newline
# rules: statements are separated by a newline or `;`; inside brackets and
# after a binary operator a newline is free; a line may start with `.` to
# continue a method chain (also `?.`) or with `|>` to continue a pipeline; a line may not
# start with another binary operator, `(`, `[` or `?` that belongs to the
# previous line.
#
# It accepts a slight superset of Limen: keywords are not excluded from
# identifiers, types are not checked, integer literals may exceed 64 bits, and
# the right side of `|>` may be any operand (the parser wants a call or a
# function). It requires at least one space or
# tab after a keyword (`if x`, not `if(x)`), which is the canonical style.

root ::= ws (top ws)*

# ---------- whitespace ----------
comment ::= "//" [^\n]*
sp      ::= ([ \t\r] | comment)*
sp1     ::= [ \t]+ sp
ws      ::= ([ \t\r\n] | comment)*
# separator inside brackets: a comma, or a newline
isep    ::= ws "," ws | sp "\n" ws
# separator between statements
stsep   ::= sp (";" | "\n") ws

# ---------- items ----------
top      ::= use | "pub" sp1 (fn | struct | enum | interface | alias) | item | foreign
use      ::= "use" sp1 ident
item     ::= fn | struct | enum | test | bench | interface | alias
# another name for a type: `type Pair[T] = (T, T)`
alias    ::= "type" sp1 ident sp generics? sp "=" sp type
interface ::= "interface" sp1 ident sp generics? sp "{" ws (imethod (isep imethod)* (ws ",")?)? ws "}"
imethod  ::= "fn" sp1 ident sp "(" ws "self" (isep param)* (ws ",")? ws ")" (sp "->" sp type)?
test     ::= "test" sp1 plainstr sp tparams? ("for" sp1 (ident sp1 | upat sp) "in" sp1 "[" ws args ws "]" sp)? block
bench    ::= "bench" sp1 plainstr sp tparams? block
tparams  ::= "(" ws (tparam (isep tparam)* (ws ",")?)? ws ")" sp
# `clock: virtual Clock`: a clock on virtual time
tparam   ::= param | ident sp ":" sp "virtual" sp1 "Clock"
fn       ::= "fn" sp1 ident sp bgenerics? sp "(" ws (param (isep param)* (ws ",")?)? ws ")" (sp "->" sp type)? sp block
# C functions from a library: signatures only, one per line, and C structs.
# `...` makes a function variadic; `= "name"` names the C function;
# `blocking fn` runs the call off the task's thread.
foreign  ::= "foreign" sp1 plainstr sp "{" ws (fitem (stsep fitem)* stsep?)? ws "}"
fitem    ::= ("pub" sp1)? (("blocking" sp1)? ffn | fstruct)
ffn      ::= "fn" sp1 ident sp "(" ws fparams? ws ")" (sp "->" sp type)? (sp "=" sp plainstr)?
fparams  ::= (param isep)* "..." (isep param)* (ws ",")? | param (isep param)* (ws ",")?
fstruct  ::= "struct" sp1 ident sp "{" ws (param (isep param)* (ws ",")?)? ws "}"
generics ::= "[" ws ident (isep ident)* (ws ",")? ws "]"
bgenerics ::= "[" ws bgen (isep bgen)* (ws ",")? ws "]"
bgen     ::= ident (sp ":" sp bound (sp "+" sp bound)*)?
# an interface, with its type arguments if it is generic: `Shape`, `geo.Area`, `Container[Int]`
bound    ::= ident ("." ident)? (sp "[" ws typearg (isep typearg)* (ws ",")? ws "]")?
param    ::= ident sp ":" sp type
struct   ::= "struct" sp1 ident sp bgenerics? sp "{" ws (field (isep field)* (ws ",")?)? ws "}"
field    ::= ident sp ":" sp type | embed
# an embedded struct: its type alone, starting with a capital (`User`, `auth.User`, `Box[Int]`)
embed    ::= (ident ".")? upper (sp "[" ws typearg (isep typearg)* (ws ",")? ws "]")?
enum     ::= "enum" sp1 ident sp bgenerics? sp "{" ws (variant (isep variant)* (ws ",")?)? ws "}"
variant  ::= ident (sp "(" ws type (isep type)* (ws ",")? ws ")")?

# ---------- types ----------
type    ::= "dyn" sp1 bound | ident ("." ident)? (sp "[" ws typearg (isep typearg)* (ws ",")? ws "]")? | "(" ws ")" | "(" ws type (isep type)* (ws ",")? ws ")" | "fn" sp "(" ws (type (isep type)* (ws ",")?)? ws ")" (sp "->" sp type)?
typearg ::= type | int

# ---------- blocks and statements ----------
block ::= "{" ws (stmt (stsep stmt)* (sp ";")?)? ws "}"
stmt  ::= let | return | while | for | defer | "break" | "continue" | expr (sp "=" ws expr)?
# `defer` takes a block, or one statement other than `let`
defer  ::= "defer" sp1 (block | return | while | for | "break" | "continue" | expr (sp "=" ws expr)?)
let    ::= "let" sp1 ("mut" sp1)? (ident sp (":" sp type sp)? | upat sp) "=" ws expr
tpat   ::= "(" ws pattern (isep pattern)* (ws ",")? ws ")"
# unpacking in `let` and `for`: names, `_` and nested tuples only
upat   ::= "(" ws (ident | upat) (isep (ident | upat))* (ws ",")? ws ")"
return ::= "return" (sp1 expr)?
while  ::= "while" sp1 expr sp block
for    ::= "for" sp1 (ident sp1 | upat sp) "in" sp1 expr sp block

# ---------- expressions ----------
# `|>` may also start a line, to continue a pipeline
expr    ::= unary (sp binop ws unary | ws "|>" ws unary)*
binop   ::= "??" | "||" | "&&" | "==" | "!=" | "<=" | ">=" | "<" | ">" | "..<" | "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" | "<<" | ">>"
unary   ::= ("-" | "!" | "~") sp unary | postfix
postfix ::= primary suffix*
# `?.` is safe navigation (a line may start with it, as with `.`)
suffix  ::= sp "(" ws args? ws ")" (sp tclosure)? | sp tclosure | sp "[" ws expr ws "]" | ws "." sp ident | "." [0-9]+ | ws "?." sp ident | "?." [0-9]+ | sp "?" (sp string)?
args    ::= arg (isep arg)* (ws ",")?
exprs   ::= expr (isep expr)* (ws ",")?
# a named argument: `retries: 3`
arg     ::= (ident sp ":" ws)? expr

primary ::= float | int | string | ident | structlit | withlit | "(" ws ")" | "(" ws expr ws ")" | "(" ws expr (isep expr)+ (ws ",")? ws ")" | "[" ws exprs? ws "]" | block | if | match | select | closure | group
structlit ::= (ident ".")? upper sp "{" ws (init (isep init)* (ws ",")?)? ws "}"
init      ::= ident (sp ":" ws expr)?
# a copy of a struct with fields replaced: `{ p with x: 1 }`; `with` is on the base's line
withlit   ::= "{" ws expr sp1 "with" (sp1 | sp "\n" ws) init (isep init)* (ws ",")? ws "}"
if        ::= "if" sp1 expr sp block (ws "else" (sp block | sp1 if))?
match     ::= "match" sp1 expr sp "{" ws (arm (isep arm)* (ws ",")?)? ws "}"
select    ::= "select" sp "{" ws (selarm (isep selarm)* (ws ",")?)? ws "}"
selarm    ::= (ident sp "=" ws expr | expr) (sp1 "if" sp1 expr)? sp "=>" ws expr
arm       ::= pattern (sp1 "if" sp1 expr)? sp "=>" ws expr
closure   ::= "|" ws (cparam (isep cparam)* ws)? "|" ws expr | "||" ws expr
cparam    ::= ident (sp ":" sp type)?
# a trailing closure, `f(a) { |x| ... }`; the grammar does not keep it out
# of `if`/`while`/`for`/`match` heads as the parser does
tclosure  ::= "{" ws ("|" ws (cparam (isep cparam)* ws)? "|" ws | "||" ws)? (stmt (stsep stmt)* (sp ";")?)? ws "}"
group     ::= "group" sp1 ident (sp1 "interleaved")? (sp1 "until" sp1 expr)? sp block

# `A | B`: an or-pattern; `..` (once per bracket, `..name` in a list) is the rest;
# `p as name` names the whole value
pattern ::= palt (ws "|" ws palt)* (sp1 "as" sp1 asname)?
# the name `as` gives: any name but `_`
asname  ::= [A-Za-z] [A-Za-z0-9_]* | "_" [A-Za-z0-9_]+
palt    ::= "-"? int | plainstr | ident ("." ident)? (sp "(" ws pitems ws ")")? | spat | "(" ws pitems ws ")" | "[" ws pitems? ws "]"
pitems  ::= pitem (isep pitem)* (ws ",")?
pitem   ::= pattern | ".." (sp ident)?
# a struct pattern: `Point { x, y: 0, .. }`, with `..` last
spat    ::= (ident ".")? upper sp "{" ws (fpat (isep fpat)* (isep "..")? (ws ",")? | ".." (ws ",")?)? ws "}"
fpat    ::= ident (sp ":" ws pattern)?

# ---------- tokens ----------
ident  ::= [A-Za-z_] [A-Za-z0-9_]*
upper  ::= [A-Z] [A-Za-z0-9_]*
int    ::= [0-9] [0-9_]*
float  ::= [0-9] [0-9_]* ("." [0-9] [0-9_]* exp? | exp)
exp    ::= [eE] [+-]? [0-9]+
string ::= mlstr | "\"" (strchar | escape | interp)* "\""
# a multi-line string: three quotes ending their line, lines of text, and
# three quotes on a line of their own (the grammar does not check that every
# line is indented at least as far as the closing line)
mlstr   ::= "\"\"\"" [ \t\r]* "\n" mlline* [ \t]* "\"\"\""
mlline  ::= [ \t]* (mlfirst mlchar* | "\"" | "\"\"")? "\n"
mlfirst ::= [^ \t\n"\\{] | escape | interp | mljoin | "\"" mlnq | "\"\"" mlnq
mlnq    ::= [^"\n\\{] | escape | interp | mljoin
mlchar  ::= [^\n\\{] | escape | interp | mljoin
# a line ending in a backslash goes on with the next one
mljoin  ::= "\\" "\r"? "\n"
plainstr ::= mlplain | "\"" (strchar | escape)* "\""
mlplain  ::= "\"\"\"" [ \t\r]* "\n" mlpline* [ \t]* "\"\"\""
mlpline  ::= [ \t]* (mlpfirst mlpchar* | "\"" | "\"\"")? "\n"
mlpfirst ::= [^ \t\n"\\{] | escape | mljoin | "\"" mlpnq | "\"\"" mlpnq
mlpnq    ::= [^"\n\\{] | escape | mljoin
mlpchar  ::= [^\n\\{] | escape | mljoin
strchar ::= [^"\\{]
escape  ::= "\\" [ntr\\"{}0]
interp  ::= "{" ws expr ws "}"
