; `dune test` also checks that the GBNF grammar accepts every example and
; benchmark, and accepts or rejects the hand-written cases as labelled.
(rule
 (alias runtest)
 (deps
  limen.gbnf
  gbnf_check.py
  (glob_files tests/accept/*.lmn)
  (glob_files tests/reject/*.lmn)
  (glob_files %{project_root}/examples/*.lmn)
  (glob_files %{project_root}/bench/*.lmn))
 (action
  (system
   "python3 gbnf_check.py limen.gbnf tests/accept/*.lmn ../examples/*.lmn ../bench/*.lmn --reject tests/reject/*.lmn")))
