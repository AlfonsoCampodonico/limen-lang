; `dune test` also checks that the GBNF grammar accepts every example and
; benchmark, and accepts or rejects the hand-written cases as labelled.
(rule
 (alias runtest)
 (deps
  tessera.gbnf
  gbnf_check.py
  (glob_files tests/accept/*.tsr)
  (glob_files tests/reject/*.tsr)
  (glob_files %{project_root}/examples/*.tsr)
  (glob_files %{project_root}/bench/*.tsr))
 (action
  (system
   "python3 gbnf_check.py tessera.gbnf tests/accept/*.tsr ../examples/*.tsr ../bench/*.tsr --reject tests/reject/*.tsr")))
