; `dune test` also checks that the GBNF grammar accepts every example and
; benchmark, and accepts or rejects the hand-written cases as labelled.
(rule
 (alias runtest)
 (deps
  vela.gbnf
  gbnf_check.py
  (glob_files tests/accept/*.vela)
  (glob_files tests/reject/*.vela)
  (glob_files %{project_root}/examples/*.vela)
  (glob_files %{project_root}/bench/*.vela))
 (action
  (system
   "python3 gbnf_check.py vela.gbnf tests/accept/*.vela ../examples/*.vela ../bench/*.vela --reject tests/reject/*.vela")))
