# Vela grammar in GBNF (llama.cpp grammar format), for constrained decoding.
#
# It follows SPEC.md section 15 at the character level, including the newline
# rules: statements are separated by a newline or `;`; inside brackets and
# after a binary operator a newline is free; a line may start with `.` to
# continue a method chain; a line may not start with a binary operator, `(`,
# `[` or `?` that belongs to the previous line.
#
# It accepts a slight superset of Vela: keywords are not excluded from
# identifiers, types are not checked, and integer literals may exceed 64 bits. It requires at least one space or
# tab after a keyword (`if x`, not `if(x)`), which is the canonical style.

root ::= ws (top ws)*

# ---------- whitespace ----------
comment ::= "//" [^\n]*
sp      ::= ([ \t\r] | comment)*
sp1     ::= [ \t]+ sp
ws      ::= ([ \t\r\n] | comment)*
# separator inside brackets: a comma, or a newline
isep    ::= ws "," ws | sp "\n" ws
# separator between statements
stsep   ::= sp (";" | "\n") ws

# ---------- items ----------
top      ::= use | "pub" sp1 (fn | struct | enum | interface) | item
use      ::= "use" sp1 ident
item     ::= fn | struct | enum | test | interface
interface ::= "interface" sp1 ident sp "{" ws (imethod (isep imethod)* (ws ",")?)? ws "}"
imethod  ::= "fn" sp1 ident sp "(" ws "self" (isep param)* (ws ",")? ws ")" (sp "->" sp type)?
test     ::= "test" sp1 plainstr sp block
fn       ::= "fn" sp1 ident sp bgenerics? sp "(" ws (param (isep param)* (ws ",")?)? ws ")" (sp "->" sp type)? sp block
generics ::= "[" ws ident (isep ident)* (ws ",")? ws "]"
bgenerics ::= "[" ws bgen (isep bgen)* (ws ",")? ws "]"
bgen     ::= ident (sp ":" sp qident (sp "+" sp qident)*)?
qident   ::= ident ("." ident)?
param    ::= ident sp ":" sp type
struct   ::= "struct" sp1 ident sp generics? sp "{" ws (field (isep field)* (ws ",")?)? ws "}"
field    ::= ident sp ":" sp type
enum     ::= "enum" sp1 ident sp generics? sp "{" ws (variant (isep variant)* (ws ",")?)? ws "}"
variant  ::= ident (sp "(" ws type (isep type)* (ws ",")? ws ")")?

# ---------- types ----------
type    ::= "dyn" sp1 qident | ident ("." ident)? (sp "[" ws typearg (isep typearg)* (ws ",")? ws "]")? | "(" ws ")" | "(" ws type (isep type)* (ws ",")? ws ")" | "fn" sp "(" ws (type (isep type)* (ws ",")?)? ws ")" sp "->" sp type
typearg ::= type | int

# ---------- blocks and statements ----------
block ::= "{" ws (stmt (stsep stmt)* (sp ";")?)? ws "}"
stmt  ::= let | return | while | for | "break" | "continue" | expr (sp "=" ws expr)?
let    ::= "let" sp1 ("mut" sp1)? (ident sp (":" sp type sp)? | upat sp) "=" ws expr
tpat   ::= "(" ws pattern (isep pattern)* (ws ",")? ws ")"
# unpacking in `let` and `for`: names, `_` and nested tuples only
upat   ::= "(" ws (ident | upat) (isep (ident | upat))* (ws ",")? ws ")"
return ::= "return" (sp1 expr)?
while  ::= "while" sp1 expr sp block
for    ::= "for" sp1 (ident sp1 | upat sp) "in" sp1 expr sp block

# ---------- expressions ----------
expr    ::= unary (sp binop ws unary)*
binop   ::= "??" | "||" | "&&" | "==" | "!=" | "<=" | ">=" | "<" | ">" | "+" | "-" | "*" | "/" | "%"
unary   ::= ("-" | "!") sp unary | postfix
postfix ::= primary suffix*
suffix  ::= sp "(" ws args? ws ")" | sp "[" ws expr ws "]" | ws "." sp ident | "." [0-9]+ | sp "?"
args    ::= expr (isep expr)* (ws ",")?

primary ::= float | int | string | ident | structlit | "(" ws ")" | "(" ws expr ws ")" | "(" ws expr (isep expr)+ (ws ",")? ws ")" | "[" ws args? ws "]" | block | if | match | select | closure | group
structlit ::= (ident ".")? upper sp "{" ws (init (isep init)* (ws ",")?)? ws "}"
init      ::= ident (sp ":" ws expr)?
if        ::= "if" sp1 expr sp block (ws "else" (sp block | sp1 if))?
match     ::= "match" sp1 expr sp "{" ws (arm (isep arm)* (ws ",")?)? ws "}"
select    ::= "select" sp "{" ws (selarm (isep selarm)* (ws ",")?)? ws "}"
selarm    ::= (ident sp "=" ws expr | expr) (sp1 "if" sp1 expr)? sp "=>" ws expr
arm       ::= pattern sp "=>" ws expr
closure   ::= "|" ws (cparam (isep cparam)* ws)? "|" ws expr | "||" ws expr
cparam    ::= ident (sp ":" sp type)?
group     ::= "group" sp1 ident (sp1 "until" sp1 expr)? sp block

pattern ::= "-"? int | plainstr | ident ("." ident)? (sp "(" ws pattern (isep pattern)* (ws ",")? ws ")")? | tpat

# ---------- tokens ----------
ident  ::= [A-Za-z_] [A-Za-z0-9_]*
upper  ::= [A-Z] [A-Za-z0-9_]*
int    ::= [0-9] [0-9_]*
float  ::= [0-9] [0-9_]* ("." [0-9] [0-9_]* exp? | exp)
exp    ::= [eE] [+-]? [0-9]+
string ::= "\"" (strchar | escape | interp)* "\""
plainstr ::= "\"" (strchar | escape)* "\""
strchar ::= [^"\\{]
escape  ::= "\\" [ntr\\"{}0]
interp  ::= "{" ws expr ws "}"
