// CSV (RFC 4180): rows of fields separated by commas. A field may be
// quoted with `"`, and then hold commas, line breaks and quotes, each
// quote written twice. Lines end in `\n` or `\r\n`.
//
// Reading is a little more lenient than the RFC: rows may have different
// numbers of fields (`parse_maps` checks them against the header), blank
// lines are skipped, and a UTF-8 byte order mark at the start is ignored.
// Errors name the line, counting lines inside quoted fields:
// `csv: line 3: a quoted field is not closed`.

// The rows of `text`, each a list of fields:
// `parse("a,b\n1,\"x, y\"\n")` is `Ok([["a", "b"], ["1", "x, y"]])`.
pub fn parse(text: Str) -> Result[List[List[Str]], Str] {
    parse_with(text, ",")
}

// The rows of `text` with fields separated by `sep`, one byte other than a
// quote or a line break: `"\t"` for TSV, `";"` where commas are decimal
// points.
pub fn parse_with(text: Str, sep: Str) -> Result[List[List[Str]], Str] {
    let rs = records(text, sep)?
    Ok(rs.map(|r| r.1))
}

// The rows of `text` after the first, which names the fields: each row as
// a map from those names to its fields, in the header's order. A row with
// a different number of fields than the header, or a header naming a field
// twice, is an error.
pub fn parse_maps(text: Str) -> Result[List[Map[Str, Str]], Str] {
    let rs = records(text, ",")?
    let mut out: List[Map[Str, Str]] = []
    match rs {
        [] => Ok(out),
        [(line, header), ..rest] => {
            let mut seen: Map[Str, Bool] = map()
            for name in header {
                if seen.contains(name) {
                    return Err("csv: line {line}: the header names `{name}` twice")
                }
                seen[name] = true
            }
            for (at, fields) in rest {
                if fields.len() != header.len() {
                    return Err("csv: line {at}: {count(fields.len())}, but the header has {header.len()}")
                }
                let mut m: Map[Str, Str] = map()
                for (i, name) in header.with_index() {
                    m[name] = fields[i]
                }
                out.push(m)
            }
            Ok(out)
        },
    }
}

fn count(n: Int) -> Str {
    if n == 1 { "1 field" } else { "{n} fields" }
}

// `rows` as CSV text, one line per row, each ending in `\n`. Fields are
// quoted only when they need it.
pub fn write(rows: List[List[Str]]) -> Str {
    write_with(rows, ",")
}

// `rows` as text with fields separated by `sep`.
pub fn write_with(rows: List[List[Str]], sep: Str) -> Str {
    rows.map(|r| line(r, sep) + "\n").join("")
}

// A header line naming `header`, then one line per map with its values in
// that order; a name the map lacks is an empty field.
pub fn write_maps(header: List[Str], rows: List[Map[Str, Str]]) -> Str {
    line(header, ",") + "\n" + rows.map(|m| line(header.map(|h| m.get(h) ?? ""), ",") + "\n").join("")
}

// `field` as it goes in a comma-separated line: in quotes, with its quotes
// doubled, if it holds a comma, a quote or a line break; otherwise as is.
pub fn escape(field: Str) -> Str {
    escape_with(field, ",")
}

fn escape_with(field: Str, sep: Str) -> Str {
    if field.contains(sep) || field.contains("\"") || field.contains("\n") || field.contains("\r") {
        "\"" + field.replace("\"", "\"\"") + "\""
    } else {
        field
    }
}

fn line(fields: List[Str], sep: Str) -> Str {
    match fields {
        // a lone empty field would be a blank line, which reading skips
        [""] => "\"\"",
        _ => fields.map(|f| escape_with(f, sep)).join(sep),
    }
}

// ---------- reading ----------

// Each row with the line it starts on.
fn records(text: Str, sep: Str) -> Result[List[(Int, List[Str])], Str] {
    let sb = sep.bytes()
    if sb.len() != 1 || sb[0] == 34 || sb[0] == 10 || sb[0] == 13 {
        return Err("csv: the separator must be one byte other than a quote or a line break, not `{sep}`")
    }
    let d = sb[0]
    let bs = text.bytes()
    let n = bs.len()
    let mut i = if n >= 3 && bs[0] == 239 && bs[1] == 187 && bs[2] == 191 { 3 } else { 0 }
    let mut line = 1
    let mut rows: List[(Int, List[Str])] = []
    while i < n {
        let b = bs[i]
        if b == 10 {
            // a blank line
            i = i + 1
            line = line + 1
        } else if b == 13 && i + 1 < n && bs[i + 1] == 10 {
            i = i + 2
            line = line + 1
        } else {
            let start = line
            let mut row: List[Str] = []
            let mut more = true
            while more {
                // a field starts at i
                if i < n && bs[i] == 34 {
                    let open = line
                    let mut field = ""
                    let mut from = i + 1
                    let mut j = i + 1
                    let mut closed = false
                    while !closed {
                        if j >= n {
                            return Err("csv: line {open}: a quoted field is not closed")
                        }
                        let c = bs[j]
                        if c == 34 {
                            if j + 1 < n && bs[j + 1] == 34 {
                                field = field + text.slice(from, j + 1)
                                j = j + 2
                                from = j
                            } else {
                                field = field + text.slice(from, j)
                                j = j + 1
                                closed = true
                            }
                        } else {
                            if c == 10 {
                                line = line + 1
                            }
                            j = j + 1
                        }
                    }
                    i = j
                    if i < n && bs[i] != d && bs[i] != 10 && !(bs[i] == 13 && i + 1 < n && bs[i + 1] == 10) {
                        return Err("csv: line {line}: `{sep}` or a line break must follow a closing quote")
                    }
                    row.push(field)
                } else {
                    let from = i
                    while i < n && bs[i] != d && bs[i] != 10 && !(bs[i] == 13 && i + 1 < n && bs[i + 1] == 10) {
                        if bs[i] == 34 {
                            return Err("csv: line {line}: a quote inside an unquoted field; quote the whole field and double the quote")
                        }
                        i = i + 1
                    }
                    row.push(text.slice(from, i))
                }
                // after a field: a separator, the end of the line, or the end
                if i >= n {
                    more = false
                } else if bs[i] == d {
                    i = i + 1
                } else {
                    i = i + if bs[i] == 13 { 2 } else { 1 }
                    line = line + 1
                    more = false
                }
            }
            rows.push((start, row))
        }
    }
    Ok(rows)
}
