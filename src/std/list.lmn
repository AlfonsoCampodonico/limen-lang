// Lists: sorting with your own order, searching, ranges, insert and remove.

// The items in the order given by `less`, which says whether its first
// argument goes before its second. Stable: equal items keep their order.
pub fn sort_by[T](xs: List[T], less: fn(T, T) -> Bool) -> List[T] {
    let n = xs.len()
    if n < 2 {
        return xs
    }
    let mut a = xs
    let mut width = 1
    while width < n {
        let mut out = []
        let mut lo = 0
        while lo < n {
            let mid = (lo + width).min(n)
            let hi = (lo + 2 * width).min(n)
            let mut i = lo
            let mut j = mid
            while i < mid && j < hi {
                if less(a[j], a[i]) {
                    out.push(a[j])
                    j = j + 1
                } else {
                    out.push(a[i])
                    i = i + 1
                }
            }
            while i < mid {
                out.push(a[i])
                i = i + 1
            }
            while j < hi {
                out.push(a[j])
                j = j + 1
            }
            lo = hi
        }
        a = out
        width = width * 2
    }
    a
}

// The position of the first item equal to `x`.
pub fn index_of[T](xs: List[T], x: T) -> Option[Int] {
    let mut i = 0
    while i < xs.len() {
        if xs[i] == x {
            return Some(i)
        }
        i = i + 1
    }
    None
}

// The position of the first item for which `pred` is true.
pub fn find_index[T](xs: List[T], pred: fn(T) -> Bool) -> Option[Int] {
    let mut i = 0
    while i < xs.len() {
        if pred(xs[i]) {
            return Some(i)
        }
        i = i + 1
    }
    None
}

// lo, lo + 1, ..., hi - 1.
pub fn range(lo: Int, hi: Int) -> List[Int] {
    let mut out = []
    let mut i = lo
    while i < hi {
        out.push(i)
        i = i + 1
    }
    out
}

// A copy with the item at `i` removed (unchanged if `i` is out of range).
pub fn remove_at[T](xs: List[T], i: Int) -> List[T] {
    let mut out = []
    let mut k = 0
    for x in xs {
        if k != i {
            out.push(x)
        }
        k = k + 1
    }
    out
}

// A copy with `x` inserted before position `i` (appended if `i` is past the end).
pub fn insert_at[T](xs: List[T], i: Int, x: T) -> List[T] {
    let mut out = []
    let mut k = 0
    for y in xs {
        if k == i {
            out.push(x)
        }
        out.push(y)
        k = k + 1
    }
    if i >= xs.len() || i < 0 {
        out.push(x)
    }
    out
}
