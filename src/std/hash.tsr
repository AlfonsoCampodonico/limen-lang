// Cryptographic hashes over Bytes: SHA-256 (FIPS 180-4) and HMAC-SHA-256
// (RFC 2104) for checksums, signatures and keys; SHA-1 and MD5 only for
// formats that still name them (git object ids, ETags, older protocols),
// since both are broken for security. Digests are Bytes; the `_hex`
// functions give them as lowercase hex, as checksum tools print them.
//
// A 32-bit word is an Int from 0 to 2^32 - 1, kept there with `& mask()`.

// The SHA-256 digest of `data`: 32 bytes.
pub fn sha256(data: Bytes) -> Bytes {
    let n = data.len()
    let full = n / 64
    let state = sha256_blocks([1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225], data, full)
    let last = sha256_blocks(state, padding(data, full * 64, true), if n % 64 < 56 { 1 } else { 2 })
    words_big(last)
}

// `sha256(data)` as 64 hex digits:
// `sha256_hex("abc".to_bytes())` is `"ba7816bf...f20015ad"`.
pub fn sha256_hex(data: Bytes) -> Str {
    hex(sha256(data))
}

// The HMAC-SHA-256 of `data` under `key` (RFC 2104): 32 bytes. Any key
// length works; one longer than 64 bytes is hashed first, as the RFC says.
// Compare a MAC you are given with `equal`, not `==`.
pub fn hmac_sha256(key: Bytes, data: Bytes) -> Bytes {
    hmac(Sha256, key, data)
}

// `hmac_sha256(key, data)` as 64 hex digits.
pub fn hmac_sha256_hex(key: Bytes, data: Bytes) -> Str {
    hex(hmac(Sha256, key, data))
}

// The SHA-1 digest of `data`: 20 bytes. Broken for security (collisions
// can be made); for formats that name it.
pub fn sha1(data: Bytes) -> Bytes {
    let n = data.len()
    let full = n / 64
    let state = sha1_blocks([1732584193, 4023233417, 2562383102, 271733878, 3285377520], data, full)
    let last = sha1_blocks(state, padding(data, full * 64, true), if n % 64 < 56 { 1 } else { 2 })
    words_big(last)
}

// `sha1(data)` as 40 hex digits.
pub fn sha1_hex(data: Bytes) -> Str {
    hex(sha1(data))
}

// The HMAC-SHA-1 of `data` under `key`: 20 bytes, for protocols that
// name it (TOTP, older webhooks).
pub fn hmac_sha1(key: Bytes, data: Bytes) -> Bytes {
    hmac(Sha1, key, data)
}

// The MD5 digest of `data` (RFC 1321): 16 bytes. Broken for security; for
// checksums and formats that name it.
pub fn md5(data: Bytes) -> Bytes {
    let n = data.len()
    let full = n / 64
    let state = md5_blocks([1732584193, 4023233417, 2562383102, 271733878], data, full)
    let last = md5_blocks(state, padding(data, full * 64, false), if n % 64 < 56 { 1 } else { 2 })
    let mut out: List[Int] = []
    for w in last {
        for i in 0..<4 {
            out.push(w >> (8 * i) & 255)
        }
    }
    bytes(out)
}

// `md5(data)` as 32 hex digits.
pub fn md5_hex(data: Bytes) -> Str {
    hex(md5(data))
}

// Whether `a` and `b` hold the same bytes, taking the same time wherever
// they differ, so checking a MAC or a token does not tell an attacker how
// much of a guess was right. (Their lengths are not secret.)
pub fn equal(a: Bytes, b: Bytes) -> Bool {
    if a.len() != b.len() {
        return false
    }
    let mut diff = 0
    for i in 0..<a.len() {
        diff = diff | a[i] ^ b[i]
    }
    diff == 0
}

// Bytes as lowercase hex digits.
pub fn hex(data: Bytes) -> Str {
    let d = "0123456789abcdef".bytes()
    let mut out: List[Int] = []
    for i in 0..<data.len() {
        out.push(d[data[i] >> 4])
        out.push(d[data[i] & 15])
    }
    bytes(out).to_str()
}

// ---------- HMAC ----------

enum Algo {
    Sha1,
    Sha256,
}

fn digest(algo: Algo, data: Bytes) -> Bytes {
    match algo {
        Sha1 => sha1(data),
        Sha256 => sha256(data),
    }
}

fn hmac(algo: Algo, key: Bytes, data: Bytes) -> Bytes {
    let k = if key.len() > 64 { digest(algo, key) } else { key }
    let mut inner: List[Int] = []
    let mut outer: List[Int] = []
    for i in 0..<64 {
        let b = k.get(i) ?? 0
        inner.push(b ^ 54)
        outer.push(b ^ 92)
    }
    digest(algo, bytes(outer) + digest(algo, bytes(inner) + data))
}

// ---------- the compression functions ----------

fn mask() -> Int {
    4294967295
}

fn rotr(x: Int, n: Int) -> Int {
    (x >> n | x << (32 - n)) & mask()
}

fn rotl(x: Int, n: Int) -> Int {
    (x << n | x >> (32 - n)) & mask()
}

// The last one or two blocks: the bytes of `data` from `from`, a 1 bit,
// zeros, and the length in bits as 8 bytes, big-endian for the SHAs and
// little-endian for MD5.
fn padding(data: Bytes, from: Int, big: Bool) -> Bytes {
    let mut out: List[Int] = []
    for i in from..<data.len() {
        out.push(data[i])
    }
    out.push(128)
    while out.len() % 64 != 56 {
        out.push(0)
    }
    let bits = data.len() * 8
    for i in 0..<8 {
        out.push(bits >> (8 * (if big { 7 - i } else { i })) & 255)
    }
    bytes(out)
}

// Words as bytes, high byte first.
fn words_big(ws: List[Int]) -> Bytes {
    let mut out: List[Int] = []
    for w in ws {
        out.push(w >> 24 & 255)
        out.push(w >> 16 & 255)
        out.push(w >> 8 & 255)
        out.push(w & 255)
    }
    bytes(out)
}

