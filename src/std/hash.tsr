// The state after the first `blocks` 64-byte blocks of `data`.
fn sha256_blocks(state: List[Int], data: Bytes, blocks: Int) -> List[Int] {
    let k = sha256_k()
    let m = mask()
    let mut h0 = state[0]
    let mut h1 = state[1]
    let mut h2 = state[2]
    let mut h3 = state[3]
    let mut h4 = state[4]
    let mut h5 = state[5]
    let mut h6 = state[6]
    let mut h7 = state[7]
    let mut w: List[Int] = []
    for _ in 0..<64 {
        w.push(0)
    }
    for blk in 0..<blocks {
        let at = blk * 64
        for t in 0..<16 {
            let i = at + t * 4
            w[t] = data[i] << 24 | data[i + 1] << 16 | data[i + 2] << 8 | data[i + 3]
        }
        for t in 16..<64 {
            let x = w[t - 15]
            let y = w[t - 2]
            let s0 = rotr(x, 7) ^ rotr(x, 18) ^ x >> 3
            let s1 = rotr(y, 17) ^ rotr(y, 19) ^ y >> 10
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & m
        }
        let mut a = h0
        let mut b = h1
        let mut c = h2
        let mut d = h3
        let mut e = h4
        let mut f = h5
        let mut g = h6
        let mut h = h7
        for t in 0..<64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch = e & f ^ ~e & g
            let t1 = (h + s1 + ch + k[t] + w[t]) & m
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj = a & b ^ a & c ^ b & c
            h = g
            g = f
            f = e
            e = (d + t1) & m
            d = c
            c = b
            b = a
            a = (t1 + s0 + maj) & m
        }
        h0 = (h0 + a) & m
        h1 = (h1 + b) & m
        h2 = (h2 + c) & m
        h3 = (h3 + d) & m
        h4 = (h4 + e) & m
        h5 = (h5 + f) & m
        h6 = (h6 + g) & m
        h7 = (h7 + h) & m
    }
    [h0, h1, h2, h3, h4, h5, h6, h7]
}

fn sha1_blocks(state: List[Int], data: Bytes, blocks: Int) -> List[Int] {
    let m = mask()
    let mut h0 = state[0]
    let mut h1 = state[1]
    let mut h2 = state[2]
    let mut h3 = state[3]
    let mut h4 = state[4]
    let mut w: List[Int] = []
    for _ in 0..<80 {
        w.push(0)
    }
    for blk in 0..<blocks {
        let at = blk * 64
        for t in 0..<16 {
            let i = at + t * 4
            w[t] = data[i] << 24 | data[i + 1] << 16 | data[i + 2] << 8 | data[i + 3]
        }
        for t in 16..<80 {
            w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
        }
        let mut a = h0
        let mut b = h1
        let mut c = h2
        let mut d = h3
        let mut e = h4
        for t in 0..<80 {
            let (f, k) = if t < 20 {
                (b & c | ~b & d, 1518500249)
            } else if t < 40 {
                (b ^ c ^ d, 1859775393)
            } else if t < 60 {
                (b & c | b & d | c & d, 2400959708)
            } else {
                (b ^ c ^ d, 3395469782)
            }
            let next = (rotl(a, 5) + (f & m) + e + k + w[t]) & m
            e = d
            d = c
            c = rotl(b, 30)
            b = a
            a = next
        }
        h0 = (h0 + a) & m
        h1 = (h1 + b) & m
        h2 = (h2 + c) & m
        h3 = (h3 + d) & m
        h4 = (h4 + e) & m
    }
    [h0, h1, h2, h3, h4]
}

