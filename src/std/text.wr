// Text helpers on top of the Str methods.

// `s` repeated `n` times.
pub fn repeat(s: Str, n: Int) -> Str {
    let mut out = ""
    let mut i = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    out
}

// `s` padded on the left with `fill` to at least `width` bytes.
pub fn pad_left(s: Str, width: Int, fill: Str) -> Str {
    let mut out = s
    while out.len() < width && fill != "" {
        out = fill + out
    }
    out
}

// `s` padded on the right with `fill` to at least `width` bytes.
pub fn pad_right(s: Str, width: Int, fill: Str) -> Str {
    let mut out = s
    while out.len() < width && fill != "" {
        out = out + fill
    }
    out
}

// How many times `sub` occurs in `s`, without overlaps.
pub fn count(s: Str, sub: Str) -> Int {
    if sub == "" {
        return 0
    }
    let mut n = 0
    let mut rest = s
    let mut more = true
    while more {
        match rest.index_of(sub) {
            Some(i) => {
                n = n + 1
                rest = rest.slice(i + sub.len(), rest.len())
            },
            None => { more = false },
        }
    }
    n
}

// Whether a byte is an ASCII digit, letter or whitespace.
pub fn is_digit(b: Int) -> Bool {
    b >= 48 && b <= 57
}

pub fn is_alpha(b: Int) -> Bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

pub fn is_space(b: Int) -> Bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

// The words of `s`: runs of non-whitespace.
pub fn words(s: Str) -> List[Str] {
    let mut out = []
    let mut start = -1
    let bs = s.bytes()
    let mut i = 0
    while i <= bs.len() {
        let sp = i == bs.len() || is_space(bs[i])
        if sp && start >= 0 {
            out.push(s.slice(start, i))
            start = -1
        } else if !sp && start < 0 {
            start = i
        }
        i = i + 1
    }
    out
}
