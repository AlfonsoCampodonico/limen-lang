// JSON: parse text into a Value, turn a Value back into text, and read
// fields out of it.
use hex

// A number is `Int` when it was written as a whole number that fits an Int
// (no `.` or exponent), so ids and counts above 2^53 survive a round trip;
// any other number is `Num`.
pub enum Value {
    Null,
    Bool(Bool),
    Num(Float),
    Int(Int),
    Str(Str),
    Arr(List[Value]),
    Obj(List[Field]),
}

// One member of an object, in source order.
pub struct Field {
    key: Str,
    value: Value,
}

pub fn field(key: Str, value: Value) -> Field {
    Field { key, value }
}

// ---------- reading values (methods on Value) ----------

// The value of `key` in an object: `v.get("name")`. `parse` refuses an
// object that repeats a key; in one built with a key twice, the first wins.
pub fn get(self: Value, key: Str) -> Option[Value] {
    match self {
        Obj(fields) => {
            for f in fields {
                if f.key == key {
                    return Some(f.value)
                }
            }
            None
        },
        _ => None,
    }
}

// Item `i` of an array.
pub fn at(self: Value, i: Int) -> Option[Value] {
    match self {
        Arr(items) => items.get(i),
        _ => None,
    }
}

pub fn as_str(self: Value) -> Option[Str] {
    match self {
        Str(s) => Some(s),
        _ => None,
    }
}

pub fn as_num(self: Value) -> Option[Float] {
    match self {
        Num(x) => Some(x),
        Int(n) => Some(n.to_float()),
        _ => None,
    }
}

pub fn as_int(self: Value) -> Option[Int] {
    match self {
        Num(x) => if x == x.to_int().to_float() { Some(x.to_int()) } else { None },
        Int(n) => Some(n),
        _ => None,
    }
}

pub fn as_bool(self: Value) -> Option[Bool] {
    match self {
        Bool(b) => Some(b),
        _ => None,
    }
}

pub fn as_list(self: Value) -> Option[List[Value]] {
    match self {
        Arr(items) => Some(items),
        _ => None,
    }
}

// ---------- writing ----------

// Compact JSON text for `v`. JSON has no infinity or NaN, so those numbers
// are written as `null`, as JavaScript does; every other number is written
// in the fewest digits that read back as the same Float. The arrays and
// objects being written are tracked in a list rather than by recursion, so
// a deep value costs no stack.
pub fn stringify(v: Value) -> Str {
    let mut out: List[Str] = []
    // the open ones, outermost first; slots from `depth` on are spare
    let mut open: List[Writing] = []
    let mut depth = 0
    let mut next = v
    let mut going = true
    while going {
        match next {
            Null => out.push("null"),
            Bool(b) => out.push(b.to_str()),
            Num(x) => out.push(num_text(x)),
            Int(n) => out.push(n.to_str()),
            Str(s) => out.push(quote(s)),
            Arr(items) => {
                out.push("[")
                let w = Writing { obj: false, items, fields: [], at: 0 }
                if depth < open.len() {
                    open[depth] = w
                } else {
                    open.push(w)
                }
                depth = depth + 1
            },
            Obj(fields) => {
                out.push("\{")
                let w = Writing { obj: true, items: [], fields, at: 0 }
                if depth < open.len() {
                    open[depth] = w
                } else {
                    open.push(w)
                }
                depth = depth + 1
            },
        }
        // the next value to write, closing each array and object that has
        // none left
        going = false
        while depth > 0 && !going {
            let d = depth - 1
            let at = open[d].at
            let n = if open[d].obj { open[d].fields.len() } else { open[d].items.len() }
            if at < n {
                if at > 0 {
                    out.push(",")
                }
                if open[d].obj {
                    out.push(quote(open[d].fields[at].key) + ":")
                    next = open[d].fields[at].value
                } else {
                    next = open[d].items[at]
                }
                open[d].at = at + 1
                going = true
            } else {
                out.push(if open[d].obj { "\}" } else { "]" })
                // let go of the finished one's items now, not when its slot is reused
                open[d] = Writing { obj: false, items: [], fields: [], at: 0 }
                depth = d
            }
        }
    }
    out.join("")
}

// An array or object being written, and the position of its next item.
struct Writing {
    obj: Bool,
    items: List[Value],
    fields: List[Field],
    at: Int,
}

fn num_text(x: Float) -> Str {
    if x != x || x - x != 0.0 {
        // NaN or an infinity
        return "null"
    }
    if x.abs() < 100000000000000000.0 && x == x.to_int().to_float() {
        return x.to_int().to_str()
    }
    // Float's to_str keeps 15 significant digits, enough for most numbers;
    // the rest need 16 or 17
    let s = x.to_str()
    if s.parse_float() == Some(x) {
        return s
    }
    if x < 0.0 {
        "-" + longer(0.0 - x, s.slice(1, s.len()))
    } else {
        longer(x, s)
    }
}

fn pow10(n: Int) -> Int {
    let mut p = 1
    for _ in 0..<n {
        p = p * 10
    }
    p
}

// The power of ten of the first significant digit of `s`, a positive
// number as Float's to_str writes it: `1.5e+22`, `0.00012` or `123.25`.
fn decimal_exponent(s: Str) -> Int {
    match s.index_of("e") {
        Some(k) => {
            let e = s.slice(k + 1, s.len())
            let n = if e.starts_with("+") { e.slice(1, e.len()) } else { e }
            n.parse_int() ?? 0
        },
        None => {
            let point = s.index_of(".") ?? s.len()
            let bs = s.bytes()
            let mut i = 0
            while i < bs.len() && (bs[i] == 48 || bs[i] == 46) {
                i = i + 1
            }
            if i < point { point - i - 1 } else { point - i }
        },
    }
}

// `m * 10^e` read as a Float.
fn scaled(m: Int, e: Int) -> Float {
    "{m}e{e}".parse_float() ?? 0.0
}

// The shortest text for a positive finite `x` that needs more than the 15
// digits of `s`, its to_str. With q chosen so x / 10^q lies in [10^16,
// 10^18], it finds the whole numbers m from `low` to `high` for which
// m * 10^q reads back as x (reading text rounds to nearest, so they are
// one unbroken run, found by bisection). Then, with 16 digits and else
// 17, it takes the one in that run nearest its middle, which is nearest x
// (to within the 18th digit; any of them reads back as x).
fn longer(x: Float, s: Str) -> Str {
    let q = decimal_exponent(s) - 17
    // the largest m with m * 10^q <= x
    let mut lo = pow10(16)
    let mut hi = pow10(18)
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if scaled(mid, q) <= x { lo = mid } else { hi = mid }
    }
    let high = lo
    // the smallest m with m * 10^q >= x
    lo = pow10(16)
    hi = high
    while hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if scaled(mid, q) >= x { hi = mid } else { lo = mid }
    }
    let low = hi
    let n = high.to_str().len()
    for p in [16, 17] {
        if p <= n {
            let unit = pow10(n - p)
            let first = (low + unit - 1) / unit
            let last = high / unit
            if first <= last {
                let middle = ((low + high) / unit + 1) / 2
                let m = if middle < first { first } else if middle > last { last } else { middle }
                return digits_text(m, q + n - p)
            }
        }
    }
    digits_text(high, q)
}

fn zeros(n: Int) -> Str {
    let mut s = ""
    for _ in 0..<n {
        s = s + "0"
    }
    s
}

// `m * 10^e` written out as JSON: plain when the point falls near the
// digits (`0.30000000000000004`, `123.45678901234568`), with an exponent
// otherwise (`1.2345678901234567e+29`).
fn digits_text(m: Int, e: Int) -> Str {
    let mut d = m.to_str()
    let mut ex = e
    while d.len() > 1 && d.ends_with("0") {
        d = d.slice(0, d.len() - 1)
        ex = ex + 1
    }
    let n = d.len()
    let point = n + ex
    if ex >= 0 && point <= 21 {
        d + zeros(ex)
    } else if point > 0 && point <= 21 {
        d.slice(0, point) + "." + d.slice(point, n)
    } else if point <= 0 && point > -6 {
        "0." + zeros(0 - point) + d
    } else {
        let rest = if n > 1 { "." + d.slice(1, n) } else { "" }
        let sign = if point - 1 >= 0 { "+" } else { "" }
        d.slice(0, 1) + rest + "e" + sign + "{point - 1}"
    }
}

// `s` as a JSON string literal, with quotes.
pub fn quote(s: Str) -> Str {
    let bs = s.bytes()
    let mut out = "\""
    let mut start = 0
    let mut i = 0
    while i < bs.len() {
        let b = bs[i]
        let esc = if b == 34 {
            "\\\""
        } else if b == 92 {
            "\\\\"
        } else if b == 10 {
            "\\n"
        } else if b == 13 {
            "\\r"
        } else if b == 9 {
            "\\t"
        } else if b < 32 {
            "\\u00" + hex.encode(bytes([b]))
        } else {
            ""
        }
        if esc != "" {
            out = out + s.slice(start, i) + esc
            start = i + 1
        }
        i = i + 1
    }
    out + s.slice(start, bs.len()) + "\""
}

// ---------- parsing ----------

struct Parsed {
    value: Value,
    pos: Int,
}

struct Text {
    s: Str,
    bs: List[Int],
}

// Parse JSON text. The error says what was expected and at which byte.
// Where RFC 8259 leaves the choice to the parser, this one refuses: half a
// surrogate pair (`"\ud800"`), which no Str can hold; an object that
// repeats a key, which two parsers could read two ways; more than 512
// arrays and objects inside each other; and a number longer than 400
// characters.
pub fn parse(s: Str) -> Result[Value, Str] {
    let t = Text { s, bs: s.bytes() }
    let p = value(t, skip(t, 0))?
    let end = skip(t, p.pos)
    if end < t.bs.len() {
        return Err(fail("end of input", end))
    }
    Ok(p.value)
}

fn fail(what: Str, at: Int) -> Str {
    "expected {what} at byte {at}"
}

fn skip(t: Text, i: Int) -> Int {
    let mut j = i
    while j < t.bs.len() && (t.bs[j] == 32 || t.bs[j] == 9 || t.bs[j] == 10 || t.bs[j] == 13) {
        j = j + 1
    }
    j
}

fn lit(t: Text, i: Int, word: Str, v: Value) -> Result[Parsed, Str] {
    if t.s.slice(i, i + word.len()) == word {
        Ok(Parsed { value: v, pos: i + word.len() })
    } else {
        Err(fail("a value", i))
    }
}

// An array or object the parser is inside: its items so far, or for an
// object its members so far and the key of the member whose value comes
// next. `id` tells its keys from other objects' in the map of keys.
struct Open {
    obj: Bool,
    items: List[Value],
    fields: List[Field],
    key: Str,
    id: Int,
}

// The value starting at byte `i`. Arrays and objects are tracked in a list
// rather than by recursion, so deep nesting costs no stack; more than 512
// of them inside each other is an error.
fn value(t: Text, i: Int) -> Result[Parsed, Str] {
    // the open ones, outermost first; slots from `depth` on are spare
    let mut open: List[Open] = []
    let mut depth = 0
    // the keys of objects with many members, by object
    let mut seen: Map[(Int, Str), Bool] = map()
    let mut opened = 0
    let mut j = i
    let mut want_key = false
    while true {
        if want_key {
            let k = key(t, j)?
            let name = k.value.as_str() ?? ""
            let d = depth - 1
            let id = open[d].id
            // a few keys are compared one by one, more through the map
            let n = open[d].fields.len()
            let many = n >= few_keys()
            if n == few_keys() {
                for f in open[d].fields {
                    seen[(id, f.key)] = true
                }
            }
            if (!many && has_key(open[d].fields, name)) || (many && seen.contains((id, name))) {
                return Err("duplicate key `{name}` at byte {j}")
            }
            if many {
                seen[(id, name)] = true
            }
            open[d].key = name
            j = k.pos
        }
        if j >= t.bs.len() {
            return Err(fail("a value", j))
        }
        let b = t.bs[j]
        let mut done = if b == 91 || b == 123 {
            if depth == 512 {
                return Err("nested deeper than 512 at byte {j}")
            }
            let k = skip(t, j + 1)
            if b == 91 && k < t.bs.len() && t.bs[k] == 93 {
                Parsed { value: Arr([]), pos: k + 1 }
            } else if b == 123 && k < t.bs.len() && t.bs[k] == 125 {
                Parsed { value: Obj([]), pos: k + 1 }
            } else {
                opened = opened + 1
                let o = Open { obj: b == 123, items: [], fields: [], key: "", id: opened }
                if depth < open.len() {
                    open[depth] = o
                } else {
                    open.push(o)
                }
                depth = depth + 1
                want_key = b == 123
                j = k
                continue
            }
        } else {
            scalar(t, j)?
        }
        // `done` is a whole value: add it to the array or object it is in,
        // and close each one that ends after it
        while true {
            if depth == 0 {
                return Ok(done)
            }
            let d = depth - 1
            let k = skip(t, done.pos)
            let more = k < t.bs.len() && t.bs[k] == 44
            if open[d].obj {
                open[d].fields.push(Field { key: open[d].key, value: done.value })
                if !more && (k >= t.bs.len() || t.bs[k] != 125) {
                    return Err(fail("`,` or `\}`", k))
                }
                if !more {
                    done = Parsed { value: Obj(open[d].fields), pos: k + 1 }
                }
            } else {
                open[d].items.push(done.value)
                if !more && (k >= t.bs.len() || t.bs[k] != 93) {
                    return Err(fail("`,` or `]`", k))
                }
                if !more {
                    done = Parsed { value: Arr(open[d].items), pos: k + 1 }
                }
            }
            if more {
                want_key = open[d].obj
                j = skip(t, k + 1)
                break
            }
            depth = d
        }
    }
    // not reached: the loop ends only by returning, but a `while` has no value
    Err(fail("a value", j))
}

// How many members an object has before its keys go into the map of keys
// rather than being compared one by one.
fn few_keys() -> Int {
    16
}

fn has_key(fields: List[Field], name: Str) -> Bool {
    for f in fields {
        if f.key == name {
            return true
        }
    }
    false
}

// An object member's key at byte `j` and the `:` after it: where its value
// starts.
fn key(t: Text, j: Int) -> Result[Parsed, Str] {
    if j >= t.bs.len() || t.bs[j] != 34 {
        return Err(fail("a string key", j))
    }
    let k = string(t, j + 1)?
    let c = skip(t, k.pos)
    if c >= t.bs.len() || t.bs[c] != 58 {
        return Err(fail("`:`", c))
    }
    Ok(Parsed { value: k.value, pos: skip(t, c + 1) })
}

// A string, number, `true`, `false` or `null` at byte `j`.
fn scalar(t: Text, j: Int) -> Result[Parsed, Str] {
    let b = t.bs[j]
    if b == 34 {
        string(t, j + 1)
    } else if b == 116 {
        lit(t, j, "true", Bool(true))
    } else if b == 102 {
        lit(t, j, "false", Bool(false))
    } else if b == 110 {
        lit(t, j, "null", Null)
    } else {
        number(t, j)
    }
}

fn is_digit(t: Text, j: Int) -> Bool {
    j < t.bs.len() && t.bs[j] >= 48 && t.bs[j] <= 57
}

// The digits from `j` on: where they stop.
fn digits(t: Text, j: Int) -> Int {
    let mut k = j
    while is_digit(t, k) {
        k = k + 1
    }
    k
}

// A number, by RFC 8259's grammar exactly:
// `-`? (`0` | [1-9][0-9]*) (`.` [0-9]+)? ([eE] [+-]? [0-9]+)?
// so `01`, `1.`, `.5` and `+1` are not numbers. One too large for a Float
// (`1e999`) is an error; one too small to tell from zero reads as 0. One
// longer than 400 characters is an error too, so a huge literal can't cost
// much time or memory: no Float needs that many digits.
fn number(t: Text, i: Int) -> Result[Parsed, Str] {
    let mut j = i
    if j < t.bs.len() && t.bs[j] == 45 {
        j = j + 1
    }
    if !is_digit(t, j) {
        return Err(fail("a value", i))
    }
    j = if t.bs[j] == 48 { j + 1 } else { digits(t, j) }
    let whole = j
    if j < t.bs.len() && t.bs[j] == 46 {
        if !is_digit(t, j + 1) {
            return Err(fail("a digit after `.`", j + 1))
        }
        j = digits(t, j + 1)
    }
    if j < t.bs.len() && (t.bs[j] == 101 || t.bs[j] == 69) {
        let mut k = j + 1
        if k < t.bs.len() && (t.bs[k] == 43 || t.bs[k] == 45) {
            k = k + 1
        }
        if !is_digit(t, k) {
            return Err(fail("a digit in the exponent", k))
        }
        j = digits(t, k)
    }
    if j - i > 400 {
        return Err("number longer than 400 characters at byte {i}")
    }
    // a whole number that fits an Int stays exact; `-0` keeps its sign as a Float
    if whole == j && t.s.slice(i, j) != "-0" {
        match t.s.slice(i, j).parse_int() {
            Some(n) => { return Ok(Parsed { value: Int(n), pos: j }) },
            None => (),
        }
    }
    let x = t.s.slice(i, j).parse_float() ?? { return Err(fail("a number", i)) }
    if x - x != 0.0 {
        return Err(fail("a number within Float's range", i))
    }
    Ok(Parsed { value: Num(x), pos: j })
}

// Four hex digits at `i`, or -1.
fn hex_at(t: Text, i: Int) -> Int {
    if i + 4 > t.bs.len() {
        return -1
    }
    let mut n = 0
    let mut k = 0
    while k < 4 {
        let d = hex.digit(t.bs[i + k])
        if d < 0 {
            return -1
        }
        n = n * 16 + d
        k = k + 1
    }
    n
}

// A string body starting after its opening quote.
fn string(t: Text, i: Int) -> Result[Parsed, Str] {
    let mut out = ""
    let mut start = i
    let mut j = i
    while j < t.bs.len() {
        let b = t.bs[j]
        if b == 34 {
            return Ok(Parsed { value: Str(out + t.s.slice(start, j)), pos: j + 1 })
        } else if b < 32 {
            return Err(fail("no control characters in a string", j))
        } else if b == 92 {
            out = out + t.s.slice(start, j)
            if j + 1 >= t.bs.len() {
                return Err(fail("an escape", j))
            }
            let e = t.bs[j + 1]
            j = j + 2
            if e == 34 || e == 92 || e == 47 {
                out = out + e.to_char()
            } else if e == 110 {
                out = out + "\n"
            } else if e == 116 {
                out = out + "\t"
            } else if e == 114 {
                out = out + "\r"
            } else if e == 98 {
                out = out + 8.to_char()
            } else if e == 102 {
                out = out + 12.to_char()
            } else if e == 117 {
                let mut c = hex_at(t, j)
                if c < 0 {
                    return Err(fail("four hex digits", j))
                }
                j = j + 4
                // a surrogate pair; half of one alone is no character, and a
                // Str holds only characters
                let mut paired = false
                if c >= 55296 && c <= 56319 && j + 6 <= t.bs.len() && t.bs[j] == 92 && t.bs[j + 1] == 117 {
                    let lo = hex_at(t, j + 2)
                    if lo >= 56320 && lo <= 57343 {
                        c = 65536 + (c - 55296) * 1024 + (lo - 56320)
                        j = j + 6
                        paired = true
                    }
                }
                if !paired && c >= 55296 && c <= 57343 {
                    return Err("lone surrogate {t.s.slice(j - 6, j)} at byte {j - 6}")
                }
                out = out + c.to_char()
            } else {
                return Err(fail("a valid escape", j - 2))
            }
            start = j
        } else {
            j = j + 1
        }
    }
    Err(fail("a closing `\"`", j))
}

// ---------- converting values ----------

// `encode(x)` is the JSON text for `x`, and `decode(s)` reads one back:
// `let t: Todo = json.decode(body)?`. They work for any type made of `Int`,
// `Float`, `Str`, `Bool`, `Value`, `Option`, `List`, `Map` with `Str` keys,
// tuples, and structs and enums of those. The compiler writes the
// conversion for each type they are used with, from the functions below;
// these bodies never run.
pub fn encode[T](x: T) -> Str {
    panic("json.encode: the compiler writes this for each type")
}

pub fn decode[T](s: Str) -> Result[T, Str] {
    panic("json.decode: the compiler writes this for each type")
}

// What the compiler's conversions are made of. A decoder takes the value
// and where it sits in the document (`todos[2].title`, "" at the top), for
// the error message.

fn of_int(x: Int) -> Value {
    Int(x)
}

fn of_float(x: Float) -> Value {
    Num(x)
}

fn of_str(x: Str) -> Value {
    Str(x)
}

fn of_bool(x: Bool) -> Value {
    Bool(x)
}

fn of_value(x: Value) -> Value {
    x
}

fn of_option[T](x: Option[T], f: fn(T) -> Value) -> Value {
    match x {
        Some(y) => f(y),
        None => Null,
    }
}

fn of_map[V](m: Map[Str, V], f: fn(V) -> Value) -> Value {
    Obj(m.entries().map(|e| field(e.0, f(e.1))))
}

fn of_variant(name: Str, payload: Value) -> Value {
    Obj([field(name, payload)])
}

fn from_text[T](s: Str, f: fn(Value, Str) -> Result[T, Str]) -> Result[T, Str] {
    let v = parse(s)?
    f(v, "")
}

fn kind(v: Value) -> Str {
    match v {
        Null => "null",
        Bool(_) => "a boolean",
        Num(_) => "a number",
        Int(_) => "a number",
        Str(_) => "a string",
        Arr(_) => "an array",
        Obj(_) => "an object",
    }
}

fn wrong(at: Str, want: Str, v: Value) -> Str {
    let found = kind(v)
    if at.is_empty() {
        "expected {want}, found {found}"
    } else {
        "`{at}`: expected {want}, found {found}"
    }
}

fn inside(at: Str, key: Str) -> Str {
    if at.is_empty() { key } else { "{at}.{key}" }
}

fn from_int(v: Value, at: Str) -> Result[Int, Str] {
    match v.as_int() {
        Some(n) => Ok(n),
        None => Err(wrong(at, "a whole number", v)),
    }
}

fn from_float(v: Value, at: Str) -> Result[Float, Str] {
    match v.as_num() {
        Some(x) => Ok(x),
        None => Err(wrong(at, "a number", v)),
    }
}

fn from_str(v: Value, at: Str) -> Result[Str, Str] {
    match v {
        Str(s) => Ok(s),
        _ => Err(wrong(at, "a string", v)),
    }
}

fn from_bool(v: Value, at: Str) -> Result[Bool, Str] {
    match v {
        Bool(b) => Ok(b),
        _ => Err(wrong(at, "true or false", v)),
    }
}

fn from_value(v: Value, at: Str) -> Result[Value, Str] {
    Ok(v)
}

fn from_option[T](v: Value, at: Str, f: fn(Value, Str) -> Result[T, Str]) -> Result[Option[T], Str] {
    match v {
        Null => Ok(None),
        _ => Ok(Some(f(v, at)?)),
    }
}

fn from_list[T](v: Value, at: Str, f: fn(Value, Str) -> Result[T, Str]) -> Result[List[T], Str] {
    match v {
        Arr(items) => {
            let mut out: List[T] = []
            for x in items {
                out.push(f(x, "{at}[{out.len()}]")?)
            }
            Ok(out)
        },
        _ => Err(wrong(at, "an array", v)),
    }
}

fn from_map[V](v: Value, at: Str, f: fn(Value, Str) -> Result[V, Str]) -> Result[Map[Str, V], Str] {
    match v {
        Obj(fields) => {
            let mut out: Map[Str, V] = map()
            for x in fields {
                out[x.key] = f(x.value, inside(at, x.key))?
            }
            Ok(out)
        },
        _ => Err(wrong(at, "an object", v)),
    }
}

// An array of exactly `n` items, for a tuple or a variant's payload.
fn from_items(v: Value, at: Str, n: Int) -> Result[List[Value], Str] {
    match v {
        Arr(items) if items.len() == n => Ok(items),
        _ => Err(wrong(at, "an array of {n} items", v)),
    }
}

fn item_at(at: Str, i: Int) -> Str {
    "{at}[{i}]"
}

fn need_object(v: Value, at: Str) -> Result[(), Str] {
    match v {
        Obj(_) => Ok(()),
        _ => Err(wrong(at, "an object", v)),
    }
}

// Field `key` of object `v`. A missing field reads as null, so an `Option`
// field may be left out; any other is reported missing.
fn member[T](v: Value, at: Str, key: Str, f: fn(Value, Str) -> Result[T, Str]) -> Result[T, Str] {
    let path = inside(at, key)
    match v.get(key) {
        Some(x) => f(x, path),
        None => match f(Null, path) {
            Ok(x) => Ok(x),
            Err(_) => Err("`{path}` is missing"),
        },
    }
}

// An enum value: a unit variant is its name, `"Point"`; one with a payload
// is an object with one member, `{"Circle": 1.5}`, or for several items
// `{"Rect": [2, 3]}`. The variant's name and its payload (null for none).
fn from_variant(v: Value, at: Str) -> Result[(Str, Value), Str] {
    match v {
        Str(name) => Ok((name, Null)),
        Obj([f]) => Ok((f.key, f.value)),
        _ => Err(wrong(at, "a variant's name or an object with one member", v)),
    }
}

fn no_variant(at: Str, name: Str, names: Str) -> Str {
    let place = if at.is_empty() { "" } else { "`{at}`: " }
    "{place}no variant `{name}`; expected one of {names}"
}

fn of_list(items: List[Value]) -> Value {
    Arr(items)
}

fn of_fields(fields: List[Field]) -> Value {
    Obj(fields)
}
