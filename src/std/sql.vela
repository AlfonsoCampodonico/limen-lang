// SQL databases through SQLite (the system's libsqlite3), with parameters
// bound by SQLite itself, never pasted into the SQL text.
//
//   let f = root.foreign                          // --grant foreign=sqlite3
//   let db = sql.open(f, root.fs, "app.db")?      // --grant fs=DIR
//   db.exec(f, "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, name TEXT)", [])?
//   db.exec(f, "INSERT INTO users (name) VALUES (?)", [sql.Text("Ada")])?
//   for row in db.query(f, "SELECT id, name FROM users WHERE id > ?", [sql.Int(0)])? {
//       out.print("{row.int("id") ?? 0} {row.text("name") ?? "?"}")
//   }
//   db.close(f)
//
// Every operation takes the Foreign capability, since it calls C. Opening a
// file also takes the Fs capability for its directory: the database is a
// path under the granted directory, opened read-only when the Fs is. SQLite
// is kept inside that grant: ATTACH (and VACUUM, which attaches) is turned
// off, the database file is not opened through a symlink, URI filenames and
// extensions stay off.

// ---------- SQLite's C API, as much as this module needs ----------

foreign "sqlite3" {
    fn sqlite3_open_v2(path: Str, db: Out[Handle], flags: Int32, vfs: Int) -> Int32
    fn sqlite3_close_v2(db: Handle) -> Int32
    fn sqlite3_errmsg(db: Handle) -> Str
    fn sqlite3_errstr(rc: Int32) -> Str
    fn sqlite3_limit(db: Handle, id: Int32, value: Int32) -> Int32
    fn sqlite3_busy_timeout(db: Handle, ms: Int32) -> Int32
    fn sqlite3_exec(db: Handle, sql: Str, callback: Int, arg: Int, err: Out[Handle]) -> Int32
    fn sqlite3_free(p: Handle)
    fn sqlite3_changes64(db: Handle) -> Int
    fn sqlite3_last_insert_rowid(db: Handle) -> Int
    fn sqlite3_get_autocommit(db: Handle) -> Bool
    fn sqlite3_prepare_v2(db: Handle, sql: Str, n: Int32, stmt: Out[Handle], tail: Out[Handle]) -> Int32
    fn sqlite3_sql(stmt: Handle) -> Str
    fn sqlite3_finalize(stmt: Handle) -> Int32
    fn sqlite3_step(stmt: Handle) -> Int32
    fn sqlite3_bind_parameter_count(stmt: Handle) -> Int32
    fn sqlite3_bind_null(stmt: Handle, i: Int32) -> Int32
    fn sqlite3_bind_int64(stmt: Handle, i: Int32, v: Int) -> Int32
    fn sqlite3_bind_double(stmt: Handle, i: Int32, v: Float) -> Int32
    fn sqlite3_bind_text(stmt: Handle, i: Int32, v: Str, n: Int32, destructor: Int) -> Int32
    fn sqlite3_bind_blob(stmt: Handle, i: Int32, v: Bytes, n: Int32, destructor: Int) -> Int32
    fn sqlite3_column_count(stmt: Handle) -> Int32
    fn sqlite3_column_name(stmt: Handle, i: Int32) -> Str
    fn sqlite3_column_type(stmt: Handle, i: Int32) -> Int32
    fn sqlite3_column_int64(stmt: Handle, i: Int32) -> Int
    fn sqlite3_column_double(stmt: Handle, i: Int32) -> Float
    fn sqlite3_column_text(stmt: Handle, i: Int32) -> Handle
    fn sqlite3_column_blob(stmt: Handle, i: Int32) -> Handle
    fn sqlite3_column_bytes(stmt: Handle, i: Int32) -> Int32
}

// result codes and flags from sqlite3.h
fn ok_code() -> Int { 0 }

fn row_code() -> Int { 100 }

fn done_code() -> Int { 101 }

fn open_flags(read_only: Bool) -> Int {
    // NOFOLLOW (0x01000000), FULLMUTEX (0x00010000): one connection can be
    // shared by tasks; READONLY (1), or READWRITE (2) | CREATE (4)
    let base = 16777216 + 65536
    if read_only { base + 1 } else { base + 2 + 4 }
}

// SQLITE_TRANSIENT: SQLite copies a bound text or blob before the call returns
fn transient() -> Int { -1 }

// ---------- values ----------

// A database connection. Close it with `db.close(f)`.
pub struct Db {
    handle: Handle,
}

// One SQL value: a parameter, or a column of a row.
pub enum Value {
    Null,
    Int(Int),
    Float(Float),
    Text(Str),
    Blob(Bytes),
}

// One result row: column names and values, in the order of the SELECT.
pub struct Row {
    columns: List[Str],
    values: List[Value],
}

fn fail(f: Foreign, db: Handle, what: Str) -> IoError {
    Failed("sql: {what}: {sqlite3_errmsg(f, db)}")
}

fn need(f: Foreign) -> Result[(), IoError] {
    if f.allows("sqlite3") { Ok(()) } else { Err(Denied("sql: calling SQLite needs --grant foreign=sqlite3")) }
}

fn connect(f: Foreign, path: Str, read_only: Bool) -> Result[Db, IoError] {
    need(f)?
    let (rc, h) = sqlite3_open_v2(f, path, open_flags(read_only), 0)
    if rc != ok_code() {
        let msg = if h.addr == 0 { sqlite3_errstr(f, rc) } else { sqlite3_errmsg(f, h) }
        sqlite3_close_v2(f, h)
        return Err(Failed("sql: cannot open `{path}`: {msg}"))
    }
    // no ATTACH, so SQL cannot reach files outside the Fs grant
    // (SQLITE_LIMIT_ATTACHED is 7; VACUUM INTO attaches too)
    sqlite3_limit(f, h, 7, 0)
    sqlite3_busy_timeout(f, h, 5000)
    Ok(Db { handle: h })
}

// Open (or create) the database file `name` under the directory `fs` grants.
// A read-only Fs opens it read-only, and then it must exist.
pub fn open(f: Foreign, fs: Fs, name: Str) -> Result[Db, IoError] {
    need(f)?
    let path = fs.full_path(name)?
    connect(f, path, fs.is_read_only())
}

// A fresh database in memory, gone when closed. Needs no Fs.
pub fn memory(f: Foreign) -> Result[Db, IoError] {
    connect(f, ":memory:", false)
}

// Close the connection. A Db must not be used after this.
pub fn close(self: Db, f: Foreign) -> Result[(), IoError] {
    let rc = sqlite3_close_v2(f, self.handle)
    if rc == ok_code() { Ok(()) } else { Err(Failed("sql: close: {sqlite3_errstr(f, rc)}")) }
}

// ---------- statements ----------

fn bind(f: Foreign, db: Handle, st: Handle, params: List[Value]) -> Result[(), IoError] {
    let want = sqlite3_bind_parameter_count(f, st)
    if want != params.len() {
        return Err(Failed("sql: the statement has {want} parameter{if want == 1 { "" } else { "s" }}, but {params.len()} were given"))
    }
    let mut i = 1
    for p in params {
        let rc = match p {
            Null => sqlite3_bind_null(f, st, i),
            Int(n) => sqlite3_bind_int64(f, st, i, n),
            Float(x) => sqlite3_bind_double(f, st, i, x),
            Text(s) => sqlite3_bind_text(f, st, i, s, s.len(), transient()),
            Blob(b) => sqlite3_bind_blob(f, st, i, b, b.len(), transient()),
        }
        if rc != ok_code() {
            return Err(fail(f, db, "binding parameter {i}"))
        }
        i = i + 1
    }
    Ok(())
}

// Prepare exactly one statement with its parameters bound.
fn prepare(f: Foreign, db: Handle, text: Str, params: List[Value]) -> Result[Handle, IoError] {
    let (rc, st, _) = sqlite3_prepare_v2(f, db, text, text.len())
    if rc != ok_code() {
        return Err(fail(f, db, "prepare"))
    }
    if st.addr == 0 {
        return Err(Failed("sql: no statement in the SQL text"))
    }
    // the text SQLite used for this statement; anything after it is a second statement
    let used = sqlite3_sql(f, st).len()
    if text.slice(used, text.len()).trim() != "" && text.slice(used, text.len()).trim() != ";" {
        sqlite3_finalize(f, st)
        return Err(Failed("sql: a statement with parameters must be alone; run several with `exec` and no parameters"))
    }
    match bind(f, db, st, params) {
        Ok(_) => Ok(st),
        Err(e) => {
            sqlite3_finalize(f, st)
            Err(e)
        },
    }
}

fn column(f: Foreign, st: Handle, i: Int) -> Value {
    match sqlite3_column_type(f, st, i) {
        1 => Int(sqlite3_column_int64(f, st, i)),
        2 => Float(sqlite3_column_double(f, st, i)),
        3 => {
            let p = sqlite3_column_text(f, st, i)
            Text(f.copy(p, sqlite3_column_bytes(f, st, i)).to_str())
        },
        4 => {
            let p = sqlite3_column_blob(f, st, i)
            Blob(f.copy(p, sqlite3_column_bytes(f, st, i)))
        },
        _ => Null,
    }
}

// Run SQL that returns no rows; the result is how many rows it changed.
// With no parameters the text may hold several statements, separated by `;`
// (a schema, say). With parameters it must be exactly one statement, and
// each `?` takes the next value of `params`.
pub fn exec(self: Db, f: Foreign, text: Str, params: List[Value]) -> Result[Int, IoError] {
    need(f)?
    if params.is_empty() {
        let (rc, err) = sqlite3_exec(f, self.handle, text, 0, 0)
        if rc != ok_code() {
            let msg = if err.addr == 0 { sqlite3_errstr(f, rc) } else { sqlite3_errmsg(f, self.handle) }
            sqlite3_free(f, err)
            return Err(Failed("sql: {msg}"))
        }
        return Ok(sqlite3_changes64(f, self.handle))
    }
    let st = prepare(f, self.handle, text, params)?
    let rc = sqlite3_step(f, st)
    let result = if rc == done_code() || rc == row_code() { Ok(sqlite3_changes64(f, self.handle)) } else { Err(fail(f, self.handle, "exec")) }
    sqlite3_finalize(f, st)
    result
}

// Run one statement and collect every row it returns.
pub fn query(self: Db, f: Foreign, text: Str, params: List[Value]) -> Result[List[Row], IoError] {
    need(f)?
    let st = prepare(f, self.handle, text, params)?
    let n = sqlite3_column_count(f, st)
    let names = (0..<n).map(|i| sqlite3_column_name(f, st, i))
    let mut rows = []
    let mut rc = sqlite3_step(f, st)
    while rc == row_code() {
        rows.push(Row { columns: names, values: (0..<n).map(|i| column(f, st, i)) })
        rc = sqlite3_step(f, st)
    }
    let result = if rc == done_code() { Ok(rows) } else { Err(fail(f, self.handle, "query")) }
    sqlite3_finalize(f, st)
    result
}

// The first row, if any: for queries that look one thing up.
pub fn query_one(self: Db, f: Foreign, text: Str, params: List[Value]) -> Result[Option[Row], IoError] {
    let rows = self.query(f, text, params)?
    if rows.is_empty() { Ok(None) } else { Ok(Some(rows[0])) }
}

// The rowid of the last row inserted through this connection.
pub fn last_id(self: Db, f: Foreign) -> Int {
    sqlite3_last_insert_rowid(f, self.handle)
}

// Run `body` in a transaction: committed if it returns Ok, rolled back if it
// returns Err or panics (the panic then goes on). Transactions do not nest.
pub fn transaction[T](self: Db, f: Foreign, body: fn() -> Result[T, IoError]) -> Result[T, IoError] {
    need(f)?
    if !sqlite3_get_autocommit(f, self.handle) {
        return Err(Failed("sql: a transaction is already open on this connection"))
    }
    self.exec(f, "BEGIN", [])?
    match catch(body) {
        Ok(Ok(v)) => {
            match self.exec(f, "COMMIT", []) {
                Ok(_) => Ok(v),
                Err(e) => {
                    self.exec(f, "ROLLBACK", [])
                    Err(e)
                },
            }
        },
        Ok(Err(e)) => {
            self.exec(f, "ROLLBACK", [])
            Err(e)
        },
        Err(msg) => {
            self.exec(f, "ROLLBACK", [])
            panic(msg)
        },
    }
}

// ---------- reading rows ----------

fn index(self: Row, name: Str) -> Int {
    let mut i = 0
    for c in self.columns {
        if c == name {
            return i
        }
        i = i + 1
    }
    panic("sql: the row has no column `{name}` (it has {self.columns.join(", ")})")
}

// The value of column `name`. Panics if there is no such column.
pub fn get(self: Row, name: Str) -> Value {
    self.values[self.index(name)]
}

fn wrong(name: Str, want: Str, v: Value) -> Str {
    "sql: column `{name}` is not {want}: {v}"
}

// Typed access: None when the column is NULL. Panics if there is no such
// column or it holds another type (an Int column reads as Float too).
pub fn int(self: Row, name: Str) -> Option[Int] {
    match self.get(name) {
        Int(n) => Some(n),
        Null => None,
        v => panic(wrong(name, "an integer", v)),
    }
}

pub fn float(self: Row, name: Str) -> Option[Float] {
    match self.get(name) {
        Float(x) => Some(x),
        Int(n) => Some(n.to_float()),
        Null => None,
        v => panic(wrong(name, "a number", v)),
    }
}

pub fn text(self: Row, name: Str) -> Option[Str] {
    match self.get(name) {
        Text(s) => Some(s),
        Null => None,
        v => panic(wrong(name, "text", v)),
    }
}

pub fn blob(self: Row, name: Str) -> Option[Bytes] {
    match self.get(name) {
        Blob(b) => Some(b),
        Null => None,
        v => panic(wrong(name, "a blob", v)),
    }
}

pub fn is_null(self: Row, name: Str) -> Bool {
    match self.get(name) {
        Null => true,
        _ => false,
    }
}
