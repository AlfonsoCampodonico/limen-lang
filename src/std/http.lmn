// HTTP/1.1: a client on top of Net, and a server on top of Listener and
// Conn. The server keeps connections alive between requests, and bodies can
// be streamed in chunks both ways. The client speaks TLS for https:// URLs
// (Net.connect_tls); the server speaks TLS when its listener came from
// Listen.on_tls, with nothing else to change.
use compress
use format
use hex
use url

pub struct Header {
    name: Str,
    value: Str,
}

pub struct Request {
    method: Str,
    path: Str,
    version: Str,   // "HTTP/1.1" or "HTTP/1.0"
    headers: List[Header],
    body: Str,
}

pub struct Response {
    status: Int,
    headers: List[Header],
    body: Str,
}

// The value of a header, matching its name without regard to case.
pub fn find_header(headers: List[Header], name: Str) -> Option[Str] {
    let want = name.to_lower()
    for h in headers {
        if h.name.to_lower() == want {
            return Some(h.value)
        }
    }
    None
}

// A header of a request or response: `req.header("content-type")`.
pub fn header(self: Request, name: Str) -> Option[Str] {
    find_header(self.headers, name)
}

pub fn header(self: Response, name: Str) -> Option[Str] {
    find_header(self.headers, name)
}

// A response with a body of plain text.
pub fn text(status: Int, body: Str) -> Response {
    Response { status, headers: [Header { name: "Content-Type", value: "text/plain; charset=utf-8" }], body }
}

// A response with a JSON body (already serialized).
pub fn json(status: Int, body: Str) -> Response {
    Response { status, headers: [Header { name: "Content-Type", value: "application/json" }], body }
}

// A page for an error status in the design of limen-lang.org, light or dark
// as the visitor's system is, with nothing fetched: the status, its reason
// and `detail` (HTML-escaped). The router and the server answer with it
// instead of plain text when the request accepts HTML; call it to answer
// errors of your own the same way.
pub fn error_page(status: Int, detail: Str) -> Response {
    let why = escape_html(reason(status))
    // the heading in sentence case, as the design writes labels
    let heading = why.slice(0, 1) + why.slice(1, why.len()).to_lower()
    let body = """
        <!doctype html>
        <html lang="en">
        <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{status} {why}</title>
        <style>
        {error_css()}</style>
        </head>
        <body>
        <main class="error-page">
        <p class="error-status">{status}</p>
        <h1>{heading}</h1>
        <p>{escape_html(detail)}</p>
        <p><a href="/">Go to the home page</a></p>
        </main>
        </body>
        </html>

        """
    Response { status, headers: [Header { name: "Content-Type", value: "text/html; charset=utf-8" }], body }
}

// True when the request's Accept header names `text/html`, as a browser's
// does. Clients that leave it out, like curl and most API clients, get the
// plain-text errors.
pub fn accepts_html(r: Request) -> Bool {
    match r.header("Accept") {
        Some(a) => a.to_lower().contains("text/html"),
        None => false,
    }
}

// The error page for a request that accepts HTML, else `plain` as text.
fn error_for(r: Request, status: Int, detail: Str, plain: Str) -> Response {
    if accepts_html(r) { error_page(status, detail) } else { text(status, plain) }
}

fn escape_html(s: Str) -> Str {
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

// The error page's stylesheet: a trimmed copy of the compiler's
// src/design/limen.css (tokens and the `.error-page` rules), which comes
// from limen-book. A test checks every token here against that file.
fn error_css() -> Str {
    """
    :root \{ --bg: #ffffff; --line: #e7e5e4; --ink: #0c0a09; --ink-2: #44403c; --ink-3: #78716c; --brand: #1f3a70; --brand-ink: #24498f; --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; --font-mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace; --text-sm: 14px; --text-md: 16px; --text-3xl: 40px; --space-3: 12px; --space-4: 16px; --space-6: 24px; --space-24: 96px; color-scheme: light; \}
    @media (prefers-color-scheme: dark) \{ :root \{ --bg: #0c0b0a; --line: #2a2826; --ink: #f5f4f2; --ink-2: #cfcbc6; --ink-3: #8f8a84; --brand: #3a62b0; --brand-ink: #9dbbf5; color-scheme: dark; \} \}
    body \{ margin: 0; background: var(--bg); color: var(--ink); font: 400 var(--text-md)/1.6 var(--font-sans); -webkit-font-smoothing: antialiased; \}
    p \{ margin: 0 0 var(--space-4); color: var(--ink-2); \}
    a \{ color: var(--brand-ink); text-underline-offset: 3px; \}
    h1 \{ margin: 0; color: var(--ink); font-weight: 600; letter-spacing: -.02em; \}
    .error-page \{ max-width: 640px; margin: 0 auto; padding: var(--space-24) var(--space-6); \}
    .error-status \{ margin: 0 0 var(--space-3); color: var(--ink-3); font: 500 var(--text-sm)/1 var(--font-mono); \}
    .error-page h1 \{ font-size: var(--text-3xl); line-height: 1.1; letter-spacing: -.03em; margin-bottom: var(--space-4); \}

    """
}

pub fn reason(status: Int) -> Str {
    match status {
        200 => "OK",
        201 => "Created",
        202 => "Accepted",
        204 => "No Content",
        301 => "Moved Permanently",
        302 => "Found",
        304 => "Not Modified",
        400 => "Bad Request",
        401 => "Unauthorized",
        403 => "Forbidden",
        404 => "Not Found",
        405 => "Method Not Allowed",
        408 => "Request Timeout",
        409 => "Conflict",
        413 => "Payload Too Large",
        422 => "Unprocessable Content",
        429 => "Too Many Requests",
        500 => "Internal Server Error",
        502 => "Bad Gateway",
        503 => "Service Unavailable",
        _ => "Status",
    }
}

// ---------- limits ----------

fn max_head() -> Int {
    65536
}

fn max_body() -> Int {
    8388608
}

// Requests answered on one connection before the server closes it.
fn max_requests() -> Int {
    1000
}

// ---------- message parsing, shared by client and server ----------

struct Head {
    first: Str,
    headers: List[Header],
}

fn bad(msg: Str) -> IoError {
    Failed("http: " + msg)
}

// A byte a token may hold (RFC 9110 5.6.2): letters, digits and
// ! # $ % & ' * + - . ^ _ ` | ~
fn token_byte(b: Int) -> Bool {
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || "!#$%&'*+-.^_`|~".bytes().contains(b)
}

// Whether `s` is a token, as header names and methods must be.
fn is_token(s: Str) -> Bool {
    s != "" && s.bytes().all(|b| token_byte(b))
}

// Whether `s` can go in a header value, a start line or a reason phrase:
// no control bytes (CR, LF and NUL above all) other than the tab.
fn is_field_text(s: Str) -> Bool {
    s.bytes().all(|b| (b >= 32 || b == 9) && b != 127)
}

// The start line and headers of a message (without the blank line). Lines
// end in CRLF; a bare CR or LF, a NUL, a header name that is not a token
// (`Content-Length : 5`), a folded line (one starting with a space or tab)
// or a control byte in a value is an error rather than something to guess at.
fn parse_head(text: Str) -> Result[Head, IoError] {
    let bs = text.bytes()
    let mut j = 0
    while j < bs.len() {
        let b = bs[j]
        if b == 0 {
            return Err(bad("NUL in the headers"))
        }
        if b == 13 && (j + 1 >= bs.len() || bs[j + 1] != 10) {
            return Err(bad("bare CR in the headers"))
        }
        if b == 10 && (j == 0 || bs[j - 1] != 13) {
            return Err(bad("bare LF in the headers"))
        }
        j = j + 1
    }
    let lines = text.split("\r\n")
    if !is_field_text(lines[0]) {
        return Err(bad("control character in the start line"))
    }
    let mut headers = []
    let mut i = 1
    while i < lines.len() {
        let l = lines[i]
        if l.starts_with(" ") || l.starts_with("\t") {
            return Err(bad("folded header line"))
        }
        let k = l.index_of(":") ?? { return Err(bad("malformed header line")) }
        let name = l.slice(0, k)
        let value = l.slice(k + 1, l.len())
        if !is_token(name) {
            return Err(bad("malformed header name"))
        }
        if !is_field_text(value) {
            return Err(bad("control character in a header value"))
        }
        headers.push(Header { name, value: value.trim() })
        i = i + 1
    }
    Ok(Head { first: lines[0], headers })
}

// A point in time a read or write must finish by, on the Clock that
// measures it, or none (the client, and servers without limits).
type By = Option[(Clock, Int)]

// The next bytes from `c`, by `by`.
fn read_by(c: Conn, by: By) -> Result[Str, IoError] {
    match by {
        Some((clock, at)) => c.read_within(clock, (at - clock.now_ms()).max(0)),
        None => c.read(),
    }
}

// Read from `c` until `buf` holds a whole head: its text and the bytes after
// the blank line. None if the peer closed before sending anything.
fn read_head(c: Conn, buf: Str, by: By) -> Result[Option[(Str, Str)], IoError] {
    let mut data = buf
    while true {
        match data.index_of("\r\n\r\n") {
            Some(i) => { return Ok(Some((data.slice(0, i), data.slice(i + 4, data.len())))) },
            None => (),
        }
        // a head ended by bare LFs would never match; refuse it at once
        if data.contains("\n\n") {
            return Err(bad("bare LF in the headers"))
        }
        if data.len() > max_head() {
            return Err(bad("headers too large"))
        }
        let chunk = read_by(c, by)?
        if chunk == "" {
            if data == "" {
                return Ok(None)
            }
            return Err(bad("connection closed before the headers were complete"))
        }
        data = data + chunk
    }
    Ok(None)
}

// The Content-Length of a message, None without one. Every Content-Length
// header must be digits only, and when there are several they must agree:
// two lengths that differ are how one request gets smuggled inside another.
fn content_length(headers: List[Header]) -> Result[Option[Int], IoError] {
    let mut found = None
    for h in headers {
        if h.name.to_lower() == "content-length" {
            let v = h.value
            if v == "" || v.len() > 18 || !v.bytes().all(|b| b >= 48 && b <= 57) {
                return Err(bad("bad Content-Length"))
            }
            let n = v.parse_int() ?? { return Err(bad("bad Content-Length")) }
            if found.is_some() && found != Some(n) {
                return Err(bad("conflicting Content-Length headers"))
            }
            found = Some(n)
        }
    }
    Ok(found)
}

// The transfer codings of a message, lowercased, from every
// Transfer-Encoding header in order; None without one.
fn transfer_codings(headers: List[Header]) -> Option[List[Str]] {
    let mut found = false
    let mut codings = []
    for h in headers {
        if h.name.to_lower() == "transfer-encoding" {
            found = true
            for t in h.value.to_lower().split(",") {
                let c = t.trim()
                if c != "" {
                    codings.push(c)
                }
            }
        }
    }
    if found { Some(codings) } else { None }
}

// Whether a comma-separated header such as Connection lists `token`.
fn has_token(headers: List[Header], name: Str, token: Str) -> Bool {
    match find_header(headers, name) {
        Some(v) => v.to_lower().split(",").map(|t| t.trim()).contains(token),
        None => false,
    }
}

fn hex_value(s: Str) -> Option[Int] {
    let t = s.trim()
    if t == "" || t.len() > 15 {
        return None
    }
    let mut n = 0
    for b in t.bytes() {
        let d = hex.digit(b)
        if d < 0 {
            return None
        }
        n = n * 16 + d
    }
    Some(n)
}

// Read `n` bytes of body, the first ones already in `buf`, passing each
// piece to `f` as it arrives. The folded value and the bytes after the body.
// Once `stop` is true of the folded value, it returns at once without
// reading the rest (the caller then closes the connection).
fn read_sized[T](c: Conn, buf: Str, n: Int, init: T, f: fn(T, Str) -> T, stop: fn(T) -> Bool, by: By) -> Result[(T, Str), IoError] {
    let mut acc = init
    let mut left = n
    let mut data = buf
    while true {
        if data.len() >= left {
            if left > 0 {
                acc = f(acc, data.slice(0, left))
            }
            return Ok((acc, data.slice(left, data.len())))
        }
        if data != "" {
            acc = f(acc, data)
            left = left - data.len()
            if stop(acc) {
                return Ok((acc, ""))
            }
        }
        data = read_by(c, by)?
        if data == "" {
            return Err(bad("connection closed before the body was complete"))
        }
    }
    Ok((acc, ""))
}

// Read a body that ends when the peer closes the connection.
fn read_to_end[T](c: Conn, buf: Str, init: T, f: fn(T, Str) -> T, stop: fn(T) -> Bool) -> Result[T, IoError] {
    let mut acc = if buf == "" { init } else { f(init, buf) }
    while !stop(acc) {
        let data = c.read()?
        if data == "" {
            return Ok(acc)
        }
        acc = f(acc, data)
    }
    Ok(acc)
}

// Read more of a chunked body into `data`, failing if the peer closed.
fn more(c: Conn, data: Str, by: By) -> Result[Str, IoError] {
    let chunk = read_by(c, by)?
    if chunk == "" {
        return Err(bad("truncated chunk"))
    }
    Ok(data + chunk)
}

// Read a `Transfer-Encoding: chunked` body, decoding it as it arrives and
// passing each piece to `f`. `limit` caps the decoded size (-1: no cap).
// The folded value and the bytes after the body and its trailers.
fn read_chunked[T](c: Conn, buf: Str, limit: Int, init: T, f: fn(T, Str) -> T, stop: fn(T) -> Bool, by: By) -> Result[(T, Str), IoError] {
    let mut acc = init
    let mut data = buf
    let mut total = 0
    while true {
        let eol = data.index_of("\r\n") ?? -1
        if eol < 0 {
            if data.len() > 4096 {
                return Err(bad("bad chunk size"))
            }
            data = more(c, data, by)?
            continue
        }
        // a chunk size may carry `;extensions`
        let line = data.slice(0, eol)
        let size_text = match line.index_of(";") {
            Some(k) => line.slice(0, k),
            None => line,
        }
        let size = hex_value(size_text) ?? { return Err(bad("bad chunk size")) }
        data = data.slice(eol + 2, data.len())
        if size == 0 {
            // trailer lines, up to a blank line
            while true {
                let e = data.index_of("\r\n") ?? -1
                if e == 0 {
                    return Ok((acc, data.slice(2, data.len())))
                }
                if e > 0 {
                    data = data.slice(e + 2, data.len())
                } else if data.len() > max_head() {
                    return Err(bad("trailers too large"))
                } else {
                    data = more(c, data, by)?
                }
            }
        }
        total = total + size
        if limit >= 0 && total > limit {
            return Err(bad("body too large"))
        }
        let (a, rest) = read_sized(c, data, size, acc, f, stop, by)?
        acc = a
        data = rest
        if stop(acc) {
            return Ok((acc, ""))
        }
        while data.len() < 2 {
            data = more(c, data, by)?
        }
        if !data.starts_with("\r\n") {
            return Err(bad("missing CRLF after a chunk"))
        }
        data = data.slice(2, data.len())
    }
    Ok((acc, data))
}

// Refuse headers that would not go out as the caller meant: a name that is
// not a token, or a value with CR, LF, NUL or another control byte, which
// would let it end the header early and start another (response splitting).
fn check_headers(headers: List[Header]) -> Result[(), IoError] {
    for h in headers {
        if !is_token(h.name) {
            return Err(bad("a header name is not a token"))
        }
        if !is_field_text(h.value) {
            return Err(bad("the value of header {h.name} holds a control character"))
        }
    }
    Ok(())
}

// A whole message: the start line, the headers and a Content-Length (unless
// one is given), then the body. An error for a bad header, a start line with
// a control byte, a Transfer-Encoding (the body goes whole) or a
// Content-Length that is not a length.
fn head_text(first: Str, headers: List[Header], body: Str) -> Result[Str, IoError] {
    if !is_field_text(first) {
        return Err(bad("control character in the start line"))
    }
    check_headers(headers)?
    if transfer_codings(headers).is_some() {
        return Err(bad("a whole message cannot have a Transfer-Encoding header"))
    }
    let given = content_length(headers)?
    let mut s = first + "\r\n"
    for h in headers {
        s = s + h.name + ": " + h.value + "\r\n"
    }
    if given.is_none() {
        s = s + "Content-Length: {body.len()}\r\n"
    }
    Ok(s + "\r\n" + body)
}

// ---------- client ----------

// Where a request for a URL goes: over TLS or not, the address to connect
// to, the Host header, and the target the request line names.
struct Target {
    tls: Bool,
    addr: Str,
    host: Str,
    // the path and the query, never the fragment, which stays with the client
    path: Str,
}

fn target(text: Str) -> Result[Target, IoError] {
    let u = match url.parse(text) {
        Ok(u) => u,
        Err(e) => {
            return Err(bad(e))
        },
    }
    let tls = u.scheme == "https"
    if !tls && u.scheme != "http" {
        return Err(bad("the URL must start with http:// or https://"))
    }
    if u.host == "" {
        return Err(bad("the URL has no host"))
    }
    // an IPv6 address keeps its brackets
    let host = if u.host.contains(":") { "[" + u.host + "]" } else { u.host }
    let port = u.port ?? if tls { 443 } else { 80 }
    let path = if u.path == "" { "/" } else { u.path }
    let query = if u.query == "" { "" } else { "?" + u.query }
    Ok(Target { tls, addr: "{host}:{port}", host, path: path + query })
}

// A response's status line and headers, and the bytes read after them.
fn read_status(c: Conn) -> Result[(Response, Str), IoError] {
    let (text, rest) = read_head(c, "", None)? ?? { return Err(bad("connection closed before the response")) }
    let h = parse_head(text)?
    let parts = h.first.split(" ")
    if parts.len() < 2 || !parts[0].starts_with("HTTP/") {
        return Err(bad("malformed status line"))
    }
    if parts[1].len() != 3 || !parts[1].bytes().all(|b| b >= 48 && b <= 57) {
        return Err(bad("malformed status line"))
    }
    let status = parts[1].parse_int() ?? { return Err(bad("malformed status line")) }
    Ok((Response { status, headers: h.headers, body: "" }, rest))
}

// The body of `resp`, the first bytes already in `rest`, passed to `f`
// piece by piece as it arrives; it stops early once `stop` is true.
fn read_body[T](c: Conn, method: Str, resp: Response, rest: Str, init: T, f: fn(T, Str) -> T, stop: fn(T) -> Bool) -> Result[T, IoError] {
    let status = resp.status
    if method == "HEAD" || status == 204 || status == 304 || (status >= 100 && status < 200) {
        return Ok(init)
    }
    let length = content_length(resp.headers)?
    match transfer_codings(resp.headers) {
        Some(codings) => {
            // both framings at once is how responses get split: refuse it
            if length.is_some() {
                return Err(bad("both Transfer-Encoding and Content-Length"))
            }
            // RFC 9112 6.3: chunked last means chunked; anything else runs
            // until the server closes
            if codings.len() > 0 && codings[codings.len() - 1] == "chunked" {
                let (acc, _) = read_chunked(c, rest, -1, init, f, stop, None)?
                return Ok(acc)
            }
            read_to_end(c, rest, init, f, stop)
        },
        None => match length {
            Some(n) => {
                let (acc, _) = read_sized(c, rest, n, init, f, stop, None)?
                Ok(acc)
            },
            None => read_to_end(c, rest, init, f, stop),
        },
    }
}

// Connect for `url` and send the request; the connection, ready for the response.
fn send_request(net: Net, method: Str, url: Str, headers: List[Header], body: Str) -> Result[Conn, IoError] {
    let u = target(url)?
    if !is_token(method) {
        return Err(bad("the method is not a token"))
    }
    if !u.path.bytes().all(|b| b > 32 && b != 127) {
        return Err(bad("the URL path holds a space or control character"))
    }
    let mut all = [Header { name: "Host", value: u.host }, Header { name: "Connection", value: "close" }]
    for h in headers {
        all.push(h)
    }
    let message = head_text("{method} {u.path} HTTP/1.1", all, body)?
    let c = if u.tls { net.connect_tls(u.addr)? } else { net.connect(u.addr)? }
    match c.write(message) {
        Ok(_) => Ok(c),
        Err(e) => {
            c.close()
            Err(e)
        },
    }
}

// Send a request and pass the response body to `f` piece by piece as it
// arrives, folding it into a value, so a large body need not be held in
// memory: `request_fold(net, "GET", url, [], "", 0, |n, s| n + s.len())`.
// Returns the response, with an empty body, and the folded value.
pub fn request_fold[T](net: Net, method: Str, url: Str, headers: List[Header], body: Str, init: T, f: fn(T, Str) -> T) -> Result[(Response, T), IoError] {
    let c = send_request(net, method, url, headers, body)?
    let r = match read_status(c) {
        Ok((resp, rest)) => match read_body(c, method, resp, rest, init, f, |_| false) {
            Ok(acc) => Ok((resp, acc)),
            Err(e) => Err(e),
        },
        Err(e) => Err(e),
    }
    c.close()
    r
}

// The lines of a body not yet passed on, and whether the caller wants more.
struct Lines {
    rest: Str,
    more: Bool,
}

// Pass each complete line in `data` to `f`, keeping a partial last line.
fn split_lines(s: Lines, data: Str, f: fn(Str) -> Bool) -> Lines {
    let mut buf = s.rest + data
    let mut more = s.more
    while more {
        match buf.index_of("\n") {
            Some(i) => {
                let line = buf.slice(0, i)
                buf = buf.slice(i + 1, buf.len())
                more = f(if line.ends_with("\r") { line.slice(0, line.len() - 1) } else { line })
            },
            None => {
                if buf.len() > max_body() {
                    // a line that never ends: stop rather than hold it all
                    return Lines { rest: "", more: false }
                }
                return Lines { rest: buf, more }
            },
        }
    }
    Lines { rest: buf, more }
}

// Send a request and pass the response body to `f` a line at a time, each
// as soon as it has arrived, without its "\n" or "\r\n": for streams that
// never end, such as a Kubernetes watch, server-sent events or a log
// follow. `f` returns false to stop; the connection is closed then. Only a
// 2xx response is streamed; any other is returned with its whole body, and
// `f` is not called. Returns the response, with an empty body when streamed.
pub fn request_lines(net: Net, method: Str, url: Str, headers: List[Header], body: Str, f: fn(Str) -> Bool) -> Result[Response, IoError] {
    let c = send_request(net, method, url, headers, body)?
    let r = match read_status(c) {
        Ok((resp, rest)) if resp.status >= 200 && resp.status < 300 => {
            let lines = read_body(c, method, resp, rest, Lines { rest: "", more: true }, |s, data| split_lines(s, data, f), |s| !s.more)
            match lines {
                Ok(s) => {
                    // a last line without a line break
                    if s.more && s.rest != "" {
                        let _ = f(if s.rest.ends_with("\r") { s.rest.slice(0, s.rest.len() - 1) } else { s.rest })
                    }
                    Ok(resp)
                },
                Err(e) => Err(e),
            }
        },
        Ok((resp, rest)) => match read_body(c, method, resp, rest, "", |a, s| a + s, |_| false) {
            Ok(text) => Ok(Response { status: resp.status, headers: resp.headers, body: text }),
            Err(e) => Err(e),
        },
        Err(e) => Err(e),
    }
    c.close()
    r
}

// Send a request and read the whole response. The connection is closed
// afterwards. `net` must allow the URL's host. Unless `headers` has an
// Accept-Encoding, the request says `Accept-Encoding: gzip`, and a body
// that comes back with `Content-Encoding: gzip` (or `deflate`) is
// decompressed, up to 64 MB, with that header and Content-Length left out
// of the response, since they describe the bytes sent and not the body.
pub fn request(net: Net, method: Str, url: Str, headers: List[Header] = [], body: Str = "") -> Result[Response, IoError] {
    let mut all = headers
    if find_header(headers, "Accept-Encoding").is_none() {
        all.push(Header { name: "Accept-Encoding", value: "gzip" })
    }
    let (r, text) = request_fold(net, method, url, all, body, "", |a, s| a + s)?
    decoded(Response { status: r.status, headers: r.headers, body: text })
}

fn max_decoded() -> Int {
    67108864
}

// `r` with its body decompressed if it came with `Content-Encoding: gzip`
// or `deflate` (zlib, or the raw deflate some servers send for it).
fn decoded(r: Response) -> Result[Response, IoError] {
    let encoding = (find_header(r.headers, "Content-Encoding") ?? "").trim().to_lower()
    if r.body == "" || (encoding != "gzip" && encoding != "x-gzip" && encoding != "deflate") {
        return Ok(r)
    }
    let data = r.body.to_bytes()
    let body = if encoding == "deflate" {
        match compress.unzlib(data, max_decoded()) {
            Ok(b) => Ok(b),
            Err(e) => compress.inflate(data, max_decoded()).map_error(|_| e),
        }
    } else {
        compress.gunzip(data, max_decoded())
    }
    match body {
        Ok(b) => {
            let kept = r.headers.filter(|h| h.name.to_lower() != "content-encoding" && h.name.to_lower() != "content-length")
            Ok(Response { status: r.status, headers: kept, body: b.to_str() })
        },
        Err(e) => Err(bad("the {encoding} body: {e}")),
    }
}

pub fn get(net: Net, url: Str) -> Result[Response, IoError] {
    request(net, "GET", url, [], "")
}

pub fn post(net: Net, url: Str, content_type: Str, body: Str) -> Result[Response, IoError] {
    request(net, "POST", url, [Header { name: "Content-Type", value: content_type }], body)
}

// ---------- server ----------

// Read one request, the first bytes already in `buf`: the request and the
// bytes after it (the start of the next one). None if the peer closed
// before sending anything.
fn read_message(c: Conn, buf: Str, limits: Option[Server], head_by: By) -> Result[Option[(Request, Str)], IoError] {
    let (text, rest) = read_head(c, buf, head_by)? ?? { return Ok(None) }
    let h = parse_head(text)?
    let parts = h.first.split(" ")
    if parts.len() != 3 || !is_token(parts[0]) || parts[1] == "" || (parts[2] != "HTTP/1.1" && parts[2] != "HTTP/1.0") {
        return Err(bad("malformed request line"))
    }
    // RFC 9112 6.1 and 6.3, the strict way: a Transfer-Encoding must be
    // exactly `chunked`, never beside a Content-Length and never in an
    // HTTP/1.0 request; anything else is refused, not guessed at.
    let length = content_length(h.headers)?
    let chunked = match transfer_codings(h.headers) {
        Some(codings) => {
            if length.is_some() {
                return Err(bad("both Transfer-Encoding and Content-Length"))
            }
            if parts[2] == "HTTP/1.0" {
                return Err(bad("Transfer-Encoding in an HTTP/1.0 request"))
            }
            if codings != ["chunked"] {
                return Err(bad("unsupported Transfer-Encoding"))
            }
            true
        },
        None => false,
    }
    let n = length ?? 0
    if !chunked && n > max_body() {
        return Err(bad("request body too large"))
    }
    let body_by = deadline(limits, |s| s.body_ms)
    let (body, after) = if chunked {
        read_chunked(c, rest, max_body(), "", |a, s| a + s, |_| false, body_by)?
    } else {
        read_sized(c, rest, n, "", |a, s| a + s, |_| false, body_by)?
    }
    Ok(Some((Request { method: parts[0], path: parts[1], version: parts[2], headers: h.headers, body }, after)))
}

// Read one request from a connection. Errors if the peer closes first or
// sends more than 64 KiB of headers or 8 MiB of body. Chunked request
// bodies are decoded.
pub fn read_request(c: Conn) -> Result[Request, IoError] {
    match read_message(c, "", None, None)? {
        Some((r, _)) => Ok(r),
        None => Err(bad("connection closed before the request was complete")),
    }
}

// Whether the client wants the connection kept open after this request.
fn keeps_alive(r: Request) -> Bool {
    if has_token(r.headers, "Connection", "close") {
        return false
    }
    if r.version == "HTTP/1.0" {
        return has_token(r.headers, "Connection", "keep-alive")
    }
    true
}

fn send(c: Conn, r: Response, keep: Bool, head_only: Bool, by: By) -> Result[(), IoError] {
    let mut hs = r.headers
    if find_header(hs, "Connection").is_none() {
        hs.push(Header { name: "Connection", value: if keep { "keep-alive" } else { "close" } })
    }
    if r.status < 100 || r.status > 999 {
        return Err(bad("the status {r.status} is not three digits"))
    }
    let t = head_text("HTTP/1.1 {r.status} {reason(r.status)}", hs, r.body)?
    let out = if head_only { t.slice(0, t.len() - r.body.len()) } else { t }
    match by {
        Some((clock, at)) => c.write_within(clock, (at - clock.now_ms()).max(0), out),
        None => c.write(out),
    }
}

// The answer when the handler for `req` panicked.
fn failed(req: Request) -> Response {
    error_for(req, 500, "The server ran into an error while answering this request.", "internal error")
}

// `r`, or a 500 if it could not be sent as it is (a bad header or status).
fn sendable(r: Response) -> Response {
    let ok = r.status >= 100 && r.status <= 999 && check_headers(r.headers).is_ok() && transfer_codings(r.headers).is_none() && content_length(r.headers).is_ok()
    if ok { r } else { text(500, "internal error") }
}

// Write a whole response, saying the connection will close. An error, with
// nothing written, for a header name that is not a token, a header value
// with CR, LF, NUL or another control byte, a Transfer-Encoding header, a
// Content-Length that is not digits, or a status outside 100 to 999.
pub fn write_response(c: Conn, r: Response) -> Result[(), IoError] {
    send(c, r, false, false, None)
}

// Start a response whose body follows in pieces: the status line and
// headers, with `Transfer-Encoding: chunked`. Then call `write_chunk` for
// each piece and `end_body` once. Headers are refused as in
// `write_response`, and so is any Content-Length or Transfer-Encoding,
// which would contradict the chunked body.
pub fn write_head(c: Conn, status: Int, headers: List[Header]) -> Result[(), IoError] {
    if status < 100 || status > 999 {
        return Err(bad("the status {status} is not three digits"))
    }
    check_headers(headers)?
    if find_header(headers, "Content-Length").is_some() || transfer_codings(headers).is_some() {
        return Err(bad("write_head sets the framing itself: no Content-Length or Transfer-Encoding"))
    }
    let mut s = "HTTP/1.1 {status} {reason(status)}\r\n"
    for h in headers {
        s = s + h.name + ": " + h.value + "\r\n"
    }
    c.write(s + "Transfer-Encoding: chunked\r\n\r\n")
}

// Send one piece of a body started with `write_head`. An empty piece sends
// nothing (an empty chunk would end the body).
pub fn write_chunk(c: Conn, data: Str) -> Result[(), IoError] {
    if data == "" {
        return Ok(())
    }
    c.write(format.hex(data.len()) + "\r\n" + data + "\r\n")
}

// End a body started with `write_head`.
pub fn end_body(c: Conn) -> Result[(), IoError] {
    c.write("0\r\n\r\n")
}

// Answer one request on a connection with `handler`'s response, then
// close it. A malformed request gets 400; a handler that panics gets 500.
// True if it was answered.
pub fn handle(c: Conn, handler: fn(Request) -> Response) -> Bool {
    let r = match read_request(c) {
        Ok(req) => sendable(catch(|| handler(req)) ?? failed(req)),
        Err(_) => text(400, "bad request\n"),
    }
    let ok = write_response(c, r).is_ok()
    c.close()
    ok
}

// Answer requests on a connection until the client closes it or asks to
// (`Connection: close`, or HTTP/1.0 without keep-alive), then close it.
// Requests may be pipelined. A malformed request gets 400 and ends the
// connection; a handler that panics gets 500 and the connection goes on.
// HEAD requests get the headers only. Returns how many were answered.
// No time limits: a client may take as long as it likes (see `Server`).
pub fn serve_conn(c: Conn, handler: fn(Request) -> Response) -> Int {
    let n = conn_loop(c, None, handler, atomic(0))
    c.close()
    n
}

fn conn_loop(c: Conn, limits: Option[Server], handler: fn(Request) -> Response, answered: Atomic) -> Int {
    let mut buf = ""
    let mut open = true
    while open {
        // wait for a request's first bytes: idle time between requests,
        // part of the head's time for the first one. A client that sends
        // nothing in that time is closed without a reply.
        let first = answered.get() == 0
        let mut head_by = deadline(limits, |s| s.head_ms)
        if buf == "" {
            let wait_by = if first { head_by } else { deadline(limits, |s| s.idle_ms) }
            match read_by(c, wait_by) {
                Ok(more) => {
                    buf = more
                    if more == "" {
                        return answered.get()
                    }
                },
                Err(_) => { return answered.get() },
            }
            if !first {
                head_by = deadline(limits, |s| s.head_ms)
            }
        }
        match read_message(c, buf, limits, head_by) {
            Ok(Some((req, rest))) => {
                let r = sendable(catch(|| handler(req)) ?? failed(req))
                let keep = keeps_alive(req) && answered.get() + 1 < max_requests() && !has_token(r.headers, "Connection", "close")
                if send(c, r, keep, req.method == "HEAD", deadline(limits, |s| s.write_ms)).is_ok() {
                    let _ = answered.add(1)
                } else {
                    open = false
                }
                if !keep {
                    open = false
                }
                buf = rest
            },
            Ok(None) => { open = false },
            Err(e) => {
                let r = if is_timeout(e) { text(408, "request timeout\n") } else { text(400, "bad request\n") }
                let _ = send(c, r, false, false, deadline(limits, |s| s.write_ms))
                open = false
            },
        }
    }
    answered.get()
}

// Like `serve_conn`, for handlers that write the response themselves: a
// streamed one with `write_head`, `write_chunk` and `end_body`, or
// `write_response`. The request body is read whole first. A handler that
// returns an error or panics closes the connection. Returns how many
// requests were handled.
pub fn serve_stream(c: Conn, handler: fn(Request, Conn) -> Result[(), IoError]) -> Int {
    let n = stream_loop(c, None, handler, atomic(0))
    c.close()
    n
}

fn stream_loop(c: Conn, limits: Option[Server], handler: fn(Request, Conn) -> Result[(), IoError], handled: Atomic) -> Int {
    let mut buf = ""
    let mut open = true
    while open {
        // wait for a request's first bytes: idle time between requests,
        // part of the head's time for the first one. A client that sends
        // nothing in that time is closed without a reply.
        let first = handled.get() == 0
        let mut head_by = deadline(limits, |s| s.head_ms)
        if buf == "" {
            let wait_by = if first { head_by } else { deadline(limits, |s| s.idle_ms) }
            match read_by(c, wait_by) {
                Ok(more) => {
                    buf = more
                    if more == "" {
                        return handled.get()
                    }
                },
                Err(_) => { return handled.get() },
            }
            if !first {
                head_by = deadline(limits, |s| s.head_ms)
            }
        }
        match read_message(c, buf, limits, head_by) {
            Ok(Some((req, rest))) => {
                let ok = match catch(|| handler(req, c)) {
                    Ok(Ok(_)) => true,
                    _ => false,
                }
                if ok {
                    let _ = handled.add(1)
                }
                if !ok || !keeps_alive(req) || handled.get() >= max_requests() {
                    open = false
                }
                buf = rest
            },
            Ok(None) => { open = false },
            Err(e) => {
                let r = if is_timeout(e) { text(408, "request timeout\n") } else { text(400, "bad request\n") }
                let _ = send(c, r, false, false, deadline(limits, |s| s.write_ms))
                open = false
            },
        }
    }
    handled.get()
}

// Accept `count` connections, each served by `serve_conn` in its own task,
// and return how many requests were answered. The handler gets no
// capabilities unless its closure captures them. What handlers print goes
// out as they print it: a connection's output does not wait for earlier ones.
pub fn serve(l: Listener, count: Int, handler: fn(Request) -> Response) -> Int {
    let answered = group g interleaved {
        let mut i = 0
        while i < count {
            match l.accept() {
                Ok(c) => g.go(|| serve_conn(c, handler)),
                Err(_) => { i = count },
            }
            i = i + 1
        }
    }
    answered.sum()
}

// Accept connections until accepting fails, typically because the listener
// was closed, running `f` on each in its own task. Waits for those tasks,
// then returns the error that stopped it. Output from the tasks goes out as
// they print it, as in `serve`.
pub fn accept_forever(l: Listener, f: fn(Conn) -> Int) -> IoError {
    let mut stop = Failed("")
    let _ = group g interleaved {
        let mut open = true
        while open {
            match l.accept() {
                // a task that returns () keeps nothing once it ends, so
                // a server that runs for days stays the same size
                Ok(c) => g.go(|| {
                    let _ = f(c)
                }),
                Err(e) => {
                    stop = e
                    open = false
                },
            }
        }
    }
    stop
}

// Serve every connection with `serve_conn` until the listener is closed
// (by another task holding it) or fails; returns that error.
pub fn serve_forever(l: Listener, handler: fn(Request) -> Response) -> IoError {
    accept_forever(l, |c| serve_conn(c, handler))
}

// ---------- time limits ----------

// Time limits for a server's connections, with the Clock that measures
// them. Without them one slow client holds a task for as long as it likes,
// sending a byte now and then (slowloris). Make one with `server(clock)`
// and change the fields you want; `0` turns a limit off.
//
//   let s = http.server(root.clock)
//   s.serve_forever(listener, handler)
pub struct Server {
    clock: Clock,
    head_ms: Int,    // a request's line and headers, from when the server starts reading them
    body_ms: Int,    // its body, after the headers
    write_ms: Int,   // sending a response
    idle_ms: Int,    // a kept-alive connection waiting for its next request
    conn_ms: Int,    // the whole connection, handlers included
}

// The default limits: 10 s for the headers, 30 s for the body and for
// writing the response, 60 s idle between requests, 10 minutes for a
// connection. A request that runs out of time before it is complete gets
// 408 and the connection is closed; an idle connection is just closed.
pub fn server(clock: Clock) -> Server {
    Server { clock, head_ms: 10000, body_ms: 30000, write_ms: 30000, idle_ms: 60000, conn_ms: 600000 }
}

// When a phase whose limit `ms` picks must end, starting now; none
// without limits or when the limit is 0.
fn deadline(limits: Option[Server], ms: fn(Server) -> Int) -> By {
    match limits {
        Some(s) => if ms(s) > 0 { Some((s.clock, s.clock.now_ms() + ms(s))) } else { None },
        None => None,
    }
}

fn is_timeout(e: IoError) -> Bool {
    match e {
        Failed(m) => m.starts_with("timed out after "),
        _ => false,
    }
}

// The whole connection within `conn_ms`, then closed. Returns how many
// requests `run` answered, including those before a timeout.
fn whole_conn(self: Server, c: Conn, run: fn(Atomic) -> Int) -> Int {
    let count = atomic(0)
    if self.conn_ms <= 0 {
        let _ = run(count)
    } else {
        let _ = group g interleaved until self.clock.after(self.conn_ms) {
            g.go(|| run(count))
        }
    }
    c.close()
    count.get()
}

// `serve_conn` within these limits.
pub fn serve_conn(self: Server, c: Conn, handler: fn(Request) -> Response) -> Int {
    self.whole_conn(c, |count| conn_loop(c, Some(self), handler, count))
}

// `serve_stream` within these limits. The handler's own writes count
// toward the connection's limit only.
pub fn serve_stream(self: Server, c: Conn, handler: fn(Request, Conn) -> Result[(), IoError]) -> Int {
    self.whole_conn(c, |count| stream_loop(c, Some(self), handler, count))
}

// `serve` within these limits.
pub fn serve(self: Server, l: Listener, count: Int, handler: fn(Request) -> Response) -> Int {
    let answered = group g interleaved {
        let mut i = 0
        while i < count {
            match l.accept() {
                Ok(c) => g.go(|| self.serve_conn(c, handler)),
                Err(_) => { i = count },
            }
            i = i + 1
        }
    }
    answered.sum()
}

// `serve_forever` within these limits.
pub fn serve_forever(self: Server, l: Listener, handler: fn(Request) -> Response) -> IoError {
    accept_forever(l, |c| self.serve_conn(c, handler))
}

// ---------- routing ----------

// What a route's pattern captured from the path: `id` in
// "GET /todos/:id". Values are percent-decoded.
pub struct Params {
    pairs: List[(Str, Str)],
}

// The value captured as `:name` or `*name`.
pub fn get(self: Params, name: Str) -> Option[Str] {
    self.pairs.find(|p| p.0 == name).map(|p| p.1)
}

// The value captured as `:name`, if it is a whole number.
pub fn int(self: Params, name: Str) -> Option[Int] {
    self.get(name).flat_map(|s| s.parse_int())
}

// A pattern and the handler for requests that match it. The pattern is a
// method, a space and a path ("GET /todos/:id"), or a path alone for any
// method. In the path, `:name` matches one segment and `*name`, last,
// matches the rest, possibly nothing.
pub type Route = (Str, fn(Request, Params) -> Response)

fn bad_pattern(pattern: Str, why: Str) -> (Str, List[Str]) {
    panic("http.route: pattern `{pattern}` {why}")
}

// "GET /todos/:id" -> ("GET", ["todos", ":id"])
fn parse_pattern(pattern: Str) -> (Str, List[Str]) {
    let words = pattern.split(" ")
    let (method, path) = match words.len() {
        1 => ("", words[0]),
        2 => (words[0], words[1]),
        _ => { return bad_pattern(pattern, "has more than a method and a path") },
    }
    if method != "" && !is_token(method) {
        return bad_pattern(pattern, "has a method that is not a token")
    }
    if !path.starts_with("/") {
        return bad_pattern(pattern, "has a path that does not start with `/`")
    }
    let segs = path.split("/").filter(|s| !s.is_empty())
    for (i, s) in segs.with_index() {
        if s.starts_with("*") && i + 1 < segs.len() {
            return bad_pattern(pattern, "has `{s}` before its last segment")
        }
    }
    (method, segs)
}

// "/todos/a%20b?x=1" -> Some(["todos", "a b"]); None if an escape is malformed.
// Empty segments are dropped, so "/todos/" is "/todos".
fn segments(path: Str) -> Option[List[Str]] {
    let mut out: List[Str] = []
    for s in path.split("?")[0].split("/") {
        if !s.is_empty() {
            match url.decode(s) {
                Ok(d) => out.push(d),
                Err(_) => { return None },
            }
        }
    }
    Some(out)
}

fn capture_name(seg: Str) -> Option[Str] {
    if seg.starts_with(":") || seg.starts_with("*") {
        Some(seg.slice(1, seg.len()))
    } else {
        None
    }
}

fn capture(pattern: List[Str], path: List[Str]) -> Option[List[(Str, Str)]] {
    let mut out: List[(Str, Str)] = []
    for (i, seg) in pattern.with_index() {
        if seg.starts_with("*") {
            out.push((capture_name(seg) ?? "", path.skip(i).join("/")))
            return Some(out)
        }
        if i >= path.len() {
            return None
        }
        match capture_name(seg) {
            Some(name) => out.push((name, path[i])),
            None => {
                if seg != path[i] {
                    return None
                }
            },
        }
    }
    if pattern.len() == path.len() { Some(out) } else { None }
}

// A route, with its pattern checked now: `http.on("GET /todos/:id", |r, p| ...)`.
// A malformed pattern panics.
pub fn on(pattern: Str, handler: fn(Request, Params) -> Response) -> Route {
    let _ = parse_pattern(pattern)
    (pattern, handler)
}

// Answer `r` with the first route whose pattern matches its method and path
// (the query string is ignored, and a GET route answers HEAD too). When a
// path matches but no method does, the answer is 405 with an `Allow`
// header; when no path matches, 404. A malformed pattern panics, which
// `serve_conn` answers with 500.
pub fn route(r: Request, routes: List[Route]) -> Response {
    let path = match segments(r.path) {
        Some(p) => p,
        None => { return text(400, "bad request\n") },
    }
    let mut allowed: List[Str] = []
    for (pattern, handler) in routes {
        let (method, segs) = parse_pattern(pattern)
        match capture(segs, path) {
            None => {},
            Some(pairs) => {
                if method == "" || method == r.method || (method == "GET" && r.method == "HEAD") {
                    return handler(r, Params { pairs })
                }
                if !allowed.contains(method) {
                    allowed.push(method)
                }
            },
        }
    }
    if allowed.is_empty() {
        return error_for(r, 404, "Nothing is served at {r.path}.", "not found\n")
    }
    if allowed.contains("GET") && !allowed.contains("HEAD") {
        allowed.push("HEAD")
    }
    let r405 = error_for(r, 405, "{r.path} does not answer {r.method}. It answers {allowed.join(", ")}.", "method not allowed\n")
    { r405 with headers: r405.headers + [Header { name: "Allow", value: allowed.join(", ") }] }
}
