// Unicode 17.0.0 beyond `chars()`: case folding, full upper and lower case,
// and the normal forms NFC and NFD, for comparing text that people
// typed. Pure functions of text; nothing to grant.
//
//   unicode.fold("Straße") == unicode.fold("STRASSE")      // true: compare ignoring case
//   unicode.nfc("e\u{301}") == "\u{e9}"                       // true: one form for the same text
//   unicode.upper("ﬁx") is "FIX", unicode.code_points("é") is [233]
//
// A character is a `Str` holding one code point (`chars()`), and its
// number an `Int`. Malformed UTF-8 reads as U+FFFD. Case mapping is per
// code point: a final sigma lowers to `σ`, not `ς`. The tables below are
// generated from Unicode 17.0.0 (Python's unicodedata); they are functions
// rather than data, so a native program looks a code point up with one
// switch and builds nothing at start.

// The code points of `s`.
pub fn code_points(s: Str) -> List[Int] {
    let bs = s.bytes()
    let n = bs.len()
    let mut out: List[Int] = []
    let mut i = 0
    while i < n {
        let b = bs[i]
        let (len, first) = if b < 0x80 { (1, b) } else if b >= 0xc2 && b < 0xe0 { (2, b & 0x1f) } else if b >= 0xe0 && b < 0xf0 { (3, b & 0x0f) } else if b >= 0xf0 && b < 0xf5 { (4, b & 0x07) } else { (0, 0) }
        let mut cp = first
        let mut ok = len > 0 && i + len <= n
        if ok {
            for k in 1..<len {
                let c = bs[i + k]
                if c & 0xc0 != 0x80 {
                    ok = false
                }
                cp = cp << 6 | (c & 0x3f)
            }
        }
        // overlong forms, surrogates and past U+10FFFF are malformed too
        if ok && ((len == 3 && cp < 0x800) || (len == 4 && cp < 0x10000) || (cp >= 0xd800 && cp <= 0xdfff) || cp > 0x10ffff) {
            ok = false
        }
        if ok {
            out.push(cp)
            i = i + len
        } else {
            out.push(0xfffd)
            i = i + 1
        }
    }
    out
}

// The text of code points.
pub fn from_code_points(cps: List[Int]) -> Str {
    cps.map(|c| c.to_char()).join("")
}

// `s` case-folded: the form to compare text in when case does not
// matter. Folding maps `ß` to `ss` and `ﬁ` to `fi`, so lengths can change.
pub fn fold(s: Str) -> Str {
    map_each(s, 0)
}

// `s` in upper case, by the full Unicode mappings: `ß` becomes `SS`.
pub fn upper(s: Str) -> Str {
    map_each(s, 1)
}

// `s` in lower case, by the full Unicode mappings.
pub fn lower(s: Str) -> Str {
    map_each(s, 2)
}

// Whether `a` and `b` are the same text once case and the way accents
// were typed are set aside.
pub fn same_ignoring_case(a: Str, b: Str) -> Bool {
    fold(nfd(a)) == fold(nfd(b))
}

fn map_each(s: Str, which: Int) -> Str {
    let mut out: List[Str] = []
    for cp in code_points(s) {
        let m = if which == 0 { fold_of(cp) } else if which == 1 { upper_of(cp) } else { lower_of(cp) }
        out.push(if m == "" { cp.to_char() } else { m })
    }
    out.join("")
}

// `s` in Normalization Form D: every character taken apart into its
// base and combining marks, the marks in their canonical order.
pub fn nfd(s: Str) -> Str {
    from_code_points(decompose(code_points(s)))
}

// `s` in Normalization Form C: taken apart, then put back together into
// the fewest characters (`e` and a combining acute become `é`).
pub fn nfc(s: Str) -> Str {
    from_code_points(compose(decompose(code_points(s))))
}

// Hangul syllables are taken apart and put together by formula.
fn s_base() -> Int { 0xac00 }

fn l_base() -> Int { 0x1100 }

fn v_base() -> Int { 0x1161 }

fn t_base() -> Int { 0x11a7 }

fn decompose(cps: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    for cp in cps {
        out = push_decomposed(out, cp)
    }
    reorder(out)
}

// `out` with the full canonical decomposition of `cp` after it.
fn push_decomposed(out: List[Int], cp: Int) -> List[Int] {
    let mut o = out
    if cp >= s_base() && cp < s_base() + 11172 {
        let i = cp - s_base()
        o.push(l_base() + i / 588)
        o.push(v_base() + i % 588 / 28)
        if i % 28 != 0 {
            o.push(t_base() + i % 28)
        }
        return o
    }
    let parts = decomposition_of(cp)
    if parts.is_empty() {
        o.push(cp)
        return o
    }
    for p in parts {
        o = push_decomposed(o, p)
    }
    o
}

// Combining marks in a row sorted by their class, a stable sort.
fn reorder(cps: List[Int]) -> List[Int] {
    let mut xs = cps
    let n = xs.len()
    let mut i = 0
    while i < n {
        if combining_class(xs[i]) == 0 {
            i = i + 1
            continue
        }
        let mut j = i
        while j < n && combining_class(xs[j]) != 0 {
            j = j + 1
        }
        // an insertion sort over the run xs[i..j]
        for k in i + 1..<j {
            let mut m = k
            while m > i && combining_class(xs[m - 1]) > combining_class(xs[m]) {
                let t = xs[m - 1]
                xs[m - 1] = xs[m]
                xs[m] = t
                m = m - 1
            }
        }
        i = j
    }
    xs
}

// The canonical composition of decomposed, ordered code points.
fn compose(cps: List[Int]) -> List[Int] {
    if cps.is_empty() {
        return cps
    }
    let mut out: List[Int] = []
    // where the last starter is in `out` (-1 for none), and the class of
    // the last mark after it (-1 when nothing follows it)
    let mut starter = -1
    let mut last_class = -1
    for cp in cps {
        let class = combining_class(cp)
        // a mark joins its starter unless a mark of the same or a higher
        // class came between them
        let joined = if starter >= 0 && (last_class == -1 || last_class < class) { pair(out[starter], cp) } else { -1 }
        if joined >= 0 {
            out[starter] = joined
        } else {
            if class == 0 {
                starter = out.len()
                last_class = -1
            } else {
                last_class = class
            }
            out.push(cp)
        }
    }
    out
}

// The composition of a starter and the code point after it, or -1.
fn pair(a: Int, b: Int) -> Int {
    // Hangul: a leading and a vowel jamo, or an LV syllable and a trailing jamo
    if a >= l_base() && a < l_base() + 19 && b >= v_base() && b < v_base() + 21 {
        return s_base() + ((a - l_base()) * 21 + (b - v_base())) * 28
    }
    if a >= s_base() && a < s_base() + 11172 && (a - s_base()) % 28 == 0 && b > t_base() && b < t_base() + 28 {
        return a + (b - t_base())
    }
    composed(a * 0x110000 + b)
}

