// Cryptographic hashes over Bytes: SHA-256 (FIPS 180-4) and HMAC-SHA-256
// (RFC 2104) for checksums, signatures and keys; SHA-1 and MD5 only for
// formats that still name them (git object ids, ETags, older protocols),
// since both are broken for security. Digests are Bytes; the `_hex`
// functions give them as lowercase hex, as checksum tools print them.
//
// Each hash can also be computed a piece at a time, for data that arrives
// in chunks or is too big to hold at once: start a Hasher, feed it with
// `update`, and `finish` it. Any split of the data gives the same digest.
//
// A 32-bit word is an Int from 0 to 2^32 - 1, kept there with `& mask()`.
use hex

// The SHA-256 digest of `data`: 32 bytes.
pub fn sha256(data: Bytes) -> Bytes {
    sha256_new().update(data).finish()
}

// `sha256(data)` as 64 hex digits:
// `sha256_hex("abc".to_bytes())` is `"ba7816bf...f20015ad"`.
pub fn sha256_hex(data: Bytes) -> Str {
    hex.encode(sha256(data))
}

// The HMAC-SHA-256 of `data` under `key` (RFC 2104): 32 bytes. Any key
// length works; one longer than 64 bytes is hashed first, as the RFC says.
// Compare a MAC you are given with `equal`, not `==`.
pub fn hmac_sha256(key: Bytes, data: Bytes) -> Bytes {
    hmac_sha256_new(key).update(data).finish()
}

// `hmac_sha256(key, data)` as 64 hex digits.
pub fn hmac_sha256_hex(key: Bytes, data: Bytes) -> Str {
    hex.encode(hmac_sha256(key, data))
}

// The SHA-1 digest of `data`: 20 bytes. Broken for security (collisions
// can be made); for formats that name it.
pub fn sha1(data: Bytes) -> Bytes {
    sha1_new().update(data).finish()
}

// `sha1(data)` as 40 hex digits.
pub fn sha1_hex(data: Bytes) -> Str {
    hex.encode(sha1(data))
}

// The HMAC-SHA-1 of `data` under `key`: 20 bytes, for protocols that
// name it (TOTP, older webhooks).
pub fn hmac_sha1(key: Bytes, data: Bytes) -> Bytes {
    hmac_sha1_new(key).update(data).finish()
}

// The MD5 digest of `data` (RFC 1321): 16 bytes. Broken for security; for
// checksums and formats that name it.
pub fn md5(data: Bytes) -> Bytes {
    md5_new().update(data).finish()
}

// `md5(data)` as 32 hex digits.
pub fn md5_hex(data: Bytes) -> Str {
    hex.encode(md5(data))
}

// Whether `a` and `b` hold the same bytes, taking the same time wherever
// they differ, so checking a MAC or a token does not tell an attacker how
// much of a guess was right. (Their lengths are not secret.)
pub fn equal(a: Bytes, b: Bytes) -> Bool {
    if a.len() != b.len() {
        return false
    }
    let mut diff = 0
    for i in 0..<a.len() {
        diff = diff | a[i] ^ b[i]
    }
    diff == 0
}

// Bytes as lowercase hex digits.
pub fn hex(data: Bytes) -> Str {
    hex.encode(data)
}

// ---------- hashing a piece at a time ----------

// The hash functions a Hasher computes.
pub enum Algo {
    Sha256,
    Sha1,
    Md5,
}

// A hash in progress: the data fed to it so far, as a state of 32-bit
// words and the last block's bytes. It is a plain value, so `update`
// returns the next one and the old one still stands for the data before:
// feed a common prefix once and finish copies with different endings.
//
//     let mut h = hash.sha256_new()
//     for chunk in chunks {
//         h = h.update(chunk)
//     }
//     let digest = h.finish()
pub struct Hasher {
    algo: Algo,
    // the words after every full 64-byte block so far
    state: List[Int],
    // the bytes after them: fewer than 64
    pending: Bytes,
    // how many bytes have been fed
    length: Int,
    // for an HMAC, the key's outer block, hashed before the inner digest
    // when the hasher finishes; empty for a plain hash
    outer: Bytes,
}

// A Hasher for SHA-256.
pub fn sha256_new() -> Hasher {
    new(Sha256)
}

// A Hasher for SHA-1.
pub fn sha1_new() -> Hasher {
    new(Sha1)
}

// A Hasher for MD5.
pub fn md5_new() -> Hasher {
    new(Md5)
}

// A Hasher for the HMAC-SHA-256 of what it is fed, under `key`: its
// `finish` gives what `hmac_sha256(key, data)` gives.
pub fn hmac_sha256_new(key: Bytes) -> Hasher {
    hmac_new(Sha256, key)
}

// A Hasher for the HMAC-SHA-1 of what it is fed, under `key`.
pub fn hmac_sha1_new(key: Bytes) -> Hasher {
    hmac_new(Sha1, key)
}

// A Hasher for `algo`, fed nothing yet.
pub fn new(algo: Algo) -> Hasher {
    let state = match algo {
        Sha256 => [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
        Sha1 => [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0],
        Md5 => [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476],
    }
    Hasher { algo, state, pending: bytes([]), length: 0, outer: bytes([]) }
}

// The hasher fed `data` after what it was fed before. Whole 64-byte
// blocks are hashed straight from `data`; only the bytes of an unfinished
// block are kept.
pub fn update(self: Hasher, data: Bytes) -> Hasher {
    let mut h = self
    let n = data.len()
    let mut at = 0
    if h.pending.len() > 0 {
        let need = 64 - h.pending.len()
        if n < need {
            h.pending = h.pending + data
            h.length = h.length + n
            return h
        }
        h.state = blocks(h.algo, h.state, h.pending + data.slice(0, need), 0, 1)
        at = need
    }
    let full = (n - at) / 64
    h.state = blocks(h.algo, h.state, data, at, full)
    h.pending = data.slice(at + full * 64, n)
    h.length = h.length + n
    h
}

// The digest of everything the hasher was fed: 32 bytes for SHA-256, 20
// for SHA-1, 16 for MD5, the MAC for an HMAC hasher.
pub fn finish(self: Hasher) -> Bytes {
    let big = match self.algo {
        Md5 => false,
        _ => true,
    }
    let tail = padding(self.pending, self.length, big)
    let words = blocks(self.algo, self.state, tail, 0, tail.len() / 64)
    let digest = if big { words_big(words) } else { words_little(words) }
    if self.outer.is_empty() {
        digest
    } else {
        new(self.algo).update(self.outer).update(digest).finish()
    }
}

// `finish()` as lowercase hex digits.
pub fn finish_hex(self: Hasher) -> Str {
    hex.encode(self.finish())
}

// ---------- HMAC ----------

// The key padded to a block (hashed first when longer), XORed with the
// inner pad starts the inner hash; with the outer pad it is kept for
// `finish`.
fn hmac_new(algo: Algo, key: Bytes) -> Hasher {
    let k = if key.len() > 64 { new(algo).update(key).finish() } else { key }
    let mut inner: List[Int] = []
    let mut outer: List[Int] = []
    for i in 0..<64 {
        let b = k.get(i) ?? 0
        inner.push(b ^ 54)
        outer.push(b ^ 92)
    }
    let mut h = new(algo).update(bytes(inner))
    h.outer = bytes(outer)
    h
}

// The state after `count` 64-byte blocks of `data` starting at byte `at`.
fn blocks(algo: Algo, state: List[Int], data: Bytes, at: Int, count: Int) -> List[Int] {
    if count == 0 {
        return state
    }
    match algo {
        Sha256 => sha256_blocks(state, data, at, count),
        Sha1 => sha1_blocks(state, data, at, count),
        Md5 => md5_blocks(state, data, at, count),
    }
}

// ---------- the compression functions ----------

fn mask() -> Int {
    0xffff_ffff
}

fn rotr(x: Int, n: Int) -> Int {
    (x >> n | x << (32 - n)) & mask()
}

fn rotl(x: Int, n: Int) -> Int {
    (x << n | x >> (32 - n)) & mask()
}

// The last one or two blocks: `rest`, the bytes after the last full
// block, then a 1 bit, zeros, and the length of all the data (`total`
// bytes) in bits as 8 bytes, big-endian for the SHAs and little-endian
// for MD5.
fn padding(rest: Bytes, total: Int, big: Bool) -> Bytes {
    let mut out = rest.to_list()
    out.push(128)
    while out.len() % 64 != 56 {
        out.push(0)
    }
    let bits = total * 8
    for i in 0..<8 {
        out.push(bits >> (8 * (if big { 7 - i } else { i })) & 255)
    }
    bytes(out)
}

// Words as bytes, low byte first.
fn words_little(ws: List[Int]) -> Bytes {
    let mut out: List[Int] = []
    for w in ws {
        for i in 0..<4 {
            out.push(w >> (8 * i) & 255)
        }
    }
    bytes(out)
}

// Words as bytes, high byte first.
fn words_big(ws: List[Int]) -> Bytes {
    let mut out: List[Int] = []
    for w in ws {
        out.push(w >> 24 & 255)
        out.push(w >> 16 & 255)
        out.push(w >> 8 & 255)
        out.push(w & 255)
    }
    bytes(out)
}

// The SHA-256 round constants: the first 32 bits of the fractional parts
// of the cube roots of the first 64 primes.
fn sha256_k() -> List[Int] {
    [
        0x428a2f98,
        0x71374491,
        0xb5c0fbcf,
        0xe9b5dba5,
        0x3956c25b,
        0x59f111f1,
        0x923f82a4,
        0xab1c5ed5,
        0xd807aa98,
        0x12835b01,
        0x243185be,
        0x550c7dc3,
        0x72be5d74,
        0x80deb1fe,
        0x9bdc06a7,
        0xc19bf174,
        0xe49b69c1,
        0xefbe4786,
        0x0fc19dc6,
        0x240ca1cc,
        0x2de92c6f,
        0x4a7484aa,
        0x5cb0a9dc,
        0x76f988da,
        0x983e5152,
        0xa831c66d,
        0xb00327c8,
        0xbf597fc7,
        0xc6e00bf3,
        0xd5a79147,
        0x06ca6351,
        0x14292967,
        0x27b70a85,
        0x2e1b2138,
        0x4d2c6dfc,
        0x53380d13,
        0x650a7354,
        0x766a0abb,
        0x81c2c92e,
        0x92722c85,
        0xa2bfe8a1,
        0xa81a664b,
        0xc24b8b70,
        0xc76c51a3,
        0xd192e819,
        0xd6990624,
        0xf40e3585,
        0x106aa070,
        0x19a4c116,
        0x1e376c08,
        0x2748774c,
        0x34b0bcb5,
        0x391c0cb3,
        0x4ed8aa4a,
        0x5b9cca4f,
        0x682e6ff3,
        0x748f82ee,
        0x78a5636f,
        0x84c87814,
        0x8cc70208,
        0x90befffa,
        0xa4506ceb,
        0xbef9a3f7,
        0xc67178f2,
    ]
}

fn sha256_blocks(state: List[Int], data: Bytes, from: Int, count: Int) -> List[Int] {
    let k = sha256_k()
    let m = mask()
    let mut h0 = state[0]
    let mut h1 = state[1]
    let mut h2 = state[2]
    let mut h3 = state[3]
    let mut h4 = state[4]
    let mut h5 = state[5]
    let mut h6 = state[6]
    let mut h7 = state[7]
    let mut w: List[Int] = []
    for _ in 0..<64 {
        w.push(0)
    }
    for blk in 0..<count {
        let at = from + blk * 64
        for t in 0..<16 {
            let i = at + t * 4
            w[t] = data[i] << 24 | data[i + 1] << 16 | data[i + 2] << 8 | data[i + 3]
        }
        for t in 16..<64 {
            let x = w[t - 15]
            let y = w[t - 2]
            let s0 = rotr(x, 7) ^ rotr(x, 18) ^ x >> 3
            let s1 = rotr(y, 17) ^ rotr(y, 19) ^ y >> 10
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & m
        }
        let mut a = h0
        let mut b = h1
        let mut c = h2
        let mut d = h3
        let mut e = h4
        let mut f = h5
        let mut g = h6
        let mut h = h7
        for t in 0..<64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch = e & f ^ ~e & g
            let t1 = (h + s1 + ch + k[t] + w[t]) & m
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj = a & b ^ a & c ^ b & c
            h = g
            g = f
            f = e
            e = (d + t1) & m
            d = c
            c = b
            b = a
            a = (t1 + s0 + maj) & m
        }
        h0 = (h0 + a) & m
        h1 = (h1 + b) & m
        h2 = (h2 + c) & m
        h3 = (h3 + d) & m
        h4 = (h4 + e) & m
        h5 = (h5 + f) & m
        h6 = (h6 + g) & m
        h7 = (h7 + h) & m
    }
    [h0, h1, h2, h3, h4, h5, h6, h7]
}

fn sha1_blocks(state: List[Int], data: Bytes, from: Int, count: Int) -> List[Int] {
    let m = mask()
    let mut h0 = state[0]
    let mut h1 = state[1]
    let mut h2 = state[2]
    let mut h3 = state[3]
    let mut h4 = state[4]
    let mut w: List[Int] = []
    for _ in 0..<80 {
        w.push(0)
    }
    for blk in 0..<count {
        let at = from + blk * 64
        for t in 0..<16 {
            let i = at + t * 4
            w[t] = data[i] << 24 | data[i + 1] << 16 | data[i + 2] << 8 | data[i + 3]
        }
        for t in 16..<80 {
            w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
        }
        let mut a = h0
        let mut b = h1
        let mut c = h2
        let mut d = h3
        let mut e = h4
        for t in 0..<80 {
            let (f, k) = if t < 20 {
                (b & c | ~b & d, 0x5a827999)
            } else if t < 40 {
                (b ^ c ^ d, 0x6ed9eba1)
            } else if t < 60 {
                (b & c | b & d | c & d, 0x8f1bbcdc)
            } else {
                (b ^ c ^ d, 0xca62c1d6)
            }
            let next = (rotl(a, 5) + (f & m) + e + k + w[t]) & m
            e = d
            d = c
            c = rotl(b, 30)
            b = a
            a = next
        }
        h0 = (h0 + a) & m
        h1 = (h1 + b) & m
        h2 = (h2 + c) & m
        h3 = (h3 + d) & m
        h4 = (h4 + e) & m
    }
    [h0, h1, h2, h3, h4]
}

