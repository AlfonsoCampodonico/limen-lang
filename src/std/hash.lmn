}

// The rotation of each MD5 step.
fn md5_shifts() -> List[Int] {
    [
        7,
        12,
        17,
        22,
        7,
        12,
        17,
        22,
        7,
        12,
        17,
        22,
        7,
        12,
        17,
        22,
        5,
        9,
        14,
        20,
        5,
        9,
        14,
        20,
        5,
        9,
        14,
        20,
        5,
        9,
        14,
        20,
        4,
        11,
        16,
        23,
        4,
        11,
        16,
        23,
        4,
        11,
        16,
        23,
        4,
        11,
        16,
        23,
        6,
        10,
        15,
        21,
        6,
        10,
        15,
        21,
        6,
        10,
        15,
        21,
        6,
        10,
        15,
        21,
    ]
}

fn md5_blocks(state: List[Int], data: Bytes, from: Int, count: Int) -> List[Int] {
    let k = md5_k()
    let shift = md5_shifts()
    let m = mask()
    let mut a0 = state[0]
    let mut b0 = state[1]
    let mut c0 = state[2]
    let mut d0 = state[3]
    let mut x: List[Int] = []
    for _ in 0..<16 {
        x.push(0)
    }
    for blk in 0..<count {
        let at = from + blk * 64
        for j in 0..<16 {
            let i = at + j * 4
            x[j] = data[i] | data[i + 1] << 8 | data[i + 2] << 16 | data[i + 3] << 24
        }
        let mut a = a0
        let mut b = b0
        let mut c = c0
        let mut d = d0
        for i in 0..<64 {
            let (f, g) = if i < 16 {
                // (b and c) or (not b and d), as d xor (b and (c xor d))
                (d ^ b & (c ^ d), i)
            } else if i < 32 {
                // (d and b) or (not d and c), as c xor (d and (b xor c))
                (c ^ d & (b ^ c), (5 * i + 1) % 16)
            } else if i < 48 {
                (b ^ c ^ d, (3 * i + 5) % 16)
            } else {
                (c ^ (b | ~d & m), 7 * i % 16)
            }
            let sum = (a + f + k[i] + x[g]) & m
            a = d
            d = c
            c = b
            b = (b + rotl(sum, shift[i])) & m
        }
        a0 = (a0 + a) & m
        b0 = (b0 + b) & m
        c0 = (c0 + c) & m
        d0 = (d0 + d) & m
    }
    [a0, b0, c0, d0]
}
