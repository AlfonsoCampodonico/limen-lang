(library
 (name tessera)
 (libraries unix)
 (foreign_stubs
  (language c)
  (names tls_stubs)
  (extra_deps runtime/tessera_tls.h)
  (flags
   (:standard
    (:include tls_cflags.sexp))))
 ; the interpreter's calls into C libraries (foreign blocks)
 (foreign_stubs
  (language c)
  (names ffi_stubs)
  (extra_deps runtime/tessera_sandbox.h))
 (c_library_flags
  (:include tls_libs.sexp))
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70 -warn-error -a)))

; Embed the C runtime header as an OCaml string.
(rule
 (targets runtime_text.ml)
 (deps runtime/tessera_rt.h runtime/tessera_sandbox.h)
 (action
  (with-stdout-to
   runtime_text.ml
   (progn
    (echo "let text = {xxrtxx|")
    (cat runtime/tessera_sandbox.h)
    (cat runtime/tessera_rt.h)
    (echo "|xxrtxx}\n")))))

; Find OpenSSL for TLS (see openssl_config.sh); without it tessera builds
; without TLS.
(rule
 (targets tls_cflags.sexp tls_libs.sexp openssl_config.ml)
 (deps
  openssl_config.sh
  (env_var TESSERA_OPENSSL)
  (env_var CC))
 (action
  (run sh %{dep:openssl_config.sh} tls_cflags.sexp tls_libs.sexp openssl_config.ml)))

; Embed the TLS core, pasted into native programs that use TLS.
(rule
 (targets tls_text.ml)
 (deps runtime/tessera_tls.h)
 (action
  (with-stdout-to
   tls_text.ml
   (progn
    (echo "let text = {xxtlsxx|")
    (cat runtime/tessera_tls.h)
    (echo "|xxtlsxx}\n")))))

; Embed SPEC.md for `tessera spec` and the MCP server.
(rule
 (targets spec_text.ml)
 (deps %{project_root}/SPEC.md)
 (action
  (with-stdout-to
   spec_text.ml
   (progn
    (echo "let text = {xxspecxx|")
    (cat %{project_root}/SPEC.md)
    (echo "|xxspecxx}\n")))))

; Embed the built-in List and Map methods written in Tessera (see prelude.ml).
(rule
 (targets methods_text.ml)
 (deps std/methods.tsr)
 (action
  (with-stdout-to
   methods_text.ml
   (progn
    (echo "let text = {xxmethodsxx|")
    (cat std/methods.tsr)
    (echo "|xxmethodsxx}\n")))))

; Embed the standard library modules (written in Tessera).
(rule
 (targets std_text.ml)
 (deps std/json.tsr std/list.tsr std/text.tsr std/http.tsr std/format.tsr std/time.tsr std/regex.tsr std/sql.tsr std/errors.tsr std/hex.tsr std/base64.tsr std/hash.tsr std/csv.tsr std/url.tsr std/flags.tsr std/log.tsr std/path.tsr std/tessera.toml)
 (action
  (with-stdout-to
   std_text.ml
   (progn
    (echo "let modules = [\n")
    (echo "(\"json\", {xxstdxx|")
    (cat std/json.tsr)
    (echo "|xxstdxx});\n(\"list\", {xxstdxx|")
    (cat std/list.tsr)
    (echo "|xxstdxx});\n(\"text\", {xxstdxx|")
    (cat std/text.tsr)
    (echo "|xxstdxx});\n(\"http\", {xxstdxx|")
    (cat std/http.tsr)
    (echo "|xxstdxx});\n(\"format\", {xxstdxx|")
    (cat std/format.tsr)
    (echo "|xxstdxx});\n(\"time\", {xxstdxx|")
    (cat std/time.tsr)
    (echo "|xxstdxx});\n(\"regex\", {xxstdxx|")
    (cat std/regex.tsr)
    (echo "|xxstdxx});\n(\"sql\", {xxstdxx|")
    (cat std/sql.tsr)
    (echo "|xxstdxx});\n(\"errors\", {xxstdxx|")
    (cat std/errors.tsr)
    (echo "|xxstdxx});\n(\"hex\", {xxstdxx|")
    (cat std/hex.tsr)
    (echo "|xxstdxx});\n(\"base64\", {xxstdxx|")
    (cat std/base64.tsr)
    (echo "|xxstdxx});\n(\"hash\", {xxstdxx|")
    (cat std/hash.tsr)
    (echo "|xxstdxx});\n(\"csv\", {xxstdxx|")
    (cat std/csv.tsr)
    (echo "|xxstdxx});\n(\"url\", {xxstdxx|")
    (cat std/url.tsr)
    (echo "|xxstdxx});\n(\"flags\", {xxstdxx|")
    (cat std/flags.tsr)
    (echo "|xxstdxx});\n(\"log\", {xxstdxx|")
    (cat std/log.tsr)
    (echo "|xxstdxx});\n(\"path\", {xxstdxx|")
    (cat std/path.tsr)
    (echo "|xxstdxx}) ]\n")
    (echo "let manifest = {xxstdxx|")
    (cat std/tessera.toml)
    (echo "|xxstdxx}\n")))))
