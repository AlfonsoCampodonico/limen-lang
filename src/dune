(library
 (name writ)
 (libraries unix)
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70 -warn-error -a)))

; Embed the C runtime header as an OCaml string.
(rule
 (targets runtime_text.ml)
 (deps runtime/writ_rt.h)
 (action
  (with-stdout-to
   runtime_text.ml
   (progn
    (echo "let text = {xxrtxx|")
    (cat runtime/writ_rt.h)
    (echo "|xxrtxx}\n")))))

; Embed SPEC.md for `writ spec` and the MCP server.
(rule
 (targets spec_text.ml)
 (deps %{project_root}/SPEC.md)
 (action
  (with-stdout-to
   spec_text.ml
   (progn
    (echo "let text = {xxspecxx|")
    (cat %{project_root}/SPEC.md)
    (echo "|xxspecxx}\n")))))

; Embed the standard library modules (written in Writ).
(rule
 (targets std_text.ml)
 (deps std/json.wr std/list.wr std/text.wr std/http.wr)
 (action
  (with-stdout-to
   std_text.ml
   (progn
    (echo "let modules = [\n")
    (echo "(\"json\", {xxstdxx|")
    (cat std/json.wr)
    (echo "|xxstdxx});\n(\"list\", {xxstdxx|")
    (cat std/list.wr)
    (echo "|xxstdxx});\n(\"text\", {xxstdxx|")
    (cat std/text.wr)
    (echo "|xxstdxx});\n(\"http\", {xxstdxx|")
    (cat std/http.wr)
    (echo "|xxstdxx}) ]\n")))))
