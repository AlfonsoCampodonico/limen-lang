(library
 (name limen)
 (libraries unix)
 (foreign_stubs
  (language c)
  (names tls_stubs)
  (extra_deps runtime/limen_tls.h)
  (flags
   (:standard
    (:include tls_cflags.sexp))))
 ; the interpreter's calls into C libraries (foreign blocks)
 (foreign_stubs
  (language c)
  (names ffi_stubs)
  (extra_deps runtime/limen_sandbox.h runtime/limen_sql.h))
 (c_library_flags
  (:include tls_libs.sexp))
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70 -warn-error -a)))

; Embed the C runtime as OCaml strings: `text`, all of it as one program
; starts (the sandbox, the declarations, the SQL core, the definitions), and `header`, the
; declarations alone, which each piece of a split build includes.
(rule
 (targets runtime_text.ml)
 (deps runtime/limen_rt.h runtime/limen_sql.h runtime/limen_rt.c runtime/limen_sandbox.h)
 (action
  (with-stdout-to
   runtime_text.ml
   (progn
    (echo "let text = {xxrtxx|")
    (cat runtime/limen_sandbox.h)
    (cat runtime/limen_rt.h)
    (cat runtime/limen_sql.h)
    (cat runtime/limen_rt.c)
    (echo "|xxrtxx}\n")
    (echo "let header = {xxrtxx|")
    (cat runtime/limen_rt.h)
    (echo "|xxrtxx}\n")))))

; Find OpenSSL for TLS (see openssl_config.sh); without it limen builds
; without TLS.
(rule
 (targets tls_cflags.sexp tls_libs.sexp openssl_config.ml)
 (deps
  openssl_config.sh
  (env_var LIMEN_OPENSSL)
  (env_var LIMEN_OPENSSL_STATIC)
  (env_var CC))
 (action
  (run sh %{dep:openssl_config.sh} tls_cflags.sexp tls_libs.sexp openssl_config.ml)))

; Embed the TLS core, pasted into native programs that use TLS.
(rule
 (targets tls_text.ml)
 (deps runtime/limen_tls.h)
 (action
  (with-stdout-to
   tls_text.ml
   (progn
    (echo "let text = {xxtlsxx|")
    (cat runtime/limen_tls.h)
    (echo "|xxtlsxx}\n")))))

; Embed SPEC.md for `limen spec` and the MCP server.
(rule
 (targets spec_text.ml)
 (deps %{project_root}/SPEC.md)
 (action
  (with-stdout-to
   spec_text.ml
   (progn
    (echo "let text = {xxspecxx|")
    (cat %{project_root}/SPEC.md)
    (echo "|xxspecxx}\n")))))

; Embed the built-in List and Map methods written in Limen (see prelude.ml).
(rule
 (targets methods_text.ml)
 (deps std/methods.lmn)
 (action
  (with-stdout-to
   methods_text.ml
   (progn
    (echo "let text = {xxmethodsxx|")
    (cat std/methods.lmn)
    (echo "|xxmethodsxx}\n")))))

; Embed the standard library modules (written in Limen).
(rule
 (targets std_text.ml)
 (deps std/json.lmn std/list.lmn std/text.lmn std/http.lmn std/format.lmn std/time.lmn std/regex.lmn std/sql.lmn std/errors.lmn std/hex.lmn std/base64.lmn std/hash.lmn std/csv.lmn std/url.lmn std/flags.lmn std/log.lmn std/path.lmn std/uuid.lmn std/compress.lmn std/postgres.lmn std/redis.lmn std/stream.lmn std/websocket.lmn std/limen.toml)
 (action
  (with-stdout-to
   std_text.ml
   (progn
    (echo "let modules = [\n")
    (echo "(\"json\", {xxstdxx|")
    (cat std/json.lmn)
    (echo "|xxstdxx});\n(\"list\", {xxstdxx|")
    (cat std/list.lmn)
    (echo "|xxstdxx});\n(\"text\", {xxstdxx|")
    (cat std/text.lmn)
    (echo "|xxstdxx});\n(\"http\", {xxstdxx|")
    (cat std/http.lmn)
    (echo "|xxstdxx});\n(\"format\", {xxstdxx|")
    (cat std/format.lmn)
    (echo "|xxstdxx});\n(\"time\", {xxstdxx|")
    (cat std/time.lmn)
    (echo "|xxstdxx});\n(\"regex\", {xxstdxx|")
    (cat std/regex.lmn)
    (echo "|xxstdxx});\n(\"sql\", {xxstdxx|")
    (cat std/sql.lmn)
    (echo "|xxstdxx});\n(\"errors\", {xxstdxx|")
    (cat std/errors.lmn)
    (echo "|xxstdxx});\n(\"hex\", {xxstdxx|")
    (cat std/hex.lmn)
    (echo "|xxstdxx});\n(\"base64\", {xxstdxx|")
    (cat std/base64.lmn)
    (echo "|xxstdxx});\n(\"hash\", {xxstdxx|")
    (cat std/hash.lmn)
    (echo "|xxstdxx});\n(\"csv\", {xxstdxx|")
    (cat std/csv.lmn)
    (echo "|xxstdxx});\n(\"url\", {xxstdxx|")
    (cat std/url.lmn)
    (echo "|xxstdxx});\n(\"flags\", {xxstdxx|")
    (cat std/flags.lmn)
    (echo "|xxstdxx});\n(\"log\", {xxstdxx|")
    (cat std/log.lmn)
    (echo "|xxstdxx});\n(\"path\", {xxstdxx|")
    (cat std/path.lmn)
    (echo "|xxstdxx});\n(\"uuid\", {xxstdxx|")
    (cat std/uuid.lmn)
    (echo "|xxstdxx});\n(\"compress\", {xxstdxx|")
    (cat std/compress.lmn)
    (echo "|xxstdxx});\n(\"postgres\", {xxstdxx|")
    (cat std/postgres.lmn)
    (echo "|xxstdxx});\n(\"redis\", {xxstdxx|")
    (cat std/redis.lmn)
    (echo "|xxstdxx});\n(\"stream\", {xxstdxx|")
    (cat std/stream.lmn)
    (echo "|xxstdxx});\n(\"websocket\", {xxstdxx|")
    (cat std/websocket.lmn)
    (echo "|xxstdxx}) ]\n")
    (echo "let manifest = {xxstdxx|")
    (cat std/limen.toml)
    (echo "|xxstdxx}\n")))))
