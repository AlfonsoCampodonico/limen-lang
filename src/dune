(library
 (name writ)
 (libraries unix)
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70 -warn-error -a)))

; Embed the C runtime header as an OCaml string.
(rule
 (targets runtime_text.ml)
 (deps runtime/writ_rt.h)
 (action
  (with-stdout-to
   runtime_text.ml
   (progn
    (echo "let text = {xxrtxx|")
    (cat runtime/writ_rt.h)
    (echo "|xxrtxx}\n")))))

; Embed SPEC.md for `writ spec` and the MCP server.
(rule
 (targets spec_text.ml)
 (deps %{project_root}/SPEC.md)
 (action
  (with-stdout-to
   spec_text.ml
   (progn
    (echo "let text = {xxspecxx|")
    (cat %{project_root}/SPEC.md)
    (echo "|xxspecxx}\n")))))
