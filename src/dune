(library
 (name vela)
 (libraries unix)
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70 -warn-error -a)))

; Embed the C runtime header as an OCaml string.
(rule
 (targets runtime_text.ml)
 (deps runtime/vela_rt.h)
 (action
  (with-stdout-to
   runtime_text.ml
   (progn
    (echo "let text = {xxrtxx|")
    (cat runtime/vela_rt.h)
    (echo "|xxrtxx}\n")))))

; Embed SPEC.md for `vela spec` and the MCP server.
(rule
 (targets spec_text.ml)
 (deps %{project_root}/SPEC.md)
 (action
  (with-stdout-to
   spec_text.ml
   (progn
    (echo "let text = {xxspecxx|")
    (cat %{project_root}/SPEC.md)
    (echo "|xxspecxx}\n")))))

; Embed the standard library modules (written in Vela).
(rule
 (targets std_text.ml)
 (deps std/json.vela std/list.vela std/text.vela std/http.vela std/format.vela std/time.vela std/regex.vela)
 (action
  (with-stdout-to
   std_text.ml
   (progn
    (echo "let modules = [\n")
    (echo "(\"json\", {xxstdxx|")
    (cat std/json.vela)
    (echo "|xxstdxx});\n(\"list\", {xxstdxx|")
    (cat std/list.vela)
    (echo "|xxstdxx});\n(\"text\", {xxstdxx|")
    (cat std/text.vela)
    (echo "|xxstdxx});\n(\"http\", {xxstdxx|")
    (cat std/http.vela)
    (echo "|xxstdxx});\n(\"format\", {xxstdxx|")
    (cat std/format.vela)
    (echo "|xxstdxx});\n(\"time\", {xxstdxx|")
    (cat std/time.vela)
    (echo "|xxstdxx});\n(\"regex\", {xxstdxx|")
    (cat std/regex.vela)
    (echo "|xxstdxx}) ]\n")))))
