(test
 (name test_tessera)
 (libraries tessera unix)
 (deps
  ../bin/main.exe
  ffi_test.c
  (glob_files %{project_root}/examples/*.tsr)
  (glob_files %{project_root}/bench/*.tsr)
  (glob_files %{project_root}/selfhost/*.tsr)
  (glob_files tls/*.pem)
  (glob_files tls/*.py)
  (glob_files compressed/*)
  (source_tree zoneinfo)))

; `tessera lsp` end to end over stdio.
(rule
 (alias runtest)
 (deps lsp_stdio.py %{exe:../bin/main.exe})
 (action
  (run python3 lsp_stdio.py %{exe:../bin/main.exe})))

; `tessera mcp` end to end over stdio.
(rule
 (alias runtest)
 (deps mcp_stdio.py %{exe:../bin/main.exe})
 (action
  (run python3 mcp_stdio.py %{exe:../bin/main.exe})))
