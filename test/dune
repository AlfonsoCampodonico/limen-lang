(test
 (name test_writ)
 (libraries writ unix)
 (deps
  (glob_files %{project_root}/examples/*.wr)
  (glob_files %{project_root}/bench/*.wr)))

; `writ lsp` end to end over stdio.
(rule
 (alias runtest)
 (deps lsp_stdio.py %{exe:../bin/main.exe})
 (action
  (run python3 lsp_stdio.py %{exe:../bin/main.exe})))
