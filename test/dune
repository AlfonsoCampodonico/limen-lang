(test
 (name test_limen)
 (libraries limen unix)
 (deps
  ../bin/main.exe
  ffi_test.c
  (glob_files %{project_root}/examples/*.lmn)
  (glob_files %{project_root}/bench/*.lmn)
  (glob_files %{project_root}/selfhost/*.lmn)
  (glob_files tls/*.pem)
  (glob_files tls/kube/*.pem)
  (glob_files kube/*.lmn)
  (glob_files tls/*.py)
  (glob_files compressed/*)
  (source_tree zoneinfo)))

; `limen lsp` end to end over stdio.
(rule
 (alias runtest)
 (deps lsp_stdio.py %{exe:../bin/main.exe})
 (action
  (run python3 lsp_stdio.py %{exe:../bin/main.exe})))

; `limen mcp` end to end over stdio.
(rule
 (alias runtest)
 (deps mcp_stdio.py %{exe:../bin/main.exe})
 (action
  (run python3 mcp_stdio.py %{exe:../bin/main.exe})))
