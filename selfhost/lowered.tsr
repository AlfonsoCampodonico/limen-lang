// Prints the IR the Tessera backend makes of one file, after every pass C
// generation runs before it writes C (lowering, then reusing repeated pure
// calls, then ownership), with what C generation decides about the loops,
// in the format of selfhost/ir_print.tsr, which selfhost/irdump prints for
// the OCaml backend, so the two can be compared. The program as `tessera
// build` compiles it comes under `== build` when it has a `main`, and as
// `tessera test` compiles it under `== test` when it has tests or
// benchmarks. A program that does not load or check prints its errors
// instead, one `ERROR CODE FILE LO HI` line each.
//
// It reads through the one Fs it is granted, as selfhost/check.tsr does:
//
//   tessera run selfhost/lowered.tsr --grant fs=..:ro -- tessera/src/std tessera/examples hello.tsr
use ast
use caps
use diag
use disk
use ffi
use ir_print
use loader
use lower
use own
use pure
use typecheck

fn main(root: Root) -> Int {
    let out = root.stdout
    let args = root.args()
    if args.len() != 3 {
        out.print("usage: lowered STD CWD FILE")
        return 2
    }
    let fs = root.fs
    let base = match fs.full_path("") {
        Ok(p) => p,
        Err(e) => {
            out.print("no directory granted: {e}")
            return 1
        },
    }
    let std = fs.under(args[0])
    let place = disk.Place { cwd: args[1], root: base }
    let p = loader.load(fs, std, place, args[2])
    if !p.diags.is_empty() {
        for d in p.diags {
            out.print("ERROR {d.code} {diag.path_of(p.files, d.span.file)} {d.span.lo} {d.span.hi}")
        }
        return 0
    }
    let methods = match std.read("methods.tsr") {
        Ok(text) => text,
        Err(e) => {
            out.print("cannot read the built-in methods: {e}")
            return 1
        },
    }
    let c = typecheck.check_program(p.items, p.files, p.next_id, methods, p.forwarders)
    let files = p.files + [diag.Source { path: "<prelude>", text: "" }, diag.Source { path: "<builtin>", text: "" }, diag.Source { path: "<std>/tessera.toml", text: "" }]
    let errors = caps.check(fs, place, files, files.len() - 1, p.std_manifest, p.std_modules, p.manifest, p.packages, p.items, c).filter(|d| !d.warning)
    if !errors.is_empty() {
        for d in errors {
            out.print("ERROR {d.code} {diag.path_of(files, d.span.file)} {d.span.lo} {d.span.hi}")
        }
        return 0
    }
    let fns = c.items.flat_map(|i| match i {
        IFn(d) => [d],
        _ => [],
    })
    let libs = ffi.libs(c.items)
    if fns.any(|d| d.name == "main") {
        out.print("== build")
        out.print(dump(c, files, libs, false))
    }
    if fns.any(|d| d.test.is_some()) {
        out.print("== test")
        out.print(dump(c, files, libs, true))
    }
    0
}

fn dump(c: typecheck.Checked, files: List[diag.Source], libs: List[Str], tests: Bool) -> Str {
    let (prog, _) = lower.lower_program(c.prelude, c.items, c.cx, c.state, tests)
    ir_print.program(files, own.program(pure.cse(prog)), libs).join("\n")
}
