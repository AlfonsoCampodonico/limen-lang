// `json.encode(x)` and `json.decode(s)`, and `sql.decode(row)`,
// `db.all(text, params)`, `db.one(text, params)` and `sql.values(x)`: the
// compiler writes the conversion, as src/derive.ml does.
//
// The standard json module declares both as generic functions whose
// bodies never run, so the checker types every use like any call. Once a
// program has checked, this pass finds each use, takes the type it was used
// at, and writes ordinary Limen functions for that type and every type
// inside it, into the json module: `json.to$N(x: T) -> json.Value` (for a
// type that holds a type that holds itself, `json.put$N(x: T) ->
// List[json.Part]`, the text in pieces) and `json.from$N(v: json.Value, at: Str) ->
// Result[T, Str]`, built from the helpers at the end of json.lmn; for a
// type that holds itself also `json.step$N`, its decoder a step at a time. Each use is pointed at a wrapper,
// `json.encode$N` or `json.decode$N`, and the program is checked again with
// the new functions. The functions come out in the order src/derive.ml
// writes them, so both compilers emit the same C.
//
// The sql module's work the same way, for structs whose fields are Int,
// Float, Str, Bool, Bytes or an Option of one: `sql.row$N(row: Row) ->
// Result[T, IoError]` and `sql.values$N(x: T) -> List[Value]`, and a call
// `db.all(...)` or `db.one(...)` becomes a call of a wrapper,
// `sql.all$N(db, ...)`.
use ast
use diag
use env
use ids
use typecheck
use types
use walk

// What has been written so far.
struct Gen {
    // the json module's name in this program: "json" or "std/json"
    q: Str,
    // the use being expanded, for every node written
    sp: ast.Span,
    structs: Map[Str, ast.StructDecl],
    enums: Map[Str, ast.EnumDecl],
    // a type, shown, and its number
    names: Map[Str, Int],
    // `cyclic`'s and `plain`'s answers, by type shown (`classify`)
    cyc: Map[Str, Bool],
    pln: Map[Str, Bool],
    count: Int,
    // the functions written, in order
    out: List[ast.Item],
    subst: types.Subst,
}

// A type without its JSON form: what holds it, and the state when it was
// found (src/derive.ml raises Unsupported, keeping what it wrote).
struct Fail {
    what: Str,
    g: Gen,
}

fn ex(g: Gen, d: ast.ExprDesc) -> ast.Expr {
    ast.Expr { desc: d, span: g.sp, id: 0 }
}

fn var(g: Gen, n: Str) -> ast.Expr {
    ex(g, EVar(n))
}

fn call(g: Gen, f: Str, args: List[ast.Expr]) -> ast.Expr {
    ex(g, ECall(var(g, f), args))
}

fn text(g: Gen, s: Str) -> ast.Expr {
    ex(g, EStr([SPLit(s)]))
}

fn num(g: Gen, n: Int) -> ast.Expr {
    ex(g, EInt(n))
}

fn jf(g: Gen, n: Str) -> Str {
    g.q + "." + n
}

fn te(g: Gen, d: ast.TyDesc) -> ast.TyExpr {
    ast.TyExpr { desc: d, span: g.sp }
}

fn pat(g: Gen, d: ast.PatDesc) -> ast.Pat {
    ast.Pat { desc: d, span: g.sp }
}

fn only(g: Gen, e: ast.Expr) -> ast.Block {
    ast.Block { stmts: [], tail: Some(e), span: g.sp }
}

fn try_(g: Gen, e: ast.Expr) -> ast.Expr {
    ex(g, ETry(e, None))
}

fn ok(g: Gen, e: ast.Expr) -> ast.Expr {
    call(g, "Ok", [e])
}

fn let_(g: Gen, n: Str, e: ast.Expr) -> ast.Stmt {
    ast.Stmt { desc: SLet(false, n, g.sp, None, e), span: g.sp }
}

fn show(g: Gen, t: types.Ty) -> Str {
    g.subst.show(t)
}

fn quoted(g: Gen, t: types.Ty) -> Str {
    "`{show(g, t)}`"
}

// A type as written, for a generated function's parameters and result.
fn written(g: Gen, t: types.Ty) -> Result[ast.TyExpr, Str] {
    match t {
        TInt => Ok(te(g, TyName("Int", []))),
        TFloat => Ok(te(g, TyName("Float", []))),
        TBool => Ok(te(g, TyName("Bool", []))),
        TStr => Ok(te(g, TyName("Str", []))),
        TBytes => Ok(te(g, TyName("Bytes", []))),
        TUnit => Ok(te(g, TyUnit)),
        TList(a) => Ok(te(g, TyName("List", [written(g, a)?]))),
        TMap(k, v) => Ok(te(g, TyName("Map", [written(g, k)?, written(g, v)?]))),
        TNamed(n, args) => Ok(te(g, TyName(n, written_all(g, args)?))),
        _ => Err(show(g, t)),
    }
}

fn written_all(g: Gen, ts: List[types.Ty]) -> Result[List[ast.TyExpr], Str] {
    let mut out: List[ast.TyExpr] = []
    for x in ts {
        out.push(written(g, x)?)
    }
    Ok(out)
}

// The type of a declared field or payload, with the declaration's type
// parameters replaced by `env`.
fn field_ty(env: List[(Str, types.Ty)], t: ast.TyExpr) -> Result[types.Ty, Str] {
    match t.desc {
        TyUnit => Ok(TUnit),
        TyName(n, []) if env.any(|p| p.0 == n) => Ok(env.find(|p| p.0 == n).map(|p| p.1) ?? TErr),
        TyName("Int", []) => Ok(TInt),
        TyName("Float", []) => Ok(TFloat),
        TyName("Bool", []) => Ok(TBool),
        TyName("Str", []) => Ok(TStr),
        TyName("Bytes", []) => Ok(TBytes),
        TyName("List", [a]) => Ok(TList(field_ty(env, a)?)),
        TyName("Map", [k, v]) => Ok(TMap(field_ty(env, k)?, field_ty(env, v)?)),
        TyName(n, _) if is_cap(n) => Err("`{n}`"),
        TyName(n, _) if ["Array", "dyn", "Chan", "Atomic", "Shared", "Group"].contains(n) => Err("`{n}`"),
        TyName(n, args) => {
            let mut out: List[types.Ty] = []
            for a in args {
                out.push(field_ty(env, a)?)
            }
            Ok(TNamed(n, out))
        },
        TyFn(..) => Err("a function"),
        TyInt(_) => Err("a number"),
    }
}

fn is_cap(n: Str) -> Bool {
    ["Root", "Net", "Fs", "Stdout", "Stderr", "Clock", "Listen", "Listener", "Conn", "Rand", "Stdin", "Env", "Exec", "Foreign", "Revoker"].contains(n)
}

fn fn_item(g: Gen, name: Str, params: List[ast.Param], ret: ast.TyExpr, body: ast.Block) -> ast.Item {
    IFn(ast.FnDecl { name, span: g.sp, generics: [], params, ret: Some(ret), body, test: None, bench: false, virtual: false, table: None, public: false, bounds: [], foreign: None })
}

fn param(g: Gen, n: Str, t: ast.TyExpr) -> ast.Param {
    ast.Param { name: n, span: g.sp, ty: t, default: None }
}

fn value_ty(g: Gen) -> types.Ty {
    TNamed(jf(g, "Value"), [])
}

fn fn_gen(g: Gen, name: Str, generics: List[Str], params: List[ast.Param], ret: ast.TyExpr, body: ast.Block) -> ast.Item {
    IFn(ast.FnDecl { name, span: g.sp, generics, params, ret: Some(ret), body, test: None, bench: false, virtual: false, table: None, public: false, bounds: [], foreign: None })
}

// What a type holds, for `cyclic`: nothing for a type converted by a
// helper, and nothing when a part has no JSON form (that is reported when
// its conversion is written).
fn kids(g: Gen, t: types.Ty) -> List[types.Ty] {
    match t {
        TNamed(n, []) if n == jf(g, "Value") => [],
        TNamed("Option", [a]) => [a],
        TList(a) => [a],
        TMap(_, a) => [a],
        TNamed(n, args) if ast.is_tuple_name(n) => args,
        TNamed(n, args) if g.structs.contains(n) => {
            let sd = g.structs[n]
            let env = sd.generics.zip(args)
            let mut out: List[types.Ty] = []
            for f in sd.fields {
                match field_ty(env, f.ty) {
                    Ok(x) => out.push(x),
                    Err(_) => { return [] },
                }
            }
            out
        },
        TNamed(n, args) if g.enums.contains(n) => {
            let ed = g.enums[n]
            let env = ed.generics.zip(args)
            let mut out: List[types.Ty] = []
            for vr in ed.variants {
                for pt in vr.payload {
                    match field_ty(env, pt) {
                        Ok(x) => out.push(x),
                        Err(_) => { return [] },
                    }
                }
            }
            out
        },
        _ => [],
    }
}

// Does `t` hold itself? Then a value can be as deep as it is long, so its
// encoder leaves those parts for later and its decoder goes a step at a
// time (json.lmn), rather than recursing once per level.
fn cyclic(g: Gen, t: types.Ty) -> Bool {
    match g.cyc.get(show(g, t)) {
        Some(b) => b,
        None => connected(g, t).cyc.get(show(g, t)) ?? false,
    }
}

// The state of `connected`'s walk.
struct Scc {
    idx: Map[Str, Int],
    low: Map[Str, Int],
    on: Map[Str, Bool],
    // the walk's stack; slots from `depth` on are spare
    stack: List[types.Ty],
    depth: Int,
    next: Int,
    // the answers found
    cyc: Map[Str, Bool],
}

// Every type reachable from `t` whose answer is not known yet, answered
// at once: the strongly connected parts of the graph of what holds what
// (Tarjan), a type holding itself when its part has more than one type or
// it holds itself directly. Linear in the types, where asking each type
// alone would be quadratic.
fn connected(g: Gen, t: types.Ty) -> Scc {
    let s = Scc { idx: map(), low: map(), on: map(), stack: [], depth: 0, next: 0, cyc: map() }
    if g.cyc.contains(show(g, t)) {
        return s
    }
    connect(g, t, s)
}

fn connect(g: Gen, v: types.Ty, s0: Scc) -> Scc {
    let k = show(g, v)
    let mut s = s0
    s.idx[k] = s.next
    s.low[k] = s.next
    s.next = s.next + 1
    if s.depth < s.stack.len() {
        s.stack[s.depth] = v
    } else {
        s.stack.push(v)
    }
    s.depth = s.depth + 1
    s.on[k] = true
    for w in kids(g, v) {
        let wk = show(g, w)
        if g.cyc.contains(wk) || s.cyc.contains(wk) {
            continue
        }
        if !s.idx.contains(wk) {
            s = connect(g, w, s)
            s.low[k] = s.low[k].min(s.low[wk])
        } else if s.on.get(wk) ?? false {
            s.low[k] = s.low[k].min(s.idx[wk])
        }
    }
    if s.low[k] == s.idx[k] {
        let mut part: List[types.Ty] = []
        let mut going = true
        while going {
            s.depth = s.depth - 1
            let u = s.stack[s.depth]
            let uk = show(g, u)
            s.on[uk] = false
            part.push(u)
            going = uk != k
        }
        let many = part.len() > 1
        for u in part {
            let uk = show(g, u)
            s.cyc[uk] = many || kids(g, u).any(|w| show(g, w) == uk)
        }
    }
    s
}

// Is no type that holds itself inside `t`, `t` included? Then its values
// are only so deep, and it is encoded as before: a json.Value, then
// `stringify`. A type that is not inside itself has parts that are not
// inside it either, so this recursion ends.
fn plain(g: Gen, t: types.Ty) -> Bool {
    match g.pln.get(show(g, t)) {
        Some(b) => b,
        None => !cyclic(g, t) && kids(g, t).all(|u| plain(g, u)),
    }
}

// Work out `cyclic` and `plain` for `t` and the parts plain needs, once
// for the whole pass.
fn classify(g: Gen, t: types.Ty) -> Gen {
    let k = show(g, t)
    if g.pln.contains(k) {
        return g
    }
    let mut g = g
    for e in connected(g, t).cyc.entries() {
        g.cyc[e.0] = e.1
    }
    let c = g.cyc.get(k) ?? false
    if c {
        g.pln[k] = false
        return g
    }
    let mut p = true
    for u in kids(g, t) {
        g = classify(g, u)
        if !(g.pln.get(show(g, u)) ?? true) {
            p = false
        }
    }
    g.pln[k] = p
    g
}

// The encoder and decoder of `t`, as function names: a helper of
// json.lmn for the simple types, written ones otherwise. The encoder of a
// plain type is `to$N`, giving a json.Value; any other's is `put$N`, giving
// the text in pieces. A type that holds itself has a third, its decoder a
// step at a time, `step$N`.
fn coders(g: Gen, t: types.Ty) -> Result[((Str, Str), Gen), Fail] {
    match g.names.get(show(g, t)) {
        Some(_) => { return Ok((names_of(g, t), g)) },
        None => {},
    }
    match t {
        TInt | TFloat | TStr | TBool => { return Ok((names_of(g, t), g)) },
        TNamed(n, []) if n == jf(g, "Value") => { return Ok((names_of(g, t), g)) },
        _ => {},
    }
    let key = show(g, t)
    let mut g = classify(g, t)
    g.count = g.count + 1
    let k = g.count
    g.names[key] = k
    let put = names_of(g, t).0
    let from = jf(g, "from${k}")
    let ((enc, dec, step), g2) = bodies(g, t)?
    let mut g = g2
    let fail = |what: Str| Fail { what, g }
    let vt = match written(g, value_ty(g)) {
        Ok(x) => x,
        Err(w) => { return Err(fail(w)) },
    }
    let tt = match written(g, t) {
        Ok(x) => x,
        Err(w) => { return Err(fail(w)) },
    }
    let rt = match written(g, TNamed("Result", [t, TStr])) {
        Ok(x) => x,
        Err(w) => { return Err(fail(w)) },
    }
    let st = match written(g, TStr) {
        Ok(x) => x,
        Err(w) => { return Err(fail(w)) },
    }
    let parts = te(g, TyName("List", [te(g, TyName(jf(g, "Part"), []))]))
    let dec_params = [param(g, "v", vt), param(g, "at", st)]
    let encoder = fn_item(g, put, [param(g, "x", tt)], if plain(g, t) { vt } else { parts }, enc)
    match step {
        None => {
            g.out = g.out + [encoder, fn_item(g, from, dec_params, rt, dec)]
        },
        Some(body) => {
            // the decoder runs the steps
            let r = [ast.ClosureParam { name: "r", ty: None, span: g.sp }]
            let start = call(g, jf(g, "stop"), [var(g, "r")])
            let stepper_name = jf(g, "step${k}")
            let run = only(g, call(g, jf(g, "run"), [call(g, stepper_name, [var(g, "v"), var(g, "at"), ex(g, EClosure(r, start))])]))
            let next = te(g, TyName(jf(g, "Next"), [te(g, TyName("R$", []))]))
            let kont = te(g, TyFn([rt], next))
            let stepper = fn_gen(g, stepper_name, ["R$"], dec_params + [param(g, "k", kont)], next, body)
            g.out = g.out + [encoder, stepper, fn_item(g, from, dec_params, rt, run)]
        },
    }
    Ok(((put, from), g))
}

// The names of a type's coders, once they are written.
fn names_of(g: Gen, t: types.Ty) -> (Str, Str) {
    match t {
        TInt => (jf(g, "of_int"), jf(g, "from_int")),
        TFloat => (jf(g, "of_float"), jf(g, "from_float")),
        TStr => (jf(g, "of_str"), jf(g, "from_str")),
        TBool => (jf(g, "of_bool"), jf(g, "from_bool")),
        TNamed(n, []) if n == jf(g, "Value") => (jf(g, "of_value"), jf(g, "from_value")),
        _ => {
            let k = g.names.get(show(g, t)) ?? 0
            let kind = if plain(g, t) { "to" } else { "put" }
            (jf(g, "{kind}${k}"), jf(g, "from${k}"))
        },
    }
}

fn step_of(g: Gen, t: types.Ty) -> Str {
    let k = g.names.get(show(g, t)) ?? 0
    jf(g, "step${k}")
}

// The coders of the parts, written first, in order.
fn need(g: Gen, ts: List[types.Ty]) -> Result[Gen, Fail] {
    let mut g = g
    for t in ts {
        let (_, g2) = coders(g, t)?
        g = g2
    }
    Ok(g)
}

fn unsupported(g: Gen, what: Str) -> Fail {
    Fail { what, g }
}

fn fields_of(g: Gen, env: List[(Str, types.Ty)], tys: List[ast.TyExpr]) -> Result[List[types.Ty], Fail] {
    let mut out: List[types.Ty] = []
    for t in tys {
        match field_ty(env, t) {
            Ok(x) => out.push(x),
            Err(w) => { return Err(unsupported(g, w)) },
        }
    }
    Ok(out)
}

// A part's Value, encoded as before
fn enc_of(g: Gen, a: types.Ty, e: ast.Expr) -> ast.Expr {
    call(g, names_of(g, a).0, [e])
}

// The pieces of a part: a plain one's Value as text, later when it holds
// itself
fn put_of(g: Gen, a: types.Ty, e: ast.Expr) -> ast.Expr {
    let p = names_of(g, a).0
    let simple = match a {
        TInt => "put_int",
        TFloat => "put_float",
        TStr => "put_str",
        TBool => "put_bool",
        TNamed(n, []) if n == jf(g, "Value") => "put_value",
        _ => "",
    }
    if simple != "" {
        return call(g, jf(g, simple), [e])
    }
    if plain(g, a) {
        call(g, jf(g, "put_value"), [call(g, p, [e])])
    } else if cyclic(g, a) {
        call(g, jf(g, "later"), [ex(g, EClosure([], call(g, p, [e])))])
    } else {
        call(g, p, [e])
    }
}

// `n` values from an array of exactly `n` items at `at`, decoded by the
// decoders of `tys`: a `let` of the items, and the expressions.
fn items_of(g: Gen, v: ast.Expr, at: ast.Expr, tys: List[types.Ty]) -> (ast.Stmt, List[ast.Expr]) {
    let s = let_(g, "items", try_(g, call(g, jf(g, "from_items"), [v, at, num(g, tys.len())])))
    let mut es: List[ast.Expr] = []
    for (i, t) in tys.with_index() {
        es.push(try_(g, call(g, names_of(g, t).1, [ex(g, EIndex(var(g, "items"), num(g, i))), call(g, jf(g, "item_at"), [at, num(g, i)])])))
    }
    (s, es)
}

// ---- decoding a step at a time ----

// A part to decode: its type, how to decode it at once, and the function
// and arguments that decode it a step at a time (the next step is added).
struct StepPart {
    ty: types.Ty,
    direct: ast.Expr,
    f: Str,
    args: List[ast.Expr],
}

fn go_(g: Gen, e: ast.Expr) -> ast.Expr {
    call(g, jf(g, "go"), [ex(g, EClosure([], e))])
}

// hand `e` on
fn kont(g: Gen, e: ast.Expr) -> ast.Expr {
    go_(g, call(g, "k", [e]))
}

fn on_ok(g: Gen, r: ast.Expr, name: Str, body: ast.Expr) -> ast.Expr {
    let bind = if name == "_" { pat(g, PWild) } else { pat(g, PBind(name)) }
    let good = ast.Arm { pat: pat(g, PVariant(None, "Ok", [bind])), guard: None, body }
    let bad = ast.Arm { pat: pat(g, PVariant(None, "Err", [pat(g, PBind("e"))])), guard: None, body: kont(g, call(g, "Err", [var(g, "e")])) }
    ex(g, EMatch(r, [good, bad]))
}

// decode the parts in order, binding d0, d1, ..., then hand on `made`
fn seq(g: Gen, parts: List[StepPart], i: Int, made: ast.Expr) -> ast.Expr {
    if i == parts.len() {
        return kont(g, made)
    }
    let p = parts[i]
    let name = "d{i}"
    let rest = seq(g, parts, i + 1, made)
    if cyclic(g, p.ty) {
        let r = [ast.ClosureParam { name: "r", ty: None, span: g.sp }]
        go_(g, call(g, p.f, p.args + [ex(g, EClosure(r, on_ok(g, var(g, "r"), name, rest)))]))
    } else {
        on_ok(g, p.direct, name, rest)
    }
}

fn ds(g: Gen, n: Int) -> List[ast.Expr] {
    (0..<n).map(|i| var(g, "d{i}"))
}

// the parts of an array of exactly `ts` items at `at`, then `made`
fn items_then(g: Gen, v: ast.Expr, at: ast.Expr, ts: List[types.Ty], made: ast.Expr) -> ast.Expr {
    let mut parts: List[StepPart] = []
    for (i, a) in ts.with_index() {
        let iv = ex(g, EIndex(var(g, "items"), num(g, i)))
        let iat = call(g, jf(g, "item_at"), [at, num(g, i)])
        parts.push(StepPart { ty: a, direct: call(g, names_of(g, a).1, [iv, iat]), f: step_of(g, a), args: [iv, iat] })
    }
    on_ok(g, call(g, jf(g, "from_items"), [v, at, num(g, ts.len())]), "items", seq(g, parts, 0, made))
}

// The bodies of `t`'s encoder (of `x`) and decoder (of `v` at `at`), and
// when `t` holds itself, its decoder a step at a time (of `v` at `at`, on
// to `k`). The parts' conversions are written first, in order.
fn bodies(g: Gen, t: types.Ty) -> Result[((ast.Block, ast.Block, Option[ast.Block]), Gen), Fail] {
    let x = var(g, "x")
    let v = var(g, "v")
    let at = var(g, "at")
    let k = var(g, "k")
    let self_ = cyclic(g, t)
    let pl = plain(g, t)
    match t {
        TNamed("Option", [a]) => {
            let g = need(g, [a])?
            let (e, d) = names_of(g, a)
            let step = if self_ { Some(only(g, call(g, jf(g, "option_k"), [v, at, var(g, step_of(g, a)), k]))) } else { None }
            Ok(((only(g, if pl { call(g, jf(g, "of_option"), [x, var(g, e)]) } else { call(g, jf(g, "put_option"), [x, var(g, e)]) }), only(g, call(g, jf(g, "from_option"), [v, at, var(g, d)])), step), g))
        },
        TList(a) => {
            let g = need(g, [a])?
            let (e, d) = names_of(g, a)
            let step = if self_ { Some(only(g, call(g, jf(g, "list_k"), [v, at, var(g, step_of(g, a)), k]))) } else { None }
            Ok(((only(g, if pl { call(g, jf(g, "of_list"), [ex(g, EMethod(x, "map", g.sp, [var(g, e)]))]) } else { call(g, jf(g, "put_list"), [x, var(g, e)]) }), only(g, call(g, jf(g, "from_list"), [v, at, var(g, d)])), step), g))
        },
        TMap(kt, a) => match kt {
            TStr => {
                let g = need(g, [a])?
                let (e, d) = names_of(g, a)
                let step = if self_ { Some(only(g, call(g, jf(g, "map_k"), [v, at, var(g, step_of(g, a)), k]))) } else { None }
                Ok(((only(g, if pl { call(g, jf(g, "of_map"), [x, var(g, e)]) } else { call(g, jf(g, "put_map"), [x, var(g, e)]) }), only(g, call(g, jf(g, "from_map"), [v, at, var(g, d)])), step), g))
            },
            _ => Err(unsupported(g, "{quoted(g, t)} (a map's keys must be `Str`)")),
        },
        TNamed(n, args) if ast.is_tuple_name(n) => {
            let g = need(g, args)?
            let mut parts: List[ast.Expr] = []
            for (i, a) in args.with_index() {
                let xi = ex(g, EField(x, "{i}", g.sp))
                parts.push(if pl { enc_of(g, a, xi) } else { put_of(g, a, xi) })
            }
            let enc = if pl { call(g, jf(g, "of_list"), [ex(g, EList(parts))]) } else { call(g, jf(g, "put_items"), [ex(g, EList(parts))]) }
            let (s, es) = items_of(g, v, at, args)
            let build = |es: List[ast.Expr]| ex(g, EStruct(n, g.sp, es.with_index().map(|p| ast.FieldInit { name: "{p.0}", span: g.sp, value: p.1 })))
            let step = if self_ { Some(only(g, items_then(g, v, at, args, ok(g, build(ds(g, args.len())))))) } else { None }
            Ok(((only(g, enc), ast.Block { stmts: [s], tail: Some(ok(g, build(es))), span: g.sp }, step), g))
        },
        TNamed(n, args) if g.structs.contains(n) => {
            let sd = g.structs[n]
            let env = sd.generics.zip(args)
            let fts = fields_of(g, env, sd.fields.map(|f| f.ty))?
            let fs = sd.fields.map(|f| f.name).zip(fts)
            let g = need(g, fts)?
            let enc = if pl {
                call(g, jf(g, "of_fields"), [ex(g, EList(fs.map(|p| call(g, jf(g, "field"), [text(g, p.0), enc_of(g, p.1, ex(g, EField(x, p.0, g.sp)))]))))])
            } else {
                call(g, jf(g, "put_fields"), [ex(g, EList(fs.map(|p| text(g, p.0)))), ex(g, EList(fs.map(|p| put_of(g, p.1, ex(g, EField(x, p.0, g.sp))))))])
            }
            let check = ast.Stmt { desc: SExpr(try_(g, call(g, jf(g, "need_object"), [v, at]))), span: g.sp }
            let mut inits: List[ast.FieldInit] = []
            let mut parts: List[StepPart] = []
            let mut made: List[ast.FieldInit] = []
            for (i, p) in fs.with_index() {
                let (f, ft) = p
                let member = call(g, jf(g, "member"), [v, at, text(g, f), var(g, names_of(g, ft).1)])
                inits.push(ast.FieldInit { name: f, span: g.sp, value: try_(g, member) })
                parts.push(StepPart { ty: ft, direct: member, f: jf(g, "member_k"), args: [v, at, text(g, f), var(g, step_of(g, ft))] })
                made.push(ast.FieldInit { name: f, span: g.sp, value: var(g, "d{i}") })
            }
            let step = if self_ {
                Some(only(g, on_ok(g, call(g, jf(g, "need_object"), [v, at]), "_", seq(g, parts, 0, ok(g, ex(g, EStruct(n, g.sp, made)))))))
            } else {
                None
            }
            Ok(((only(g, enc), ast.Block { stmts: [check], tail: Some(ok(g, ex(g, EStruct(n, g.sp, inits)))), span: g.sp }, step), g))
        },
        TNamed(n, args) if g.enums.contains(n) => {
            let ed = g.enums[n]
            let env = ed.generics.zip(args)
            let mut vs: List[(Str, List[types.Ty])] = []
            for vr in ed.variants {
                vs.push((vr.name, fields_of(g, env, vr.payload)?))
            }
            let g = need(g, vs.flat_map(|p| p.1))?
            let mut arms: List[ast.Arm] = []
            for (vn, ts) in vs {
                let names = ts.len() |> names_for
                let body = if pl && ts.is_empty() {
                    call(g, jf(g, "of_str"), [text(g, vn)])
                } else if pl && ts.len() == 1 {
                    call(g, jf(g, "of_variant"), [text(g, vn), enc_of(g, ts[0], var(g, "p0"))])
                } else if pl {
                    let mut parts: List[ast.Expr] = []
                    for (i, a) in ts.with_index() {
                        parts.push(enc_of(g, a, var(g, names[i])))
                    }
                    call(g, jf(g, "of_variant"), [text(g, vn), call(g, jf(g, "of_list"), [ex(g, EList(parts))])])
                } else if ts.is_empty() {
                    call(g, jf(g, "put_str"), [text(g, vn)])
                } else if ts.len() == 1 {
                    call(g, jf(g, "put_variant"), [text(g, vn), put_of(g, ts[0], var(g, "p0"))])
                } else {
                    let mut parts: List[ast.Expr] = []
                    for (i, a) in ts.with_index() {
                        parts.push(put_of(g, a, var(g, names[i])))
                    }
                    call(g, jf(g, "put_variant"), [text(g, vn), call(g, jf(g, "put_items"), [ex(g, EList(parts))])])
                }
                arms.push(ast.Arm { pat: pat(g, PVariant(Some(n), vn, names.map(|p| pat(g, PBind(p))))), guard: None, body })
            }
            let enc = ex(g, EMatch(x, arms))
            let got = var(g, "got")
            let name = ex(g, EField(got, "0", g.sp))
            let payload = ex(g, EField(got, "1", g.sp))
            let inner = call(g, jf(g, "inside"), [at, name])
            let mut darms: List[ast.Arm] = []
            let mut sarms: List[ast.Arm] = []
            for (vn, ts) in vs {
                let made = if ts.is_empty() {
                    ok(g, ex(g, EField(var(g, n), vn, g.sp)))
                } else if ts.len() == 1 {
                    ok(g, ex(g, EMethod(var(g, n), vn, g.sp, [try_(g, call(g, names_of(g, ts[0]).1, [payload, inner]))])))
                } else {
                    let (s, es) = items_of(g, payload, inner, ts)
                    ex(g, EBlock(ast.Block { stmts: [s], tail: Some(ok(g, ex(g, EMethod(var(g, n), vn, g.sp, es)))), span: g.sp }))
                }
                darms.push(ast.Arm { pat: pat(g, PStr(vn)), guard: None, body: made })
                let built = |es: List[ast.Expr]| ok(g, if ts.is_empty() { ex(g, EField(var(g, n), vn, g.sp)) } else { ex(g, EMethod(var(g, n), vn, g.sp, es)) })
                let sbody = if ts.is_empty() {
                    kont(g, built([]))
                } else if ts.len() == 1 {
                    let a = ts[0]
                    seq(g, [StepPart { ty: a, direct: call(g, names_of(g, a).1, [payload, inner]), f: step_of(g, a), args: [payload, inner] }], 0, built(ds(g, 1)))
                } else {
                    items_then(g, payload, inner, ts, built(ds(g, ts.len())))
                }
                sarms.push(ast.Arm { pat: pat(g, PStr(vn)), guard: None, body: sbody })
            }
            let names = vs.map(|p| "`{p.0}`").join(", ")
            let no = call(g, "Err", [call(g, jf(g, "no_variant"), [at, name, text(g, names)])])
            let other = ast.Arm { pat: pat(g, PWild), guard: None, body: no }
            let s = let_(g, "got", try_(g, call(g, jf(g, "from_variant"), [v, at])))
            let step = if self_ {
                let sother = ast.Arm { pat: pat(g, PWild), guard: None, body: kont(g, no) }
                Some(only(g, on_ok(g, call(g, jf(g, "from_variant"), [v, at]), "got", ex(g, EMatch(name, sarms + [sother])))))
            } else {
                None
            }
            Ok(((only(g, enc), ast.Block { stmts: [s], tail: Some(ex(g, EMatch(name, darms + [other]))), span: g.sp }, step), g))
        },
        _ => Err(unsupported(g, quoted(g, t))),
    }
}

fn names_for(n: Int) -> List[Str] {
    (0..<n).map(|i| "p{i}")
}

// ---------- SQL rows ----------

// The helper suffix for a column type, if `t` is one.
fn column(t: types.Ty) -> Option[Str] {
    match t {
        TInt => Some("int"),
        TFloat => Some("float"),
        TStr => Some("str"),
        TBool => Some("bool"),
        TBytes => Some("bytes"),
        _ => None,
    }
}

// The struct's name without its module, for errors.
fn short(n: Str) -> Str {
    n.split(".").last() ?? n
}

// The reader and writer of the struct `t` as rows, `sql.row$N` and
// `sql.values$N`, written the first time `t` is asked for. `g.q` is the
// sql module's name here.
fn row_coders(g: Gen, t: types.Ty) -> Result[((Str, Str), Gen), Fail] {
    let key = "row " + show(g, t)
    match g.names.get(key) {
        Some(k) => {
            return Ok(((jf(g, "row${k}"), jf(g, "values${k}")), g))
        },
        None => {},
    }
    let (n, args) = match t {
        TNamed(n, args) if g.structs.contains(n) && !ast.is_tuple_name(n) => (n, args),
        _ => {
            return Err(unsupported(g, "it is not a struct"))
        },
    }
    let sd = match g.structs.get(n) {
        Some(d) => d,
        None => {
            return Err(unsupported(g, "it is not a struct"))
        },
    }
    let env = sd.generics.zip(args)
    let mut fs: List[(Str, types.Ty)] = []
    for f in sd.fields {
        match field_ty(env, f.ty) {
            Ok(ft) => fs.push((f.name, ft)),
            Err(w) => {
                return Err(unsupported(g, "its field `{f.name}` holds {w}, which is not a column type"))
            },
        }
    }
    let owner = short(n)
    let row = var(g, "row")
    let x = var(g, "x")
    let mut reads: List[ast.FieldInit] = []
    let mut writes: List[ast.Expr] = []
    for (f, ft) in fs {
        let at = |k: Str| try_(g, call(g, jf(g, k + "_at"), [row, text(g, f), text(g, owner)]))
        let value = ex(g, EField(x, f, g.sp))
        match (column(ft), ft) {
            (Some(k), _) => {
                reads.push(ast.FieldInit { name: f, span: g.sp, value: try_(g, call(g, jf(g, "required"), [at(k), text(g, f), text(g, owner)])) })
                writes.push(call(g, jf(g, "of_" + k), [value]))
            },
            (None, TNamed("Option", [a])) if column(a).is_some() => {
                let k = column(a) ?? ""
                reads.push(ast.FieldInit { name: f, span: g.sp, value: at(k) })
                writes.push(call(g, jf(g, "of_option"), [value, var(g, jf(g, "of_" + k))]))
            },
            _ => {
                return Err(unsupported(g, "its field `{f}` is a {quoted(g, ft)}, which is not a column type"))
            },
        }
    }
    let mut g = g
    g.count = g.count + 1
    let k = g.count
    g.names[key] = k
    let reader = jf(g, "row${k}")
    let writer = jf(g, "values${k}")
    let fail = |what: Str| Fail { what, g }
    let tt = match written(g, t) {
        Ok(w) => w,
        Err(w) => { return Err(fail(w)) },
    }
    let lt = match written(g, TList(TNamed(jf(g, "Value"), []))) {
        Ok(w) => w,
        Err(w) => { return Err(fail(w)) },
    }
    let rowt = match written(g, TNamed(jf(g, "Row"), [])) {
        Ok(w) => w,
        Err(w) => { return Err(fail(w)) },
    }
    let rt = match written(g, TNamed("Result", [t, TNamed("IoError", [])])) {
        Ok(w) => w,
        Err(w) => { return Err(fail(w)) },
    }
    let made = ex(g, EStruct(n, g.sp, reads))
    g.out = g.out + [fn_item(g, reader, [param(g, "row", rowt)], rt, only(g, ok(g, made))), fn_item(g, writer, [param(g, "x", tt)], lt, only(g, ex(g, EList(writes))))]
    Ok(((reader, writer), g))
}

// A type with every variable the checker linked replaced by its type.
fn deep(s: types.Subst, t: types.Ty) -> types.Ty {
    let all = |ts: List[types.Ty]| ts.map(|x| deep(s, x))
    match s.repr(t) {
        TList(a) => TList(deep(s, a)),
        TChan(a) => TChan(deep(s, a)),
        TShared(a) => TShared(deep(s, a)),
        TGroup(a) => TGroup(deep(s, a)),
        TMap(a, b) => TMap(deep(s, a), deep(s, b)),
        TArray(a, b) => TArray(deep(s, a), deep(s, b)),
        TNamed(n, args) => TNamed(n, all(args)),
        TDyn(n, args) => TDyn(n, all(args)),
        TFn(ps, r) => TFn(all(ps), deep(s, r)),
        other => other,
    }
}

// Is the type known all the way down?
fn concrete(t: types.Ty) -> Bool {
    match t {
        TParam(_) | TVar(_) => false,
        TList(a) | TChan(a) | TShared(a) | TGroup(a) => concrete(a),
        TMap(a, b) | TArray(a, b) => concrete(a) && concrete(b),
        TNamed(_, args) | TDyn(_, args) => args.all(concrete),
        TFn(ps, r) => ps.all(concrete) && concrete(r),
        _ => true,
    }
}

// What expanding a checked program gives: its items with every use pointed
// at its conversion and the conversions added, the problems, and the id the
// next expression can have.
pub struct Expanded {
    items: List[ast.Item],
    diags: List[diag.Diag],
    next_id: Int,
}

// The loaded program's `items`, which checked as `c`, with every
// `json.encode` and `json.decode`, and every `sql.decode`, `sql.values`,
// `db.all` and `db.one`, pointed at its conversion; None when it uses none
// of them. `json` and `sql` are those modules' names in the program, when
// loaded. The items are the loaded ones, not the checker's rewritten ones,
// so checking the result is checking a new program; the uses keep their
// ids, which `c` knows.
pub fn expand(json: Option[Str], rows: List[Str], items: List[ast.Item], c: typecheck.Checked) -> Option[Expanded] {
    let mut structs: Map[Str, ast.StructDecl] = map()
    let mut enums: Map[Str, ast.EnumDecl] = map()
    // the prelude's types too: Result is an enum like any other
    for i in c.prelude + items {
        match i {
            IStruct(s) => {
                structs[s.name] = s
            },
            IEnum(e) => {
                enums[e.name] = e
            },
            _ => {},
        }
    }
    let span0 = ast.Span { file: 0, lo: 0, hi: 0 }
    let mut g = Gen { q: json ?? "", sp: span0, structs, enums, names: map(), cyc: map(), pln: map(), count: 0, out: [], subst: c.state.subst }
    // the modules that read rows into structs, each writing its own
    // conversions, and their problems
    let mut rgs = rows.map(|q| Gen { q, sp: span0, structs, enums, names: map(), cyc: map(), pln: map(), count: 0, out: [], subst: c.state.subst })
    let mut rdiags: List[List[diag.Diag]] = rows.map(|_| [])
    let mut wrappers: Map[Str, Str] = map()
    let mut diags: List[diag.Diag] = []
    let mut rewrites: Map[Int, ast.ExprDesc] = map()
    // the ids of the expressions written into the uses: after every id the
    // program has, before the written functions'
    let mut next = c.state.next_id
    let mut found = false
    let is_json = |n: Str| json.is_some() && (n == jf(g, "encode") || n == jf(g, "decode"))
    let row_module = |n: Str| rgs.with_index().find(|p| n == jf(p.1, "decode") || n == jf(p.1, "values")).map(|p| p.0)
    // a table test's case, then the body
    for e in items.flat_map(fn_exprs) {
        match e.desc {
            EVar(n) if is_json(n) => {
                found = true
                g.sp = e.span
                let encode = n == jf(g, "encode")
                let what = if encode { "json.encode" } else { "json.decode" }
                let note = if encode { "convert where the type is known, and pass the text" } else { "say the type: `let t: Todo = json.decode(s)?`" }
                match known(c, e, what, note) {
                    Err(d) => diags.push(d),
                    Ok(t) => {
                        let key = what + " " + show(g, t)
                        match wrappers.get(key) {
                            Some(w) => {
                                rewrites[e.id] = EVar(w)
                            },
                            None => match coders(g, t) {
                                Ok(((to, from), g2)) => {
                                    g = g2
                                    let kind = if encode { "encode" } else { "decode" }
                                    let w = jf(g, "{kind}${wrappers.len() + 1}")
                                    // the types here have a JSON form, so they can be written
                                    let written_t = written(g, t) ?? te(g, TyUnit)
                                    let str_t = te(g, TyName("Str", []))
                                    let item = if encode {
                                        fn_item(g, w, [param(g, "x", written_t)], str_t, only(g, call(g, jf(g, if plain(g, t) { "stringify" } else { "write" }), [call(g, to, [var(g, "x")])])))
                                    } else {
                                        let rt = written(g, TNamed("Result", [t, TStr])) ?? te(g, TyUnit)
                                        fn_item(g, w, [param(g, "s", str_t)], rt, only(g, call(g, jf(g, "from_text"), [var(g, "s"), var(g, from)])))
                                    }
                                    g.out = g.out + [item]
                                    wrappers[key] = w
                                    rewrites[e.id] = EVar(w)
                                },
                                Err(f) => {
                                    g = f.g
                                    // a function held through a struct's fields is named by its path
                                    let inner = match g.subst.fn_via(t) {
                                        Some(p) if f.what == "a function" => "a function through `{p}`",
                                        _ => f.what,
                                    }
                                    diags.push(no_form(g, e, what, t, inner, "JSON"))
                                },
                            },
                        }
                    },
                }
            },
            EVar(n) if row_module(n).is_some() => {
                found = true
                let j = row_module(n) ?? 0
                let mut sg = rgs[j]
                sg.sp = e.span
                // `sql`, also when the program names the module `std/sql`
                let m = sg.q.split("/").last() ?? sg.q
                let decode = n == jf(sg, "decode")
                let what = m + (if decode { ".decode" } else { ".values" })
                let note = if decode { "say the type: `let t: Todo = {m}.decode(row)?`" } else { "convert where the type is known" }
                match known(c, e, what, note) {
                    Err(d) => {
                        rdiags[j] = rdiags[j] + [d]
                    },
                    Ok(t) => match row_coders(sg, t) {
                        Ok(((reader, writer), g2)) => {
                            sg = g2
                            rewrites[e.id] = EVar(if decode { reader } else { writer })
                        },
                        Err(f) => {
                            sg = f.g
                            rdiags[j] = rdiags[j] + [no_form(sg, e, what, t, f.what, "SQL")]
                        },
                    },
                }
                rgs[j] = sg
            },
            EMethod(recv, m, _, args) if (m == "all" || m == "one") && db_module(c, recv, rgs).is_some() => {
                found = true
                let j = db_module(c, recv, rgs) ?? 0
                let mut sg = rgs[j]
                sg.sp = e.span
                let what = "db." + m
                let want = if m == "all" { "List[Todo]" } else { "Option[Todo]" }
                match known(c, e, what, "say the type: `let t: {want} = db.{m}(...)?`") {
                    Err(d) => {
                        rdiags[j] = rdiags[j] + [d]
                    },
                    Ok(t) => {
                        // the module too: the same struct can be read from sql and postgres
                        let key = sg.q + " " + what + " " + show(sg, t)
                        let w = match wrappers.get(key) {
                            Some(w) => Some(w),
                            None => match row_coders(sg, t) {
                                Ok(((reader, _), g2)) => {
                                    sg = g2
                                    let w = jf(sg, "{m}${wrappers.len() + 1}")
                                    sg.out = sg.out + [all_or_one(sg, w, m, t, reader)]
                                    wrappers[key] = w
                                    Some(w)
                                },
                                Err(f) => {
                                    sg = f.g
                                    rdiags[j] = rdiags[j] + [no_form(sg, e, what, t, f.what, "SQL")]
                                    None
                                },
                            },
                        }
                        match w {
                            Some(w) => {
                                let callee = ast.Expr { desc: EVar(w), span: e.span, id: next }
                                next = next + 1
                                rewrites[e.id] = ECall(callee, [recv] + args)
                            },
                            None => {},
                        }
                    },
                }
                rgs[j] = sg
            },
            _ => {},
        }
    }
    if !found {
        return None
    }
    let items = typecheck.rewrite_items({ c.state with rewrites }, items)
    let mut more: List[ast.Item] = []
    for i in g.out + rgs.flat_map(|x| x.out) {
        let (i2, n2) = ids.item(i, next)
        more.push(i2)
        next = n2
    }
    Some(Expanded { items: items + more, diags: diags + rdiags.flat_map(|d| d), next_id: next })
}

// The type a use converts, or an E0212 when it is not known.
fn known(c: typecheck.Checked, e: ast.Expr, what: Str, note: Str) -> Result[types.Ty, diag.Diag] {
    let t = match c.state.insts.get(e.id) {
        Some([(_, t)]) => deep(c.state.subst, t),
        _ => TErr,
    }
    if concrete(t) {
        return Ok(t)
    }
    let it = match t {
        TParam(p) => "the type parameter `{p}`",
        _ => "not known yet",
    }
    Err(diag.error("E0212", e.span, "`{what}` needs to know the type it converts here, and it is {it}").note(note))
}

// The E0212 for a type `what` cannot convert: `inner` is what in it has no
// form in `holds` (JSON or SQL).
fn no_form(g: Gen, e: ast.Expr, what: Str, t: types.Ty, inner: Str, holds: Str) -> diag.Diag {
    let msg = if inner == quoted(g, t) {
        "`{what}` cannot convert {quoted(g, t)}: it has no {holds} form"
    } else if holds == "SQL" {
        "`{what}` cannot convert {quoted(g, t)}: {inner}"
    } else {
        "`{what}` cannot convert {quoted(g, t)}: it holds {inner}, which has no {holds} form"
    }
    let note = if holds == "SQL" {
        "a row is read into a struct whose fields are Int, Float, Str, Bool, Bytes, or an Option of one of those"
    } else {
        "JSON holds Int, Float, Str, Bool, json.Value, Option, List, Map with Str keys, tuples, and structs and enums of those"
    }
    diag.error("E0212", e.span, msg).note(note)
}

// Which of the row modules `gens` has `recv`'s type as its `Db`.
fn db_module(c: typecheck.Checked, recv: ast.Expr, gens: List[Gen]) -> Option[Int] {
    match c.state.types.get(recv.id) {
        Some(t) => match deep(c.state.subst, t) {
            TNamed(n, []) => gens.with_index().find(|p| n == jf(p.1, "Db")).map(|p| p.0),
            _ => None,
        },
        None => None,
    }
}

// `sql.all$N(self: Db, text: Str, params: List[Value])`, or `one$N`: the
// query's rows, read by `reader`.
fn all_or_one(g: Gen, w: Str, m: Str, t: types.Ty, reader: Str) -> ast.Item {
    let db = written(g, TNamed(jf(g, "Db"), [])) ?? te(g, TyUnit)
    let values = written(g, TList(TNamed(jf(g, "Value"), []))) ?? te(g, TyUnit)
    let str_t = te(g, TyName("Str", []))
    let query = if m == "all" { "query" } else { "query_one" }
    let rows = try_(g, ex(g, EMethod(var(g, "self"), query, g.sp, [var(g, "text"), var(g, "params")])))
    let helper = if m == "all" { "rows_as" } else { "row_as" }
    let body = only(g, call(g, jf(g, helper), [rows, var(g, reader)]))
    let held = if m == "all" { TList(t) } else { TNamed("Option", [t]) }
    let ret = written(g, TNamed("Result", [held, TNamed("IoError", [])])) ?? te(g, TyUnit)
    // `params` defaults to `[]` as on the method it stands for, so a call
    // that left it out still fits
    let params = { param(g, "params", values) with default: Some(ex(g, EList([]))) }
    fn_item(g, w, [param(g, "self", db), param(g, "text", str_t), params], ret, body)
}

fn fn_exprs(i: ast.Item) -> List[ast.Expr] {
    match i {
        IFn(d) => (d.table.map(|t| walk.expr(t.cases)) ?? []) + walk.block(d.body),
        _ => [],
    }
}
