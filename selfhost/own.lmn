// Ownership, as src/own.ml decides it: where the IR retains a value and
// where it releases one (Perceus-style, without reuse).
//
// 1. Backward liveness over the structured IR (loops iterate to a
//    fixpoint).
// 2. A forward pass tracking which variables currently own their value:
//    - a consuming use of a variable that is dead afterwards is a move;
//      otherwise it becomes VDup (retain);
//    - an owned variable is released (Drop) right after its last use, at
//      the start of a branch that does not use it, and before break,
//      continue and return.
// Moving the last use is what keeps reference counts at 1, so `xs.push`
// and `xs[i] = v` mutate in place instead of copying.
use intset
use ir

// A statement with what is live after it, and its blocks so annotated.
struct Ann {
    s: ir.Stmt,
    out: List[Int],
    sub: Sub,
}

enum Sub {
    NoSub,
    IfSub(ABlock, ABlock),
    LoopSub(ABlock),
    // the handler, then the body
    GuardSub(ABlock, ABlock),
    ScopeSub(ABlock),
}

// A block's statements, and what is live at its start.
struct ABlock {
    stmts: List[Ann],
    lin: List[Int],
}

fn ids(atoms: List[ir.Atom]) -> List[Int] {
    intset.of_list(atoms.flat_map(|a| match ir.atom_var(a) {
        Some(v) => [v.id],
        None => [],
    }))
}

fn rhs_uses(r: ir.Rhs) -> List[Int] {
    ids(ir.consumed(r) + ir.borrowed(r))
}

// Where control goes after a break and a continue: what is live there.
struct Exits {
    brk: List[Int],
    cont: List[Int],
}

fn no_exits() -> Exits {
    Exits { brk: [], cont: [] }
}

// `refs`: the function's `mut` parameters, owned all through it and never
// released, since the caller's place keeps the value; they are pinned
// everywhere, handlers included.
// `pin`: variables a defer's handler reads; they stay live at every point
// of its guarded statements, since a panic can leave them anywhere.
fn live_block(refs: List[Int], pin: List[Int], stmts: List[ir.Stmt], out: List[Int], ex: Exits) -> ABlock {
    let mut live = intset.union(out, pin)
    let mut anns: List[Ann] = []
    for s in stmts.reverse() {
        let (a, l) = live_stmt(refs, pin, s, live, ex)
        anns.push(a)
        live = l
    }
    ABlock { stmts: anns.reverse(), lin: live }
}

fn live_stmt(refs: List[Int], pin: List[Int], s: ir.Stmt, out: List[Int], ex: Exits) -> (Ann, List[Int]) {
    let out = intset.union(out, pin)
    let plain = |l: List[Int]| (Ann { s, out, sub: NoSub }, intset.union(l, pin))
    match s {
        Let(v, r) | Init(v, r) | Set(v, r, _) => plain(intset.union(intset.remove(out, v.id), rhs_uses(r))),
        Decl(v) => plain(intset.remove(out, v.id)),
        Mutate(v, steps, m) => plain(intset.add(intset.union(out, ids(ir.mut_atoms(m) + ir.step_atoms(steps))), v.id)),
        If(c, a, b) => {
            let ba = live_block(refs, pin, a, out, ex)
            let bb = live_block(refs, pin, b, out, ex)
            (Ann { s, out, sub: IfSub(ba, bb) }, intset.union(pin, intset.union(ids([c]), intset.union(ba.lin, bb.lin))))
        },
        Loop(body) => {
            let mut l = intset.empty()
            let mut b = live_block(refs, pin, body, l, Exits { brk: out, cont: l })
            while b.lin != l {
                l = intset.union(l, b.lin)
                b = live_block(refs, pin, body, l, Exits { brk: out, cont: l })
            }
            (Ann { s, out, sub: LoopSub(b) }, intset.union(pin, b.lin))
        },
        Break => plain(ex.brk),
        Continue => plain(ex.cont),
        Return(a) => plain(ids([a])),
        Drop(_) | GuardEnd(_) | Line(_) => plain(out),
        Scope(g, body) => {
            // the deadline can stop the body anywhere; the code after reads
            // only what is live after it, which the body keeps
            let bb = live_block(refs, pin, body, out, ex)
            (Ann { s, out, sub: ScopeSub(bb) }, intset.union(pin, intset.union(ids([g]), bb.lin)))
        },
        Guard(_, h, b) => {
            // A panic can leave the body anywhere, and the handler then reads
            // what it uses: those variables stay live, so retained and never
            // moved or dropped, all through the body.
            let hb = live_block(refs, refs, h, intset.empty(), no_exits())
            let pinned = intset.union(pin, hb.lin)
            let bb = live_block(refs, pinned, b, out, ex)
            (Ann { s, out, sub: GuardSub(hb, bb) }, intset.union(pinned, bb.lin))
        },
    }
}

// ---------- the forward pass ----------

// The variables of the function being rewritten, by id.
struct Fwd {
    vars: Map[Int, ir.Var],
    // the `mut` parameters (see live_block)
    refs: List[Int],
}

fn drops(self: Fwd, set: List[Int]) -> List[ir.Stmt] {
    set.map(|id| Drop(self.vars[id]))
}

// Rewrite the consumed atoms of a statement: move or retain.
fn consume(atoms: List[ir.Atom], live_after: List[Int], borrowed: List[Int], mut owned: List[Int]) -> List[ir.Atom] {
    let mut count: Map[Int, Int] = map()
    for a in atoms {
        match ir.atom_var(a) {
            Some(v) => {
                count[v.id] = (count.get(v.id) ?? 0) + 1
            },
            None => {},
        }
    }
    let mut out: List[ir.Atom] = []
    for a in atoms {
        match a {
            V(v) => {
                let left = count[v.id]
                count[v.id] = left - 1
                if intset.mem(live_after, v.id) || left > 1 || intset.mem(borrowed, v.id) || !intset.mem(owned, v.id) {
                    out.push(VDup(v))
                } else {
                    owned = intset.remove(owned, v.id)
                    out.push(V(v))
                }
            },
            _ => out.push(a),
        }
    }
    out
}

fn rewrite_rhs(r: ir.Rhs, live_after: List[Int], mut owned: List[Int]) -> ir.Rhs {
    let borrowed = ids(ir.borrowed(r))
    match r {
        Use(a) => {
            let xs = consume([a], live_after, borrowed, mut owned)
            Use(xs[0])
        },
        Call(n, args) => {
            let xs = consume(args, live_after, borrowed, mut owned)
            Call(n, xs)
        },
        CallMut(n, args) => {
            // the values are consumed; each place's variable and step atoms
            // are borrowed, so a value that names one is retained
            let xs = consume(ir.consumed(r), live_after, borrowed, mut owned)
            let mut k = 0
            let mut rebuilt: List[ir.Arg] = []
            for x in args {
                match x {
                    ByValue(_) => {
                        rebuilt.push(ByValue(xs[k]))
                        k = k + 1
                    },
                    ByPlace(..) => rebuilt.push(x),
                }
            }
            CallMut(n, rebuilt)
        },
        CallClo(f, args) => {
            let xs = consume(args, live_after, borrowed, mut owned)
            CallClo(f, xs)
        },
        MkStruct(t, args) => {
            let xs = consume(args, live_after, borrowed, mut owned)
            MkStruct(t, xs)
        },
        MkEnum(t, k, args) => {
            let xs = consume(args, live_after, borrowed, mut owned)
            MkEnum(t, k, xs)
        },
        MkList(t, args) => {
            let xs = consume(args, live_after, borrowed, mut owned)
            MkList(t, xs)
        },
        MkClosure(n, t, args) => {
            let xs = consume(args, live_after, borrowed, mut owned)
            MkClosure(n, t, xs)
        },
        Spawn(g, task, t, keep) => {
            let xs = consume([task], live_after, borrowed, mut owned)
            Spawn(g, xs[0], t, keep)
        },
        ChanSend(ch, v, sp) => {
            let xs = consume([v], live_after, borrowed, mut owned)
            ChanSend(ch, xs[0], sp)
        },
        Select(id, ops, d, sp) => {
            let sends = ops.flat_map(|op| match op {
                SSend(_, v, _, _) => [v],
                SRecv(..) | SAfter(..) => [],
            })
            let xs = consume(sends, live_after, borrowed, mut owned)
            let mut k = 0
            let mut rebuilt: List[ir.Sel] = []
            for op in ops {
                match op {
                    SSend(ch, _, t, g) => {
                        rebuilt.push(SSend(ch, xs[k], t, g))
                        k = k + 1
                    },
                    _ => rebuilt.push(op),
                }
            }
            Select(id, rebuilt, d, sp)
        },
        MkDyn(t, i, v, ms) => {
            let xs = consume([v], live_after, borrowed, mut owned)
            MkDyn(t, i, xs[0], ms)
        },
        CallDyn(k, ps, rt, recv, args) => {
            let xs = consume(args, live_after, borrowed, mut owned)
            CallDyn(k, ps, rt, recv, xs)
        },
        _ => r,
    }
}

fn fwd_block(self: Fwd, b: ABlock, mut owned: List[Int], ex: Exits) -> List[ir.Stmt] {
    let entry = intset.diff(owned, b.lin)
    let mut acc = self.drops(entry)
    owned = intset.diff(owned, entry)
    for a in b.stmts {
        let ss = self.fwd_stmt(a, mut owned, ex)
        for s in ss {
            acc.push(s)
        }
    }
    acc
}

// Statement `s` and the drops of what `owned` holds that is not live after
// it (`out`).
fn after(self: Fwd, s: ir.Stmt, out: List[Int], mut owned: List[Int]) -> List[ir.Stmt] {
    let d = intset.diff(owned, out)
    owned = intset.diff(owned, d)
    [s] + self.drops(d)
}

fn fwd_stmt(self: Fwd, a: Ann, mut owned: List[Int], ex: Exits) -> List[ir.Stmt] {
    match (a.s, a.sub) {
        (Let(v, r), _) => {
            let r = rewrite_rhs(r, a.out, mut owned)
            owned = intset.add(owned, v.id)
            self.after(Let(v, r), a.out, mut owned)
        },
        (Init(v, r), _) => {
            let r = rewrite_rhs(r, a.out, mut owned)
            owned = intset.add(owned, v.id)
            self.after(Init(v, r), a.out, mut owned)
        },
        (Set(v, r, _), _) => {
            let r = rewrite_rhs(r, intset.remove(a.out, v.id), mut owned)
            let s = Set(v, r, intset.mem(owned, v.id))
            owned = intset.add(owned, v.id)
            self.after(s, a.out, mut owned)
        },
        (Decl(v), _) => [Decl(v)],
        (Mutate(v, steps, m), _) => {
            let borrowed = intset.add(ids(ir.step_atoms(steps)), v.id)
            let xs = consume(ir.mut_atoms(m), a.out, borrowed, mut owned)
            let m = match m {
                MSet(_) => MSet(xs[0]),
                MPush(_) => MPush(xs[0]),
                MRemove(_) => MRemove(xs[0]),
                MPut(..) => MPut(xs[0], xs[1]),
            }
            self.after(Mutate(v, steps, m), a.out, mut owned)
        },
        (If(c, _, _), IfSub(ba, bb)) => {
            // both branches start from what is owned before the `if`
            let mut oa = owned
            let sa = self.fwd_block(ba, mut oa, ex)
            let mut ob = owned
            let sb = self.fwd_block(bb, mut ob, ex)
            owned = intset.inter(a.out, intset.union(oa, ob))
            [If(c, sa, sb)]
        },
        (Loop(_), LoopSub(b)) => {
            let mut inside = owned
            let body = self.fwd_block(b, mut inside, Exits { brk: a.out, cont: b.lin })
            owned = intset.inter(owned, a.out)
            [Loop(body)]
        },
        (Scope(g, _), ScopeSub(bb)) => {
            let sb = self.fwd_block(bb, mut owned, ex)
            [Scope(g, sb)]
        },
        (Guard(n, _, _), GuardSub(hb, bb)) => {
            // the handler owns nothing from outside but the `mut` parameters:
            // its uses retain, and the frame's cleanups drop the variables as
            // the panic goes on
            let mut held = self.refs
            let sh = self.fwd_block(hb, mut held, no_exits())
            let sb = self.fwd_block(bb, mut owned, ex)
            // what the handler kept alive and nothing after needs
            let left = intset.diff(owned, a.out)
            owned = intset.inter(a.out, owned)
            [Guard(n, sh, sb)] + self.drops(left)
        },
        (Break, _) => {
            let ss = self.drops(intset.diff(owned, ex.brk)) + [Break]
            owned = intset.empty()
            ss
        },
        (Continue, _) => {
            let ss = self.drops(intset.diff(owned, ex.cont)) + [Continue]
            owned = intset.empty()
            ss
        },
        (Return(x), _) => {
            let xs = consume([x], intset.empty(), self.refs, mut owned)
            let ss = self.drops(intset.diff(owned, self.refs)) + [Return(xs[0])]
            owned = intset.empty()
            ss
        },
        (s, _) => [s],
    }
}

fn collect_vars(vars: Map[Int, ir.Var], stmts: List[ir.Stmt]) -> Map[Int, ir.Var] {
    let mut vars = vars
    for s in stmts {
        match s {
            Let(v, _) | Decl(v) | Init(v, _) | Set(v, _, _) | Mutate(v, _, _) | Drop(v) => {
                vars[v.id] = v
            },
            If(_, a, b) => {
                vars = collect_vars(collect_vars(vars, a), b)
            },
            Loop(b) | Scope(_, b) => {
                vars = collect_vars(vars, b)
            },
            Guard(_, h, b) => {
                vars = collect_vars(collect_vars(vars, h), b)
            },
            _ => {},
        }
    }
    vars
}

pub fn function(f: ir.Fn) -> ir.Fn {
    let mut vars: Map[Int, ir.Var] = map()
    for v in f.params + f.captures {
        vars[v.id] = v
    }
    let refs = intset.of_list(f.params.filter(|v| v.by_ref).map(|v| v.id))
    let fwd = Fwd { vars: collect_vars(vars, f.body), refs }
    let b = live_block(refs, refs, f.body, intset.empty(), no_exits())
    let mut owned = intset.of_list((f.params + f.captures).map(|v| v.id))
    let body = fwd.fwd_block(b, mut owned, no_exits())
    { f with body }
}

pub fn program(p: ir.Program) -> ir.Program {
    { p with fns: p.fns.map(function) }
}
