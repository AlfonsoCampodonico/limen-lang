// Every expression of a part of the tree, for passes that look for some of
// them: an expression first, then the ones inside it, in the order they
// are written (the order selfhost/ids.lmn numbers them in).
use ast

// The expressions of an item: a table test's cases and a function's body.
pub fn item(i: ast.Item) -> List[ast.Expr] {
    match i {
        IFn(d) => from(maybe(d.table.map(|t| t.cases)) + block_kids(d.body)),
        IStruct(_) | IEnum(_) | IIface(_) | IType(_) => [],
    }
}

pub fn expr(e: ast.Expr) -> List[ast.Expr] {
    from([e])
}

pub fn block(b: ast.Block) -> List[ast.Expr] {
    from(block_kids(b))
}

// `roots` and every expression inside them, each before the ones inside
// it. Through a stack of expressions still to visit rather than
// recursion, so a long chain (`a + b + c ...`, `x.f().g()...`, `else if`)
// costs time in proportion to its length and no stack.
fn from(roots: List[ast.Expr]) -> List[ast.Expr] {
    let mut out: List[ast.Expr] = []
    let mut stack = roots.reverse()
    let mut top = stack.len()
    while top > 0 {
        top = top - 1
        let e = stack[top]
        out.push(e)
        let kids = below(e)
        let mut k = kids.len()
        while k > 0 {
            k = k - 1
            if top < stack.len() {
                stack[top] = kids[k]
            } else {
                stack.push(kids[k])
            }
            top = top + 1
        }
    }
    out
}

// The expressions directly in a block: those of its statements, with the
// statements of the blocks those hold, and its tail.
pub fn block_kids(b: ast.Block) -> List[ast.Expr] {
    b.stmts.flat_map(stmt) + maybe(b.tail)
}

fn stmt(s: ast.Stmt) -> List[ast.Expr] {
    match s.desc {
        SLet(_, _, _, _, e) | SExpr(e) | SLetPat(_, e) => [e],
        SAssign(a, b) => [a, b],
        SReturn(e) => maybe(e),
        SWhile(c, body) | SFor(_, _, c, body) | SForPat(_, c, body) => [c] + block_kids(body),
        SDefer(body) => block_kids(body),
        SBreak | SContinue => [],
    }
}

fn maybe(e: Option[ast.Expr]) -> List[ast.Expr] {
    match e {
        Some(x) => [x],
        None => [],
    }
}

// The expressions directly inside `e`, as written.
fn below(e: ast.Expr) -> List[ast.Expr] {
    match e.desc {
        EInt(_) | EFloat(_) | EBool(_) | EUnit | EVar(_) => [],
        EStr(parts) => parts.flat_map(|part| match part {
            SPExpr(x) => [x],
            SPLit(_) => [],
        }),
        EList(items) => items,
        EBin(_, a, b) | EPipe(a, b) | EIndex(a, b) | ESafe(a, _, b) => [a, b],
        EUn(_, a) | EField(a, _, _) | ENamed(_, _, a) | EMut(a) | EClosure(_, a) | EDyn(a, _) => [a],
        ECall(f, args) | EMethod(f, _, _, args) => [f] + args,
        ETry(a, context) => [a] + maybe(context),
        EIf(c, then, other) => [c] + block_kids(then) + maybe(other),
        EMatch(s, arms) => [s] + arms.flat_map(|a| maybe(a.guard) + [a.body]),
        EBlock(b) => block_kids(b),
        EStruct(_, _, fields) => fields.map(|f| f.value),
        EWith(base, fields) => [base] + fields.map(|f| f.value),
        EGroup(_, _, until, b) => (until.map(|d| [d.clock, d.ms]) ?? []) + block_kids(b),
        ESelect(arms) => arms.flat_map(|a| sel_op(a.op) + maybe(a.guard) + [a.body]),
    }
}

pub fn sel_op(o: ast.SelOp) -> List[ast.Expr] {
    match o {
        SelRecv(_, ch) => [ch],
        SelSend(ch, v) => [ch, v],
        SelAfter(clock, ms) => [clock, ms],
        SelDefault => [],
    }
}
