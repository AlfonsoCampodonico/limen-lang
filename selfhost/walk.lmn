// Every expression of a part of the tree, for passes that look for some of
// them: an expression first, then the ones inside it, in the order they
// are written (the order selfhost/ids.lmn numbers them in).
use ast

// The expressions of an item: a table test's cases and a function's body.
pub fn item(i: ast.Item) -> List[ast.Expr] {
    match i {
        IFn(d) => maybe(d.table.map(|t| t.cases)) + block(d.body),
        IStruct(_) | IEnum(_) | IIface(_) | IType(_) => [],
    }
}

pub fn expr(e: ast.Expr) -> List[ast.Expr] {
    [e] + below(e)
}

pub fn block(b: ast.Block) -> List[ast.Expr] {
    b.stmts.flat_map(stmt) + maybe(b.tail)
}

fn stmt(s: ast.Stmt) -> List[ast.Expr] {
    match s.desc {
        SLet(_, _, _, _, e) | SExpr(e) | SLetPat(_, e) => expr(e),
        SAssign(a, b) => expr(a) + expr(b),
        SReturn(e) => maybe(e),
        SWhile(c, body) | SFor(_, _, c, body) | SForPat(_, c, body) => expr(c) + block(body),
        SDefer(body) => block(body),
        SBreak | SContinue => [],
    }
}

fn maybe(e: Option[ast.Expr]) -> List[ast.Expr] {
    e.map(expr) ?? []
}

fn all(es: List[ast.Expr]) -> List[ast.Expr] {
    es.flat_map(expr)
}

// The expressions inside `e`, all the way down.
fn below(e: ast.Expr) -> List[ast.Expr] {
    match e.desc {
        EInt(_) | EFloat(_) | EBool(_) | EUnit | EVar(_) => [],
        EStr(parts) => parts.flat_map(|part| match part {
            SPExpr(x) => expr(x),
            SPLit(_) => [],
        }),
        EList(items) => all(items),
        EBin(_, a, b) | EPipe(a, b) | EIndex(a, b) | ESafe(a, _, b) => expr(a) + expr(b),
        EUn(_, a) | EField(a, _, _) | ENamed(_, _, a) | EClosure(_, a) | EDyn(a, _) => expr(a),
        ECall(f, args) | EMethod(f, _, _, args) => expr(f) + all(args),
        ETry(a, context) => expr(a) + maybe(context),
        EIf(c, then, other) => expr(c) + block(then) + maybe(other),
        EMatch(s, arms) => expr(s) + arms.flat_map(|a| maybe(a.guard) + expr(a.body)),
        EBlock(b) => block(b),
        EStruct(_, _, fields) => all(fields.map(|f| f.value)),
        EWith(base, fields) => expr(base) + all(fields.map(|f| f.value)),
        EGroup(_, _, until, b) => all(until.map(|d| [d.clock, d.ms]) ?? []) + block(b),
        ESelect(arms) => arms.flat_map(|a| all(sel_op(a.op)) + maybe(a.guard) + expr(a.body)),
    }
}

fn sel_op(o: ast.SelOp) -> List[ast.Expr] {
    match o {
        SelRecv(_, ch) => [ch],
        SelSend(ch, v) => [ch, v],
        SelAfter(clock, ms) => [clock, ms],
        SelDefault => [],
    }
}
