// The checked program, lowered to the IR of selfhost/ir.lmn, as
// src/lower.ml does it. Generic functions are instantiated per concrete
// type arguments (monomorphization); closures are lifted to top-level
// functions that receive their captured values; list map, filter and fold
// and the Option and Result helpers become plain loops and branches.
//
// The OCaml lowering keeps a mutable context per function, with a pointer
// to the enclosing one for closures. Here the whole context is one value,
// `Lx`, passed to every step as `mut self`: the function being lowered
// is `cur`, the ones around it (for a closure) are `parents`, innermost
// first.
// Lowering a nested block, which OCaml does by running a callback between
// saving and restoring the statement buffer, is `open` and `close` here.
//
// Variables, lifted functions and instances are numbered in the order
// OCaml makes them, which is also the order it evaluates its expressions
// in, so the IR comes out the same, numbers included. That holds even in
// code lowered after a panic, which emits nothing but still numbers what
// it makes.
use ast
use env
use exhaust
use ffi
use free
use ir
use types
use walk

// What lowering reads and never changes: the checked program.
pub struct Ro {
    // whether to mark where each Limen statement starts (ir.Line), for
    // `#line` in the C of a development build
    lines: Bool,
    // `--profile`: count calls and sample the CPU, function by function
    profile: Bool,
    fns: Map[Str, ast.FnDecl],
    structs: Map[Str, ast.StructDecl],
    enums: Map[Str, ast.EnumDecl],
    // variant -> its enum, when only one enum defines it
    ctors: Map[Str, Str],
    // each expression's type and type arguments, by id, read through the
    // checker's final substitution
    types: Map[Int, types.Ty],
    insts: Map[Int, List[(Str, types.Ty)]],
    // `a?.b` whose rest is an Option already
    nested: Map[Int, Bool],
    subst: types.Subst,
    ifaces: Map[Str, List[env.IfaceMethod]],
    iface_gen: Map[Str, List[Str]],
}

// A `defer` being lowered: its body, the names in scope at the defer, the
// loop depth there, its guard number and the defers around it.
struct Deferred {
    body: ast.Block,
    scopes: List[Map[Str, ir.Var]],
    loop_depth: Int,
    id: Int,
    outer: List[Deferred],
}

// A function being lowered.
struct Frame {
    // its type parameters' types
    genv: List[(Str, types.Ty)],
    // innermost first
    scopes: List[Map[Str, ir.Var]],
    // the statements so far
    buf: List[ir.Stmt],
    // control cannot reach this point
    dead: Bool,
    ret: types.Ty,
    // captured: the variable outside, the one inside
    caps: List[(ir.Var, ir.Var)],
    // innermost first
    defers: List[Deferred],
    loop_depth: Int,
}

// A job: an instance to lower, its C name, its declaration and type
// arguments.
struct Job {
    cname: Str,
    decl: ast.FnDecl,
    targs: List[(Str, types.Ty)],
}

pub struct Lx {
    ro: Ro,
    // "name[args]" -> C name
    instances: Map[Str, Str],
    queue: List[Job],
    // the next job of the queue to lower
    next_job: Int,
    out: List[ir.Fn],
    // lifted functions and selects
    counter: Int,
    // the last variable and guard numbers given
    vars: Int,
    guards: Int,
    cur: Frame,
    parents: List[Frame],
    // variables never reassigned that hold a pure function: a pure closure
    // literal or a top-level function. A closure that captures one is
    // still pure (fusion, pure_closure).
    pure_fns: List[Int],
}

// What a nested block saved of the one around it.
struct Saved {
    buf: List[ir.Stmt],
    dead: Bool,
}

// A function argument of map, filter or fold: a closure literal inlined
// where it is applied, or a value called.
enum Prep {
    Inline(List[Str], ast.Expr),
    Value(ir.Atom),
}

// What a fused loop does with each item that gets through the stages.
enum Terminal {
    FoldInto(ir.Var, Prep),
    MapInto(ir.Var, Prep),
    FilterInto(ir.Var, Prep),
}

fn new_frame(genv: List[(Str, types.Ty)], ret: types.Ty) -> Frame {
    Frame { genv, scopes: [map()], buf: [], dead: false, ret, caps: [], defers: [], loop_depth: 0 }
}

fn no_subst() -> types.Subst {
    types.empty()
}

pub fn show(t: types.Ty) -> Str {
    no_subst().show(t)
}

// ---------- the context ----------

fn fresh_var(mut self: Lx, name: Str, ty: types.Ty) -> ir.Var {
    self.vars = self.vars + 1
    ir.Var { id: self.vars, name, ty, by_ref: false }
}

fn emit(mut self: Lx, s: ir.Stmt) {
    if self.cur.dead {
        return
    }
    self.cur.buf.push(s)
}

fn emit_all(mut self: Lx, ss: List[ir.Stmt]) {
    for s in ss {
        self.emit(s)
    }
}

fn tmp(mut self: Lx, ty: types.Ty, rhs: ir.Rhs) -> ir.Atom {
    let v = self.fresh_var("t", ty)
    self.emit(Let(v, rhs))
    V(v)
}

fn set_dead(mut self: Lx) {
    self.cur.dead = true
}

fn bind(mut self: Lx, n: Str, v: ir.Var) {
    self.cur.scopes[0][n] = v
}

fn push_scope(mut self: Lx) {
    self.cur.scopes = [map()] + self.cur.scopes
}

fn pop_scope(mut self: Lx) {
    self.cur.scopes = self.cur.scopes.skip(1)
}

// Start collecting statements into a separate block with its own scope.
fn open(mut self: Lx) -> Saved {
    let saved = Saved { buf: self.cur.buf, dead: self.cur.dead }
    self.cur.buf = []
    self.cur.dead = false
    self.push_scope()
    saved
}

// The block's statements, and whether control can leave its end.
fn close(mut self: Lx, saved: Saved) -> (List[ir.Stmt], Bool) {
    self.pop_scope()
    let stmts = self.cur.buf
    let dead = self.cur.dead
    self.cur.buf = saved.buf
    self.cur.dead = saved.dead
    (stmts, dead)
}

// The block that only breaks out of the loop.
fn break_block(mut self: Lx) -> List[ir.Stmt] {
    let saved = self.open()
    self.emit(Break)
    self.set_dead()
    let (b, _) = self.close(saved)
    b
}

fn frame(self: Lx, depth: Int) -> Frame {
    if depth == 0 { self.cur } else { self.parents[depth - 1] }
}

// The variable `n` names in the function `depth` levels out. A variable of
// an enclosing function is captured: the closure gets a variable of its
// own for it, made the first time it is used, in every closure between.
fn lookup_at(mut self: Lx, depth: Int, n: Str) -> Option[ir.Var] {
    for s in self.frame(depth).scopes {
        match s.get(n) {
            Some(v) => {
                return Some(v)
            },
            None => {},
        }
    }
    if depth >= self.parents.len() {
        return None
    }
    let found = self.lookup_at(depth + 1, n)
    match found {
        None => None,
        Some(outer) => match self.frame(depth).caps.find(|c| c.0.id == outer.id) {
            Some(c) => Some(c.1),
            None => {
                let inner = self.fresh_var(n, outer.ty)
                if depth == 0 {
                    self.cur.caps.push((outer, inner))
                } else {
                    self.parents[depth - 1].caps.push((outer, inner))
                }
                Some(inner)
            },
        },
    }
}

fn lookup(mut self: Lx, n: Str) -> Option[ir.Var] {
    self.lookup_at(0, n)
}

// `lookup` without capturing: the variable where it is declared.
fn peek(self: Lx, n: Str) -> Option[ir.Var] {
    for depth in 0..<self.parents.len() + 1 {
        for s in self.frame(depth).scopes {
            match s.get(n) {
                Some(v) => {
                    return Some(v)
                },
                None => {},
            }
        }
    }
    None
}

// One of `pure_fns`, or a capture of one, in the function `depth` levels
// out.
fn pure_fn_var(self: Lx, depth: Int, v: ir.Var) -> Bool {
    if self.pure_fns.contains(v.id) {
        return true
    }
    match self.frame(depth).caps.find(|c| c.1.id == v.id) {
        Some(c) if depth < self.parents.len() => self.pure_fn_var(depth + 1, c.0),
        _ => false,
    }
}

fn not_local(mut self: Lx, n: Str) -> Bool {
    let found = self.lookup(n)
    found.is_none()
}

fn is_enum_name(mut self: Lx, n: Str) -> Bool {
    let no = self.not_local(n)
    no && self.ro.enums.contains(n)
}

// ---------- types ----------

// The type a written type stands for, with the type parameters of `env`.
pub fn resolve(env: List[(Str, types.Ty)], te: ast.TyExpr) -> types.Ty {
    let assoc = |n: Str| env.find(|p| p.0 == n).map(|p| p.1)
    match te.desc {
        TyUnit => TUnit,
        TyFn(ps, r) => TFn(ps.map(|p| resolve(env, p)), resolve(env, r)),
        TyInt(_) => TUnit,
        TyName("Array", [elt, size]) if is_len(env, size) => match size.desc {
            TyInt(n) => TArray(resolve(env, elt), TLen(n)),
            TyName(g, _) => TArray(resolve(env, elt), assoc(g) ?? TUnit),
            _ => TUnit,
        },
        TyName("dyn", [target]) if is_named(target) => match target.desc {
            TyName(i, args) => TDyn(i, args.map(|a| resolve(env, a))),
            _ => TUnit,
        },
        TyName(n, args) => {
            let a = args.map(|x| resolve(env, x))
            match (n, a) {
                ("Int", _) => TInt,
                ("Float", _) => TFloat,
                ("Bool", _) => TBool,
                ("Str", _) => TStr,
                ("Bytes", _) => TBytes,
                ("UInt8", _) => TUInt(8),
                ("UInt16", _) => TUInt(16),
                ("UInt32", _) => TUInt(32),
                ("UInt64", _) => TUInt(64),
                ("List", [x]) => TList(x),
                ("Chan", [x]) => TChan(x),
                ("Atomic", _) => TAtomic,
                ("Shared", [x]) => TShared(x),
                ("Map", [k, v]) => TMap(k, v),
                _ if is_cap(n) => TCap(n),
                _ => assoc(n) ?? TNamed(n, a),
            }
        },
    }
}

fn is_cap(n: Str) -> Bool {
    ["Root", "Net", "Fs", "Stdout", "Stderr", "Clock", "Listen", "Listener", "Conn", "Rand", "Stdin", "Env", "Exec", "Foreign", "Revoker"].contains(n)
}

// An array's size: a number, or a type parameter that stands for one.
fn is_len(env: List[(Str, types.Ty)], size: ast.TyExpr) -> Bool {
    match size.desc {
        TyInt(_) => true,
        TyName(g, []) => env.any(|p| p.0 == g),
        _ => false,
    }
}

fn is_named(te: ast.TyExpr) -> Bool {
    match te.desc {
        TyName(..) => true,
        _ => false,
    }
}

// The fields of struct type `t`, with their types.
pub fn field_types(ro: Ro, t: types.Ty) -> List[(Str, types.Ty)] {
    match t {
        TNamed(n, args) => {
            let s = ro.structs[n]
            let env = s.generics.zip(args)
            s.fields.map(|f| (f.name, resolve(env, f.ty)))
        },
        _ => panic("field_types"),
    }
}

// The variants of enum type `t`, with their payload types.
pub fn variants(ro: Ro, t: types.Ty) -> List[(Str, List[types.Ty])] {
    match t {
        TNamed(n, args) => {
            let e = ro.enums[n]
            let env = e.generics.zip(args)
            e.variants.map(|v| (v.name, v.payload.map(|p| resolve(env, p))))
        },
        _ => panic("variants"),
    }
}

fn index_of(x: Str, l: List[Str]) -> Int {
    for (i, y) in l.with_index() {
        if y == x {
            return i
        }
    }
    panic("index_of " + x)
}

pub fn field_index(ro: Ro, t: types.Ty, name: Str) -> Int {
    index_of(name, field_types(ro, t).map(|f| f.0))
}

pub fn tag_of(ro: Ro, t: types.Ty, v: Str) -> Int {
    index_of(v, variants(ro, t).map(|x| x.0))
}

fn is_struct(ro: Ro, t: types.Ty) -> Bool {
    match t {
        TNamed(n, _) => ro.structs.contains(n),
        _ => false,
    }
}

// The type of `e` in the function being lowered: concrete.
fn tyof(self: Lx, e: ast.Expr) -> types.Ty {
    self.ro.subst.zonk(self.cur.genv, self.ro.types.get(e.id) ?? TErr)
}

// The type arguments of a generic function's use, made concrete.
fn inst_of(self: Lx, e: ast.Expr) -> List[(Str, types.Ty)] {
    let insts = self.ro.insts.get(e.id) ?? []
    insts.map(|p| (p.0, self.ro.subst.zonk(self.cur.genv, p.1)))
}

// The methods of interface `i` with these type arguments.
pub fn iface_methods(ro: Ro, i: Str, args: List[types.Ty]) -> List[env.IfaceMethod] {
    let ms = ro.ifaces.get(i) ?? []
    match ro.iface_gen.get(i) {
        Some(gs) if !gs.is_empty() && gs.len() == args.len() => {
            let e = gs.zip(args)
            ms.map(|m| { m with params: m.params.map(|p| ro.subst.subst(e, p)), ret: ro.subst.subst(e, m.ret) })
        },
        _ => ms,
    }
}

// ---------- function instances ----------

// The C name of function `name`: `wf_NAME` for the main file's, and for
// module M's `wmN_M_NAME` (`wsN_M_NAME` for the standard library's
// `std/M`), N the length of M, so no two modules' names meet in C,
// whatever underscores their names have.
fn c_name(name: Str) -> Str {
    let safe = |s: Str| bytes(s.bytes().map(|ch| if (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 95 { ch } else { 95 })).to_str()
    match name.index_of(".") {
        None => "wf_" + safe(name),
        Some(k) => {
            let m = name.slice(0, k)
            let rest = name.slice(k + 1, name.len())
            let (tag, m) = if m.starts_with("std/") { ("ws", m.slice(4, m.len())) } else { ("wm", m) }
            "{tag}{m.len()}_{m}_{safe(rest)}"
        },
    }
}

// The C name of function `name` instantiated with `targs`, queued to be
// lowered the first time.
fn instance(mut self: Lx, name: Str, targs: List[(Str, types.Ty)]) -> Str {
    let key = name + "[" + targs.map(|p| show(p.1)).join(",") + "]"
    match self.instances.get(key) {
        Some(c) => c,
        None => {
            let c = if targs.is_empty() { c_name(name) } else { "{c_name(name)}_{self.instances.len()}" }
            self.instances[key] = c
            self.queue.push(Job { cname: c, decl: self.ro.fns[name], targs })
            c
        },
    }
}

fn lift(mut self: Lx, params: List[ir.Var], ret: types.Ty, body: List[ir.Stmt]) -> Str {
    self.counter = self.counter + 1
    let name = "wf_lift{self.counter}"
    self.out.push(ir.Fn { fname: name, params, captures: [], is_closure: true, ret, body })
    name
}

// A top-level function or a variant constructor used as a value: a lifted
// function that calls it.
fn wrapper(mut self: Lx, ty: types.Ty, make: fn(List[ir.Atom]) -> ir.Rhs) -> Str {
    match ty {
        TFn(ps, r) => {
            let mut params: List[ir.Var] = []
            for t in ps {
                let v = self.fresh_var("a", t)
                params.push(v)
            }
            let res = self.fresh_var("r", r)
            let body = [Let(res, make(params.map(|v| V(v)))), Return(V(res))]
            self.lift(params, r, body)
        },
        _ => panic("wrapper"),
    }
}

// ---------- expressions ----------

fn is_map(t: types.Ty) -> Bool {
    match t {
        TMap(..) => true,
        _ => false,
    }
}

fn is_list(t: types.Ty) -> Bool {
    match t {
        TList(_) => true,
        _ => false,
    }
}

pub fn lower(mut self: Lx, e: ast.Expr) -> ir.Atom {
    if self.cur.dead {
        return AUnit
    }
    let ty = self.tyof(e)
    let sp = e.span
    match e.desc {
        EInt(n) => AInt(n),
        EFloat(x) => AFloat(x),
        EBool(b) => ABool(b),
        EUnit => AUnit,
        EStr([]) => AStr(""),
        EStr([SPLit(s)]) => AStr(s),
        EStr(parts) => {
            let mut exprs: List[ast.Expr] = []
            for p in parts {
                match p {
                    SPExpr(x) => exprs.push(x),
                    SPLit(_) => {},
                }
            }
            let mut ps: List[ir.IPart] = []
            let mut j = 0
            for p in parts {
                match p {
                    SPLit(s) => ps.push(IStr(s)),
                    SPExpr(x) => {
                        j = j + 1
                        let a = self.lower_arg(x, exprs.skip(j))
                        ps.push(IVal(a, self.tyof(x)))
                    },
                }
            }
            self.tmp(TStr, Format(ps))
        },
        EVar(n) => {
            let found = self.lookup(n)
            match found {
                Some(v) => V(v),
                None => self.global_value(e, n, ty),
            }
        },
        EList(es) => {
            let xs = self.lower_args(es)
            self.tmp(ty, MkList(ty, xs))
        },
        EBin(op, a, b) if op == And || op == Or => {
            let x = self.lower(a)
            let r = self.fresh_var("b", TBool)
            self.emit(Decl(r))
            let saved = self.open()
            let y = self.lower(b)
            self.emit(Init(r, Use(y)))
            let (rhs_branch, _) = self.close(saved)
            let const_branch = [Init(r, Use(ABool(op == Or)))]
            self.emit(if op == And { If(x, rhs_branch, const_branch) } else { If(x, const_branch, rhs_branch) })
            V(r)
        },
        EBin(Else, a, b) => {
            // `a ?? b`: the payload of Some or Ok (tag 0), else b, evaluated
            // only then
            let x = self.lower(a)
            let at = self.tyof(a)
            let r = self.fresh_var("v", ty)
            self.emit(Decl(r))
            let has = self.tmp(TBool, IsTag(x, at, 0))
            let saved = self.open()
            self.emit(Init(r, Payload(x, at, 0, 0)))
            let (some_b, _) = self.close(saved)
            let saved = self.open()
            let y = self.lower(b)
            self.emit(Init(r, Use(y)))
            let (none_b, _) = self.close(saved)
            self.emit(If(has, some_b, none_b))
            V(r)
        },
        EBin(Range, a, b) => {
            let x = self.lower_arg(a, [b])
            let y = self.lower(b)
            self.tmp(ty, Prim("int_range", TInt, [x, y], sp))
        },
        EBin(op, a, b) => {
            let x = self.lower_arg(a, [b])
            let y = self.lower(b)
            self.tmp(ty, Bin(op, self.tyof(a), x, y, sp))
        },
        EUn(Neg, a) => {
            let x = self.lower(a)
            self.tmp(ty, Negate(ty, x))
        },
        EUn(Not, a) => {
            let x = self.lower(a)
            self.tmp(TBool, Flip(x))
        },
        EUn(BitNot, a) => {
            // `~x` is `x ^ -1`, or x xor every bit of its unsigned type
            let x = self.lower(a)
            match self.tyof(a) {
                TUInt(n) => self.tmp(TUInt(n), Bin(BitXor, TUInt(n), x, AInt(if n == 64 { -1 } else { (1 << n) - 1 }), sp)),
                _ => self.tmp(TInt, Bin(BitXor, TInt, x, AInt(-1), sp)),
            }
        },
        ECall(callee, args) => self.lower_call(e, callee, args, ty),
        ENamed(..) => panic("internal: the checker puts named arguments in order"),
        EMut(_) => panic("internal: a mut argument outside a call"),
        EMethod(recv, name, _, args) => self.lower_method_expr(e, recv, name, args, ty),
        EField(recv, name, _) => {
            let is_ctor = match recv.desc {
                EVar(en) => self.is_enum_name(en),
                _ => false,
            }
            if is_ctor {
                return self.ctor_value(name, ty)
            }
            self.lower_access(e, ty)
        },
        EIndex(..) => self.lower_access(e, ty),
        ETry(x, c) => self.lower_try(x, c),
        EIf(c, b, other) => {
            let ca = self.lower(c)
            let r = self.fresh_var("if", ty)
            self.emit(Decl(r))
            let saved = self.open()
            let a = self.lower_block_inner(b)
            self.emit(Init(r, Use(a)))
            let (s1, d1) = self.close(saved)
            let saved = self.open()
            match other {
                Some(x) => {
                    let a = self.lower(x)
                    self.emit(Init(r, Use(a)))
                },
                None => self.emit(Init(r, Use(AUnit))),
            }
            let (s2, d2) = self.close(saved)
            self.emit(If(ca, s1, s2))
            if d1 && d2 {
                self.set_dead()
            }
            V(r)
        },
        EMatch(s, arms) => self.lower_match(e, s, arms, ty),
        ESelect(arms) => self.lower_select(e, arms, ty),
        EBlock(b) => self.lower_block(b),
        EClosure(ps, body) => self.lower_closure(ps, body, ty),
        EPipe(..) => panic("pipes are expanded when modules load"),
        ESafe(base, x, rest) => {
            // `a?.b`: if a is Some(v), the rest of the chain on v (wrapped in
            // Some unless it is an Option already), else None
            let flat = self.ro.nested.contains(e.id)
            let a = self.lower(base)
            let bt = self.tyof(base)
            let inner = match bt {
                TNamed("Option", [t]) => t,
                _ => TUnit,
            }
            let r = self.fresh_var("safe", ty)
            self.emit(Decl(r))
            let has = self.tmp(TBool, IsTag(a, bt, 0))
            let saved = self.open()
            let v = self.fresh_var(x, inner)
            self.emit(Let(v, Payload(a, bt, 0, 0)))
            self.bind(x, v)
            let c = self.lower(rest)
            self.emit(Init(r, if flat { Use(c) } else { MkEnum(ty, 0, [c]) }))
            let (some_b, _) = self.close(saved)
            let saved = self.open()
            self.emit(Init(r, MkEnum(ty, 1, [])))
            let (none_b, _) = self.close(saved)
            self.emit(If(has, some_b, none_b))
            V(r)
        },
        EWith(base, fields) => {
            // Take the base, then overwrite the fields in place. When the
            // base is not used afterwards it is moved, so its storage is
            // reused; otherwise the ownership pass retains it (a copy)
            // first. A plain variable is read after the new values, so
            // `p = { p with x: p.x + 1 }` still moves `p`, as the
            // specification says.
            let bt = self.tyof(base)
            let early = match base.desc {
                EVar(_) => None,
                _ => {
                    let a = self.lower(base)
                    Some(a)
                },
            }
            let xs = self.lower_args(fields.map(|f| f.value))
            let mut vals: List[(Int, ir.Atom)] = []
            for (f, a) in fields.zip(xs) {
                vals.push((field_index(self.ro, bt, f.name), a))
            }
            let b = match early {
                Some(a) => a,
                None => {
                    let a = self.lower(base)
                    a
                },
            }
            let v = self.fresh_var("with", bt)
            self.emit(Let(v, Use(b)))
            for p in vals {
                self.emit(Mutate(v, [PField(p.0)], MSet(p.1)))
            }
            V(v)
        },
        EStruct(name, _, fields) => {
            let xs = self.lower_args(fields.map(|f| f.value))
            let mut vals: List[(Str, ir.Atom)] = []
            for (f, a) in fields.zip(xs) {
                vals.push((f.name, a))
            }
            let decl = self.ro.structs[name]
            let xs = decl.fields.map(|fd| vals.find(|p| p.0 == fd.name).map(|p| p.1) ?? AUnit)
            self.tmp(ty, MkStruct(ty, xs))
        },
        EDyn(x, i) => {
            let t = self.tyof(x)
            let a = self.lower(x)
            let args = match ty {
                TDyn(_, args) => args,
                _ => [],
            }
            self.mk_dyn(t, i, args, a)
        },
        EGroup(name, interleaved, until, b) => {
            // with a deadline, each result is an Option: None for a
            // cancelled task
            let t = match (ty, until) {
                (TList(TNamed("Option", [t])), Some(_)) => t,
                (TList(t), None) => t,
                _ => TUnit,
            }
            let dl = match until {
                Some(d) => {
                    let c = self.lower(d.clock)
                    let ms = self.lower(d.ms)
                    Some((c, ms))
                },
                None => None,
            }
            let g = self.fresh_var(name, TGroup(t))
            self.emit(Let(g, GroupNew(dl, interleaved)))
            self.push_scope()
            self.bind(name, g)
            if until.is_none() {
                let _ = self.lower_block(b)
            } else {
                let saved = self.open()
                let _ = self.lower_block(b)
                let (body, _) = self.close(saved)
                self.emit(Scope(V(g), body))
            }
            self.pop_scope()
            self.tmp(ty, GroupJoin(V(g), ty, until.is_some()))
        },
    }
}

// `r.name` and `a[i]` chains read as one path.
fn lower_access(mut self: Lx, e: ast.Expr, ty: types.Ty) -> ir.Atom {
    let (root, rty, steps) = self.access(e, [])
    if steps.is_empty() {
        return root
    }
    self.tmp(ty, Get(root, rty, steps))
}

fn lower_method_expr(mut self: Lx, e: ast.Expr, recv: ast.Expr, name: Str, args: List[ast.Expr], ty: types.Ty) -> ir.Atom {
    let is_ctor = match recv.desc {
        EVar(en) => self.is_enum_name(en),
        _ => false,
    }
    let rt = self.tyof(recv)
    let one = args.len() == 1
    if is_ctor {
        let xs = self.lower_args(args)
        return self.tmp(ty, MkEnum(ty, tag_of(self.ro, ty, name), xs))
    }
    if name == "remove" && one && is_map(rt) {
        let (v, steps) = self.lower_place(recv)
        let ka = self.lower(args[0])
        self.emit(Mutate(v, steps, MRemove(ka)))
        return AUnit
    }
    if name == "push" && one && is_list(rt) {
        let (v, steps) = self.lower_place(recv)
        let x = self.lower(args[0])
        self.emit(Mutate(v, steps, MPush(x)))
        return AUnit
    }
    let on_group = match rt {
        TGroup(_) => true,
        _ => false,
    }
    if (name == "go" || name == "#go") && one && on_group {
        let g = self.lower(recv)
        let c = self.lower(args[0])
        let keep = name == "go"
        let t = match rt {
            TGroup(t) if keep => t,
            _ => TUnit,
        }
        let _ = self.tmp(TUnit, Spawn(g, c, t, keep))
        return AUnit
    }
    let chan = match rt {
        TChan(_) => true,
        _ => false,
    }
    if name == "send" && one && chan {
        let c = self.lower_arg(recv, args)
        let x = self.lower(args[0])
        let _ = self.tmp(TUnit, ChanSend(c, x, e.span))
        return AUnit
    }
    self.lower_method(e, recv, name, args, ty)
}

fn global_value(mut self: Lx, e: ast.Expr, n: Str, ty: types.Ty) -> ir.Atom {
    if self.ro.fns.contains(n) {
        let targs = self.inst_of(e)
        let c = self.instance(n, targs)
        let w = self.wrapper(ty, |args| Call(c, args))
        return self.tmp(ty, MkClosure(w, ty, []))
    }
    self.ctor_value(n, ty)
}

fn ctor_value(mut self: Lx, vname: Str, ty: types.Ty) -> ir.Atom {
    match ty {
        TFn(_, rt) => {
            let tag = tag_of(self.ro, rt, vname)
            let w = self.wrapper(ty, |args| MkEnum(rt, tag, args))
            self.tmp(ty, MkClosure(w, ty, []))
        },
        _ => self.tmp(ty, MkEnum(ty, tag_of(self.ro, ty, vname), [])),
    }
}

// A block that panics with `msg`, after which nothing runs.
fn panic_block(mut self: Lx, msg: ir.Atom, sp: ast.Span) -> List[ir.Stmt] {
    let saved = self.open()
    let _ = self.tmp(TUnit, Panic(msg, sp))
    self.set_dead()
    let (b, _) = self.close(saved)
    b
}

fn lower_call(mut self: Lx, e: ast.Expr, callee: ast.Expr, args: List[ast.Expr], ty: types.Ty) -> ir.Atom {
    let sp = e.span
    match callee.desc {
        EVar(n) => {
            let no_local = self.not_local(n)
            if no_local && !self.ro.fns.contains(n) {
                match n {
                    "assert" => {
                        let c = self.lower(args[0])
                        let fail = self.panic_block(AStr("assertion failed"), sp)
                        self.emit(If(c, [], fail))
                        return AUnit
                    },
                    "assert_eq" => {
                        let xs = self.lower_args(args)
                        let x = xs[0]
                        let y = xs[1]
                        let t = self.tyof(args[0])
                        let same = self.tmp(TBool, Bin(Eq, t, x, y, sp))
                        let saved = self.open()
                        let msg = self.tmp(TStr, Format([IStr("assertion failed: "), IValQ(x, t), IStr(" != "), IValQ(y, t)]))
                        let _ = self.tmp(TUnit, Panic(msg, sp))
                        self.set_dead()
                        let (fail, _) = self.close(saved)
                        self.emit(If(same, [], fail))
                        return AUnit
                    },
                    "channel" => {
                        let cap = self.lower(args[0])
                        return self.tmp(ty, ChanNew(ty, cap, sp))
                    },
                    "atomic" => {
                        let x = self.lower(args[0])
                        return self.tmp(ty, Prim("atomic_new", TAtomic, [x], sp))
                    },
                    "shared" => {
                        let x = self.lower(args[0])
                        return self.tmp(ty, Prim("shared_new", ty, [x], sp))
                    },
                    "catch" => {
                        let c = self.lower(args[0])
                        let inner = match self.tyof(args[0]) {
                            TFn(_, r) => r,
                            _ => TUnit,
                        }
                        return self.tmp(ty, Catch(c, inner))
                    },
                    "keep" => {
                        let x = self.lower(args[0])
                        return self.tmp(TUnit, Prim("keep", self.tyof(args[0]), [x], sp))
                    },
                    "bytes" => {
                        let xs = self.lower_args(args)
                        return self.tmp(ty, Prim("bytes_new", TBytes, xs, sp))
                    },
                    "map" => {
                        let xs = self.lower_args(args)
                        return self.tmp(ty, Prim(if xs.is_empty() { "map_new" } else { "map_from" }, ty, xs, sp))
                    },
                    "panic" => {
                        let m = self.lower(args[0])
                        let r = self.tmp(ty, Panic(m, sp))
                        self.set_dead()
                        return r
                    },
                    _ => {},
                }
            }
            if no_local {
                match self.ro.fns.get(n) {
                    Some(d) if d.foreign.is_some() => {
                        return self.lower_foreign(d, args, ty, sp)
                    },
                    Some(_) => {
                        let targs = self.inst_of(callee)
                        let c = self.instance(n, targs)
                        return self.call(c, args, ty)
                    },
                    None => {},
                }
                if self.ro.ctors.contains(n) {
                    let xs = self.lower_args(args)
                    return self.tmp(ty, MkEnum(ty, tag_of(self.ro, ty, n), xs))
                }
            }
            self.call_value(callee, args, ty)
        },
        EField(recv, v, _) => {
            let is_ctor = match recv.desc {
                EVar(en) => self.is_enum_name(en),
                _ => false,
            }
            if is_ctor {
                let xs = self.lower_args(args)
                return self.tmp(ty, MkEnum(ty, tag_of(self.ro, ty, v), xs))
            }
            self.call_value(callee, args, ty)
        },
        _ => self.call_value(callee, args, ty),
    }
}

// A call of a top-level function or a method: a plain Call, or with a
// `mut` argument a CallMut, its arguments lowered in order, each `mut`
// place to its variable and steps.
fn call(mut self: Lx, c: Str, args: List[ast.Expr], ty: types.Ty) -> ir.Atom {
    let is_mut = |a: ast.Expr| match a.desc {
        EMut(_) => true,
        _ => false,
    }
    if !args.any(is_mut) {
        let xs = self.lower_args(args)
        return self.tmp(ty, Call(c, xs))
    }
    let mut xs: List[ir.Arg] = []
    for (k, a) in args.with_index() {
        match a.desc {
            EMut(p) => {
                let x = self.mut_arg(p)
                xs.push(x)
            },
            _ => {
                let x = self.lower_arg(a, args.skip(k + 1))
                xs.push(ByValue(x))
            },
        }
    }
    self.tmp(ty, CallMut(c, xs))
}

// A `mut` place, where it is written: its indexes and keys copied, so a
// later argument cannot move it, and read up to the last of them, so a
// missing element panics there; the pointer to it is taken at the call.
fn mut_arg(mut self: Lx, p: ast.Expr) -> ir.Arg {
    let (v, steps) = self.lower_place(p)
    let mut snapped: List[ir.Step] = []
    for st in steps {
        match st {
            PIndex(V(w), sp) => {
                let t = self.tmp(w.ty, Use(V(w)))
                snapped.push(PIndex(t, sp))
            },
            PKey(V(w), sp) => {
                let t = self.tmp(w.ty, Use(V(w)))
                snapped.push(PKey(t, sp))
            },
            _ => snapped.push(st),
        }
    }
    match self.last_index(p) {
        Some((t, n)) => {
            let _ = self.tmp(t, Get(V(v), v.ty, snapped.take(n)))
        },
        None => {},
    }
    ByPlace(v, snapped)
}

// The innermost index or key of a place, and how many steps lead to it.
fn last_index(self: Lx, x: ast.Expr) -> Option[(types.Ty, Int)] {
    match x.desc {
        EField(r, _, _) => self.last_index(r),
        EIndex(..) => Some((self.tyof(x), place_depth(x))),
        _ => None,
    }
}

fn place_depth(x: ast.Expr) -> Int {
    match x.desc {
        EField(r, _, _) | EIndex(r, _) => 1 + place_depth(r),
        _ => 0,
    }
}

// Sibling expressions whose values are used together (the arguments of a
// call, the operands of an operator, the parts of a literal or of a string
// with interpolations, a receiver and its arguments), left to right. A
// variable that a later sibling changes is copied where it is written, so
// it is used with the value it had there; any other is read in place.
fn lower_args(mut self: Lx, args: List[ast.Expr]) -> List[ir.Atom] {
    let mut xs: List[ir.Atom] = []
    for (k, a) in args.with_index() {
        let x = self.lower_arg(a, args.skip(k + 1))
        xs.push(x)
    }
    xs
}

fn lower_arg(mut self: Lx, a: ast.Expr, rest: List[ast.Expr]) -> ir.Atom {
    let x = self.lower(a)
    match (a.desc, x) {
        (EVar(n), V(v)) if rest.any(|r| self.changes(n, r)) => self.tmp(v.ty, Use(x)),
        _ => x,
    }
}

fn root_of(e: ast.Expr) -> Option[Str] {
    match e.desc {
        EVar(n) => Some(n),
        EField(a, _, _) | EIndex(a, _) | EMut(a) => root_of(a),
        _ => None,
    }
}

// Does `e` change variable `n` outside closures: assign a place in it,
// pass one as `mut`, or push to or remove from it?
fn changes(self: Lx, n: Str, e: ast.Expr) -> Bool {
    let here = match e.desc {
        EClosure(..) => {
            return false
        },
        EMut(p) => root_of(p) == Some(n),
        EMethod(r, m, _, _) => root_of(r) == Some(n) && match (m, self.tyof(r)) {
            ("push", TList(_)) | ("remove", TMap(..)) => true,
            _ => false,
        },
        EBlock(b) | EIf(_, b, _) | EGroup(_, _, _, b) => assigns(n, b),
        _ => false,
    }
    here || walk.below(e).any(|k| self.changes(n, k))
}

// Does a statement of `b`, or of a block it holds, assign a place in `n`?
fn assigns(n: Str, b: ast.Block) -> Bool {
    b.stmts.any(|s| match s.desc {
        SAssign(a, _) => root_of(a) == Some(n),
        SWhile(_, body) | SFor(_, _, _, body) | SForPat(_, _, body) | SDefer(body) => assigns(n, body),
        _ => false,
    })
}

// A call of a closure value.
fn call_value(mut self: Lx, callee: ast.Expr, args: List[ast.Expr], ty: types.Ty) -> ir.Atom {
    let c = self.lower(callee)
    let xs = self.lower_args(args)
    self.tmp(ty, CallClo(c, xs))
}

// A call of a foreign C function. A callback is a top-level function (the
// checker made sure): C calls its compiled code through a wrapper, so it
// is not lowered as a value.
fn lower_foreign(mut self: Lx, d: ast.FnDecl, args: List[ast.Expr], ty: types.Ty, sp: ast.Span) -> ir.Atom {
    let cs = match ffi.of_decl(d, self.ro.structs) {
        Ok(cs) => cs,
        Err(_) => panic("lower: foreign signature"),
    }
    let kinds = (if cs.trusted { [] } else { [Unit] }) + cs.params.filter(|p| !p.out).map(|p| p.cty)
    let mut xs: List[ir.Atom] = []
    let mut cbs: List[ir.Callback] = []
    let mut j = 0
    for (a, k) in args.zip(kinds) {
        j = j + 1
        match (k, a.desc) {
            (Fn(ps, _), EVar(m)) => {
                let cd = self.ro.fns[m]
                let c = self.instance(m, [])
                cbs.push(ir.Callback { cname: c, name: m, span: cd.span, takes_foreign: cd.params.len() > ps.len() })
            },
            _ => {
                let x = self.lower_arg(a, args.skip(j))
                xs.push(x)
            },
        }
    }
    self.tmp(ty, CallC(cs, xs, cbs, sp))
}

// A chain of field and index reads, so `a[i].x` is one Get, not two
// copies: the value at its root, the root's type, and the steps. `later`
// are the indexes after `e` in the chain: a variable they change is copied
// where it is read, as for siblings.
fn access(mut self: Lx, e: ast.Expr, later: List[ast.Expr]) -> (ir.Atom, types.Ty, List[ir.Step]) {
    match e.desc {
        EField(r, name, _) if is_struct(self.ro, self.tyof(r)) => {
            let (a, rt, steps) = self.access(r, later)
            (a, rt, steps + [PField(field_index(self.ro, self.tyof(r), name))])
        },
        EIndex(r, i) if self.tyof(r) == TBytes => {
            let b = self.lower_arg(r, [i] + later)
            let ia = self.lower_arg(i, later)
            let x = self.tmp(TInt, Prim("bytes_at", TBytes, [b, ia], e.span))
            (x, TInt, [])
        },
        EIndex(r, k) if is_map(self.tyof(r)) => {
            // a map lookup starts a new path: the value it finds
            let m = self.lower_arg(r, [k] + later)
            let ka = self.lower_arg(k, later)
            let vt = self.tyof(e)
            let x = self.tmp(vt, Prim("map_at", self.tyof(r), [m, ka], e.span))
            (x, vt, [])
        },
        EIndex(r, i) => {
            let (a, rt, steps) = self.access(r, [i] + later)
            let ia = self.lower_arg(i, later)
            (a, rt, steps + [PIndex(ia, e.span)])
        },
        EField(r, name, _) if self.tyof(r) == TCap("Root") => {
            let a = self.lower(r)
            let x = self.tmp(self.tyof(e), RootField(a, name))
            (x, self.tyof(e), [])
        },
        _ => {
            let a = self.lower_arg(e, later)
            (a, self.tyof(e), [])
        },
    }
}

// The variable at the root of an assignable path, and the steps to the
// place.
fn lower_place(mut self: Lx, e: ast.Expr) -> (ir.Var, List[ir.Step]) {
    match e.desc {
        EVar(n) => match self.lookup(n) {
            Some(v) => (v, []),
            None => panic("place " + n),
        },
        EField(r, name, _) => {
            let (v, s) = self.lower_place(r)
            (v, s + [PField(field_index(self.ro, self.tyof(r), name))])
        },
        EIndex(r, k) if is_map(self.tyof(r)) => {
            // `m[k].x = v`: the entry, changed in place
            let (v, s) = self.lower_place(r)
            let ka = self.lower(k)
            (v, s + [PKey(ka, e.span)])
        },
        EIndex(r, i) => {
            let (v, s) = self.lower_place(r)
            let ia = self.lower(i)
            (v, s + [PIndex(ia, e.span)])
        },
        _ => panic("place"),
    }
}

// Box `a` of type `t` as `dyn i`: a vtable of t's methods.
fn mk_dyn(mut self: Lx, t: types.Ty, i: Str, args: List[types.Ty], a: ir.Atom) -> ir.Atom {
    let mut entries: List[ir.DynEntry] = []
    for m in iface_methods(self.ro, i, args) {
        let f = self.method_fn(t, m.name, m.params)
        entries.push(ir.DynEntry { fname: f, params: m.params, ret: m.ret })
    }
    // the vtable is per interface and arguments
    let key = if args.is_empty() { i } else { show(TDyn(i, args)) }
    self.tmp(TDyn(i, args), MkDyn(t, key, a, entries))
}

// The function that is method `m` of type `t`, receiver first.
fn method_fn(mut self: Lx, t: types.Ty, m: Str, ps: List[types.Ty]) -> Str {
    let key = match t {
        TNamed(n, _) if self.ro.fns.contains(n + "::" + m) => n + "::" + m,
        TStr if m == "message" => "$Str::message",
        TNamed("IoError", _) if m == "message" => "$IoError::message",
        // `cause` is optional in `Error`
        _ if m == "cause" => "$no_cause",
        _ => panic("no method " + m),
    }
    let d = self.ro.fns[key]
    self.instance(key, derive_targs(d, [t] + ps))
}

fn lower_try(mut self: Lx, x: ast.Expr, context: Option[ast.Expr]) -> ir.Atom {
    let a = self.lower(x)
    let xt = self.tyof(x)
    let ok_ty = match xt {
        TNamed("Result", [t, _]) | TNamed("Option", [t]) => t,
        _ => panic("try"),
    }
    let ok = self.tmp(TBool, IsTag(a, xt, 0))
    let saved = self.open()
    let r = self.try_fail(a, xt, context)
    self.run_defers(self.cur.defers)
    self.emit(Return(r))
    self.set_dead()
    let (fail_block, _) = self.close(saved)
    self.emit(If(ok, [], fail_block))
    self.tmp(ok_ty, Payload(a, xt, 0, 0))
}

// What `x?` returns when `a`, of type `xt`, is an Err or None.
fn try_fail(mut self: Lx, a: ir.Atom, xt: types.Ty, context: Option[ast.Expr]) -> ir.Atom {
    let ret = self.cur.ret
    match (xt, context) {
        (TNamed("Result", [_, et]), _) => {
            let ev = self.tmp(et, Payload(a, xt, 1, 0))
            let err = self.to_ret_err(ev, et, context)
            self.tmp(ret, MkEnum(ret, 1, [err]))
        },
        // `opt? "context"`: the context is the error
        (TNamed("Option", _), Some(c)) => {
            let ca = self.lower(c)
            let err = self.mk_dyn(TStr, "Error", [], ca)
            self.tmp(ret, MkEnum(ret, 1, [err]))
        },
        _ => self.tmp(ret, MkEnum(ret, 1, [])),
    }
}

// The error the function returns: converted to `dyn Error` if it returns
// one, and wrapped with the context if there is one.
fn to_ret_err(mut self: Lx, ev: ir.Atom, et: types.Ty, context: Option[ast.Expr]) -> ir.Atom {
    let dyn_error = TDyn("Error", [])
    let returns_dyn = match self.cur.ret {
        TNamed("Result", [_, e]) => e == dyn_error,
        _ => false,
    }
    let ev = if returns_dyn && et != dyn_error { self.mk_dyn(et, "Error", [], ev) } else { ev }
    match context {
        None => ev,
        Some(c) => {
            let ca = self.lower(c)
            let wt = TNamed("WrappedError", [])
            let s = self.tmp(wt, MkStruct(wt, [ca, ev]))
            self.mk_dyn(wt, "Error", [], s)
        },
    }
}

fn no_arm_matched(mut self: Lx, sp: ast.Span) {
    let _ = self.tmp(TUnit, Panic(AStr("no `match` arm matched"), sp))
    self.set_dead()
}

fn lower_match(mut self: Lx, e: ast.Expr, s: ast.Expr, arms: List[ast.Arm], ty: types.Ty) -> ir.Atom {
    let sa = self.lower(s)
    let st = self.tyof(s)
    let r = self.fresh_var("m", ty)
    self.emit(Decl(r))
    if arms.all(|a| a.guard.is_none()) {
        self.match_chain(e, sa, st, r, arms)
        return V(r)
    }
    // With guards, first find the arm: `k` is the index of the first arm
    // whose pattern matches and whose guard holds (-1 for none), trying
    // each arm only while none has been found. Then run that arm's body.
    // Each arm's bindings are made again for its body; this keeps the code
    // linear in the number of arms.
    let k = self.fresh_var("arm", TInt)
    self.emit(Let(k, Use(AInt(-1))))
    for (i, arm) in arms.with_index() {
        if i == 0 {
            self.try_arm(sa, st, k, i, arm)
        } else {
            let pending = self.tmp(TBool, Bin(Eq, TInt, V(k), AInt(-1), e.span))
            let saved = self.open()
            self.try_arm(sa, st, k, i, arm)
            let (b, _) = self.close(saved)
            self.emit(If(pending, b, []))
        }
    }
    self.dispatch(e, sa, st, r, k, 0, arms)
    V(r)
}

// The arms without guards, each tried in turn.
fn match_chain(mut self: Lx, e: ast.Expr, sa: ir.Atom, st: types.Ty, r: ir.Var, arms: List[ast.Arm]) {
    match arms {
        [] => self.no_arm_matched(e.span),
        [arm, ..rest] => {
            if exhaust.irrefutable(arm.pat) {
                let saved = self.open()
                self.arm_body(sa, st, r, arm)
                let (b, d) = self.close(saved)
                self.emit_all(b)
                if d {
                    self.set_dead()
                }
                return
            }
            let t = self.tmp(TBool, PatTest(sa, st, arm.pat))
            let saved = self.open()
            self.arm_body(sa, st, r, arm)
            let (b1, d1) = self.close(saved)
            let saved = self.open()
            self.match_chain(e, sa, st, r, rest)
            let (b2, d2) = self.close(saved)
            self.emit(If(t, b1, b2))
            if d1 && d2 {
                self.set_dead()
            }
        },
    }
}

fn arm_body(mut self: Lx, sa: ir.Atom, st: types.Ty, r: ir.Var, arm: ast.Arm) {
    self.bind_pat(sa, st, arm.pat)
    let a = self.lower(arm.body)
    self.emit(Init(r, Use(a)))
}

// Set `k` to `i` if arm `i` applies.
fn try_arm(mut self: Lx, sa: ir.Atom, st: types.Ty, k: ir.Var, i: Int, arm: ast.Arm) {
    let saved = self.open()
    match arm.guard {
        None => self.emit(Set(k, Use(AInt(i)), false)),
        Some(g) => {
            self.bind_pat(sa, st, arm.pat)
            let ga = self.lower(g)
            let saved = self.open()
            self.emit(Set(k, Use(AInt(i)), false))
            let (yes, _) = self.close(saved)
            self.emit(If(ga, yes, []))
        },
    }
    let (b, _) = self.close(saved)
    if exhaust.irrefutable(arm.pat) {
        self.emit_all(b)
        return
    }
    let t = self.tmp(TBool, PatTest(sa, st, arm.pat))
    self.emit(If(t, b, []))
}

// Run the body of arm `k`.
fn dispatch(mut self: Lx, e: ast.Expr, sa: ir.Atom, st: types.Ty, r: ir.Var, k: ir.Var, i: Int, arms: List[ast.Arm]) {
    match arms {
        [] => self.no_arm_matched(e.span),
        [arm, ..rest] => {
            let t = self.tmp(TBool, Bin(Eq, TInt, V(k), AInt(i), e.span))
            let saved = self.open()
            self.arm_body(sa, st, r, arm)
            let (b1, d1) = self.close(saved)
            let saved = self.open()
            self.dispatch(e, sa, st, r, k, i + 1, rest)
            let (b2, d2) = self.close(saved)
            self.emit(If(t, b1, b2))
            if d1 && d2 {
                self.set_dead()
            }
        },
    }
}

fn chan_elem(t: types.Ty) -> types.Ty {
    match t {
        TChan(x) => x,
        _ => TUnit,
    }
}

fn lower_select(mut self: Lx, e: ast.Expr, arms: List[ast.SelArm], ty: types.Ty) -> ir.Atom {
    self.counter = self.counter + 1
    let id = self.counter
    // channels and send values first, in order
    let mut ops: List[ir.Sel] = []
    for a in arms {
        let on = match a.guard {
            Some(g) => {
                let x = self.lower(g)
                x
            },
            None => ABool(true),
        }
        match a.op {
            SelRecv(_, ch) => {
                let el = chan_elem(self.tyof(ch))
                let c = self.lower(ch)
                ops.push(SRecv(c, el, on))
            },
            SelSend(ch, v) => {
                let el = chan_elem(self.tyof(ch))
                let c = self.lower(ch)
                let x = self.lower(v)
                ops.push(SSend(c, x, el, on))
            },
            SelAfter(clk, ms) => {
                let c = self.lower(clk)
                let m = self.lower(ms)
                ops.push(SAfter(c, m, on))
            },
            SelDefault => {},
        }
    }
    let has_default = arms.any(|a| is_default(a.op))
    let k = self.tmp(TInt, Select(id, ops, has_default, e.span))
    let r = self.fresh_var("s", ty)
    self.emit(Decl(r))
    // number the channel arms; `_` is -1
    let mut n = 0
    let mut numbered: List[(Int, ast.SelArm)] = []
    for a in arms {
        if is_default(a.op) {
            numbered.push((-1, a))
        } else {
            numbered.push((n, a))
            n = n + 1
        }
    }
    self.select_chain(e, id, k, r, numbered)
    V(r)
}

fn is_default(op: ast.SelOp) -> Bool {
    match op {
        SelDefault => true,
        _ => false,
    }
}

fn select_chain(mut self: Lx, e: ast.Expr, id: Int, k: ir.Atom, r: ir.Var, arms: List[(Int, ast.SelArm)]) {
    match arms {
        [] => {},
        [(i, a)] => {
            let saved = self.open()
            self.select_body(id, i, r, a)
            let (b, d) = self.close(saved)
            self.emit_all(b)
            if d {
                self.set_dead()
            }
        },
        [(i, a), ..rest] => {
            let t = self.tmp(TBool, Bin(Eq, TInt, k, AInt(i), e.span))
            let saved = self.open()
            self.select_body(id, i, r, a)
            let (b1, d1) = self.close(saved)
            let saved = self.open()
            self.select_chain(e, id, k, r, rest)
            let (b2, d2) = self.close(saved)
            self.emit(If(t, b1, b2))
            if d1 && d2 {
                self.set_dead()
            }
        },
    }
}

fn select_body(mut self: Lx, id: Int, i: Int, r: ir.Var, a: ast.SelArm) {
    match a.op {
        SelRecv(b, ch) => {
            // always take the value out, so an unnamed one is released
            let ot = types.opt(chan_elem(self.tyof(ch)))
            let v = self.fresh_var(b.map(|n| n.text) ?? "got", ot)
            self.emit(Let(v, SelGot(id, i, ot)))
            match b {
                Some(n) => self.bind(n.text, v),
                None => {},
            }
        },
        _ => {},
    }
    let x = self.lower(a.body)
    self.emit(Init(r, Use(x)))
}

fn has_bind(p: ast.Pat) -> Bool {
    !free.pat_binds(p, []).is_empty()
}

// Bind the names in `p`, which matches `a` of type `t`.
fn bind_pat(mut self: Lx, a: ir.Atom, t: types.Ty, p: ast.Pat) {
    match p.desc {
        PBind(n) => {
            let v = self.fresh_var(n, t)
            self.emit(Let(v, Use(a)))
            self.bind(n, v)
        },
        PVariant(_, vn, args) => {
            let tag = tag_of(self.ro, t, vn)
            let ptys = variants(self.ro, t).find(|v| v.0 == vn).map(|v| v.1) ?? []
            for (i, pair) in exhaust.fill_rest(args, ptys.len()).zip(ptys).with_index() {
                let (sub, pt) = pair
                if has_bind(sub) {
                    let pv = self.tmp(pt, Payload(a, t, tag, i))
                    self.bind_pat(pv, pt, sub)
                }
            }
        },
        PTuple(ps) => {
            let fts = field_types(self.ro, t)
            for (i, pair) in exhaust.fill_rest(ps, fts.len()).zip(fts).with_index() {
                let (sub, ft) = pair
                if has_bind(sub) {
                    let pv = self.tmp(ft.1, Get(a, t, [PField(i)]))
                    self.bind_pat(pv, ft.1, sub)
                }
            }
        },
        PStruct(_, _, fields, _) => {
            let fts = field_types(self.ro, t)
            for (i, pair) in exhaust.struct_items(fields, fts.map(|f| f.0), p.span).zip(fts).with_index() {
                let (sub, ft) = pair
                if has_bind(sub) {
                    let pv = self.tmp(ft.1, Get(a, t, [PField(i)]))
                    self.bind_pat(pv, ft.1, sub)
                }
            }
        },
        PAs(q, n, _) => {
            let v = self.fresh_var(n, t)
            self.emit(Let(v, Use(a)))
            self.bind(n, v)
            self.bind_pat(a, t, q)
        },
        PList(ps) if has_bind(p) => self.bind_list(a, t, p, ps),
        POr(alts) if has_bind(p) => self.bind_or(a, t, p, alts),
        _ => {},
    }
}

fn bind_list(mut self: Lx, a: ir.Atom, t: types.Ty, p: ast.Pat, ps: List[ast.Pat]) {
    let el = match t {
        TList(el) => el,
        _ => panic("bind_pat: list"),
    }
    let (before, rest, after) = exhaust.list_parts(ps)
    for (i, sub) in before.with_index() {
        self.bind_item(a, t, el, AInt(i), sub)
    }
    if rest.is_none() && after.is_empty() {
        return
    }
    let n = self.tmp(TInt, Prim("list_len", t, [a], p.span))
    let j = after.len()
    for (i, sub) in after.with_index() {
        if has_bind(sub) {
            let at = self.tmp(TInt, Bin(Sub, TInt, n, AInt(j - i), p.span))
            self.bind_item(a, t, el, at, sub)
        }
    }
    match rest {
        Some(Some(name)) => {
            let hi = self.tmp(TInt, Bin(Sub, TInt, n, AInt(j), p.span))
            let v = self.fresh_var(name, t)
            self.emit(Let(v, Prim("list_slice", t, [a, AInt(before.len()), hi], p.span)))
            self.bind(name, v)
        },
        _ => {},
    }
}

fn bind_item(mut self: Lx, a: ir.Atom, t: types.Ty, el: types.Ty, i: ir.Atom, sub: ast.Pat) {
    if !has_bind(sub) {
        return
    }
    let x = self.tmp(el, Get(a, t, [PIndexU(i)]))
    self.bind_pat(x, el, sub)
}

// The names come from whichever alternative matched: each gets a variable
// declared here, set in the branch for that alternative.
fn bind_or(mut self: Lx, a: ir.Atom, t: types.Ty, p: ast.Pat, alts: List[ast.Pat]) {
    let names = free.pat_binds(p, []).sort().distinct()
    let mut outs: Map[Str, ir.Var] = map()
    let mut branches: List[(ast.Pat, List[ir.Stmt])] = []
    for alt in alts {
        let saved = self.open()
        self.bind_pat(a, t, alt)
        for n in names {
            let v = self.cur.scopes[0][n]
            let o = match outs.get(n) {
                Some(o) => o,
                None => {
                    let o = self.fresh_var(n, v.ty)
                    outs[n] = o
                    o
                },
            }
            self.emit(Init(o, Use(V(v))))
        }
        let (b, _) = self.close(saved)
        branches.push((alt, b))
    }
    for n in names {
        self.emit(Decl(outs[n]))
    }
    self.or_chain(a, t, branches)
    for n in names {
        self.bind(n, outs[n])
    }
}

fn or_chain(mut self: Lx, a: ir.Atom, t: types.Ty, branches: List[(ast.Pat, List[ir.Stmt])]) {
    match branches {
        [] => {},
        [(_, b)] => self.emit_all(b),
        [(alt, b), ..rest] => {
            let c = self.tmp(TBool, PatTest(a, t, alt))
            let saved = self.open()
            self.or_chain(a, t, rest)
            let (other, _) = self.close(saved)
            self.emit(If(c, b, other))
        },
    }
}

// The type arguments of generic function `d` called with arguments of the
// given concrete types.
fn derive_targs(d: ast.FnDecl, act: List[types.Ty]) -> List[(Str, types.Ty)] {
    let genv = d.generics.map(|g| (g, TParam(g)))
    let decl = d.params.map(|p| resolve(genv, p.ty))
    let found = if decl.len() == act.len() { match_all(decl, act, []) } else { [] }
    d.generics.map(|g| (g, found.find(|p| p.0 == g).map(|p| p.1) ?? TUnit))
}

// Read the type parameters of `decl` off `act`; the first binding of each
// wins.
fn match_targs(decl: types.Ty, act: types.Ty, found: List[(Str, types.Ty)]) -> List[(Str, types.Ty)] {
    match (decl, act) {
        (TParam(g), t) => if found.any(|p| p.0 == g) { found } else { [(g, t)] + found },
        (TList(a), TList(b)) | (TChan(a), TChan(b)) | (TShared(a), TShared(b)) => match_targs(a, b, found),
        (TArray(a, n), TArray(b, k)) => match_targs(n, k, match_targs(a, b, found)),
        (TNamed(_, xs), TNamed(_, ys)) if xs.len() == ys.len() => match_all(xs, ys, found),
        (TFn(xs, r1), TFn(ys, r2)) if xs.len() == ys.len() => match_targs(r1, r2, match_all(xs, ys, found)),
        _ => found,
    }
}

fn match_all(xs: List[types.Ty], ys: List[types.Ty], found: List[(Str, types.Ty)]) -> List[(Str, types.Ty)] {
    xs.zip(ys).fold(found, |acc, p| match_targs(p.0, p.1, acc))
}

fn lower_method(mut self: Lx, e: ast.Expr, recv: ast.Expr, name: Str, args: List[ast.Expr], ty: types.Ty) -> ir.Atom {
    let rt = self.tyof(recv)
    match rt {
        TDyn(i, targs) => {
            // through the vtable
            let ms = iface_methods(self.ro, i, targs)
            let k = index_of(name, ms.map(|m| m.name))
            let m = ms[k]
            let xs = self.lower_args([recv] + args)
            return self.tmp(ty, CallDyn(k, m.params, m.ret, xs[0], xs.skip(1)))
        },
        _ => {},
    }
    let error_type = match rt {
        TStr => true,
        TNamed("IoError", _) => true,
        _ => false,
    }
    let no_cause = match rt {
        TStr => true,
        TNamed(n, _) => !self.ro.fns.contains(n + "::cause"),
        _ => false,
    }
    if (error_type && name == "message") || (no_cause && name == "cause" && args.is_empty()) {
        // `message` of Str and IoError, and `cause` reached through an
        // `Error` bound on a type without one
        let c = self.method_fn(rt, name, [])
        let x = self.lower(recv)
        return self.tmp(ty, Call(c, [x]))
    }
    match rt {
        TNamed(n, _) if self.ro.fns.contains(n + "::" + name) => {
            // a method on a user type: a call with the receiver first
            let key = n + "::" + name
            let d = self.ro.fns[key]
            let env = self.inst_of(e)
            // reached through an interface bound, the checker only knew a
            // type parameter: read the instantiation off the actual types
            let targs = if d.generics.all(|g| env.any(|p| p.0 == g)) { env } else { derive_targs(d, ([recv] + args).map(|x| self.tyof(x))) }
            let c = self.instance(key, targs)
            return self.call(c, [recv] + args, ty)
        },
        _ => {},
    }
    let sp = e.span
    match (rt, name, args) {
        (TNamed("Option", _), "is_some", []) | (TNamed("Result", _), "is_ok", []) => {
            let x = self.lower(recv)
            self.tmp(TBool, IsTag(x, rt, 0))
        },
        (TNamed("Option", _), "is_none", []) | (TNamed("Result", _), "is_err", []) => {
            let x = self.lower(recv)
            self.tmp(TBool, IsTag(x, rt, 1))
        },
        (TNamed("Option", [xt]), "map", [f]) => {
            let ra = self.lower_arg(recv, [f])
            let ca = self.lower(f)
            let c = self.tmp(TBool, IsTag(ra, rt, 0))
            let r = self.fresh_var("u", ty)
            self.emit(Decl(r))
            let ut = match ty {
                TNamed(_, [u]) => u,
                _ => TUnit,
            }
            let saved = self.open()
            let p = self.tmp(xt, Payload(ra, rt, 0, 0))
            let y = self.tmp(ut, CallClo(ca, [p]))
            self.emit(Init(r, MkEnum(ty, 0, [y])))
            let (s1, _) = self.close(saved)
            let saved = self.open()
            self.emit(Init(r, MkEnum(ty, 1, [])))
            let (s2, _) = self.close(saved)
            self.emit(If(c, s1, s2))
            V(r)
        },
        (TNamed("Result", [at, et]), "map_error", [f]) => {
            let ra = self.lower_arg(recv, [f])
            let ca = self.lower(f)
            let c = self.tmp(TBool, IsTag(ra, rt, 1))
            let r = self.fresh_var("u", ty)
            self.emit(Decl(r))
            let ut = match ty {
                TNamed(_, [_, u]) => u,
                _ => TUnit,
            }
            let saved = self.open()
            let p = self.tmp(et, Payload(ra, rt, 1, 0))
            let y = self.tmp(ut, CallClo(ca, [p]))
            self.emit(Init(r, MkEnum(ty, 1, [y])))
            let (s1, _) = self.close(saved)
            let saved = self.open()
            let p = self.tmp(at, Payload(ra, rt, 0, 0))
            self.emit(Init(r, MkEnum(ty, 0, [p])))
            let (s2, _) = self.close(saved)
            self.emit(If(c, s1, s2))
            V(r)
        },
        (TList(_), "map", _) | (TList(_), "filter", _) | (TList(_), "fold", _) => self.lower_fused(recv, name, args, ty, sp),
        _ => {
            let xs = self.lower_args([recv] + args)
            let prefix = match rt {
                TStr => "str_",
                TBytes => "bytes_",
                TUInt(_) => "uint_",
                TInt => "int_",
                TFloat => "float_",
                TBool => "bool_",
                TList(_) => "list_",
                TMap(..) => "map_",
                TArray(..) => "array_",
                TChan(_) => "chan_",
                TAtomic => "atomic_",
                TShared(_) => "shared_",
                TCap(_) => "cap_",
                _ => panic("method on " + show(rt)),
            }
            self.tmp(ty, Prim(prefix + name, rt, xs, sp))
        },
    }
}

fn elem(t: types.Ty) -> types.Ty {
    match t {
        TList(x) => x,
        _ => TUnit,
    }
}

// Fuse a chain like xs.filter(p).map(g).fold(z, h) into one loop. Only
// pure closure literals are fused into earlier stages: they capture no
// capability and no function, so running them interleaved instead of
// stage by stage cannot be observed (except which panic comes first).
fn lower_fused(mut self: Lx, recv: ast.Expr, name: Str, args: List[ast.Expr], ty: types.Ty, sp: ast.Span) -> ir.Atom {
    let (src_e, stages) = self.stages_of(recv)
    let src = self.lower_arg(src_e, args)
    let mut prepared: List[(Str, Prep, types.Ty)] = []
    for s in stages {
        let p = self.prepare(s.1)
        prepared.push((s.0, p, s.2))
    }
    let src_ty = self.tyof(src_e)
    match (name, args) {
        ("fold", [init, f]) => {
            let ia = self.lower(init)
            let p = self.prepare(f)
            let acc = self.fresh_var("acc", ty)
            self.emit(Let(acc, Use(ia)))
            let (x, saved) = self.for_start(src, src_ty, sp)
            self.run_stages(V(x), elem(src_ty), prepared, FoldInto(acc, p), ty)
            self.for_end(saved)
            V(acc)
        },
        (_, [f]) => {
            let p = self.prepare(f)
            let out = self.fresh_var("out", ty)
            self.emit(Let(out, MkList(ty, [])))
            let (x, saved) = self.for_start(src, src_ty, sp)
            let terminal = if name == "map" { MapInto(out, p) } else { FilterInto(out, p) }
            self.run_stages(V(x), elem(src_ty), prepared, terminal, ty)
            self.for_end(saved)
            V(out)
        },
        _ => panic("list method arity"),
    }
}

// The stages, then what the loop does with the item.
fn run_stages(mut self: Lx, v: ir.Atom, vty: types.Ty, stages: List[(Str, Prep, types.Ty)], terminal: Terminal, ty: types.Ty) {
    match stages {
        [] => match terminal {
            FoldInto(acc, p) => {
                let r = self.apply(p, [V(acc), v], ty)
                self.emit(Set(acc, Use(r), false))
            },
            MapInto(out, p) => {
                let y = self.apply(p, [v], elem(ty))
                self.emit(Mutate(out, [], MPush(y)))
            },
            FilterInto(out, p) => {
                let keep = self.apply(p, [v], TBool)
                let saved = self.open()
                self.emit(Mutate(out, [], MPush(v)))
                let (push, _) = self.close(saved)
                self.emit(If(keep, push, []))
            },
        },
        [("map", p, t), ..rest] => {
            let y = self.apply(p, [v], elem(t))
            self.run_stages(y, elem(t), rest, terminal, ty)
        },
        [(_, p, _), ..rest] => {
            let keep = self.apply(p, [v], TBool)
            let saved = self.open()
            self.run_stages(v, vty, rest, terminal, ty)
            let (blk, _) = self.close(saved)
            self.emit(If(keep, blk, []))
        },
    }
}

// Split `src.filter(a).map(b)` into the source and its fusable stages.
fn stages_of(mut self: Lx, e: ast.Expr) -> (ast.Expr, List[(Str, ast.Expr, types.Ty)]) {
    match e.desc {
        EMethod(r, k, _, [f]) if (k == "map" || k == "filter") && is_list(self.tyof(r)) => {
            let pure = self.pure_closure(f)
            if !pure {
                return (e, [])
            }
            let (src, st) = self.stages_of(r)
            (src, st + [(k, f, self.tyof(e))])
        },
        _ => (e, []),
    }
}

// A closure literal is inlined where it is applied (no closure object, no
// indirect call) unless its body can return early from itself.
fn prepare(mut self: Lx, f: ast.Expr) -> Prep {
    match f.desc {
        EClosure(ps, body) if !free.has_escape(body) => Inline(ps.map(|p| p.name), body),
        _ => {
            let a = self.lower(f)
            Value(a)
        },
    }
}

fn apply(mut self: Lx, prep: Prep, args: List[ir.Atom], ret_ty: types.Ty) -> ir.Atom {
    match prep {
        Value(c) => self.tmp(ret_ty, CallClo(c, args)),
        Inline(ps, body) => {
            self.push_scope()
            for (n, a) in ps.zip(args) {
                let v = self.fresh_var(n, ir.atom_ty(a))
                self.emit(Let(v, Use(a)))
                self.bind(n, v)
            }
            let r = self.lower(body)
            self.pop_scope()
            r
        },
    }
}

// Pure: a closure literal whose free variables hold no capability and no
// function value. It can then only compute, which is what fusion needs.
fn pure_closure(mut self: Lx, f: ast.Expr) -> Bool {
    match f.desc {
        EClosure(ps, body) if !free.has_escape(body) => {
            let s = self.ro.subst
            for n in free.expr(ps.map(|p| p.name), body) {
                let found = self.lookup(n)
                match found {
                    Some(v) => {
                        if !s.caps_in(v.ty, []).is_empty() || (s.has_fn(v.ty) && !self.pure_fn_var(0, v)) || s.has_chan(v.ty) {
                            return false
                        }
                    },
                    // a top-level function or constructor
                    None => {},
                }
            }
            true
        },
        _ => false,
    }
}

// `pure_closure` without capturing anything.
fn pure_closure_peek(self: Lx, f: ast.Expr) -> Bool {
    match f.desc {
        EClosure(ps, body) if !free.has_escape(body) => {
            let s = self.ro.subst
            free.expr(ps.map(|p| p.name), body).all(|n| match self.peek(n) {
                Some(v) => s.caps_in(v.ty, []).is_empty() && (!s.has_fn(v.ty) || self.pure_fns.contains(v.id)) && !s.has_chan(v.ty),
                // a top-level function or constructor
                None => true,
            })
        },
        _ => false,
    }
}

// for x in list: iterate over a snapshot of the list by index. This
// starts the loop, up to the item `x`; the caller lowers the body, then
// for_end closes it.
fn for_start(mut self: Lx, la: ir.Atom, lty: types.Ty, sp: ast.Span) -> (ir.Var, Saved) {
    let elt = match lty {
        TList(t) | TArray(t, _) => t,
        _ => TUnit,
    }
    let it = self.fresh_var("it", lty)
    self.emit(Let(it, Use(la)))
    let i = self.fresh_var("i", TInt)
    self.emit(Let(i, Use(AInt(0))))
    let saved = self.open()
    let n = self.tmp(TInt, Prim("list_len", lty, [V(it)], sp))
    let c = self.tmp(TBool, Bin(Ge, TInt, V(i), n, sp))
    let brk = self.break_block()
    self.emit(If(c, brk, []))
    let x = self.fresh_var("x", elt)
    // i < len was checked just above, on a snapshot nothing else can change
    self.emit(Let(x, Get(V(it), lty, [PIndexU(V(i))])))
    self.emit(Set(i, Bin(Add, TInt, V(i), AInt(1), sp), false))
    (x, saved)
}

fn for_end(mut self: Lx, saved: Saved) {
    let (stmts, _) = self.close(saved)
    self.emit(Loop(stmts))
}

fn lower_closure(mut self: Lx, ps: List[ast.ClosureParam], body: ast.Expr, ty: types.Ty) -> ir.Atom {
    let (pts, rt) = match ty {
        TFn(a, b) => (a, b),
        _ => panic("closure type"),
    }
    let cf = new_frame(self.cur.genv, rt)
    self.parents = [self.cur] + self.parents
    self.cur = cf
    let mut params: List[ir.Var] = []
    for (p, t) in ps.zip(pts) {
        let v = self.fresh_var(p.name, t)
        self.bind(p.name, v)
        params.push(v)
    }
    let a = self.lower(body)
    self.emit(Return(a))
    self.counter = self.counter + 1
    let name = "wf_clo{self.counter}"
    let caps = self.cur.caps
    let fbody = self.cur.buf
    self.cur = self.parents[0]
    self.parents = self.parents.skip(1)
    self.out.push(ir.Fn { fname: name, params, captures: caps.map(|c| c.1), is_closure: true, ret: rt, body: fbody })
    self.tmp(ty, MkClosure(name, ty, caps.map(|c| V(c.0))))
}

fn lower_block(mut self: Lx, b: ast.Block) -> ir.Atom {
    self.push_scope()
    let a = self.lower_block_inner(b)
    self.pop_scope()
    a
}

fn lower_block_inner(mut self: Lx, b: ast.Block) -> ir.Atom {
    self.lower_stmts(b.stmts, b.tail)
}

fn lower_stmts(mut self: Lx, ss: List[ast.Stmt], tail: Option[ast.Expr]) -> ir.Atom {
    for (i, s) in ss.with_index() {
        match s.desc {
            SDefer(d) if !self.cur.dead => {
                return self.lower_defer(d, ss.skip(i + 1), tail)
            },
            _ => {
                self.mark(s.span)
                self.lower_stmt(s)
            },
        }
    }
    match tail {
        Some(e) => {
            self.mark(e.span)
            self.lower(e)
        },
        None => AUnit,
    }
}

// Where the next statement starts, in a development build.
fn mark(mut self: Lx, sp: ast.Span) {
    if self.ro.lines {
        self.emit(Line(sp))
    }
}

// `defer d` followed by `rest`: the rest runs under a guard whose handler
// is `d` (for panics and cancellations); every normal way out of the rest
// runs `d` itself after popping the guard: the end of the block here, and
// return, `?`, break and continue through run_defers.
fn lower_defer(mut self: Lx, d: ast.Block, rest: List[ast.Stmt], tail: Option[ast.Expr]) -> ir.Atom {
    self.guards = self.guards + 1
    let fr = Deferred { body: d, scopes: self.cur.scopes, loop_depth: self.cur.loop_depth, id: self.guards, outer: self.cur.defers }
    let rt = match tail {
        Some(e) => self.tyof(e),
        None => TUnit,
    }
    let r = self.fresh_var("dr", rt)
    self.emit(Decl(r))
    let saved = self.open()
    self.lower_defer_body(fr)
    let (handler, _) = self.close(saved)
    let saved = self.open()
    self.cur.defers = [fr] + self.cur.defers
    let a = self.lower_stmts(rest, tail)
    self.cur.defers = fr.outer
    if !self.cur.dead {
        self.emit(GuardEnd(fr.id))
        self.lower_defer_body(fr)
        self.emit(Init(r, Use(a)))
    }
    let (body, dead) = self.close(saved)
    self.emit(Guard(fr.id, handler, body))
    if dead {
        self.set_dead()
    }
    V(r)
}

// The deferred body, in the scope of its defer, with only the defers
// around it still pending.
fn lower_defer_body(mut self: Lx, fr: Deferred) {
    let saved_scopes = self.cur.scopes
    let saved_defers = self.cur.defers
    self.cur.scopes = fr.scopes
    self.cur.defers = fr.outer
    let _ = self.lower_block(fr.body)
    self.cur.scopes = saved_scopes
    self.cur.defers = saved_defers
}

// Leaving the given defers' blocks normally: innermost first, pop each
// guard and run its body.
fn run_defers(mut self: Lx, frames: List[Deferred]) {
    for fr in frames {
        self.emit(GuardEnd(fr.id))
        self.lower_defer_body(fr)
    }
}

// The defers inside the innermost loop, which break and continue leave.
fn loop_defers(self: Lx) -> List[Deferred] {
    let depth = self.cur.loop_depth
    self.cur.defers.filter(|fr| fr.loop_depth >= depth)
}

fn in_loop_block(mut self: Lx, b: ast.Block) {
    self.cur.loop_depth = self.cur.loop_depth + 1
    let _ = self.lower_block(b)
    self.cur.loop_depth = self.cur.loop_depth - 1
}

fn lower_stmt(mut self: Lx, s: ast.Stmt) {
    if self.cur.dead {
        return
    }
    match s.desc {
        SLetPat(..) | SForPat(..) => panic("destructuring is expanded when modules load"),
        SLet(m, n, _, _, e) => {
            let pure = !m && match e.desc {
                EClosure(..) => self.pure_closure_peek(e),
                EVar(g) => self.peek(g).is_none(),
                _ => false,
            }
            let a = self.lower(e)
            let v = self.fresh_var(n, self.tyof(e))
            match v.ty {
                TFn(..) if pure => {
                    self.pure_fns.push(v.id)
                },
                _ => {},
            }
            self.emit(Let(v, Use(a)))
            self.bind(n, v)
        },
        SAssign(lhs, rhs) => match lhs.desc {
            EVar(n) => {
                let a = self.lower(rhs)
                match self.lookup(n) {
                    Some(v) => self.emit(Set(v, Use(a), false)),
                    None => panic("assign"),
                }
            },
            EIndex(m, k) if is_map(self.tyof(m)) => {
                // `m[k] = v` inserts or replaces
                let a = self.lower(rhs)
                let ka = self.lower(k)
                let (v, steps) = self.lower_place(m)
                self.emit(Mutate(v, steps, MPut(ka, a)))
            },
            _ => {
                let a = self.lower(rhs)
                let (v, steps) = self.lower_place(lhs)
                self.emit(Mutate(v, steps, MSet(a)))
            },
        },
        SExpr(e) => {
            let _ = self.lower(e)
        },
        SReturn(eo) => {
            let a = match eo {
                Some(e) => self.lower(e),
                None => AUnit,
            }
            self.run_defers(self.cur.defers)
            self.emit(Return(a))
            self.set_dead()
        },
        SWhile(c, b) => {
            let saved = self.open()
            let ca = self.lower(c)
            let brk = self.break_block()
            self.emit(If(ca, [], brk))
            self.in_loop_block(b)
            let (body, _) = self.close(saved)
            self.emit(Loop(body))
        },
        SFor(n, _, range, b) if is_range(range) => {
            // count from lo while below hi; the list is never built
            let (lo, hi) = match range.desc {
                EBin(_, lo, hi) => (lo, hi),
                _ => panic("range"),
            }
            let sp = range.span
            let la = self.lower_arg(lo, [hi])
            let ha = self.lower(hi)
            let i = self.fresh_var("i", TInt)
            self.emit(Let(i, Use(la)))
            let h = self.fresh_var("hi", TInt)
            self.emit(Let(h, Use(ha)))
            let saved = self.open()
            let c = self.tmp(TBool, Bin(Ge, TInt, V(i), V(h), sp))
            let brk = self.break_block()
            self.emit(If(c, brk, []))
            let x = self.fresh_var(n, TInt)
            self.emit(Let(x, Use(V(i))))
            // i < hi, so i + 1 cannot overflow
            self.emit(Set(i, Bin(Add, TInt, V(i), AInt(1), sp), false))
            self.bind(n, x)
            self.in_loop_block(b)
            let (stmts, _) = self.close(saved)
            self.emit(Loop(stmts))
        },
        SFor(n, _, e, b) => {
            let la = self.lower(e)
            let (x, saved) = self.for_start(la, self.tyof(e), e.span)
            self.bind(n, x)
            self.in_loop_block(b)
            self.for_end(saved)
        },
        SBreak => {
            self.run_defers(self.loop_defers())
            self.emit(Break)
            self.set_dead()
        },
        SContinue => {
            self.run_defers(self.loop_defers())
            self.emit(Continue)
            self.set_dead()
        },
        SDefer(_) => panic("defer is lowered with its block"),
    }
}

fn is_range(e: ast.Expr) -> Bool {
    match e.desc {
        EBin(Range, _, _) => true,
        _ => false,
    }
}

// ---------- functions and the program ----------

fn lower_fn(mut self: Lx, job: Job) -> ir.Fn {
    let d = job.decl
    let env = job.targs
    let ret = match d.ret {
        Some(te) => resolve(env, te),
        None => TUnit,
    }
    self.cur = new_frame(env, ret)
    self.parents = []
    let mut params: List[ir.Var] = []
    for p in d.params {
        let v = self.fresh_var(p.name, resolve(env, p.ty))
        let v = { v with by_ref: p.mutable }
        self.bind(p.name, v)
        params.push(v)
    }
    let a = self.lower_block_inner(d.body)
    self.emit(Return(a))
    let f = ir.Fn { fname: job.cname, params, captures: [], is_closure: false, ret, body: self.cur.buf }
    self.cur = new_frame([], TUnit)
    f
}

// The checked program (its prelude, then its own items, as the checker
// returned them) in the IR. With `tests`, the program is its tests and
// benchmarks instead of `main`.
pub fn lower_program(checked_prelude: List[ast.Item], user_items: List[ast.Item], cx: env.Cx, st: env.State, tests: Bool, lines: Bool, profile: Bool = false) -> (ir.Program, Ro) {
    let mut fns: Map[Str, ast.FnDecl] = map()
    let mut structs: Map[Str, ast.StructDecl] = map()
    let mut enums: Map[Str, ast.EnumDecl] = map()
    let mut owners: Map[Str, Int] = map()
    let mut first_owner: Map[Str, Str] = map()
    for i in checked_prelude + user_items {
        match i {
            IFn(d) => {
                fns[d.name] = d
            },
            IStruct(s) => {
                structs[s.name] = s
            },
            IEnum(e) => {
                enums[e.name] = e
                for v in e.variants {
                    owners[v.name] = (owners.get(v.name) ?? 0) + 1
                    first_owner[v.name] = e.name
                }
            },
            IIface(_) | IType(_) => {},
        }
    }
    let mut ctors: Map[Str, Str] = map()
    for (v, n) in owners.entries() {
        if n == 1 {
            ctors[v] = first_owner[v]
        }
    }
    let ro = Ro { lines, profile, fns, structs, enums, ctors, types: st.types, insts: st.insts, nested: st.nested, subst: st.subst, ifaces: cx.ifaces, iface_gen: cx.iface_gen }
    let mut lx = Lx { ro, instances: map(), queue: [], next_job: 0, out: [], counter: 0, vars: 0, guards: 0, cur: new_frame([], TUnit), parents: [], pure_fns: [] }
    let field = |p: ast.Param| match p.ty.desc {
        TyName("Fs", _) => "fs",
        _ => "clock",
    }
    let mut test_names: List[ir.Test] = []
    let mut bench_names: List[ir.Test] = []
    if tests {
        for i in user_items {
            match i {
                IFn(d) if d.test.is_some() && !d.bench => {
                    let c = lx.instance(d.name, [])
                    test_names.push(ir.Test { cname: c, fields: d.params.map(field), virtual: d.virtual })
                },
                _ => {},
            }
        }
        for i in user_items {
            match i {
                IFn(d) if d.test.is_some() && d.bench => {
                    let c = lx.instance(d.name, [])
                    bench_names.push(ir.Test { cname: c, fields: d.params.map(field), virtual: false })
                },
                _ => {},
            }
        }
    }
    let main_decl = if tests { None } else { lx.ro.fns.get("main") }
    let mut main = ""
    if main_decl.is_some() {
        let c = lx.instance("main", [])
        main = c
    }
    while lx.next_job < lx.queue.len() {
        let job = lx.queue[lx.next_job]
        lx.next_job = lx.next_job + 1
        // lowering may add lifted closures to `out` first
        let f = lx.lower_fn(job)
        lx.out.push(f)
    }
    let main_ret = match main_decl {
        Some(d) => match d.ret {
            Some(te) => resolve([], te),
            None => TUnit,
        },
        None => TUnit,
    }
    let takes_root = match main_decl {
        Some(d) => !d.params.is_empty(),
        None => false,
    }
    (ir.Program { fns: lx.out, main, main_takes_root: takes_root, main_ret, tests: test_names, benches: bench_names, types: lx.ro.subst }, lx.ro)
}
