// What the language has built in, for the checker: the methods of the
// built-in types and of the capabilities, Root's fields, the names of the
// built-in types, and the names other languages use for ambient I/O. The
// same tables as src/check.ml, in the same order, which shows in
// suggestions and in the lists a message gives.
use types

pub struct Method {
    name: Str,
    params: List[types.Ty],
    result: types.Ty,
}

fn m(name: Str, params: List[types.Ty], result: types.Ty) -> Method {
    Method { name, params, result }
}

// The built-in methods of `t` (its outermost part known). `u` is a new
// type variable, for the methods whose result type is still to be found
// (`xs.map(f)`, `xs.fold(init, f)`).
pub fn methods(t: types.Ty, u: types.Ty) -> List[Method] {
    let io = types.io_err()
    match t {
        TStr => [
            m("len", [], TInt),
            m("is_empty", [], TBool),
            m("lines", [], TList(TStr)),
            m("split", [TStr], TList(TStr)),
            m("trim", [], TStr),
            m("contains", [TStr], TBool),
            m("starts_with", [TStr], TBool),
            m("ends_with", [TStr], TBool),
            m("to_upper", [], TStr),
            m("to_lower", [], TStr),
            m("replace", [TStr, TStr], TStr),
            m("parse_int", [], types.opt(TInt)),
            m("parse_float", [], types.opt(TFloat)),
            m("slice", [TInt, TInt], TStr),
            m("index_of", [TStr], types.opt(TInt)),
            m("last_index_of", [TStr], types.opt(TInt)),
            m("bytes", [], TList(TInt)),
            m("chars", [], TList(TStr)),
            m("to_bytes", [], TBytes),
            m("message", [], TStr),
        ],
        TBytes => [
            m("len", [], TInt),
            m("is_empty", [], TBool),
            m("get", [TInt], types.opt(TInt)),
            m("slice", [TInt, TInt], TBytes),
            m("to_list", [], TList(TInt)),
            m("to_str", [], TStr),
        ],
        TInt => [
            m("to_str", [], TStr),
            m("to_float", [], TFloat),
            m("abs", [], TInt),
            m("to_char", [], TStr),
            m("min", [TInt], TInt),
            m("max", [TInt], TInt),
            m("shift_right_unsigned", [TInt], TInt),
        ],
        TFloat => [m("to_str", [], TStr), m("to_int", [], TInt), m("abs", [], TFloat), m("sqrt", [], TFloat), m("to_fixed", [TInt], TStr)],
        TBool => [m("to_str", [], TStr)],
        TList(a) => [
            m("len", [], TInt),
            m("is_empty", [], TBool),
            m("get", [TInt], types.opt(a)),
            m("first", [], types.opt(a)),
            m("last", [], types.opt(a)),
            m("push", [a], TUnit),
            m("contains", [a], TBool),
            m("reverse", [], TList(a)),
            m("sort", [], TList(a)),
            m("take", [TInt], TList(a)),
            m("skip", [TInt], TList(a)),
            m("filter", [TFn([a], TBool)], TList(a)),
            m("map", [TFn([a], u)], TList(u)),
            m("fold", [u, TFn([u, a], u)], u),
            m("join", [TStr], TStr),
            m("sum", [], TInt),
        ],
        TMap(k, v) => [
            m("len", [], TInt),
            m("is_empty", [], TBool),
            m("get", [k], types.opt(v)),
            m("contains", [k], TBool),
            m("remove", [k], TUnit),
            m("keys", [], TList(k)),
            m("values", [], TList(v)),
            m("entries", [], TList(TNamed("#tuple2", [k, v]))),
        ],
        TArray(a, _) => [m("len", [], TInt), m("get", [TInt], types.opt(a)), m("to_list", [], TList(a)), m("contains", [a], TBool)],
        TNamed("Option", [a]) => [m("is_some", [], TBool), m("is_none", [], TBool), m("map", [TFn([a], u)], types.opt(u))],
        TNamed("IoError", []) => [m("message", [], TStr)],
        TNamed("Result", [a, e]) => [m("is_ok", [], TBool), m("is_err", [], TBool), m("map_error", [TFn([e], u)], types.res(a, u))],
        TCap(c) => cap_methods(c, io),
        TChan(a) => [m("send", [a], TUnit), m("recv", [], types.opt(a)), m("close", [], TUnit)],
        _ => [],
    }
}

fn cap_methods(c: Str, io: types.Ty) -> List[Method] {
    let res = |t: types.Ty| types.res(t, io)
    match c {
        "Net" => [m("get", [TStr], res(TNamed("HttpResponse", []))), m("only", [TStr], TCap("Net")), m("connect", [TStr], res(TCap("Conn"))), m("connect_tls", [TStr], res(TCap("Conn")))],
        "Listen" => [m("on", [TStr], res(TCap("Listener"))), m("on_tls", [TStr, TStr, TStr], res(TCap("Listener")))],
        "Listener" => [m("accept", [], res(TCap("Conn"))), m("port", [], TInt), m("close", [], TUnit)],
        "Conn" => [m("read", [], res(TStr)), m("write", [TStr], res(TUnit)), m("close", [], TUnit)],
        "Fs" => [
            m("read", [TStr], res(TStr)),
            m("write", [TStr, TStr], res(TUnit)),
            m("append", [TStr, TStr], res(TUnit)),
            m("list", [TStr], res(TList(TStr))),
            m("remove", [TStr], res(TUnit)),
            m("make_dir", [TStr], res(TUnit)),
            m("is_dir", [TStr], TBool),
            m("full_path", [TStr], res(TStr)),
            m("is_read_only", [], TBool),
            m("exists", [TStr], TBool),
            m("under", [TStr], TCap("Fs")),
            m("read_only", [], TCap("Fs")),
            m("rename", [TStr, TStr], res(TUnit)),
            m("info", [TStr], res(TNamed("FileInfo", []))),
        ],
        "Stdout" | "Stderr" => [m("print", [TStr], TUnit), m("write", [TStr], TUnit)],
        "Clock" => [m("now_ms", [], TInt), m("sleep", [TInt], TUnit)],
        "Rand" => [m("int", [TInt, TInt], TInt), m("float", [], TFloat)],
        "Stdin" => [m("read_line", [], types.opt(TStr)), m("read_all", [], TStr)],
        "Env" => [m("get", [TStr], types.opt(TStr))],
        "Exec" => [m("run", [TStr, TList(TStr)], res(TNamed("ProcessOutput", []))), m("only", [TStr], TCap("Exec"))],
        "Foreign" => [m("only", [TStr], TCap("Foreign")), m("allows", [TStr], TBool), m("copy", [TNamed("Handle", []), TInt], TBytes)],
        "Root" => [m("args", [], TList(TStr))],
        _ => [],
    }
}

pub fn find(t: types.Ty, u: types.Ty, name: Str) -> Option[Method] {
    methods(t, u).find(|x| x.name == name)
}

pub fn names(t: types.Ty) -> List[Str] {
    methods(t, TErr).map(|x| x.name)
}

// The name a built-in type's methods are keyed by (`Str::shout`), if a
// program can add methods to it.
pub fn type_name(t: types.Ty) -> Option[Str] {
    match t {
        TInt => Some("Int"),
        TFloat => Some("Float"),
        TBool => Some("Bool"),
        TStr => Some("Str"),
        TBytes => Some("Bytes"),
        TList(_) => Some("List"),
        TMap(..) => Some("Map"),
        TNamed(n, _) if n == "Option" || n == "Result" || n == "IoError" => Some(n),
        _ => None,
    }
}

pub fn root_fields() -> List[(Str, types.Ty)] {
    [("net", TCap("Net")), ("fs", TCap("Fs")), ("stdout", TCap("Stdout")), ("stderr", TCap("Stderr")), ("clock", TCap("Clock")), ("listen", TCap("Listen")), ("rand", TCap("Rand")), ("stdin", TCap("Stdin")), ("env", TCap("Env")), ("exec", TCap("Exec")), ("foreign", TCap("Foreign"))]
}

pub fn type_names() -> List[Str] {
    ["Int", "Float", "Bool", "Str", "Bytes", "List", "Array", "Chan", "Root", "Net", "Fs", "Stdout", "Stderr", "Clock", "Listen", "Listener", "Conn", "Rand", "Stdin", "Env", "Exec", "Foreign", "Map"]
}

pub fn cap_names() -> List[Str] {
    ["Root", "Net", "Fs", "Stdout", "Stderr", "Clock", "Listen", "Listener", "Conn", "Rand", "Stdin", "Env", "Exec", "Foreign"]
}

// Built-in bounds with no methods: `Ordered` (the type has `<`) and `Key`
// (it can be a map key).
pub fn bounds() -> List[Str] {
    ["Ordered", "Key"]
}

// The functions every program can call without declaring them.
pub fn functions() -> List[Str] {
    ["panic", "channel", "assert", "assert_eq", "map", "catch", "bytes", "keep", "embed", "embed_bytes", "embed_dir"]
}

// A name other languages use for ambient I/O: the capability Tessera uses
// instead, and how to call it.
pub struct Ambient {
    name: Str,
    cap: Str,
    how: Str,
}

pub fn ambient(name: Str) -> Option[Ambient] {
    let all = [
        ("print", "Stdout", "out.print(...)"),
        ("println", "Stdout", "out.print(...)"),
        ("eprint", "Stderr", "stderr.print(...)"),
        ("puts", "Stdout", "out.print(...)"),
        ("open", "Fs", "fs.read(path)"),
        ("read_file", "Fs", "fs.read(path)"),
        ("write_file", "Fs", "fs.write(path, text)"),
        ("fetch", "Net", "net.get(url)"),
        ("http_get", "Net", "net.get(url)"),
        ("now", "Clock", "clock.now_ms()"),
        ("time", "Clock", "clock.now_ms()"),
        ("sleep", "Clock", "clock.sleep(ms)"),
        ("random", "Rand", "rand.int(lo, hi)"),
        ("rand", "Rand", "rand.int(lo, hi)"),
        ("input", "Stdin", "stdin.read_line()"),
        ("read_line", "Stdin", "stdin.read_line()"),
        ("getenv", "Env", "env.get(name)"),
        ("system", "Exec", "exec.run(program, args)"),
        ("spawn", "Exec", "exec.run(program, args)"),
        ("popen", "Exec", "exec.run(program, args)"),
    ]
    all.find(|a| a.0 == name).map(|a| Ambient { name: a.0, cap: a.1, how: a.2 })
}
