// `embed("page.html")`, `embed_bytes("logo.png")` and `embed_dir("public")`
// are read by the compiler and become literals, as src/modules.ml does it,
// so a program that serves its own files needs no Fs.
//
// The path is relative to the file that names it and must stay inside
// that file's package: the directory of its tessera.toml (of the main file
// when there is none), or a dependency's own directory. Otherwise a
// dependency could bake `../../.ssh/id_rsa` into the binary, a read no
// grant allows. The program's own tessera.toml can add directories, its
// embed roots (`[embed] roots = ["../assets"]`); a dependency's cannot.
// Here that rule is a capability: the loader reads a file through an Fs
// limited to the package or the root holding it (`fs.under`), which
// refuses `..` and links that lead out of it.
//
// The loader reads every embedded file of a module before renaming it, so
// renaming (selfhost/rename.tsr) stays pure; it looks up what each call
// found by the call's position.
use ast
use disk
use paths
use walk

pub enum Found {
    // `embed` and `embed_bytes`: the file's contents
    Text(Str),
    // `embed_dir`: each file's path inside the directory, and its contents
    Files(List[(Str, Str)]),
    // why it cannot be embedded, for an E0405
    Problem(Str),
}

pub fn is_embed(name: Str) -> Bool {
    name == "embed" || name == "embed_bytes" || name == "embed_dir"
}

// The path an embed call names, when its one argument is a string literal.
pub fn literal_path(args: List[ast.Expr]) -> Option[Str] {
    match args {
        [arg] => match arg.desc {
            EStr([]) => Some(""),
            EStr([SPLit(p)]) => Some(p),
            _ => None,
        },
        _ => None,
    }
}

// What a call is known by: its place in its file.
pub fn key(span: ast.Span) -> Str {
    "{span.file}:{span.lo}:{span.hi}"
}

// What each embed call in `items` finds, by key. `file` is the path of
// the module they come from and `roots` the directories its files may
// come from, its package's first (None for the standard library, which
// cannot embed). A call that a local or an item turns out to hide is read
// too, and its result never used.
pub fn read_all(fs: Fs, place: disk.Place, file: Str, roots: Option[List[Str]], items: List[ast.Item]) -> Map[Str, Found] {
    let mut found: Map[Str, Found] = map()
    for e in items.flat_map(walk.item) {
        match e.desc {
            ECall(callee, args) => match callee.desc {
                EVar(name) if is_embed(name) => match literal_path(args) {
                    Some(path) => {
                        found[key(e.span)] = read(fs, place, file, roots, name, path)
                    },
                    None => {},
                },
                _ => {},
            },
            _ => {},
        }
    }
    found
}

fn read(fs: Fs, place: disk.Place, file: Str, roots: Option[List[Str]], name: Str, path: Str) -> Found {
    let roots = match roots {
        Some(r) => r,
        None => {
            return Problem("the standard library cannot use `{name}`")
        },
    }
    if path == "" || !paths.is_relative(path) {
        return Problem("`{name}` takes a path relative to this file, not `{path}`")
    }
    let full = paths.concat(paths.dirname(file), path)
    let missing = Problem("cannot find `{path}` (looked for {full})")
    // the package's directory and the file, as real paths
    let real_main = match fs.full_path(place.locate(roots[0])) {
        Ok(r) => r,
        Err(_) => {
            return missing
        },
    }
    if !fs.exists(place.locate(full)) {
        return missing
    }
    let real = match fs.full_path(place.locate(full)) {
        Ok(r) => r,
        Err(_) => {
            return missing
        },
    }
    // the embed roots that exist, each with its real path
    let extra = roots.skip(1).flat_map(|r| match fs.full_path(place.locate(r)) {
        Ok(x) => [(r, x)],
        Err(_) => [],
    })
    let outside = Problem(if extra.is_empty() {
        "`{path}` is outside this package ({real_main}); a program can embed only its own package's files"
    } else {
        "`{path}` is outside this package ({real_main}) and its embed roots ({extra.map(|x| x.1).join(", ")}); a program can embed only its own package's files and those under the roots its tessera.toml declares"
    })
    // the first directory that holds the file
    let mut chosen: Option[(Str, Str, Str)] = None
    for (r, real_r) in [(roots[0], real_main)] + extra {
        match inside(real_r, real) {
            Some(p) => {
                chosen = Some((r, real_r, p))
                break
            },
            None => {},
        }
    }
    let (root, real_root, inner) = match chosen {
        Some(c) => c,
        None => {
            return outside
        },
    }
    // a single file is never the package's directory itself
    if inner == "" && name != "embed_dir" {
        return outside
    }
    // from here on, only through the package
    let package = fs.under(place.locate(root))
    if name == "embed_dir" {
        if !package.is_dir(inner) {
            return Problem("`{path}` is a file, not a directory; use `embed` or `embed_bytes` for one file")
        }
        return match files(package, inner, path, "", real_root) {
            Ok([]) => Problem("`{path}` has no files to embed (names starting with `.` are left out)"),
            Ok(found) => Files(found),
            Err(message) => Problem(message),
        }
    }
    if package.is_dir(inner) {
        return Problem("`{path}` is a directory, not a file")
    }
    match package.read(inner) {
        Ok(text) => {
            if name == "embed" && !valid_utf8(text) {
                Problem("`{path}` is not UTF-8 text; use `embed_bytes(\"{path}\")` for a Bytes value")
            } else {
                Text(text)
            }
        },
        // a link that leads out of the package
        Err(Denied(_)) => outside,
        Err(e) => Problem("cannot read `{path}`: {e}"),
    }
}

// `path` relative to `root` when it is inside it ("" for the root itself).
fn inside(root: Str, path: Str) -> Option[Str] {
    if path == root {
        return Some("")
    }
    let prefix = if root == "/" { "/" } else { root + "/" }
    if path.starts_with(prefix) { Some(path.slice(prefix.len(), path.len())) } else { None }
}

// The files under directory `dir` of the package, keyed by their path
// below the directory `embed_dir` named (`path`), in sorted order. Names
// starting with `.` are left out.
fn files(package: Fs, dir: Str, path: Str, prefix: Str, real_root: Str) -> Result[List[(Str, Str)], Str] {
    let names = match package.list(dir) {
        Ok(names) => names,
        Err(_) => {
            return Err("cannot read `{path}/{prefix}`")
        },
    }
    let mut out: List[(Str, Str)] = []
    for n in names {
        if n == "" || n.starts_with(".") {
            continue
        }
        let key = if prefix == "" { n } else { prefix + "/" + n }
        let entry = paths.concat(dir, n)
        if package.is_dir(entry) {
            out = out + files(package, entry, path, key, real_root)?
            continue
        }
        match package.read(entry) {
            Ok(text) => out.push((key, text)),
            Err(Denied(_)) => {
                return Err("`{path}/{key}` points outside this package ({real_root}); a program can embed only its own package's files")
            },
            Err(_) => {
                return Err("cannot read `{path}/{key}`")
            },
        }
    }
    Ok(out)
}

// Whether `s` is well-formed UTF-8: no stray continuation bytes, no
// overlong forms, no surrogates, nothing past U+10FFFF.
pub fn valid_utf8(s: Str) -> Bool {
    let bs = s.bytes()
    let n = bs.len()
    let mut i = 0
    while i < n {
        let b = bs[i]
        if b < 128 {
            i = i + 1
            continue
        }
        // how many bytes follow, and the range the first of them must be in
        let (more, lo, hi) = if b >= 194 && b <= 223 {
            (1, 128, 191)
        } else if b == 224 {
            (2, 160, 191)
        } else if (b >= 225 && b <= 236) || b == 238 || b == 239 {
            (2, 128, 191)
        } else if b == 237 {
            (2, 128, 159)
        } else if b == 240 {
            (3, 144, 191)
        } else if b >= 241 && b <= 243 {
            (3, 128, 191)
        } else if b == 244 {
            (3, 128, 143)
        } else {
            return false
        }
        if i + more >= n {
            return false
        }
        if bs[i + 1] < lo || bs[i + 1] > hi {
            return false
        }
        let mut k = 2
        while k <= more {
            if bs[i + k] < 128 || bs[i + k] > 191 {
                return false
            }
            k = k + 1
        }
        i = i + more + 1
    }
    true
}
