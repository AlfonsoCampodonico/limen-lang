// The rotation of each step.
fn shifts() -> List[Int] {
    [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
}

fn pow2(n: Int) -> Int {
    let mut p = 1
    for _ in 0..<n {
        p = p * 2
    }
    p
}

// The digest of `s`, as 32 lowercase hex digits.
pub fn hex(s: Str) -> Str {
    let t = tables()
    let k = sines()
    let powers = shifts().map(pow2)
    let shift = shifts()
    // the message, padded: a 1 bit, zeros up to 56 bytes past a multiple
    // of 64, then the length in bits, little-endian
    let mut bs = s.bytes()
    let n = bs.len()
    bs.push(128)
    while bs.len() % 64 != 56 {
        bs.push(0)
    }
    let mut bits = n * 8
    for _ in 0..<8 {
        bs.push(bits % 256)
        bits = bits / 256
    }
    let mut a0 = 1732584193
    let mut b0 = 4023233417
    let mut c0 = 2562383102
    let mut d0 = 271733878
    let mut m: List[Int] = []
    for _ in 0..<16 {
        m.push(0)
    }
    let mut at = 0
    while at < bs.len() {
        for j in 0..<16 {
            let i = at + j * 4
            m[j] = bs[i] + bs[i + 1] * 256 + bs[i + 2] * 65536 + bs[i + 3] * 16777216
        }
        let mut a = a0
        let mut b = b0
        let mut c = c0
        let mut d = d0
        for i in 0..<64 {
            let (f, g) = if i < 16 {
                // (b and c) or (not b and d), as d xor (b and (c xor d))
                (t.xor(d, t.and(b, t.xor(c, d))), i)
            } else if i < 32 {
                // (d and b) or (not d and c), as c xor (d and (b xor c))
                (t.xor(c, t.and(d, t.xor(b, c))), (5 * i + 1) % 16)
            } else if i < 48 {
                (t.xor(t.xor(b, c), d), (3 * i + 5) % 16)
            } else {
                (t.xor(c, t.or(b, not(d))), 7 * i % 16)
            }
            let sum = low32(a + f + k[i] + m[g])
            a = d
            d = c
            c = b
            b = low32(b + rotl(sum, shift[i], powers[i]))
        }
        a0 = low32(a0 + a)
        b0 = low32(b0 + b)
        c0 = low32(c0 + c)
        d0 = low32(d0 + d)
        at = at + 64
    }
    [a0, b0, c0, d0].map(word_hex).join("")
}

// A word's four bytes, low byte first, in hex.
fn word_hex(w: Int) -> Str {
    let digits = "0123456789abcdef"
    let mut out = ""
    let mut w = w
    for _ in 0..<4 {
        let b = w % 256
        out = out + digits.slice(b / 16, b / 16 + 1) + digits.slice(b % 16, b % 16 + 1)
        w = w / 256
    }
    out
}
