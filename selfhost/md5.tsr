// MD5 (RFC 1321), as OCaml's `Digest.to_hex (Digest.string s)` gives it:
// the build cache names a binary by the digest of what decides it, and the
// Tessera compiler must find the binaries the OCaml one put there.
//
// A 32-bit word is an Int from 0 to 2^32 - 1, kept there with `& mask()`.

fn mask() -> Int {
    4294967295
}

// Rotate a word left by `n` bits.
fn rotl(x: Int, n: Int) -> Int {
    (x << n | x >> (32 - n)) & mask()
}

// The sine constants: the integer part of 2^32 * abs(sin(i + 1)).
fn sines() -> List[Int] {
    [
        3614090360,
        3905402710,
        606105819,
        3250441966,
        4118548399,
        1200080426,
        2821735955,
        4249261313,
        1770035416,
        2336552879,
        4294925233,
        2304563134,
        1804603682,
        4254626195,
        2792965006,
        1236535329,
        4129170786,
        3225465664,
        643717713,
        3921069994,
        3593408605,
        38016083,
        3634488961,
        3889429448,
        568446438,
        3275163606,
        4107603335,
        1163531501,
        2850285829,
        4243563512,
        1735328473,
        2368359562,
        4294588738,
        2272392833,
        1839030562,
        4259657740,
        2763975236,
        1272893353,
        4139469664,
        3200236656,
        681279174,
        3936430074,
        3572445317,
        76029189,
        3654602809,
        3873151461,
        530742520,
        3299628645,
        4096336452,
        1126891415,
        2878612391,
        4237533241,
        1700485571,
        2399980690,
        4293915773,
        2240044497,
        1873313359,
        4264355552,
        2734768916,
        1309151649,
        4149444226,
        3174756917,
        718787259,
        3951481745,
    ]
}

// The rotation of each step.
fn shifts() -> List[Int] {
    [7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21]
}

// The digest of `s`, as 32 lowercase hex digits.
pub fn hex(s: Str) -> Str {
    let k = sines()
    let shift = shifts()
    // the message, padded: a 1 bit, zeros up to 56 bytes past a multiple
    // of 64, then the length in bits, little-endian
    let mut bs = s.bytes()
    let n = bs.len()
    bs.push(128)
    while bs.len() % 64 != 56 {
        bs.push(0)
    }
    let bits = n * 8
    for i in 0..<8 {
        bs.push(bits >> (8 * i) & 255)
    }
    let mut a0 = 1732584193
    let mut b0 = 4023233417
    let mut c0 = 2562383102
    let mut d0 = 271733878
    let mut m: List[Int] = []
    for _ in 0..<16 {
        m.push(0)
    }
    let mut at = 0
    while at < bs.len() {
        for j in 0..<16 {
            let i = at + j * 4
            m[j] = bs[i] | bs[i + 1] << 8 | bs[i + 2] << 16 | bs[i + 3] << 24
        }
        let mut a = a0
        let mut b = b0
        let mut c = c0
        let mut d = d0
        for i in 0..<64 {
            let (f, g) = if i < 16 {
                // (b and c) or (not b and d), as d xor (b and (c xor d))
                (d ^ b & (c ^ d), i)
            } else if i < 32 {
                // (d and b) or (not d and c), as c xor (d and (b xor c))
                (c ^ d & (b ^ c), (5 * i + 1) % 16)
            } else if i < 48 {
                (b ^ c ^ d, (3 * i + 5) % 16)
            } else {
                (c ^ (b | ~d & mask()), 7 * i % 16)
            }
            let sum = (a + f + k[i] + m[g]) & mask()
            a = d
            d = c
            c = b
            b = (b + rotl(sum, shift[i])) & mask()
        }
        a0 = (a0 + a) & mask()
        b0 = (b0 + b) & mask()
        c0 = (c0 + c) & mask()
        d0 = (d0 + d) & mask()
        at = at + 64
    }
    [a0, b0, c0, d0].map(word_hex).join("")
}

// A word's four bytes, low byte first, in hex.
fn word_hex(w: Int) -> Str {
    let digits = "0123456789abcdef"
    let mut out = ""
    for i in 0..<4 {
        let b = w >> (8 * i) & 255
        out = out + digits.slice(b >> 4, (b >> 4) + 1) + digits.slice(b & 15, (b & 15) + 1)
    }
    out
}
