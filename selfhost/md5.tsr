// MD5 (RFC 1321), as OCaml's `Digest.to_hex (Digest.string s)` gives it:
// the build cache names a binary by the digest of what decides it, and the
// Tessera compiler must find the binaries the OCaml one put there.
//
// Tessera has no bitwise operators. A 32-bit word is an Int from 0 to
// 2^32 - 1, and `and`, `or` and `xor` go a byte at a time through tables
// of all 65536 byte pairs, made once per digest: a few divisions and four
// lookups per operation, instead of a loop over 32 bits.

// The byte-pair tables: entry a * 256 + b is `a op b`.
struct Tables {
    and: List[Int],
    or: List[Int],
    xor: List[Int],
}

fn tables() -> Tables {
    let mut and: List[Int] = []
    let mut or: List[Int] = []
    let mut xor: List[Int] = []
    for a in 0..<256 {
        for b in 0..<256 {
            let mut x = a
            let mut y = b
            let mut bit = 1
            let mut n = 0
            let mut o = 0
            let mut e = 0
            while bit < 256 {
                let p = x % 2
                let q = y % 2
                if p == 1 && q == 1 {
                    n = n + bit
                }
                if p == 1 || q == 1 {
                    o = o + bit
                }
                if p != q {
                    e = e + bit
                }
                x = x / 2
                y = y / 2
                bit = bit * 2
            }
            and.push(n)
            or.push(o)
            xor.push(e)
        }
    }
    Tables { and, or, xor }
}

// `op` applied to two words, byte by byte.
fn bytewise(op: List[Int], a: Int, b: Int) -> Int {
    op[a % 256 * 256 + b % 256] + op[a / 256 % 256 * 256 + b / 256 % 256] * 256 + op[a / 65536 % 256 * 256 + b / 65536 % 256] * 65536 + op[a / 16777216 * 256 + b / 16777216] * 16777216
}

fn and(self: Tables, a: Int, b: Int) -> Int {
    bytewise(self.and, a, b)
}

fn or(self: Tables, a: Int, b: Int) -> Int {
    bytewise(self.or, a, b)
}

fn xor(self: Tables, a: Int, b: Int) -> Int {
    bytewise(self.xor, a, b)
}

fn not(a: Int) -> Int {
    4294967295 - a
}

fn low32(x: Int) -> Int {
    x % 4294967296
}

// Rotate a word left by `n` bits; `p` is 2^n. The product stays below 2^63.
fn rotl(x: Int, n: Int, p: Int) -> Int {
    low32(x * p) + x / (4294967296 / p)
}

// The sine constants: the integer part of 2^32 * abs(sin(i + 1)).
fn sines() -> List[Int] {
    [
        3614090360,
        3905402710,
        606105819,
        3250441966,
        4118548399,
        1200080426,
        2821735955,
