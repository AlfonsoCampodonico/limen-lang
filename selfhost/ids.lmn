// Expression ids. The checker learns things about expressions (a type,
// the type arguments of a generic function's use, which function a call
// reaches) and keeps them in maps keyed by an expression's id, since it
// cannot write them into the tree the way the OCaml checker does. So every
// expression of a loaded program needs an id no other expression has.
//
// The parser numbers each file as it finishes it, from a first id the
// module loader gives it, so the files of a program get ranges that do not
// overlap. The loader gives the expressions it builds itself (a pipe's
// call, the parts of an unpacked tuple, an embedded file's text) ids that
// come after all the files', and numbers each copy of a table test again.
//
// The order is a walk of the tree: an expression before the expressions
// inside it, those in the order they are written. Only expressions get
// ids. Patterns, statements and types are not annotated: a binding's type
// is its value's type or follows from the scrutinee's, and a block's is its
// tail's.
use ast

// Each function takes the next free id as a `mut` parameter, numbers the
// node, and leaves the next free id after it there.

pub fn file(f: ast.File, mut next: Int) -> ast.File {
    let mut items: List[ast.Item] = []
    for i in f.items {
        items.push(item(i, mut next))
    }
    { f with items }
}

pub fn item(i: ast.Item, mut next: Int) -> ast.Item {
    match i {
        IFn(d) => {
            let d = function(d, mut next)
            IFn(d)
        },
        // only functions hold expressions
        IStruct(_) | IEnum(_) | IIface(_) | IType(_) => i,
    }
}

fn function(d: ast.FnDecl, mut next: Int) -> ast.FnDecl {
    // parameters' defaults first, then a table test's cases, then the body
    let mut params: List[ast.Param] = []
    for prm in d.params {
        let default = opt_expr(prm.default, mut next)
        params.push({ prm with default })
    }
    let d = { d with params }
    let table = match d.table {
        Some(t) => {
            let cases = expr(t.cases, mut next)
            Some({ t with cases })
        },
        None => None,
    }
    let body = block(d.body, mut next)
    { d with table, body }
}

pub fn expr(e: ast.Expr, mut next: Int) -> ast.Expr {
    // this expression first, then the ones inside it
    let id = next
    next = next + 1
    let desc = match e.desc {
        EInt(_) | EFloat(_) | EBool(_) | EUnit | EVar(_) => e.desc,
        EStr(parts) => {
            let mut out: List[ast.StrPart] = []
            for part in parts {
                out.push(str_part(part, mut next))
            }
            EStr(out)
        },
        EList(items) => {
            let items = exprs(items, mut next)
            EList(items)
        },
        EBin(o, a, b) => {
            let a = expr(a, mut next)
            let b = expr(b, mut next)
            EBin(o, a, b)
        },
        EUn(o, a) => {
            let a = expr(a, mut next)
            EUn(o, a)
        },
        ECall(f, args) => {
            let f = expr(f, mut next)
            let args = exprs(args, mut next)
            ECall(f, args)
        },
        EMethod(r, name, span, args) => {
            let r = expr(r, mut next)
            let args = exprs(args, mut next)
            EMethod(r, name, span, args)
        },
        EField(r, name, span) => {
            let r = expr(r, mut next)
            EField(r, name, span)
        },
        EIndex(a, i) => {
            let a = expr(a, mut next)
            let i = expr(i, mut next)
            EIndex(a, i)
        },
        ETry(a, context) => {
            let a = expr(a, mut next)
            let context = opt_expr(context, mut next)
            ETry(a, context)
        },
        EIf(c, then, other) => {
            let c = expr(c, mut next)
            let then = block(then, mut next)
            let other = opt_expr(other, mut next)
            EIf(c, then, other)
        },
        EMatch(s, arms) => {
            let s = expr(s, mut next)
            let mut out: List[ast.Arm] = []
            for a in arms {
                out.push(arm(a, mut next))
            }
            EMatch(s, out)
        },
        EBlock(b) => {
            let b = block(b, mut next)
            EBlock(b)
        },
        EClosure(params, body) => {
            let body = expr(body, mut next)
            EClosure(params, body)
        },
        EStruct(name, span, fields) => {
            let fields = field_inits(fields, mut next)
            EStruct(name, span, fields)
        },
        EGroup(name, interleaved, until, b) => {
            let until = match until {
                Some(d) => Some(deadline(d, mut next)),
                None => None,
            }
            let b = block(b, mut next)
            EGroup(name, interleaved, until, b)
        },
        ESelect(arms) => {
            let mut out: List[ast.SelArm] = []
            for a in arms {
                out.push(sel_arm(a, mut next))
            }
            ESelect(out)
        },
        EPipe(a, b) => {
            let a = expr(a, mut next)
            let b = expr(b, mut next)
            EPipe(a, b)
        },
        EWith(base, fields) => {
            let base = expr(base, mut next)
            let fields = field_inits(fields, mut next)
            EWith(base, fields)
        },
        ESafe(option, name, rest) => {
            let option = expr(option, mut next)
            let rest = expr(rest, mut next)
            ESafe(option, name, rest)
        },
        ENamed(name, span, value) => {
            let value = expr(value, mut next)
            ENamed(name, span, value)
        },
        EMut(place) => {
            let place = expr(place, mut next)
            EMut(place)
        },
        EDyn(value, iface) => {
            let value = expr(value, mut next)
            EDyn(value, iface)
        },
    }
    { e with desc, id }
}

fn exprs(xs: List[ast.Expr], mut next: Int) -> List[ast.Expr] {
    let mut out: List[ast.Expr] = []
    for x in xs {
        out.push(expr(x, mut next))
    }
    out
}

fn opt_expr(x: Option[ast.Expr], mut next: Int) -> Option[ast.Expr] {
    match x {
        Some(v) => Some(expr(v, mut next)),
        None => None,
    }
}

fn str_part(part: ast.StrPart, mut next: Int) -> ast.StrPart {
    match part {
        SPLit(_) => part,
        SPExpr(x) => {
            let x = expr(x, mut next)
            SPExpr(x)
        },
    }
}

fn field_inits(fields: List[ast.FieldInit], mut next: Int) -> List[ast.FieldInit] {
    let mut out: List[ast.FieldInit] = []
    for f in fields {
        let value = expr(f.value, mut next)
        out.push({ f with value })
    }
    out
}

fn deadline(d: ast.Deadline, mut next: Int) -> ast.Deadline {
    let clock = expr(d.clock, mut next)
    let ms = expr(d.ms, mut next)
    ast.Deadline { clock, ms }
}

fn arm(a: ast.Arm, mut next: Int) -> ast.Arm {
    let guard = opt_expr(a.guard, mut next)
    let body = expr(a.body, mut next)
    { a with guard, body }
}

fn sel_arm(a: ast.SelArm, mut next: Int) -> ast.SelArm {
    let op = match a.op {
        SelRecv(bound, ch) => {
            let ch = expr(ch, mut next)
            SelRecv(bound, ch)
        },
        SelSend(ch, v) => {
            let ch = expr(ch, mut next)
            let v = expr(v, mut next)
            SelSend(ch, v)
        },
        SelAfter(clock, ms) => {
            let clock = expr(clock, mut next)
            let ms = expr(ms, mut next)
            SelAfter(clock, ms)
        },
        SelDefault => SelDefault,
    }
    let guard = opt_expr(a.guard, mut next)
    let body = expr(a.body, mut next)
    { a with op, guard, body }
}

pub fn block(b: ast.Block, mut next: Int) -> ast.Block {
    let mut stmts: List[ast.Stmt] = []
    for s in b.stmts {
        stmts.push(stmt(s, mut next))
    }
    let tail = opt_expr(b.tail, mut next)
    { b with stmts, tail }
}

fn stmt(s: ast.Stmt, mut next: Int) -> ast.Stmt {
    let desc = match s.desc {
        SLet(m, name, span, t, e) => {
            let e = expr(e, mut next)
            SLet(m, name, span, t, e)
        },
        SAssign(a, b) => {
            let a = expr(a, mut next)
            let b = expr(b, mut next)
            SAssign(a, b)
        },
        SExpr(e) => {
            let e = expr(e, mut next)
            SExpr(e)
        },
        SReturn(e) => {
            let e = opt_expr(e, mut next)
            SReturn(e)
        },
        SWhile(c, body) => {
            let c = expr(c, mut next)
            let body = block(body, mut next)
            SWhile(c, body)
        },
        SFor(name, span, e, body) => {
            let e = expr(e, mut next)
            let body = block(body, mut next)
            SFor(name, span, e, body)
        },
        SLetPat(p, e) => {
            let e = expr(e, mut next)
            SLetPat(p, e)
        },
        SForPat(p, e, body) => {
            let e = expr(e, mut next)
            let body = block(body, mut next)
            SForPat(p, e, body)
        },
        SDefer(body) => {
            let body = block(body, mut next)
            SDefer(body)
        },
        SBreak | SContinue => s.desc,
    }
    { s with desc }
}
