// Sets of variable ids, as sorted lists without repeats: what the
// ownership pass and the IR optimizations keep their liveness in, where the
// OCaml compiler uses Set.Make(Int). Listing a set gives its ids in
// increasing order, as OCaml's S.elements does, which decides the order
// of the drops the ownership pass writes.

pub fn empty() -> List[Int] {
    []
}

// Where `x` is, or would go, in `s`.
fn position(s: List[Int], x: Int) -> Int {
    let mut lo = 0
    let mut hi = s.len()
    while lo < hi {
        let mid = (lo + hi) / 2
        if s[mid] < x {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

pub fn mem(s: List[Int], x: Int) -> Bool {
    let i = position(s, x)
    i < s.len() && s[i] == x
}

pub fn add(s: List[Int], x: Int) -> List[Int] {
    let i = position(s, x)
    if i < s.len() && s[i] == x {
        return s
    }
    s.take(i) + [x] + s.skip(i)
}

pub fn remove(s: List[Int], x: Int) -> List[Int] {
    let i = position(s, x)
    if i < s.len() && s[i] == x {
        return s.take(i) + s.skip(i + 1)
    }
    s
}

pub fn of_list(xs: List[Int]) -> List[Int] {
    xs.sort().distinct()
}

pub fn union(a: List[Int], b: List[Int]) -> List[Int] {
    if a.is_empty() {
        return b
    }
    if b.is_empty() {
        return a
    }
    let mut out: List[Int] = []
    let mut i = 0
    let mut j = 0
    while i < a.len() && j < b.len() {
        let x = a[i]
        let y = b[j]
        if x < y {
            out.push(x)
            i = i + 1
        } else if y < x {
            out.push(y)
            j = j + 1
        } else {
            out.push(x)
            i = i + 1
            j = j + 1
        }
    }
    out + a.skip(i) + b.skip(j)
}

// The ids of `a` that are not in `b`.
pub fn diff(a: List[Int], b: List[Int]) -> List[Int] {
    if a.is_empty() || b.is_empty() {
        return a
    }
    let mut out: List[Int] = []
    let mut j = 0
    for x in a {
        while j < b.len() && b[j] < x {
            j = j + 1
        }
        if j >= b.len() || b[j] != x {
            out.push(x)
        }
    }
    out
}

pub fn inter(a: List[Int], b: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    let mut j = 0
    for x in a {
        while j < b.len() && b[j] < x {
            j = j + 1
        }
        if j < b.len() && b[j] == x {
            out.push(x)
        }
    }
    out
}
