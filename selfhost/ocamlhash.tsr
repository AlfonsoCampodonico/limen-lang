// The order OCaml's hash tables list their keys in. The OCaml checker
// suggests a name for a misspelled one ("did you mean `count`?") by
// scanning candidates that come from its hash tables, and of two
// candidates equally close it keeps the first: so which one it suggests
// depends on where the keys sit in the table. To suggest the same name,
// the Tessera checker lists the candidates in that order.
//
// A table created with `Hashtbl.create n` (n up to 16) starts with 16
// buckets and doubles them when it holds more than twice as many keys. A
// key goes in bucket `hash land (buckets - 1)`, at the front, and doubling
// keeps the order inside a bucket. Listing goes through the buckets in
// order, each from its front.

// The keys of a table that got them in this order, each once, in the
// order Hashtbl.to_seq_keys lists them.
pub fn order(keys: List[Str]) -> List[Str] {
    let mut buckets = 16
    for (i, _) in keys.with_index() {
        if i + 1 > 2 * buckets {
            buckets = buckets * 2
        }
    }
    let n = keys.len()
    keys.with_index().sort_by(|p| (hash(p.1) % buckets, n - p.0)).map(|p| p.1)
}

// What Hashtbl.hash gives for a string: MurmurHash3's mixing of its bytes,
// four at a time, then of its length. A 32-bit word is an Int from 0 to
// 2^32 - 1, kept there with `& mask()`; Int arithmetic wraps at 64 bits,
// which keeps the low 32 bits of a product right.
pub fn hash(s: Str) -> Int {
    let bs = s.bytes()
    let mut h = 0
    let mut i = 0
    while i + 4 <= bs.len() {
        h = mix(h, bs[i] | bs[i + 1] << 8 | bs[i + 2] << 16 | bs[i + 3] << 24)
        i = i + 4
    }
    let left = bs.len() - i
    if left > 0 {
        let mut w = 0
        let mut k = left - 1
        while k >= 0 {
            w = w << 8 | bs[i + k]
            k = k - 1
        }
        h = mix(h, w)
    }
    h = h ^ bs.len()
    // the final mix
    h = h ^ h >> 16
    h = h * 2246822507 & mask()
    h = h ^ h >> 13
    h = h * 3266489909 & mask()
    h = h ^ h >> 16
    h & 1073741823
}

fn mask() -> Int {
    4294967295
}

fn mix(h: Int, d: Int) -> Int {
    let d = rotl(d * 3432918353 & mask(), 15) * 461845907 & mask()
    let h = rotl(h ^ d, 13)
    (h * 5 + 3864292196) & mask()
}

fn rotl(x: Int, n: Int) -> Int {
    (x << n | x >> (32 - n)) & mask()
}
