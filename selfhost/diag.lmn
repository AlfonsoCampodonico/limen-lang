// Diagnostics: what went wrong, where, and what to do about it, as the
// OCaml compiler's src/diag.ml has them. A span names its file by number;
// the loaded program's file table turns the number into a path.
use ast

pub struct Diag {
    code: Str,
    span: ast.Span,
    message: Str,
    notes: List[Str],
    // a warning is reported, but does not stop a program from building
    warning: Bool,
    fix: Option[Fix],
}

// A change that would solve the problem: what it does, and the edits.
pub struct Fix {
    message: Str,
    edits: List[Edit],
}

// Replace the text at `at` with `replacement`.
pub struct Edit {
    at: ast.Span,
    replacement: Str,
}

pub fn error(code: Str, span: ast.Span, message: Str) -> Diag {
    Diag { code, span, message, notes: [], warning: false, fix: None }
}

pub fn warning(code: Str, span: ast.Span, message: Str) -> Diag {
    { error(code, span, message) with warning: true }
}

pub fn note(self: Diag, text: Str) -> Diag {
    { self with notes: self.notes + [text] }
}

// The fix with one edit: replace `at` with `replacement`.
pub fn fix(self: Diag, message: Str, at: ast.Span, replacement: Str) -> Diag {
    { self with fix: Some(Fix { message, edits: [Edit { at, replacement }] }) }
}

// A file of the program: its path as the loader names it, and its text.
pub struct Source {
    path: Str,
    text: Str,
}

// The span OCaml calls Span.dummy, for a problem with no place in any
// file: file number -1, which the file table has no entry for.
pub fn nowhere() -> ast.Span {
    ast.Span { file: -1, lo: 0, hi: 0 }
}

// The path of file number `file`, or "" for nowhere.
pub fn path_of(files: List[Source], file: Int) -> Str {
    files.get(file).map(|s| s.path) ?? ""
}

// The line and column of offset `off` in file number `file`, counted as
// the OCaml compiler's Source.line_col counts them.
pub fn line_col(files: List[Source], file: Int, off: Int) -> (Int, Int) {
    let text = match files.get(file) {
        Some(s) => s.text,
        None => {
            return (1, off + 1)
        },
    }
    let mut line = 1
    let mut col = 1
    let bs = text.bytes()
    let n = off.min(bs.len())
    let mut i = 0
    while i < n {
        if bs[i] == 10 {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    (line, col)
}

fn line_text(files: List[Source], file: Int, line: Int) -> Str {
    match files.get(file) {
        Some(s) => s.text.split("\n").get(line - 1) ?? "",
        None => "",
    }
}

fn repeat(s: Str, n: Int) -> Str {
    (0..<n).map(|_| s).join("")
}

// The problem as `limen check` prints it: what and where, the line with
// the span underlined, then the notes and the fix.
pub fn render(self: Diag, files: List[Source]) -> Str {
    let mut b = "{if self.warning { "warning" } else { "error" }}[{self.code}]: {self.message}\n"
    let file = path_of(files, self.span.file)
    if file != "" {
        let (l, c) = line_col(files, self.span.file, self.span.lo)
        b = b + "  --> {file}:{l}:{c}\n"
        let text = line_text(files, self.span.file, l)
        let gutter = repeat(" ", "{l}".len())
        let (l2, c2) = line_col(files, self.span.file, self.span.hi)
        let width = if l2 == l { (c2 - c).max(1) } else { (text.len() - c + 1).max(1) }
        b = b + " {gutter} |\n {l} | {text}\n {gutter} | {repeat(" ", (c - 1).max(0))}{repeat("^", width)}\n"
    }
    for n in self.notes {
        b = b + "  = note: {n}\n"
    }
    match self.fix {
        Some(f) => {
            b = b + "  = help: {f.message}\n"
        },
        None => {},
    }
    b
}

// `s` as a JSON string, as the OCaml compiler's Diag.jstr writes it: the
// quote, the backslash, newline, return and tab escaped by name, any other
// byte under 0x20 as `\u00XX` in lower case, every other byte as it is.
pub fn jstr(s: Str) -> Str {
    let hex = "0123456789abcdef"
    let mut out: List[Str] = ["\""]
    let mut start = 0
    let bs = s.bytes()
    let mut i = 0
    while i < bs.len() {
        let b = bs[i]
        let esc = if b == 34 {
            "\\\""
        } else if b == 92 {
            "\\\\"
        } else if b == 10 {
            "\\n"
        } else if b == 13 {
            "\\r"
        } else if b == 9 {
            "\\t"
        } else if b < 32 {
            "\\u00" + hex.slice(b / 16, b / 16 + 1) + hex.slice(b % 16, b % 16 + 1)
        } else {
            ""
        }
        if esc != "" {
            out.push(s.slice(start, i))
            out.push(esc)
            start = i + 1
        }
        i = i + 1
    }
    out.push(s.slice(start, bs.len()))
    out.push("\"")
    out.join("")
}

fn jpos(files: List[Source], file: Int, off: Int) -> Str {
    let (l, c) = line_col(files, file, off)
    "\{\"line\":{l},\"col\":{c},\"offset\":{off}}"
}

fn jspan(files: List[Source], sp: ast.Span) -> Str {
    let file = jstr(path_of(files, sp.file))
    "\{\"file\":{file},\"start\":{jpos(files, sp.file, sp.lo)},\"end\":{jpos(files, sp.file, sp.hi)}}"
}

// The problem as `limen check --json` prints it, as Diag.to_json does.
pub fn to_json(self: Diag, files: List[Source]) -> Str {
    let fix = match self.fix {
        None => "null",
        Some(f) => {
            let edits = f.edits.map(|e| "\{\"span\":{jspan(files, e.at)},\"replacement\":{jstr(e.replacement)}}").join(",")
            "\{\"message\":{jstr(f.message)},\"edits\":[{edits}]}"
        },
    }
    let severity = if self.warning { "warning" } else { "error" }
    "\{\"code\":{jstr(self.code)},\"severity\":{jstr(severity)},\"message\":{jstr(self.message)},\"span\":{jspan(files, self.span)},\"notes\":[{self.notes.map(jstr).join(",")}],\"fix\":{fix},\"explain\":{jstr("limen explain " + self.code)}}"
}

pub fn list_to_json(ds: List[Diag], files: List[Source]) -> Str {
    "\{\"diagnostics\":[" + ds.map(|d| d.to_json(files)).join(",") + "]}"
}
