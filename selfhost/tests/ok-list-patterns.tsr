fn f(xs: List[Int], ws: List[Str]) -> Int {
    match xs {
        [] => 0,
        [x] => x,
        [first, ..] => first,
        [first, ..rest] => first + rest.len(),
        [.., last] => last,
        [..init, last] => last,
        [a, .., z] => a + z,
        [a, b, ..rest, y, z] => a,
        [..] => 0,
        [..all] => all.len(),
        [[1, 2], [_, ..]] => 1,
        [Some(1) | None, ..] => 2,
        [
            a,
            b,
        ] => a,
    }
    match ws {
        ["a", "b"] | ["c", ..] => 1,
        _ => 0,
    }
}
