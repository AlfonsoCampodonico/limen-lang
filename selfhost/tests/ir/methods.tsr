// Method calls the lowering treats one by one: variant constructors
// qualified by their enum, Option and Result helpers that become
// branches, `message` and `cause` reached through an `Error` bound,
// built-in methods (primitives, and those written in Tessera, compiled
// like the program's own), a file's own methods on built-in types,
// methods promoted from an embedded struct, and tasks whose results are
// not kept.
enum Shape {
    Circle(Float),
    Square(Float),
}

struct Problem {
    code: Int,
}

struct Named {
    name: Str,
}

struct Admin {
    Named,
    level: Int,
}

fn message(self: Problem) -> Str {
    "problem {self.code}"
}

fn hello(self: Named) -> Str {
    "hi {self.name}"
}

fn shout(self: Str) -> Str {
    self.to_upper() + "!"
}

fn explain[E: Error](e: E) -> Str {
    let why = match e.cause() {
        Some(c) => c.message(),
        None => "no cause",
    }
    e.message() + ": " + why
}

fn check(n: Int) -> Result[Int, Str] {
    if n > 0 { Ok(n) } else { Err("not positive") }
}

fn main(root: Root) {
    let out = root.stdout
    let shapes = [Shape.Circle(1.0), Shape.Square(2.0)]
    let o = Some(3)
    let none: Option[Int] = None
    let r = check(2)
    let doubled = o.map(|x| x * 2)
    let named = r.map_error(|e| e.len())
    out.print("{shapes.len()} {doubled} {named} {o.is_some()} {none.is_none()} {r.is_ok()} {check(0).is_err()}")
    out.print(explain(Problem { code: 4 }) + explain("text"))
    let xs = [3, 1, 2]
    out.print("{xs.sort()} {xs.reverse()} {xs.any(|x| x > 2)} {xs.find(|x| x < 2)} {xs.sum()} {xs.with_index().len()}")
    let m = map([("a", 1), ("b", 2)])
    out.print("{m.keys()} {m.map_values(|v| v * 10)} {m.contains("a")} {m.get("z")}")
    out.print("{(-4).abs()} {2.25.sqrt()} {true.to_str()} {"hey".shout()} {65.to_char()}")
    let a = Admin { Named: Named { name: "ana" }, level: 1 }
    out.print("{a.hello()} {a.name} {a.level}")
    let mut total = 0
    let _ = group g {
        g.go(|| {
            out.print("side effect")
        })
        g.go(|| {
            total
        })
    }
}
