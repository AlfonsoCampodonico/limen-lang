// Tests and benchmarks: `limen test` compiles them instead of `main`,
// with the root fields each takes, on virtual time for a test that asks
// for it, and table tests.
fn add(a: Int, b: Int) -> Int {
    a + b
}

fn main(root: Root) {
    root.stdout.print("{add(1, 2)}")
}

test "adds" {
    assert_eq(add(1, 2), 3)
}

test "files" (fs: Fs) {
    assert(fs.read("missing").is_err())
}

test "sleeps" (clock: virtual Clock) {
    let t = clock.now_ms()
    clock.sleep(100)
    assert(clock.now_ms() >= t + 100)
}

test "table" for (a, b, want) in [(1, 2, 3), (2, 2, 4)] {
    assert_eq(add(a, b), want)
}

bench "adding" {
    keep(add(1, 2))
}

bench "timed" (clock: Clock) {
    keep(clock.now_ms())
}
