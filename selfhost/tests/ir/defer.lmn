// `defer` in a function body, in nested blocks and in loops (break and
// continue leave it), with `return` and `?` leaving early, panics caught
// with `catch`, and `assert`, `assert_eq` and `panic`.
struct Log {
    lines: List[Str],
}

fn risky(n: Int) -> Int {
    if n > 2 {
        panic("too big: {n}")
    }
    n
}

fn guarded(out: Stdout, xs: List[Int]) -> Int {
    defer out.print("leaving")
    let mut total = 0
    for x in xs {
        defer out.print("item {x}")
        if x == 0 {
            continue
        }
        if x < 0 {
            break
        }
        total = total + x
    }
    if total > 10 {
        return total
    }
    total * 2
}

fn parse_all(out: Stdout, xs: List[Str]) -> Option[Int] {
    let mut sum = 0
    defer out.print("sum so far {sum}")
    for s in xs {
        let n = s.parse_int()?
        sum = sum + n
    }
    Some(sum)
}

fn value(out: Stdout) -> Int {
    let a = {
        defer out.print("inner")
        3
    }
    defer out.print("outer")
    a + 1
}

fn main(root: Root) {
    let out = root.stdout
    out.print("{guarded(out, [1, 0, 2, -1, 5])} {parse_all(out, ["1", "x"])} {value(out)}")
    let r = catch(|| risky(5))
    let s = catch {
        defer out.print("unwinding")
        risky(1)
    }
    out.print("{r} {s}")
    assert(1 < 2)
    assert_eq([1, 2], [1, 2])
    let log = Log { lines: [] }
    defer out.print("{log.lines.len()} lines")
    if log.lines.len() > 5 {
        panic("never")
    }
}
