// Foreign functions: what can cross to C (E0330), using one as a value
// (E0331), callbacks (E0332), and the Tessera type of a call: Foreign
// first, Out parameters returned after the result.
foreign "c" {
    struct Div { quot: Int32, rem: Int32 }
    struct Empty {}
    struct Many { a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int }
    struct Odd { name: Str, ok: Bool }
    fn div(a: Int32, b: Int32) -> Div
    fn strtol(s: Str, end: Out[Handle], base: Int32) -> Int
    fn two_outs(x: Int, a: Out[Int], b: Out[Float])
    fn frexp(x: Float, exp: Out[Int32]) -> Float
    fn printf(format: Str, ..., n: Int, s: Str) -> Int32
    fn snprintf(buf: Handle, size: Int, format: Str, ..., x: Float) -> Int32
    fn qsort(base: Handle, n: Int, size: Int, cmp: fn(Handle, Handle) -> Int32)
    fn each(f: fn(Foreign, Int) -> Int, n: Int)
    fn apply(f: fn(Int) -> Int, n: Int) -> Int
    fn atexit(f: fn() -> ())
    fn getenv(name: Str) -> Str
    fn noise()
}

foreign "bad lib" {
    fn bad_out(x: Out[Str], y: Out[Div2]) = "1bad"
    fn bad_types(xs: List[Int], m: Map[Str, Int], b: Bytes) -> Bytes
    fn bad_callback(f: fn(List[Int], Bytes) -> Str, g: fn(Int) -> List[Int], h: fn(Plain) -> ())
    fn bad_struct(p: Plain) -> Plain
    fn bad_result() -> fn() -> Int
    fn bad_result2() -> List[Int]
    fn too_many(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int)
    fn too_many_floats(a: Float, b: Float, c: Float, d: Float, e: Float, f: Float, g: Float, h: Float, i: Float)
    fn wide_callback(f: fn(Int, Int, Int, Int, Int, Int, Int, Int, Int) -> ())
    fn variadic_none(..., x: Int)
    fn variadic_float(x: Float, ..., d: Div)
    fn variadic_struct(x: Int, ...) -> Div
    fn variadic_out(x: Int, ..., o: Out[Int])
    fn variadic_many(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, ...)
    fn variadic_after(a: Int, ..., b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int, i: Int, j: Int)
}

foreign "tessera" {
    fn tessera_copy(p: Handle, n: Int) -> Bytes
    fn tessera_nothing(p: Handle)
    fn tessera_handle_new(p: Int) -> Int
}

foreign "c" {
    fn main()
}

struct Plain {
    x: Int,
}

fn compare(a: Handle, b: Handle) -> Int {
    0
}

fn twice(foreign: Foreign, n: Int) -> Int {
    n * 2
}

fn plain(n: Int) -> Int {
    n
}

fn generic[T](a: Handle, b: Handle) -> Int {
    0
}

fn bye() {}

fn calls(foreign: Foreign, h: Handle) {
    let d = div(foreign, 7, 2)
    let q = d.quot + d.rem
    let n = strtol(foreign, "12", 10)
    let (a, b) = two_outs(foreign, 1)
    let (m, e) = frexp(foreign, 2.0)
    let p = printf(foreign, "%d %s", 1, "x")
    qsort(foreign, h, 1, 8, compare)
    qsort(foreign, h, 1, 8, |x, y| 0)
    qsort(foreign, h, 1, 8, generic)
    let k = 1
    qsort(foreign, h, 1, 8, |x, y| k)
    each(foreign, twice, 3)
    each(foreign, plain, 3)
    // a callback that takes the call's Foreign first
    let t = apply(foreign, twice, 1) + apply(foreign, plain, 2)
    atexit(foreign, bye)
    let f = getenv
    let g = getenv(foreign, "HOME").len()
    noise()
    noise(foreign, 1)
    let named = getenv(foreign, name: "x")
    let s: Str = div(foreign, 1, 2)
}

fn no_foreign(h: Handle) {
    noise(h)
}
