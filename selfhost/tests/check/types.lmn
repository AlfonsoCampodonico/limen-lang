// Written types that do not exist or are written wrong.
struct Pair[A, B] {
    a: A,
    b: B,
}

enum Shape {
    Dot,
}

fn sizes(b: Array[Int], c: Array[Int, 2, 3]) {}

fn names(x: Stirng, y: List, z: Map[Str], w: Pair[Int], v: Int[Str]) {}

fn bounds(d: dyn Ordered, e: dyn Shapely, f: Error, g: dyn Error) {}

fn both[N](xs: Array[Int, N], y: N) {}

fn number(x: List[3]) {}

fn literal() {
    let s = Shape { x: 1 }
    let t = Shap { x: 1 }
    let ok: Array[Int, 2] = [1, 2]
    let short: Array[Int, 3] = [1, 2]
}

fn sum[N](xs: Array[Int, N]) -> Int {
    xs[0]
}

fn main(root: Root) {
    let n = sum([1, 2, 3])
    let m: Pair[Int, Str] = Pair { a: 1, b: "x" }
}
