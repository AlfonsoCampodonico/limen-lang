// Statements and control flow: `if` without `else`, loops, `defer`,
// `group`, `?` in its many wrong places, assignments, mutability.
struct P {
    x: Int,
}

fn no_else(c: Bool) -> Int {
    if c { 1 }
    2
}

fn loops() {
    break
    continue
    for c in "abc" {}
    for n in 5 {}
    while 1 {}
}

fn deferred() -> Option[Int] {
    for i in [1] {
        defer break
    }
    defer return
    defer {
        let v = Some(1)?
    }
    None
}

fn tasks() -> Option[Int] {
    let r = group g {
        g.go(|| 1)
        return None
    }
    let s = group g {
        g.go(|| Some(1)?)
        let x = Some(2)?
    }
    let t = group g {
        let f = || g.go(|| 1)
        g.go(1, 2)
        g.spawn(|| 1)
        g = 3
    }
    None
}

fn tries() -> Int {
    let a = Some(1)?
    3
}

fn tries2() -> Result[Int, Str] {
    let r: Result[Int, Int] = Ok(1)
    let a = r?
    let b = Some(1)?
    let c = 5?
    let d = r? "context"
    Ok(1)
}

fn tries3(fs: Fs) -> Result[Int, dyn Error] {
    let t = fs.read("x")?
    let u = fs.read("y")? "reading {t}"
    let v = Some(1)? "missing"
    Ok(1)
}

fn tries5() -> Result[Int, dyn Error] {
    let r: Result[Int, Int] = Ok(1)
    let a = r?
    Ok(a)
}

fn tries4() -> Option[Int] {
    let r: Result[Int, Str] = Ok(1)
    let a = r?
    Some(1)
}

fn assigns(param: Int) {
    let x = 1
    x = 2
    param = 3
    let mut ys = [1]
    for y in ys {
        y = 1
    }
    let f = || {
        ys = []
        1
    }
    let p = P { x: 1 }
    p.x = 3
    5 = 4
    nope = 1
    let bs = bytes([1])
    let mut cs = bytes([1])
    cs[0] = 2
    let (q, w) = (1, 2)
    let mut aa = 0
    let mut bb = 0
    (aa, bb) = 5
    (aa, bb) = (1, 2, 3)
}

fn exprs() {
    let f = || 1
    let s = "{f}"
    let n = -"x"
    let i = 5[0]
    let m = map()
    let k = m[1]
    let j = [1]["x"]
    let e = 5 ?? 1
    let g = Some(1)?.len()
    let h = 5?.len()
    let r: Result[Int, Str] = Ok(1)
    let rr = r?.len()
    let ok = Some("x")?.len()
    let flat = Some("x")?.index_of("y")
    let bad = 1 + "x"
    let worse = true - false
    let m2 = 1.5 % 2.0
    let lt = f < f
    let eq = f == f
    let and = 1 && true
    let range = "a"..<3
    let u = || x_unknown.len()
}

fn unknown_types() {
    let a = |x| x.len()
    let b = |x| x.y
    let c = |x| x ?? 1
    let d = |x| { x with a: 1 }
    let e = |o| o?.a
