// E0214: an index of a `mut` place assigning a variable that another index
// of the same place reads; the same index reading it is fine
fn put(mut x: Int, v: Int) {
    x = v
}

fn main(root: Root) {
    let mut ys = [[0, 0], [0, 0]]
    let mut j = 1
    put(mut ys[j][{
        j = 0
        0
    }], 5)
    put(mut ys[0][{
        j = 1
        j
    }], 6)
    ys[j][{
        j = 0
        0
    }] = 7
    root.stdout.print("{ys} {j}")
}
