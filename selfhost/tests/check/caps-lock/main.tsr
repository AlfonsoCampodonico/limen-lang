// Trusted dependencies whose C libraries differ from what tessera.lock
// recorded (E0324), in the order the checks find them, and one that
// matches (the same libraries in another order).
use cl
use same
use two

fn main(root: Root) {
    let a = cl.deflate(root.foreign, 1) + cl.sqrt(root.foreign, 2)
    let b = same.puts(root.foreign, "x") + same.cos(root.foreign, 1)
    let c = two.ask(root.foreign)
}
