// `select` arms and group deadlines.
fn main(root: Root) {
    let c: Chan[Int] = channel(1)
    let clock = root.clock
    select {
        _ => 1,
        _ => 2,
    }
    select {
        v = c.recv() => 1,
        clock.after(10) => 2,
        _ => 3,
    }
    select {
        v = 5.recv() => 1,
        c.send("x") => 2,
        root.after(1) => 3,
    }
    let r = select {
        v = c.recv() => v ?? 0,
        c.send(1) => 0,
    }
    let xs = group g until 5.after(10) {
        g.go(|| 1)
    }
    let ys = group g until clock.after("x") {
        g.go(|| 1)
    }
}
