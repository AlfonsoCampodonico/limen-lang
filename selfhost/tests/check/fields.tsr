// Fields: missing, unknown, set twice; Root's fields; methods used as
// values; copies with `with`.
struct Point {
    x: Int,
    y: Int,
}

fn norm(self: Point) -> Int {
    self.x + self.y
}

fn twice(self: Point, k: Int, label: Str) -> Point {
    { self with x: self.x * k }
}

fn main(root: Root) {
    let p = Point { x: 1, z: 2, x: 3 }
    let q = Point { x: 1 }
    let a = p.xx
    let b = p.norm
    let c = p.twice
    let d = c(2, "two")
    let e = root.stdot
    let f = root.args
    let mut xs = [1, 2]
    let g = xs.push
    let h = xs.len
    let i = { p with x: 5, w: 1, x: 2 }
    let j = { 3 with x: 1 }
    let k = (1, 2).0
    let l = "s".len
    let m = 5.nothing
    p.norm = 3
}
