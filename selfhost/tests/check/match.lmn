// Matches: arms missing (with the fix that adds them, on their own lines
// or not), arms that can never match, or-patterns that bind differently,
// patterns of the wrong shape.
enum Shape {
    Circle(Float),
    Rect(Float, Float),
    Dot,
}

enum Tree {
    Leaf,
    Node(Tree, Int, Tree),
}

enum Wrap {
    One(Option[Bool]),
}

fn area(s: Shape) -> Float {
    match s {
        Circle(r) => r,
    }
}

fn same_line(b: Bool) -> Int {
    match b {
        true => 1,
    }
}

fn lists(xs: List[Int]) -> Int {
    match xs {
        [] => 0,
        [a] => a,
        [a, b, ..] if a > b => a,
    }
}

fn tuples(t: (Bool, Bool)) -> Int {
    match t {
        (true, _) => 1,
        (_, true) => 2,
    }
}

fn nested(w: Wrap) -> Int {
    match w {
        One(Some(true)) => 1,
    }
}

fn trees(t: Tree) -> Int {
    match t {
        Leaf => 0,
    }
}

fn ints(n: Int) -> Int {
    match n {
        1 => 1,
        2 => 2,
    }
}

fn unreachable(s: Shape) -> Float {
    match s {
        _ => 0.0,
        Dot => 1.0,
    }
}

fn alternatives(s: Shape) -> Float {
    match s {
        Circle(r) => r,
        Dot | Circle(_) => 0.0,
        Rect(w, _) => w,
    }
}

fn binds(s: Shape) -> Float {
    match s {
        Circle(r) | Dot => 1.0,
        Rect(w, h) | Circle(h) => h,
        Dot | Circle(z) => 2.0,
        _ => 0.0,
    }
}

fn types_differ(x: (Int, Str)) -> Int {
    match x {
        (a, _) | (_, a) => 1,
    }
}

fn shapes(s: Shape, n: Int) -> Int {
    match s {
        Circle(a, b) => 1,
        Rect(..) => 2,
        Rect(a, b, c, ..) => 3,
        Shape.Squ => 4,
        Sape.Dot => 5,
        Squar => 6,
        _ => 7,
    }
}

fn tuple_rest(t: (Int, Int)) -> Int {
    match t {
        (a, b, c, ..) => a,
        (a, ..) => a,
    }
}

fn not_tuple(n: Int) -> Int {
    match n {
        (a, ..) => a,
        _ => 0,
    }
}

fn empty(n: Int) -> Int {
    match n {
    }
}

fn unknown_rest() {
    let f = |t| match t {
        (a, ..) => 1,
    }
}

fn wrong_type(n: Int) -> Int {
    match n {
        "x" => 1,
        Some(x) => 2,
        _ => 3,
    }
}

fn list_rest(xs: List[Int]) -> Int {
    match xs {
        [a, ..rest] => rest.len(),
        [] => 0,
        [_] => 9,
    }
}

struct Point {
    x: Int,
    y: Int,
}

struct Pair[T] {
    left: T,
    right: T,
}

// struct patterns: missing fields, unknown and repeated fields, an enum
// or an unknown name, wrong types, and what they cover
fn struct_patterns(p: Point, q: Pair[Bool], o: Option[Point]) -> Int {
    let a = match p {
        Point { x } => x,
        Point { x, z: 1, x: 2, .. } => x,
        Pointt { x, .. } => 1,
        Shape { .. } => 2,
        Point { x: "s", .. } => 3,
    }
    let b = match p {
        Point { x: 0, .. } => 1,
        Point { y: 1, .. } => 2,
    }
    let c = match q {
        Pair { left: true, right } => 1,
        Pair { left: false, right: true } => 2,
    }
    let d = match q {
        Pair { left: true, .. } | Pair { right: true, .. } => 1,
        Pair { left: false, right: false } => 2,
        Pair { .. } => 3,
    }
    let e = match o {
        Some(Point { x: 1, .. }) => 1,
        None => 0,
    }
    let g = match (p, q) {
        (Point { x: 0, .. }, Pair { left: true, .. }) => 1,
        (Point { .. }, _) => 2,
        (_, Pair { left, right }) => 3,
    }
    a + b + c + d + e + g
}

// as-patterns: the whole value with its parts, in every alternative, and
// what they cover
fn as_patterns(o: Option[Point], xs: List[Int]) -> Int {
    let a = match o {
        Some(Point { x, .. } as p) if x > 0 => p.y,
        Some(_) as s => 1,
        None as n => 0,
    }
    let b = match xs {
        [first, ..] as all => first + all.len(),
        [] as none => none.len(),
        _ => 9,
    }
    let c = match o {
        Some(Point { x: 0, .. }) | None as which => 1,
        Some(p as q) => q.x,
    }
    let d: Str = match o {
        Some(p) as whole => whole,
        None => "",
    }
    a + b + c
}

fn main(root: Root) {}
