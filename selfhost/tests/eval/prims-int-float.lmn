// Every built-in method of Int, Float, Bool and the unsigned types.
fn main(root: Root) {
    let out = root.stdout
    let n = -42
    out.print("{n.to_str()} {n.to_float()} {n.abs()} {65.to_char()} {233.to_char()} {n.min(3)} {n.max(3)}")
    out.print("{n.shift_right_unsigned(60)} {n.to_uint8()} {n.to_uint16()} {n.to_uint32()} {n.to_uint64()}")
    let u = 200.to_uint8()
    let v = 100.to_uint8()
    out.print("{u + v} {v - u} {u * v} {u / v} {u % v} {u & v} {u | v} {u ^ v} {u << 1.to_uint8()} {u >> 3.to_uint8()} {u << 9.to_uint8()}")
    out.print("{u < v} {u > v} {u == v} {u.to_int()} {u.to_str()} {u.to_float()} {u.min(v)} {u.max(v)}")
    out.print("{u.rotate_left(3)} {u.rotate_right(3)} {u.to_uint16()} {u.to_uint32()} {u.to_uint64()}")
    let w = (0 - 1).to_uint64()
    let one = 1.to_uint64()
    out.print("{w} {w + one} {w / 3.to_uint64()} {w > one} {w.to_int()} {w.to_float()} {w.rotate_left(4)} {w.to_uint8()}")
    let h = 65535.to_uint16()
    let q = 4000000000.to_uint32()
    out.print("{h + 1.to_uint16()} {h.rotate_right(4)} {q * 2.to_uint32()} {q.to_int()}")
    let x = -2.75
    out.print("{x.to_str()} {x.to_int()} {x.abs()} {x.sqrt()} {16.0.sqrt()} {x.to_fixed(1)} {x.to_fixed(0)} {3.14159.to_fixed(3)}")
    out.print("{1e300.to_int()} {(0.0 / 0.0).to_int()} {true.to_str()} {false.to_str()}")
    for k in [-1, 3] {
        match catch(|| 5 << k) {
            Ok(v) => out.print("ok {v}"),
            Err(m) => out.print("panic: {m}"),
        }
    }
    match catch(|| 5.shift_right_unsigned(-1)) {
        Ok(v) => out.print("ok {v}"),
        Err(m) => out.print("panic: {m}"),
    }
    match catch(|| (-1).to_char()) {
        Ok(v) => out.print("ok {v}"),
        Err(m) => out.print("panic: {m}"),
    }
    match catch(|| u / 0.to_uint8()) {
        Ok(v) => out.print("ok {v}"),
        Err(m) => out.print("panic: {m}"),
    }
    out.print("{7 % 0}")
}
