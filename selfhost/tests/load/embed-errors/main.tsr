// every way an embed can fail, in order
fn main() {
    let name = "page.html"
    let a = embed(name)
    let b = embed("a", "b")
    let c = embed_dir()
    let d = embed("/etc/hosts")
    let e = embed("")
    let f = embed("nothing.txt")
    let g = embed("../embeds/main.tsr")
    let h = embed("data")
    let i = embed_dir("data/text.txt")
    let j = embed_dir("dots")
    let k = embed("data/bad.bin")
    let l = embed_bytes("data/bad.bin")
    let m = embed_dir("..")
    let n = embed(".")
    let o = embed("data/{name}")
    let p = embed_dir("nowhere")
}
