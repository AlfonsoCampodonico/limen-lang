// Function types: with a result, and without one (the result is `()`).
fn apply(f: fn(Int) -> Int, g: fn(Int), h: fn(), k: fn() -> ()) -> fn(Str) {
    g(f(1))
    h()
    k()
    |s| {}
}

fn nested(f: fn(fn(Int)) -> fn()) {}

