// What the type checker works with: the program's declarations (`Cx`),
// what it has learned so far (`State`), the function being checked
// (`Fx`), and the steps everything shares: reporting a problem, finding a
// name to suggest, turning a written type into a type.
//
// The OCaml checker writes what it learns into the tree: each
// expression's type and type arguments, and new forms for the expressions
// it rewrites (`x.m()` into `T::m(x)`, a call with named arguments into
// one in parameter order, ...). Here the tree stays as the parser and the
// loader made it, and those go into maps keyed by expression id in the
// State. A rewrite is recorded as the expression's new `desc`; the
// expressions inside it are the same ones (same ids), so rebuilding the
// tree from the rewrites at the end gives what OCaml's in-place writes
// give, however the rewrites nest.
use ast
use builtins
use diag
use ocamlhash
use types

// A function's type parameters, parameter types and result.
pub struct Sig {
    gen: List[Str],
    params: List[types.Ty],
    ret: types.Ty,
}

// A bound on a type parameter: an interface and its type arguments,
// `Container[Int]`.
pub struct Bound {
    iface: Str,
    args: List[types.Ty],
}

// An interface's method: its parameter types (without `self`) and result.
pub struct IfaceMethod {
    name: Str,
    params: List[types.Ty],
    ret: types.Ty,
}

// A type parameter's bounds.
pub struct Bounds {
    param: Str,
    bounds: List[Bound],
}

// The program's declarations, known before any body is checked. The maps
// list their keys in the order OCaml's tables got them, which suggestions
// need (selfhost/ocamlhash.tsr).
pub struct Cx {
    structs: Map[Str, ast.StructDecl],
    enums: Map[Str, ast.EnumDecl],
    // field types, with the struct's type parameters as TParam
    sfields: Map[Str, List[(Str, types.Ty)]],
    variants: Map[Str, List[(Str, List[types.Ty])]],
    // variant -> the enums that define it
    owners: Map[Str, List[Str]],
    fns: Map[Str, Sig],
    // parameter names, for named arguments: functions and methods (keyed
    // like `fns`, `self` included) and interface methods (`Iface::m`)
    param_names: Map[Str, List[Str]],
    // `Type::name` -> whether it is pub, and its file
    method_owner: Map[Str, (Bool, Int)],
    foreign_fns: Map[Str, Bool],
    ifaces: Map[Str, List[IfaceMethod]],
    iface_gen: Map[Str, List[Str]],
    // struct and enum bounds: their type parameters, and each one's bounds
    type_bounds: Map[Str, (List[Str], List[Bounds])],
    // a generic function's declared bounds, and all its bounds as seen
    // inside it (declared and implied by its parameter types)
    fn_bounds: Map[Str, List[Bounds]],
    fn_cur_bounds: Map[Str, List[Bounds]],
    // a function's type parameters that stand for array lengths (true) or
    // types (false)
    fn_kinds: Map[Str, List[(Str, Bool)]],
    // the methods struct embedding added
    forwarders: List[Str],
    // the methods by their `Type::name` part: `Str::shout` -> `Str::shout`
    // and `text.Str::shout`, so finding a method a file added to a
    // built-in type is a lookup
    by_suffix: Map[Str, List[Str]],
    // the files, by the numbers spans give them
    files: List[diag.Source],
    prelude_file: Int,
    methods_file: Int,
    // the built-in methods written in Tessera, by type: `List` -> any, all, ...
    builtin_names: Map[Str, List[Str]],
}

pub fn empty_cx(files: List[diag.Source], prelude_file: Int, methods_file: Int, forwarders: List[Str]) -> Cx {
    Cx {
        structs: map(),
        enums: map(),
        sfields: map(),
        variants: map(),
        owners: map(),
        fns: map(),
        param_names: map(),
        method_owner: map(),
        foreign_fns: map(),
        ifaces: map(),
        iface_gen: map(),
        type_bounds: map(),
        fn_bounds: map(),
        fn_cur_bounds: map(),
        fn_kinds: map(),
        forwarders,
        by_suffix: map(),
        files,
        prelude_file,
        methods_file,
        builtin_names: map(),
    }
}

pub fn text_of(self: Cx, file: Int) -> Str {
    self.files.get(file).map(|f| f.text) ?? ""
}

pub fn path_of(self: Cx, file: Int) -> Str {
    diag.path_of(self.files, file)
}

// The names of the Tessera-written built-in methods of type `tn`.
pub fn builtin_methods(self: Cx, tn: Str) -> List[Str] {
    self.builtin_names.get(tn) ?? []
}

// A bound to check once the function's types are known: where, the type
// used, the bound, and the type parameter it is for.
pub struct Pending {
    span: ast.Span,
    ty: types.Ty,
    bound: Bound,
    param: Str,
}

// What the checker has learned so far.
pub struct State {
    subst: types.Subst,
    // the problems, in the order they were found
    diags: List[diag.Diag],
    // each expression's type, by id
    types: Map[Int, types.Ty],
    // for a use of a generic function, its type arguments
    insts: Map[Int, List[(Str, types.Ty)]],
    // the expressions the checker rewrote, with their new form
    rewrites: Map[Int, ast.ExprDesc],
    // `a?.b` whose rest is an Option already, so it is not wrapped again
    nested: Map[Int, Bool],
    // the id the next expression the checker makes gets
    next_id: Int,
    // how many `$argN` temporaries keeping argument order have been named
    temps: Int,
    // checking the name a call calls: a foreign function may be used there
    calling: Bool,
    // the Tessera-written built-in methods the program calls
    used: Map[Str, Bool],
    // the key types of maps made in the function being checked
    map_keys: List[(ast.Span, types.Ty)],
    // values compared by a built-in method or standard library function in
    // the function being checked, with the method's name: they must not
    // hold authority, as with `==`
    compared: List[(ast.Span, types.Ty, Str)],
    // bounds to check when the function's types are known
    pending: List[Pending],
    // bounds of generic interfaces at calls, whose arguments are inferred
    // from the type's methods as soon as the type is known
    to_infer: List[(types.Ty, Bound)],
    // the bounds of the type parameters of the function being checked
    bounds: List[Bounds],
    // the type parameters of the declaration being resolved used as an
    // array's length (true) or as a type (false)
    kinds: Map[Str, Bool],
}

pub fn start(next_id: Int) -> State {
    State {
        subst: types.empty(),
        diags: [],
        types: map(),
        insts: map(),
        rewrites: map(),
        nested: map(),
        next_id,
        temps: 0,
        calling: false,
        used: map(),
        map_keys: [],
        compared: [],
        pending: [],
        to_infer: [],
        bounds: [],
        kinds: map(),
    }
}

// ---------- the substitution ----------

pub fn fresh(self: State) -> (types.Ty, State) {
    let (t, s) = self.subst.fresh()
    (t, { self with subst: s })
}

pub fn fresh_list(self: State, n: Int) -> (List[types.Ty], State) {
    let mut st = self
    let mut ts: List[types.Ty] = []
    for _ in 0..<n {
        let (t, next) = st.fresh()
        ts.push(t)
        st = next
    }
    (ts, st)
}

pub fn repr(self: State, t: types.Ty) -> types.Ty {
    self.subst.repr(t)
}

pub fn show(self: State, t: types.Ty) -> Str {
    self.subst.show(t)
}

pub fn subst(self: State, env: List[(Str, types.Ty)], t: types.Ty) -> types.Ty {
    self.subst.subst(env, t)
}

pub fn unify(self: State, a: types.Ty, b: types.Ty) -> (Bool, State) {
    let (ok, s) = self.subst.unify(a, b)
    (ok, { self with subst: s })
}

// Unify, reporting E0201 at `span` when the types differ.
pub fn unify_at(self: State, span: ast.Span, want: types.Ty, got: types.Ty) -> State {
    let (ok, st) = self.unify(want, got)
    if ok {
        return st
    }
    st.report(diag.error("E0201", span, "expected `{st.show(want)}`, found `{st.show(got)}`"))
}

// ---------- what is known of expressions ----------

pub fn set_type(self: State, e: ast.Expr, t: types.Ty) -> State {
    let mut st = self
    st.types[e.id] = t
    st
}

// The type recorded for `e`; TErr (shown `?`) if it was never checked,
// which is what an OCaml expression's type starts as.
pub fn type_of(self: State, e: ast.Expr) -> types.Ty {
    self.types.get(e.id) ?? TErr
}

pub fn set_inst(self: State, e: ast.Expr, env: List[(Str, types.Ty)]) -> State {
    let mut st = self
    st.insts[e.id] = env
    st
}

pub fn inst_of(self: State, e: ast.Expr) -> List[(Str, types.Ty)] {
    self.insts.get(e.id) ?? []
}

// Give `e` a new form.
pub fn rewrite(self: State, e: ast.Expr, desc: ast.ExprDesc) -> State {
    let mut st = self
    st.rewrites[e.id] = desc
    st
}

// `e`'s form now: rewritten or as written.
pub fn desc(self: State, e: ast.Expr) -> ast.ExprDesc {
    self.rewrites.get(e.id) ?? e.desc
}

// A new expression, with the next id.
pub fn node(self: State, desc: ast.ExprDesc, span: ast.Span) -> (ast.Expr, State) {
    (ast.Expr { desc, span, id: self.next_id }, { self with next_id: self.next_id + 1 })
}

// ---------- problems ----------

pub fn report(self: State, d: diag.Diag) -> State {
    let mut st = self
    st.diags.push(d)
    st
}

pub fn error_count(self: State) -> Int {
    self.diags.count(|d| !d.warning)
}

pub fn plural(n: Int) -> Str {
    if n == 1 { "" } else { "s" }
}

pub fn was_were(n: Int) -> Str {
    if n == 1 { "was" } else { "were" }
}

// Edit distance, in bytes.
fn lev(a: Str, b: Str) -> Int {
    let x = a.bytes()
    let y = b.bytes()
    let mut prev = (0..<y.len() + 1).map(|j| j)
    for i in 1..<x.len() + 1 {
        let mut row = [i]
        for j in 1..<y.len() + 1 {
            let cost = if x[i - 1] == y[j - 1] { 0 } else { 1 }
            row.push((prev[j] + 1).min(row[j - 1] + 1).min(prev[j - 1] + cost))
        }
        prev = row
    }
    prev[y.len()]
}

// The candidate closest to `name`, if one is close enough; of two equally
// close, the first.
pub fn suggest(name: Str, cands: List[Str]) -> Option[Str] {
    let limit = if name.len() <= 3 { 1 } else { 2.max(name.len() / 3) }
    let mut best: Option[(Str, Int)] = None
    for c in cands {
        if c == name {
            continue
        }
        let d = lev(name, c)
        let closer = match best {
            Some((_, bd)) => d < bd,
            None => true,
        }
        if closer && d <= limit {
            best = Some((c, d))
        }
    }
    best.map(|b| b.0)
}

// Report `d`, with a fix that puts in the candidate closest to `name`.
pub fn did_you_mean(self: State, d: diag.Diag, name: Str, cands: List[Str]) -> State {
    match suggest(name, cands) {
        Some(s) => self.report(d.fix("did you mean `{s}`?", d.span, s)),
        None => self.report(d),
    }
}

// The keys of a map in the order OCaml's hash table of them lists them.
pub fn keys_in_order[V](m: Map[Str, V]) -> List[Str] {
    ocamlhash.order(m.keys())
}

// ---------- written types ----------

// Records whether type parameter `g` stands for an array length or a
// type; one cannot be both.
pub fn param_kind(self: State, g: Str, len: Bool, span: ast.Span) -> State {
    match self.kinds.get(g) {
        Some(k) if k != len => {
            let d = diag.error("E0102", span, "`{g}` is used both as a type and as an array length").note("a type parameter in an array's size stands for a length, as in `fn sum[N](xs: Array[Int, N])`; use another parameter for the type")
            self.report(d)
        },
        Some(_) => self,
        None => {
            let mut st = self
            st.kinds[g] = len
            st
        },
    }
}

// A use of struct or enum `n` with these type arguments: its bounds apply.
pub fn add_type_bounds(self: State, cx: Cx, n: Str, args: List[types.Ty], span: ast.Span) -> State {
    match cx.type_bounds.get(n) {
        Some((gen, bs)) if gen.len() == args.len() => {
            let env = gen.zip(args)
            let mut st = self
            for b in bs {
                let t = env.find(|p| p.0 == b.param).map(|p| p.1) ?? TErr
                for bound in b.bounds {
                    let pending = Pending { span, ty: t, bound: st.subst_bound(env, bound), param: b.param }
                    st.pending = [pending] + st.pending
                }
            }
            st
        },
        _ => self,
    }
}

pub fn subst_bound(self: State, env: List[(Str, types.Ty)], b: Bound) -> Bound {
    { b with args: b.args.map(|a| self.subst(env, a)) }
}

pub fn show_bound(self: State, b: Bound) -> Str {
    if b.args.is_empty() { b.iface } else { b.iface + "[" + b.args.map(|a| self.show(a)).join(", ") + "]" }
}

fn lookup_env(env: List[(Str, types.Ty)], n: Str) -> Option[types.Ty] {
    env.find(|p| p.0 == n).map(|p| p.1)
}

// The type a written type stands for, `env` giving the type parameters in
// scope. A type that does not exist is reported, and is TErr.
pub fn resolve(self: State, cx: Cx, env: List[(Str, types.Ty)], te: ast.TyExpr) -> (types.Ty, State) {
    let mut st = self
    match te.desc {
        TyUnit => (TUnit, st),
        TyFn(ps, r) => {
            // OCaml builds TFn(ps, r) from its arguments last to first
            let (rt, next) = st.resolve(cx, env, r)
            st = next
            let mut pts: List[types.Ty] = []
            for p in ps {
                let (t, next) = st.resolve(cx, env, p)
                pts.push(t)
                st = next
            }
            (TFn(pts, rt), st)
        },
        TyInt(_) => (TErr, st.report(diag.error("E0102", te.span, "a number is only allowed as the size of an `Array`, as in `Array[Int, 3]`"))),
        TyName("Array", [elt, size]) => match size.desc {
            TyInt(n) => {
                if n < 0 {
                    return (TErr, st.report(diag.error("E0102", te.span, "an array size cannot be negative")))
                }
                let (et, st) = st.resolve(cx, env, elt)
                (TArray(et, TLen(n)), st)
            },
            // generic over the length: `fn sum[N](xs: Array[Int, N])`
            TyName(g, []) if lookup_env(env, g).is_some() => {
                st = st.param_kind(g, true, size.span)
                let (et, st) = st.resolve(cx, env, elt)
                (TArray(et, lookup_env(env, g) ?? TErr), st)
            },
            _ => (TErr, st.array_arity(te)),
        },
        TyName("Array", _) => (TErr, st.array_arity(te)),
        TyName("dyn", [target]) => match target.desc {
            TyName(i, _) if builtins.bounds().contains(i) => {
                let d = diag.error("E0102", target.span, "`{i}` is a built-in bound, not an interface with methods; it cannot be `dyn`").note("use it on a type parameter: `fn f[T: {i}](x: T)`")
                (TErr, st.report(d))
            },
            TyName(i, args) => {
                if cx.ifaces.contains(i) {
                    let (got, st) = st.bound_args(cx, env, i, args, target.span)
                    return (got.map(|a| TDyn(i, a)) ?? TErr, st)
                }
                (TErr, st.did_you_mean(diag.error("E0102", target.span, "unknown interface `{i}`"), i, keys_in_order(cx.ifaces)))
            },
            _ => st.resolve_named(cx, env, te, "dyn", [target]),
        },
        TyName(n, args) => st.resolve_named(cx, env, te, n, args),
    }
}

fn array_arity(self: State, te: ast.TyExpr) -> State {
    let d = diag.error("E0109", te.span, "`Array` takes an element type and a size, as in `Array[Float, 4]`").note("the size is a number, or a type parameter that stands for one: `fn sum[N](xs: Array[Int, N])`")
    self.report(d)
}

// Whether `te`, which names a type, is written with `k` type arguments;
// reported if not.
fn arity(self: State, te: ast.TyExpr, n: Str, given: Int, k: Int) -> (Bool, State) {
    if given == k {
        return (true, self)
    }
    (false, self.report(diag.error("E0109", te.span, "`{n}` takes {k} type argument{plural(k)}, found {given}")))
}

// A type written as a name with arguments, `n[args]`.
fn resolve_named(self: State, cx: Cx, env: List[(Str, types.Ty)], te: ast.TyExpr, n: Str, args: List[ast.TyExpr]) -> (types.Ty, State) {
    let mut st = self
    let mut targs: List[types.Ty] = []
    for a in args {
        let (t, next) = st.resolve(cx, env, a)
        targs.push(t)
        st = next
    }
    let given = args.len()
    // a type with no arguments
    let simple = |st: State, t: types.Ty| {
        let (ok, st) = st.arity(te, n, given, 0)
        (if ok { t } else { TErr }, st)
    }
    match n {
        "Int" => simple(st, TInt),
        "Float" => simple(st, TFloat),
        "Bool" => simple(st, TBool),
        "Str" => simple(st, TStr),
        "Bytes" => simple(st, TBytes),
        "List" => {
            let (ok, st) = st.arity(te, n, given, 1)
            (if ok { TList(targs[0]) } else { TErr }, st)
        },
        "Chan" => {
            let (ok, st) = st.arity(te, n, given, 1)
            (if ok { TChan(targs[0]) } else { TErr }, st)
        },
        "Map" => {
            let (ok, st) = st.arity(te, n, given, 2)
            (if ok { TMap(targs[0], targs[1]) } else { TErr }, st)
        },
        _ if builtins.cap_names().contains(n) => simple(st, TCap(n)),
        _ => match lookup_env(env, n) {
            Some(t) => simple(st.param_kind(n, false, te.span), t),
            None => {
                let gen = match cx.structs.get(n) {
                    Some(s) => Some(s.generics),
                    None => cx.enums.get(n).map(|e| e.generics),
                }
                match gen {
                    Some(g) => {
                        let (ok, st) = st.arity(te, n, given, g.len())
                        if !ok {
                            return (TErr, st)
                        }
                        (TNamed(n, targs), st.add_type_bounds(cx, n, targs, te.span))
                    },
                    None => {
                        if cx.ifaces.contains(n) {
                            let d = diag.error("E0102", te.span, "`{n}` is an interface, not a type").note(iface_note(cx, n))
                            return (TErr, st.report(d))
                        }
                        let cands = builtins.type_names() + keys_in_order(cx.structs) + keys_in_order(cx.enums) + env.map(|p| p.0)
                        (TErr, st.did_you_mean(diag.error("E0102", te.span, "unknown type `{n}`"), n, cands))
                    },
                }
            },
        },
    }
}

fn iface_note(cx: Cx, n: Str) -> Str {
    let gs = cx.iface_gen.get(n) ?? []
    if gs.is_empty() {
        return "take a type parameter bounded by it: `fn f[T: {n}](x: T)`"
    }
    let all = gs.join(", ")
    "take a type parameter bounded by it: `fn f[C: {n}[{all}], {all}](x: C)`"
}

// The type arguments of interface `i`, written `args`: exactly as many as
// it has parameters.
pub fn bound_args(self: State, cx: Cx, env: List[(Str, types.Ty)], i: Str, args: List[ast.TyExpr], span: ast.Span) -> (Option[List[types.Ty]], State) {
    let gs = cx.iface_gen.get(i) ?? []
    if gs.len() == args.len() {
        let mut st = self
        let mut ts: List[types.Ty] = []
        for a in args {
            let (t, next) = st.resolve(cx, env, a)
            ts.push(t)
            st = next
        }
        return (Some(ts), st)
    }
    let k = gs.len()
    let how = if k == 0 { "write it without arguments: `{i}`" } else { "write it with its type argument{plural(k)}: `{i}[{gs.join(", ")}]`" }
    let d = diag.error("E0109", span, "interface `{i}` takes {k} type argument{plural(k)}, found {args.len()}").note(how)
    (None, self.report(d))
}

// A bound on a type parameter: `Shape`, `Ordered`, `Container[Int]`.
pub fn resolve_bound(self: State, cx: Cx, env: List[(Str, types.Ty)], b: ast.TyExpr) -> (Option[Bound], State) {
    match b.desc {
        TyName(i, args) if cx.ifaces.contains(i) => {
            let (got, st) = self.bound_args(cx, env, i, args, b.span)
            (got.map(|a| Bound { iface: i, args: a }), st)
        },
        TyName(i, _) => (None, self.did_you_mean(diag.error("E0102", b.span, "unknown interface `{i}`"), i, keys_in_order(cx.ifaces))),
        _ => (None, self.report(diag.error("E0102", b.span, "a bound is an interface"))),
    }
}

// Channels and functions cannot hide in a struct or enum; capabilities
// can, and the types holding them are tracked (types.with_authority).
pub fn check_storable(self: State, span: ast.Span, t: types.Ty) -> State {
    if self.subst.has_chan(t) {
        let d = diag.error("E0305", span, "channel type `{self.show(t)}` cannot be stored in a struct or enum field").note("pass the channel as a parameter or capture it in a task's closure instead")
        return self.report(d)
    }
    if self.subst.has_fn(t) {
        let d = diag.error("E0304", span, "function type `{self.show(t)}` cannot be stored in a struct or enum field").note("a stored closure could carry a capability out of sight; pass it as a parameter instead")
        return self.report(d)
    }
    self
}

// The capabilities values of types `ts` hold, in the order of
// builtins.cap_names, each with where it comes from when no type writes
// it: the first type's path.
pub fn authority_of(self: State, ts: List[types.Ty]) -> List[(Str, Option[Str])] {
    let found = ts.fold([], |acc, t| self.subst.caps_in(t, acc))
    let written = ts.fold([], |acc, t| self.subst.caps_written(t, acc))
    builtins.cap_names().filter(|c| found.contains(c)).map(|c| if written.contains(c) {
        (c, None)
    } else {
        (c, first_path(self.subst, ts, c))
    })
}

fn first_path(s: types.Subst, ts: List[types.Ty], c: Str) -> Option[Str] {
    for t in ts {
        match s.via(t, c) {
            Some(p) => {
                return Some(p)
            },
            None => {},
        }
    }
    None
}

// "`T` holds capability `C`", and through which field when T does not
// write it, for the messages that refuse a type holding authority.
pub fn held(self: State, t: types.Ty) -> Option[Str] {
    match self.authority_of([t]).first() {
        Some((c, Some(path))) => Some("`{self.show(t)}` holds capability `{c}` through `{path}`"),
        Some((c, None)) => Some("`{self.show(t)}` holds capability `{c}`"),
        None => None,
    }
}

// ---------- the function being checked ----------

pub enum VarKind {
    KLet,
    KParam,
    KPat,
    KGroup,
}

pub struct Var {
    ty: types.Ty,
    mutable: Bool,
    span: ast.Span,
    kind: VarKind,
}

// The names bound in a block, a closure's parameters, ...; a closure's
// scope is a barrier, which lookups note crossing.
pub struct Scope {
    vars: Map[Str, Var],
    barrier: Bool,
}

pub struct Fx {
    // the result type
    ret: types.Ty,
    // innermost first
    scopes: List[Scope],
    loops: Int,
    // the type parameters in scope
    genv: List[(Str, types.Ty)],
    // inside a group body: no return, no `?`
    in_group: Int,
    // inside a deferred body: nothing may leave it
    in_defer: Int,
    // the declared result type, for fixes
    ret_te: Option[ast.TyExpr],
}

pub fn push(self: Fx) -> Fx {
    { self with scopes: [Scope { vars: map(), barrier: false }] + self.scopes }
}

pub fn pop(self: Fx) -> Fx {
    { self with scopes: self.scopes.skip(1) }
}

pub fn bind(self: Fx, name: Str, v: Var) -> Fx {
    let mut fx = self
    fx.scopes[0].vars[name] = v
    fx
}

// The variable `name`, and whether finding it crossed a closure's scope.
pub fn lookup(self: Fx, name: Str) -> Option[(Var, Bool)] {
    let mut crossed = false
    for s in self.scopes {
        match s.vars.get(name) {
            Some(v) => {
                return Some((v, crossed))
            },
            None => {
                crossed = crossed || s.barrier
            },
        }
    }
    None
}

pub fn find_var(self: Fx, name: Str) -> Option[Var] {
    self.lookup(name).map(|p| p.0)
}

pub fn is_local(self: Fx, name: Str) -> Bool {
    self.lookup(name).is_some()
}
