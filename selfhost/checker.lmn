// Checking function bodies: the expressions, statements and patterns of
// src/check.ml, one function here for each there, in the same order, with
// the same problems reported in the same order.
//
// Every function takes the State and returns it with what it learned:
// `(t, st) = check_expr(st, cx, fx, e)`. `cx` is the program's
// declarations and `fx` the function being checked (its scopes, its
// result type, the loops it is in), which only statements and patterns
// change, by binding names: they return it too.
//
// The OCaml checker evaluates the arguments of a constructor or function
// last to first, and some of them have effects (a new type variable, a
// problem reported); where that order shows, a comment says so and the
// code follows it.
use ast
use builtins
use diag
use env
use exhaust
use types

// ---------- expressions ----------

pub fn check_expr(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr) -> (types.Ty, env.State) {
    let (t, st) = inner(st, cx, fx, e)
    // a call can make the type of a generic interface bound known
    let st = match st.desc(e) {
        ECall(..) | EMethod(..) => infer_pending(st, cx),
        _ => st,
    }
    (t, st.set_type(e, t))
}

fn inner(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr) -> (types.Ty, env.State) {
    let mut st = st
    match st.desc(e) {
        EInt(_) => (TInt, st),
        EFloat(_) => (TFloat, st),
        EBool(_) => (TBool, st),
        EUnit => (TUnit, st),
        EStr(parts) => {
            for part in parts {
                match part {
                    SPExpr(x) => {
                        let (t, next) = check_expr(st, cx, fx, x)
                        st = next
                        st = match st.subst.refused(env.printing(), t) {
                            Some(Itself) => st.report(diag.error("E0201", x.span, "cannot interpolate a value of type `{st.show(t)}`")),
                            Some(Inside(u)) => st.report(diag.error("E0201", x.span, "cannot interpolate a value of type `{st.show(t)}`").note("`{st.show(t)}` holds `{st.show(u)}`, which cannot be interpolated")),
                            None => st,
                        }
                    },
                    SPLit(_) => {},
                }
            }
            (TStr, st)
        },
        EVar(n) => check_var(st, cx, fx, e, n, e.span),
        EList(es) => {
            let (el, next) = st.fresh()
            st = next
            for x in es {
                st = expect(st, cx, fx, x, el)
            }
            (TList(el), st)
        },
        EBin(op, a, b) => check_bin(st, cx, fx, op, a, b, e.span),
        EUn(Neg, a) => {
            let (t, st) = check_expr(st, cx, fx, a)
            match st.repr(t) {
                TInt | TFloat | TErr => (t, st),
                TVar(_) => (TInt, st.unify_at(a.span, TInt, t)),
                _ => (TErr, st.report(diag.error("E0201", a.span, "cannot negate a value of type `{st.show(t)}`"))),
            }
        },
        EUn(Not, a) => (TBool, expect(st, cx, fx, a, TBool)),
        EUn(BitNot, a) => {
            let (t, st) = check_expr(st, cx, fx, a)
            match st.repr(t) {
                TInt | TUInt(_) | TErr => (t, st),
                TVar(_) => (TInt, st.unify_at(a.span, TInt, t)),
                _ => (TErr, st.report(diag.error("E0201", a.span, "operator `~` cannot be applied to `{st.show(t)}`"))),
            }
        },
        ECall(callee, args) => check_call(st, cx, fx, e, callee, args, e.span, None),
        EMethod(recv, name, nsp, args) => match st.desc(recv) {
            // `Enum.Variant(args)` is a constructor call, not a method call
            EVar(en) if !fx.is_local(en) && cx.enums.contains(en) => {
                let (callee, st) = st.node(EField(recv, name, nsp), ast.merge(recv.span, nsp))
                check_call(st, cx, fx, e, callee, args, e.span, None)
            },
            _ => check_method(st, cx, fx, e, recv, name, nsp, args),
        },
        EField(recv, name, nsp) => check_field(st, cx, fx, e, recv, name, nsp),
        EIndex(a, i) => {
            let (t, next) = check_expr(st, cx, fx, a)
            st = next
            match st.repr(t) {
                TMap(k, v) => (v, expect(st, cx, fx, i, k)),
                TBytes => (TInt, expect(st, cx, fx, i, TInt)),
                _ => {
                    st = expect(st, cx, fx, i, TInt)
                    match st.repr(t) {
                        TList(el) | TArray(el, _) => (el, st),
                        TErr => (TErr, st),
                        _ => (TErr, st.report(diag.error("E0201", a.span, "only lists, arrays and maps can be indexed, found `{st.show(t)}`"))),
                    }
                },
            }
        },
        ETry(x, context) => check_try(st, cx, fx, x, context, e.span),
        EIf(c, b, other) => {
            st = expect(st, cx, fx, c, TBool)
            let (tt, next) = check_block(st, cx, fx, b)
            st = next
            match other {
                None => {
                    let (ok, next) = st.unify(TUnit, tt)
                    st = next
                    if ok {
                        return (TUnit, st)
                    }
                    let d = diag.error("E0203", b.span, "this `if` has no `else`, so its block must have type `()`, found `{st.show(tt)}`").note("add an `else` branch, or end the block with a statement")
                    (TErr, st.report(d))
                },
                Some(x) => (tt, expect(st, cx, fx, x, tt)),
            }
        },
        EMatch(s, arms) => check_match(st, cx, fx, s, arms, e.span, None),
        ESelect(arms) => {
            if st.no_wait > 0 {
                st = update_waits(st, e.span, "a `select` can wait")
            }
            check_select(st, cx, fx, arms, e.span)
        },
        EBlock(b) => check_block(st, cx, fx, b),
        EClosure(ps, body) => check_closure(st, cx, fx, ps, body, None),
        EStruct(name, nsp, fields) => check_struct_lit(st, cx, fx, name, nsp, fields, e.span),
        EPipe(..) => panic("pipes are expanded when modules load"),
        EWith(base, fields) => check_with(st, cx, fx, base, fields, e.span),
        ESafe(base, x, rest) => check_safe(st, cx, fx, e, base, x, rest),
        EDyn(x, i) => {
            // checked again: the type it was boxed as
            let before = st.repr(st.type_of(e))
            let (_, st) = check_expr(st, cx, fx, x)
            match before {
                TDyn(..) => (before, st),
                _ => (TDyn(i, []), st),
            }
        },
        ENamed(n, nsp, x) => {
            // a label the call did not take away: the callee has no
            // parameter names
            let d = diag.error("E0122", nsp, "`{n}:` names a parameter, but this call takes its arguments by position").fix("remove the label", { nsp with hi: x.span.lo }, "")
            check_expr(st.report(d), cx, fx, x)
        },
        EGroup(name, _, until, b) => {
            let (t, next) = st.fresh()
            st = next
            if st.no_wait > 0 {
                st = update_waits(st, e.span, "a `group` waits for its tasks")
            }
            match until {
                Some(dl) => {
                    let (ct, next) = check_expr(st, cx, fx, dl.clock)
                    st = next
                    match st.repr(ct) {
                        TCap("Clock") | TErr => {},
                        TVar(_) => {
                            st = st.unify_at(dl.clock.span, TCap("Clock"), ct)
                        },
                        _ => {
                            let d = diag.error("E0201", dl.clock.span, "`after` in a group deadline needs a `Clock`, found `{st.show(ct)}`").note("a group deadline is `group g until clock.after(ms) \{ ... }`, with the `Clock` from `root.clock`")
                            st = st.report(d)
                        },
                    }
                    st = expect(st, cx, fx, dl.ms, TInt)
                },
                None => {},
            }
            let inside = { fx.push().bind(name, env.Var { ty: TGroup(t), mutable: false, span: e.span, kind: KGroup }) with loops: 0, in_group: fx.in_group + 1 }
            let (_, next) = check_block(st, cx, inside, b)
            st = next
            // with a deadline, a task cancelled by it has no result: None
            (if until.is_none() { TList(t) } else { TList(types.opt(t)) }, st)
        },
    }
}

// Check `e` against an expected type; closures get their parameter types
// from it.
pub fn expect(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, want: types.Ty) -> env.State {
    let mut st = st
    match (st.desc(e), st.repr(want)) {
        // an integer literal where an unsigned integer is expected is one, if it fits
        (EInt(v), TUInt(bits)) => {
            if v < 0 || (bits < 64 && v >= 1 << bits) {
                let top = if bits == 64 { "18446744073709551615" } else { "{(1 << bits) - 1}" }
                st = st.report(diag.error("E0201", e.span, "{v} does not fit in a `UInt{bits}`, which holds 0 to {top}"))
            }
            st.set_type(e, want)
        },
        (EUn(Neg, x), TUInt(bits)) if is_int_literal(st, x) => st.report(diag.error("E0201", e.span, "a `UInt{bits}` cannot be negative")).set_type(e, want),
        (EList(es), TList(el)) if is_uint(st, el) => {
            for x in es {
                st = expect(st, cx, fx, x, el)
            }
            st.set_type(e, want)
        },
        (EList(es), TArray(el, n)) => {
            for x in es {
                st = expect(st, cx, fx, x, el)
            }
            match st.repr(n) {
                TLen(k) => {
                    if es.len() != k {
                        st = st.report(diag.error("E0201", e.span, "expected {k} element{env.plural(k)} for `{st.show(want)}`, found {es.len()}"))
                    }
                },
                // a length still to infer, as at a call of `fn sum[N](xs: Array[Int, N])`
                _ => {
                    st = st.unify_at(e.span, n, TLen(es.len()))
                },
            }
            st.set_type(e, want)
        },
        (EList(es), TList(el)) if is_dyn(st, el) => {
            // each element is boxed on its own, so a list can mix types
            for x in es {
                st = expect(st, cx, fx, x, el)
            }
            st.set_type(e, want)
        },
        // the expected type reaches each branch, so `if` and `match` arms
        // can become `dyn` one by one, and closures in them get their types
        (EIf(c, b, Some(other)), _) => {
            st = expect(st, cx, fx, c, TBool)
            st = expect_block(st, cx, fx, b, want)
            st = expect(st, cx, fx, other, want)
            st.set_type(e, want)
        },
        (EMatch(s, arms), _) => {
            let (t, st) = check_match(st, cx, fx, s, arms, e.span, Some(want))
            st.set_type(e, t)
        },
        // `Err(x)` or `Some(x)` where a `dyn` payload is expected: the
        // expected type reaches the arguments, so `x` becomes `dyn`
        (ECall(callee, args), TNamed(_, targs)) if targs.any(|a| st.subst.has_dyn(a)) => {
            let (t, st) = check_call(st, cx, fx, e, callee, args, e.span, Some(want))
            st.set_type(e, t).unify_at(e.span, want, t)
        },
        (EBlock(b), _) => expect_block(st, cx, fx, b, want).set_type(e, want),
        // the expected type reaches into a list or tuple literal when an
        // item needs it: a closure whose parameters have no types, as in
        // `[("GET /", |r, p| ...)]`
        (EList(es), TList(el)) if es.any(|x| needs_type(st, x)) => {
            for x in es {
                st = expect(st, cx, fx, x, el)
            }
            st.set_type(e, want)
        },
        (EStruct(n, _, fields), TNamed(tn, ts)) if ast.is_tuple_name(n) && n == tn && fields.len() == ts.len() && fields.any(|x| needs_type(st, x.value)) => {
            for (x, t) in fields.zip(ts) {
                st = expect(st, cx, fx, x.value, t)
            }
            st.set_type(e, want)
        },
        (_, TDyn(i, a)) => {
            let (t, st) = check_expr(st, cx, fx, e)
            coerce(st, cx, e, t, env.Bound { iface: i, args: a })
        },
        _ => expect_plain(st, cx, fx, e, want),
    }
}

fn is_int_literal(st: env.State, e: ast.Expr) -> Bool {
    match st.desc(e) {
        EInt(_) => true,
        _ => false,
    }
}

fn is_uint(st: env.State, t: types.Ty) -> Bool {
    match st.repr(t) {
        TUInt(_) => true,
        _ => false,
    }
}

// Whether `e` needs the expected type to be checked: a closure with a
// parameter that has no type, alone or inside a list or tuple literal.
pub fn needs_type(st: env.State, e: ast.Expr) -> Bool {
    match st.desc(e) {
        EClosure(ps, _) => ps.any(|p| p.ty.is_none()),
        EList(es) => es.any(|x| needs_type(st, x)),
        EStruct(n, _, fields) if ast.is_tuple_name(n) => fields.any(|x| needs_type(st, x.value)),
        _ => false,
    }
}

fn is_dyn(st: env.State, t: types.Ty) -> Bool {
    match st.repr(t) {
        TDyn(..) => true,
        _ => false,
    }
}

// A value used where `dyn I` is expected: box it if its type satisfies I.
fn coerce(st: env.State, cx: env.Cx, e: ast.Expr, t: types.Ty, b: env.Bound) -> env.State {
    let boxed = TDyn(b.iface, b.args)
    let bn = st.show_bound(b)
    match st.repr(t) {
        TDyn(j, _) if j == b.iface => st.unify_at(e.span, boxed, t),
        TVar(_) => st.unify_at(e.span, boxed, t),
        TErr => st,
        // the built-in errors: a message, no cause
        TStr | TNamed("IoError", _) if b.iface == "Error" => box(st, e, b),
        TNamed(n, _) if (cx.structs.contains(n) || cx.enums.contains(n)) && !["Option", "Result", "IoError"].contains(n) => {
            let ct = st.repr(t)
            match st.held(ct) {
                Some(h) => {
                    let d = diag.error("E0112", e.span, "{h}, so it cannot become `dyn {bn}`").note("authority must stay visible in types; pass it with a type parameter, as in `[T: " + bn + "]`")
                    return st.report(d)
                },
                None => {},
            }
            let kind = st.subst.chan_kind(ct)
            if st.subst.has_chan(ct) && !st.subst.has_fn(ct) && kind != Some("channel") {
                let d = diag.error("E0112", e.span, "`{st.show(ct)}` holds an `Atomic` or `Shared` value, so it cannot become `dyn {bn}`").note("shared state must stay visible in types; pass it with a type parameter, as in `[T: " + bn + "]`")
                return st.report(d)
            }
            if st.subst.has_fn(ct) || st.subst.has_chan(ct) {
                let d = diag.error("E0112", e.span, "`{st.show(ct)}` holds a function or channel, so it cannot become `dyn {bn}`").note("a function or channel could carry authority out of sight; pass it with a type parameter, as in `[T: " + bn + "]`")
                return st.report(d)
            }
            match satisfies(st, cx, ct, b) {
                (Some(why), st) => st.report(diag.error("E0111", e.span, "`{st.show(ct)}` does not satisfy interface `{bn}`").note(why)),
                (None, st) => box(st, e, b),
            }
        },
        other => {
            let d = diag.error("E0112", e.span, "only struct and enum values can become `dyn {bn}`, not `{st.show(other)}`").note("wrap the value in a struct that has the interface's methods")
            st.report(d)
        },
    }
}

// `e`, already checked, becomes `EDyn(inner, I)`: `inner` is a new
// expression with what was known of `e` (its form, type and type
// arguments), and `e` is the boxed value, of type `dyn I`.
fn box(st: env.State, e: ast.Expr, b: env.Bound) -> env.State {
    let (inner, st) = st.node(st.desc(e), e.span)
    let mut st = st.set_type(inner, st.type_of(e)).set_inst(inner, st.inst_of(e))
    if st.nested.contains(e.id) {
        st.nested[inner.id] = true
    }
    st.rewrite(e, EDyn(inner, b.iface)).set_type(e, TDyn(b.iface, b.args))
}

// Does `t` have every method of bound `b`, with the same types? None if
// so, else why not. Unifying the method types infers the bound's
// arguments where they are unknown.
pub fn satisfies(st: env.State, cx: env.Cx, t: types.Ty, b: env.Bound) -> (Option[Str], env.State) {
    let mut st = st
    let ms = iface_methods(st, cx, b)
    let t = st.repr(t)
    let name = st.show_bound(b)
    // the bound's own arguments, unified with `args`
    let same_args = |st: env.State, args: List[types.Ty]| {
        if args.len() != b.args.len() {
            return (false, st)
        }
        let mut st = st
        for (x, y) in b.args.zip(args) {
            let (ok, next) = st.unify(x, y)
            st = next
            if !ok {
                return (false, st)
            }
        }
        (true, st)
    }
    match t {
        TDyn(j, ja) if j == b.iface => {
            let (same, next) = same_args(st, ja)
            st = next
            if same {
                return (None, st)
            }
        },
        TParam(g) => {
            for x in bounds_of(st, g) {
                if x.iface == b.iface {
                    let (same, next) = same_args(st, x.args)
                    st = next
                    if same {
                        return (None, st)
                    }
                }
            }
        },
        _ => {},
    }
    for m in ms {
        // `cause` is optional in `Error`: a type without one has no cause
        let own = match t {
            TNamed(n, _) => cx.fns.contains(n + "::" + m.name) || builtins.names(t).contains(m.name),
            TParam(_) | TDyn(..) => true,
            _ => builtins.names(t).contains(m.name),
        }
        if b.iface == "Error" && m.name == "cause" && !own {
            continue
        }
        let (why, next) = method_fits(st, cx, t, name, m)
        st = next
        if why.is_some() {
            return (why, st)
        }
    }
    (None, st)
}

// Whether `t` has method `m` of the interface called `name` (as shown),
// with its type; why not if it does not.
fn method_fits(st: env.State, cx: env.Cx, t: types.Ty, name: Str, m: env.IfaceMethod) -> (Option[Str], env.State) {
    let want = TFn(m.params, m.ret)
    let trial = |st: env.State, got: types.Ty| {
        let (ok, st) = st.unify(want, got)
        if ok {
            return (None, st)
        }
        (Some("its `{m.name}` has type `{st.show(got)}`, but `{name}` needs `{st.show(want)}`"), st)
    }
    let key = |n: Str| n + "::" + m.name
    match t {
        TVar(_) | TErr => (None, st),
        TDyn(j, ja) => match iface_methods(st, cx, env.Bound { iface: j, args: ja }).find(|x| x.name == m.name) {
            Some(x) => trial(st, TFn(x.params, x.ret)),
            None => (Some("`{st.show(t)}` has no method `{m.name}`"), st),
        },
        TParam(g) => {
            for x in bounds_of(st, g) {
                match iface_methods(st, cx, x).find(|y| y.name == m.name) {
                    Some(y) => {
                        return trial(st, TFn(y.params, y.ret))
                    },
                    None => {},
                }
            }
            (Some("type parameter `{g}` is not bounded by `{name}`; add it: `[{g}: {name}]`"), st)
        },
        TNamed(n, _) if cx.fns.contains(key(n)) => {
            let (_, ft, st) = instantiate(st, cx.fns.get(key(n)) ?? env.Sig { gen: [], params: [], ret: TErr })
            match ft {
                TFn([p0, ..rest], r) => trial(st.unify(p0, t).1, TFn(rest, r)),
                _ => (Some("its `{m.name}` is not a method"), st),
            }
        },
        TNamed(n, _) if is_ambiguous(promote(cx, false, n, m.name)) => match promote(cx, false, n, m.name) {
            Ambiguous(paths) => (Some(ambiguity(n, m.name, paths)), st),
            _ => (None, st),
        },
        _ => {
            let (u, st) = st.fresh()
            match builtins.find(t, u, m.name) {
                Some(x) => trial(st, TFn(x.params, x.result)),
                None => (Some("`{st.show(t)}` has no method `{m.name}`"), st),
            }
        },
    }
}

fn is_ambiguous(f: Found) -> Bool {
    match f {
        Ambiguous(_) => true,
        _ => false,
    }
}

// Infer the arguments of the generic-interface bounds of the calls made so
// far whose type is now known, so `first(xs)` has its result type at once.
fn infer_pending(st: env.State, cx: env.Cx) -> env.State {
    if st.to_infer.is_empty() {
        return st
    }
    let mut st = st
    let mut keep: List[(types.Ty, env.Bound)] = []
    for (t, b) in st.to_infer {
        match st.repr(t) {
            TVar(_) => keep.push((t, b)),
            _ => {
                st = satisfies(st, cx, t, b).1
            },
        }
    }
    st.to_infer = keep
    st
}

fn expect_plain(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, want: types.Ty) -> env.State {
    match st.desc(e) {
        EClosure(ps, body) => {
            let (t, st) = check_closure(st, cx, fx, ps, body, Some(want))
            st.set_type(e, t).unify_at(e.span, want, t)
        },
        _ => {
            let (t, st) = check_expr(st, cx, fx, e)
            st.unify_at(e.span, want, t)
        },
    }
}

fn check_var(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, n: Str, sp: ast.Span) -> (types.Ty, env.State) {
    let mut st = st
    match fx.find_var(n) {
        Some(v) if v.kind == KGroup => {
            return (TErr, st.report(diag.error("E0310", sp, "`{n}` is a group handle; the only thing you can do with it is `{n}.go(...)`")))
        },
        Some(v) => {
            let pass = st.arg_of
            st.arg_of = None
            if v.kind == KParam && st.cb_params.contains((n, v.span)) {
                match fx.lookup(n) {
                    Some((_, false)) if st.calling => {},
                    Some((_, false)) if pass.is_some() => {
                        st.cb_passes = [pass ?? ("", 0)] + st.cb_passes
                    },
                    _ => {
                        st.cb_escaped = true
                    },
                }
            }
            return (v.ty, st)
        },
        None => {},
    }
    let direct = st.calling
    st.calling = false
    match cx.fns.get(n) {
        Some(_) if cx.foreign_fns.contains(n) && !direct => {
            let d = diag.error("E0331", sp, "foreign function `{n}` can only be called, not used as a value").note("wrap it in a closure, as in `|x| {n}(foreign, x)`")
            return (TErr, st.report(d))
        },
        Some(s) => {
            let (inst, t, next) = instantiate(st, s)
            st = next.set_inst(e, inst)
            return (t, add_bounds(st, cx, n, inst, sp))
        },
        None => {},
    }
    if cx.owners.contains(n) {
        match variant_scope(cx, n, sp.file) {
            [en] => {
                // name the enum when the variant name alone would be
                // ambiguous to the backends
                if (cx.owners.get(n) ?? []).len() > 1 {
                    let (qual, next) = st.node(EVar(en), sp)
                    st = next.rewrite(e, EField(qual, n, sp))
                }
                return ctor_ty(st, cx, en, n, sp)
            },
            ens => {
                let d = diag.error("E0104", sp, "`{n}` is a variant of several enums ({ens.join(", ")}); qualify it, for example `{ens[0]}.{n}`")
                return (TErr, st.report(d))
            },
        }
    }
    match builtins.ambient(n) {
        Some(a) => {
            let d = diag.error("E0302", sp, "`{n}` does not exist: Limen has no ambient I/O").note("I/O goes through capabilities: take a `{a.cap}` parameter and call `{a.how}`").note("in `main`, the capabilities live on `root`, for example `root.stdout.print(\"hi\")`")
            return (TErr, st.report(d))
        },
        None => {},
    }
    // OCaml folds over its table of functions, so of the methods named `n`
    // it names the last its table lists
    let suffix = "::" + n
    let mut d = diag.error("E0101", sp, "unknown name `{n}`")
    match env.keys_in_order(cx.fns).filter(|k| k.ends_with(suffix)).last() {
        Some(k) => {
            let tn = k.slice(0, k.len() - suffix.len())
            d = d.note("`{n}` is a method of `{tn}`; call it on a value: `x.{n}(...)`")
        },
        None => {},
    }
    (TErr, st.did_you_mean(d, n, visible_names(cx, fx)))
}

fn visible_names(cx: env.Cx, fx: env.Fx) -> List[Str] {
    fx.scopes.flat_map(|s| env.keys_in_order(s.vars)) + env.keys_in_order(cx.fns) + env.keys_in_order(cx.owners) + builtins.functions()
}

fn instantiate(st: env.State, s: env.Sig) -> (List[(Str, types.Ty)], types.Ty, env.State) {
    let (vars, st) = st.fresh_list(s.gen.len())
    let inst = s.gen.zip(vars)
    (inst, TFn(s.params.map(|p| st.subst(inst, p)), st.subst(inst, s.ret)), st)
}

// E0201 when built-in `name` compares values of type `t` that have no
// equality: functions, channels, `dyn` values, capabilities, and values
// holding one of them, as `==` refuses them.
pub fn refuse_compare(st: env.State, sp: ast.Span, name: Str, t: types.Ty) -> env.State {
    let t = st.repr(t)
    match st.subst.refused(env.equality(), t) {
        Some(Itself) => st.report(diag.error("E0201", sp, "`{name}` compares values, and values of type `{st.show(t)}` cannot be compared")),
        Some(Inside(u)) => st.report(diag.error("E0201", sp, "`{name}` compares values, and {st.holds_uncomparable(t, u)}")),
        None => match st.held(t) {
            Some(h) => st.report(diag.error("E0201", sp, "`{name}` compares values, and {h}").note("capabilities have no equality, so neither has a value holding one; compare something it holds that is not a capability, as in `xs.any(|x| x.name == name)`")),
            None => st,
        },
    }
}

// The bounds of generic function `name` apply to its type arguments here.
fn add_bounds(st: env.State, cx: env.Cx, name: Str, inst: List[(Str, types.Ty)], sp: ast.Span) -> env.State {
    let mut st = st
    if !inst.is_empty() {
        st.uses_here = [(sp, name, inst)] + st.uses_here
    }
    if st.cur_fn != "" && !st.refs_here.contains(name) {
        st.refs_here = [name] + st.refs_here
    }
    for b in cx.fn_bounds.get(name) ?? [] {
        match inst.find(|p| p.0 == b.param) {
            Some((_, t)) => {
                for bound in b.bounds {
                    let bound = st.subst_bound(inst, bound)
                    st.pending = [env.Pending { span: sp, ty: t, bound, param: b.param }] + st.pending
                    if !bound.args.is_empty() {
                        st.to_infer = [(t, bound)] + st.to_infer
                    }
                }
            },
            None => {},
        }
    }
    st
}

// The enums a bare variant name can mean in `file`: the file's own enums
// shadow the prelude's, which shadow other modules'. More than one at the
// nearest level is ambiguous.
fn variant_scope(cx: env.Cx, v: Str, file: Int) -> List[Str] {
    let ens = cx.owners.get(v) ?? []
    let from = |f: Int| ens.filter(|en| cx.enums.get(en).map(|e| e.span.file == f) ?? false)
    match from(file) {
        [] => match from(cx.prelude_file) {
            [] => ens,
            p => p,
        },
        own => own,
    }
}

// The type of variant `v` of enum `en` used as a value: the enum, or a
// function from its payload to the enum.
fn ctor_ty(st: env.State, cx: env.Cx, en: Str, v: Str, sp: ast.Span) -> (types.Ty, env.State) {
    let gen = cx.enums.get(en).map(|e| e.generics) ?? []
    let (targs, st) = st.fresh_list(gen.len())
    let st = st.add_type_bounds(cx, en, targs, sp)
    let inst = gen.zip(targs)
    let payload = (cx.variants.get(en) ?? []).find(|x| x.0 == v).map(|x| x.1) ?? []
    let result = TNamed(en, targs)
    if payload.is_empty() {
        return (result, st)
    }
    (TFn(payload.map(|p| st.subst(inst, p)), result), st)
}

fn struct_fields(st: env.State, cx: env.Cx, n: Str, args: List[types.Ty]) -> List[(Str, types.Ty)] {
    let gen = cx.structs.get(n).map(|s| s.generics) ?? []
    let inst = gen.zip(args)
    (cx.sfields.get(n) ?? []).map(|f| (f.0, st.subst(inst, f.1)))
}

fn check_args(st: env.State, cx: env.Cx, fx: env.Fx, args: List[ast.Expr]) -> env.State {
    let mut st = st
    for a in args {
        let (_, next) = check_expr(st, cx, fx, unlabel(st, a))
        st = next
    }
    st
}

fn is_named(st: env.State, a: ast.Expr) -> Bool {
    match st.desc(a) {
        ENamed(..) => true,
        _ => false,
    }
}

fn unlabel(st: env.State, a: ast.Expr) -> ast.Expr {
    match st.desc(a) {
        ENamed(_, _, v) => v,
        _ => a,
    }
}

// ---------- calls ----------

// Named arguments, `connect(host, retries: 3)`: positional arguments
// first, then named ones in any order, every parameter passed exactly once
// (there are no default values). A closure written last, after named
// arguments, fills the last parameter: that is where a trailing closure
// goes. Returns the arguments in parameter order without their labels, or
// None after reporting what is wrong. `names` are the callee's parameter
// names, or why it has none.
fn order_args(st: env.State, what: Str, sp: ast.Span, names: Result[List[Str], Str], defaults: List[Option[ast.Expr]], args: List[ast.Expr]) -> (Option[List[ast.Expr]], env.State) {
    let mut st = st
    if !args.any(|a| is_named(st, a)) && args.len() >= defaults.len() {
        return (Some(args), st)
    }
    let names = match names {
        Err(why) => {
            for a in args {
                match st.desc(a) {
                    ENamed(l, lsp, v) => {
                        let d = diag.error("E0122", lsp, "`{l}:` names a parameter, but {why}").fix("remove the label", { lsp with hi: v.span.lo }, "")
                        return (None, st.report(d))
                    },
                    _ => {},
                }
            }
            return (None, st)
        },
        Ok(names) => names,
    }
    let n = names.len()
    let mut slots: List[Option[ast.Expr]] = names.map(|_| None)
    let mut ok = true
    let total = args.len()
    let mut named_seen = false
    let mut misplaced: List[ast.Expr] = []
    let mut extra = 0
    let mut unknown: List[(Str, ast.Span)] = []
    let mut dup = false
    for (i, a) in args.with_index() {
        match st.desc(a) {
            ENamed(l, lsp, v) => {
                named_seen = true
                match names.with_index().find(|p| p.1 == l) {
                    None => {
                        ok = false
                        unknown.push((l, lsp))
                    },
                    Some((j, _)) => match slots[j] {
                        Some(_) => {
                            ok = false
                            dup = true
                            let d = diag.error("E0122", lsp, "parameter `{l}` is passed twice").note("positional arguments fill the parameters in order, before the named ones")
                            st = st.report(d)
                        },
                        None => {
                            slots[j] = Some(v)
                        },
                    },
                }
            },
            EClosure(..) if named_seen && i == total - 1 && n > 0 && slots[n - 1].is_none() => {
                slots[n - 1] = Some(a)
            },
            _ if named_seen => misplaced.push(a),
            _ => {
                if i < n {
                    slots[i] = Some(a)
                } else {
                    extra = extra + 1
                }
            },
        }
    }
    if extra > 0 {
        ok = false
        st = st.report(diag.error("E0107", sp, "{what} takes {n} argument{env.plural(n)} but {total} {env.was_were(total)} supplied"))
    }
    // a parameter left out takes its default
    for (j, d) in defaults.with_index() {
        if j < n && slots[j].is_none() {
            slots[j] = d
        }
    }
    let mut missing = names.with_index().filter(|p| slots[p.0].is_none()).map(|p| p.1)
    let list = if names.is_empty() { "none" } else { names.join(", ") }
    let with_notes = |d: diag.Diag| d.note("its parameters are: {list}")
    match (unknown, missing) {
        ([(l, lsp)], [m]) => {
            // one wrong label and one parameter left: that must be the one
            missing = []
            st = st.report(with_notes(diag.error("E0122", lsp, "{what} has no parameter `{l}`")).fix("did you mean `{m}`?", lsp, m))
        },
        (us, _) => {
            if !us.is_empty() {
                missing = []
            }
            for (l, lsp) in us {
                st = st.did_you_mean(with_notes(diag.error("E0122", lsp, "{what} has no parameter `{l}`")), l, names)
            }
        },
    }
    for a in misplaced {
        ok = false
        let mut d = diag.error("E0122", a.span, "a positional argument cannot come after a named one").note("write the positional arguments first, or name this one too")
        match missing {
            [m, ..rest] => {
                missing = rest
                d = d.fix("name it: `{m}: ...`", { a.span with hi: a.span.lo }, m + ": ")
            },
            [] => {},
        }
        st = st.report(d)
    }
    if misplaced.is_empty() && extra == 0 && !dup {
        for m in missing {
            ok = false
            st = st.report(diag.error("E0107", sp, "{what} is missing the argument for parameter `{m}`").note("every parameter without a default value must be passed"))
        }
    }
    if !ok {
        return (None, st)
    }
    // every slot is filled when nothing was wrong
    (Some(slots.flat_map(|s| s.map(|x| [x]) ?? [])), st)
}

// Arguments run in the order they are written. When labels moved one that
// has an effect past another, the checked call `e` becomes
// `{ let $arg1 = first; let $arg2 = second; call($arg2, $arg1) }`, the lets
// in written order. Literals, names, closures and field reads have no
// effect, so they stay in place. `written` is the arguments as written,
// after the receiver if there is one.
fn keep_order(st: env.State, e: ast.Expr, written: List[ast.Expr], r: types.Ty) -> env.State {
    let mut st = st
    let effects = written.filter(|x| !pure(st, x))
    let ids = effects.map(|x| x.id)
    let call_args = match st.desc(e) {
        ECall(_, xs) => xs,
        EMethod(rv, _, _, xs) => [rv] + xs,
        _ => [],
    }
    let in_call = call_args.filter(|x| ids.contains(x.id)).map(|x| x.id)
    if in_call.len() != ids.len() || in_call == ids {
        return st
    }
    let mut temps: List[(Int, Str)] = []
    for x in effects {
        st.temps = st.temps + 1
        temps.push((x.id, "$arg{st.temps}"))
    }
    let mut vars: List[(Int, ast.Expr)] = []
    for x in effects {
        let name = temps.find(|t| t.0 == x.id).map(|t| t.1) ?? ""
        let (v, next) = st.node(EVar(name), x.span)
        st = next.set_type(v, next.type_of(x))
        vars.push((x.id, v))
    }
    let var = |x: ast.Expr| vars.find(|v| v.0 == x.id).map(|v| v.1) ?? x
    let desc = match st.desc(e) {
        ECall(c, xs) => ECall(c, xs.map(var)),
        EMethod(rv, m, nsp, xs) => EMethod(var(rv), m, nsp, xs.map(var)),
        d => d,
    }
    let (call, next) = st.node(desc, e.span)
    st = next.set_type(call, r)
    st = st.set_inst(call, st.inst_of(e))
    let lets = effects.map(|x| ast.Stmt { desc: SLet(false, temps.find(|t| t.0 == x.id).map(|t| t.1) ?? "", x.span, None, x), span: x.span })
    st.rewrite(e, EBlock(ast.Block { stmts: lets, tail: Some(call), span: e.span }))
}

fn pure(st: env.State, x: ast.Expr) -> Bool {
    match st.desc(x) {
        EInt(_) | EFloat(_) | EBool(_) | EUnit | EVar(_) | EClosure(..) => true,
        EStr(parts) => parts.all(|p| match p {
            SPLit(_) => true,
            SPExpr(_) => false,
        }),
        EField(a, _, _) | EDyn(a, _) => pure(st, a),
        _ => false,
    }
}

// Parameter names of the method `key` (`Type::name`), without `self`.
fn method_params(cx: env.Cx, key: Str) -> Result[List[Str], Str] {
    match cx.param_names.get(key) {
        Some([_, ..ps]) => Ok(ps),
        _ => Err("this method takes its arguments by position"),
    }
}

// Default values of the method `key`'s parameters, without `self`.
fn method_defaults(cx: env.Cx, key: Str) -> List[Option[ast.Expr]] {
    match cx.param_defaults.get(key) {
        Some([_, ..ds]) => ds,
        _ => [],
    }
}

// The built-in functions: `assert(c)`, `channel(n)`, `map()`, ...,
// unless a local or a function of the program has the name.
fn builtin_call(st: env.State, cx: env.Cx, fx: env.Fx, n: Str, args: List[ast.Expr], sp: ast.Span) -> Option[(types.Ty, env.State)] {
    if fx.is_local(n) || cx.fns.contains(n) {
        return None
    }
    let mut st = st
    // the wrong number of arguments: reported, and each checked anyway
    let wrong = |st: env.State, message: Str| check_args(st.report(diag.error("E0107", sp, message)), cx, fx, args)
    match n {
        "assert" => {
            st = match args {
                [a] => expect(st, cx, fx, a, TBool),
                _ => wrong(st, "`assert` takes 1 argument, a Bool"),
            }
            Some((TUnit, st))
        },
        "assert_eq" => {
            st = match args {
                [a, b] => {
                    let (t, next) = check_expr(st, cx, fx, a)
                    let next = expect(next, cx, fx, b, t)
                    match next.subst.refused(env.equality(), t) {
                        Some(Itself) => next.report(diag.error("E0201", sp, "values of type `{next.show(t)}` cannot be compared")),
                        Some(Inside(_)) | None => {
                            let mut next = next
                            next.eq_types = [t] + next.eq_types
                            refuse_compare(next, sp, "assert_eq", t)
                        },
                    }
                },
                _ => wrong(st, "`assert_eq` takes 2 arguments"),
            }
            Some((TUnit, st))
        },
        // `keep(x)`: x counts as used, so a benchmark's work is not
        // optimized away
        "keep" => {
            st = match args {
                [a] => check_expr(st, cx, fx, a).1,
                _ => wrong(st, "`keep` takes 1 argument"),
            }
            Some((TUnit, st))
        },
        "channel" => {
            st = match args {
                [a] => expect(st, cx, fx, a, TInt),
                _ => wrong(st, "`channel` takes 1 argument, its capacity"),
            }
            let (t, st) = st.fresh()
            Some((TChan(t), st))
        },
        "atomic" => {
            st = match args {
                [a] => expect(st, cx, fx, a, TInt),
                _ => wrong(st, "`atomic` takes 1 argument, its first value"),
            }
            Some((TAtomic, st))
        },
        "shared" => match args {
            [a] => {
                let (t, st) = check_expr(st, cx, fx, a)
                Some((TShared(t), st))
            },
            _ => {
                let st = wrong(st, "`shared` takes 1 argument, its first value")
                let (t, st) = st.fresh()
                Some((TShared(t), st))
            },
        },
        // catch(|| ...): Ok(value), or Err(message) if anything inside panicked
        "catch" => {
            let (t, st) = st.fresh()
            match args {
                [a] => Some((types.res(t, TStr), expect(st, cx, fx, a, TFn([], t)))),
                _ => Some((TErr, wrong(st, "`catch` takes 1 argument, a closure with no parameters, as in `catch(|| risky())`"))),
            }
        },
        // bytes([104, 105]): each item 0 to 255, or it panics
        "bytes" => {
            st = match args {
                [a] => expect(st, cx, fx, a, TList(TInt)),
                _ => wrong(st, "`bytes` takes 1 argument, a list of Ints from 0 to 255"),
            }
            Some((TBytes, st))
        },
        "map" => {
            let (k, st) = st.fresh()
            let (v, st) = st.fresh()
            let mut st = match args {
                [] => st,
                [a] => expect(st, cx, fx, a, TList(TNamed("#tuple2", [k, v]))),
                _ => wrong(st, "`map` takes no arguments, or a list of (key, value) pairs"),
            }
            st.map_keys = [(sp, k)] + st.map_keys
            Some((TMap(k, v), st))
        },
        "panic" => {
            st = match args {
                [a] => expect(st, cx, fx, a, TStr),
                _ => wrong(st, "`panic` takes 1 argument (a message)"),
            }
            let (t, st) = st.fresh()
            Some((t, st))
        },
        _ => None,
    }
}

fn check_call(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, callee: ast.Expr, args: List[ast.Expr], sp: ast.Span, want: Option[types.Ty]) -> (types.Ty, env.State) {
    let mut st = st
    match st.desc(callee) {
        EVar(n) => match builtin_call(st, cx, fx, n, args, sp) {
            Some(done) => {
                return done
            },
            None => {},
        },
        _ => {},
    }
    let is_var = match st.desc(callee) {
        EVar(_) => true,
        _ => false,
    }
    // a foreign function can be used only where it is called
    st.calling = is_var
    let (ct, next) = check_expr(st, cx, fx, callee)
    st = next
    st.calling = false
    let (what, names) = match st.desc(callee) {
        EVar(n) if !fx.is_local(n) && cx.param_names.contains(n) => ("function `{n}`", Ok(cx.param_names.get(n) ?? [])),
        EVar(n) if !fx.is_local(n) && cx.foreign_fns.contains(n) => ("", Err("foreign function `{n}` takes its arguments by position")),
        EVar(n) if fx.is_local(n) => ("", Err("`{n}` is a function value, and function values have no parameter names")),
        EVar(n) if cx.owners.contains(n) => ("", Err("an enum variant takes its payload by position")),
        EField(..) => ("", Err("an enum variant takes its payload by position")),
        _ => ("", Err("a function value has no parameter names")),
    }
    match st.repr(ct) {
        TFn(ps, r) => {
            // a constructor's type parameters come from the expected type first
            match (want, st.desc(callee), st.repr(r)) {
                (Some(w), EVar(_) | EField(..), TNamed(n, _)) if cx.enums.contains(n) => {
                    st = st.unify(r, w).1
                },
                _ => {},
            }
            let defaults = match st.desc(callee) {
                EVar(n) if !fx.is_local(n) => cx.param_defaults.get(n) ?? [],
                _ => [],
            }
            let (ordered, next) = order_args(st, what, sp, names, defaults, args)
            st = next
            let args2 = match ordered {
                None => {
                    return (r, check_args(st, cx, fx, args))
                },
                Some(a) => a,
            }
            // reordered by labels, or with defaults filled in: the call is rewritten
            let labelled = args.any(|a| is_named(st, a)) || args2.len() != args.len()
            let written = args.map(|a| unlabel(st, a))
            if ps.len() != args2.len() {
                st = st.report(diag.error("E0107", sp, "this function takes {ps.len()} argument{env.plural(ps.len())} but {args2.len()} {env.was_were(args2.len())} supplied"))
                st = check_args(st, cx, fx, args2)
            } else {
                let foreign = match st.desc(callee) {
                    EVar(n) => !fx.is_local(n) && cx.foreign_fns.contains(n),
                    _ => false,
                }
                let ps = if foreign { callback_params(st, cx, fx, args2, ps) } else { ps }
                // a function parameter passed on: pure if the callee is, there
                let passed_to = match st.desc(callee) {
                    EVar(g) if !foreign && !fx.is_local(g) && cx.fns.contains(g) => Some(g),
                    _ => None,
                }
                for (k, (a, p)) in args2.zip(ps).with_index() {
                    match (passed_to, st.desc(a)) {
                        (Some(g), EVar(_)) => {
                            st.arg_of = Some((g, k))
                        },
                        _ => {},
                    }
                    st = expect(st, cx, fx, a, p)
                    st.arg_of = None
                }
                if foreign {
                    st = check_callbacks(st, cx, fx, args2, ps)
                    // a Foreign narrowed here to other libraries: the call would panic
                    match (ps, args2, st.desc(callee)) {
                        ([TCap("Foreign"), ..], [a, ..], EVar(n)) => match (cx.foreign_libs.get(n), known_foreign(st, fx, a)) {
                            (Some(lib), Some(s)) if !s.contains(lib) && !s.contains("*") => {
                                let grants = if s.is_empty() { "no library" } else { "only " + s.map(|l| "`" + l + "`").join(", ") }
                                st = st.report(diag.error("E0333", a.span, "`{n}` calls C library `{lib}`, but this Foreign grants {grants}").note("it was narrowed with `only`, so the call would panic; narrow it to the library the function belongs to"))
                            },
                            _ => {},
                        },
                        _ => {},
                    }
                }
            }
            if labelled {
                st = st.rewrite(e, ECall(callee, args2))
                st = keep_order(st, e, written, r)
            }
            (r, st)
        },
        TErr => (TErr, check_args(st, cx, fx, args)),
        TVar(_) => {
            let (ps, next) = st.fresh_list(args.len())
            let (r, next) = next.fresh()
            st = next.unify_at(callee.span, TFn(ps, r), ct)
            for (a, p) in args.zip(ps) {
                st = expect(st, cx, fx, a, p)
            }
            (r, st)
        },
        t => {
            st = st.report(diag.error("E0108", callee.span, "a value of type `{st.show(t)}` is not a function"))
            (TErr, check_args(st, cx, fx, args))
        },
    }
}

// The libraries a Foreign expression is known to be narrowed to: a
// variable bound to one, or `x.only("lib")`. None when it is not known
// here.
fn known_foreign(st: env.State, fx: env.Fx, e: ast.Expr) -> Option[List[Str]] {
    match st.desc(e) {
        EVar(m) => match fx.find_var(m) {
            Some(v) => st.foreign_known.find(|k| k.0 == (m, v.span)).map(|k| k.1),
            None => None,
        },
        EMethod(r, "only", _, [arg]) => match (st.repr(st.type_of(r)), st.desc(arg)) {
            (TCap("Foreign"), EStr([SPLit(lib)])) => match known_foreign(st, fx, r) {
                Some(s) => Some(if lib == "*" { s } else if s.contains(lib) || s.contains("*") { [lib] } else { [] }),
                None => if lib == "*" { None } else { Some([lib]) },
            },
            _ => None,
        },
        _ => None,
    }
}

// The parameter types of a call of a foreign function: a callback may
// take the call's Foreign first, before what C passes.
fn callback_params(st: env.State, cx: env.Cx, fx: env.Fx, args: List[ast.Expr], ps: List[types.Ty]) -> List[types.Ty] {
    match ps {
        [TCap("Foreign"), ..] => {},
        _ => {
            return ps
        },
    }
    args.zip(ps).map(|x| {
        let (a, p) = x
        match (st.repr(p), st.desc(a)) {
            (TFn(cps, r), EVar(m)) if !fx.is_local(m) => match cx.fns.get(m) {
                Some(s) => match s.params {
                    [TCap("Foreign"), ..rest] if rest.len() == cps.len() => TFn([TCap("Foreign")] + cps, r),
                    _ => p,
                },
                None => p,
            },
            _ => p,
        }
    })
}

// A callback passed to C names a top-level function: C calls it with its
// arguments alone, so it has nowhere to keep a closure's captured values.
fn check_callbacks(st: env.State, cx: env.Cx, fx: env.Fx, args: List[ast.Expr], ps: List[types.Ty]) -> env.State {
    let mut st = st
    for (a, p) in args.zip(ps) {
        match st.repr(p) {
            TFn(..) => {
                let named = match st.desc(a) {
                    EVar(m) => !fx.is_local(m) && (cx.fns.get(m).map(|s| s.gen.is_empty()) ?? false),
                    _ => false,
                }
                if !named {
                    let d = diag.error("E0332", a.span, "a callback to C is a top-level function, passed by its name").note("C calls it with its arguments alone, so it has nowhere to keep a closure's captured values; pass what it needs through C (most C functions that take a callback also take a pointer for it)")
                    st = st.report(d)
                }
            },
            _ => {},
        }
    }
    st
}

// ---------- fields and methods ----------

fn check_field(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, name: Str, nsp: ast.Span) -> (types.Ty, env.State) {
    match st.desc(recv) {
        EVar(en) if !fx.is_local(en) && cx.enums.contains(en) => {
            let vs = cx.variants.get(en) ?? []
            if vs.any(|v| v.0 == name) {
                return ctor_ty(st, cx, en, name, nsp)
            }
            (TErr, st.did_you_mean(diag.error("E0104", nsp, "enum `{en}` has no variant `{name}`"), name, vs.map(|v| v.0)))
        },
        _ => {
            let (t, st) = check_expr(st, cx, fx, recv)
            field_of(st, cx, fx, e, recv, t, name, nsp)
        },
    }
}

// `recv.name` where `recv` is checked and has type `t`.
fn field_of(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, t: types.Ty, name: Str, nsp: ast.Span) -> (types.Ty, env.State) {
    let (arity, st) = method_arity(st, cx, nsp.file, t, name)
    let mut st = st
    let rt = st.repr(t)
    match rt {
        TNamed(n, args) if cx.sfields.contains(n) => {
            match promote(cx, true, n, name) {
                // promoted from an embedded struct: `admin.name` is `admin.User.name`
                Path(path, _) => {
                    let (r, rt2, next) = embed_path(st, cx, recv, rt, path)
                    st = next.rewrite(e, EField(r, name, nsp))
                    return field_of(st, cx, fx, e, r, rt2, name, nsp)
                },
                Ambiguous(paths) => {
                    return (TErr, ambiguous(st, nsp, n, name, paths))
                },
                _ => {},
            }
            let fs = struct_fields(st, cx, n, args)
            match fs.find(|f| f.0 == name) {
                Some(f) => (f.1, st),
                None => match arity {
                    Some(k) => method_value(st, cx, fx, e, recv, t, name, nsp, k),
                    None => {
                        let mut d = diag.error("E0103", nsp, "struct `{n}` has no field `{name}`")
                        if cx.fns.contains(n + "::" + name) {
                            d = d.note("`{name}` is a method; call it with parentheses: `.{name}()`")
                        }
                        (TErr, st.did_you_mean(d, name, fs.map(|f| f.0)))
                    },
                },
            }
        },
        TCap("Root") => match builtins.root_fields().find(|f| f.0 == name) {
            Some(f) => (f.1, st),
            None => match arity {
                Some(k) => method_value(st, cx, fx, e, recv, t, name, nsp, k),
                None => (TErr, st.did_you_mean(diag.error("E0103", nsp, "`Root` has no field `{name}`"), name, builtins.root_fields().map(|f| f.0))),
            },
        },
        TErr => (TErr, st),
        TVar(_) => (TErr, st.report(diag.error("E0207", recv.span, "the type of this value is not known here; add a type annotation"))),
        _ => match arity {
            Some(k) => method_value(st, cx, fx, e, recv, t, name, nsp, k),
            None => {
                let mut d = diag.error("E0103", nsp, "`{st.show(rt)}` has no field `{name}`")
                if builtins.names(rt).contains(name) {
                    d = d.note("`{name}` changes its receiver in place, so it cannot be a value; call it as `{name}(...)`")
                }
                (TErr, st.report(d))
            },
        },
    }
}

// How many arguments (besides the receiver) method `name` of a value of
// type `t` takes, if it has one that can be used as a value.
fn method_arity(st: env.State, cx: env.Cx, file: Int, t: types.Ty, name: Str) -> (Option[Int], env.State) {
    let (key, st) = builtin_method(st, cx, t, name, file)
    match key {
        Some(k) => {
            return (cx.fns.get(k).map(|s| s.params.len() - 1), st)
        },
        None => {},
    }
    let rt = st.repr(t)
    let arity = match rt {
        TNamed(n, _) if cx.fns.contains(n + "::" + name) && builtins.type_name(rt).is_none() => cx.fns.get(n + "::" + name).map(|s| s.params.len() - 1),
        TDyn(i, a) => iface_methods(st, cx, env.Bound { iface: i, args: a }).find(|m| m.name == name).map(|m| m.params.len()),
        TParam(g) => {
            let mut found: Option[Int] = None
            for b in bounds_of(st, g) {
                match iface_methods(st, cx, b).find(|m| m.name == name) {
                    Some(m) => {
                        found = Some(m.params.len())
                        break
                    },
                    None => {},
                }
            }
            found
        },
        // they change the receiver
        TList(_) | TMap(..) if name == "push" || name == "remove" => None,
        _ => builtins.find(rt, TErr, name).map(|m| m.params.len()),
    }
    (arity, st)
}

// `x.name` without a call, where `name` is a method: a closure that calls
// it on the value `x` had when the expression ran, as if written
// `{ let $recv = x; |a, b| $recv.name(a, b) }`. The rewritten tree is what
// both backends see; `recv` is already checked.
fn method_value(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, rt: types.Ty, name: Str, nsp: ast.Span, arity: Int) -> (types.Ty, env.State) {
    let sp = e.span
    let mut st = st
    let params = (0..<arity).map(|i| ast.ClosureParam { name: "$a{i}", ty: None, span: sp })
    let mut args: List[ast.Expr] = []
    for p in params {
        let (a, next) = st.node(EVar(p.name), sp)
        args.push(a)
        st = next
    }
    let (self_var, next) = st.node(EVar("$recv"), sp)
    let (call, next) = next.node(EMethod(self_var, name, nsp, args), sp)
    let (clo, next) = next.node(EClosure(params, call), sp)
    st = next
    let bind_recv = ast.Stmt { desc: SLet(false, "$recv", recv.span, None, recv), span: sp }
    st = st.rewrite(e, EBlock(ast.Block { stmts: [bind_recv], tail: Some(clo), span: sp }))
    let inside = fx.push().bind("$recv", env.Var { ty: rt, mutable: false, span: recv.span, kind: KLet })
    check_expr(st, cx, inside, clo)
}

// The method `name` that file `file` added to built-in type `t`, if any;
// one of the built-in methods written in Limen counts as used.
fn builtin_method(st: env.State, cx: env.Cx, t: types.Ty, name: Str, file: Int) -> (Option[Str], env.State) {
    let tn = match builtins.type_name(st.repr(t)) {
        Some(tn) => tn,
        None => {
            return (None, st)
        },
    }
    let suffix = tn + "::" + name
    let own = (cx.by_suffix.get(suffix) ?? []).find(|k| match cx.method_owner.get(k) {
        Some((_, f)) => f == file,
        None => false,
    })
    let in_methods_file = match cx.method_owner.get(suffix) {
        Some((_, f)) => f == cx.methods_file,
        None => false,
    }
    if own.is_none() && cx.fns.contains(suffix) && in_methods_file {
        let mut st = st
        st.used[suffix] = true
        return (Some(suffix), st)
    }
    (own, st)
}

// The interface methods of bound `b`, its parameters replaced by the
// bound's arguments.
pub fn iface_methods(st: env.State, cx: env.Cx, b: env.Bound) -> List[env.IfaceMethod] {
    let ms = cx.ifaces.get(b.iface) ?? []
    match cx.iface_gen.get(b.iface) {
        Some(gs) if !gs.is_empty() && gs.len() == b.args.len() => {
            let inst = gs.zip(b.args)
            ms.map(|m| { m with params: m.params.map(|p| st.subst(inst, p)), ret: st.subst(inst, m.ret) })
        },
        _ => ms,
    }
}

fn bounds_of(st: env.State, g: Str) -> List[env.Bound] {
    st.bounds.find(|b| b.param == g).map(|b| b.bounds) ?? []
}

// Whether type parameter `g` of the function being checked has bound `b`.
fn bounded(st: env.State, g: Str, b: Str) -> Bool {
    let bs = bounds_of(st, g).map(|x| x.iface)
    bs.contains(b) || (b == "Ordered" && bs.contains("Key"))
}

// ---------- struct embedding ----------

// Where a member of a struct lives.
enum Found {
    // the struct itself has it
    Own,
    // the embedded fields to go through, and the struct that has it
    Path(List[Str], Str),
    // the paths of the structs at the nearest depth that have it
    Ambiguous(List[List[Str]]),
    Missing,
}

// A method struct `t` declares itself, not one forwarded from an embedded
// struct.
fn own_method(cx: env.Cx, t: Str, name: Str) -> Bool {
    let key = t + "::" + name
    cx.fns.contains(key) && !cx.forwarders.contains(key)
}

// Where member `name` of struct `n` lives. A field access (`x.name`)
// looks for fields and methods; a call (`x.name()`) for methods only. The
// struct's own come first, then the embedded structs one depth at a time;
// two at the nearest depth that has it make it ambiguous.
fn promote(cx: env.Cx, fields: Bool, n: Str, name: Str) -> Found {
    let has = |t: Str| (fields && (cx.sfields.get(t) ?? []).any(|f| f.0 == name)) || own_method(cx, t, name)
    if has(n) {
        return Own
    }
    let embeds_of = |at: (Str, List[Str])| match cx.structs.get(at.0) {
        Some(s) => s.embeds.flat_map(|f| match s.fields.find(|x| x.name == f).map(|x| x.ty.desc) {
            Some(TyName(tn, _)) if cx.structs.contains(tn) => [(tn, at.1 + [f])],
            _ => [],
        }),
        None => [],
    }
    // the structs at shallower depths, so a struct that embeds itself (an
    // error reported elsewhere) cannot loop
    let mut seen = [n]
    let mut level = [(n, [])]
    while true {
        let next = level.flat_map(embeds_of).filter(|x| !seen.contains(x.0))
        if next.is_empty() {
            return Missing
        }
        match next.filter(|x| has(x.0)) {
            [(t, path)] => {
                return Path(path, t)
            },
            [] => {
                seen = seen + next.map(|x| x.0)
                level = next
            },
            many => {
                return Ambiguous(many.map(|x| x.1))
            },
        }
    }
    Missing
}

// `recv` (of type `rt`, already checked) followed by the embedded fields
// of `path`: the explicit form of a promoted access, `admin.User`. The
// added field names get an empty span, so tools see only what was written.
fn embed_path(st: env.State, cx: env.Cx, recv: ast.Expr, rt: types.Ty, path: List[Str]) -> (ast.Expr, types.Ty, env.State) {
    let mut st = st
    let mut x = recv
    let mut t = rt
    for fld in path {
        let ft = match st.repr(t) {
            TNamed(n, args) if cx.sfields.contains(n) => struct_fields(st, cx, n, args).find(|f| f.0 == fld).map(|f| f.1) ?? TErr,
            _ => TErr,
        }
        let (next_x, next) = st.node(EField(x, fld, { x.span with lo: x.span.hi }), x.span)
        st = next.set_type(next_x, ft)
        x = next_x
        t = ft
    }
    (x, t, st)
}

fn ambiguity(n: Str, name: Str, paths: List[List[Str]]) -> Str {
    let ways = paths.map(|p| "`" + (p + [name]).join(".") + "`").join(" and ")
    "`{name}` is ambiguous in `{n}`: it is reached through {ways}, at the same depth"
}

fn ambiguous(st: env.State, sp: ast.Span, n: Str, name: Str, paths: List[List[Str]]) -> env.State {
    let which = paths.map(|p| "`." + (p + [name]).join(".") + "`").join(" or ")
    st.report(diag.error("E0120", sp, ambiguity(n, name, paths)).note("name the embedded struct you mean: {which}"))
}

// ---------- method calls ----------

fn check_method(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, name: Str, nsp: ast.Span, args: List[ast.Expr]) -> (types.Ty, env.State) {
    let handle = match st.desc(recv) {
        EVar(g) => match fx.lookup(g) {
            Some((v, crossed)) if v.kind == KGroup => Some((g, v, crossed)),
            _ => None,
        },
        _ => None,
    }
    let (g, v, crossed) = match handle {
        Some(found) => found,
        None => {
            return check_method_value(st, cx, fx, e, recv, name, nsp, args, None)
        },
    }
    let mut st = st.set_type(recv, v.ty)
    let t = match st.repr(v.ty) {
        TGroup(t) => t,
        _ => TErr,
    }
    if crossed {
        st = st.report(diag.error("E0310", recv.span, "cannot spawn into `{g}` from inside a closure").note("call `go` directly in the group's body"))
    }
    match (name, args) {
        ("go" | "#go", [a]) => {
            // a task that returns () runs for its effect and adds no item
            // to the group's list (the backends see it as `#go`); the
            // others share one type
            let (r, next) = st.fresh()
            st = expect(next, cx, fx, a, TFn([], r))
            match st.repr(r) {
                TUnit => {
                    st = st.rewrite(e, EMethod(recv, "#go", nsp, args))
                },
                _ => {
                    st = st.unify_at(a.span, t, r)
                },
            }
            (TUnit, st)
        },
        ("go" | "#go", _) => (TUnit, check_args(st.report(diag.error("E0107", nsp, "`go` takes 1 argument, a closure with no parameters")), cx, fx, args)),
        _ => (TErr, check_args(st.report(diag.error("E0105", nsp, "a group handle only has `go`, not `{name}`")), cx, fx, args)),
    }
}

// The arguments of a method call after the receiver: put in parameter
// order, counted, and checked against the parameter types `ps`. Returns
// them, or None when order_args reported a problem with the labels.
fn method_args(st: env.State, cx: env.Cx, fx: env.Fx, name: Str, nsp: ast.Span, names: Result[List[Str], Str], defaults: List[Option[ast.Expr]], args: List[ast.Expr], ps: List[types.Ty]) -> (Option[List[ast.Expr]], env.State) {
    let (ordered, st) = order_args(st, "method `{name}`", nsp, names, defaults, args)
    let args2 = match ordered {
        None => {
            return (None, check_args(st, cx, fx, args))
        },
        Some(a) => a,
    }
    let mut st = st
    if ps.len() != args2.len() {
        let k = ps.len()
        st = st.report(diag.error("E0107", nsp, "method `{name}` takes {k} argument{env.plural(k)} besides `self`, but {args2.len()} {env.was_were(args2.len())} supplied"))
        st = check_args(st, cx, fx, args2)
    } else {
        for (a, p) in args2.zip(ps) {
            st = expect(st, cx, fx, a, p)
        }
    }
    (Some(args2), st)
}

// `rt`: the receiver's type, when `recv` is already checked
fn check_method_value(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, name: Str, nsp: ast.Span, args: List[ast.Expr], rt: Option[types.Ty]) -> (types.Ty, env.State) {
    let mut st = st
    let rt = match rt {
        Some(t) => st.repr(t),
        None => {
            let (t, next) = check_expr(st, cx, fx, recv)
            st = next
            st.repr(t)
        },
    }
    let mut name = name
    match rt {
        TNamed("Result", _) if name == "map_err" => {
            // the old name still works, with a warning and a fix that renames it
            st = st.report(diag.warning("W0001", nsp, "`map_err` is now called `map_error`").fix("rename it to `map_error`", nsp, "map_error"))
            match st.desc(e) {
                EMethod(r, _, msp, a) => {
                    st = st.rewrite(e, EMethod(r, "map_error", msp, a))
                },
                _ => {},
            }
            name = "map_error"
        },
        _ => {},
    }
    let labelled = args.any(|a| is_named(st, a))
    let written = [recv] + args.map(|a| unlabel(st, a))
    match rt {
        TErr => {
            return (TErr, check_args(st, cx, fx, args))
        },
        TVar(_) => {
            st = st.report(diag.error("E0207", recv.span, "the type of this value is not known here; add a type annotation"))
            return (TErr, check_args(st, cx, fx, args))
        },
        TDyn(..) | TParam(_) => {
            return bound_method(st, cx, fx, e, recv, rt, name, nsp, args)
        },
        _ => {},
    }
    let (key, next) = builtin_method(st, cx, rt, name, nsp.file)
    st = next
    match key {
        Some(key) => {
            // a method this file added to a built-in type: rewritten to a
            // plain call of `Str::name` (or `mod.Str::name`), receiver first
            let (inst, t, next) = instantiate(st, cx.fns.get(key) ?? env.Sig { gen: [], params: [], ret: TErr })
            st = add_bounds(next, cx, key, inst, nsp)
            match t {
                TFn([p0, ..ps], r) => {
                    st = st.unify_at(recv.span, p0, rt)
                    let (ordered, next) = method_args(st, cx, fx, name, nsp, method_params(cx, key), method_defaults(cx, key), args, ps)
                    st = next
                    match ordered {
                        Some(args2) => {
                            let (f, next) = st.node(EVar(key), nsp)
                            st = next.set_type(f, t).set_inst(f, inst)
                            st = st.rewrite(e, ECall(f, [recv] + args2))
                            // reordered by labels, or with defaults filled in
                            if labelled || args2.len() != args.len() {
                                st = keep_order(st, e, written, r)
                            }
                        },
                        None => {},
                    }
                    return (r, st)
                },
                _ => {
                    return (TErr, check_args(st, cx, fx, args))
                },
            }
        },
        None => {},
    }
    match rt {
        TNamed(n, _) if cx.sfields.contains(n) => match promote(cx, false, n, name) {
            // promoted from an embedded struct: `admin.greet()` is `admin.User.greet()`
            Path(path, _) => {
                let (r, rt2, next) = embed_path(st, cx, recv, rt, path)
                st = next.rewrite(e, EMethod(r, name, nsp, args))
                return check_method_value(st, cx, fx, e, r, name, nsp, args, Some(rt2))
            },
            Ambiguous(paths) => {
                return (TErr, check_args(ambiguous(st, nsp, n, name, paths), cx, fx, args))
            },
            _ => {},
        },
        _ => {},
    }
    match rt {
        TNamed(n, _) if cx.fns.contains(n + "::" + name) && builtins.type_name(rt).is_none() => {
            // a method: `fn name(self: T, ...)`, called with the receiver first
            let key = n + "::" + name
            let (inst, t, next) = instantiate(st, cx.fns.get(key) ?? env.Sig { gen: [], params: [], ret: TErr })
            st = add_bounds(next.set_inst(e, inst), cx, key, inst, nsp)
            match cx.method_owner.get(key) {
                Some((false, file)) if file != nsp.file => {
                    st = st.report(diag.error("E0402", nsp, "method `{name}` is private to the module that defines `{n}`").note("mark it `pub fn` in {cx.path_of(file)} to use it here"))
                },
                _ => {},
            }
            match t {
                TFn([p0, ..ps], r) => {
                    st = st.unify_at(recv.span, p0, rt)
                    let (ordered, next) = method_args(st, cx, fx, name, nsp, method_params(cx, key), method_defaults(cx, key), args, ps)
                    st = next
                    match ordered {
                        Some(args2) if labelled || args2.len() != args.len() => {
                            st = st.rewrite(e, EMethod(recv, name, nsp, args2))
                            st = keep_order(st, e, written, r)
                        },
                        _ => {},
                    }
                    (r, st)
                },
                _ => (TErr, check_args(st, cx, fx, args)),
            }
        },
        _ => builtin_method_call(st, cx, fx, e, recv, rt, name, nsp, args),
    }
}

// `x.m(...)` where `x: T` and `T` is bounded by interfaces that declare
// `m`, or `x: dyn I`.
fn bound_method(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, rt: types.Ty, name: Str, nsp: ast.Span, args: List[ast.Expr]) -> (types.Ty, env.State) {
    let mut st = st
    let (g, bs) = match rt {
        TDyn(i, a) => ("dyn " + st.show_bound(env.Bound { iface: i, args: a }), [env.Bound { iface: i, args: a }]),
        TParam(g) => (g, bounds_of(st, g)),
        _ => ("", []),
    }
    let mut found: Option[(Str, env.IfaceMethod)] = None
    for b in bs {
        match iface_methods(st, cx, b).find(|m| m.name == name) {
            Some(m) => {
                found = Some((b.iface, m))
                break
            },
            None => {},
        }
    }
    match found {
        Some((b, m)) => {
            let names = match cx.param_names.get(b + "::" + name) {
                Some(ns) => Ok(ns),
                None => Err(""),
            }
            let labelled = args.any(|a| is_named(st, a))
            let written = [recv] + args.map(|a| unlabel(st, a))
            let (ordered, next) = method_args(st, cx, fx, name, nsp, names, [], args, m.params)
            st = next
            match ordered {
                Some(args2) if labelled => {
                    st = st.rewrite(e, EMethod(recv, name, nsp, args2))
                    st = keep_order(st, e, written, m.ret)
                },
                _ => {},
            }
            (m.ret, st)
        },
        None => {
            let declared = bs.flat_map(|b| iface_methods(st, cx, b).map(|m| m.name))
            let note = if bs.is_empty() {
                "`{g}` is a type parameter with no bounds; add one, as in `[{g}: Interface]`, whose interface declares `fn {name}(self, ...)`"
            } else {
                let listed = if declared.is_empty() { "nothing" } else { declared.join(", ") }
                "the bounds of `{g}` ({bs.map(|b| st.show_bound(b)).join(", ")}) declare: {listed}"
            }
            st = st.did_you_mean(diag.error("E0105", nsp, "no method `{name}` on `{g}`").note(note), name, declared)
            (TErr, check_args(st, cx, fx, args))
        },
    }
}

// A built-in method: `xs.len()`, `s.split(",")`, `net.get(url)`, ...
fn builtin_method_call(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, rt: types.Ty, name: Str, nsp: ast.Span, args: List[ast.Expr]) -> (types.Ty, env.State) {
    let mut st = st
    let (u, next) = st.fresh()
    st = next
    let ms = builtins.methods(rt, u)
    let option_or_result = match rt {
        TNamed("Option" | "Result", _) => true,
        _ => false,
    }
    let m = match ms.find(|x| x.name == name) {
        Some(m) => m,
        None => {
            if name == "unwrap_or" && option_or_result {
                // `x.unwrap_or(d)` is written `x ?? d`
                let mut d = diag.error("E0105", nsp, "there is no `unwrap_or`; write `value ?? default`").note("`??` gives the value inside a `Some` or `Ok`, or the default otherwise, evaluating the default only then")
                match args {
                    [dflt] => {
                        d = d.fix("write it with `??`", ast.merge(recv.span, e.span), with_default(st, cx, e, recv, dflt))
                    },
                    _ => {},
                }
                return (TErr, check_args(st.report(d), cx, fx, args))
            }
            if name == "and_then" && option_or_result {
                // the same operation is called `flat_map` here, as on lists
                let d = diag.error("E0105", nsp, "there is no `and_then`; it is called `flat_map`, as on lists").note("`x.flat_map(f)` passes the value inside a `Some` or `Ok` to `f`, which returns an Option or Result itself").fix("rename it to `flat_map`", nsp, "flat_map")
                return (TErr, check_args(st.report(d), cx, fx, args))
            }
            let names = ms.map(|x| x.name)
            let builtin_names = match builtins.type_name(rt) {
                Some(tn) => cx.builtin_methods(tn),
                None => [],
            }
            let mut d = diag.error("E0105", nsp, "no method `{name}` on type `{st.show(rt)}`")
            match rt {
                TNamed(n, _) if (cx.sfields.get(n) ?? []).any(|f| f.0 == name) => {
                    d = d.note("`{name}` is a field; access it without parentheses")
                },
                TCap("Root") if builtins.root_fields().any(|f| f.0 == name) => {
                    d = d.note("`{name}` is a field of `Root`; write `root.{name}`")
                },
                TCap("Clock") if name == "after" => {
                    d = d.note("`clock.after(ms)` is a timeout: use it as a `select` arm, `clock.after(ms) => ...`, or as a group deadline, `group g until clock.after(ms) \{ ... }`").note("to wait, call `clock.sleep(ms)`")
                },
                TNamed(n, _) if ms.is_empty() => match user_methods(cx, n) {
                    [] => {
                        d = d.note("`{n}` has no methods; define one as `fn {name}(self: {n}) \{ ... }`")
                    },
                    us => {
                        d = d.note("`{n}` has: {us.join(", ")}")
                    },
                },
                _ => {},
            }
            if !ms.is_empty() && env.suggest(name, names).is_none() {
                d = d.note("`{st.show(rt)}` has: {sort_uniq(names + builtin_names).join(", ")}")
            }
            let users = match rt {
                TNamed(n, _) => user_methods(cx, n),
                _ => [],
            }
            st = st.did_you_mean(d, name, names + users + builtin_names)
            return (TErr, check_args(st, cx, fx, args))
        },
    }
    if st.no_wait > 0 {
        match waits(rt, name) {
            Some(what) => {
                st = update_waits(st, nsp, "`{name}` on `{st.show(rt)}` {what}")
            },
            None => {},
        }
    }
    match (name, rt) {
        ("join", TList(a)) => {
            st = st.unify_at(recv.span, TStr, a)
        },
        ("sum", TList(a)) => {
            st = st.unify_at(recv.span, TInt, a)
        },
        ("push", TList(_)) | ("remove", TMap(..)) => {
            st = check_place(st, cx, fx, recv)
        },
        _ => {},
    }
    if m.params.len() != args.len() {
        let k = m.params.len()
        st = st.report(diag.error("E0107", nsp, "`{name}` takes {k} argument{env.plural(k)} but {args.len()} {env.was_were(args.len())} supplied"))
        st = check_args(st, cx, fx, args)
    } else {
        for (a, p) in args.zip(m.params) {
            st = match (name, rt, a.desc) {
                // the function runs holding the lock: it must not wait
                ("update", TShared(_), EClosure(..)) => {
                    st.no_wait = st.no_wait + 1
                    let mut next = expect(st, cx, fx, a, p)
                    next.no_wait = next.no_wait - 1
                    next
                },
                _ => expect(st, cx, fx, a, p),
            }
        }
    }
    match (name, rt) {
        ("sort", TList(a)) => match unordered(st, cx, a) {
            Some(_) if st.held(st.repr(a)).is_some() => {
                st = refuse_compare(st, nsp, "sort", a)
            },
            Some(t) => {
                let d = diag.error("E0201", nsp, "`List[{st.show(a)}]` cannot be sorted: `{st.show(t)}` has no order").note("numbers, strings, Bool, and lists, tuples, structs and enums of them are ordered; to sort by a key use `xs.sort_by(key)`, for another order `list.sort_by(xs, less)`")
                st = st.report(d)
            },
            None => {},
        },
        ("contains", TList(a)) | ("contains", TArray(a, _)) => {
            st.compared = [(nsp, a, "contains")] + st.compared
        },
        _ => {},
    }
    (m.result, st)
}

// E0312: inside a closure literal given to `Shared.update`, which runs
// holding the value's lock. What else waits (a call of a function that
// waits) is a panic when it happens: "update must not wait".
fn waits(rt: types.Ty, name: Str) -> Option[Str] {
    match (rt, name) {
        (TChan(_), "send" | "recv") => Some("can wait"),
        (TShared(_), _) => Some("takes a lock another task can hold"),
        (TCap("Clock"), "sleep") | (TCap("Stdin"), _) | (TCap("Listener"), "accept") | (TCap("Conn"), "read" | "write" | "read_within" | "write_within" | "start_tls") | (TCap("Exec"), "run") => Some("can wait"),
        (TCap("Net"), "get" | "connect" | "connect_tls") => Some("can wait"),
        _ => None,
    }
}

fn update_waits(st: env.State, sp: ast.Span, what: Str) -> env.State {
    st.report(diag.error("E0312", sp, "the function given to `update` must not wait: {what}").note("`update` holds the Shared value's lock while its function runs; wait before or after it, and only compute the new value inside"))
}

fn sort_uniq(xs: List[Str]) -> List[Str] {
    let sorted = xs.sort()
    sorted.with_index().filter(|p| p.0 == 0 || sorted[p.0 - 1] != p.1).map(|p| p.1)
}

// The methods defined on user type `n`, by name, sorted.
fn user_methods(cx: env.Cx, n: Str) -> List[Str] {
    let prefix = n + "::"
    cx.fns.keys().filter(|k| k.starts_with(prefix)).map(|k| k.slice(prefix.len(), k.len())).sort()
}

// The text of the fix that writes `recv.unwrap_or(dflt)` as `recv ?? dflt`,
// parenthesized where `??` would bind differently from the method call.
fn with_default(st: env.State, cx: env.Cx, e: ast.Expr, recv: ast.Expr, dflt: ast.Expr) -> Str {
    let src = cx.text_of(recv.span.file)
    let text = |sp: ast.Span| if sp.hi <= src.len() { src.slice(sp.lo, sp.hi) } else { "" }
    let simple = |x: ast.Expr| match st.desc(x) {
        EBin(..) | EIf(..) | EMatch(..) | EClosure(..) => false,
        _ => true,
    }
    let d = if simple(dflt) { text(dflt.span) } else { "(" + text(dflt.span) + ")" }
    let r = if simple(recv) { text(recv.span) } else { "(" + text(recv.span) + ")" }
    let next = if e.span.hi < src.len() { src.slice(e.span.hi, e.span.hi + 1) } else { " " }
    let prev = if recv.span.lo > 0 { src.slice(recv.span.lo - 1, recv.span.lo) } else { " " }
    let core = r + " ?? " + d
    if next == "." || next == "[" || next == "?" || prev == "-" || prev == "!" { "(" + core + ")" } else { core }
}

// Types with an order, for `<` and `sort()`: numbers, strings (bytes),
// Bool (false first), (), and lists, arrays, tuples, structs and enums of
// ordered types, compared item by item. Returns the first type in the way,
// if any.
fn unordered(st: env.State, cx: env.Cx, t: types.Ty) -> Option[types.Ty] {
    first_in_way(st, cx, t, false, []).0
}

// Why type `t` does not satisfy the bound `Ordered`, if it does not.
pub fn unordered_why(st: env.State, cx: env.Cx, t: types.Ty) -> Option[Str] {
    unordered(st, cx, t).map(|u| "`{st.show(u)}` has no order: numbers, strings, Bool, and lists, tuples, structs and enums of them are ordered")
}

// Map keys: Int, Str, Bool, and tuples, structs and enums made of them.
// Returns the first type in the way, if any.
pub fn unkeyable(st: env.State, cx: env.Cx, t: types.Ty) -> Option[types.Ty] {
    first_in_way(st, cx, t, true, []).0
}

// The walk `unordered` (`keys` false) and `unkeyable` (`keys` true) share:
// structs and enums are fine when what they hold is, and for an order,
// lists and arrays when their items are. `seen` holds the structs and enums
// already entered, so a recursive type is entered once.
fn first_in_way(st: env.State, cx: env.Cx, t: types.Ty, keys: Bool, seen: List[Str]) -> (Option[types.Ty], List[Str]) {
    let rt = st.repr(t)
    match rt {
        TInt | TStr | TBytes | TBool | TUInt(_) | TVar(_) | TErr => (None, seen),
        TFloat | TUnit if !keys => (None, seen),
        TParam(g) if bounded(st, g, if keys { "Key" } else { "Ordered" }) => (None, seen),
        TList(a) | TArray(a, _) if !keys => first_in_way(st, cx, a, keys, seen),
        TNamed(n, args) => {
            let key = st.show(rt)
            if seen.contains(key) {
                return (None, seen)
            }
            let mut seen = seen + [key]
            let parts = match cx.structs.get(n) {
                Some(s) => {
                    let inst = s.generics.zip(args)
                    (cx.sfields.get(n) ?? []).map(|f| st.subst(inst, f.1))
                },
                None => match cx.enums.get(n) {
                    Some(en) => {
                        let inst = en.generics.zip(args)
                        (cx.variants.get(n) ?? []).flat_map(|v| v.1.map(|p| st.subst(inst, p)))
                    },
                    None => {
                        return (Some(rt), seen)
                    },
                },
            }
            for p in parts {
                let (found, next) = first_in_way(st, cx, p, keys, seen)
                seen = next
                if found.is_some() {
                    return (found, seen)
                }
            }
            (None, seen)
        },
        _ => (Some(rt), seen),
    }
}

fn check_place(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr) -> env.State {
    match st.desc(e) {
        EVar(n) => match fx.lookup(n) {
            Some((_, true)) => st.report(diag.error("E0205", e.span, "cannot modify `{n}` inside a closure").note("closures capture variables by value; return the new value from the closure instead")),
            Some((v, false)) if !v.mutable => match v.kind {
                KLet => st.report(diag.error("E0205", e.span, "cannot modify `{n}`, it is not declared `mut`").fix("declare it as `let mut {n}`", { v.span with hi: v.span.lo }, "mut ")),
                KParam => st.report(diag.error("E0205", e.span, "cannot modify parameter `{n}`").note("parameters are immutable; make a copy with `let mut {n} = {n}`")),
                KPat => st.report(diag.error("E0205", e.span, "cannot modify `{n}`, pattern and loop bindings are immutable")),
                KGroup => st.report(diag.error("E0310", e.span, "`{n}` is a group handle; the only thing you can do with it is `{n}.go(...)`")),
            },
            Some(_) => st,
            None => st.report(diag.error("E0209", e.span, "this cannot be assigned to")),
        },
        EField(r, _, _) | EIndex(r, _) => check_place(st, cx, fx, r),
        _ => st.report(diag.error("E0209", e.span, "only variables, fields and list elements can be assigned to")),
    }
}

// ---------- `?`, operators, closures, literals ----------

// Can errors of type `e` become `dyn Error`? None if so, else why not.
fn error_conversion(st: env.State, cx: env.Cx, e: types.Ty) -> (Option[Str], env.State) {
    match st.repr(e) {
        TDyn("Error", []) | TErr | TStr | TNamed("IoError", _) => (None, st),
        TVar(_) => (None, st.unify(e, TDyn("Error", [])).1),
        TNamed(n, _) if (cx.structs.contains(n) || cx.enums.contains(n)) && n != "Option" && n != "Result" => {
            let ct = st.repr(e)
            match st.held(ct) {
                Some(h) => {
                    return (Some(h), st)
                },
                None => {},
            }
            if st.subst.has_fn(ct) || st.subst.has_chan(ct) {
                return (Some("`{st.show(ct)}` holds a function or channel"), st)
            }
            satisfies(st, cx, ct, env.Bound { iface: "Error", args: [] })
        },
        t => (Some("`{st.show(t)}` does not satisfy `Error`"), st),
    }
}

// The fix that changes the function's error type to `dyn Error`.
fn dyn_error_fix(d: diag.Diag, fx: env.Fx) -> diag.Diag {
    match fx.ret_te {
        Some(te) => match te.desc {
            TyName("Result", [_, et]) => d.fix("return `dyn Error`, which any error converts to", et.span, "dyn Error"),
            _ => d,
        },
        None => d,
    }
}

fn check_try(st: env.State, cx: env.Cx, fx: env.Fx, x: ast.Expr, context: Option[ast.Expr], sp: ast.Span) -> (types.Ty, env.State) {
    if fx.in_defer > 0 {
        let st = st.report(diag.error("E0115", sp, "`?` cannot leave a `defer` body").note("handle the error inside it, for example with `??` or a `match`"))
        return (TErr, check_expr(st, cx, fx, x).1)
    }
    check_try_ok(st, cx, fx, x, context, sp)
}

fn is_dyn_error(st: env.State, t: types.Ty) -> Bool {
    match st.repr(t) {
        TDyn("Error", []) => true,
        _ => false,
    }
}

fn wrong_fn(st: env.State, sp: ast.Span, rt: types.Ty, kind: Str) -> env.State {
    let d = diag.error("E0202", sp, "`?` can only be used in a function that returns `{kind}`, this one returns `{st.show(rt)}`").note("for main, write `fn main(root: Root) -> Result[(), IoError]`")
    st.report(d)
}

// `x? "context"` wraps the error, so the function must return `dyn Error`.
// Whether there is a context.
fn with_context(st: env.State, cx: env.Cx, fx: env.Fx, context: Option[ast.Expr], sp: ast.Span) -> (Bool, env.State) {
    let c = match context {
        None => {
            return (false, st)
        },
        Some(c) => c,
    }
    let mut st = expect(st, cx, fx, c, TStr)
    match st.repr(fx.ret) {
        TNamed("Result", [_, fe]) if is_dyn_error(st, fe) => {},
        TNamed("Result", [_, fe]) => {
            let d = diag.error("E0202", sp, "`?` with context returns a `dyn Error`, but this function returns errors of type `{st.show(fe)}`")
            st = st.report(dyn_error_fix(d, fx))
        },
        TVar(_) => {
            let (v, next) = st.fresh()
            st = next.unify_at(sp, fx.ret, types.res(v, TDyn("Error", [])))
        },
        TErr => {},
        rt => {
            st = wrong_fn(st, sp, rt, "Result[_, dyn Error]")
        },
    }
    (true, st)
}

fn check_try_ok(st: env.State, cx: env.Cx, fx: env.Fx, x: ast.Expr, context: Option[ast.Expr], sp: ast.Span) -> (types.Ty, env.State) {
    let mut st = st
    if fx.in_group > 0 {
        st = st.report(diag.error("E0311", sp, "`?` cannot leave a `group` block early; every task must finish first").note("handle the error inside the task, or after the group returns its results"))
    }
    let (t, next) = check_expr(st, cx, fx, x)
    st = next
    match st.repr(t) {
        TErr => {
            match context {
                Some(c) => {
                    st = check_expr(st, cx, fx, c).1
                },
                None => {},
            }
            (TErr, st)
        },
        TNamed("Result", [a, e]) => {
            let (ctxd, next) = with_context(st, cx, fx, context, sp)
            st = next
            match st.repr(fx.ret) {
                TNamed("Result", [_, fe]) if is_dyn_error(st, fe) || ctxd => {
                    if is_dyn_error(st, fe) {
                        let (why, next) = error_conversion(st, cx, e)
                        st = next
                        match why {
                            Some(why) => {
                                let hint = if st.held(e).is_some() || st.subst.has_fn(e) || st.subst.has_chan(e) {
                                    "an error cannot carry authority: keep capabilities, functions and channels out of the error type"
                                } else {
                                    "give it a method `fn message(self: " + st.show(e) + ") -> Str`"
                                }
                                let d = diag.error("E0202", sp, "`?` cannot turn an error of type `{st.show(e)}` into `dyn Error`").note(why).note(hint)
                                st = st.report(d)
                            },
                            None => {},
                        }
                    }
                },
                TNamed("Result", [_, fe]) => {
                    let (ok, next) = st.unify(fe, e)
                    st = next
                    if !ok {
                        let (we, next) = error_conversion(st, cx, e)
                        let (wf, next) = if we.is_none() { error_conversion(next, cx, fe) } else { (we, next) }
                        st = next
                        let mut d = diag.error("E0202", sp, "`?` would return an error of type `{st.show(e)}`, but this function returns errors of type `{st.show(fe)}`").note("convert the error first with `.map_error(|e| ...)`, or return `dyn Error`, which any error type with a `message` method converts to")
                        if we.is_none() && wf.is_none() {
                            d = dyn_error_fix(d, fx)
                        }
                        st = st.report(d)
                    }
                },
                TVar(_) => {
                    if !ctxd {
                        let (v, next) = st.fresh()
                        st = next.unify_at(sp, fx.ret, types.res(v, e))
                    }
                },
                TErr => {},
                rt => {
                    if !ctxd {
                        st = wrong_fn(st, sp, rt, "Result")
                    }
                },
            }
            (a, st)
        },
        TNamed("Option", [a]) => {
            // with context, a None becomes an error whose message is the context
            let (ctxd, next) = with_context(st, cx, fx, context, sp)
            st = next
            if !ctxd {
                match st.repr(fx.ret) {
                    TNamed("Option", _) | TErr => {},
                    TVar(_) => {
                        let (v, next) = st.fresh()
                        st = next.unify_at(sp, fx.ret, types.opt(v))
                    },
                    rt => {
                        st = wrong_fn(st, sp, rt, "Option")
                    },
                }
            }
            (a, st)
        },
        TVar(_) => (TErr, st.report(diag.error("E0207", x.span, "the type of this value is not known here; add a type annotation"))),
        other => (TErr, st.report(diag.error("E0202", x.span, "`?` needs a `Result` or `Option`, found `{st.show(other)}`"))),
    }
}

fn op_name(op: ast.BinOp) -> Str {
    match op {
        Add => "+",
        Sub => "-",
        Mul => "*",
        Div => "/",
        Mod => "%",
        Eq => "==",
        Ne => "!=",
        Lt => "<",
        Le => "<=",
        Gt => ">",
        Ge => ">=",
        And => "&&",
        Or => "||",
        Else => "??",
        Range => "..<",
        BitAnd => "&",
        BitOr => "|",
        BitXor => "^",
        Shl => "<<",
        Shr => ">>",
    }
}

fn check_bin(st: env.State, cx: env.Cx, fx: env.Fx, op: ast.BinOp, a: ast.Expr, b: ast.Expr, sp: ast.Span) -> (types.Ty, env.State) {
    let (ta, st) = check_expr(st, cx, fx, a)
    match op {
        And | Or => (TBool, expect(st.unify_at(a.span, TBool, ta), cx, fx, b, TBool)),
        // `lo..<hi`: the Ints from lo up to but not including hi
        Range => (TList(TInt), expect(st.unify_at(a.span, TInt, ta), cx, fx, b, TInt)),
        // `opt ?? default`: the value inside, or the default when there is none
        Else => match st.repr(ta) {
            TNamed("Option", [t]) | TNamed("Result", [t, _]) => (t, expect(st, cx, fx, b, t)),
            TErr => (TErr, check_expr(st, cx, fx, b).1),
            TVar(_) => {
                let st = st.report(diag.error("E0207", a.span, "the type of this value is not known here; add a type annotation"))
                (TErr, check_expr(st, cx, fx, b).1)
            },
            t => {
                let st = st.report(diag.error("E0201", sp, "`??` needs an `Option` or `Result` on its left, found `{st.show(t)}`"))
                (TErr, check_expr(st, cx, fx, b).1)
            },
        },
        _ => {
            // a literal on the left takes the right's type: `1 + x` with x a UInt8
            let (ta, st) = match (st.desc(a), st.repr(ta)) {
                (EInt(_), TInt) => {
                    let (tb, st2) = check_expr(st, cx, fx, b)
                    match st2.repr(tb) {
                        TUInt(_) => (tb, expect(st2, cx, fx, a, tb)),
                        _ => (ta, st2.unify_at(b.span, ta, tb)),
                    }
                },
                _ => (ta, expect(st, cx, fx, b, ta)),
            }
            let t = st.repr(ta)
            let bad = |st: env.State| st.report(diag.error("E0201", sp, "operator `{op_name(op)}` cannot be applied to `{st.show(t)}`"))
            match op {
                Add => match t {
                    TInt | TFloat | TStr | TBytes | TUInt(_) | TList(_) | TErr | TVar(_) => (t, st),
                    _ => (TErr, bad(st)),
                },
                Sub | Mul | Div => match t {
                    TInt | TFloat | TUInt(_) | TErr | TVar(_) => (t, st),
                    _ => (TErr, bad(st)),
                },
                Mod | BitAnd | BitOr | BitXor | Shl | Shr => match t {
                    TInt | TUInt(_) | TErr | TVar(_) => (t, st),
                    _ => (TErr, bad(st)),
                },
                Lt | Le | Gt | Ge => (TBool, if unordered(st, cx, t).is_some() { bad(st) } else { st }),
                _ => {
                    let mut st = st
                    st.eq_types = [t] + st.eq_types
                    match st.subst.refused(env.equality(), t) {
                        Some(Itself) => (TBool, bad(st)),
                        Some(Inside(u)) => (TBool, st.report(diag.error("E0201", sp, "operator `{op_name(op)}` cannot be applied to `{st.show(t)}`").note(st.holds_uncomparable(t, u)))),
                        // capabilities have no equality, so neither has a value holding one
                        None => match st.held(t) {
                            Some(h) => (TBool, st.report(diag.error("E0201", sp, "operator `{op_name(op)}` cannot be applied to `{st.show(t)}`").note(h + ", and capabilities cannot be compared"))),
                            None => (TBool, st),
                        },
                    }
                },
            }
        },
    }
}

fn check_closure(st: env.State, cx: env.Cx, fx: env.Fx, ps: List[ast.ClosureParam], body: ast.Expr, want: Option[types.Ty]) -> (types.Ty, env.State) {
    let mut st = st
    let (want_ps, want_ret) = match want.map(|w| st.repr(w)) {
        Some(TFn(wp, wr)) if wp.len() == ps.len() => (Some(wp), Some(wr)),
        _ => (None, None),
    }
    let mut scope = env.Scope { vars: map(), barrier: true }
    let mut pts: List[types.Ty] = []
    for (i, p) in ps.with_index() {
        let t = match (p.ty, want_ps) {
            (Some(te), _) => {
                let (t, next) = st.resolve(cx, fx.genv, te)
                st = next
                t
            },
            (None, Some(wp)) => wp[i],
            (None, None) => {
                let (t, next) = st.fresh()
                st = next
                t
            },
        }
        scope.vars[p.name] = env.Var { ty: t, mutable: false, span: p.span, kind: KParam }
        pts.push(t)
    }
    let ret = match want_ret {
        Some(r) => r,
        None => {
            let (r, next) = st.fresh()
            st = next
            r
        },
    }
    let inside = env.Fx { ret, scopes: [scope] + fx.scopes, loops: 0, genv: fx.genv, in_group: 0, in_defer: 0, ret_te: None }
    let (bt, st) = check_expr(st, cx, inside, body)
    (TFn(pts, ret), st.unify_at(body.span, ret, bt))
}

// `field: value` pairs set once each, and every value checked: against the
// field's type, or alone when the struct has no such field. `extra_notes`
// says more about a field the struct does not have.
fn check_field_inits(st: env.State, cx: env.Cx, fx: env.Fx, name: Str, decl: List[(Str, types.Ty)], inst: List[(Str, types.Ty)], fields: List[ast.FieldInit], extra_notes: fn(Str) -> List[Str]) -> (List[Str], env.State) {
    let mut st = st
    let mut seen: List[Str] = []
    for f in fields {
        if seen.contains(f.name) {
            st = st.report(diag.error("E0106", f.span, "field `{f.name}` is set twice"))
        } else {
            seen.push(f.name)
        }
        match decl.find(|x| x.0 == f.name) {
            Some((_, ft)) => {
                st = expect(st, cx, fx, f.value, st.subst(inst, ft))
            },
            None => {
                let d = extra_notes(f.name).fold(diag.error("E0103", f.span, "struct `{name}` has no field `{f.name}`"), |d, n| d.note(n))
                st = st.did_you_mean(d, f.name, decl.map(|x| x.0))
                st = check_expr(st, cx, fx, f.value).1
            },
        }
    }
    (seen, st)
}

fn check_struct_lit(st: env.State, cx: env.Cx, fx: env.Fx, name: Str, nsp: ast.Span, fields: List[ast.FieldInit], sp: ast.Span) -> (types.Ty, env.State) {
    let mut st = st
    let decl = match cx.sfields.get(name) {
        Some(d) => d,
        None => {
            if cx.enums.contains(name) {
                st = st.report(diag.error("E0102", nsp, "`{name}` is an enum; build it with a variant, for example `{name}.Variant(...)`"))
            } else {
                st = st.did_you_mean(diag.error("E0102", nsp, "unknown struct `{name}`"), name, env.keys_in_order(cx.sfields))
            }
            for f in fields {
                st = check_expr(st, cx, fx, f.value).1
            }
            return (TErr, st)
        },
    }
    let gen = cx.structs.get(name).map(|s| s.generics) ?? []
    let (targs, next) = st.fresh_list(gen.len())
    st = next.add_type_bounds(cx, name, targs, nsp)
    let embedded = |fname: Str| match promote(cx, true, name, fname) {
        Path(p, _) => {
            let top = p[0]
            ["`{fname}` belongs to the embedded `{p.join(".")}`; set it there: `{top}: {top} \{ {fname}: ... }`"]
        },
        _ => [],
    }
    let (seen, next) = check_field_inits(st, cx, fx, name, decl, gen.zip(targs), fields, embedded)
    st = next
    let missing = decl.filter(|f| !seen.contains(f.0))
    if !missing.is_empty() {
        let listed = missing.map(|f| "`" + f.0 + "`").join(", ")
        st = st.report(diag.error("E0206", sp, "missing field{env.plural(missing.len())} {listed} in `{name}`"))
    }
    (TNamed(name, targs), st)
}

// `a?.b`: `rest` runs on the value inside the Option `a`, bound to `x`.
// The result is an Option: the rest's own when it is one already (so
// `a?.b?.c` is not nested), otherwise the rest wrapped in Some.
fn check_safe(st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, base: ast.Expr, x: Str, rest: ast.Expr) -> (types.Ty, env.State) {
    let (bt, st) = check_expr(st, cx, fx, base)
    let mut st = st
    let inner = match st.repr(bt) {
        TNamed("Option", [t]) => t,
        TErr => TErr,
        TVar(_) => {
            st = st.report(diag.error("E0207", base.span, "the type of this value is not known here; add a type annotation"))
            TErr
        },
        TNamed("Result", _) => {
            let d = diag.error("E0201", base.span, "`?.` works on an `Option`, but this is `{st.show(bt)}`").note("`?.` is safe navigation; to return early on `Err` and then use the value, write `(e?).name`")
            st = st.report(d)
            TErr
        },
        t => {
            st = st.report(diag.error("E0201", base.span, "`?.` needs an `Option` on its left, found `{st.show(t)}`").note("a value that is always there takes a plain `.`"))
            TErr
        },
    }
    let inside = fx.push().bind(x, env.Var { ty: inner, mutable: false, span: base.span, kind: KPat })
    let (rt, st) = check_expr(st, cx, inside, rest)
    match (st.repr(bt), st.repr(rt)) {
        (TNamed("Option", _), TNamed("Option", _)) => {
            let mut st = st
            st.nested[e.id] = true
            (rt, st)
        },
        (TNamed("Option", _), TErr) => (TErr, st),
        (TNamed("Option", _), _) => (types.opt(rt), st),
        _ => (TErr, st),
    }
}

// `{ base with x: 1, y }`: a copy of a struct value with some fields
// replaced; the same field errors as a struct literal, minus "missing".
fn check_with(st: env.State, cx: env.Cx, fx: env.Fx, base: ast.Expr, fields: List[ast.FieldInit], sp: ast.Span) -> (types.Ty, env.State) {
    let (bt, st) = check_expr(st, cx, fx, base)
    let others = |st: env.State| fields.fold(st, |st, f| check_expr(st, cx, fx, f.value).1)
    match st.repr(bt) {
        TNamed(name, targs) if cx.sfields.contains(name) && !ast.is_tuple_name(name) => {
            let gen = cx.structs.get(name).map(|s| s.generics) ?? []
            let (_, st) = check_field_inits(st, cx, fx, name, cx.sfields.get(name) ?? [], gen.zip(targs), fields, |_| [])
            (bt, st)
        },
        TErr => (TErr, others(st)),
        TVar(_) => (TErr, others(st.report(diag.error("E0207", base.span, "the type of this value is not known here; add a type annotation")))),
        t => {
            let d = diag.error("E0201", base.span, "`\{ ... with ... }` copies a struct, but this is `{st.show(t)}`").note("only struct values have named fields to replace")
            (TErr, others(st.report(d)))
        },
    }
}

// ---------- match and patterns ----------

fn check_match(st: env.State, cx: env.Cx, fx: env.Fx, s: ast.Expr, arms: List[ast.Arm], sp: ast.Span, want: Option[types.Ty]) -> (types.Ty, env.State) {
    let (scrutinee, st) = check_expr(st, cx, fx, s)
    let errors_before = st.error_count()
    let (result, st) = match want {
        Some(w) => (w, st),
        None => st.fresh(),
    }
    let mut st = st
    for arm in arms {
        let (inside, next) = check_pat(st, cx, fx.push(), scrutinee, arm.pat)
        st = next
        match arm.guard {
            Some(g) => {
                st = expect(st, cx, inside, g, TBool)
            },
            None => {},
        }
        match want {
            Some(w) => {
                st = expect(st, cx, inside, arm.body, w)
            },
            None => {
                let (bt, next) = check_expr(st, cx, inside, arm.body)
                st = next.unify_at(arm.body.span, result, bt)
            },
        }
    }
    // an arm, or an alternative in one, that the unguarded arms before it
    // already cover can never run (not looked for after an error in the
    // arms, whose patterns may then not fit their type)
    if st.error_count() == errors_before {
        let mut before: List[List[ast.Pat]] = []
        for arm in arms {
            let alts = exhaust.alternatives(arm.pat)
            if !exhaust.useful(cx, st.subst, true, before, [arm.pat], [scrutinee]) {
                st = st.report(diag.warning("W0002", arm.pat.span, "this arm can never match: the arms before it cover every value it matches"))
            } else if alts.len() > 1 {
                let mut seen = before
                for alt in alts {
                    if !exhaust.useful(cx, st.subst, true, seen, [alt], [scrutinee]) {
                        st = st.report(diag.warning("W0002", alt.span, "this alternative can never match: the arms and alternatives before it cover every value it matches"))
                    }
                    seen = [[alt]] + seen
                }
            }
            if arm.guard.is_none() {
                before = [[arm.pat]] + before
            }
        }
    }
    if arms.is_empty() {
        return (result, st.report(diag.error("E0204", sp, "`match` needs at least one arm")))
    }
    // a guarded arm may not apply, so it covers nothing
    let unguarded = arms.filter(|a| a.guard.is_none()).map(|a| a.pat)
    let missing = exhaust.missing_arms(cx, st.subst, scrutinee, unguarded)
    if missing.is_empty() {
        return (result, st)
    }
    // the new arms go on their own lines just above the closing brace
    let close = sp.hi - 1
    let src = cx.text_of(sp.file)
    let line_start = line_start_before(src, close - 1)
    let indent = if close <= src.len() { src.slice(line_start, close) } else { "" }
    let own_line = indent.trim() == ""
    let at = if own_line { line_start } else { close }
    let arm_indent = (if own_line { indent } else { "" }) + "    "
    let text = (if own_line { "" } else { "\n" }) + missing.map(|m| "{arm_indent}{m} => panic(\"unhandled\"),\n").join("")
    let d = diag.error("E0204", sp, "`match` does not cover {missing.map(|m| "`" + m + "`").join(", ")}").fix("add the missing arms", { sp with lo: at, hi: at }, text)
    (result, st.report(d))
}

// Where the line holding byte `i` of `src` starts: after the last newline
// at or before `i`, as OCaml's String.rindex_from finds it.
fn line_start_before(src: Str, i: Int) -> Int {
    if i < 0 || i >= src.len() {
        return 0
    }
    let bs = src.bytes()
    let mut k = i
    while k >= 0 {
        if bs[k] == 10 {
            return k + 1
        }
        k = k - 1
    }
    0
}

// Bind the names of pattern `p` for a value of type `t`.
fn check_pat(st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, p: ast.Pat) -> (env.Fx, env.State) {
    let mut st = st
    let mut fx = fx
    let bind = |fx: env.Fx, n: Str, ty: types.Ty, span: ast.Span| fx.bind(n, env.Var { ty, mutable: false, span, kind: KPat })
    // every part of the pattern, against a type already reported
    let all_err = |st: env.State, fx: env.Fx, ps: List[ast.Pat]| check_pats(st, cx, fx, ps.map(|_| TErr), ps)
    match p.desc {
        PWild => (fx, st),
        PBind(n) => (bind(fx, n, t, p.span), st),
        PInt(v) => match st.repr(t) {
            // an unsigned integer matches literals that fit in it
            TUInt(bits) => {
                if v < 0 {
                    (fx, st.report(diag.error("E0201", p.span, "a `UInt{bits}` cannot be negative")))
                } else if bits < 64 && v >= 1 << bits {
                    (fx, st.report(diag.error("E0201", p.span, "{v} does not fit in a `UInt{bits}`, which holds 0 to {(1 << bits) - 1}")))
                } else {
                    (fx, st)
                }
            },
            _ => (fx, st.unify_at(p.span, t, TInt)),
        },
        PStr(_) => (fx, st.unify_at(p.span, t, TStr)),
        PBool(_) => (fx, st.unify_at(p.span, t, TBool)),
        PTuple(ps) if ps.any(exhaust.is_rest) => match st.repr(t) {
            // `(a, ..)`: the tuple's size comes from its type
            TNamed(n, ts) if ast.is_tuple_name(n) => {
                if ps.len() - 1 > ts.len() {
                    st = st.report(diag.error("E0107", p.span, "the tuple has {ts.len()} items, the pattern has at least {ps.len() - 1}"))
                    return all_err(st, fx, ps)
                }
                check_pats(st, cx, fx, ts, exhaust.fill_rest(ps, ts.len()))
            },
            TErr => all_err(st, fx, ps),
            TVar(_) => {
                st = st.report(diag.error("E0207", p.span, "the type of this value is not known here, so `..` cannot stand for its other items; add a type annotation"))
                all_err(st, fx, ps)
            },
            other => {
                st = st.report(diag.error("E0201", p.span, "this pattern is a tuple, but the value is `{st.show(other)}`"))
                all_err(st, fx, ps)
            },
        },
        PTuple(ps) => {
            let (ts, next) = st.fresh_list(ps.len())
            st = next.unify_at(p.span, TNamed(ast.tuple_name(ps.len()), ts), t)
            check_pats(st, cx, fx, ts, ps)
        },
        PList(ps) => {
            let (el, next) = st.fresh()
            st = next.unify_at(p.span, TList(el), t)
            for q in ps {
                match q.desc {
                    PRest(Some(n)) => {
                        fx = bind(fx, n, TList(el), q.span)
                    },
                    _ => {
                        let (f, next) = check_pat(st, cx, fx, el, q)
                        fx = f
                        st = next
                    },
                }
            }
            (fx, st)
        },
        // only inside a tuple, variant or list pattern, which handle it
        PRest(_) => (fx, st),
        PAs(q, n, nsp) => {
            let (fx, st) = check_pat(st, cx, fx, t, q)
            (bind(fx, n, t, nsp), st)
        },
        PStruct(name, nsp, fields, rest) => check_struct_pat(st, cx, fx, t, p, name, nsp, fields, rest),
        POr(alts) => check_or(st, cx, fx, t, alts),
        PVariant(q, v, args) => check_variant_pat(st, cx, fx, t, p, q, v, args),
    }
}

// `Point \{ x, y: 0, .. }`: the struct's fields, each matched against its
// pattern; without `..`, every field is named.
fn check_struct_pat(st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, p: ast.Pat, name: Str, nsp: ast.Span, fields: List[ast.FieldPat], rest: Bool) -> (env.Fx, env.State) {
    let mut st = st
    let decl = match cx.sfields.get(name) {
        Some(d) => d,
        None => {
            if cx.enums.contains(name) {
                st = st.report(diag.error("E0102", nsp, "`{name}` is an enum; match it with its variants, for example `{name}.Variant(...)`"))
            } else {
                st = st.did_you_mean(diag.error("E0102", nsp, "unknown struct `{name}`"), name, env.keys_in_order(cx.sfields))
            }
            return check_pats(st, cx, fx, fields.map(|_| TErr), fields.map(|f| f.pat))
        },
    }
    let gen = cx.structs.get(name).map(|s| s.generics) ?? []
    let (targs, next) = st.fresh_list(gen.len())
    st = next.unify_at(p.span, t, TNamed(name, targs))
    let inst = gen.zip(targs)
    let mut fx = fx
    let mut seen: List[Str] = []
    for f in fields {
        if seen.contains(f.name) {
            st = st.report(diag.error("E0106", f.span, "field `{f.name}` is matched twice"))
        } else {
            seen.push(f.name)
        }
        let ft = match decl.find(|x| x.0 == f.name) {
            Some((_, ft)) => st.subst(inst, ft),
            None => {
                st = st.did_you_mean(diag.error("E0103", f.span, "struct `{name}` has no field `{f.name}`"), f.name, decl.map(|x| x.0))
                TErr
            },
        }
        let (inside, next) = check_pat(st, cx, fx, ft, f.pat)
        fx = inside
        st = next
    }
    let missing = decl.filter(|f| !seen.contains(f.0))
    if !missing.is_empty() && !rest {
        let listed = missing.map(|f| "`" + f.0 + "`").join(", ")
        st = st.report(diag.error("E0206", p.span, "missing field{env.plural(missing.len())} {listed} in the pattern for `{name}`").note("name every field, or end the pattern with `..` to match any value of the others"))
    }
    (fx, st)
}

fn check_pats(st: env.State, cx: env.Cx, fx: env.Fx, ts: List[types.Ty], ps: List[ast.Pat]) -> (env.Fx, env.State) {
    let mut st = st
    let mut fx = fx
    for (t, p) in ts.zip(ps) {
        let (f, next) = check_pat(st, cx, fx, t, p)
        fx = f
        st = next
    }
    (fx, st)
}

// `A | B`: each alternative in a scope of its own, to compare what they
// bind; the names of the first are bound, in order of name.
fn check_or(st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, alts: List[ast.Pat]) -> (env.Fx, env.State) {
    let mut st = st
    let binds_of = |st: env.State, alt: ast.Pat| {
        let (inside, st) = check_pat(st, cx, fx.push(), t, alt)
        (inside.scopes[0].vars.entries().sort_by(|x| x.0), st)
    }
    let (first, next) = binds_of(st, alts[0])
    st = next
    let same = "every alternative of `A | B` must bind the same names, with the same types"
    for alt in alts.skip(1) {
        let (vs, next) = binds_of(st, alt)
        st = next
        let names = |l: List[(Str, env.Var)]| l.map(|x| x.0)
        let only_first = names(first).filter(|n| !names(vs).contains(n))
        let only_this = names(vs).filter(|n| !names(first).contains(n))
        match (only_first, only_this) {
            ([n, ..], _) => {
                st = st.report(diag.error("E0210", alt.span, "`{n}` is bound in the first alternative but not in this one").note(same))
            },
            ([], [n, ..]) => {
                st = st.report(diag.error("E0210", alt.span, "`{n}` is bound in this alternative but not in the first one").note(same))
            },
            ([], []) => {
                for (n, v) in vs {
                    let v0 = first.find(|x| x.0 == n).map(|x| x.1) ?? v
                    let (ok, next) = st.unify(v0.ty, v.ty)
                    st = next
                    if !ok {
                        st = st.report(diag.error("E0210", v.span, "`{n}` is `{st.show(v0.ty)}` in the first alternative and `{st.show(v.ty)}` in this one").note(same))
                    }
                }
            },
        }
    }
    let mut fx = fx
    for (n, v) in first {
        fx = fx.bind(n, v)
    }
    (fx, st)
}

fn check_variant_pat(st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, p: ast.Pat, q: Option[Str], v: Str, args: List[ast.Pat]) -> (env.Fx, env.State) {
    let mut st = st
    let rt = st.repr(t)
    let skip = |st: env.State| check_pats(st, cx, fx, args.map(|_| TErr), args)
    let en = match q {
        Some(e) => {
            if cx.enums.contains(e) {
                e
            } else {
                st = st.did_you_mean(diag.error("E0102", p.span, "unknown enum `{e}`"), e, env.keys_in_order(cx.enums))
                return skip(st)
            }
        },
        None => match rt {
            TNamed(n, _) if (cx.variants.get(n) ?? []).any(|x| x.0 == v) => n,
            _ => {
                let scope = if cx.owners.contains(v) { variant_scope(cx, v, p.span.file) } else { [] }
                match scope {
                    [e] => e,
                    [e, ..] => {
                        st = st.report(diag.error("E0104", p.span, "`{v}` is a variant of several enums ({scope.join(", ")}); qualify it, for example `{e}.{v}`"))
                        return skip(st)
                    },
                    [] => {
                        let cands = match rt {
                            TNamed(n, _) if cx.variants.contains(n) => (cx.variants.get(n) ?? []).map(|x| x.0),
                            _ => env.keys_in_order(cx.owners),
                        }
                        st = st.did_you_mean(diag.error("E0104", p.span, "unknown variant `{v}`"), v, cands)
                        return skip(st)
                    },
                }
            },
        },
    }
    let vs = cx.variants.get(en) ?? []
    let payload = match vs.find(|x| x.0 == v) {
        Some(x) => x.1,
        None => {
            st = st.did_you_mean(diag.error("E0104", p.span, "enum `{en}` has no variant `{v}`"), v, vs.map(|x| x.0))
            return skip(st)
        },
    }
    let gen = cx.enums.get(en).map(|e| e.generics) ?? []
    let (targs, next) = st.fresh_list(gen.len())
    st = next.unify_at(p.span, t, TNamed(en, targs))
    let inst = gen.zip(targs)
    let ptys = payload.map(|x| st.subst(inst, x))
    let rest = args.any(exhaust.is_rest)
    let given = args.len() - (if rest { 1 } else { 0 })
    if (rest && given > ptys.len()) || (!rest && given != ptys.len()) {
        let k = ptys.len()
        st = st.report(diag.error("E0107", p.span, "variant `{v}` has {k} field{env.plural(k)}, the pattern has {if rest { "at least " } else { "" }}{given}"))
        return skip(st)
    }
    check_pats(st, cx, fx, ptys, exhaust.fill_rest(args, ptys.len()))
}

// ---------- select, blocks, statements ----------

fn check_select(st: env.State, cx: env.Cx, fx: env.Fx, arms: List[ast.SelArm], sp: ast.Span) -> (types.Ty, env.State) {
    let mut st = st
    let is_default = |a: ast.SelArm| match a.op {
        SelDefault => true,
        _ => false,
    }
    let defaults = arms.filter(is_default)
    if defaults.len() > 1 {
        st = st.report(diag.error("E0106", sp, "`select` has more than one `_` arm"))
    }
    for a in arms {
        if is_default(a) && a.guard.is_some() {
            st = st.report(diag.error("E0003", a.span, "the `_` arm of a `select` cannot have a guard"))
        }
    }
    if defaults.len() == arms.len() {
        st = st.report(diag.error("E0003", sp, "`select` needs at least one channel arm: `v = ch.recv() => ...` or `ch.send(x) => ...`"))
    }
    let afters = arms.filter(|a| match a.op {
        SelAfter(..) => true,
        _ => false,
    })
    if !afters.is_empty() && !defaults.is_empty() {
        st = st.report(diag.error("E0003", afters[0].span, "a `select` with a `_` arm never waits, so it cannot also have a `clock.after` timeout"))
    }
    let (rt, next) = st.fresh()
    st = next
    // the element type of a channel
    let chan_el = |st: env.State, ch: ast.Expr| {
        let (ct, st) = check_expr(st, cx, fx, ch)
        match st.repr(ct) {
            TChan(el) => (el, st),
            TErr => (TErr, st),
            TVar(_) => {
                let (el, st) = st.fresh()
                (el, st.unify_at(ch.span, TChan(el), ct))
            },
            t => (TErr, st.report(diag.error("E0201", ch.span, "`select` works on channels, found `{st.show(t)}`"))),
        }
    }
    for a in arms {
        match a.guard {
            Some(g) => {
                st = expect(st, cx, fx, g, TBool)
            },
            None => {},
        }
        let mut inside = fx.push()
        match a.op {
            SelRecv(b, ch) => {
                let (el, next) = chan_el(st, ch)
                st = next
                match b {
                    Some(name) => {
                        inside = inside.bind(name.text, env.Var { ty: types.opt(el), mutable: false, span: name.span, kind: KPat })
                    },
                    None => {},
                }
            },
            SelSend(ch, v) => {
                let (el, next) = chan_el(st, ch)
                st = expect(next, cx, fx, v, el)
            },
            SelAfter(clock, ms) => {
                let (ct, next) = check_expr(st, cx, fx, clock)
                st = next
                match st.repr(ct) {
                    TCap("Clock") | TErr => {},
                    TVar(_) => {
                        st = st.unify_at(clock.span, TCap("Clock"), ct)
                    },
                    t => {
                        let d = diag.error("E0201", clock.span, "`after` in a `select` needs a `Clock`, found `{st.show(t)}`").note("a timeout arm is `clock.after(ms) => ...`, with the `Clock` from `root.clock`")
                        st = st.report(d)
                    },
                }
                st = expect(st, cx, fx, ms, TInt)
            },
            SelDefault => {},
        }
        st = expect(st, cx, inside, a.body, rt)
    }
    (rt, st)
}

// The statements of a block, in a scope of its own; whether one of them
// never falls through.
fn check_stmts(st: env.State, cx: env.Cx, fx: env.Fx, b: ast.Block) -> (Bool, env.Fx, env.State) {
    let mut st = st
    let mut fx = fx.push()
    let mut diverges = false
    for s in b.stmts {
        let (d, f, next) = check_stmt(st, cx, fx, s)
        diverges = d || diverges
        fx = f
        st = next
    }
    (diverges, fx, st)
}

pub fn check_block(st: env.State, cx: env.Cx, fx: env.Fx, b: ast.Block) -> (types.Ty, env.State) {
    let (diverges, inside, st) = check_stmts(st, cx, fx, b)
    match b.tail {
        Some(e) => check_expr(st, cx, inside, e),
        None => if diverges { st.fresh() } else { (TUnit, st) },
    }
}

// A block checked against the type its value must have.
pub fn expect_block(st: env.State, cx: env.Cx, fx: env.Fx, b: ast.Block, want: types.Ty) -> env.State {
    let (diverges, inside, st) = check_stmts(st, cx, fx, b)
    match b.tail {
        Some(e) => expect(st, cx, inside, e, want),
        None => if diverges { st } else { st.unify_at({ b.span with lo: b.span.lo.max(b.span.hi - 1) }, want, TUnit) },
    }
}

fn loop_block(st: env.State, cx: env.Cx, fx: env.Fx, b: ast.Block) -> env.State {
    check_block(st, cx, { fx with loops: fx.loops + 1 }, b).1
}

// Returns true when the statement never falls through.
fn check_stmt(st: env.State, cx: env.Cx, fx: env.Fx, s: ast.Stmt) -> (Bool, env.Fx, env.State) {
    let mut st = st
    match s.desc {
        SLet(_, n, nsp, Some(te), e) if n.starts_with("$assign") && is_tuple_annotation(te) => {
            // the right side of `(a, b) = e`, expanded when modules load;
            // the annotation `#tupleN` says how many parts the left side takes
            let tn = match te.desc {
                TyName(tn, _) => tn,
                _ => "",
            }
            let k = tn.slice(6, tn.len()).parse_int() ?? 0
            let (t, next) = check_expr(st, cx, fx, e)
            st = next
            let t = match st.repr(t) {
                TNamed(tn2, ts) if ast.is_tuple_name(tn2) && ts.len() == k => t,
                TErr => TErr,
                TVar(_) => {
                    let (parts, next) = st.fresh_list(k)
                    let u = TNamed(tn, parts)
                    st = next.unify_at(e.span, u, t)
                    u
                },
                other => {
                    let d = diag.error("E0211", e.span, "the left side assigns {k} values, but the right side is `{st.show(other)}`").note("the right side of `({(0..<k).map(|i| (97 + i % 26).to_char()).join(", ")}) = value` must be a tuple of {k} items")
                    st = st.report(d)
                    TErr
                },
            }
            (false, fx.bind(n, env.Var { ty: t, mutable: false, span: nsp, kind: KLet }), st)
        },
        SLet(m, n, nsp, ann, e) => {
            let t = match ann {
                Some(te) => {
                    let (at, next) = st.resolve(cx, fx.genv, te)
                    st = expect(next, cx, fx, e, at)
                    at
                },
                None => {
                    let (t, next) = check_expr(st, cx, fx, e)
                    st = next
                    t
                },
            }
            // known before the name is bound: `let c = c.only("z")` narrows the old `c`
            if !m {
                match known_foreign(st, fx, e) {
                    Some(s) => {
                        st.foreign_known = [((n, nsp), s)] + st.foreign_known
                    },
                    None => {},
                }
            }
            (false, fx.bind(n, env.Var { ty: t, mutable: m, span: nsp, kind: KLet }), st)
        },
        SAssign(lhs, rhs) => {
            st = check_place(st, cx, fx, lhs)
            let is_group = match st.desc(lhs) {
                EVar(n) => match fx.lookup(n) {
                    Some((v, _)) => v.kind == KGroup,
                    None => false,
                },
                _ => false,
            }
            let lt = if is_group {
                TErr
            } else {
                let (t, next) = check_expr(st, cx, fx, lhs)
                st = next
                t
            }
            match st.desc(lhs) {
                EBlock(_) => {
                    st = st.report(diag.error("E0209", lhs.span, "a method cannot be assigned to"))
                },
                EIndex(b, _) if st.repr(st.type_of(b)) == TBytes => {
                    let d = diag.error("E0209", lhs.span, "`Bytes` cannot be changed in place").note("build a new value: `b.slice(0, i) + bytes([x]) + b.slice(i + 1, b.len())`")
                    st = st.report(d)
                },
                _ => {},
            }
            (false, fx, expect(st, cx, fx, rhs, lt))
        },
        SExpr(e) => (false, fx, check_expr(st, cx, fx, e).1),
        SReturn(value) => {
            if fx.in_defer > 0 {
                st = st.report(diag.error("E0115", s.span, "`return` cannot leave a `defer` body"))
            } else if fx.in_group > 0 {
                st = st.report(diag.error("E0311", s.span, "`return` cannot leave a `group` block early; every task must finish first"))
            }
            st = match value {
                Some(e) => expect(st, cx, fx, e, fx.ret),
                None => st.unify_at(s.span, fx.ret, TUnit),
            }
            (true, fx, st)
        },
        SWhile(c, b) => {
            st = expect(st, cx, fx, c, TBool)
            (false, fx, loop_block(st, cx, fx, b))
        },
        SLetPat(..) | SForPat(..) => panic("destructuring is expanded when modules load"),
        SFor(n, nsp, e, b) => {
            let (t, next) = check_expr(st, cx, fx, e)
            st = next
            let el = match st.repr(t) {
                TList(a) | TArray(a, _) => a,
                TErr => TErr,
                TVar(_) => {
                    let (a, next) = st.fresh()
                    st = next.unify_at(e.span, TList(a), t)
                    a
                },
                other => {
                    let mut d = diag.error("E0201", e.span, "`for` can only iterate over a `List`, found `{st.show(other)}`")
                    if other == TStr {
                        d = d.note("use `.lines()` or `.split(...)` to get a `List[Str]`")
                    }
                    st = st.report(d)
                    TErr
                },
            }
            let inside = fx.push().bind(n, env.Var { ty: el, mutable: false, span: nsp, kind: KPat })
            (false, fx, loop_block(st, cx, inside, b))
        },
        SBreak | SContinue => {
            if fx.loops == 0 {
                if fx.in_defer > 0 {
                    st = st.report(diag.error("E0115", s.span, "`break` and `continue` cannot leave a `defer` body"))
                } else {
                    st = st.report(diag.error("E0208", s.span, "`break` and `continue` can only be used inside a loop"))
                }
            }
            (true, fx, st)
        },
        SDefer(b) => {
            // the body runs when the block is left: it sees the names in
            // scope here, and nothing in it may leave it; its value is dropped
            let inside = { fx with loops: 0, in_defer: fx.in_defer + 1 }
            (false, fx, check_block(st, cx, inside, b).1)
        },
    }
}

fn is_tuple_annotation(te: ast.TyExpr) -> Bool {
    match te.desc {
        TyName(tn, []) => ast.is_tuple_name(tn),
        _ => false,
    }
}
