// Checking function bodies: the expressions, statements and patterns of
// src/check.ml, one function here for each there, in the same order, with
// the same problems reported in the same order.
//
// Every function takes the State as a `mut` parameter and changes it in
// place with what it learned: `let t = check_expr(mut st, cx, fx, e)`.
// `cx` is the program's declarations and `fx` the function being checked
// (its scopes, its result type, the loops it is in), which only statements
// and patterns change, by binding names: they return it.
//
// The OCaml checker evaluates the arguments of a constructor or function
// last to first, and some of them have effects (a new type variable, a
// problem reported); where that order shows, a comment says so and the
// code follows it.
use ast
use builtins
use diag
use env
use exhaust
use types
use walk

// ---------- expressions ----------

pub fn check_expr(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr) -> types.Ty {
    let t = inner(mut st, cx, fx, e)
    // a call can make the type of a generic interface bound known
    match st.desc(e) {
        ECall(..) | EMethod(..) => infer_pending(mut st, cx),
        _ => {},
    }
    st.set_type(e, t)
    t
}

fn inner(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr) -> types.Ty {
    match st.desc(e) {
        EInt(_) => TInt,
        EFloat(_) => TFloat,
        EBool(_) => TBool,
        EUnit => TUnit,
        EStr(parts) => {
            for part in parts {
                match part {
                    SPExpr(x) => {
                        let t = check_expr(mut st, cx, fx, x)
                        match st.subst.refused(env.printing(), t) {
                            Some(Itself) => st.report(diag.error("E0201", x.span, "cannot interpolate a value of type `{st.show(t)}`")),
                            Some(Inside(u)) => st.report(diag.error("E0201", x.span, "cannot interpolate a value of type `{st.show(t)}`").note("`{st.show(t)}` holds `{st.show(u)}`, which cannot be interpolated")),
                            None => {},
                        }
                    },
                    SPLit(_) => {},
                }
            }
            TStr
        },
        EVar(n) => check_var(mut st, cx, fx, e, n, e.span),
        EList(es) => {
            let el = st.fresh()
            for x in es {
                expect(mut st, cx, fx, x, el)
            }
            TList(el)
        },
        EBin(op, a, b) => check_bin(mut st, cx, fx, op, a, b, e.span),
        EUn(Neg, a) => {
            let t = check_expr(mut st, cx, fx, a)
            match st.repr(t) {
                TInt | TFloat | TErr => t,
                TVar(_) => {
                    st.unify_at(a.span, TInt, t)
                    TInt
                },
                _ => {
                    st.report(diag.error("E0201", a.span, "cannot negate a value of type `{st.show(t)}`"))
                    TErr
                },
            }
        },
        EUn(Not, a) => {
            expect(mut st, cx, fx, a, TBool)
            TBool
        },
        EUn(BitNot, a) => {
            let t = check_expr(mut st, cx, fx, a)
            match st.repr(t) {
                TInt | TUInt(_) | TErr => t,
                TVar(_) => {
                    st.unify_at(a.span, TInt, t)
                    TInt
                },
                _ => {
                    st.report(diag.error("E0201", a.span, "operator `~` cannot be applied to `{st.show(t)}`"))
                    TErr
                },
            }
        },
        ECall(callee, args) => check_call(mut st, cx, fx, e, callee, args, e.span, None),
        EMethod(recv, name, nsp, args) => match st.desc(recv) {
            // `Enum.Variant(args)` is a constructor call, not a method call
            EVar(en) if !fx.is_local(en) && cx.enums.contains(en) => {
                let callee = st.node(EField(recv, name, nsp), ast.merge(recv.span, nsp))
                check_call(mut st, cx, fx, e, callee, args, e.span, None)
            },
            _ => check_method(mut st, cx, fx, e, recv, name, nsp, args),
        },
        EField(recv, name, nsp) => check_field(mut st, cx, fx, e, recv, name, nsp),
        EIndex(a, i) => {
            let t = check_expr(mut st, cx, fx, a)
            match st.repr(t) {
                TMap(k, v) => {
                    expect(mut st, cx, fx, i, k)
                    v
                },
                TBytes => {
                    expect(mut st, cx, fx, i, TInt)
                    TInt
                },
                _ => {
                    expect(mut st, cx, fx, i, TInt)
                    match st.repr(t) {
                        TList(el) | TArray(el, _) => el,
                        TErr => TErr,
                        _ => {
                            st.report(diag.error("E0201", a.span, "only lists, arrays and maps can be indexed, found `{st.show(t)}`"))
                            TErr
                        },
                    }
                },
            }
        },
        ETry(x, context) => check_try(mut st, cx, fx, x, context, e.span),
        EIf(c, b, other) => {
            expect(mut st, cx, fx, c, TBool)
            let tt = check_block(mut st, cx, fx, b)
            match other {
                None => {
                    let ok = st.unify(TUnit, tt)
                    if ok {
                        return TUnit
                    }
                    let d = diag.error("E0203", b.span, "this `if` has no `else`, so its block must have type `()`, found `{st.show(tt)}`").note("add an `else` branch, or end the block with a statement")
                    st.report(d)
                    TErr
                },
                Some(x) => {
                    expect(mut st, cx, fx, x, tt)
                    tt
                },
            }
        },
        EMatch(s, arms) => check_match(mut st, cx, fx, s, arms, e.span, None),
        ESelect(arms) => {
            if st.no_wait > 0 {
                update_waits(mut st, e.span, "a `select` can wait")
            }
            check_select(mut st, cx, fx, arms, e.span)
        },
        EBlock(b) => check_block(mut st, cx, fx, b),
        EClosure(ps, body) => check_closure(mut st, cx, fx, ps, body, None),
        EStruct(name, nsp, fields) => check_struct_lit(mut st, cx, fx, name, nsp, fields, e.span),
        EPipe(..) => panic("pipes are expanded when modules load"),
        EWith(base, fields) => check_with(mut st, cx, fx, base, fields, e.span),
        ESafe(base, x, rest) => check_safe(mut st, cx, fx, e, base, x, rest),
        EDyn(x, i) => {
            // checked again: the type it was boxed as
            let before = st.repr(st.type_of(e))
            check_expr(mut st, cx, fx, x)
            match before {
                TDyn(..) => before,
                _ => TDyn(i, []),
            }
        },
        ENamed(n, nsp, x) => {
            // a label the call did not take away: the callee has no
            // parameter names
            let d = diag.error("E0122", nsp, "`{n}:` names a parameter, but this call takes its arguments by position").fix("remove the label", { nsp with hi: x.span.lo }, "")
            st.report(d)
            check_expr(mut st, cx, fx, x)
        },
        // a call to a function or method declared with `fn` checks its
        // `mut` arguments itself; any other callee has no `mut` parameter
        EMut(x) => {
            let d = diag.error("E0213", e.span, "`mut` is only for an argument whose parameter is declared `mut`, and this callee has none").fix("remove `mut`", { e.span with hi: x.span.lo }, "")
            st.report(d)
            check_expr(mut st, cx, fx, x)
        },
        EGroup(name, _, until, b) => {
            let t = st.fresh()
            if st.no_wait > 0 {
                update_waits(mut st, e.span, "a `group` waits for its tasks")
            }
            match until {
                Some(dl) => {
                    let ct = check_expr(mut st, cx, fx, dl.clock)
                    match st.repr(ct) {
                        TCap("Clock") | TErr => {},
                        TVar(_) => {
                            st.unify_at(dl.clock.span, TCap("Clock"), ct)
                        },
                        _ => {
                            let d = diag.error("E0201", dl.clock.span, "`after` in a group deadline needs a `Clock`, found `{st.show(ct)}`").note("a group deadline is `group g until clock.after(ms) \{ ... }`, with the `Clock` from `root.clock`")
                            st.report(d)
                        },
                    }
                    expect(mut st, cx, fx, dl.ms, TInt)
                },
                None => {},
            }
            let inside = { fx.push().bind(name, env.Var { ty: TGroup(t), mutable: false, span: e.span, kind: KGroup }) with loops: 0, in_group: fx.in_group + 1 }
            check_block(mut st, cx, inside, b)
            // with a deadline, a task cancelled by it has no result: None
            if until.is_none() { TList(t) } else { TList(types.opt(t)) }
        },
    }
}

// Check `e` against an expected type; closures get their parameter types
// from it.
pub fn expect(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, want: types.Ty) {
    match (st.desc(e), st.repr(want)) {
        // an integer literal where an unsigned integer is expected is one, if it fits
        (EInt(v), TUInt(bits)) => {
            if v < 0 || (bits < 64 && v >= 1 << bits) {
                let top = if bits == 64 { "18446744073709551615" } else { "{(1 << bits) - 1}" }
                st.report(diag.error("E0201", e.span, "{v} does not fit in a `UInt{bits}`, which holds 0 to {top}"))
            }
            st.set_type(e, want)
        },
        (EUn(Neg, x), TUInt(bits)) if is_int_literal(st, x) => {
            st.report(diag.error("E0201", e.span, "a `UInt{bits}` cannot be negative"))
            st.set_type(e, want)
        },
        (EList(es), TList(el)) if is_uint(st, el) => {
            for x in es {
                expect(mut st, cx, fx, x, el)
            }
            st.set_type(e, want)
        },
        (EList(es), TArray(el, n)) => {
            for x in es {
                expect(mut st, cx, fx, x, el)
            }
            match st.repr(n) {
                TLen(k) => {
                    if es.len() != k {
                        st.report(diag.error("E0201", e.span, "expected {k} element{env.plural(k)} for `{st.show(want)}`, found {es.len()}"))
                    }
                },
                // a length still to infer, as at a call of `fn sum[N](xs: Array[Int, N])`
                _ => {
                    st.unify_at(e.span, n, TLen(es.len()))
                },
            }
            st.set_type(e, want)
        },
        (EList(es), TList(el)) if is_dyn(st, el) => {
            // each element is boxed on its own, so a list can mix types
            for x in es {
                expect(mut st, cx, fx, x, el)
            }
            st.set_type(e, want)
        },
        // the expected type reaches each branch, so `if` and `match` arms
        // can become `dyn` one by one, and closures in them get their types
        (EIf(c, b, Some(other)), _) => {
            expect(mut st, cx, fx, c, TBool)
            expect_block(mut st, cx, fx, b, want)
            expect(mut st, cx, fx, other, want)
            st.set_type(e, want)
        },
        (EMatch(s, arms), _) => {
            let t = check_match(mut st, cx, fx, s, arms, e.span, Some(want))
            st.set_type(e, t)
        },
        // `Err(x)` or `Some(x)` where a `dyn` payload is expected: the
        // expected type reaches the arguments, so `x` becomes `dyn`
        (ECall(callee, args), TNamed(_, targs)) if targs.any(|a| st.subst.has_dyn(a)) => {
            let t = check_call(mut st, cx, fx, e, callee, args, e.span, Some(want))
            st.set_type(e, t)
            st.unify_at(e.span, want, t)
        },
        (EBlock(b), _) => {
            expect_block(mut st, cx, fx, b, want)
            st.set_type(e, want)
        },
        // the expected type reaches into a list or tuple literal when an
        // item needs it: a closure whose parameters have no types, as in
        // `[("GET /", |r, p| ...)]`
        (EList(es), TList(el)) if es.any(|x| needs_type(st, x)) => {
            for x in es {
                expect(mut st, cx, fx, x, el)
            }
            st.set_type(e, want)
        },
        (EStruct(n, _, fields), TNamed(tn, ts)) if ast.is_tuple_name(n) && n == tn && fields.len() == ts.len() && fields.any(|x| needs_type(st, x.value)) => {
            for (x, t) in fields.zip(ts) {
                expect(mut st, cx, fx, x.value, t)
            }
            st.set_type(e, want)
        },
        (_, TDyn(i, a)) => {
            let t = check_expr(mut st, cx, fx, e)
            coerce(mut st, cx, e, t, env.Bound { iface: i, args: a })
        },
        _ => expect_plain(mut st, cx, fx, e, want),
    }
}

fn is_int_literal(st: env.State, e: ast.Expr) -> Bool {
    match st.desc(e) {
        EInt(_) => true,
        _ => false,
    }
}

fn is_uint(st: env.State, t: types.Ty) -> Bool {
    match st.repr(t) {
        TUInt(_) => true,
        _ => false,
    }
}

// Whether `e` needs the expected type to be checked: a closure with a
// parameter that has no type, alone or inside a list or tuple literal.
pub fn needs_type(st: env.State, e: ast.Expr) -> Bool {
    match st.desc(e) {
        EClosure(ps, _) => ps.any(|p| p.ty.is_none()),
        EList(es) => es.any(|x| needs_type(st, x)),
        EStruct(n, _, fields) if ast.is_tuple_name(n) => fields.any(|x| needs_type(st, x.value)),
        _ => false,
    }
}

fn is_dyn(st: env.State, t: types.Ty) -> Bool {
    match st.repr(t) {
        TDyn(..) => true,
        _ => false,
    }
}

// A value used where `dyn I` is expected: box it if its type satisfies I.
fn coerce(mut st: env.State, cx: env.Cx, e: ast.Expr, t: types.Ty, b: env.Bound) {
    let boxed = TDyn(b.iface, b.args)
    let bn = st.show_bound(b)
    match st.repr(t) {
        TDyn(j, _) if j == b.iface => {
            st.unify_at(e.span, boxed, t)
        },
        TVar(_) => {
            st.unify_at(e.span, boxed, t)
        },
        TErr => {},
        // the built-in errors: a message, no cause
        TStr | TNamed("IoError", _) if b.iface == "Error" => box(mut st, e, b),
        TNamed(n, _) if (cx.structs.contains(n) || cx.enums.contains(n)) && !["Option", "Result", "IoError"].contains(n) => {
            let ct = st.repr(t)
            match st.held(ct) {
                Some(h) => {
                    let d = diag.error("E0112", e.span, "{h}, so it cannot become `dyn {bn}`").note("authority must stay visible in types; pass it with a type parameter, as in `[T: " + bn + "]`")
                    st.report(d)
                    return
                },
                None => {},
            }
            let kind = st.subst.chan_kind(ct)
            if st.subst.has_chan(ct) && !st.subst.has_fn(ct) && kind != Some("channel") {
                let d = diag.error("E0112", e.span, "`{st.show(ct)}` holds an `Atomic` or `Shared` value, so it cannot become `dyn {bn}`").note("shared state must stay visible in types; pass it with a type parameter, as in `[T: " + bn + "]`")
                st.report(d)
                return
            }
            if st.subst.has_fn(ct) || st.subst.has_chan(ct) {
                let message = match st.holds_fn_through(ct) {
                    Some(h) => "{h}, so it cannot become `dyn {bn}`",
                    None => "`{st.show(ct)}` holds a function or channel, so it cannot become `dyn {bn}`",
                }
                let d = diag.error("E0112", e.span, message).note("a function or channel could carry authority out of sight; pass it with a type parameter, as in `[T: " + bn + "]`")
                st.report(d)
                return
            }
            let why = satisfies(mut st, cx, ct, b)
            match why {
                Some(why) => {
                    st.report(diag.error("E0111", e.span, "`{st.show(ct)}` does not satisfy interface `{bn}`").note(why))
                },
                None => box(mut st, e, b),
            }
        },
        other => {
            let d = diag.error("E0112", e.span, "only struct and enum values can become `dyn {bn}`, not `{st.show(other)}`").note("wrap the value in a struct that has the interface's methods")
            st.report(d)
        },
    }
}

// `e`, already checked, becomes `EDyn(inner, I)`: `inner` is a new
// expression with what was known of `e` (its form, type and type
// arguments), and `e` is the boxed value, of type `dyn I`.
fn box(mut st: env.State, e: ast.Expr, b: env.Bound) {
    let inner = st.node(st.desc(e), e.span)
    st.set_type(inner, st.type_of(e))
    st.set_inst(inner, st.inst_of(e))
    if st.nested.contains(e.id) {
        st.nested[inner.id] = true
    }
    st.rewrite(e, EDyn(inner, b.iface))
    st.set_type(e, TDyn(b.iface, b.args))
}

// Does `t` have every method of bound `b`, with the same types? None if
// so, else why not. Unifying the method types infers the bound's
// arguments where they are unknown.
pub fn satisfies(mut st: env.State, cx: env.Cx, t: types.Ty, b: env.Bound) -> Option[Str] {
    let ms = iface_methods(st, cx, b)
    let t = st.repr(t)
    let name = st.show_bound(b)
    match t {
        TDyn(j, ja) if j == b.iface => {
            let same = same_args(mut st, b, ja)
            if same {
                return None
            }
        },
        TParam(g) => {
            for x in bounds_of(st, g) {
                if x.iface == b.iface {
                    let same = same_args(mut st, b, x.args)
                    if same {
                        return None
                    }
                }
            }
        },
        _ => {},
    }
    for m in ms {
        // `cause` is optional in `Error`: a type without one has no cause
        let own = match t {
            TNamed(n, _) => cx.fns.contains(n + "::" + m.name) || builtins.names(t).contains(m.name),
            TParam(_) | TDyn(..) => true,
            _ => builtins.names(t).contains(m.name),
        }
        if b.iface == "Error" && m.name == "cause" && !own {
            continue
        }
        let why = method_fits(mut st, cx, t, name, m)
        if why.is_some() {
            return why
        }
    }
    None
}

// The arguments of bound `b`, unified with `args`.
fn same_args(mut st: env.State, b: env.Bound, args: List[types.Ty]) -> Bool {
    if args.len() != b.args.len() {
        return false
    }
    for (x, y) in b.args.zip(args) {
        let ok = st.unify(x, y)
        if !ok {
            return false
        }
    }
    true
}

// Whether `got` unifies with `want`, the type of method `m` of the
// interface called `name`; why not if it does not.
fn method_trial(mut st: env.State, want: types.Ty, got: types.Ty, name: Str, m: env.IfaceMethod) -> Option[Str] {
    let ok = st.unify(want, got)
    if ok {
        return None
    }
    Some("its `{m.name}` has type `{st.show(got)}`, but `{name}` needs `{st.show(want)}`")
}

// Whether `t` has method `m` of the interface called `name` (as shown),
// with its type; why not if it does not.
fn method_fits(mut st: env.State, cx: env.Cx, t: types.Ty, name: Str, m: env.IfaceMethod) -> Option[Str] {
    let want = TFn(m.params, m.ret)
    let key = |n: Str| n + "::" + m.name
    match t {
        TVar(_) | TErr => None,
        TDyn(j, ja) => match iface_methods(st, cx, env.Bound { iface: j, args: ja }).find(|x| x.name == m.name) {
            Some(x) => method_trial(mut st, want, TFn(x.params, x.ret), name, m),
            None => Some("`{st.show(t)}` has no method `{m.name}`"),
        },
        TParam(g) => {
            for x in bounds_of(st, g) {
                match iface_methods(st, cx, x).find(|y| y.name == m.name) {
                    Some(y) => {
                        return method_trial(mut st, want, TFn(y.params, y.ret), name, m)
                    },
                    None => {},
                }
            }
            Some("type parameter `{g}` is not bounded by `{name}`; add it: `[{g}: {name}]`")
        },
        // a bound or `dyn` calls it as a value, with a plain receiver
        TNamed(n, _) if cx.has_mut(key(n)) => Some("its `{m.name}` has a `mut` parameter, so it cannot implement `{name}`"),
        TNamed(n, _) if cx.fns.contains(key(n)) => {
            let (_, ft) = instantiate(mut st, cx.fns.get(key(n)) ?? env.Sig { gen: [], params: [], ret: TErr })
            match ft {
                TFn([p0, ..rest], r) => {
                    st.unify(p0, t)
                    method_trial(mut st, want, TFn(rest, r), name, m)
                },
                _ => Some("its `{m.name}` is not a method"),
            }
        },
        TNamed(n, _) if is_ambiguous(promote(cx, false, n, m.name)) => match promote(cx, false, n, m.name) {
            Ambiguous(paths) => Some(ambiguity(n, m.name, paths)),
            _ => None,
        },
        _ => {
            let u = st.fresh()
            match builtins.find(t, u, m.name) {
                Some(x) => method_trial(mut st, want, TFn(x.params, x.result), name, m),
                None => Some("`{st.show(t)}` has no method `{m.name}`"),
            }
        },
    }
}

fn is_ambiguous(f: Found) -> Bool {
    match f {
        Ambiguous(_) => true,
        _ => false,
    }
}

// Infer the arguments of the generic-interface bounds of the calls made so
// far whose type is now known, so `first(xs)` has its result type at once.
fn infer_pending(mut st: env.State, cx: env.Cx) {
    if st.to_infer.is_empty() {
        return
    }
    let mut keep: List[(types.Ty, env.Bound)] = []
    for (t, b) in st.to_infer {
        match st.repr(t) {
            TVar(_) => keep.push((t, b)),
            _ => {
                let _ = satisfies(mut st, cx, t, b)
            },
        }
    }
    st.to_infer = keep
}

fn expect_plain(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, want: types.Ty) {
    match st.desc(e) {
        EClosure(ps, body) => {
            let t = check_closure(mut st, cx, fx, ps, body, Some(want))
            st.set_type(e, t)
            st.unify_at(e.span, want, t)
        },
        _ => {
            let t = check_expr(mut st, cx, fx, e)
            st.unify_at(e.span, want, t)
        },
    }
}

fn check_var(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, n: Str, sp: ast.Span) -> types.Ty {
    match fx.find_var(n) {
        Some(v) if v.kind == KGroup => {
            st.report(diag.error("E0310", sp, "`{n}` is a group handle; the only thing you can do with it is `{n}.go(...)`"))
            return TErr
        },
        Some(v) => {
            let pass = st.arg_of
            st.arg_of = None
            if v.kind == KParam && st.cb_params.contains((n, v.span)) {
                match fx.lookup(n) {
                    Some((_, false)) if st.calling => {},
                    Some((_, false)) if pass.is_some() => {
                        st.cb_passes = [pass ?? ("", 0)] + st.cb_passes
                    },
                    _ => {
                        st.cb_escaped = true
                    },
                }
            }
            return v.ty
        },
        None => {},
    }
    let direct = st.calling
    st.calling = false
    match cx.fns.get(n) {
        Some(_) if cx.foreign_fns.contains(n) && !direct => {
            let d = diag.error("E0331", sp, "foreign function `{n}` can only be called, not used as a value").note("wrap it in a closure, as in `|x| {n}(foreign, x)`")
            st.report(d)
            return TErr
        },
        Some(_) if cx.has_mut(n) && !direct => {
            let d = diag.error("E0215", sp, "`{n}` has a `mut` parameter, so it can only be called, not used as a value").note("a `mut` argument is a place, which only a direct call can pass: call `{n}(...)` by name")
            st.report(d)
            return TErr
        },
        Some(s) => {
            let (inst, t) = instantiate(mut st, s)
            st.set_inst(e, inst)
            add_bounds(mut st, cx, n, inst, sp)
            return t
        },
        None => {},
    }
    if cx.owners.contains(n) {
        match variant_scope(cx, n, sp.file) {
            [en] => {
                // name the enum when the variant name alone would be
                // ambiguous to the backends
                if (cx.owners.get(n) ?? []).len() > 1 {
                    let qual = st.node(EVar(en), sp)
                    st.rewrite(e, EField(qual, n, sp))
                }
                return ctor_ty(mut st, cx, en, n, sp)
            },
            ens => {
                let d = diag.error("E0104", sp, "`{n}` is a variant of several enums ({ens.join(", ")}); qualify it, for example `{ens[0]}.{n}`")
                st.report(d)
                return TErr
            },
        }
    }
    match builtins.ambient(n) {
        Some(a) => {
            let d = diag.error("E0302", sp, "`{n}` does not exist: Limen has no ambient I/O").note("I/O goes through capabilities: take a `{a.cap}` parameter and call `{a.how}`").note("in `main`, the capabilities live on `root`, for example `root.stdout.print(\"hi\")`")
            st.report(d)
            return TErr
        },
        None => {},
    }
    // OCaml folds over its table of functions, so of the methods named `n`
    // it names the last its table lists
    let suffix = "::" + n
    let mut d = diag.error("E0101", sp, "unknown name `{n}`")
    match env.keys_in_order(cx.fns).filter(|k| k.ends_with(suffix)).last() {
        Some(k) => {
            let tn = k.slice(0, k.len() - suffix.len())
            d = d.note("`{n}` is a method of `{tn}`; call it on a value: `x.{n}(...)`")
        },
        None => {},
    }
    st.did_you_mean(d, n, visible_names(cx, fx))
    TErr
}

fn visible_names(cx: env.Cx, fx: env.Fx) -> List[Str] {
    fx.scopes.flat_map(|s| env.keys_in_order(s.vars)) + env.keys_in_order(cx.fns) + env.keys_in_order(cx.owners) + builtins.functions()
}

fn instantiate(mut st: env.State, s: env.Sig) -> (List[(Str, types.Ty)], types.Ty) {
    let vars = st.fresh_list(s.gen.len())
    let inst = s.gen.zip(vars)
    (inst, TFn(s.params.map(|p| st.subst(inst, p)), st.subst(inst, s.ret)))
}

// E0201 when built-in `name` compares values of type `t` that have no
// equality: functions, channels, `dyn` values, capabilities, and values
// holding one of them, as `==` refuses them.
pub fn refuse_compare(mut st: env.State, sp: ast.Span, name: Str, t: types.Ty) {
    let t = st.repr(t)
    match st.subst.refused(env.equality(), t) {
        Some(found) => match st.uncomparable(t, found) {
            Some(why) => {
                st.report(diag.error("E0201", sp, "`{name}` compares values, and {why}"))
            },
            None => {
                st.report(diag.error("E0201", sp, "`{name}` compares values, and values of type `{st.show(t)}` cannot be compared"))
            },
        },
        None => match st.held(t) {
            Some(h) => {
                st.report(diag.error("E0201", sp, "`{name}` compares values, and {h}").note("capabilities have no equality, so neither has a value holding one; compare something it holds that is not a capability, as in `xs.any(|x| x.name == name)`"))
            },
            None => {},
        },
    }
}

// The bounds of generic function `name` apply to its type arguments here.
fn add_bounds(mut st: env.State, cx: env.Cx, name: Str, inst: List[(Str, types.Ty)], sp: ast.Span) {
    if !inst.is_empty() {
        st.uses_here = [(sp, name, inst)] + st.uses_here
    }
    if st.cur_fn != "" && !st.refs_here.contains(name) {
        st.refs_here = [name] + st.refs_here
    }
    for b in cx.fn_bounds.get(name) ?? [] {
        match inst.find(|p| p.0 == b.param) {
            Some((_, t)) => {
                for bound in b.bounds {
                    let bound = st.subst_bound(inst, bound)
                    st.pending = [env.Pending { span: sp, ty: t, bound, param: b.param }] + st.pending
                    if !bound.args.is_empty() {
                        st.to_infer = [(t, bound)] + st.to_infer
                    }
                }
            },
            None => {},
        }
    }
}

// The enums a bare variant name can mean in `file`: the file's own enums
// shadow the prelude's, which shadow other modules'. More than one at the
// nearest level is ambiguous.
fn variant_scope(cx: env.Cx, v: Str, file: Int) -> List[Str] {
    let ens = cx.owners.get(v) ?? []
    let from = |f: Int| ens.filter(|en| cx.enums.get(en).map(|e| e.span.file == f) ?? false)
    match from(file) {
        [] => match from(cx.prelude_file) {
            [] => ens,
            p => p,
        },
        own => own,
    }
}

// The type of variant `v` of enum `en` used as a value: the enum, or a
// function from its payload to the enum.
fn ctor_ty(mut st: env.State, cx: env.Cx, en: Str, v: Str, sp: ast.Span) -> types.Ty {
    let gen = cx.enums.get(en).map(|e| e.generics) ?? []
    let targs = st.fresh_list(gen.len())
    st.add_type_bounds(cx, en, targs, sp)
    let inst = gen.zip(targs)
    let payload = (cx.variants.get(en) ?? []).find(|x| x.0 == v).map(|x| x.1) ?? []
    let result = TNamed(en, targs)
    if payload.is_empty() {
        return result
    }
    TFn(payload.map(|p| st.subst(inst, p)), result)
}

fn struct_fields(st: env.State, cx: env.Cx, n: Str, args: List[types.Ty]) -> List[(Str, types.Ty)] {
    let gen = cx.structs.get(n).map(|s| s.generics) ?? []
    let inst = gen.zip(args)
    (cx.sfields.get(n) ?? []).map(|f| (f.0, st.subst(inst, f.1)))
}

// Arguments checked anyway, where the call is already wrong: a `mut`
// marker says nothing more there.
fn check_args(mut st: env.State, cx: env.Cx, fx: env.Fx, args: List[ast.Expr]) {
    for a in args {
        let x = unlabel(st, a)
        match st.desc(x) {
            EMut(p) => {
                let t = check_expr(mut st, cx, fx, p)
                st.set_type(x, t)
            },
            _ => {
                let _ = check_expr(mut st, cx, fx, x)
            },
        }
    }
}

fn is_named(st: env.State, a: ast.Expr) -> Bool {
    match st.desc(a) {
        ENamed(..) => true,
        _ => false,
    }
}

fn unlabel(st: env.State, a: ast.Expr) -> ast.Expr {
    match st.desc(a) {
        ENamed(_, _, v) => v,
        _ => a,
    }
}

// ---------- calls ----------

// Named arguments, `connect(host, retries: 3)`: positional arguments
// first, then named ones in any order, every parameter passed exactly once
// (there are no default values). A closure written last, after named
// arguments, fills the last parameter: that is where a trailing closure
// goes. Returns the arguments in parameter order without their labels, or
// None after reporting what is wrong. `names` are the callee's parameter
// names, or why it has none.
fn order_args(mut st: env.State, what: Str, sp: ast.Span, names: Result[List[Str], Str], defaults: List[Option[ast.Expr]], args: List[ast.Expr]) -> Option[List[ast.Expr]] {
    if !args.any(|a| is_named(st, a)) && args.len() >= defaults.len() {
        return Some(args)
    }
    let names = match names {
        Err(why) => {
            for a in args {
                match st.desc(a) {
                    ENamed(l, lsp, v) => {
                        let d = diag.error("E0122", lsp, "`{l}:` names a parameter, but {why}").fix("remove the label", { lsp with hi: v.span.lo }, "")
                        st.report(d)
                        return None
                    },
                    _ => {},
                }
            }
            return None
        },
        Ok(names) => names,
    }
    let n = names.len()
    let mut slots: List[Option[ast.Expr]] = names.map(|_| None)
    let mut ok = true
    let total = args.len()
    let mut named_seen = false
    let mut misplaced: List[ast.Expr] = []
    let mut extra = 0
    let mut unknown: List[(Str, ast.Span)] = []
    let mut dup = false
    for (i, a) in args.with_index() {
        match st.desc(a) {
            ENamed(l, lsp, v) => {
                named_seen = true
                match names.with_index().find(|p| p.1 == l) {
                    None => {
                        ok = false
                        unknown.push((l, lsp))
                    },
                    Some((j, _)) => match slots[j] {
                        Some(_) => {
                            ok = false
                            dup = true
                            let d = diag.error("E0122", lsp, "parameter `{l}` is passed twice").note("positional arguments fill the parameters in order, before the named ones")
                            st.report(d)
                        },
                        None => {
                            slots[j] = Some(v)
                        },
                    },
                }
            },
            EClosure(..) if named_seen && i == total - 1 && n > 0 && slots[n - 1].is_none() => {
                slots[n - 1] = Some(a)
            },
            _ if named_seen => misplaced.push(a),
            _ => {
                if i < n {
                    slots[i] = Some(a)
                } else {
                    extra = extra + 1
                }
            },
        }
    }
    if extra > 0 {
        ok = false
        st.report(diag.error("E0107", sp, "{what} takes {n} argument{env.plural(n)} but {total} {env.was_were(total)} supplied"))
    }
    // a parameter left out takes its default
    for (j, d) in defaults.with_index() {
        if j < n && slots[j].is_none() {
            slots[j] = d
        }
    }
    let mut missing = names.with_index().filter(|p| slots[p.0].is_none()).map(|p| p.1)
    let list = if names.is_empty() { "none" } else { names.join(", ") }
    let with_notes = |d: diag.Diag| d.note("its parameters are: {list}")
    match (unknown, missing) {
        ([(l, lsp)], [m]) => {
            // one wrong label and one parameter left: that must be the one
            missing = []
            st.report(with_notes(diag.error("E0122", lsp, "{what} has no parameter `{l}`")).fix("did you mean `{m}`?", lsp, m))
        },
        (us, _) => {
            if !us.is_empty() {
                missing = []
            }
            for (l, lsp) in us {
                st.did_you_mean(with_notes(diag.error("E0122", lsp, "{what} has no parameter `{l}`")), l, names)
            }
        },
    }
    for a in misplaced {
        ok = false
        let mut d = diag.error("E0122", a.span, "a positional argument cannot come after a named one").note("write the positional arguments first, or name this one too")
        match missing {
            [m, ..rest] => {
                missing = rest
                d = d.fix("name it: `{m}: ...`", { a.span with hi: a.span.lo }, m + ": ")
            },
            [] => {},
        }
        st.report(d)
    }
    if misplaced.is_empty() && extra == 0 && !dup {
        for m in missing {
            ok = false
            st.report(diag.error("E0107", sp, "{what} is missing the argument for parameter `{m}`").note("every parameter without a default value must be passed"))
        }
    }
    if !ok {
        return None
    }
    // every slot is filled when nothing was wrong
    Some(slots.flat_map(|s| s.map(|x| [x]) ?? []))
}

// Arguments run in the order they are written. When labels moved one that
// has an effect past another, the checked call `e` becomes
// `{ let $arg1 = first; let $arg2 = second; call($arg2, $arg1) }`, the lets
// in written order. Literals, names, closures and field reads have no
// effect, so they stay in place. `written` is the arguments as written,
// after the receiver if there is one. A `mut` argument stays in the call,
// as the place it is; the indexes in it that have an effect are what
// moves, the place reading their temporaries.
fn keep_order(mut st: env.State, e: ast.Expr, written: List[ast.Expr], r: types.Ty) {
    let effects = written.flat_map(|x| match st.desc(x) {
        EMut(p) => place_effects(st, p),
        _ => if pure(st, x) { [] } else { [x] },
    })
    let ids = effects.map(|x| x.id)
    let call_args = match st.desc(e) {
        ECall(_, xs) => xs,
        EMethod(rv, _, _, xs) => [rv] + xs,
        _ => [],
    }
    let in_call = call_args.flat_map(|x| match st.desc(x) {
        EMut(p) => place_effects(st, p).map(|y| y.id),
        _ => if ids.contains(x.id) { [x.id] } else { [] },
    })
    if in_call.len() != ids.len() || in_call == ids {
        return
    }
    let mut temps: List[(Int, Str)] = []
    for x in effects {
        st.temps = st.temps + 1
        temps.push((x.id, "$arg{st.temps}"))
    }
    let mut vars: List[(Int, ast.Expr)] = []
    for x in effects {
        let name = temps.find(|t| t.0 == x.id).map(|t| t.1) ?? ""
        let v = st.node(EVar(name), x.span)
        st.set_type(v, st.type_of(x))
        vars.push((x.id, v))
    }
    let var = |x: ast.Expr| vars.find(|v| v.0 == x.id).map(|v| v.1) ?? x
    // a `mut` place reads the temporaries of its indexes
    for x in call_args {
        match st.desc(x) {
            EMut(p) => {
                place_reads(mut st, p, vars)
            },
            _ => {},
        }
    }
    let desc = match st.desc(e) {
        ECall(c, xs) => ECall(c, xs.map(var)),
        EMethod(rv, m, nsp, xs) => EMethod(var(rv), m, nsp, xs.map(var)),
        d => d,
    }
    let call = st.node(desc, e.span)
    st.set_type(call, r)
    st.set_inst(call, st.inst_of(e))
    let lets = effects.map(|x| ast.Stmt { desc: SLet(false, temps.find(|t| t.0 == x.id).map(|t| t.1) ?? "", x.span, None, x), span: x.span })
    st.rewrite(e, EBlock(ast.Block { stmts: lets, tail: Some(call), span: e.span }))
}

// The indexes in a `mut` place that have an effect, in written order.
fn place_effects(st: env.State, x: ast.Expr) -> List[ast.Expr] {
    match st.desc(x) {
        EField(a, _, _) => place_effects(st, a),
        EIndex(a, i) => place_effects(st, a) + if pure(st, i) { [] } else { [i] },
        _ => [],
    }
}

// A `mut` place with its indexes reading their temporaries, `vars`.
fn place_reads(mut st: env.State, x: ast.Expr, vars: List[(Int, ast.Expr)]) {
    match st.desc(x) {
        EField(a, _, _) => place_reads(mut st, a, vars),
        EIndex(a, i) => {
            place_reads(mut st, a, vars)
            st.rewrite(x, EIndex(a, vars.find(|v| v.0 == i.id).map(|v| v.1) ?? i))
        },
        _ => {},
    }
}

fn pure(st: env.State, x: ast.Expr) -> Bool {
    match st.desc(x) {
        EInt(_) | EFloat(_) | EBool(_) | EUnit | EVar(_) | EClosure(..) => true,
        EStr(parts) => parts.all(|p| match p {
            SPLit(_) => true,
            SPExpr(_) => false,
        }),
        EField(a, _, _) | EDyn(a, _) => pure(st, a),
        _ => false,
    }
}

// Parameter names of the method `key` (`Type::name`), without `self`.
fn method_params(cx: env.Cx, key: Str) -> Result[List[Str], Str] {
    match cx.param_names.get(key) {
        Some([_, ..ps]) => Ok(ps),
        _ => Err("this method takes its arguments by position"),
    }
}

// Default values of the method `key`'s parameters, without `self`.
fn method_defaults(cx: env.Cx, key: Str) -> List[Option[ast.Expr]] {
    match cx.param_defaults.get(key) {
        Some([_, ..ds]) => ds,
        _ => [],
    }
}

// The built-in functions: `assert(c)`, `channel(n)`, `map()`, ...,
// unless a local or a function of the program has the name.
fn builtin_call(mut st: env.State, cx: env.Cx, fx: env.Fx, n: Str, args: List[ast.Expr], sp: ast.Span) -> Option[types.Ty] {
    if fx.is_local(n) || cx.fns.contains(n) {
        return None
    }
    match n {
        "assert" => {
            match args {
                [a] => expect(mut st, cx, fx, a, TBool),
                _ => wrong_count(mut st, cx, fx, args, sp, "`assert` takes 1 argument, a Bool"),
            }
            Some(TUnit)
        },
        "assert_eq" => {
            match args {
                [a, b] => {
                    let t = check_expr(mut st, cx, fx, a)
                    expect(mut st, cx, fx, b, t)
                    match st.subst.refused(env.equality(), t) {
                        Some(Itself) if st.uncomparable(t, Itself).is_none() => {
                            st.report(diag.error("E0201", sp, "values of type `{st.show(t)}` cannot be compared"))
                        },
                        Some(_) | None => {
                            st.eq_types = [t] + st.eq_types
                            refuse_compare(mut st, sp, "assert_eq", t)
                        },
                    }
                },
                _ => wrong_count(mut st, cx, fx, args, sp, "`assert_eq` takes 2 arguments"),
            }
            Some(TUnit)
        },
        // `keep(x)`: x counts as used, so a benchmark's work is not
        // optimized away
        "keep" => {
            match args {
                [a] => {
                    let _ = check_expr(mut st, cx, fx, a)
                },
                _ => wrong_count(mut st, cx, fx, args, sp, "`keep` takes 1 argument"),
            }
            Some(TUnit)
        },
        "channel" => {
            match args {
                [a] => expect(mut st, cx, fx, a, TInt),
                _ => wrong_count(mut st, cx, fx, args, sp, "`channel` takes 1 argument, its capacity"),
            }
            let t = st.fresh()
            Some(TChan(t))
        },
        "atomic" => {
            match args {
                [a] => expect(mut st, cx, fx, a, TInt),
                _ => wrong_count(mut st, cx, fx, args, sp, "`atomic` takes 1 argument, its first value"),
            }
            Some(TAtomic)
        },
        "shared" => match args {
            [a] => {
                let t = check_expr(mut st, cx, fx, a)
                Some(TShared(t))
            },
            _ => {
                wrong_count(mut st, cx, fx, args, sp, "`shared` takes 1 argument, its first value")
                let t = st.fresh()
                Some(TShared(t))
            },
        },
        // catch(|| ...): Ok(value), or Err(message) if anything inside panicked
        "catch" => {
            let t = st.fresh()
            match args {
                [a] => {
                    expect(mut st, cx, fx, a, TFn([], t))
                    Some(types.res(t, TStr))
                },
                _ => {
                    wrong_count(mut st, cx, fx, args, sp, "`catch` takes 1 argument, a closure with no parameters, as in `catch(|| risky())`")
                    Some(TErr)
                },
            }
        },
        // bytes([104, 105]): each item 0 to 255, or it panics
        "bytes" => {
            match args {
                [a] => expect(mut st, cx, fx, a, TList(TInt)),
                _ => wrong_count(mut st, cx, fx, args, sp, "`bytes` takes 1 argument, a list of Ints from 0 to 255"),
            }
            Some(TBytes)
        },
        "map" => {
            let k = st.fresh()
            let v = st.fresh()
            match args {
                [] => {},
                [a] => expect(mut st, cx, fx, a, TList(TNamed("#tuple2", [k, v]))),
                _ => wrong_count(mut st, cx, fx, args, sp, "`map` takes no arguments, or a list of (key, value) pairs"),
            }
            st.map_keys = [(sp, k)] + st.map_keys
            Some(TMap(k, v))
        },
        "panic" => {
            match args {
                [a] => expect(mut st, cx, fx, a, TStr),
                _ => wrong_count(mut st, cx, fx, args, sp, "`panic` takes 1 argument (a message)"),
            }
            let t = st.fresh()
            Some(t)
        },
        _ => None,
    }
}

// The wrong number of arguments to a built-in function: reported, and
// each checked anyway.
fn wrong_count(mut st: env.State, cx: env.Cx, fx: env.Fx, args: List[ast.Expr], sp: ast.Span, message: Str) {
    st.report(diag.error("E0107", sp, message))
    check_args(mut st, cx, fx, args)
}

fn check_call(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, callee: ast.Expr, args: List[ast.Expr], sp: ast.Span, want: Option[types.Ty]) -> types.Ty {
    match st.desc(callee) {
        EVar(n) => match builtin_call(mut st, cx, fx, n, args, sp) {
            Some(done) => {
                return done
            },
            None => {},
        },
        _ => {},
    }
    let is_var = match st.desc(callee) {
        EVar(_) => true,
        _ => false,
    }
    // a foreign function can be used only where it is called
    st.calling = is_var
    let ct = check_expr(mut st, cx, fx, callee)
    st.calling = false
    let (what, names) = match st.desc(callee) {
        EVar(n) if !fx.is_local(n) && cx.param_names.contains(n) => ("function `{n}`", Ok(cx.param_names.get(n) ?? [])),
        EVar(n) if !fx.is_local(n) && cx.foreign_fns.contains(n) => ("", Err("foreign function `{n}` takes its arguments by position")),
        EVar(n) if fx.is_local(n) => ("", Err("`{n}` is a function value, and function values have no parameter names")),
        EVar(n) if cx.owners.contains(n) => ("", Err("an enum variant takes its payload by position")),
        EField(..) => ("", Err("an enum variant takes its payload by position")),
        _ => ("", Err("a function value has no parameter names")),
    }
    match st.repr(ct) {
        TFn(ps, r) => {
            // a constructor's type parameters come from the expected type first
            match (want, st.desc(callee), st.repr(r)) {
                (Some(w), EVar(_) | EField(..), TNamed(n, _)) if cx.enums.contains(n) => {
                    let _ = st.unify(r, w)
                },
                _ => {},
            }
            let defaults = match st.desc(callee) {
                EVar(n) if !fx.is_local(n) => cx.param_defaults.get(n) ?? [],
                _ => [],
            }
            let ordered = order_args(mut st, what, sp, names, defaults, args)
            let args2 = match ordered {
                None => {
                    check_args(mut st, cx, fx, args)
                    return r
                },
                Some(a) => a,
            }
            // reordered by labels, or with defaults filled in: the call is rewritten
            let labelled = args.any(|a| is_named(st, a)) || args2.len() != args.len()
            let written = args.map(|a| unlabel(st, a))
            if ps.len() != args2.len() {
                st.report(diag.error("E0107", sp, "this function takes {ps.len()} argument{env.plural(ps.len())} but {args2.len()} {env.was_were(args2.len())} supplied"))
                check_args(mut st, cx, fx, args2)
            } else {
                let foreign = match st.desc(callee) {
                    EVar(n) => !fx.is_local(n) && cx.foreign_fns.contains(n),
                    _ => false,
                }
                let ps = if foreign { callback_params(st, cx, fx, args2, ps) } else { ps }
                // a function parameter passed on: pure if the callee is, there
                let passed_to = match st.desc(callee) {
                    EVar(g) if !foreign && !fx.is_local(g) && cx.fns.contains(g) => Some(g),
                    _ => None,
                }
                match passed_to {
                    Some(g) => {
                        check_fn_args(mut st, cx, fx, passed_to, g, callee.span, cx.param_names.get(g) ?? [], cx.param_muts.get(g) ?? [], args2, ps)
                    },
                    None => {
                        for (a, p) in args2.zip(ps) {
                            expect(mut st, cx, fx, a, p)
                        }
                    },
                }
                if foreign {
                    check_callbacks(mut st, cx, fx, args2, ps)
                    // a Foreign narrowed here to other libraries: the call would panic
                    match (ps, args2, st.desc(callee)) {
                        ([TCap("Foreign"), ..], [a, ..], EVar(n)) => match (cx.foreign_libs.get(n), known_foreign(st, fx, a)) {
                            (Some(lib), Some(s)) if !s.contains(lib) && !s.contains("*") => {
                                let grants = if s.is_empty() { "no library" } else { "only " + s.map(|l| "`" + l + "`").join(", ") }
                                st.report(diag.error("E0333", a.span, "`{n}` calls C library `{lib}`, but this Foreign grants {grants}").note("it was narrowed with `only`, so the call would panic; narrow it to the library the function belongs to"))
                            },
                            _ => {},
                        },
                        _ => {},
                    }
                }
            }
            mut_overlap(mut st, None, written)
            if labelled {
                st.rewrite(e, ECall(callee, args2))
                keep_order(mut st, e, written, r)
            }
            r
        },
        TErr => {
            check_args(mut st, cx, fx, args)
            TErr
        },
        TVar(_) => {
            let ps = st.fresh_list(args.len())
            let r = st.fresh()
            st.unify_at(callee.span, TFn(ps, r), ct)
            for (a, p) in args.zip(ps) {
                expect(mut st, cx, fx, a, p)
            }
            r
        },
        t => {
            st.report(diag.error("E0108", callee.span, "a value of type `{st.show(t)}` is not a function"))
            check_args(mut st, cx, fx, args)
            TErr
        },
    }
}

// The libraries a Foreign expression is known to be narrowed to: a
// variable bound to one, or `x.only("lib")`. None when it is not known
// here.
fn known_foreign(st: env.State, fx: env.Fx, e: ast.Expr) -> Option[List[Str]] {
    match st.desc(e) {
        EVar(m) => match fx.find_var(m) {
            Some(v) => st.foreign_known.find(|k| k.0 == (m, v.span)).map(|k| k.1),
            None => None,
        },
        EMethod(r, "only", _, [arg]) => match (st.repr(st.type_of(r)), st.desc(arg)) {
            (TCap("Foreign"), EStr([SPLit(lib)])) => match known_foreign(st, fx, r) {
                Some(s) => Some(if lib == "*" { s } else if s.contains(lib) || s.contains("*") { [lib] } else { [] }),
                None => if lib == "*" { None } else { Some([lib]) },
            },
            _ => None,
        },
        _ => None,
    }
}

// The parameter types of a call of a foreign function: a callback may
// take the call's Foreign first, before what C passes.
fn callback_params(st: env.State, cx: env.Cx, fx: env.Fx, args: List[ast.Expr], ps: List[types.Ty]) -> List[types.Ty] {
    match ps {
        [TCap("Foreign"), ..] => {},
        _ => {
            return ps
        },
    }
    args.zip(ps).map(|x| {
        let (a, p) = x
        match (st.repr(p), st.desc(a)) {
            (TFn(cps, r), EVar(m)) if !fx.is_local(m) => match cx.fns.get(m) {
                Some(s) => match s.params {
                    [TCap("Foreign"), ..rest] if rest.len() == cps.len() => TFn([TCap("Foreign")] + cps, r),
                    _ => p,
                },
                None => p,
            },
            _ => p,
        }
    })
}

// A callback passed to C names a top-level function: C calls it with its
// arguments alone, so it has nowhere to keep a closure's captured values.
fn check_callbacks(mut st: env.State, cx: env.Cx, fx: env.Fx, args: List[ast.Expr], ps: List[types.Ty]) {
    for (a, p) in args.zip(ps) {
        match st.repr(p) {
            TFn(..) => {
                let named = match st.desc(a) {
                    EVar(m) => !fx.is_local(m) && (cx.fns.get(m).map(|s| s.gen.is_empty()) ?? false),
                    _ => false,
                }
                if !named {
                    let d = diag.error("E0332", a.span, "a callback to C is a top-level function, passed by its name").note("C calls it with its arguments alone, so it has nowhere to keep a closure's captured values; pass what it needs through C (most C functions that take a callback also take a pointer for it)")
                    st.report(d)
                }
            },
            _ => {},
        }
    }
}

// ---------- fields and methods ----------

fn check_field(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, name: Str, nsp: ast.Span) -> types.Ty {
    match st.desc(recv) {
        EVar(en) if !fx.is_local(en) && cx.enums.contains(en) => {
            let vs = cx.variants.get(en) ?? []
            if vs.any(|v| v.0 == name) {
                return ctor_ty(mut st, cx, en, name, nsp)
            }
            st.did_you_mean(diag.error("E0104", nsp, "enum `{en}` has no variant `{name}`"), name, vs.map(|v| v.0))
            TErr
        },
        _ => {
            let t = check_expr(mut st, cx, fx, recv)
            field_of(mut st, cx, fx, e, recv, t, name, nsp)
        },
    }
}

// `recv.name` where `recv` is checked and has type `t`.
fn field_of(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, t: types.Ty, name: Str, nsp: ast.Span) -> types.Ty {
    let arity = method_arity(mut st, cx, nsp.file, t, name)
    let rt = st.repr(t)
    match rt {
        TNamed(n, args) if cx.sfields.contains(n) => {
            match promote(cx, true, n, name) {
                // promoted from an embedded struct: `admin.name` is `admin.User.name`
                Path(path, _) => {
                    let (r, rt2) = embed_path(mut st, cx, recv, rt, path)
                    st.rewrite(e, EField(r, name, nsp))
                    return field_of(mut st, cx, fx, e, r, rt2, name, nsp)
                },
                Ambiguous(paths) => {
                    ambiguous(mut st, nsp, n, name, paths)
                    return TErr
                },
                _ => {},
            }
            let fs = struct_fields(st, cx, n, args)
            match fs.find(|f| f.0 == name) {
                Some(f) => f.1,
                None => match arity {
                    Some(k) => method_value(mut st, cx, fx, e, recv, t, name, nsp, k),
                    None => {
                        let is_mut = mut_method(mut st, cx, nsp.file, t, name)
                        if is_mut {
                            return mut_value(mut st, name, nsp)
                        }
                        let mut d = diag.error("E0103", nsp, "struct `{n}` has no field `{name}`")
                        if cx.fns.contains(n + "::" + name) {
                            d = d.note("`{name}` is a method; call it with parentheses: `.{name}()`")
                        }
                        st.did_you_mean(d, name, fs.map(|f| f.0))
                        TErr
                    },
                },
            }
        },
        TCap("Root") => match builtins.root_fields().find(|f| f.0 == name) {
            Some(f) => f.1,
            None => match arity {
                Some(k) => method_value(mut st, cx, fx, e, recv, t, name, nsp, k),
                None => {
                    st.did_you_mean(diag.error("E0103", nsp, "`Root` has no field `{name}`"), name, builtins.root_fields().map(|f| f.0))
                    TErr
                },
            },
        },
        TErr => TErr,
        TVar(_) => {
            st.report(diag.error("E0207", recv.span, "the type of this value is not known here; add a type annotation"))
            TErr
        },
        _ => match arity {
            Some(k) => method_value(mut st, cx, fx, e, recv, t, name, nsp, k),
            None => {
                let is_mut = mut_method(mut st, cx, nsp.file, t, name)
                if is_mut {
                    return mut_value(mut st, name, nsp)
                }
                let mut d = diag.error("E0103", nsp, "`{st.show(rt)}` has no field `{name}`")
                if builtins.names(rt).contains(name) {
                    d = d.note("`{name}` changes its receiver in place, so it cannot be a value; call it as `{name}(...)`")
                }
                st.report(d)
                TErr
            },
        },
    }
}

// How many arguments (besides the receiver) method `name` of a value of
// type `t` takes, if it has one that can be used as a value.
fn method_arity(mut st: env.State, cx: env.Cx, file: Int, t: types.Ty, name: Str) -> Option[Int] {
    let is_mut = mut_method(mut st, cx, file, t, name)
    if is_mut {
        return None
    }
    let key = builtin_method(mut st, cx, t, name, file)
    match key {
        Some(k) => {
            return cx.fns.get(k).map(|s| s.params.len() - 1)
        },
        None => {},
    }
    let rt = st.repr(t)
    let arity = match rt {
        TNamed(n, _) if cx.fns.contains(n + "::" + name) && builtins.type_name(rt).is_none() => cx.fns.get(n + "::" + name).map(|s| s.params.len() - 1),
        TDyn(i, a) => iface_methods(st, cx, env.Bound { iface: i, args: a }).find(|m| m.name == name).map(|m| m.params.len()),
        TParam(g) => {
            let mut found: Option[Int] = None
            for b in bounds_of(st, g) {
                match iface_methods(st, cx, b).find(|m| m.name == name) {
                    Some(m) => {
                        found = Some(m.params.len())
                        break
                    },
                    None => {},
                }
            }
            found
        },
        // they change the receiver
        TList(_) | TMap(..) if name == "push" || name == "remove" => None,
        _ => builtins.find(rt, TErr, name).map(|m| m.params.len()),
    }
    arity
}

// Whether method `name` of a value of type `t` has a `mut` parameter: it
// can only be called.
fn mut_method(mut st: env.State, cx: env.Cx, file: Int, t: types.Ty, name: Str) -> Bool {
    let key = builtin_method(mut st, cx, t, name, file)
    match key {
        Some(k) => cx.has_mut(k),
        None => match st.repr(t) {
            TNamed(n, _) if builtins.type_name(st.repr(t)).is_none() => cx.has_mut(n + "::" + name),
            _ => false,
        },
    }
}

fn mut_value(mut st: env.State, name: Str, nsp: ast.Span) -> types.Ty {
    let d = diag.error("E0215", nsp, "`{name}` has a `mut` parameter, so it can only be called, not used as a value").note("a `mut` argument is a place, which only a direct call can pass: call `.{name}(...)` on the value")
    st.report(d)
    TErr
}

// `x.name` without a call, where `name` is a method: a closure that calls
// it on the value `x` had when the expression ran, as if written
// `{ let $recv = x; |a, b| $recv.name(a, b) }`. The rewritten tree is what
// both backends see; `recv` is already checked.
fn method_value(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, rt: types.Ty, name: Str, nsp: ast.Span, arity: Int) -> types.Ty {
    let sp = e.span
    let params = (0..<arity).map(|i| ast.ClosureParam { name: "$a{i}", ty: None, span: sp })
    let mut args: List[ast.Expr] = []
    for p in params {
        let a = st.node(EVar(p.name), sp)
        args.push(a)
    }
    let self_var = st.node(EVar("$recv"), sp)
    let call = st.node(EMethod(self_var, name, nsp, args), sp)
    let clo = st.node(EClosure(params, call), sp)
    let bind_recv = ast.Stmt { desc: SLet(false, "$recv", recv.span, None, recv), span: sp }
    st.rewrite(e, EBlock(ast.Block { stmts: [bind_recv], tail: Some(clo), span: sp }))
    let inside = fx.push().bind("$recv", env.Var { ty: rt, mutable: false, span: recv.span, kind: KLet })
    check_expr(mut st, cx, inside, clo)
}

// The method `name` that file `file` added to built-in type `t`, if any;
// one of the built-in methods written in Limen counts as used.
fn builtin_method(mut st: env.State, cx: env.Cx, t: types.Ty, name: Str, file: Int) -> Option[Str] {
    let tn = match builtins.type_name(st.repr(t)) {
        Some(tn) => tn,
        None => {
            return None
        },
    }
    let suffix = tn + "::" + name
    let own = (cx.by_suffix.get(suffix) ?? []).find(|k| match cx.method_owner.get(k) {
        Some((_, f)) => f == file,
        None => false,
    })
    let in_methods_file = match cx.method_owner.get(suffix) {
        Some((_, f)) => f == cx.methods_file,
        None => false,
    }
    if own.is_none() && cx.fns.contains(suffix) && in_methods_file {
        st.used[suffix] = true
        return Some(suffix)
    }
    own
}

// The interface methods of bound `b`, its parameters replaced by the
// bound's arguments.
pub fn iface_methods(st: env.State, cx: env.Cx, b: env.Bound) -> List[env.IfaceMethod] {
    let ms = cx.ifaces.get(b.iface) ?? []
    match cx.iface_gen.get(b.iface) {
        Some(gs) if !gs.is_empty() && gs.len() == b.args.len() => {
            let inst = gs.zip(b.args)
            ms.map(|m| { m with params: m.params.map(|p| st.subst(inst, p)), ret: st.subst(inst, m.ret) })
        },
        _ => ms,
    }
}

fn bounds_of(st: env.State, g: Str) -> List[env.Bound] {
    st.bounds.find(|b| b.param == g).map(|b| b.bounds) ?? []
}

// Whether type parameter `g` of the function being checked has bound `b`.
fn bounded(st: env.State, g: Str, b: Str) -> Bool {
    let bs = bounds_of(st, g).map(|x| x.iface)
    bs.contains(b) || (b == "Ordered" && bs.contains("Key"))
}

// ---------- struct embedding ----------

// Where a member of a struct lives.
enum Found {
    // the struct itself has it
    Own,
    // the embedded fields to go through, and the struct that has it
    Path(List[Str], Str),
    // the paths of the structs at the nearest depth that have it
    Ambiguous(List[List[Str]]),
    Missing,
}

// A method struct `t` declares itself, not one forwarded from an embedded
// struct.
fn own_method(cx: env.Cx, t: Str, name: Str) -> Bool {
    let key = t + "::" + name
    cx.fns.contains(key) && !cx.forwarders.contains(key)
}

// Where member `name` of struct `n` lives. A field access (`x.name`)
// looks for fields and methods; a call (`x.name()`) for methods only. The
// struct's own come first, then the embedded structs one depth at a time;
// two at the nearest depth that has it make it ambiguous.
fn promote(cx: env.Cx, fields: Bool, n: Str, name: Str) -> Found {
    let has = |t: Str| (fields && (cx.sfields.get(t) ?? []).any(|f| f.0 == name)) || own_method(cx, t, name)
    if has(n) {
        return Own
    }
    let embeds_of = |at: (Str, List[Str])| match cx.structs.get(at.0) {
        Some(s) => s.embeds.flat_map(|f| match s.fields.find(|x| x.name == f).map(|x| x.ty.desc) {
            Some(TyName(tn, _)) if cx.structs.contains(tn) => [(tn, at.1 + [f])],
            _ => [],
        }),
        None => [],
    }
    // the structs at shallower depths, so a struct that embeds itself (an
    // error reported elsewhere) cannot loop
    let mut seen = [n]
    let mut level = [(n, [])]
    while true {
        let next = level.flat_map(embeds_of).filter(|x| !seen.contains(x.0))
        if next.is_empty() {
            return Missing
        }
        match next.filter(|x| has(x.0)) {
            [(t, path)] => {
                return Path(path, t)
            },
            [] => {
                seen = seen + next.map(|x| x.0)
                level = next
            },
            many => {
                return Ambiguous(many.map(|x| x.1))
            },
        }
    }
    Missing
}

// `recv` (of type `rt`, already checked) followed by the embedded fields
// of `path`: the explicit form of a promoted access, `admin.User`. The
// added field names get an empty span, so tools see only what was written.
fn embed_path(mut st: env.State, cx: env.Cx, recv: ast.Expr, rt: types.Ty, path: List[Str]) -> (ast.Expr, types.Ty) {
    let mut x = recv
    let mut t = rt
    for fld in path {
        let ft = match st.repr(t) {
            TNamed(n, args) if cx.sfields.contains(n) => struct_fields(st, cx, n, args).find(|f| f.0 == fld).map(|f| f.1) ?? TErr,
            _ => TErr,
        }
        let next_x = st.node(EField(x, fld, { x.span with lo: x.span.hi }), x.span)
        st.set_type(next_x, ft)
        x = next_x
        t = ft
    }
    (x, t)
}

fn ambiguity(n: Str, name: Str, paths: List[List[Str]]) -> Str {
    let ways = paths.map(|p| "`" + (p + [name]).join(".") + "`").join(" and ")
    "`{name}` is ambiguous in `{n}`: it is reached through {ways}, at the same depth"
}

fn ambiguous(mut st: env.State, sp: ast.Span, n: Str, name: Str, paths: List[List[Str]]) {
    let which = paths.map(|p| "`." + (p + [name]).join(".") + "`").join(" or ")
    st.report(diag.error("E0120", sp, ambiguity(n, name, paths)).note("name the embedded struct you mean: {which}"))
}

// ---------- method calls ----------

fn check_method(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, name: Str, nsp: ast.Span, args: List[ast.Expr]) -> types.Ty {
    let handle = match st.desc(recv) {
        EVar(g) => match fx.lookup(g) {
            Some((v, crossed)) if v.kind == KGroup => Some((g, v, crossed)),
            _ => None,
        },
        _ => None,
    }
    let (g, v, crossed) = match handle {
        Some(found) => found,
        None => {
            return check_method_value(mut st, cx, fx, e, recv, name, nsp, args, None)
        },
    }
    st.set_type(recv, v.ty)
    let t = match st.repr(v.ty) {
        TGroup(t) => t,
        _ => TErr,
    }
    if crossed {
        st.report(diag.error("E0310", recv.span, "cannot spawn into `{g}` from inside a closure").note("call `go` directly in the group's body"))
    }
    match (name, args) {
        ("go" | "#go", [a]) => {
            // a task that returns () runs for its effect and adds no item
            // to the group's list (the backends see it as `#go`); the
            // others share one type
            let r = st.fresh()
            expect(mut st, cx, fx, a, TFn([], r))
            match st.repr(r) {
                TUnit => {
                    st.rewrite(e, EMethod(recv, "#go", nsp, args))
                },
                _ => {
                    st.unify_at(a.span, t, r)
                },
            }
            TUnit
        },
        ("go" | "#go", _) => {
            st.report(diag.error("E0107", nsp, "`go` takes 1 argument, a closure with no parameters"))
            check_args(mut st, cx, fx, args)
            TUnit
        },
        _ => {
            st.report(diag.error("E0105", nsp, "a group handle only has `go`, not `{name}`"))
            check_args(mut st, cx, fx, args)
            TErr
        },
    }
}

// The arguments of a method call after the receiver: put in parameter
// order, counted, and checked against the parameter types `ps`. Returns
// them, or None when order_args reported a problem with the labels.
// `key` is the method's `Type::name`, or "" for an interface's.
fn method_args(mut st: env.State, cx: env.Cx, fx: env.Fx, key: Str, name: Str, nsp: ast.Span, names: Result[List[Str], Str], defaults: List[Option[ast.Expr]], args: List[ast.Expr], ps: List[types.Ty]) -> Option[List[ast.Expr]] {
    let ordered = order_args(mut st, "method `{name}`", nsp, names, defaults, args)
    let args2 = match ordered {
        None => {
            check_args(mut st, cx, fx, args)
            return None
        },
        Some(a) => a,
    }
    if ps.len() != args2.len() {
        let k = ps.len()
        st.report(diag.error("E0107", nsp, "method `{name}` takes {k} argument{env.plural(k)} besides `self`, but {args2.len()} {env.was_were(args2.len())} supplied"))
        check_args(mut st, cx, fx, args2)
    } else if key == "" {
        for (a, p) in args2.zip(ps) {
            expect(mut st, cx, fx, a, p)
        }
    } else {
        check_method_args(mut st, cx, fx, key, name, nsp, args2, ps)
    }
    Some(args2)
}

// `rt`: the receiver's type, when `recv` is already checked
fn check_method_value(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, name: Str, nsp: ast.Span, args: List[ast.Expr], rt: Option[types.Ty]) -> types.Ty {
    let rt = match rt {
        Some(t) => st.repr(t),
        None => match st.desc(recv) {
            // checked again: a table test's cases share one body, so the
            // receiver of a `mut self` method is already wrapped by the
            // first check
            EMut(x) => {
                let t = check_expr(mut st, cx, fx, x)
                st.set_type(recv, t)
                st.repr(t)
            },
            _ => {
                let t = check_expr(mut st, cx, fx, recv)
                st.repr(t)
            },
        },
    }
    let mut name = name
    match rt {
        TNamed("Result", _) if name == "map_err" => {
            // the old name still works, with a warning and a fix that renames it
            st.report(diag.warning("W0001", nsp, "`map_err` is now called `map_error`").fix("rename it to `map_error`", nsp, "map_error"))
            match st.desc(e) {
                EMethod(r, _, msp, a) => {
                    st.rewrite(e, EMethod(r, "map_error", msp, a))
                },
                _ => {},
            }
            name = "map_error"
        },
        _ => {},
    }
    let labelled = args.any(|a| is_named(st, a))
    let written = [recv] + args.map(|a| unlabel(st, a))
    match rt {
        TErr => {
            check_args(mut st, cx, fx, args)
            return TErr
        },
        TVar(_) => {
            st.report(diag.error("E0207", recv.span, "the type of this value is not known here; add a type annotation"))
            check_args(mut st, cx, fx, args)
            return TErr
        },
        TDyn(..) | TParam(_) => {
            return bound_method(mut st, cx, fx, e, recv, rt, name, nsp, args)
        },
        _ => {},
    }
    let key = builtin_method(mut st, cx, rt, name, nsp.file)
    match key {
        Some(key) => {
            // a method this file added to a built-in type: rewritten to a
            // plain call of `Str::name` (or `mod.Str::name`), receiver first
            let (inst, t) = instantiate(mut st, cx.fns.get(key) ?? env.Sig { gen: [], params: [], ret: TErr })
            add_bounds(mut st, cx, key, inst, nsp)
            match t {
                TFn([p0, ..ps], r) => {
                    st.unify_at(recv.span, p0, rt)
                    mut_receiver(mut st, cx, fx, key, recv)
                    let ordered = method_args(mut st, cx, fx, key, name, nsp, method_params(cx, key), method_defaults(cx, key), args, ps)
                    match ordered {
                        Some(args2) => {
                            mut_overlap(mut st, None, written)
                            let f = st.node(EVar(key), nsp)
                            st.set_type(f, t)
                            st.set_inst(f, inst)
                            st.rewrite(e, ECall(f, [recv] + args2))
                            // reordered by labels, or with defaults filled in
                            if labelled || args2.len() != args.len() {
                                keep_order(mut st, e, written, r)
                            }
                        },
                        None => {},
                    }
                    return r
                },
                _ => {
                    check_args(mut st, cx, fx, args)
                    return TErr
                },
            }
        },
        None => {},
    }
    match rt {
        TNamed(n, _) if cx.sfields.contains(n) => match promote(cx, false, n, name) {
            // promoted from an embedded struct: `admin.greet()` is `admin.User.greet()`
            Path(path, _) => {
                let (r, rt2) = embed_path(mut st, cx, recv, rt, path)
                st.rewrite(e, EMethod(r, name, nsp, args))
                return check_method_value(mut st, cx, fx, e, r, name, nsp, args, Some(rt2))
            },
            Ambiguous(paths) => {
                ambiguous(mut st, nsp, n, name, paths)
                check_args(mut st, cx, fx, args)
                return TErr
            },
            _ => {},
        },
        _ => {},
    }
    match rt {
        TNamed(n, _) if cx.fns.contains(n + "::" + name) && builtins.type_name(rt).is_none() => {
            // a method: `fn name(self: T, ...)`, called with the receiver first
            let key = n + "::" + name
            let (inst, t) = instantiate(mut st, cx.fns.get(key) ?? env.Sig { gen: [], params: [], ret: TErr })
            st.set_inst(e, inst)
            add_bounds(mut st, cx, key, inst, nsp)
            match cx.method_owner.get(key) {
                Some((false, file)) if file != nsp.file => {
                    st.report(diag.error("E0402", nsp, "method `{name}` is private to the module that defines `{n}`").note("mark it `pub fn` in {cx.path_of(file)} to use it here"))
                },
                _ => {},
            }
            match t {
                TFn([p0, ..ps], r) => {
                    st.unify_at(recv.span, p0, rt)
                    mut_receiver(mut st, cx, fx, key, recv)
                    let ordered = method_args(mut st, cx, fx, key, name, nsp, method_params(cx, key), method_defaults(cx, key), args, ps)
                    match ordered {
                        Some(args2) => {
                            mut_overlap(mut st, None, written)
                            if labelled || args2.len() != args.len() {
                                st.rewrite(e, EMethod(recv, name, nsp, args2))
                                keep_order(mut st, e, written, r)
                            }
                        },
                        None => {},
                    }
                    r
                },
                _ => {
                    check_args(mut st, cx, fx, args)
                    TErr
                },
            }
        },
        _ => builtin_method_call(mut st, cx, fx, e, recv, rt, name, nsp, args),
    }
}

// `x.m(...)` where `x: T` and `T` is bounded by interfaces that declare
// `m`, or `x: dyn I`.
fn bound_method(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, rt: types.Ty, name: Str, nsp: ast.Span, args: List[ast.Expr]) -> types.Ty {
    let (g, bs) = match rt {
        TDyn(i, a) => ("dyn " + st.show_bound(env.Bound { iface: i, args: a }), [env.Bound { iface: i, args: a }]),
        TParam(g) => (g, bounds_of(st, g)),
        _ => ("", []),
    }
    let mut found: Option[(Str, env.IfaceMethod)] = None
    for b in bs {
        match iface_methods(st, cx, b).find(|m| m.name == name) {
            Some(m) => {
                found = Some((b.iface, m))
                break
            },
            None => {},
        }
    }
    match found {
        Some((b, m)) => {
            let names = match cx.param_names.get(b + "::" + name) {
                Some(ns) => Ok(ns),
                None => Err(""),
            }
            let labelled = args.any(|a| is_named(st, a))
            let written = [recv] + args.map(|a| unlabel(st, a))
            let ordered = method_args(mut st, cx, fx, "", name, nsp, names, [], args, m.params)
            match ordered {
                Some(args2) if labelled => {
                    st.rewrite(e, EMethod(recv, name, nsp, args2))
                    keep_order(mut st, e, written, m.ret)
                },
                _ => {},
            }
            m.ret
        },
        None => {
            let declared = bs.flat_map(|b| iface_methods(st, cx, b).map(|m| m.name))
            let note = if bs.is_empty() {
                "`{g}` is a type parameter with no bounds; add one, as in `[{g}: Interface]`, whose interface declares `fn {name}(self, ...)`"
            } else {
                let listed = if declared.is_empty() { "nothing" } else { declared.join(", ") }
                "the bounds of `{g}` ({bs.map(|b| st.show_bound(b)).join(", ")}) declare: {listed}"
            }
            st.did_you_mean(diag.error("E0105", nsp, "no method `{name}` on `{g}`").note(note), name, declared)
            check_args(mut st, cx, fx, args)
            TErr
        },
    }
}

// A built-in method: `xs.len()`, `s.split(",")`, `net.get(url)`, ...
fn builtin_method_call(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, recv: ast.Expr, rt: types.Ty, name: Str, nsp: ast.Span, args: List[ast.Expr]) -> types.Ty {
    let u = st.fresh()
    let ms = builtins.methods(rt, u)
    let option_or_result = match rt {
        TNamed("Option" | "Result", _) => true,
        _ => false,
    }
    let m = match ms.find(|x| x.name == name) {
        Some(m) => m,
        None => {
            if name == "unwrap_or" && option_or_result {
                // `x.unwrap_or(d)` is written `x ?? d`
                let mut d = diag.error("E0105", nsp, "there is no `unwrap_or`; write `value ?? default`").note("`??` gives the value inside a `Some` or `Ok`, or the default otherwise, evaluating the default only then")
                match args {
                    [dflt] => {
                        d = d.fix("write it with `??`", ast.merge(recv.span, e.span), with_default(st, cx, e, recv, dflt))
                    },
                    _ => {},
                }
                st.report(d)
                check_args(mut st, cx, fx, args)
                return TErr
            }
            if name == "and_then" && option_or_result {
                // the same operation is called `flat_map` here, as on lists
                let d = diag.error("E0105", nsp, "there is no `and_then`; it is called `flat_map`, as on lists").note("`x.flat_map(f)` passes the value inside a `Some` or `Ok` to `f`, which returns an Option or Result itself").fix("rename it to `flat_map`", nsp, "flat_map")
                st.report(d)
                check_args(mut st, cx, fx, args)
                return TErr
            }
            let names = ms.map(|x| x.name)
            let builtin_names = match builtins.type_name(rt) {
                Some(tn) => cx.builtin_methods(tn),
                None => [],
            }
            let mut d = diag.error("E0105", nsp, "no method `{name}` on type `{st.show(rt)}`")
            let src = cx.text_of(recv.span.file)
            let field_recv = if recv.span.hi <= src.len() { src.slice(recv.span.lo, recv.span.hi) } else { "h" }
            let held_field = match rt {
                TNamed(n, _) => match (cx.sfields.get(n) ?? []).find(|f| f.0 == name) {
                    Some(f) => st.subst.has_fn(f.1),
                    None => false,
                },
                _ => false,
            }
            match rt {
                TNamed(n, _) if (cx.sfields.get(n) ?? []).any(|f| f.0 == name) => {
                    if held_field {
                        d = d.note("`{name}` is a field holding a function; call it as `({field_recv}.{name})(...)`")
                    } else {
                        d = d.note("`{name}` is a field; access it without parentheses")
                    }
                },
                TCap("Root") if builtins.root_fields().any(|f| f.0 == name) => {
                    d = d.note("`{name}` is a field of `Root`; write `root.{name}`")
                },
                TCap("Clock") if name == "after" => {
                    d = d.note("`clock.after(ms)` is a timeout: use it as a `select` arm, `clock.after(ms) => ...`, or as a group deadline, `group g until clock.after(ms) \{ ... }`").note("to wait, call `clock.sleep(ms)`")
                },
                TNamed(n, _) if ms.is_empty() => match user_methods(cx, n) {
                    [] => {
                        d = d.note("`{n}` has no methods; define one as `fn {name}(self: {n}) \{ ... }`")
                    },
                    us => {
                        d = d.note("`{n}` has: {us.join(", ")}")
                    },
                },
                _ => {},
            }
            if !ms.is_empty() && env.suggest(name, names).is_none() {
                d = d.note("`{st.show(rt)}` has: {sort_uniq(names + builtin_names).join(", ")}")
            }
            let users = match rt {
                TNamed(n, _) => user_methods(cx, n),
                _ => [],
            }
            if held_field {
                st.report(d.fix("call the field with brackets", ast.merge(recv.span, nsp), "({field_recv}.{name})"))
            } else {
                st.did_you_mean(d, name, names + users + builtin_names)
            }
            check_args(mut st, cx, fx, args)
            return TErr
        },
    }
    if st.no_wait > 0 {
        match waits(rt, name) {
            Some(what) => {
                update_waits(mut st, nsp, "`{name}` on `{st.show(rt)}` {what}")
            },
            None => {},
        }
    }
    match (name, rt) {
        ("join", TList(a)) => {
            st.unify_at(recv.span, TStr, a)
        },
        ("sum", TList(a)) => {
            st.unify_at(recv.span, TInt, a)
        },
        ("push", TList(_)) | ("remove", TMap(..)) => {
            check_place(mut st, cx, fx, recv)
        },
        _ => {},
    }
    if m.params.len() != args.len() {
        let k = m.params.len()
        st.report(diag.error("E0107", nsp, "`{name}` takes {k} argument{env.plural(k)} but {args.len()} {env.was_were(args.len())} supplied"))
        check_args(mut st, cx, fx, args)
    } else {
        for (a, p) in args.zip(m.params) {
            match (name, rt, a.desc) {
                // the function runs holding the lock: it must not wait
                ("update", TShared(_), EClosure(..)) => {
                    st.no_wait = st.no_wait + 1
                    expect(mut st, cx, fx, a, p)
                    st.no_wait = st.no_wait - 1
                },
                _ => expect(mut st, cx, fx, a, p),
            }
        }
    }
    match (name, rt) {
        ("push", TList(_)) | ("remove", TMap(..)) => {
            mut_overlap(mut st, Some(recv), args)
        },
        _ => {},
    }
    match (name, rt) {
        ("sort", TList(a)) => match unordered(st, cx, a) {
            Some(_) if st.held(st.repr(a)).is_some() => {
                refuse_compare(mut st, nsp, "sort", a)
            },
            Some(t) => {
                let shown = match st.subst.fn_via(a) {
                    Some(path) => "`{st.show(st.repr(a))}` (it holds a function through `{path}`)",
                    None => "`{st.show(t)}`",
                }
                let d = diag.error("E0201", nsp, "`List[{st.show(a)}]` cannot be sorted: {shown} has no order").note("numbers, strings, Bool, and lists, tuples, structs and enums of them are ordered; to sort by a key use `xs.sort_by(key)`, for another order `list.sort_by(xs, less)`")
                st.report(d)
            },
            None => {},
        },
        ("contains", TList(a)) | ("contains", TArray(a, _)) => {
            st.compared = [(nsp, a, "contains")] + st.compared
        },
        _ => {},
    }
    m.result
}

// E0312: inside a closure literal given to `Shared.update`, which runs
// holding the value's lock. What else waits (a call of a function that
// waits) is a panic when it happens: "update must not wait".
fn waits(rt: types.Ty, name: Str) -> Option[Str] {
    match (rt, name) {
        (TChan(_), "send" | "recv") => Some("can wait"),
        (TShared(_), _) => Some("takes a lock another task can hold"),
        (TCap("Clock"), "sleep") | (TCap("Stdin"), _) | (TCap("Listener"), "accept") | (TCap("Conn"), "read" | "write" | "read_within" | "write_within" | "start_tls") | (TCap("Exec"), "run") => Some("can wait"),
        (TCap("Net"), "get" | "connect" | "connect_tls") => Some("can wait"),
        _ => None,
    }
}

fn update_waits(mut st: env.State, sp: ast.Span, what: Str) {
    st.report(diag.error("E0312", sp, "the function given to `update` must not wait: {what}").note("`update` holds the Shared value's lock while its function runs; wait before or after it, and only compute the new value inside"))
}

fn sort_uniq(xs: List[Str]) -> List[Str] {
    let sorted = xs.sort()
    sorted.with_index().filter(|p| p.0 == 0 || sorted[p.0 - 1] != p.1).map(|p| p.1)
}

// The methods defined on user type `n`, by name, sorted.
fn user_methods(cx: env.Cx, n: Str) -> List[Str] {
    let prefix = n + "::"
    cx.fns.keys().filter(|k| k.starts_with(prefix)).map(|k| k.slice(prefix.len(), k.len())).sort()
}

// The text of the fix that writes `recv.unwrap_or(dflt)` as `recv ?? dflt`,
// parenthesized where `??` would bind differently from the method call.
fn with_default(st: env.State, cx: env.Cx, e: ast.Expr, recv: ast.Expr, dflt: ast.Expr) -> Str {
    let src = cx.text_of(recv.span.file)
    let text = |sp: ast.Span| if sp.hi <= src.len() { src.slice(sp.lo, sp.hi) } else { "" }
    let simple = |x: ast.Expr| match st.desc(x) {
        EBin(..) | EIf(..) | EMatch(..) | EClosure(..) => false,
        _ => true,
    }
    let d = if simple(dflt) { text(dflt.span) } else { "(" + text(dflt.span) + ")" }
    let r = if simple(recv) { text(recv.span) } else { "(" + text(recv.span) + ")" }
    let next = if e.span.hi < src.len() { src.slice(e.span.hi, e.span.hi + 1) } else { " " }
    let prev = if recv.span.lo > 0 { src.slice(recv.span.lo - 1, recv.span.lo) } else { " " }
    let core = r + " ?? " + d
    if next == "." || next == "[" || next == "?" || prev == "-" || prev == "!" { "(" + core + ")" } else { core }
}

// Types with an order, for `<` and `sort()`: numbers, strings (bytes),
// Bool (false first), (), and lists, arrays, tuples, structs and enums of
// ordered types, compared item by item. Returns the first type in the way,
// if any.
fn unordered(st: env.State, cx: env.Cx, t: types.Ty) -> Option[types.Ty] {
    first_in_way(st, cx, t, false, []).0
}

// Why type `t` does not satisfy the bound `Ordered`, if it does not.
pub fn unordered_why(st: env.State, cx: env.Cx, t: types.Ty) -> Option[Str] {
    unordered(st, cx, t).map(|u| {
        let shown = match st.subst.fn_via(t) {
            Some(path) => "`{st.show(st.repr(t))}` (it holds a function through `{path}`)",
            None => "`{st.show(u)}`",
        }
        "{shown} has no order: numbers, strings, Bool, and lists, tuples, structs and enums of them are ordered"
    })
}

// Map keys: Int, Str, Bool, and tuples, structs and enums made of them.
// Returns the first type in the way, if any.
pub fn unkeyable(st: env.State, cx: env.Cx, t: types.Ty) -> Option[types.Ty] {
    first_in_way(st, cx, t, true, []).0
}

// The walk `unordered` (`keys` false) and `unkeyable` (`keys` true) share:
// structs and enums are fine when what they hold is, and for an order,
// lists and arrays when their items are. `seen` holds the structs and enums
// already entered, so a recursive type is entered once.
fn first_in_way(st: env.State, cx: env.Cx, t: types.Ty, keys: Bool, seen: List[Str]) -> (Option[types.Ty], List[Str]) {
    let rt = st.repr(t)
    match rt {
        TInt | TStr | TBytes | TBool | TUInt(_) | TVar(_) | TErr => (None, seen),
        TFloat | TUnit if !keys => (None, seen),
        TParam(g) if bounded(st, g, if keys { "Key" } else { "Ordered" }) => (None, seen),
        TList(a) | TArray(a, _) if !keys => first_in_way(st, cx, a, keys, seen),
        TNamed(n, args) => {
            let key = st.show(rt)
            if seen.contains(key) {
                return (None, seen)
            }
            let mut seen = seen + [key]
            let parts = match cx.structs.get(n) {
                Some(s) => {
                    let inst = s.generics.zip(args)
                    (cx.sfields.get(n) ?? []).map(|f| st.subst(inst, f.1))
                },
                None => match cx.enums.get(n) {
                    Some(en) => {
                        let inst = en.generics.zip(args)
                        (cx.variants.get(n) ?? []).flat_map(|v| v.1.map(|p| st.subst(inst, p)))
                    },
                    None => {
                        return (Some(rt), seen)
                    },
                },
            }
            for p in parts {
                let (found, next) = first_in_way(st, cx, p, keys, seen)
                seen = next
                if found.is_some() {
                    return (found, seen)
                }
            }
            (None, seen)
        },
        _ => (Some(rt), seen),
    }
}

fn check_place(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr) {
    match st.desc(e) {
        EVar(n) => match fx.lookup(n) {
            Some((_, true)) => {
                st.report(diag.error("E0205", e.span, "cannot modify `{n}` inside a closure").note("closures capture variables by value; return the new value from the closure instead"))
            },
            Some((v, false)) if !v.mutable => match v.kind {
                KLet => {
                    st.report(diag.error("E0205", e.span, "cannot modify `{n}`, it is not declared `mut`").fix("declare it as `let mut {n}`", { v.span with hi: v.span.lo }, "mut "))
                },
                KParam => {
                    st.report(diag.error("E0205", e.span, "cannot modify parameter `{n}`").note("parameters are immutable; declare it `mut {n}` to change the caller's value, or make a copy with `let mut {n} = {n}`"))
                },
                KPat => {
                    st.report(diag.error("E0205", e.span, "cannot modify `{n}`, pattern and loop bindings are immutable"))
                },
                KGroup => {
                    st.report(diag.error("E0310", e.span, "`{n}` is a group handle; the only thing you can do with it is `{n}.go(...)`"))
                },
            },
            Some(_) => {},
            None => {
                st.report(diag.error("E0209", e.span, "this cannot be assigned to"))
            },
        },
        EField(r, _, _) | EIndex(r, _) => check_place(mut st, cx, fx, r),
        _ => {
            st.report(diag.error("E0209", e.span, "only variables, fields and list elements can be assigned to"))
        },
    }
}

// What cannot be changed in place even though it is a place: the target of
// an assignment or a `mut` argument, after it is checked.
fn check_target(mut st: env.State, lhs: ast.Expr) {
    match st.desc(lhs) {
        EBlock(_) => {
            st.report(diag.error("E0209", lhs.span, "a method cannot be assigned to"))
        },
        EIndex(b, _) if st.repr(st.type_of(b)) == TBytes => {
            let d = diag.error("E0209", lhs.span, "`Bytes` cannot be changed in place").note("build a new value: `b.slice(0, i) + bytes([x]) + b.slice(i + 1, b.len())`")
            st.report(d)
        },
        _ => {},
    }
}

// The arguments of a call to a function or method declared with `fn`, in
// parameter order, checked against its parameter types `ps`: a `mut`
// parameter takes a `mut` place, and only it does. `who` names the callee,
// written at `csp`; `names` and `muts` are its parameters' names and which
// of them are `mut`; `passed_to` the function a function parameter passed
// on goes to.
fn check_fn_args(mut st: env.State, cx: env.Cx, fx: env.Fx, passed_to: Option[Str], who: Str, csp: ast.Span, names: List[Str], muts: List[Bool], args: List[ast.Expr], ps: List[types.Ty]) {
    for (k, (a, p)) in args.zip(ps).with_index() {
        let pn = names.get(k) ?? ""
        let m = muts.get(k) ?? false
        match st.desc(a) {
            EMut(x) => {
                if m {
                    check_mut_arg(mut st, cx, fx, a, x, p)
                } else {
                    let d = diag.error("E0213", a.span, "`{who}` does not change its parameter `{pn}`, so the argument is written without `mut`").fix("remove `mut`", { a.span with hi: x.span.lo }, "")
                    st.report(d)
                    expect(mut st, cx, fx, x, p)
                    st.set_type(a, p)
                }
            },
            desc => {
                if m {
                    // a value piped in starts before the callee
                    let piped = a.span.lo < csp.lo
                    let mut d = diag.error("E0213", a.span, "`{who}` changes its parameter `{pn}`, so the argument must be written with `mut`")
                    let place = match desc {
                        EVar(_) | EField(..) | EIndex(..) => true,
                        _ => false,
                    }
                    if piped {
                        let shown = if place { source_of(cx, a.span) } else { "x" }
                        d = d.note("a value piped with `|>` cannot be passed as `mut`; call `{who}(mut {shown})`")
                    } else if place {
                        d = d.fix("add `mut`", { a.span with hi: a.span.lo }, "mut ")
                    }
                    st.report(d)
                }
                // a function parameter passed on: pure if the callee is, there
                match (passed_to, desc) {
                    (Some(g), EVar(_)) => {
                        st.arg_of = Some((g, k))
                    },
                    _ => {},
                }
                expect(mut st, cx, fx, a, p)
                st.arg_of = None
            },
        }
    }
}

// The text at `sp`.
fn source_of(cx: env.Cx, sp: ast.Span) -> Str {
    let src = cx.text_of(sp.file)
    if sp.hi <= src.len() { src.slice(sp.lo, sp.hi) } else { "" }
}

// A method's arguments after the receiver; `key` is `Type::name`.
fn check_method_args(mut st: env.State, cx: env.Cx, fx: env.Fx, key: Str, name: Str, nsp: ast.Span, args: List[ast.Expr], ps: List[types.Ty]) {
    let names = match method_params(cx, key) {
        Ok(ns) => ns,
        Err(_) => [],
    }
    let muts = match cx.param_muts.get(key) {
        Some([_, ..ms]) => ms,
        _ => [],
    }
    check_fn_args(mut st, cx, fx, None, name, nsp, names, muts, args, ps)
}

// `mut x` for a `mut` parameter: `x` is a place the caller may change, of
// exactly the parameter's type (no conversion makes a place).
fn check_mut_arg(mut st: env.State, cx: env.Cx, fx: env.Fx, a: ast.Expr, x: ast.Expr, p: types.Ty) {
    check_place(mut st, cx, fx, x)
    let t = check_expr(mut st, cx, fx, x)
    check_target(mut st, x)
    let ok = st.unify(p, t)
    if !ok {
        st.report(diag.error("E0201", x.span, "a `mut` argument must have exactly the parameter's type: expected `{st.show(p)}`, found `{st.show(t)}`"))
    }
    st.set_type(a, p)
}

// The receiver of a call to method `key`: for `mut self`, a place the
// caller may change, which the backends see as `mut recv`.
fn mut_receiver(mut st: env.State, cx: env.Cx, fx: env.Fx, key: Str, recv: ast.Expr) {
    if !cx.mut_self(key) {
        return
    }
    match st.desc(recv) {
        // checked again: a table test's cases share one body, so the first
        // check already wrapped it
        EMut(x) => {
            check_place(mut st, cx, fx, x)
            check_target(mut st, x)
        },
        d => {
            check_place(mut st, cx, fx, recv)
            check_target(mut st, recv)
            let inner = st.node(d, recv.span)
            st.set_type(inner, st.type_of(recv))
            st.set_inst(inner, st.inst_of(recv))
            st.rewrite(recv, EMut(inner))
        },
    }
}

// ---------- overlapping `mut` places ----------

// A step of the path of a `mut` place: a field or tuple item by name, or
// any index of a list, array or map, since its value is not known when
// checking.
enum PStep {
    PName(Str),
    PAny,
}

// The path of a `mut` place: its root variable, then its steps.
fn place_path(st: env.State, e: ast.Expr) -> Option[(Str, List[PStep])] {
    match st.desc(e) {
        EVar(n) => Some((n, [])),
        EField(a, n, _) => place_path(st, a).map(|p| (p.0, p.1 + [PName(n)])),
        EIndex(a, _) => place_path(st, a).map(|p| (p.0, p.1 + [PAny])),
        EMut(x) => place_path(st, x),
        _ => None,
    }
}

// Two places overlap when they share a root and, walked together, never
// name two different fields before one of them ends. Roots are compared
// by name, so this is conservative under shadowing: a `mut` place on a
// name a nested block shadows can be refused although it is another
// variable.
fn overlaps(a: (Str, List[PStep]), b: (Str, List[PStep])) -> Bool {
    if a.0 != b.0 {
        return false
    }
    let mut k = 0
    while k < a.1.len() && k < b.1.len() {
        match (a.1[k], b.1[k]) {
            (PName(x), PName(y)) if x != y => {
                return false
            },
            _ => {},
        }
        k = k + 1
    }
    true
}

// The expressions directly inside `e`, in its form now; none for a
// closure.
fn expr_kids(st: env.State, e: ast.Expr) -> List[ast.Expr] {
    match st.desc(e) {
        EInt(_) | EFloat(_) | EBool(_) | EUnit | EVar(_) | EClosure(..) => [],
        EStr(parts) => parts.flat_map(|part| match part {
            SPExpr(x) => [x],
            SPLit(_) => [],
        }),
        EList(items) => items,
        EBin(_, a, b) | EPipe(a, b) | EIndex(a, b) | ESafe(a, _, b) => [a, b],
        EUn(_, a) | EField(a, _, _) | ENamed(_, _, a) | EMut(a) | EDyn(a, _) => [a],
        ECall(f, args) | EMethod(f, _, _, args) => [f] + args,
        ETry(a, context) => [a] + (context.map(|c| [c]) ?? []),
        EIf(c, then, other) => [c] + walk.block_kids(then) + (other.map(|o| [o]) ?? []),
        EMatch(x, arms) => [x] + arms.flat_map(|a| (a.guard.map(|g| [g]) ?? []) + [a.body]),
        EBlock(b) => walk.block_kids(b),
        EStruct(_, _, fields) => fields.map(|f| f.value),
        EWith(base, fields) => [base] + fields.map(|f| f.value),
        EGroup(_, _, until, b) => (until.map(|d| [d.clock, d.ms]) ?? []) + walk.block_kids(b),
        ESelect(arms) => arms.flat_map(|a| walk.sel_op(a.op) + (a.guard.map(|g| [g]) ?? []) + [a.body]),
    }
}

// A place a call changes: where it is written, its path, and whether it
// is written `mut` (a `mut` argument or receiver is, the receiver of
// `push` or `remove` is not).
struct Changed {
    at: ast.Span,
    path: (Str, List[PStep]),
    written: Bool,
}

// Two changed places clash when they overlap and at least one is written
// `mut`, so code without `mut` is never refused.
fn clash(a: Changed, b: Changed) -> Bool {
    (a.written || b.written) && overlaps(a.path, b.path)
}

// `x` as a changed place, if it is a place.
fn place_at(st: env.State, x: ast.Expr, written: Bool) -> List[Changed] {
    place_path(st, x).map(|p| [Changed { at: x.span, path: p, written }]) ?? []
}

fn changes_receiver(st: env.State, r: ast.Expr, m: Str) -> Bool {
    match (m, st.repr(st.type_of(r))) {
        ("push", TList(_)) | ("remove", TMap(..)) => true,
        _ => false,
    }
}

// The places call `e` changes itself, in written order.
fn own_places(st: env.State, e: ast.Expr) -> List[Changed] {
    let muts = |xs: List[ast.Expr]| xs.flat_map(|x| match st.desc(x) {
        EMut(_) => place_at(st, x, true),
        _ => [],
    })
    match st.desc(e) {
        ECall(_, args) => muts(args),
        EMethod(r, m, _, args) => if changes_receiver(st, r, m) { place_at(st, r, false) + muts(args) } else { muts([r] + args) },
        _ => [],
    }
}

// What is inside the parts of a call: the indexes of a `mut` place, the
// whole of anything else.
fn inside_parts(st: env.State, xs: List[ast.Expr]) -> List[ast.Expr] {
    xs.flat_map(|x| match st.desc(x) {
        EMut(p) => expr_kids(st, p),
        _ => [x],
    })
}

// The places that calls inside `e` change, outside closures, leaving out
// those a call between `e` and them already refuses, `above` being the
// places those calls change themselves.
fn changed_in(st: env.State, above: List[Changed], e: ast.Expr) -> List[Changed] {
    match st.desc(e) {
        EClosure(..) => [],
        ECall(..) | EMethod(..) => {
            let own = own_places(st, e)
            let outer = own + above
            own.filter(|c| !above.any(|a| clash(c, a))) + inside_parts(st, expr_kids(st, e)).flat_map(|k| changed_in(st, outer, k))
        },
        _ => expr_kids(st, e).flat_map(|k| changed_in(st, above, k)),
    }
}

// The places assigned (`p = v`) in a block, with where each is written:
// its statements and those of the blocks they hold.
fn block_assigns(st: env.State, b: ast.Block) -> List[(ast.Span, (Str, List[PStep]))] {
    b.stmts.flat_map(|s| match s.desc {
        SAssign(a, _) => place_path(st, a).map(|p| [(a.span, p)]) ?? [],
        SWhile(_, body) | SFor(_, _, _, body) | SForPat(_, _, body) | SDefer(body) => block_assigns(st, body),
        _ => [],
    })
}

// The places assigned inside `e`, outside closures: those of the blocks
// directly in it, then those of the expressions inside it.
fn assigned_in(st: env.State, e: ast.Expr) -> List[(ast.Span, (Str, List[PStep]))] {
    let here = match st.desc(e) {
        EClosure(..) => {
            return []
        },
        EBlock(b) | EIf(_, b, _) | EGroup(_, _, _, b) => block_assigns(st, b),
        _ => [],
    }
    here + expr_kids(st, e).flat_map(|k| assigned_in(st, k))
}

// E0214: the `mut` places of one call, `changed` (the receiver of `push`
// or `remove`) and the `mut` ones among `parts` (its receiver and
// arguments, in written order), may not clash, nor may a place that a
// call inside them changes clash with one of them.
fn mut_overlap(mut st: env.State, changed: Option[ast.Expr], parts: List[ast.Expr]) {
    let first = match changed {
        Some(r) => place_at(st, r, false),
        None => [],
    }
    let own = first + parts.flat_map(|x| match st.desc(x) {
        EMut(_) => place_at(st, x, true),
        _ => [],
    })
    let mut seen: List[Changed] = []
    for c in own {
        if seen.any(|q| clash(c, q)) {
            st.report(diag.error("E0214", c.at, "this `mut` argument overlaps another one of the same call").note("a call changes each value through one `mut` argument: `mut p.x, mut p.y` are separate, but two elements of one list or map are not (take them out and put them back)"))
        }
        seen.push(c)
    }
    if own.is_empty() {
        return
    }
    let whole = match changed {
        Some(r) => [r] + parts,
        None => parts,
    }
    for c in inside_parts(st, whole).flat_map(|k| changed_in(st, [], k)) {
        if own.any(|o| clash(c, o)) {
            st.report(diag.error("E0214", c.at, "this changes a value that the enclosing call also takes as `mut`").note("make that call first, on its own line, and pass its result"))
        }
    }
    // an assignment in another argument would change the place the callee
    // is given, or what the caller reads back
    for a in inside_parts(st, whole).flat_map(|k| assigned_in(st, k)) {
        if own.any(|o| o.written && overlaps(a.1, o.path)) {
            st.report(diag.error("E0214", a.0, "this assigns a value that the enclosing call takes as `mut`").note("assign it before the call, on its own line"))
        }
    }
    // an index of a `mut` place assigning a variable another index of it
    // reads: the backends would find different places
    for x in parts {
        match st.desc(x) {
            EMut(p) => {
                let ixs = place_indexes(st, p)
                for (k, i) in ixs.with_index() {
                    for a in assigned_in(st, i) {
                        let (sp, path) = a
                        let name = path.0
                        if ixs.with_index().any(|m| m.0 != k && reads(st, name, m.1)) {
                            st.report(diag.error("E0214", sp, "this assigns a variable that another index of the same `mut` place reads").note("assign it before the call, on its own line"))
                        }
                    }
                }
            },
            _ => {},
        }
    }
}

// The indexes and keys of a place, in written order.
fn place_indexes(st: env.State, e: ast.Expr) -> List[ast.Expr] {
    match st.desc(e) {
        EField(a, _, _) | EMut(a) => place_indexes(st, a),
        EIndex(a, i) => place_indexes(st, a) + [i],
        _ => [],
    }
}

// Does `e` read variable `n` outside closures?
fn reads(st: env.State, n: Str, e: ast.Expr) -> Bool {
    let here = match st.desc(e) {
        EVar(m) => m == n,
        _ => false,
    }
    here || expr_kids(st, e).any(|k| reads(st, n, k))
}

// ---------- `?`, operators, closures, literals ----------

// Can errors of type `e` become `dyn Error`? None if so, else why not.
fn error_conversion(mut st: env.State, cx: env.Cx, e: types.Ty) -> Option[Str] {
    match st.repr(e) {
        TDyn("Error", []) | TErr | TStr | TNamed("IoError", _) => None,
        TVar(_) => {
            let _ = st.unify(e, TDyn("Error", []))
            None
        },
        TNamed(n, _) if (cx.structs.contains(n) || cx.enums.contains(n)) && n != "Option" && n != "Result" => {
            let ct = st.repr(e)
            match st.held(ct) {
                Some(h) => {
                    return Some(h)
                },
                None => {},
            }
            if st.subst.has_fn(ct) || st.subst.has_chan(ct) {
                return Some(st.holds_fn_through(ct) ?? "`{st.show(ct)}` holds a function or channel")
            }
            satisfies(mut st, cx, ct, env.Bound { iface: "Error", args: [] })
        },
        t => Some("`{st.show(t)}` does not satisfy `Error`"),
    }
}

// The fix that changes the function's error type to `dyn Error`.
fn dyn_error_fix(d: diag.Diag, fx: env.Fx) -> diag.Diag {
    match fx.ret_te {
        Some(te) => match te.desc {
            TyName("Result", [_, et]) => d.fix("return `dyn Error`, which any error converts to", et.span, "dyn Error"),
            _ => d,
        },
        None => d,
    }
}

fn check_try(mut st: env.State, cx: env.Cx, fx: env.Fx, x: ast.Expr, context: Option[ast.Expr], sp: ast.Span) -> types.Ty {
    if fx.in_defer > 0 {
        st.report(diag.error("E0115", sp, "`?` cannot leave a `defer` body").note("handle the error inside it, for example with `??` or a `match`"))
        check_expr(mut st, cx, fx, x)
        return TErr
    }
    check_try_ok(mut st, cx, fx, x, context, sp)
}

fn is_dyn_error(st: env.State, t: types.Ty) -> Bool {
    match st.repr(t) {
        TDyn("Error", []) => true,
        _ => false,
    }
}

fn wrong_fn(mut st: env.State, sp: ast.Span, rt: types.Ty, kind: Str) {
    let d = diag.error("E0202", sp, "`?` can only be used in a function that returns `{kind}`, this one returns `{st.show(rt)}`").note("for main, write `fn main(root: Root) -> Result[(), IoError]`")
    st.report(d)
}

// `x? "context"` wraps the error, so the function must return `dyn Error`.
// Whether there is a context.
fn with_context(mut st: env.State, cx: env.Cx, fx: env.Fx, context: Option[ast.Expr], sp: ast.Span) -> Bool {
    let c = match context {
        None => {
            return false
        },
        Some(c) => c,
    }
    expect(mut st, cx, fx, c, TStr)
    match st.repr(fx.ret) {
        TNamed("Result", [_, fe]) if is_dyn_error(st, fe) => {},
        TNamed("Result", [_, fe]) => {
            let d = diag.error("E0202", sp, "`?` with context returns a `dyn Error`, but this function returns errors of type `{st.show(fe)}`")
            st.report(dyn_error_fix(d, fx))
        },
        TVar(_) => {
            let v = st.fresh()
            st.unify_at(sp, fx.ret, types.res(v, TDyn("Error", [])))
        },
        TErr => {},
        rt => {
            wrong_fn(mut st, sp, rt, "Result[_, dyn Error]")
        },
    }
    true
}

fn check_try_ok(mut st: env.State, cx: env.Cx, fx: env.Fx, x: ast.Expr, context: Option[ast.Expr], sp: ast.Span) -> types.Ty {
    if fx.in_group > 0 {
        st.report(diag.error("E0311", sp, "`?` cannot leave a `group` block early; every task must finish first").note("handle the error inside the task, or after the group returns its results"))
    }
    let t = check_expr(mut st, cx, fx, x)
    match st.repr(t) {
        TErr => {
            match context {
                Some(c) => {
                    let _ = check_expr(mut st, cx, fx, c)
                },
                None => {},
            }
            TErr
        },
        TNamed("Result", [a, e]) => {
            let ctxd = with_context(mut st, cx, fx, context, sp)
            match st.repr(fx.ret) {
                TNamed("Result", [_, fe]) if is_dyn_error(st, fe) || ctxd => {
                    if is_dyn_error(st, fe) {
                        let why = error_conversion(mut st, cx, e)
                        match why {
                            Some(why) => {
                                let hint = if st.held(e).is_some() || st.subst.has_fn(e) || st.subst.has_chan(e) {
                                    "an error cannot carry authority: keep capabilities, functions and channels out of the error type"
                                } else {
                                    "give it a method `fn message(self: " + st.show(e) + ") -> Str`"
                                }
                                let d = diag.error("E0202", sp, "`?` cannot turn an error of type `{st.show(e)}` into `dyn Error`").note(why).note(hint)
                                st.report(d)
                            },
                            None => {},
                        }
                    }
                },
                TNamed("Result", [_, fe]) => {
                    let ok = st.unify(fe, e)
                    if !ok {
                        let we = error_conversion(mut st, cx, e)
                        let wf = if we.is_none() { error_conversion(mut st, cx, fe) } else { we }
                        let mut d = diag.error("E0202", sp, "`?` would return an error of type `{st.show(e)}`, but this function returns errors of type `{st.show(fe)}`").note("convert the error first with `.map_error(|e| ...)`, or return `dyn Error`, which any error type with a `message` method converts to")
                        if we.is_none() && wf.is_none() {
                            d = dyn_error_fix(d, fx)
                        }
                        st.report(d)
                    }
                },
                TVar(_) => {
                    if !ctxd {
                        let v = st.fresh()
                        st.unify_at(sp, fx.ret, types.res(v, e))
                    }
                },
                TErr => {},
                rt => {
                    if !ctxd {
                        wrong_fn(mut st, sp, rt, "Result")
                    }
                },
            }
            a
        },
        TNamed("Option", [a]) => {
            // with context, a None becomes an error whose message is the context
            let ctxd = with_context(mut st, cx, fx, context, sp)
            if !ctxd {
                match st.repr(fx.ret) {
                    TNamed("Option", _) | TErr => {},
                    TVar(_) => {
                        let v = st.fresh()
                        st.unify_at(sp, fx.ret, types.opt(v))
                    },
                    rt => {
                        wrong_fn(mut st, sp, rt, "Option")
                    },
                }
            }
            a
        },
        TVar(_) => {
            st.report(diag.error("E0207", x.span, "the type of this value is not known here; add a type annotation"))
            TErr
        },
        other => {
            st.report(diag.error("E0202", x.span, "`?` needs a `Result` or `Option`, found `{st.show(other)}`"))
            TErr
        },
    }
}

fn op_name(op: ast.BinOp) -> Str {
    match op {
        Add => "+",
        Sub => "-",
        Mul => "*",
        Div => "/",
        Mod => "%",
        Eq => "==",
        Ne => "!=",
        Lt => "<",
        Le => "<=",
        Gt => ">",
        Ge => ">=",
        And => "&&",
        Or => "||",
        Else => "??",
        Range => "..<",
        BitAnd => "&",
        BitOr => "|",
        BitXor => "^",
        Shl => "<<",
        Shr => ">>",
    }
}

fn check_bin(mut st: env.State, cx: env.Cx, fx: env.Fx, op: ast.BinOp, a: ast.Expr, b: ast.Expr, sp: ast.Span) -> types.Ty {
    // the operators of a chain `x + y + z ...` on the left of this one,
    // outermost first: checked from the innermost out with a loop, in the
    // order recursion would take, so a long chain takes no stack
    let mut spine: List[(ast.BinOp, ast.Expr, ast.Expr, ast.Expr)] = []
    let mut left = a
    while true {
        match st.desc(left) {
            EBin(op2, a2, b2) => {
                spine.push((op2, a2, b2, left))
                left = a2
            },
            _ => {
                break
            },
        }
    }
    let first = check_expr(mut st, cx, fx, left)
    let mut ta = first
    let mut k = spine.len()
    while k > 0 {
        k = k - 1
        let (op2, a2, b2, node) = spine[k]
        let t = check_bin_rest(mut st, cx, fx, op2, a2, b2, node.span, ta)
        ta = t
        st.set_type(node, t)
    }
    check_bin_rest(mut st, cx, fx, op, a, b, sp, ta)
}

// `a op b` once `a` is checked and has type `ta`.
fn check_bin_rest(mut st: env.State, cx: env.Cx, fx: env.Fx, op: ast.BinOp, a: ast.Expr, b: ast.Expr, sp: ast.Span, ta: types.Ty) -> types.Ty {
    match op {
        And | Or => {
            st.unify_at(a.span, TBool, ta)
            expect(mut st, cx, fx, b, TBool)
            TBool
        },
        // `lo..<hi`: the Ints from lo up to but not including hi
        Range => {
            st.unify_at(a.span, TInt, ta)
            expect(mut st, cx, fx, b, TInt)
            TList(TInt)
        },
        // `opt ?? default`: the value inside, or the default when there is none
        Else => match st.repr(ta) {
            TNamed("Option", [t]) | TNamed("Result", [t, _]) => {
                expect(mut st, cx, fx, b, t)
                t
            },
            TErr => {
                check_expr(mut st, cx, fx, b)
                TErr
            },
            TVar(_) => {
                st.report(diag.error("E0207", a.span, "the type of this value is not known here; add a type annotation"))
                check_expr(mut st, cx, fx, b)
                TErr
            },
            t => {
                st.report(diag.error("E0201", sp, "`??` needs an `Option` or `Result` on its left, found `{st.show(t)}`"))
                check_expr(mut st, cx, fx, b)
                TErr
            },
        },
        _ => {
            // a literal on the left takes the right's type: `1 + x` with x a UInt8
            let ta = match (st.desc(a), st.repr(ta)) {
                (EInt(_), TInt) => {
                    let tb = check_expr(mut st, cx, fx, b)
                    match st.repr(tb) {
                        TUInt(_) => {
                            expect(mut st, cx, fx, a, tb)
                            tb
                        },
                        _ => {
                            st.unify_at(b.span, ta, tb)
                            ta
                        },
                    }
                },
                _ => {
                    expect(mut st, cx, fx, b, ta)
                    ta
                },
            }
            let t = st.repr(ta)
            match op {
                Add => match t {
                    TInt | TFloat | TStr | TBytes | TUInt(_) | TList(_) | TErr | TVar(_) => t,
                    _ => {
                        bad_operands(mut st, sp, op, t)
                        TErr
                    },
                },
                Sub | Mul | Div => match t {
                    TInt | TFloat | TUInt(_) | TErr | TVar(_) => t,
                    _ => {
                        bad_operands(mut st, sp, op, t)
                        TErr
                    },
                },
                Mod | BitAnd | BitOr | BitXor | Shl | Shr => match t {
                    TInt | TUInt(_) | TErr | TVar(_) => t,
                    _ => {
                        bad_operands(mut st, sp, op, t)
                        TErr
                    },
                },
                Lt | Le | Gt | Ge => {
                    if unordered(st, cx, t).is_some() {
                        bad_operands(mut st, sp, op, t)
                    }
                    TBool
                },
                _ => {
                    st.eq_types = [t] + st.eq_types
                    match st.subst.refused(env.equality(), t) {
                        Some(found) => match st.uncomparable(t, found) {
                            Some(why) => {
                                st.report(diag.error("E0201", sp, "operator `{op_name(op)}` cannot be applied to `{st.show(t)}`").note(why))
                                TBool
                            },
                            None => {
                                bad_operands(mut st, sp, op, t)
                                TBool
                            },
                        },
                        // capabilities have no equality, so neither has a value holding one
                        None => match st.held(t) {
                            Some(h) => {
                                st.report(diag.error("E0201", sp, "operator `{op_name(op)}` cannot be applied to `{st.show(t)}`").note(h + ", and capabilities cannot be compared"))
                                TBool
                            },
                            None => TBool,
                        },
                    }
                },
            }
        },
    }
}

fn bad_operands(mut st: env.State, sp: ast.Span, op: ast.BinOp, t: types.Ty) {
    st.report(diag.error("E0201", sp, "operator `{op_name(op)}` cannot be applied to `{st.show(t)}`"))
}

fn check_closure(mut st: env.State, cx: env.Cx, fx: env.Fx, ps: List[ast.ClosureParam], body: ast.Expr, want: Option[types.Ty]) -> types.Ty {
    let (want_ps, want_ret) = match want.map(|w| st.repr(w)) {
        Some(TFn(wp, wr)) if wp.len() == ps.len() => (Some(wp), Some(wr)),
        _ => (None, None),
    }
    let mut scope = env.Scope { vars: map(), barrier: true }
    let mut pts: List[types.Ty] = []
    for (i, p) in ps.with_index() {
        let t = match (p.ty, want_ps) {
            (Some(te), _) => {
                let t = st.resolve(cx, fx.genv, te)
                t
            },
            (None, Some(wp)) => wp[i],
            (None, None) => {
                let t = st.fresh()
                t
            },
        }
        scope.vars[p.name] = env.Var { ty: t, mutable: false, span: p.span, kind: KParam }
        pts.push(t)
    }
    let ret = match want_ret {
        Some(r) => r,
        None => {
            let r = st.fresh()
            r
        },
    }
    let inside = env.Fx { ret, scopes: [scope] + fx.scopes, loops: 0, genv: fx.genv, in_group: 0, in_defer: 0, ret_te: None }
    let bt = check_expr(mut st, cx, inside, body)
    st.unify_at(body.span, ret, bt)
    TFn(pts, ret)
}

// `field: value` pairs set once each, and every value checked: against the
// field's type, or alone when the struct has no such field. `extra_notes`
// says more about a field the struct does not have.
fn check_field_inits(mut st: env.State, cx: env.Cx, fx: env.Fx, name: Str, decl: List[(Str, types.Ty)], inst: List[(Str, types.Ty)], fields: List[ast.FieldInit], extra_notes: fn(Str) -> List[Str]) -> List[Str] {
    let mut seen: List[Str] = []
    for f in fields {
        if seen.contains(f.name) {
            st.report(diag.error("E0106", f.span, "field `{f.name}` is set twice"))
        } else {
            seen.push(f.name)
        }
        match decl.find(|x| x.0 == f.name) {
            Some((_, ft)) => {
                expect(mut st, cx, fx, f.value, st.subst(inst, ft))
            },
            None => {
                let d = extra_notes(f.name).fold(diag.error("E0103", f.span, "struct `{name}` has no field `{f.name}`"), |d, n| d.note(n))
                st.did_you_mean(d, f.name, decl.map(|x| x.0))
                let _ = check_expr(mut st, cx, fx, f.value)
            },
        }
    }
    seen
}

fn check_struct_lit(mut st: env.State, cx: env.Cx, fx: env.Fx, name: Str, nsp: ast.Span, fields: List[ast.FieldInit], sp: ast.Span) -> types.Ty {
    let decl = match cx.sfields.get(name) {
        Some(d) => d,
        None => {
            if cx.enums.contains(name) {
                st.report(diag.error("E0102", nsp, "`{name}` is an enum; build it with a variant, for example `{name}.Variant(...)`"))
            } else {
                st.did_you_mean(diag.error("E0102", nsp, "unknown struct `{name}`"), name, env.keys_in_order(cx.sfields))
            }
            for f in fields {
                let _ = check_expr(mut st, cx, fx, f.value)
            }
            return TErr
        },
    }
    let gen = cx.structs.get(name).map(|s| s.generics) ?? []
    let targs = st.fresh_list(gen.len())
    st.add_type_bounds(cx, name, targs, nsp)
    let embedded = |fname: Str| match promote(cx, true, name, fname) {
        Path(p, _) => {
            let top = p[0]
            ["`{fname}` belongs to the embedded `{p.join(".")}`; set it there: `{top}: {top} \{ {fname}: ... }`"]
        },
        _ => [],
    }
    let seen = check_field_inits(mut st, cx, fx, name, decl, gen.zip(targs), fields, embedded)
    let missing = decl.filter(|f| !seen.contains(f.0))
    if !missing.is_empty() {
        let listed = missing.map(|f| "`" + f.0 + "`").join(", ")
        st.report(diag.error("E0206", sp, "missing field{env.plural(missing.len())} {listed} in `{name}`"))
    }
    TNamed(name, targs)
}

// `a?.b`: `rest` runs on the value inside the Option `a`, bound to `x`.
// The result is an Option: the rest's own when it is one already (so
// `a?.b?.c` is not nested), otherwise the rest wrapped in Some.
fn check_safe(mut st: env.State, cx: env.Cx, fx: env.Fx, e: ast.Expr, base: ast.Expr, x: Str, rest: ast.Expr) -> types.Ty {
    let bt = check_expr(mut st, cx, fx, base)
    let inner = match st.repr(bt) {
        TNamed("Option", [t]) => t,
        TErr => TErr,
        TVar(_) => {
            st.report(diag.error("E0207", base.span, "the type of this value is not known here; add a type annotation"))
            TErr
        },
        TNamed("Result", _) => {
            let d = diag.error("E0201", base.span, "`?.` works on an `Option`, but this is `{st.show(bt)}`").note("`?.` is safe navigation; to return early on `Err` and then use the value, write `(e?).name`")
            st.report(d)
            TErr
        },
        t => {
            st.report(diag.error("E0201", base.span, "`?.` needs an `Option` on its left, found `{st.show(t)}`").note("a value that is always there takes a plain `.`"))
            TErr
        },
    }
    let inside = fx.push().bind(x, env.Var { ty: inner, mutable: false, span: base.span, kind: KPat })
    let rt = check_expr(mut st, cx, inside, rest)
    match (st.repr(bt), st.repr(rt)) {
        (TNamed("Option", _), TNamed("Option", _)) => {
            st.nested[e.id] = true
            rt
        },
        (TNamed("Option", _), TErr) => TErr,
        (TNamed("Option", _), _) => types.opt(rt),
        _ => TErr,
    }
}

// `{ base with x: 1, y }`: a copy of a struct value with some fields
// replaced; the same field errors as a struct literal, minus "missing".
fn check_with(mut st: env.State, cx: env.Cx, fx: env.Fx, base: ast.Expr, fields: List[ast.FieldInit], sp: ast.Span) -> types.Ty {
    let bt = check_expr(mut st, cx, fx, base)
    match st.repr(bt) {
        TNamed(name, targs) if cx.sfields.contains(name) && !ast.is_tuple_name(name) => {
            let gen = cx.structs.get(name).map(|s| s.generics) ?? []
            check_field_inits(mut st, cx, fx, name, cx.sfields.get(name) ?? [], gen.zip(targs), fields, |_| [])
            bt
        },
        TErr => {
            check_values(mut st, cx, fx, fields)
            TErr
        },
        TVar(_) => {
            st.report(diag.error("E0207", base.span, "the type of this value is not known here; add a type annotation"))
            check_values(mut st, cx, fx, fields)
            TErr
        },
        t => {
            let d = diag.error("E0201", base.span, "`\{ ... with ... }` copies a struct, but this is `{st.show(t)}`").note("only struct values have named fields to replace")
            st.report(d)
            check_values(mut st, cx, fx, fields)
            TErr
        },
    }
}

// The values of `fields`, each checked alone.
fn check_values(mut st: env.State, cx: env.Cx, fx: env.Fx, fields: List[ast.FieldInit]) {
    for f in fields {
        let _ = check_expr(mut st, cx, fx, f.value)
    }
}

// ---------- match and patterns ----------

fn check_match(mut st: env.State, cx: env.Cx, fx: env.Fx, s: ast.Expr, arms: List[ast.Arm], sp: ast.Span, want: Option[types.Ty]) -> types.Ty {
    let scrutinee = check_expr(mut st, cx, fx, s)
    let errors_before = st.error_count()
    let result = match want {
        Some(w) => w,
        None => st.fresh(),
    }
    for arm in arms {
        let inside = check_pat(mut st, cx, fx.push(), scrutinee, arm.pat)
        match arm.guard {
            Some(g) => {
                expect(mut st, cx, inside, g, TBool)
            },
            None => {},
        }
        match want {
            Some(w) => {
                expect(mut st, cx, inside, arm.body, w)
            },
            None => {
                let bt = check_expr(mut st, cx, inside, arm.body)
                st.unify_at(arm.body.span, result, bt)
            },
        }
    }
    // an arm, or an alternative in one, that the unguarded arms before it
    // already cover can never run (not looked for after an error in the
    // arms, whose patterns may then not fit their type)
    if st.error_count() == errors_before {
        let mut before: List[List[ast.Pat]] = []
        for arm in arms {
            let alts = exhaust.alternatives(arm.pat)
            if !exhaust.useful(cx, st.subst, true, before, [arm.pat], [scrutinee]) {
                st.report(diag.warning("W0002", arm.pat.span, "this arm can never match: the arms before it cover every value it matches"))
            } else if alts.len() > 1 {
                let mut seen = before
                for alt in alts {
                    if !exhaust.useful(cx, st.subst, true, seen, [alt], [scrutinee]) {
                        st.report(diag.warning("W0002", alt.span, "this alternative can never match: the arms and alternatives before it cover every value it matches"))
                    }
                    seen = [[alt]] + seen
                }
            }
            if arm.guard.is_none() {
                before = [[arm.pat]] + before
            }
        }
    }
    if arms.is_empty() {
        st.report(diag.error("E0204", sp, "`match` needs at least one arm"))
        return result
    }
    // a guarded arm may not apply, so it covers nothing
    let unguarded = arms.filter(|a| a.guard.is_none()).map(|a| a.pat)
    let missing = exhaust.missing_arms(cx, st.subst, scrutinee, unguarded)
    if missing.is_empty() {
        return result
    }
    // the new arms go on their own lines just above the closing brace
    let close = sp.hi - 1
    let src = cx.text_of(sp.file)
    let line_start = line_start_before(src, close - 1)
    let indent = if close <= src.len() { src.slice(line_start, close) } else { "" }
    let own_line = indent.trim() == ""
    let at = if own_line { line_start } else { close }
    let arm_indent = (if own_line { indent } else { "" }) + "    "
    let text = (if own_line { "" } else { "\n" }) + missing.map(|m| "{arm_indent}{m} => panic(\"unhandled\"),\n").join("")
    let d = diag.error("E0204", sp, "`match` does not cover {missing.map(|m| "`" + m + "`").join(", ")}").fix("add the missing arms", { sp with lo: at, hi: at }, text)
    st.report(d)
    result
}

// Where the line holding byte `i` of `src` starts: after the last newline
// at or before `i`, as OCaml's String.rindex_from finds it.
fn line_start_before(src: Str, i: Int) -> Int {
    if i < 0 || i >= src.len() {
        return 0
    }
    let bs = src.bytes()
    let mut k = i
    while k >= 0 {
        if bs[k] == 10 {
            return k + 1
        }
        k = k - 1
    }
    0
}

// Bind the names of pattern `p` for a value of type `t`.
fn check_pat(mut st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, p: ast.Pat) -> env.Fx {
    let mut fx = fx
    let bind = |fx: env.Fx, n: Str, ty: types.Ty, span: ast.Span| fx.bind(n, env.Var { ty, mutable: false, span, kind: KPat })
    match p.desc {
        PWild => fx,
        PBind(n) => bind(fx, n, t, p.span),
        PInt(v) => match st.repr(t) {
            // an unsigned integer matches literals that fit in it
            TUInt(bits) => {
                if v < 0 {
                    st.report(diag.error("E0201", p.span, "a `UInt{bits}` cannot be negative"))
                    fx
                } else if bits < 64 && v >= 1 << bits {
                    st.report(diag.error("E0201", p.span, "{v} does not fit in a `UInt{bits}`, which holds 0 to {(1 << bits) - 1}"))
                    fx
                } else {
                    fx
                }
            },
            _ => {
                st.unify_at(p.span, t, TInt)
                fx
            },
        },
        PStr(_) => {
            st.unify_at(p.span, t, TStr)
            fx
        },
        PBool(_) => {
            st.unify_at(p.span, t, TBool)
            fx
        },
        PTuple(ps) if ps.any(exhaust.is_rest) => match st.repr(t) {
            // `(a, ..)`: the tuple's size comes from its type
            TNamed(n, ts) if ast.is_tuple_name(n) => {
                if ps.len() - 1 > ts.len() {
                    st.report(diag.error("E0107", p.span, "the tuple has {ts.len()} items, the pattern has at least {ps.len() - 1}"))
                    return all_err(mut st, cx, fx, ps)
                }
                check_pats(mut st, cx, fx, ts, exhaust.fill_rest(ps, ts.len()))
            },
            TErr => all_err(mut st, cx, fx, ps),
            TVar(_) => {
                st.report(diag.error("E0207", p.span, "the type of this value is not known here, so `..` cannot stand for its other items; add a type annotation"))
                all_err(mut st, cx, fx, ps)
            },
            other => {
                st.report(diag.error("E0201", p.span, "this pattern is a tuple, but the value is `{st.show(other)}`"))
                all_err(mut st, cx, fx, ps)
            },
        },
        PTuple(ps) => {
            let ts = st.fresh_list(ps.len())
            st.unify_at(p.span, TNamed(ast.tuple_name(ps.len()), ts), t)
            check_pats(mut st, cx, fx, ts, ps)
        },
        PList(ps) => {
            let el = st.fresh()
            st.unify_at(p.span, TList(el), t)
            for q in ps {
                match q.desc {
                    PRest(Some(n)) => {
                        fx = bind(fx, n, TList(el), q.span)
                    },
                    _ => {
                        fx = check_pat(mut st, cx, fx, el, q)
                    },
                }
            }
            fx
        },
        // only inside a tuple, variant or list pattern, which handle it
        PRest(_) => fx,
        PAs(q, n, nsp) => {
            let fx = check_pat(mut st, cx, fx, t, q)
            bind(fx, n, t, nsp)
        },
        PStruct(name, nsp, fields, rest) => check_struct_pat(mut st, cx, fx, t, p, name, nsp, fields, rest),
        POr(alts) => check_or(mut st, cx, fx, t, alts),
        PVariant(q, v, args) => check_variant_pat(mut st, cx, fx, t, p, q, v, args),
    }
}

// `Point \{ x, y: 0, .. }`: the struct's fields, each matched against its
// pattern; without `..`, every field is named.
fn check_struct_pat(mut st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, p: ast.Pat, name: Str, nsp: ast.Span, fields: List[ast.FieldPat], rest: Bool) -> env.Fx {
    let decl = match cx.sfields.get(name) {
        Some(d) => d,
        None => {
            if cx.enums.contains(name) {
                st.report(diag.error("E0102", nsp, "`{name}` is an enum; match it with its variants, for example `{name}.Variant(...)`"))
            } else {
                st.did_you_mean(diag.error("E0102", nsp, "unknown struct `{name}`"), name, env.keys_in_order(cx.sfields))
            }
            return check_pats(mut st, cx, fx, fields.map(|_| TErr), fields.map(|f| f.pat))
        },
    }
    let gen = cx.structs.get(name).map(|s| s.generics) ?? []
    let targs = st.fresh_list(gen.len())
    st.unify_at(p.span, t, TNamed(name, targs))
    let inst = gen.zip(targs)
    let mut fx = fx
    let mut seen: List[Str] = []
    for f in fields {
        if seen.contains(f.name) {
            st.report(diag.error("E0106", f.span, "field `{f.name}` is matched twice"))
        } else {
            seen.push(f.name)
        }
        let ft = match decl.find(|x| x.0 == f.name) {
            Some((_, ft)) => st.subst(inst, ft),
            None => {
                st.did_you_mean(diag.error("E0103", f.span, "struct `{name}` has no field `{f.name}`"), f.name, decl.map(|x| x.0))
                TErr
            },
        }
        fx = check_pat(mut st, cx, fx, ft, f.pat)
    }
    let missing = decl.filter(|f| !seen.contains(f.0))
    if !missing.is_empty() && !rest {
        let listed = missing.map(|f| "`" + f.0 + "`").join(", ")
        st.report(diag.error("E0206", p.span, "missing field{env.plural(missing.len())} {listed} in the pattern for `{name}`").note("name every field, or end the pattern with `..` to match any value of the others"))
    }
    fx
}

fn check_pats(mut st: env.State, cx: env.Cx, fx: env.Fx, ts: List[types.Ty], ps: List[ast.Pat]) -> env.Fx {
    let mut fx = fx
    for (t, p) in ts.zip(ps) {
        fx = check_pat(mut st, cx, fx, t, p)
    }
    fx
}

// Every part of patterns `ps`, against a type already reported.
fn all_err(mut st: env.State, cx: env.Cx, fx: env.Fx, ps: List[ast.Pat]) -> env.Fx {
    check_pats(mut st, cx, fx, ps.map(|_| TErr), ps)
}

// `A | B`: each alternative in a scope of its own, to compare what they
// bind; the names of the first are bound, in order of name.
fn check_or(mut st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, alts: List[ast.Pat]) -> env.Fx {
    let first = binds_of(mut st, cx, fx, t, alts[0])
    let same = "every alternative of `A | B` must bind the same names, with the same types"
    for alt in alts.skip(1) {
        let vs = binds_of(mut st, cx, fx, t, alt)
        let names = |l: List[(Str, env.Var)]| l.map(|x| x.0)
        let only_first = names(first).filter(|n| !names(vs).contains(n))
        let only_this = names(vs).filter(|n| !names(first).contains(n))
        match (only_first, only_this) {
            ([n, ..], _) => {
                st.report(diag.error("E0210", alt.span, "`{n}` is bound in the first alternative but not in this one").note(same))
            },
            ([], [n, ..]) => {
                st.report(diag.error("E0210", alt.span, "`{n}` is bound in this alternative but not in the first one").note(same))
            },
            ([], []) => {
                for (n, v) in vs {
                    let v0 = first.find(|x| x.0 == n).map(|x| x.1) ?? v
                    let ok = st.unify(v0.ty, v.ty)
                    if !ok {
                        st.report(diag.error("E0210", v.span, "`{n}` is `{st.show(v0.ty)}` in the first alternative and `{st.show(v.ty)}` in this one").note(same))
                    }
                }
            },
        }
    }
    let mut fx = fx
    for (n, v) in first {
        fx = fx.bind(n, v)
    }
    fx
}

// What alternative `alt` binds, by name.
fn binds_of(mut st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, alt: ast.Pat) -> List[(Str, env.Var)] {
    let inside = check_pat(mut st, cx, fx.push(), t, alt)
    inside.scopes[0].vars.entries().sort_by(|x| x.0)
}

fn check_variant_pat(mut st: env.State, cx: env.Cx, fx: env.Fx, t: types.Ty, p: ast.Pat, q: Option[Str], v: Str, args: List[ast.Pat]) -> env.Fx {
    let rt = st.repr(t)
    let en = match q {
        Some(e) => {
            if cx.enums.contains(e) {
                e
            } else {
                st.did_you_mean(diag.error("E0102", p.span, "unknown enum `{e}`"), e, env.keys_in_order(cx.enums))
                return all_err(mut st, cx, fx, args)
            }
        },
        None => match rt {
            TNamed(n, _) if (cx.variants.get(n) ?? []).any(|x| x.0 == v) => n,
            _ => {
                let scope = if cx.owners.contains(v) { variant_scope(cx, v, p.span.file) } else { [] }
                match scope {
                    [e] => e,
                    [e, ..] => {
                        st.report(diag.error("E0104", p.span, "`{v}` is a variant of several enums ({scope.join(", ")}); qualify it, for example `{e}.{v}`"))
                        return all_err(mut st, cx, fx, args)
                    },
                    [] => {
                        let cands = match rt {
                            TNamed(n, _) if cx.variants.contains(n) => (cx.variants.get(n) ?? []).map(|x| x.0),
                            _ => env.keys_in_order(cx.owners),
                        }
                        st.did_you_mean(diag.error("E0104", p.span, "unknown variant `{v}`"), v, cands)
                        return all_err(mut st, cx, fx, args)
                    },
                }
            },
        },
    }
    let vs = cx.variants.get(en) ?? []
    let payload = match vs.find(|x| x.0 == v) {
        Some(x) => x.1,
        None => {
            st.did_you_mean(diag.error("E0104", p.span, "enum `{en}` has no variant `{v}`"), v, vs.map(|x| x.0))
            return all_err(mut st, cx, fx, args)
        },
    }
    let gen = cx.enums.get(en).map(|e| e.generics) ?? []
    let targs = st.fresh_list(gen.len())
    st.unify_at(p.span, t, TNamed(en, targs))
    let inst = gen.zip(targs)
    let ptys = payload.map(|x| st.subst(inst, x))
    let rest = args.any(exhaust.is_rest)
    let given = args.len() - (if rest { 1 } else { 0 })
    if (rest && given > ptys.len()) || (!rest && given != ptys.len()) {
        let k = ptys.len()
        st.report(diag.error("E0107", p.span, "variant `{v}` has {k} field{env.plural(k)}, the pattern has {if rest { "at least " } else { "" }}{given}"))
        return all_err(mut st, cx, fx, args)
    }
    check_pats(mut st, cx, fx, ptys, exhaust.fill_rest(args, ptys.len()))
}

// ---------- select, blocks, statements ----------

fn check_select(mut st: env.State, cx: env.Cx, fx: env.Fx, arms: List[ast.SelArm], sp: ast.Span) -> types.Ty {
    let is_default = |a: ast.SelArm| match a.op {
        SelDefault => true,
        _ => false,
    }
    let defaults = arms.filter(is_default)
    if defaults.len() > 1 {
        st.report(diag.error("E0106", sp, "`select` has more than one `_` arm"))
    }
    for a in arms {
        if is_default(a) && a.guard.is_some() {
            st.report(diag.error("E0003", a.span, "the `_` arm of a `select` cannot have a guard"))
        }
    }
    if defaults.len() == arms.len() {
        st.report(diag.error("E0003", sp, "`select` needs at least one channel arm: `v = ch.recv() => ...` or `ch.send(x) => ...`"))
    }
    let afters = arms.filter(|a| match a.op {
        SelAfter(..) => true,
        _ => false,
    })
    if !afters.is_empty() && !defaults.is_empty() {
        st.report(diag.error("E0003", afters[0].span, "a `select` with a `_` arm never waits, so it cannot also have a `clock.after` timeout"))
    }
    let rt = st.fresh()
    for a in arms {
        match a.guard {
            Some(g) => {
                expect(mut st, cx, fx, g, TBool)
            },
            None => {},
        }
        let mut inside = fx.push()
        match a.op {
            SelRecv(b, ch) => {
                let el = chan_el(mut st, cx, fx, ch)
                match b {
                    Some(name) => {
                        inside = inside.bind(name.text, env.Var { ty: types.opt(el), mutable: false, span: name.span, kind: KPat })
                    },
                    None => {},
                }
            },
            SelSend(ch, v) => {
                let el = chan_el(mut st, cx, fx, ch)
                expect(mut st, cx, fx, v, el)
            },
            SelAfter(clock, ms) => {
                let ct = check_expr(mut st, cx, fx, clock)
                match st.repr(ct) {
                    TCap("Clock") | TErr => {},
                    TVar(_) => {
                        st.unify_at(clock.span, TCap("Clock"), ct)
                    },
                    t => {
                        let d = diag.error("E0201", clock.span, "`after` in a `select` needs a `Clock`, found `{st.show(t)}`").note("a timeout arm is `clock.after(ms) => ...`, with the `Clock` from `root.clock`")
                        st.report(d)
                    },
                }
                expect(mut st, cx, fx, ms, TInt)
            },
            SelDefault => {},
        }
        expect(mut st, cx, inside, a.body, rt)
    }
    rt
}

// The element type of channel `ch`.
fn chan_el(mut st: env.State, cx: env.Cx, fx: env.Fx, ch: ast.Expr) -> types.Ty {
    let ct = check_expr(mut st, cx, fx, ch)
    match st.repr(ct) {
        TChan(el) => el,
        TErr => TErr,
        TVar(_) => {
            let el = st.fresh()
            st.unify_at(ch.span, TChan(el), ct)
            el
        },
        t => {
            st.report(diag.error("E0201", ch.span, "`select` works on channels, found `{st.show(t)}`"))
            TErr
        },
    }
}

// The statements of a block, in a scope of its own; whether one of them
// never falls through.
fn check_stmts(mut st: env.State, cx: env.Cx, fx: env.Fx, b: ast.Block) -> (Bool, env.Fx) {
    let mut fx = fx.push()
    let mut diverges = false
    for s in b.stmts {
        let (d, f) = check_stmt(mut st, cx, fx, s)
        diverges = d || diverges
        fx = f
    }
    (diverges, fx)
}

pub fn check_block(mut st: env.State, cx: env.Cx, fx: env.Fx, b: ast.Block) -> types.Ty {
    let (diverges, inside) = check_stmts(mut st, cx, fx, b)
    match b.tail {
        Some(e) => check_expr(mut st, cx, inside, e),
        None => if diverges {
            let t = st.fresh()
            t
        } else {
            TUnit
        },
    }
}

// A block checked against the type its value must have.
pub fn expect_block(mut st: env.State, cx: env.Cx, fx: env.Fx, b: ast.Block, want: types.Ty) {
    let (diverges, inside) = check_stmts(mut st, cx, fx, b)
    match b.tail {
        Some(e) => expect(mut st, cx, inside, e, want),
        None => {
            if !diverges {
                st.unify_at({ b.span with lo: b.span.lo.max(b.span.hi - 1) }, want, TUnit)
            }
        },
    }
}

fn loop_block(mut st: env.State, cx: env.Cx, fx: env.Fx, b: ast.Block) {
    let _ = check_block(mut st, cx, { fx with loops: fx.loops + 1 }, b)
}

// Returns true when the statement never falls through.
fn check_stmt(mut st: env.State, cx: env.Cx, fx: env.Fx, s: ast.Stmt) -> (Bool, env.Fx) {
    match s.desc {
        SLet(_, n, nsp, Some(te), e) if n.starts_with("$assign") && is_tuple_annotation(te) => {
            // the right side of `(a, b) = e`, expanded when modules load;
            // the annotation `#tupleN` says how many parts the left side takes
            let tn = match te.desc {
                TyName(tn, _) => tn,
                _ => "",
            }
            let k = tn.slice(6, tn.len()).parse_int() ?? 0
            let t = check_expr(mut st, cx, fx, e)
            let t = match st.repr(t) {
                TNamed(tn2, ts) if ast.is_tuple_name(tn2) && ts.len() == k => t,
                TErr => TErr,
                TVar(_) => {
                    let parts = st.fresh_list(k)
                    let u = TNamed(tn, parts)
                    st.unify_at(e.span, u, t)
                    u
                },
                other => {
                    let d = diag.error("E0211", e.span, "the left side assigns {k} values, but the right side is `{st.show(other)}`").note("the right side of `({(0..<k).map(|i| (97 + i % 26).to_char()).join(", ")}) = value` must be a tuple of {k} items")
                    st.report(d)
                    TErr
                },
            }
            (false, fx.bind(n, env.Var { ty: t, mutable: false, span: nsp, kind: KLet }))
        },
        SLet(m, n, nsp, ann, e) => {
            let t = match ann {
                Some(te) => {
                    let at = st.resolve(cx, fx.genv, te)
                    expect(mut st, cx, fx, e, at)
                    at
                },
                None => {
                    let t = check_expr(mut st, cx, fx, e)
                    t
                },
            }
            // known before the name is bound: `let c = c.only("z")` narrows the old `c`
            if !m {
                match known_foreign(st, fx, e) {
                    Some(s) => {
                        st.foreign_known = [((n, nsp), s)] + st.foreign_known
                    },
                    None => {},
                }
            }
            (false, fx.bind(n, env.Var { ty: t, mutable: m, span: nsp, kind: KLet }))
        },
        SAssign(lhs, rhs) => {
            check_place(mut st, cx, fx, lhs)
            let is_group = match st.desc(lhs) {
                EVar(n) => match fx.lookup(n) {
                    Some((v, _)) => v.kind == KGroup,
                    None => false,
                },
                _ => false,
            }
            let lt = if is_group {
                TErr
            } else {
                let t = check_expr(mut st, cx, fx, lhs)
                t
            }
            check_target(mut st, lhs)
            expect(mut st, cx, fx, rhs, lt)
            (false, fx)
        },
        SExpr(e) => {
            check_expr(mut st, cx, fx, e)
            (false, fx)
        },
        SReturn(value) => {
            if fx.in_defer > 0 {
                st.report(diag.error("E0115", s.span, "`return` cannot leave a `defer` body"))
            } else if fx.in_group > 0 {
                st.report(diag.error("E0311", s.span, "`return` cannot leave a `group` block early; every task must finish first"))
            }
            match value {
                Some(e) => {
                    expect(mut st, cx, fx, e, fx.ret)
                },
                None => {
                    st.unify_at(s.span, fx.ret, TUnit)
                },
            }
            (true, fx)
        },
        SWhile(c, b) => {
            expect(mut st, cx, fx, c, TBool)
            loop_block(mut st, cx, fx, b)
            (false, fx)
        },
        SLetPat(..) | SForPat(..) => panic("destructuring is expanded when modules load"),
        SFor(n, nsp, e, b) => {
            let t = check_expr(mut st, cx, fx, e)
            let el = match st.repr(t) {
                TList(a) | TArray(a, _) => a,
                TErr => TErr,
                TVar(_) => {
                    let a = st.fresh()
                    st.unify_at(e.span, TList(a), t)
                    a
                },
                other => {
                    let mut d = diag.error("E0201", e.span, "`for` can only iterate over a `List`, found `{st.show(other)}`")
                    if other == TStr {
                        d = d.note("use `.lines()` or `.split(...)` to get a `List[Str]`")
                    }
                    st.report(d)
                    TErr
                },
            }
            let inside = fx.push().bind(n, env.Var { ty: el, mutable: false, span: nsp, kind: KPat })
            loop_block(mut st, cx, inside, b)
            (false, fx)
        },
        SBreak | SContinue => {
            if fx.loops == 0 {
                if fx.in_defer > 0 {
                    st.report(diag.error("E0115", s.span, "`break` and `continue` cannot leave a `defer` body"))
                } else {
                    st.report(diag.error("E0208", s.span, "`break` and `continue` can only be used inside a loop"))
                }
            }
            (true, fx)
        },
        SDefer(b) => {
            // the body runs when the block is left: it sees the names in
            // scope here, and nothing in it may leave it; its value is dropped
            let inside = { fx with loops: 0, in_defer: fx.in_defer + 1 }
            check_block(mut st, cx, inside, b)
            (false, fx)
        },
    }
}

fn is_tuple_annotation(te: ast.TyExpr) -> Bool {
    match te.desc {
        TyName(tn, []) => ast.is_tuple_name(tn),
        _ => false,
    }
}
