// The IR as C, as src/cgen.ml writes it: `limen build --emit-c` gives
// the same text byte for byte. Value types (Int, Float, Bool, (), structs,
// enums that do not contain themselves, arrays) are C values; Str, List,
// Map, closures, capabilities and enums that contain themselves are
// reference-counted pointers. Every composite type gets generated
// dup/drop/eq/show functions named <CName>_dup and so on.
//
// The OCaml generator keeps a mutable context: naming a type for the first
// time gives it the next number (T0, T1, ...) and queues its definition, a
// string literal gets the next `litN`, and so on. Here the context is one
// value, `Cg`, and every function that can name something takes it as
// `mut self` and adds what it named. The numbers
// depend on the order things are first named in, so this follows OCaml's
// order of evaluation where it matters: OCaml evaluates the arguments of
// a call, and so of a `sprintf`, from right to left.
use ast
use diag
use exhaust
use ffi
use floats
use hoist
use intset
use ir
use lower
use pure
use types

// The first line of the C of a program that may use TLS (Net.get,
// Net.connect_tls, Listen.on_tls): the build then links OpenSSL and pastes
// the TLS core in ahead of the runtime.
pub fn tls_marker() -> Str {
    "/* limen: uses tls */\n"
}

// Follows the runtime in a program where no task can be cancelled.
pub fn no_checkpoints() -> Str {
    "/* no group here has a deadline, so no task is ever cancelled */\n#undef W_CHECK\n#define W_CHECK() do \{ } while (0)"
}

// A `dyn` vtable to define: its key, the boxed type, its methods.
struct DynBox {
    key: Str,
    ty: types.Ty,
    methods: List[ir.DynEntry],
}

// A C struct passed by value to a foreign function: its Limen name, its
// C typedef name (VFS<n>) and its fields.
struct CStruct {
    name: Str,
    cname: Str,
    fields: List[(Str, ffi.CTy)],
}

// A callback wrapper C calls: the Limen function's C name, whether it
// takes a Foreign first, its parameters and result at the boundary, the
// wrapper's name, the Limen name and where it is declared.
struct Wrapper {
    fname: Str,
    takes_foreign: Bool,
    params: List[ffi.CTy],
    ret: ffi.CTy,
    name: Str,
    vname: Str,
    span: ast.Span,
}

struct Cg {
    ro: lower.Ro,
    // `--profile`: each function's number, from 1 in the order the
    // functions are written; 0 is time outside them
    prof_ids: Map[Str, Int],
    files: List[diag.Source],
    // where each line of each file starts, for `file:line:col`
    starts: List[List[Int]],
    // show(t) -> C name
    names: Map[Str, Str],
    // composite types, in the order their names were finished
    types: List[types.Ty],
    lits: Map[Str, Str],
    lit_order: List[(Str, Str)],
    // C names of enums that contain themselves, boxed behind a pointer
    boxed: List[Str],
    // lists known unique inside the current loop
    uniq: List[Int],
    // result types of spawned tasks
    task_tys: List[types.Ty],
    // (list var, index var): the index is proven in range
    inrange: List[(Int, Int)],
    // element types of channels
    chan_tys: List[types.Ty],
    dyns: List[DynBox],
    // types of owned locals, which need a drop-through-pointer function
    cell_tys: List[types.Ty],
    // composite types that need a <CName>_cmp order function
    cmp_tys: List[types.Ty],
    // list types that need <CName>_sort
    sort_tys: List[types.Ty],
    // composite map key types that need <CName>_hash
    hash_tys: List[types.Ty],
    // `flat`'s answers, worked out once per type when cmp_defs starts
    flats: Map[Str, Bool],
    // C functions that foreign calls name
    csyms: List[Str],
    // limen_sql_run or limen_sql_open is called: emit the table of SQLite functions they use
    sql_api: Bool,
    cstructs: List[CStruct],
    wrappers: List[Wrapper],
    // the C signatures of kept callbacks, each with its trampolines
    kepts: List[List[ffi.CTy]],
    // blocking calls' jobs, vbj<n>_: each one's struct and the function
    // that makes the call
    bjobs: List[Str],
    // variables of the current function a `defer` needs volatile: a panic
    // longjmps back into the function, and the deferred body (and the
    // cleanups after it) must see their latest values and owned flags
    vols: List[Int],
    pure: Map[Str, pure.Info],
    // pure calls the current function keeps across a loop
    plan: pure.Plan,
    // the last slot number given, in the whole program
    slot: Int,
    // the loops of the current function met so far, in the order the
    // planner numbers them, and those whose slots are being written
    loops: Int,
    slotted: List[Int],
    // the deadline scopes written so far, in the whole program
    scopes: Int,
    tls: Bool,
    // the C of the function bodies, in pieces
    out: List[Str],
}

fn show(t: types.Ty) -> Str {
    lower.show(t)
}

fn is_scalar(t: types.Ty) -> Bool {
    match t {
        TInt | TFloat | TBool | TUnit | TUInt(_) => true,
        _ => false,
    }
}

fn is_enum(self: Cg, t: types.Ty) -> Bool {
    match t {
        TNamed(n, _) => self.ro.enums.contains(n),
        _ => false,
    }
}

fn fields_of(self: Cg, t: types.Ty) -> List[(Str, types.Ty)] {
    lower.field_types(self.ro, t)
}

fn variants_of(self: Cg, t: types.Ty) -> List[(Str, List[types.Ty])] {
    lower.variants(self.ro, t)
}

// The types a struct's fields or an enum's payloads hold.
fn parts(self: Cg, t: types.Ty) -> List[types.Ty] {
    if self.is_enum(t) {
        self.variants_of(t).flat_map(|v| v.1)
    } else {
        self.fields_of(t).map(|f| f.1)
    }
}

// The C name of a type. A composite type is numbered the first time it is
// named, and the types inside it are named next, so they get definitions
// too; it joins `types` after them.
fn cname(mut self: Cg, t: types.Ty) -> Str {
    match t {
        TInt => "Int",
        TFloat => "Float",
        TBool => "Bool",
        TUnit => "Unit",
        TStr => "Str",
        TBytes => "Bytes",
        TUInt(n) => "UInt{n}",
        TFn(ps, r) => {
            for p in ps {
                let _ = self.cname(p)
            }
            let _ = self.cname(r)
            "Clo"
        },
        TCap(_) => "Cap",
        TDyn(..) => "Dyn",
        TGroup(a) => {
            let _ = self.cname(a)
            "Group"
        },
        TChan(a) => {
            let _ = self.cname(a)
            if !self.chan_tys.contains(a) {
                self.chan_tys.push(a)
            }
            "Chan"
        },
        TAtomic => "Atomic",
        // its value's drop and share functions are a channel element's
        TShared(a) => {
            let _ = self.cname(a)
            if !self.chan_tys.contains(a) {
                self.chan_tys.push(a)
            }
            "Shared"
        },
        TList(TInt) => "L_Int",
        TList(TStr) => "L_Str",
        TList(_) | TNamed(..) | TArray(..) | TMap(..) => {
            let k = show(t)
            match self.names.get(k) {
                Some(n) => {
                    return n
                },
                None => {},
            }
            let n = "T{self.names.len()}"
            self.names[k] = n
            let inside = match t {
                TList(e) | TArray(e, _) => [e],
                TMap(kt, vt) => [kt, vt],
                _ => self.parts(t),
            }
            for e in inside {
                let _ = self.cname(e)
            }
            self.types.push(t)
            n
        },
        _ => panic("cgen: non-concrete type " + show(t)),
    }
}

// The C type of a value of type `t`.
fn ctype(mut self: Cg, t: types.Ty) -> Str {
    match t {
        TInt => "int64_t",
        TFloat => "double",
        TBool => "bool",
        TUnit => "W_Unit",
        TStr | TBytes => "WStr*",
        TUInt(n) => "uint{n}_t",
        TFn(..) => "WClo*",
        TDyn(..) => "WDyn*",
        TCap(_) => "WCap*",
        TGroup(_) => "WGroup*",
        TChan(_) => "WChan*",
        TAtomic => "WAtomic*",
        TShared(_) => "WShared*",
        TList(_) | TMap(..) => {
            let n = self.cname(t)
            n + "*"
        },
        // structs, enums and arrays are C values
        _ => self.cname(t),
    }
}

// Whether `t` has the C name of one of `ts`: types with the same C name
// share their generated functions (every closure type is `Clo`).
fn named_in(mut self: Cg, ts: List[types.Ty], t: types.Ty) -> Bool {
    for u in ts {
        let b = self.cname(t)
        let a = self.cname(u)
        if a == b {
            return true
        }
    }
    false
}

// ---------- literals ----------

// `s` as a C string literal: printable ASCII as itself, every other byte
// (and `"`, `\`, `?`, which would start a trigraph) in octal.
pub fn c_string(s: Str) -> Str {
    let bs = s.bytes()
    let mut parts: List[Str] = ["\""]
    let mut start = 0
    let mut i = 0
    let n = bs.len()
    while i < n {
        let b = bs[i]
        if b < 32 || b >= 127 || b == 34 || b == 92 || b == 63 {
            if start < i {
                parts.push(s.slice(start, i))
            }
            parts.push("\\{b / 64}{b / 8 % 8}{b % 8}")
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        parts.push(s.slice(start, n))
    }
    parts.push("\"")
    parts.join("")
}

fn lit(mut self: Cg, s: Str) -> Str {
    match self.lits.get(s) {
        Some(n) => n,
        None => {
            let n = "lit{self.lits.len()}"
            self.lits[s] = n
            self.lit_order.push((n, s))
            n
        },
    }
}

// Where each line of `text` starts.
fn line_starts(text: Str) -> List[Int] {
    let mut starts = [0]
    for (i, b) in text.bytes().with_index() {
        if b == 10 {
            starts.push(i + 1)
        }
    }
    starts
}

// The line and column of offset `off` in file `file`, as Source.line_col
// counts them; a file with no text is all one line.
fn line_col(self: Cg, file: Int, off: Int) -> (Int, Int) {
    let st = match self.starts.get(file) {
        Some(st) => st,
        None => {
            return (1, off + 1)
        },
    }
    let o = off.min(self.files[file].text.len())
    // the last line starting at or before o
    let mut lo = 0
    let mut hi = st.len() - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if st[mid] <= o {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    (lo + 1, o - st[lo] + 1)
}

// `"file:line:col"`, the place a panic reports.
fn where(self: Cg, sp: ast.Span) -> Str {
    let (l, col) = self.line_col(sp.file, sp.lo)
    c_string("{diag.path_of(self.files, sp.file)}:{l}:{col}")
}

// A variable's C name: its Limen name and its number (`total_15`), so a
// debugger and the C itself show which variable is which. Characters C
// does not allow in a name (the `$` of the compiler's own variables)
// become `_`; a variable with no name is `v15`. The number keeps every
// name apart from the others and from C's own.
fn var_name(v: ir.Var) -> Str {
    let n = bytes(v.name.bytes().map(|b| if (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 { b } else { 95 })).to_str()
    let first = if n.is_empty() { 0 } else { n.bytes()[0] }
    if n.is_empty() || (first >= 48 && first <= 57) { "v{v.id}" } else { "{n}_{v.id}" }
}

// A `mut` parameter is a pointer to the caller's place: every use goes
// through it.
fn var(v: ir.Var) -> Str {
    if v.by_ref { "(*{var_name(v)})" } else { var_name(v) }
}

fn float_lit(x: Float) -> Str {
    // NaN is the one value unequal to itself, and an infinity minus itself
    // is NaN
    if x != x {
        "NAN"
    } else if x - x != 0.0 {
        if x > 0.0 { "INFINITY" } else { "(-INFINITY)" }
    } else {
        floats.hex(x)
    }
}

fn int_lit(n: Int) -> Str {
    if n == -9223372036854775807 - 1 { "INT64_MIN" } else { "INT64_C({n})" }
}

fn atom(mut self: Cg, a: ir.Atom) -> Str {
    match a {
        V(v) => var(v),
        VDup(v) => self.dup_of(v.ty, var(v)),
        AInt(n) => int_lit(n),
        AFloat(x) => float_lit(x),
        ABool(b) => if b { "true" } else { "false" },
        AUnit => "0",
        AStr(s) => {
            let n = self.lit(s)
            "(&{n})"
        },
    }
}

// The atoms, left to right, as List.map takes them.
fn atoms(mut self: Cg, xs: List[ir.Atom]) -> List[Str] {
    let mut out: List[Str] = []
    for x in xs {
        let s = self.atom(x)
        out.push(s)
    }
    out
}

// ---------- enum helpers ----------

fn tag_expr(mut self: Cg, t: types.Ty, e: Str) -> Str {
    let n = self.cname(t)
    "{n}_tag({e})"
}

fn payload_expr(mut self: Cg, t: types.Ty, e: Str, k: Int, i: Int) -> Str {
    let n = self.cname(t)
    "{n}_p_{k}_{i}({e})"
}

fn mk_enum(mut self: Cg, t: types.Ty, k: Int, args: List[Str]) -> Str {
    let n = self.cname(t)
    "{n}_mk_{k}({args.join(", ")})"
}

// A new reference to `e`, of type `t`.
fn dup_of(mut self: Cg, t: types.Ty, e: Str) -> Str {
    if is_scalar(t) {
        return e
    }
    let n = self.cname(t)
    "{n}_dup({e})"
}

// Follow a chain of steps from `root`: the lvalue and its type.
fn walk(mut self: Cg, root: Str, rty: types.Ty, steps: List[ir.Step]) -> (Str, types.Ty) {
    let mut e = root
    let mut t = rty
    for step in steps {
        match step {
            PField(k) => {
                let ft = self.fields_of(t)[k].1
                e = "({e}).f{k}"
                t = ft
            },
            PIndex(i, sp) => {
                let wh = self.where(sp)
                let ia = self.atom(i)
                match t {
                    TList(el) => {
                        let n = self.cname(t)
                        e = "(*{n}_at({e}, {ia}, {wh}))"
                        t = el
                    },
                    TArray(el, TLen(len)) => {
                        e = "({e}).a[w_idx({ia}, {len}, {wh})]"
                        t = el
                    },
                    _ => panic("walk index"),
                }
            },
            PIndexU(i) => {
                let ia = self.atom(i)
                match t {
                    TList(el) => {
                        e = "({e})->data[{ia}]"
                        t = el
                    },
                    TArray(el, _) => {
                        e = "({e}).a[{ia}]"
                        t = el
                    },
                    _ => panic("walk index"),
                }
            },
            PKey(k, sp) => match t {
                TMap(_, vt) => {
                    let wh = self.where(sp)
                    let ka = self.atom(k)
                    let n = self.cname(t)
                    e = "(*{n}_slot({e}, {ka}, {wh}))"
                    t = vt
                },
                _ => panic("walk key"),
            },
        }
    }
    (e, t)
}

// The C condition for value `e` of type `t` matching pattern `p`.
fn pat_cond(mut self: Cg, e: Str, t: types.Ty, p: ast.Pat) -> Str {
    match p.desc {
        PWild | PBind(_) | PRest(_) => "true",
        PInt(n) => if n == -9223372036854775807 - 1 { "({e} == INT64_MIN)" } else { "({e} == INT64_C({n}))" },
        PBool(b) => "({e} == {if b { "true" } else { "false" }})",
        PStr(s) => {
            let n = self.lit(s)
            "Str_eq({e}, &{n})"
        },
        PVariant(_, vn, args) => {
            let k = lower.tag_of(self.ro, t, vn)
            let ptys = self.variants_of(t).find(|v| v.0 == vn).map(|v| v.1) ?? []
            let mut subs: List[Str] = []
            for (i, pair) in exhaust.fill_rest(args, ptys.len()).zip(ptys).with_index() {
                let pe = self.payload_expr(t, e, k, i)
                let s = self.pat_cond(pe, pair.1, pair.0)
                subs.push(s)
            }
            let te = self.tag_expr(t, e)
            (["({te} == {k})"] + subs.filter(|s| s != "true")).join(" && ")
        },
        PTuple(ps) => {
            let fts = self.fields_of(t)
            let mut subs: List[Str] = []
            for (i, pair) in exhaust.fill_rest(ps, fts.len()).zip(fts.map(|f| f.1)).with_index() {
                let s = self.pat_cond("({e}).f{i}", pair.1, pair.0)
                subs.push(s)
            }
            let real = subs.filter(|s| s != "true")
            if real.is_empty() { "true" } else { real.join(" && ") }
        },
        PList(ps) => {
            let el = match t {
                TList(el) => el,
                _ => panic("pat_cond: list"),
            }
            let (before, rest, after) = exhaust.list_parts(ps)
            let k = before.len()
            let j = after.len()
            let len = "({e})->len"
            let size = if rest.is_none() { "({len} == {k})" } else { "({len} >= {k + j})" }
            // `before @ after`: OCaml makes the right operand first
            let mut tail: List[Str] = []
            for (i, q) in after.with_index() {
                let s = self.pat_cond("({e})->data[{len} - {j - i}]", el, q)
                tail.push(s)
            }
            let mut head: List[Str] = []
            for (i, q) in before.with_index() {
                let s = self.pat_cond("({e})->data[{i}]", el, q)
                head.push(s)
            }
            ([size] + (head + tail).filter(|s| s != "true")).join(" && ")
        },
        PStruct(_, _, fields, _) => {
            let fts = self.fields_of(t)
            let mut subs: List[Str] = []
            for (i, pair) in exhaust.struct_items(fields, fts.map(|f| f.0), p.span).zip(fts.map(|f| f.1)).with_index() {
                let s = self.pat_cond("({e}).f{i}", pair.1, pair.0)
                subs.push(s)
            }
            let real = subs.filter(|s| s != "true")
            if real.is_empty() { "true" } else { real.join(" && ") }
        },
        PAs(q, _, _) => self.pat_cond(e, t, q),
        POr(alts) => {
            let mut conds: List[Str] = []
            for q in alts {
                let s = self.pat_cond(e, t, q)
                conds.push(s)
            }
            if conds.contains("true") { "true" } else { "(" + conds.join(" || ") + ")" }
        },
    }
}

// The prefix of the order function for `t` (used as <prefix>_cmp);
// composite types get one generated, and so do the types inside them.
fn cmp_prefix(mut self: Cg, t: types.Ty) -> Str {
    match t {
        TInt => "Int",
        TFloat => "Float",
        TStr => "Str",
        TBytes => "Bytes",
        TUInt(n) => "UInt{n}",
        TBool => "Bool",
        TUnit => "Unit",
        _ => {
            let n = self.cname(t)
            let mut known = false
            for u in self.cmp_tys {
                let un = self.cname(u)
                if un == n {
                    known = true
                    break
                }
            }
            if !known {
                self.cmp_tys.push(t)
                let inside = match t {
                    TList(e) | TArray(e, _) => [e],
                    TNamed(..) => self.parts(t),
                    _ => panic("cgen: no order on " + show(t)),
                }
                for e in inside {
                    let _ = self.cmp_prefix(e)
                }
            }
            n
        },
    }
}

// The prefix of the hash function for map key type `t`; tuple, struct and
// enum keys get one generated, and so do the types inside them.
fn hash_prefix(mut self: Cg, t: types.Ty) -> Str {
    match t {
        TInt => "Int",
        TStr => "Str",
        TBytes => "Bytes",
        TUInt(n) => "UInt{n}",
        TBool => "Bool",
        TUnit => "Unit",
        _ => {
            let n = self.cname(t)
            let mut known = false
            for u in self.hash_tys {
                let un = self.cname(u)
                if un == n {
                    known = true
                    break
                }
            }
            if !known {
                self.hash_tys.push(t)
                let inside = match t {
                    TNamed(..) => self.parts(t),
                    _ => panic("cgen: no hash for " + show(t)),
                }
                for e in inside {
                    let _ = self.hash_prefix(e)
                }
            }
            n
        },
    }
}

fn cmp_op(op: ast.BinOp) -> Str {
    match op {
        Lt => "<",
        Le => "<=",
        Gt => ">",
        Eq => "==",
        Ne => "!=",
        _ => ">=",
    }
}

fn arith_op(op: ast.BinOp) -> Str {
    match op {
        Add => "+",
        Sub => "-",
        Mul => "*",
        BitAnd => "&",
        BitOr => "|",
        _ => "^",
    }
}

fn binop(mut self: Cg, op: ast.BinOp, t: types.Ty, a: Str, b: Str, sp: ast.Span) -> Str {
    match (t, op) {
        (TInt, Add) | (TFloat, Add) => "({a} + {b})",
        (TInt, Sub) | (TFloat, Sub) => "({a} - {b})",
        (TInt, Mul) | (TFloat, Mul) => "({a} * {b})",
        (TInt, Div) => "w_div({a}, {b}, {self.where(sp)})",
        (TInt, Mod) => "w_mod({a}, {b}, {self.where(sp)})",
        (TInt, BitAnd) => "({a} & {b})",
        (TInt, BitOr) => "({a} | {b})",
        (TInt, BitXor) => "({a} ^ {b})",
        (TInt, Shl) => "w_shl({a}, {b}, {self.where(sp)})",
        (TInt, Shr) => "w_shr({a}, {b}, {self.where(sp)})",
        (TUInt(n), Add | Sub | Mul | BitAnd | BitOr | BitXor) => "((uint{n}_t)({a} {arith_op(op)} {b}))",
        (TUInt(n), Div) => "((uint{n}_t)w_udiv({a}, {b}, {self.where(sp)}))",
        (TUInt(n), Mod) => "((uint{n}_t)w_umod({a}, {b}, {self.where(sp)}))",
        (TUInt(n), Shl) => "((uint{n}_t)w_ushl_n({a}, {b}, {n}))",
        (TUInt(n), Shr) => "((uint{n}_t)w_ushr_n({a}, {b}, {n}))",
        (TFloat, Div) => "({a} / {b})",
        (TStr, Add) | (TBytes, Add) => "Str_concat({a}, {b})",
        (TList(_), Add) => {
            let n = self.cname(t)
            "{n}_concat({a}, {b})"
        },
        (TInt, Lt | Le | Gt | Ge | Eq | Ne) | (TFloat, Lt | Le | Gt | Ge | Eq | Ne) | (TBool, Lt | Le | Gt | Ge | Eq | Ne) | (TUInt(_), Lt | Le | Gt | Ge | Eq | Ne) => "({a} {cmp_op(op)} {b})",
        (TStr, Lt | Le | Gt | Ge) => "(Str_cmp({a}, {b}) {cmp_op(op)} 0)",
        (_, Eq) => {
            let n = self.cname(t)
            "{n}_eq({a}, {b})"
        },
        (_, Ne) => {
            let n = self.cname(t)
            "(!{n}_eq({a}, {b}))"
        },
        (_, Lt | Le | Gt | Ge) => {
            let n = self.cmp_prefix(t)
            "({n}_cmp({a}, {b}) {cmp_op(op)} 0)"
        },
        _ => panic("cgen binop on " + show(t)),
    }
}

// ---------- writing ----------

fn put(mut self: Cg, s: Str) {
    self.out.push(s)
}

fn line(mut self: Cg, ind: Str, s: Str) {
    self.put(ind + s + "\n")
}

// ---------- foreign calls ----------

fn handle_ty() -> types.Ty {
    TNamed("Handle", [])
}

// The C type of a boundary type: a C struct gets a typedef of its own
// (VFS<n>, fields c0, c1, ... at C's layout), a callback is a pointer to a
// function.
fn ffi_ctype(mut self: Cg, t: ffi.CTy) -> Str {
    match t {
        Struct(n, fs) => match self.cstructs.find(|s| s.name == n) {
            Some(s) => s.cname,
            None => {
                let cn = "VFS{self.cstructs.len()}"
                self.cstructs.push(CStruct { name: n, cname: cn, fields: fs })
                cn
            },
        },
        Fn(ps, r) => {
            let mut cps: List[Str] = []
            for p in ps {
                let s = self.ffi_ctype(p)
                cps.push(s)
            }
            let cr = self.ffi_ctype(r)
            "{cr} (*)({if ps.is_empty() { "void" } else { cps.join(", ") }})"
        },
        Kept(ps) => self.ffi_ctype(Fn(ps, Unit)),
        _ => ffi.c_name(t),
    }
}

// The number of a kept callback's C signature, its trampolines named
// vkt<n>_ (an array of W_KEPT), registered on first use.
fn kept_sig(mut self: Cg, ps: List[ffi.CTy]) -> Int {
    for (i, q) in self.kepts.with_index() {
        if q == ps {
            return i
        }
    }
    self.kepts.push(ps)
    self.kepts.len() - 1
}

fn i32_arg(v: Str, what: Str, wh: Str) -> Str {
    "w_ffi_i32({v}, {c_string(what)}, {wh})"
}

// A Limen value `v` as the C value of boundary type `t`. `what` names it
// in an Int32 range panic. In the variadic part of a call, Int32 and Bool
// go as int and Int as int64_t, written out so C's promotions see the
// right type.
fn ffi_arg(mut self: Cg, variadic: Bool, t: ffi.CTy, v: Str, what: Str, wh: Str) -> Str {
    match t {
        Int => if variadic { "(int64_t){v}" } else { v },
        Float => if variadic { "(double){v}" } else { v },
        Int32 => if variadic { "(int){i32_arg(v, what, wh)}" } else { i32_arg(v, what, wh) },
        Bool => "({if variadic { "(int)" } else { "" }}({v} ? 1 : 0))",
        Str => "(const char *)({v})->data",
        Bytes => "(const void *)({v})->data",
        Handle => "(void *)(intptr_t)({v}).f0",
        Struct(n, fs) => {
            let mut items: List[Str] = []
            for (i, f) in fs.with_index() {
                let x = "({v}).f{i}"
                items.push(match f.1 {
                    Int32 => i32_arg(x, "field `{f.0}` of `{n}`", wh),
                    Bool => "({x} ? 1 : 0)",
                    Handle => "(void *)(intptr_t)({x}).f0",
                    _ => x,
                })
            }
            let cn = self.ffi_ctype(t)
            "({cn})\{ {items.join(", ")} }"
        },
        Kept(ps) => {
            let i = self.kept_sig(ps)
            "vkt{i}_[w_kept_slot({v}, {wh})]"
        },
        Unit | Fn(..) => "0",
    }
}

// A C value `e` of boundary type `t` as a Limen value.
fn ffi_result(mut self: Cg, t: ffi.CTy, e: Str) -> Str {
    let hd = self.cname(handle_ty())
    let one = |t: ffi.CTy, e: Str| match t {
        Int | Float => e,
        Int32 => "(int64_t){e}",
        Bool => "({e} != 0)",
        Str => "w_ffi_str({e})",
        Handle => "({hd})\{ (int64_t)(intptr_t){e} }",
        _ => "0",
    }
    match t {
        Struct(n, fs) => {
            let items = fs.with_index().map(|p| {
                let (i, f) = p
                one(f.1, "{e}.c{i}")
            })
            let sn = self.cname(TNamed(n, []))
            "({sn})\{ {items.join(", ")} }"
        },
        _ => one(t, e),
    }
}

// The wrapper C calls for callback `cb` (a top-level function), made on
// first use.
fn ffi_callback(mut self: Cg, cb: ir.Callback, ps: List[ffi.CTy], r: ffi.CTy) -> Str {
    match self.wrappers.find(|w| w.fname == cb.cname && w.takes_foreign == cb.takes_foreign && w.params == ps && w.ret == r) {
        Some(w) => w.name,
        None => {
            let w = "vcb{self.wrappers.len()}_"
            self.wrappers.push(Wrapper { fname: cb.cname, takes_foreign: cb.takes_foreign, params: ps, ret: r, name: w, vname: cb.name, span: cb.span })
            w
        },
    }
}

// A callback wrapper's definition: it converts C's arguments, calls the
// compiled Limen function under a panic boundary of its own, and
// converts its result. Nothing may unwind through C's frames, so a panic
// there ends the program (w_cb_fatal), and so does waiting (see w_park).
fn ffi_callback_def(mut self: Cg, w: Wrapper) -> Str {
    let mut b: List[Str] = []
    let wh = self.where(w.span)
    let mut params: List[Str] = []
    for (i, t) in w.params.with_index() {
        let ct = self.ffi_ctype(t)
        params.push("{ct} a{i}")
    }
    let rt = self.ffi_ctype(w.ret)
    b.push("static {rt} {w.name}({if params.is_empty() { "void" } else { params.join(", ") }}) \{")
    b.push("  WFiber *f_ = w_cb_fiber({wh});")
    b.push("  const char *prev_ = f_->in_cb;")
    b.push("  f_->in_cb = {wh};")
    if w.ret != Unit {
        let rt2 = self.ffi_ctype(w.ret)
        b.push("  {rt2} volatile r_ = 0;")
    }
    b.push("  WCatch c_;")
    b.push("  w_catch_init(&c_);")
    b.push("  WCatch **slot_ = &f_->catch_top;")
    b.push("  if (_setjmp(c_.jb) == 0) \{")
    b.push("    WCatch *guard_ __attribute__((cleanup(w_catch_land))) = &c_;")
    b.push("    *slot_ = &c_;")
    let hd = self.cname(handle_ty())
    let args = w.params.with_index().map(|p| match p.1 {
        Int32 => "(int64_t)a{p.0}",
        Bool => "(a{p.0} != 0)",
        Handle => "({hd})\{ (int64_t)(intptr_t)a{p.0} }",
        Str => "w_ffi_str(a{p.0})",
        _ => "a{p.0}",
    })
    // a callback that takes a Foreign gets the one its foreign call was given
    let fa = if w.takes_foreign { ["Cap_dup(f_->cb_foreign)"] } else { [] }
    let call = "{w.fname}({(fa + args).join(", ")})"
    b.push(match w.ret {
        Unit => "    {call};",
        Int32 => "    r_ = w_ffi_i32({call}, {c_string("the result of callback `{w.vname}`")}, {wh});",
        Bool => "    r_ = {call} ? 1 : 0;",
        Handle => "    r_ = (void *)(intptr_t)({call}).f0;",
        _ => "    r_ = {call};",
    })
    b.push("    *slot_ = c_.prev;")
    b.push("    w_catch_end(&c_);")
    b.push("  } else w_cb_fatal(&c_, {wh});")
    b.push("  f_->in_cb = prev_;")
    if w.ret != Unit {
        b.push("  return r_;")
    }
    b.push("}")
    b.map(|l| l + "\n").join("")
}

// A kept callback signature's trampolines: W_KEPT functions with C's
// parameters, each building the channel's value from them and sending it
// on its slot's channel (w_kept_send), and the array C's pointers come
// from.
fn kept_def(mut self: Cg, i: Int, ps: List[ffi.CTy]) -> Str {
    let mut b: List[Str] = []
    let hd = self.cname(handle_ty())
    let elem = ffi.kept_elem(ps)
    let mut cps: List[Str] = []
    for (k, t) in ps.with_index() {
        let ct = self.ffi_ctype(t)
        cps.push("{ct} a{k}")
    }
    let params = if ps.is_empty() { "void" } else { cps.join(", ") }
    let conv = |k: Int, t: ffi.CTy| match t {
        Int32 => "(int64_t)a{k}",
        Bool => "(a{k} != 0)",
        Handle => "({hd})\{ (int64_t)(intptr_t)a{k} }",
        Str => "w_ffi_str(a{k})",
        _ => "a{k}",
    }
    let value = match ps.len() {
        0 => "0",
        1 => conv(0, ps[0]),
        _ => {
            let en = self.cname(elem)
            "({en})\{ {ps.with_index().map(|p| conv(p.0, p.1)).join(", ")} }"
        },
    }
    let et = self.ctype(elem)
    b.push("static void vkt{i}_fire(int64_t i_{cps.map(|x| ", " + x).join("")}) \{")
    b.push("  {et} v_ = {value};")
    b.push("  w_kept_send(i_, &v_);")
    b.push("}")
    let names = (0..<32).map(|k| "vkt{i}_{k}")
    let fwd = ps.with_index().map(|p| ", a{p.0}").join("")
    for (k, n) in names.with_index() {
        b.push("static void {n}({params}) \{ vkt{i}_fire({k}{fwd}); }")
    }
    b.push("static void (*const vkt{i}_[W_KEPT])({params}) = \{ {names.join(", ")} };")
    b.map(|l| l + "\n").join("")
}

// ---------- right-hand sides ----------

// A piece of a value being shown into a buffer: text, or a value of a
// type, at the top (a string as itself) or inside a container (quoted).
enum Shown {
    Text(Str),
    Value(Str, types.Ty, Bool),
}

fn set(mut self: Cg, ind: Str, dst: Str, e: Str) {
    self.line(ind, "{dst} = {e};")
}

// limen_sql_run or limen_sql_open is called: the SQLite functions they use
// are linked and their table emitted
fn use_sql_api(mut self: Cg) {
    for sym in ffi.sql_syms() {
        if !self.csyms.contains(sym) {
            self.csyms.push(sym)
        }
    }
    self.sql_api = true
}

fn show_into(mut self: Cg, ind: Str, dst: Str, parts: List[Shown]) {
    self.line(ind, "\{")
    self.line(ind, "  WBuf b_; buf_init(&b_);")
    for part in parts {
        match part {
            Text(s) => {
                self.line(ind, "  buf_putn(&b_, {c_string(s)}, {s.len()});")
            },
            Value(e, ty, top) => {
                let n = self.cname(ty)
                self.line(ind, "  {n}_show(&b_, {e}, {top});")
            },
        }
    }
    self.line(ind, "  {dst} = buf_take(&b_);")
    self.line(ind, "}")
}

// An I/O operation's WIo result as a Result[_, IoError]: `ok` is the Ok
// value, read from `r_`.
fn io_result(mut self: Cg, ind: Str, dst: Str, t: types.Ty, call: Str, ok: Str) {
    let ioe = types.io_err()
    self.line(ind, "\{")
    self.line(ind, "  WIo r_ = {call};")
    let failed = self.mk_enum(ioe, 1, ["r_.msg"])
    let denied = self.mk_enum(ioe, 0, ["r_.msg"])
    let err = self.mk_enum(t, 1, ["(r_.kind == 1 ? {denied} : {failed})"])
    let good = self.mk_enum(t, 0, [ok])
    self.line(ind, "  if (r_.kind == 0) {dst} = {good}; else {dst} = {err};")
    self.line(ind, "}")
}

// `cond ? Some(value) : None`, into `dst` of Option type `t`.
fn opt_from(mut self: Cg, ind: Str, dst: Str, t: types.Ty, cond: Str, value: Str) {
    let none = self.mk_enum(t, 1, [])
    let some = self.mk_enum(t, 0, [value])
    self.set(ind, dst, "({cond}) ? {some} : {none}")
}

fn is_array(t: types.Ty) -> Bool {
    match t {
        TArray(..) => true,
        _ => false,
    }
}

fn atom_var(a: ir.Atom) -> ir.Var {
    match ir.atom_var(a) {
        Some(v) => v,
        None => panic("cgen: a variable was expected"),
    }
}

fn vtable_key(i: Str) -> Str {
    i.chars().map(|ch| if ch == "." || ch == "[" || ch == "]" || ch == "," || ch == " " || ch == "(" || ch == ")" { "_" } else { ch }).join("")
}

// Write the statements that store `r` into the C lvalue `dst` of type `t`.
fn rhs_into(mut self: Cg, ind: Str, dst: Str, t: types.Ty, r: ir.Rhs) {
    match r {
        Use(x) => {
            let a = self.atom(x)
            self.set(ind, dst, a)
        },
        Bin(op, ty, x, y, sp) => {
            let b = self.atom(y)
            let a = self.atom(x)
            let e = self.binop(op, ty, a, b, sp)
            self.set(ind, dst, e)
        },
        Negate(TInt, x) => {
            let a = self.atom(x)
            self.set(ind, dst, "(int64_t)(0 - (uint64_t){a})")
        },
        Negate(_, x) => {
            let a = self.atom(x)
            self.set(ind, dst, "(-{a})")
        },
        Flip(x) => {
            let a = self.atom(x)
            self.set(ind, dst, "(!{a})")
        },
        Call(f, args) => {
            let xs = self.atoms(args)
            self.set(ind, dst, "{f}({xs.join(", ")})")
        },
        CallMut(f, args) => {
            // the values first, in order, so a value that names a place is
            // retained before the place is made unique; then a pointer to
            // each place
            self.line(ind, "\{")
            for (k, x) in args.with_index() {
                match x {
                    ByValue(a) => {
                        let ct = self.ctype(ir.atom_ty(a))
                        let ax = self.atom(a)
                        self.line(ind, "  {ct} a{k}_ = {ax};")
                    },
                    ByPlace(..) => {},
                }
            }
            let mut xs: List[Str] = []
            for (k, x) in args.with_index() {
                match x {
                    ByValue(_) => xs.push("a{k}_"),
                    ByPlace(v, steps) => {
                        let (p, _) = self.place_ptr(ind, "r{k}_", v, steps)
                        xs.push(p)
                    },
                }
            }
            self.line(ind, "  {dst} = {f}({xs.join(", ")});")
            self.line(ind, "}")
        },
        CallClo(f, args) => {
            let fv = atom_var(f)
            let (ps, rt) = match fv.ty {
                TFn(ps, rt) => (ps, rt),
                _ => panic("callclo type"),
            }
            let mut cps = ["WClo*"]
            for p in ps {
                let s = self.ctype(p)
                cps.push(s)
            }
            let cr = self.ctype(rt)
            let xs = self.atoms(args)
            self.set(ind, dst, "(({cr} (*)({cps.join(", ")}))({var(fv)})->fn)({([var(fv)] + xs).join(", ")})")
        },
        MkDyn(ty, i, x, ms) => {
            let n = self.cname(ty)
            let key = n + "_as_" + vtable_key(i)
            if !self.dyns.any(|d| d.key == key) {
                self.dyns.push(DynBox { key, ty, methods: ms })
            }
            let a = self.atom(x)
            self.line(ind, "\{")
            self.line(ind, "  struct Dyn_{key}* d_ = (struct Dyn_{key}*)w_alloc_k(sizeof(struct Dyn_{key}), WK_PLAIN);")
            self.line(ind, "  d_->base.rc = 1; d_->base.vt = (const WVt*)&Dyn_{key}_vt; d_->val = {a};")
            self.line(ind, "  w_set_kids(d_, w_dyn_kids);")
            self.line(ind, "  {dst} = (WDyn*)d_;")
            self.line(ind, "}")
        },
        Select(id, ops, has_default, sp) => {
            let n = ops.len()
            self.line(ind, "WSelOp sel{id}_ops[{n}];")
            for (i, op) in ops.with_index() {
                match op {
                    SRecv(ch, el, on) => {
                        let ct = self.ctype(el)
                        self.line(ind, "{ct} sel{id}_v{i};")
                        let o = self.atom(on)
                        let ca = self.atom(ch)
                        self.line(ind, "sel{id}_ops[{i}] = (WSelOp)\{ {ca}, 0, &sel{id}_v{i}, 0, {o} };")
                    },
                    SSend(ch, v, el, on) => {
                        let va = self.atom(v)
                        let ct = self.ctype(el)
                        self.line(ind, "{ct} sel{id}_s{i} = {va};")
                        let o = self.atom(on)
                        let ca = self.atom(ch)
                        self.line(ind, "sel{id}_ops[{i}] = (WSelOp)\{ {ca}, 1, &sel{id}_s{i}, 0, {o} };")
                    },
                    SAfter(_, ms, on) => {
                        let m = self.atom(ms)
                        let o = self.atom(on)
                        self.line(ind, "sel{id}_ops[{i}] = (WSelOp)\{ NULL, 2, NULL, 0, {o}, {m} };")
                    },
                }
            }
            self.set(ind, dst, "w_select(sel{id}_ops, {n}, {if has_default { 1 } else { 0 }}, {self.where(sp)})")
            // a value that was not sent is still ours
            for (i, op) in ops.with_index() {
                match op {
                    SSend(_, _, el, _) if !is_scalar(el) => {
                        let en = self.cname(el)
                        self.line(ind, "if ({dst} != {i}) {en}_drop(sel{id}_s{i});")
                    },
                    _ => {},
                }
            }
        },
        SelGot(id, i, ot) => {
            let none = self.mk_enum(ot, 1, [])
            let some = self.mk_enum(ot, 0, ["sel{id}_v{i}"])
            self.set(ind, dst, "(sel{id}_ops[{i}].ok ? {some} : {none})")
        },
        Catch(clo, rt) => {
            // run the closure under a panic boundary: Ok(value), or Err(message)
            let fv = var(atom_var(clo))
            let ct = self.ctype(rt)
            let ok = self.mk_enum(t, 0, ["r_"])
            let err = self.mk_enum(t, 1, ["m_"])
            self.line(ind, "\{")
            self.line(ind, "  WCatch c_;")
            self.line(ind, "  w_catch_init(&c_);")
            self.line(ind, "  WCatch **slot_ = w_catch_slot();")
            self.line(ind, "  if (_setjmp(c_.jb) == 0) \{")
            self.line(ind, "    WCatch *guard_ __attribute__((cleanup(w_catch_land))) = &c_;")
            self.line(ind, "    *slot_ = &c_;")
            self.line(ind, "    {ct} r_ = (({ct} (*)(WClo*))({fv})->fn)({fv});")
            self.line(ind, "    *slot_ = c_.prev;")
            self.line(ind, "    w_catch_end(&c_);")
            self.line(ind, "    {dst} = {ok};")
            self.line(ind, "  } else \{")
            self.line(ind, "    w_catch_release(&c_);")
            self.line(ind, "    if (c_.cancel) w_cancel_unwind();   /* a cancellation passes through `catch` */")
            self.line(ind, "    WStr *m_ = Str_from(c_.msg, (int64_t)strlen(c_.msg));")
            self.line(ind, "    free(c_.msg); free(c_.where);")
            self.line(ind, "    {dst} = {err};")
            self.line(ind, "  }")
            self.line(ind, "}")
        },
        CallC(cs, args, _, sp) if cs.lib == "limen" => {
            // the runtime's own helpers (ffi.runtime_fns)
            let hd = self.cname(handle_ty())
            let xs = self.atoms(args)
            match (cs.sym, xs) {
                ("limen_copy", [p, n]) => self.set(ind, dst, "w_ffi_copy(({p}).f0, {n}, {self.where(sp)})"),
                ("limen_handle_new", [p]) => self.set(ind, dst, "w_handle_new(({p}).f0)"),
                ("limen_sql_run", [db, text, params, mode]) => {
                    self.use_sql_api()
                    self.set(ind, dst, "w_sql_run(w_sql_api, ({db}).f0, {text}, {params}, {mode})")
                },
                ("limen_sql_open", [root, name, flags]) => {
                    self.use_sql_api()
                    self.set(ind, dst, "w_sql_open(w_sql_api, {root}, {name}, {flags})")
                },
                ("limen_bytes_int", [b, at]) => self.set(ind, dst, "w_bytes_int({b}, {at}, {self.where(sp)})"),
                ("limen_bytes_float", [b, at]) => self.set(ind, dst, "w_bytes_float({b}, {at}, {self.where(sp)})"),
                ("limen_float_bits", [x]) => self.set(ind, dst, "w_float_bits({x})"),
                ("limen_crypto", [op, x1, x2, x3, x4]) => {
                    self.tls = true
                    self.set(ind, dst, "w_crypto({op}, {x1}, {x2}, {x3}, {x4})")
                },
                ("limen_handle_acquire" | "limen_handle_release" | "limen_handle_close", [id]) => self.set(ind, dst, "({hd})\{ w_{cs.sym.slice("limen_".len(), cs.sym.len())}({id}) }"),
                _ => panic("cgen: runtime helper " + cs.sym),
            }
        },
        CallC(cs, args, cbs, sp) => self.call_c(ind, dst, t, cs, args, cbs, sp),
        CallDyn(k, ps, rt, recv, args) => {
            let mut cps = ["WDyn*"]
            for p in ps {
                let s = self.ctype(p)
                cps.push(s)
            }
            let cr = self.ctype(rt)
            let xs = self.atoms(args)
            let ra = self.atom(recv)
            self.set(ind, dst, "(({cr} (*)({cps.join(", ")}))({ra})->vt->m[{k}])({([ra] + xs).join(", ")})")
        },
        MkStruct(ty, args) => {
            let xs = self.atoms(args)
            let n = self.cname(ty)
            self.set(ind, dst, if args.is_empty() { "({n})\{0}" } else { "({n})\{ {xs.join(", ")} }" })
        },
        MkEnum(ty, k, args) => {
            let xs = self.atoms(args)
            let e = self.mk_enum(ty, k, xs)
            self.set(ind, dst, e)
        },
        MkList(ty, args) if is_array(ty) => {
            let xs = self.atoms(args)
            let n = self.cname(ty)
            self.set(ind, dst, if args.is_empty() { "({n})\{0}" } else { "({n})\{ \{ {xs.join(", ")} } }" })
        },
        MkList(ty, args) => {
            let n = self.cname(ty)
            self.line(ind, "\{")
            self.line(ind, "  {n}* l_ = {n}_new({args.len()});")
            for (i, x) in args.with_index() {
                let a = self.atom(x)
                self.line(ind, "  l_->data[{i}] = {a};")
            }
            self.line(ind, "  l_->len = {args.len()};")
            self.line(ind, "  {dst} = l_;")
            self.line(ind, "}")
        },
        MkClosure(fname, _, []) => {
            self.line(ind, "\{")
            self.line(ind, "  WClo* k_ = (WClo*)w_alloc_k(sizeof(WClo), WK_PLAIN);")
            self.line(ind, "  k_->rc = 1; k_->fn = (void*){fname}; k_->drop = NULL; k_->share = NULL;")
            self.line(ind, "  {dst} = k_;")
            self.line(ind, "}")
        },
        MkClosure(fname, _, args) => {
            self.line(ind, "\{")
            self.line(ind, "  struct Env_{fname}* e_ = (struct Env_{fname}*)w_alloc_k(sizeof(struct Env_{fname}), WK_PLAIN);")
            self.line(ind, "  e_->base.rc = 1; e_->base.fn = (void*){fname}; e_->base.drop = Env_{fname}_drop; e_->base.share = Env_{fname}_share;")
            self.line(ind, "  w_set_kids(e_, (void (*)(void*))Env_{fname}_drop);")
            for (i, x) in args.with_index() {
                let a = self.atom(x)
                self.line(ind, "  e_->c{i} = {a};")
            }
            self.line(ind, "  {dst} = (WClo*)e_;")
            self.line(ind, "}")
        },
        Get(root, rty, steps) => {
            let steps = match (root, steps) {
                (V(v) | VDup(v), [PIndex(V(i), _), ..rest]) if self.inrange.contains((v.id, i.id)) => [PIndexU(V(i))] + rest,
                _ => steps,
            }
            let ra = self.atom(root)
            let (e, ft) = self.walk(ra, rty, steps)
            let d = self.dup_of(ft, e)
            self.set(ind, dst, d)
        },
        Payload(x, ety, k, i) => {
            let pt = self.variants_of(ety)[k].1[i]
            let a = self.atom(x)
            let pe = self.payload_expr(ety, a, k, i)
            let d = self.dup_of(pt, pe)
            self.set(ind, dst, d)
        },
        IsTag(x, ety, k) => {
            let a = self.atom(x)
            let te = self.tag_expr(ety, a)
            self.set(ind, dst, "({te} == {k})")
        },
        PatTest(x, ty, p) => {
            let a = self.atom(x)
            let e = self.pat_cond(a, ty, p)
            self.set(ind, dst, e)
        },
        Format(ps) => {
            let mut shown: List[Shown] = []
            for p in ps {
                match p {
                    IStr(s) => shown.push(Text(s)),
                    IVal(x, ty) => {
                        let a = self.atom(x)
                        shown.push(Value(a, ty, true))
                    },
                    IValQ(x, ty) => {
                        let a = self.atom(x)
                        shown.push(Value(a, ty, false))
                    },
                }
            }
            self.show_into(ind, dst, shown)
        },
        RootField(x, f) => {
            let a = self.atom(x)
            self.set(ind, dst, "Cap_root_field({a}, {c_string(f)})")
        },
        GroupNew(None, il) => self.set(ind, dst, "w_group_new({if il { 0 } else { 1 }})"),
        GroupNew(Some((_, ms)), il) => {
            let m = self.atom(ms)
            self.set(ind, dst, "w_group_new_until({m}, {if il { 0 } else { 1 }})")
        },
        Spawn(g, task, rt, keep) => {
            if !self.task_tys.contains(rt) {
                self.task_tys.push(rt)
            }
            let ct = self.ctype(rt)
            let n = self.cname(rt)
            let ta = self.atom(task)
            let ga = self.atom(g)
            self.line(ind, "w_spawn({ga}, {ta}, wtask_{n}, sizeof({ct}), {keep});")
            self.set(ind, dst, "0")
        },
        GroupJoin(g, lty, until) => {
            let el = match lty {
                TList(e) => e,
                _ => TUnit,
            }
            let n = self.cname(lty)
            let ga = self.atom(g)
            self.line(ind, "\{")
            self.line(ind, "  WGroup* g_ = {ga};")
            self.line(ind, "  w_group_wait(g_, 1);")
            self.line(ind, "  w_group_reraise(g_);")
            self.line(ind, "  {n}* l_ = {n}_new(g_->n);")
            // tasks that return () are not kept: the list holds the others' results
            if until {
                // a cancelled task has no result: None
                let rt = match el {
                    TNamed("Option", [r]) => r,
                    _ => TUnit,
                }
                let none = self.mk_enum(el, 1, [])
                let some = self.mk_enum(el, 0, ["r_"])
                let ct = self.ctype(rt)
                self.line(ind, "  for (int64_t i_ = 0; i_ < g_->n; i_++) \{")
                self.line(ind, "    if (!g_->tasks[i_] || !g_->tasks[i_]->keep) continue;")
                self.line(ind, "    if (g_->tasks[i_]->cancelled) l_->data[l_->len++] = {none};")
                self.line(ind, "    else \{ {ct} r_; memcpy(&r_, g_->tasks[i_]->slot, sizeof({ct})); l_->data[l_->len++] = {some}; }")
                self.line(ind, "  }")
            } else {
                let ct = self.ctype(el)
                self.line(ind, "  for (int64_t i_ = 0; i_ < g_->n; i_++) if (g_->tasks[i_] && g_->tasks[i_]->keep) memcpy(&l_->data[l_->len++], g_->tasks[i_]->slot, sizeof({ct}));")
            }
            self.line(ind, "  w_group_release_tasks(g_);")
            self.line(ind, "  {dst} = l_;")
            self.line(ind, "}")
        },
        ChanNew(TChan(el), cap, sp) => {
            let _ = self.cname(TChan(el))
            let wh = self.where(sp)
            let mut share = "NULL"
            let mut drop = "NULL"
            if !is_scalar(el) {
                let en = self.cname(el)
                let en2 = self.cname(el)
                share = "chshare_" + en
                drop = "chdrop_" + en2
            }
            let ct = self.ctype(el)
            let a = self.atom(cap)
            self.set(ind, dst, "w_chan_new({a}, sizeof({ct}), {drop}, {share}, {wh})")
        },
        ChanNew(..) => panic("channel type"),
        ChanSend(ch, v, sp) => {
            let el = match ir.atom_ty(ch) {
                TChan(e) => e,
                _ => TUnit,
            }
            let va = self.atom(v)
            let ct = self.ctype(el)
            self.line(ind, "\{")
            self.line(ind, "  {ct} v_ = {va};")
            let ca = self.atom(ch)
            self.line(ind, "  w_chan_send({ca}, &v_, {self.where(sp)});")
            self.line(ind, "}")
            self.set(ind, dst, "0")
        },
        Panic(m, sp) => {
            self.line(ind, "memset(&{dst}, 0, sizeof {dst});")
            let a = self.atom(m)
            self.line(ind, "w_panic_c(({a})->data, {self.where(sp)});")
        },
        Prim(name, rt, args, sp) => {
            let xs = self.atoms(args)
            self.prim(ind, dst, t, name, rt, xs, sp)
        },
    }
}

// A call into C: the Foreign checked (unless trusted), the arguments
// converted, callbacks passed as their wrappers, out-parameters as
// locals, and the results converted back.
fn call_c(mut self: Cg, ind: Str, dst: Str, t: types.Ty, cs: ffi.CSig, args: List[ir.Atom], cbs: List[ir.Callback], sp: ast.Span) {
    if !self.csyms.contains(cs.sym) {
        self.csyms.push(cs.sym)
    }
    self.line(ind, "\{")
    let xs = self.atoms(args)
    let mut rest = xs
    if !cs.trusted {
        match xs {
            [cap, ..vs] => {
                self.line(ind, "  w_foreign_check({cap}, {c_string(cs.lib)}, {self.where(sp)});")
                rest = vs
            },
            [] => panic("cgen: foreign call"),
        }
    }
    let pass_foreign = cbs.any(|cb| cb.takes_foreign)
    let mut left = cbs
    let mut outs: List[(Str, ffi.CTy)] = []
    let fixed = cs.fixed ?? cs.params.len()
    let mut cargs: List[Str] = []
    // a blocking call's arguments go into its job: (field, C type, value)
    let mut fields: List[(Str, Str, Str)] = []
    for (i, p) in cs.params.with_index() {
        if p.out {
            if cs.blocking {
                outs.push(("j_->o{i}", p.cty))
                cargs.push("&j->o{i}")
                continue
            }
            let o = "o{i}_"
            self.line(ind, "  {ffi.c_name(p.cty)} {o} = 0;")
            outs.push((o, p.cty))
            cargs.push("&" + o)
            continue
        }
        match p.cty {
            Fn(ps, r) => match left {
                [cb, ..more] => {
                    left = more
                    let w = self.ffi_callback(cb, ps, r)
                    cargs.push(w)
                },
                [] => panic("cgen: foreign callback"),
            },
            ty => {
                let v = match rest {
                    [v, ..more] => {
                        rest = more
                        v
                    },
                    [] => panic("cgen: foreign arity"),
                }
                if cs.blocking {
                    // a Str or Bytes is lent to C through a reference the job keeps
                    let x = match ty {
                        Str => "(const char *)w_block_keep(&j_->h, {v})",
                        Bytes => "w_block_keep(&j_->h, {v})",
                        _ => {
                            let a = self.ffi_arg(i >= fixed, ty, v, "argument `{p.name}` of `{cs.sym}`", self.where(sp))
                            a
                        },
                    }
                    let ft = if i >= fixed && (ty == Int32 || ty == Bool) {
                        "int"
                    } else {
                        let ct = self.ffi_ctype(ty)
                        ct
                    }
                    fields.push(("a{i}", ft, x))
                    cargs.push("j->a{i}")
                } else {
                    let a = self.ffi_arg(i >= fixed, ty, v, "argument `{p.name}` of `{cs.sym}`", self.where(sp))
                    cargs.push(a)
                }
            },
        }
    }
    let mut ptys: List[Str] = []
    for p in cs.params.take(fixed) {
        let pt = self.ffi_ctype(p.cty)
        ptys.push(pt + if p.out { " *" } else { "" })
    }
    let rt = self.ffi_ctype(cs.ret)
    let proto = "{rt} (*)({if ptys.is_empty() { "void" } else { ptys.join(", ") + if cs.fixed.is_some() { ", ..." } else { "" } }})"
    let call = "(({proto})vf_{cs.sym})({cargs.join(", ")})"
    if cs.blocking {
        return self.blocking_call(ind, dst, t, cs, fields, outs, call)
    }
    // the Foreign value for callbacks that take one, kept on the task's fiber
    if pass_foreign {
        self.line(ind, "  WFiber *cf_ = w_current();")
        self.line(ind, "  WCap *cfp_ = cf_->cb_foreign;")
        self.line(ind, "  cf_->cb_foreign = {xs[0]};")
    }
    if cs.ret == Unit {
        self.line(ind, "  {call};")
    } else {
        let rt2 = self.ffi_ctype(cs.ret)
        self.line(ind, "  {rt2} r_ = {call};")
    }
    if pass_foreign {
        self.line(ind, "  cf_->cb_foreign = cfp_;")
    }
    // the out-parameters' values first: OCaml makes the right operand of
    // `@` first
    let mut outv: List[Str] = []
    for o in outs {
        let v = self.ffi_result(o.1, o.0)
        outv.push(v)
    }
    let mut vals: List[Str] = []
    if cs.ret != Unit {
        let v = self.ffi_result(cs.ret, "r_")
        vals.push(v)
    }
    vals = vals + outv
    match vals {
        [] => self.line(ind, "  {dst} = 0;"),
        [v] => self.line(ind, "  {dst} = {v};"),
        vs => {
            let n = self.cname(t)
            self.line(ind, "  {dst} = ({n})\{ {vs.join(", ")} };")
        },
    }
    self.line(ind, "}")
}

// Blocking calls: the call runs on the blocking-call pool, from a job
// holding its arguments, out-parameters and result (WBlock in the
// runtime), while the task waits. A struct's C type is named by
// ffi_ctype already, for the prototype.
fn blocking_call(mut self: Cg, ind: Str, dst: Str, t: types.Ty, cs: ffi.CSig, fields: List[(Str, Str, Str)], outs: List[(Str, ffi.CTy)], call: Str) {
    let n = "vbj{self.bjobs.len()}_"
    let rty = self.ffi_ctype(cs.ret)
    let mut members = fields.map(|f| "{f.1} {f.0};")
    for (i, p) in cs.params.with_index() {
        if p.out {
            members.push("{ffi.c_name(p.cty)} o{i};")
        }
    }
    match cs.ret {
        Unit | Str => {},
        _ => members.push("{rty} r;"),
    }
    let body = match cs.ret {
        Unit => "{call};",
        Str => "j->h.res = w_ffi_str({call});",
        _ => "j->r = {call};",
    }
    self.bjobs.push("typedef struct \{ WBlock h; {members.join(" ")} } {n};\nstatic void {n}run(WBlock *b_) \{ {n} *j = ({n} *)b_; {body} }\n")
    self.line(ind, "  {n} *j_ __attribute__((cleanup(w_block_end))) = ({n} *)w_block_new(sizeof({n}), {n}run);")
    for f in fields {
        self.line(ind, "  j_->{f.0} = {f.2};")
    }
    self.line(ind, "  w_block_wait(&j_->h);")
    // the out-parameters' values first: OCaml makes the right operand of
    // `@` first
    let mut outv: List[Str] = []
    for o in outs {
        let v = self.ffi_result(o.1, o.0)
        outv.push(v)
    }
    let mut vals: List[Str] = []
    match cs.ret {
        Unit => {},
        Str => vals.push("w_block_str(&j_->h)"),
        _ => {
            let v = self.ffi_result(cs.ret, "j_->r")
            vals.push(v)
        },
    }
    vals = vals + outv
    match vals {
        [] => self.line(ind, "  {dst} = 0;"),
        [v] => self.line(ind, "  {dst} = {v};"),
        vs => {
            let tn = self.cname(t)
            self.line(ind, "  {dst} = ({tn})\{ {vs.join(", ")} };")
        },
    }
    self.line(ind, "}")
}

// A built-in method on receiver type `rt`, its arguments `a` already C.
fn prim(mut self: Cg, ind: Str, dst: Str, t: types.Ty, name: Str, rt: types.Ty, a: List[Str], sp: ast.Span) {
    let arg = |i: Int| a[i]
    match (name, rt) {
        ("list_len" | "array_len", TArray(_, TLen(n))) => self.set(ind, dst, "{n}"),
        ("array_get", TArray(el, TLen(n))) => {
            let v = self.dup_of(el, "({arg(0)}).a[{arg(1)}]")
            self.opt_from(ind, dst, t, "{arg(1)} >= 0 && {arg(1)} < {n}", v)
        },
        ("array_contains", TArray(el, TLen(n))) => {
            let eq = self.binop(Eq, el, "({arg(0)}).a[i_]", arg(1), diag.nowhere())
            self.set(ind, dst, "(\{ bool f_ = false; for (int64_t i_ = 0; i_ < {n}; i_++) if ({eq}) \{ f_ = true; break; } f_; })")
        },
        ("array_to_list", TArray(el, TLen(n))) => {
            let ln = self.cname(TList(el))
            let v = self.dup_of(el, "({arg(0)}).a[i_]")
            self.line(ind, "\{")
            self.line(ind, "  {ln}* l_ = {ln}_new({n});")
            self.line(ind, "  for (int64_t i_ = 0; i_ < {n}; i_++) l_->data[i_] = {v};")
            self.line(ind, "  l_->len = {n};")
            self.line(ind, "  {dst} = l_;")
            self.line(ind, "}")
        },
        ("chan_recv", TChan(el)) => {
            let ct = self.ctype(el)
            self.line(ind, "\{")
            self.line(ind, "  {ct} v_;")
            let none = self.mk_enum(t, 1, [])
            let some = self.mk_enum(t, 0, ["v_"])
            self.line(ind, "  {dst} = w_chan_recv({arg(0)}, &v_) ? {some} : {none};")
            self.line(ind, "}")
        },
        // the value escapes into an empty asm statement the compiler cannot see through
        ("keep", _) => {
            self.line(ind, "\{ __typeof__({arg(0)}) k_ = {arg(0)}; __asm__ volatile(\"\" : : \"r\"(&k_) : \"memory\"); }")
            self.set(ind, dst, "0")
        },
        ("chan_close", _) => {
            self.line(ind, "w_chan_close({arg(0)}, {self.where(sp)});")
            self.set(ind, dst, "0")
        },
        // Atomic and Shared (the runtime's "Atomic and Shared")
        ("atomic_new", _) => self.set(ind, dst, "w_atomic_new({arg(0)})"),
        ("atomic_get", _) => self.set(ind, dst, "w_atomic_get({arg(0)})"),
        ("atomic_set", _) => {
            self.line(ind, "w_atomic_set({arg(0)}, {arg(1)});")
            self.set(ind, dst, "0")
        },
        ("atomic_add", _) => self.set(ind, dst, "w_atomic_add({arg(0)}, {arg(1)})"),
        ("atomic_swap", _) => self.set(ind, dst, "w_atomic_swap({arg(0)}, {arg(1)})"),
        ("atomic_compare_and_set", _) => self.set(ind, dst, "w_atomic_cas({arg(0)}, {arg(1)}, {arg(2)})"),
        ("shared_new", TShared(el)) => {
            // the value is the Shared's own reference, switched to shared:
            // any task may read it
            let _ = self.cname(rt)
            let cn = self.cname(el)
            let ct = self.ctype(el)
            let fns = if is_scalar(el) { "NULL, NULL" } else { "chdrop_{cn}, chshare_{cn}" }
            let dv = self.dup_of(el, arg(0))
            self.line(ind, "\{")
            self.line(ind, "  WShared *s_ = w_shared_new(sizeof({ct}), {fns});")
            self.line(ind, "  {ct} v_ = {dv};")
            if !is_scalar(el) {
                self.line(ind, "  {cn}_share(v_);")
            }
            self.line(ind, "  memcpy(s_->v, &v_, sizeof v_);")
            self.line(ind, "  {dst} = s_;")
            self.line(ind, "}")
        },
        ("shared_get", TShared(el)) => {
            // a snapshot: another reference to the value, taken under the lock
            let ct = self.ctype(el)
            let dv = self.dup_of(el, "v_")
            self.line(ind, "\{")
            self.line(ind, "  w_shared_lock({arg(0)}, {self.where(sp)});")
            self.line(ind, "  {ct} v_; memcpy(&v_, ({arg(0)})->v, sizeof v_);")
            self.line(ind, "  {dst} = {dv};")
            self.line(ind, "  w_shared_unlock({arg(0)});")
            self.line(ind, "}")
        },
        ("shared_set", TShared(el)) => {
            let ct = self.ctype(el)
            let dn = self.dup_of(el, arg(1))
            let cn = self.cname(el)
            self.line(ind, "\{")
            self.line(ind, "  {ct} n_ = {dn};")
            if !is_scalar(el) {
                self.line(ind, "  {cn}_share(n_);")
            }
            self.line(ind, "  w_shared_lock({arg(0)}, {self.where(sp)});")
            self.line(ind, "  {ct} o_; memcpy(&o_, ({arg(0)})->v, sizeof o_); memcpy(({arg(0)})->v, &n_, sizeof n_);")
            self.line(ind, "  w_shared_unlock({arg(0)});")
            if !is_scalar(el) {
                self.line(ind, "  {cn}_drop(o_);")
            }
            self.line(ind, "}")
            self.set(ind, dst, "0")
        },
        ("shared_update", TShared(el)) => {
            // the function runs holding the lock, on its own reference to
            // the value (so it copies what it changes, and a panic or a
            // cancellation in it leaves the value as it was: the cleanup
            // lets go of the lock); its result becomes the value
            let ct = self.ctype(el)
            let da = self.dup_of(el, "a_")
            let dr = self.dup_of(el, "r_")
            let cn = self.cname(el)
            self.line(ind, "\{")
            self.line(ind, "  WShared *u_ __attribute__((cleanup(w_update_end))) = w_update_begin({arg(0)}, {self.where(sp)});")
            self.line(ind, "  {ct} a_; memcpy(&a_, u_->v, sizeof a_);")
            self.line(ind, "  {ct} r_ = (({ct} (*)(WClo*, {ct}))({arg(1)})->fn)({arg(1)}, {da});")
            if !is_scalar(el) {
                self.line(ind, "  {cn}_share(r_);")
            }
            self.line(ind, "  {ct} o_; memcpy(&o_, u_->v, sizeof o_); memcpy(u_->v, &r_, sizeof r_);")
            self.line(ind, "  {dst} = {dr};")
            self.line(ind, "  w_update_end(&u_);")
            self.line(ind, "  u_ = NULL;")
            if !is_scalar(el) {
                self.line(ind, "  {cn}_drop(o_);")
            }
            self.line(ind, "}")
        },
        ("map_new", TMap(..)) => {
            let n = self.cname(rt)
            self.set(ind, dst, "{n}_new()")
        },
        ("map_from", TMap(k, v)) => {
            let n = self.cname(rt)
            let dv = self.dup_of(v, "({arg(0)})->data[i_].f1")
            let dk = self.dup_of(k, "({arg(0)})->data[i_].f0")
            self.line(ind, "\{")
            self.line(ind, "  {n}* m_ = {n}_new();")
            self.line(ind, "  for (int64_t i_ = 0; i_ < ({arg(0)})->len; i_++) {n}_put(&m_, {dk}, {dv});")
            let _ = self.cname(TList(TNamed(ast.tuple_name(2), [k, v])))
            self.line(ind, "  {dst} = m_;")
            self.line(ind, "}")
        },
        ("map_at", TMap(..)) => {
            let n = self.cname(rt)
            self.set(ind, dst, "{n}_at({arg(0)}, {arg(1)}, {self.where(sp)})")
        },
        ("map_get", TMap(_, v)) => {
            let n = self.cname(rt)
            let vt = self.ctype(v)
            self.line(ind, "\{")
            self.line(ind, "  {vt}* p_ = {n}_get({arg(0)}, {arg(1)});")
            let dv = self.dup_of(v, "*p_")
            let none = self.mk_enum(t, 1, [])
            let some = self.mk_enum(t, 0, [dv])
            self.line(ind, "  {dst} = p_ ? {some} : {none};")
            self.line(ind, "}")
        },
        ("map_contains", TMap(..)) => {
            let n = self.cname(rt)
            self.set(ind, dst, "({n}_find({arg(0)}, {arg(1)}) >= 0)")
        },
        ("map_len", _) => self.set(ind, dst, "({arg(0)})->len"),
        ("map_is_empty", _) => self.set(ind, dst, "(({arg(0)})->len == 0)"),
        ("map_keys" | "map_values" | "map_entries", TMap(k, v)) => {
            let ln = self.cname(t)
            let item = match name {
                "map_keys" => self.dup_of(k, "(m_)->keys[i_]"),
                "map_values" => self.dup_of(v, "(m_)->vals[i_]"),
                _ => {
                    let dv = self.dup_of(v, "(m_)->vals[i_]")
                    let dk = self.dup_of(k, "(m_)->keys[i_]")
                    let tn = self.cname(TNamed(ast.tuple_name(2), [k, v]))
                    "({tn})\{ {dk}, {dv} }"
                },
            }
            let mn = self.cname(rt)
            self.line(ind, "\{")
            self.line(ind, "  {mn}* m_ = {arg(0)};")
            self.line(ind, "  {ln}* l_ = {ln}_new(m_->len);")
            self.line(ind, "  for (int64_t i_ = 0; i_ < m_->n; i_++) if (m_->live[i_]) {ln}_push_u(&l_, {item});")
            self.line(ind, "  {dst} = l_;")
            self.line(ind, "}")
        },
        ("list_len" | "str_len", _) => self.set(ind, dst, "({arg(0)})->len"),
        ("list_is_empty" | "str_is_empty", _) => self.set(ind, dst, "(({arg(0)})->len == 0)"),
        ("list_get", TList(el)) => {
            let v = self.dup_of(el, "({arg(0)})->data[{arg(1)}]")
            self.opt_from(ind, dst, t, "{arg(1)} >= 0 && {arg(1)} < ({arg(0)})->len", v)
        },
        ("list_first", TList(el)) => {
            let v = self.dup_of(el, "({arg(0)})->data[0]")
            self.opt_from(ind, dst, t, "({arg(0)})->len > 0", v)
        },
        ("list_last", TList(el)) => {
            let v = self.dup_of(el, "({arg(0)})->data[({arg(0)})->len - 1]")
            self.opt_from(ind, dst, t, "({arg(0)})->len > 0", v)
        },
        ("list_contains", _) => self.named_call(ind, dst, rt, "_contains({arg(0)}, {arg(1)})"),
        ("list_reverse", _) => self.named_call(ind, dst, rt, "_reverse({arg(0)})"),
        ("list_sort", TList(el)) => {
            let _ = self.cmp_prefix(el)
            match el {
                TInt | TStr | TFloat => {},
                _ => {
                    let known = self.named_in(self.sort_tys, rt)
                    if !known {
                        self.sort_tys.push(rt)
                    }
                },
            }
            self.named_call(ind, dst, rt, "_sort({arg(0)})")
        },
        ("list_slice", _) => self.named_call(ind, dst, rt, "_slice({arg(0)}, {arg(1)}, {arg(2)})"),
        ("list_take", _) => self.named_call(ind, dst, rt, "_slice({arg(0)}, 0, {arg(1)})"),
        ("list_skip", _) => self.named_call(ind, dst, rt, "_slice({arg(0)}, {arg(1)}, ({arg(0)})->len)"),
        ("list_join", _) => self.set(ind, dst, "L_Str_join({arg(0)}, {arg(1)})"),
        ("list_sum", _) => self.set(ind, dst, "L_Int_sum({arg(0)})"),
        ("str_lines", _) => self.set(ind, dst, "Str_lines({arg(0)})"),
        ("str_split", _) => self.set(ind, dst, "Str_split({arg(0)}, {arg(1)})"),
        ("str_trim", _) => self.set(ind, dst, "Str_trim({arg(0)})"),
        ("str_contains", _) => self.set(ind, dst, "(Str_find({arg(0)}, {arg(1)}, 0) >= 0)"),
        ("str_starts_with", _) => self.set(ind, dst, "Str_starts({arg(0)}, {arg(1)})"),
        ("str_ends_with", _) => self.set(ind, dst, "Str_ends({arg(0)}, {arg(1)})"),
        ("str_to_upper", _) => self.set(ind, dst, "Str_map_case({arg(0)}, true)"),
        ("str_to_lower", _) => self.set(ind, dst, "Str_map_case({arg(0)}, false)"),
        ("str_replace", _) => self.set(ind, dst, "Str_replace({arg(0)}, {arg(1)}, {arg(2)})"),
        ("str_parse_int", _) => self.found(ind, dst, t, "int64_t n_;", "Str_parse_int({arg(0)}, &n_)", "n_"),
        ("str_parse_float", _) => self.found(ind, dst, t, "double x_;", "Str_parse_float({arg(0)}, &x_)", "x_"),
        ("str_slice", _) => self.set(ind, dst, "Str_slice({arg(0)}, {arg(1)}, {arg(2)})"),
        ("str_index_of", _) => self.found(ind, dst, t, "int64_t i_ = Str_find({arg(0)}, {arg(1)}, 0);", "i_ >= 0", "i_"),
        ("str_last_index_of", _) => self.found(ind, dst, t, "int64_t i_ = Str_rfind({arg(0)}, {arg(1)});", "i_ >= 0", "i_"),
        ("str_bytes", _) => self.set(ind, dst, "Str_bytes({arg(0)})"),
        ("str_chars", _) => self.set(ind, dst, "Str_chars({arg(0)})"),
        ("str_to_bytes" | "bytes_to_str", _) => self.set(ind, dst, "Str_dup({arg(0)})"),
        ("bytes_new", _) => self.set(ind, dst, "Bytes_from_list({arg(0)}, {self.where(sp)})"),
        ("bytes_at", _) => self.set(ind, dst, "Bytes_at({arg(0)}, {arg(1)}, {self.where(sp)})"),
        ("bytes_len", _) => self.set(ind, dst, "({arg(0)})->len"),
        ("bytes_is_empty", _) => self.set(ind, dst, "(({arg(0)})->len == 0)"),
        ("bytes_get", _) => self.opt_from(ind, dst, t, "{arg(1)} >= 0 && {arg(1)} < ({arg(0)})->len", "(int64_t)(unsigned char)({arg(0)})->data[{arg(1)}]"),
        ("bytes_slice", _) => self.set(ind, dst, "Str_slice({arg(0)}, {arg(1)}, {arg(2)})"),
        ("bytes_to_list", _) => self.set(ind, dst, "Str_bytes({arg(0)})"),
        ("int_range", _) => self.set(ind, dst, "L_Int_range({arg(0)}, {arg(1)})"),
        ("int_to_char", _) => self.set(ind, dst, "Int_to_char({arg(0)})"),
        ("int_min", _) => self.set(ind, dst, "({arg(0)} < {arg(1)} ? {arg(0)} : {arg(1)})"),
        ("int_max", _) => self.set(ind, dst, "({arg(0)} > {arg(1)} ? {arg(0)} : {arg(1)})"),
        ("int_to_str" | "float_to_str" | "bool_to_str", _) => self.show_into(ind, dst, [Value(arg(0), rt, true)]),
        ("int_to_float", _) => self.set(ind, dst, "(double){arg(0)}"),
        ("int_abs", _) => self.set(ind, dst, "w_abs({arg(0)})"),
        ("int_shift_right_unsigned", _) => self.set(ind, dst, "w_ushr({arg(0)}, {arg(1)}, {self.where(sp)})"),
        ("int_to_uint8" | "uint_to_uint8", _) => self.set(ind, dst, "(uint8_t)({arg(0)})"),
        ("int_to_uint16" | "uint_to_uint16", _) => self.set(ind, dst, "(uint16_t)({arg(0)})"),
        ("int_to_uint32" | "uint_to_uint32", _) => self.set(ind, dst, "(uint32_t)({arg(0)})"),
        ("int_to_uint64" | "uint_to_uint64", _) => self.set(ind, dst, "(uint64_t)({arg(0)})"),
        ("uint_to_int", _) => self.set(ind, dst, "(int64_t)({arg(0)})"),
        ("uint_to_str", _) => self.show_into(ind, dst, [Value(arg(0), rt, true)]),
        ("uint_to_float", _) => self.set(ind, dst, "w_u2f({arg(0)})"),
        ("uint_min", _) => self.set(ind, dst, "({arg(0)} < {arg(1)} ? {arg(0)} : {arg(1)})"),
        ("uint_max", _) => self.set(ind, dst, "({arg(0)} > {arg(1)} ? {arg(0)} : {arg(1)})"),
        ("uint_rotate_left" | "uint_rotate_right", _) => {
            let bits = match rt {
                TUInt(n) => n,
                _ => 64,
            }
            self.set(ind, dst, "(uint{bits}_t)w_urot({arg(0)}, {arg(1)}, {bits}, {if name == "uint_rotate_left" { 1 } else { 0 }})")
        },
        ("float_to_int", _) => self.set(ind, dst, "w_f2i({arg(0)})"),
        ("float_abs", _) => self.set(ind, dst, "fabs({arg(0)})"),
        ("float_sqrt", _) => self.set(ind, dst, "sqrt({arg(0)})"),
        ("float_to_fixed", _) => self.set(ind, dst, "Float_to_fixed({arg(0)}, {arg(1)})"),
        ("cap_print", TCap("Stdout")) => {
            self.line(ind, "Cap_print({arg(1)}, true);")
            self.set(ind, dst, "0")
        },
        ("cap_write", TCap("Stdout")) => {
            self.line(ind, "Cap_print({arg(1)}, false);")
            self.set(ind, dst, "0")
        },
        ("cap_print", TCap("Stderr")) => {
            self.line(ind, "Cap_eprint({arg(1)}, true);")
            self.set(ind, dst, "0")
        },
        ("cap_write", TCap("Stderr")) => {
            self.line(ind, "Cap_eprint({arg(1)}, false);")
            self.set(ind, dst, "0")
        },
        ("cap_now_ms", _) => self.set(ind, dst, "Cap_now_ms()"),
        ("cap_sleep", TCap("Clock")) => {
            self.line(ind, "Cap_sleep({arg(1)});")
            self.set(ind, dst, "0")
        },
        ("cap_int", TCap("Rand")) => self.set(ind, dst, "Cap_rand_int({arg(1)}, {arg(2)}, {self.where(sp)})"),
        ("cap_float", TCap("Rand")) => self.set(ind, dst, "Cap_rand_float()"),
        ("cap_bytes", TCap("Rand")) => self.set(ind, dst, "Cap_rand_bytes({arg(1)}, {self.where(sp)})"),
        ("cap_args", TCap("Root")) => self.set(ind, dst, "Cap_args()"),
        ("cap_read_line", TCap("Stdin")) => self.found(ind, dst, t, "bool ok_;\n{ind}  WStr *s_ = Cap_stdin_line(&ok_);", "ok_", "s_"),
        ("cap_read_all", TCap("Stdin")) => self.set(ind, dst, "Cap_stdin_all()"),
        ("cap_get", TCap("Env")) => self.found(ind, dst, t, "bool ok_;\n{ind}  WStr *s_ = Cap_env_get({arg(0)}, {arg(1)}, &ok_);", "ok_", "s_"),
        ("cap_append", TCap("Fs")) => self.io_result(ind, dst, t, "Cap_fs_append({arg(0)}, {arg(1)}, {arg(2)})", "0"),
        ("cap_list", TCap("Fs")) => self.io_result(ind, dst, t, "Cap_fs_list({arg(0)}, {arg(1)})", "(L_Str*)r_.ptr"),
        ("cap_remove", TCap("Fs")) => self.io_result(ind, dst, t, "Cap_fs_remove({arg(0)}, {arg(1)})", "0"),
        ("cap_make_dir", TCap("Fs")) => self.io_result(ind, dst, t, "Cap_fs_make_dir({arg(0)}, {arg(1)})", "0"),
        ("cap_is_dir", TCap("Fs")) => self.set(ind, dst, "Cap_fs_is_dir({arg(0)}, {arg(1)})"),
        ("cap_rename", TCap("Fs")) => self.io_result(ind, dst, t, "Cap_fs_rename({arg(0)}, {arg(1)}, {arg(2)})", "0"),
        ("cap_info", TCap("Fs")) => {
            let fi = self.ctype(TNamed("FileInfo", []))
            self.io_result(ind, dst, t, "Cap_fs_info({arg(0)}, {arg(1)})", "(\{ WFileInfo *i_ = (WFileInfo*)r_.ptr; {fi} v_ = \{ i_->size, i_->mtime_ms, i_->is_file, i_->is_dir }; free(i_); v_; })")
        },
        ("cap_only", TCap("Exec")) => self.set(ind, dst, "Cap_exec_only({arg(0)}, {arg(1)})"),
        ("cap_only_args", TCap("Exec")) => self.set(ind, dst, "Cap_exec_only_args({arg(0)}, {arg(1)}, {arg(2)})"),
        ("cap_only", TCap("Foreign")) => self.set(ind, dst, "Cap_foreign_only({arg(0)}, {arg(1)})"),
        ("cap_allows", TCap("Foreign")) => self.set(ind, dst, "Cap_foreign_allows({arg(0)}, {arg(1)})"),
        ("cap_copy", TCap("Foreign")) => self.set(ind, dst, "Cap_foreign_copy({arg(0)}, ({arg(1)}).f0, {arg(2)}, {self.where(sp)})"),
        ("cap_run", TCap("Exec")) => {
            let po = self.ctype(TNamed("ProcessOutput", []))
            self.io_result(ind, dst, t, "Cap_exec_run({arg(0)}, {arg(1)}, {arg(2)})", "(\{ WProc *p_ = (WProc*)r_.ptr; {po} v_ = \{ p_->code, p_->out, p_->err }; free(p_); v_; })")
        },
        ("cap_only", _) => self.set(ind, dst, "Cap_net_only({arg(0)}, {arg(1)})"),
        ("cap_get", _) => {
            self.tls = true
            let ht = self.ctype(TNamed("HttpResponse", []))
            let mt = self.cname(TMap(TStr, TStr))
            self.io_result(ind, dst, t, "Cap_net_get({arg(0)}, {arg(1)})", "(\{ WHttp *h_ = (WHttp*)r_.ptr; {mt}* m_ = {mt}_new(); for (int i_ = 0; i_ < h_->n; i_++) {mt}_put(&m_, h_->names[i_], h_->values[i_]); {ht} v_ = \{ h_->status, m_, h_->body }; free(h_->names); free(h_->values); free(h_); v_; })")
        },
        ("cap_under", _) => self.set(ind, dst, "Cap_fs_under({arg(0)}, {arg(1)})"),
        ("cap_read_only", _) => self.set(ind, dst, "Cap_fs_read_only({arg(0)})"),
        ("cap_read", TCap("Conn")) => self.io_result(ind, dst, t, "Cap_conn_read({arg(0)})", "r_.val"),
        ("cap_write", TCap("Conn")) => self.io_result(ind, dst, t, "Cap_conn_write({arg(0)}, {arg(1)})", "0"),
        ("cap_start_tls", TCap("Conn")) => {
            self.tls = true
            self.io_result(ind, dst, t, "Cap_conn_start_tls({arg(0)}, {arg(1)})", "0")
        },
        ("cap_read_within", TCap("Conn")) => self.io_result(ind, dst, t, "Cap_conn_read_within({arg(0)}, {arg(1)}, {arg(2)})", "r_.val"),
        ("cap_write_within", TCap("Conn")) => self.io_result(ind, dst, t, "Cap_conn_write_within({arg(0)}, {arg(1)}, {arg(2)}, {arg(3)})", "0"),
        ("cap_on", _) => self.io_result(ind, dst, t, "Cap_listen_on({arg(0)}, {arg(1)})", "(WCap*)r_.ptr"),
        ("cap_accept", _) => self.io_result(ind, dst, t, "Cap_accept({arg(0)})", "(WCap*)r_.ptr"),
        ("cap_connect", _) => self.io_result(ind, dst, t, "Cap_net_connect({arg(0)}, {arg(1)})", "(WCap*)r_.ptr"),
        ("cap_connect_tls", _) => {
            self.tls = true
            self.io_result(ind, dst, t, "Cap_net_connect_tls({arg(0)}, {arg(1)})", "(WCap*)r_.ptr")
        },
        ("cap_on_tls", _) => {
            self.tls = true
            self.io_result(ind, dst, t, "Cap_listen_on_tls({arg(0)}, {arg(1)}, {arg(2)}, {arg(3)})", "(WCap*)r_.ptr")
        },
        ("cap_port", _) => self.set(ind, dst, "(int64_t)({arg(0)})->port"),
        ("cap_close", _) => {
            self.line(ind, "Cap_sock_close({arg(0)});")
            self.set(ind, dst, "0")
        },
        ("cap_read", _) => self.io_result(ind, dst, t, "Cap_fs_read({arg(0)}, {arg(1)})", "r_.val"),
        ("cap_read_at", _) => self.io_result(ind, dst, t, "Cap_fs_read_at({arg(0)}, {arg(1)}, {arg(2)}, {arg(3)})", "r_.val"),
        ("cap_write", TCap("Fs")) => self.io_result(ind, dst, t, "Cap_fs_write({arg(0)}, {arg(1)}, {arg(2)})", "0"),
        ("cap_exists", _) => self.set(ind, dst, "Cap_fs_exists({arg(0)}, {arg(1)})"),
        ("cap_full_path", TCap("Fs")) => self.io_result(ind, dst, t, "Cap_fs_full_path({arg(0)}, {arg(1)})", "r_.val"),
        ("cap_is_read_only", TCap("Fs")) => self.set(ind, dst, "Cap_fs_is_read_only({arg(0)})"),
        ("cap_revocable", TCap(_)) => {
            self.line(ind, "\{")
            self.line(ind, "  WCap *k_; WCap *c_ = Cap_revocable({arg(0)}, &k_);")
            let n = self.cname(t)
            self.line(ind, "  {dst} = ({n})\{ c_, k_ };")
            self.line(ind, "}")
        },
        ("cap_revoke", TCap("Revoker")) => {
            self.line(ind, "Cap_revoke({arg(0)});")
            self.set(ind, dst, "0")
        },
        ("cap_is_revoked", TCap("Revoker")) => self.set(ind, dst, "Cap_is_revoked({arg(0)})"),
        _ => panic("cgen: unknown primitive {name} on {show(rt)}"),
    }
}

// `<CName of rt><rest>`, into dst.
fn named_call(mut self: Cg, ind: Str, dst: Str, rt: types.Ty, rest: Str) {
    let n = self.cname(rt)
    self.set(ind, dst, n + rest)
}

// A lookup that may find nothing, into dst of Option type `t`: `decl`
// declares what the lookup fills, `cond` says whether it found `value`.
fn found(mut self: Cg, ind: Str, dst: Str, t: types.Ty, decl: Str, cond: Str, value: Str) {
    self.line(ind, "\{")
    self.line(ind, "  " + decl)
    let none = self.mk_enum(t, 1, [])
    let some = self.mk_enum(t, 0, [value])
    self.line(ind, "  {dst} = {cond} ? {some} : {none};")
    self.line(ind, "}")
}

// ---------- owned locals: unwinding drops them after a panic ----------

// A local that owns memory gets a flag (does it still own its value?) and
// a cleanup that drops it when the flag is set as its scope is left.
// Normal code clears the flag before moving or dropping the value, so the
// cleanup only acts during unwinding. A group is left out: unwinding must
// not free it while its tasks run. It stays on the boundary's list, and
// w_catch_release waits for them first.
fn owns_memory(t: types.Ty) -> Bool {
    match t {
        TGroup(_) => false,
        _ => !is_scalar(t),
    }
}

// A `mut` parameter is never volatile: its pointer never changes, and
// writes through it reach memory before any call that can panic.
fn vol(self: Cg, v: ir.Var) -> Str {
    if intset.mem(self.vols, v.id) && !v.by_ref { " volatile" } else { "" }
}

// Note that owned locals of type `t` need w_dp_<CName>.
fn add_cell_ty(mut self: Cg, t: types.Ty) {
    let known = self.named_in(self.cell_tys, t)
    if !known {
        self.cell_tys.push(t)
    }
}

// A `mut` parameter has no cleanup: the caller's place owns the value.
fn cell_decl(mut self: Cg, ind: Str, v: ir.Var, on: Bool) {
    if !owns_memory(v.ty) || v.by_ref {
        return
    }
    self.add_cell_ty(v.ty)
    self.line(ind, "uint8_t{self.vol(v)} {var(v)}_o = {if on { 1 } else { 0 }};")
    let n = self.cname(v.ty)
    let x = var(v)
    self.line(ind, "WCl {x}_cl __attribute__((cleanup(w_cl_run))) = \{ (void*)&{x}, (uint8_t*)&{x}_o, w_dp_{n} };")
}

fn set_owned(mut self: Cg, ind: Str, v: ir.Var, on: Bool) {
    if owns_memory(v.ty) && !v.by_ref {
        self.line(ind, "{var(v)}_o = {if on { 1 } else { 0 }};")
    }
}

// Clear the flags of the variables an rhs moves out of, before it runs.
fn release_moved(mut self: Cg, ind: Str, xs: List[ir.Atom]) {
    for x in xs {
        match x {
            V(v) => {
                self.set_owned(ind, v, false)
            },
            _ => {},
        }
    }
}

// The value of a pure call kept across a loop (pure.plan): the first time,
// make the call and keep a reference in its slot; after that, take the
// kept value and release what the call would have consumed.
fn kept_or(mut self: Cg, ind: Str, v: ir.Var, r: ir.Rhs) {
    let sl = match self.plan.kept.get(v.id) {
        Some(sl) => sl,
        None => {
            self.release_moved(ind, ir.consumed(r))
            self.rhs_into(ind, var(v), v.ty, r)
            return
        },
    }
    let k = "k{sl.sid}_"
    self.line(ind, "if (__builtin_expect({k}_o, 1)) \{")
    for x in ir.consumed(r) {
        match x {
            V(w) if !is_scalar(w.ty) => {
                self.set_owned(ind + "  ", w, false)
                let n = self.cname(w.ty)
                self.line(ind, "  {n}_drop({var(w)});")
            },
            _ => {},
        }
    }
    let d = self.dup_of(v.ty, k)
    self.line(ind, "  {var(v)} = {d};")
    self.line(ind, "} else \{")
    self.release_moved(ind + "  ", ir.consumed(r))
    self.rhs_into(ind + "  ", var(v), v.ty, r)
    let d2 = self.dup_of(v.ty, var(v))
    self.line(ind, "  {k} = {d2}; {k}_o = 1;")
    self.line(ind, "}")
}

// ---------- statements ----------

fn stmts(mut self: Cg, ind: Str, ss: List[ir.Stmt]) {
    let mut i = 0
    while i < ss.len() {
        match int_chain(ss, i) {
            Some(ch) => {
                self.switch_of(ind, ch)
                // a chain starts with its first test and its `if`
                i = i + 2
            },
            None => {
                self.stmt(ind, ss[i])
                i = i + 1
            },
        }
    }
}

// A long run of tests of one integer against a literal, each failing into
// the next, as a `match` on integer literals lowers to. The chain becomes
// a C `switch`, which compiles to a jump table or a binary search, where
// nested `if`s are a linear scan that also runs into the C compiler's
// nesting limit after a couple of thousand arms. A `break` in an arm would
// leave the switch instead of the loop, so then it stays.
struct IntChain {
    // the integer tested
    x: ir.Var,
    // each literal and what runs when it matches, in order
    arms: List[(Int, List[ir.Stmt])],
    // what runs when none does
    fallback: List[ir.Stmt],
}

fn switch_min() -> Int {
    8
}

fn has_break(ss: List[ir.Stmt]) -> Bool {
    for s in ss {
        let found = match s {
            Break => true,
            If(_, a, b) => has_break(a) || has_break(b),
            Guard(_, d, p) => has_break(d) || has_break(p),
            Scope(_, b) => has_break(b),
            _ => false,
        }
        if found {
            return true
        }
    }
    false
}

// The flag, the integer and the literal of a test `flag = x == literal`.
fn int_test(s: ir.Stmt) -> Option[(ir.Var, ir.Var, Int)] {
    match s {
        Let(t, PatTest(V(x), ty, p)) => match ty {
            TInt | TUInt(_) => match p.desc {
                PInt(k) => Some((t, x, k)),
                _ => None,
            },
            _ => None,
        },
        _ => None,
    }
}

// The test at `ss[i]` and the `if` on it, when they start a chain.
fn int_chain(ss: List[ir.Stmt], i: Int) -> Option[IntChain] {
    if i + 1 >= ss.len() {
        return None
    }
    let (t0, x, k0) = match int_test(ss[i]) {
        Some(found) => found,
        None => {
            return None
        },
    }
    let (a0, b0) = match ss[i + 1] {
        If(V(c), a, b) if c.id == t0.id => (a, b),
        _ => {
            return None
        },
    }
    let mut arms = [(k0, a0)]
    let mut tail = b0
    while true {
        // what comes around the next test writes no C: a development
        // build's line mark, or the end of a scalar such as the last
        // test's flag
        let rest = tail.filter(|s| !is_quiet(s))
        if rest.len() != 2 {
            break
        }
        let next = match int_test(rest[0]) {
            Some((t, x2, k)) if x2.id == x.id => match rest[1] {
                If(V(c), a, b) if c.id == t.id => Some((k, a, b)),
                _ => None,
            },
            _ => None,
        }
        match next {
            Some((k, a, b)) => {
                arms.push((k, a))
                tail = b
            },
            None => {
                break
            },
        }
    }
    if arms.len() < switch_min() {
        return None
    }
    // a repeated literal (its later arm never runs) would be a repeated C
    // case: such a match stays as it is
    let ks = arms.map(|arm| arm.0).sort()
    for n in 1..<ks.len() {
        if ks[n] == ks[n - 1] {
            return None
        }
    }
    if has_break(tail) {
        return None
    }
    for arm in arms {
        if has_break(arm.1) {
            return None
        }
    }
    Some(IntChain { x, arms, fallback: tail })
}

fn is_quiet(s: ir.Stmt) -> Bool {
    match s {
        Line(_) => true,
        Drop(v) => is_scalar(v.ty),
        _ => false,
    }
}

fn switch_of(mut self: Cg, ind: Str, ch: IntChain) {
    self.line(ind, "switch ({var(ch.x)}) \{")
    for arm in ch.arms {
        self.line(ind, "case {int_lit(arm.0)}: \{")
        self.stmts(ind + "  ", arm.1)
        self.line(ind, "  break;")
        self.line(ind, "}")
    }
    self.line(ind, "default: \{")
    self.stmts(ind + "  ", ch.fallback)
    self.line(ind, "}")
    self.line(ind, "}")
}

// The loops in `ss`, as the planner counts them: through `if` and loops.
fn count_loops(ss: List[ir.Stmt]) -> Int {
    ss.sum_by(|s| match s {
        Loop(body) => 1 + count_loops(body),
        If(_, a, b) => count_loops(a) + count_loops(b),
        _ => 0,
    })
}

// The body of loop number `idx`, written at `ind`: loops inside it are
// numbered from idx + 1 each time it is written.
fn loop_body(mut self: Cg, ind: Str, idx: Int, body: List[ir.Stmt]) {
    self.loops = idx + 1
    // a cancellation checkpoint first, on every iteration (W_CHECK in the
    // runtime), so a cancelled task stops in code that never waits
    self.line(ind, "W_CHECK();")
    self.stmts(ind, body)
}

fn stmt(mut self: Cg, ind: Str, s: ir.Stmt) {
    match s {
        Let(v, r) => {
            let ct = self.ctype(v.ty)
            self.line(ind, "{ct}{self.vol(v)} {var(v)};")
            self.cell_decl(ind, v, false)
            self.kept_or(ind, v, r)
            self.set_owned(ind, v, true)
        },
        Decl(v) => {
            let ct = self.ctype(v.ty)
            self.line(ind, "{ct}{self.vol(v)} {var(v)};")
            self.cell_decl(ind, v, false)
        },
        Init(v, r) => {
            self.kept_or(ind, v, r)
            self.set_owned(ind, v, true)
        },
        Set(v, r, release) => {
            self.release_moved(ind, ir.consumed(r))
            self.line(ind, "\{")
            let ct = self.ctype(v.ty)
            self.line(ind, "  {ct} n_;")
            self.rhs_into(ind + "  ", "n_", v.ty, r)
            if release && !is_scalar(v.ty) {
                let n = self.cname(v.ty)
                self.line(ind, "  {n}_drop({var(v)});")
            }
            self.line(ind, "  {var(v)} = n_;")
            self.line(ind, "}")
            self.set_owned(ind, v, true)
        },
        Mutate(v, steps, m) => self.mutate(ind, v, steps, m),
        If(cond, a, b) => {
            let ca = self.atom(cond)
            self.line(ind, "if ({ca}) \{")
            self.stmts(ind + "  ", a)
            if !b.is_empty() {
                self.line(ind, "} else \{")
                self.stmts(ind + "  ", b)
            }
            self.line(ind, "}")
        },
        Loop(body) => {
            let idx = self.loops
            match self.plan.at_loop.get(idx) {
                Some(slots) if !self.slotted.contains(idx) => {
                    // Slots for the pure calls kept across this loop:
                    // filled the first time each call runs, released when
                    // the loop is left by any way.
                    self.slotted = [idx] + self.slotted
                    self.line(ind, "\{")
                    for sl in slots {
                        let k = "k{sl.sid}_"
                        let ct = self.ctype(sl.ty)
                        self.line(ind, "  {ct} {k}; uint8_t {k}_o = 0;")
                        if owns_memory(sl.ty) {
                            self.add_cell_ty(sl.ty)
                            let n = self.cname(sl.ty)
                            self.line(ind, "  WCl {k}_cl __attribute__((cleanup(w_cl_run))) = \{ (void*)&{k}, (uint8_t*)&{k}_o, w_dp_{n} };")
                        }
                    }
                    self.stmt(ind + "  ", s)
                    self.slotted = self.slotted.skip(1)
                    self.line(ind, "}")
                },
                _ => self.plain_loop(ind, idx, body),
            }
        },
        Break => self.line(ind, "break;"),
        Continue => self.line(ind, "continue;"),
        Return(x) => {
            self.release_moved(ind, [x])
            let a = self.atom(x)
            self.line(ind, "return {a};")
        },
        Drop(v) => {
            if is_scalar(v.ty) {
                return
            }
            self.set_owned(ind, v, false)
            let n = self.cname(v.ty)
            self.line(ind, "{n}_drop({var(v)});")
        },
        Guard(n, handler, body) => {
            // A defer. The rest of its block runs under a panic boundary;
            // normal exits pop it (GuardEnd) and run the deferred body
            // themselves. A panic or a cancellation lands here (the guard
            // cleanup is declared after this frame's other locals, so it
            // jumps back before they are touched), runs the deferred body,
            // and passes the panic or the cancellation on. What the rest
            // allocated stays with the enclosing boundary: an outer
            // variable may now point at it.
            let g = "g{n}_"
            self.line(ind, "\{")
            self.line(ind, "  WCatch {g};")
            self.line(ind, "  w_catch_init(&{g});")
            self.line(ind, "  WCatch **{g}slot = w_catch_slot();")
            self.line(ind, "  if (_setjmp({g}.jb) == 0) \{")
            self.line(ind, "    WCatch *{g}land __attribute__((cleanup(w_catch_land))) = &{g};")
            self.line(ind, "    if ({g}slot) *{g}slot = &{g};")
            self.stmts(ind + "    ", body)
            self.line(ind, "  } else \{")
            self.line(ind, "    w_catch_end(&{g});")
            self.line(ind, "    int cancel_ = {g}.cancel;")
            self.line(ind, "    char m_[1024] = \"\", w_[512] = \"\";")
            self.line(ind, "    if (!cancel_) \{ snprintf(m_, sizeof m_, \"%s\", {g}.msg); snprintf(w_, sizeof w_, \"%s\", {g}.where); free({g}.msg); free({g}.where); }")
            self.stmts(ind + "    ", handler)
            self.line(ind, "    if (cancel_) w_cancel_unwind();")
            self.line(ind, "    w_panic_c(m_, w_);")
            self.line(ind, "  }")
            self.line(ind, "}")
        },
        Scope(g, body) => {
            // A group body under its deadline: the deadline cancels it at
            // its next wait, like a task, and it unwinds to this boundary;
            // then the join after it goes on. A panic, or a cancellation
            // from further out, passes on (w_scope_land).
            self.scopes = self.scopes + 1
            let b = "s{self.scopes}_"
            let ga = self.atom(g)
            self.line(ind, "\{")
            self.line(ind, "  WScope {b}sc; w_scope_push(&{b}sc, {ga});")
            self.line(ind, "  WCatch {b};")
            self.line(ind, "  w_catch_init(&{b});")
            self.line(ind, "  WCatch **{b}slot = w_catch_slot();")
            self.line(ind, "  if (_setjmp({b}.jb) == 0) \{")
            self.line(ind, "    WCatch *{b}land __attribute__((cleanup(w_catch_land))) = &{b};")
            self.line(ind, "    *{b}slot = &{b};")
            self.stmts(ind + "    ", body)
            self.line(ind, "    *{b}slot = {b}.prev;")
            self.line(ind, "    w_catch_end(&{b});")
            self.line(ind, "  } else w_scope_land(&{b}, &{b}sc);")
            self.line(ind, "  w_scope_pop(&{b}sc);")
            self.line(ind, "}")
        },
        GuardEnd(n) => {
            let g = "g{n}_"
            self.line(ind, "if ({g}slot) *{g}slot = {g}.prev;")
            self.line(ind, "w_catch_end(&{g});")
        },
        Line(sp) => self.put(self.line_directive(sp) + "\n"),
    }
}

// `#line N "file"` for where `sp` starts, so a debugger, the sanitizers
// and crash traces show the Limen line.
fn line_directive(self: Cg, sp: ast.Span) -> Str {
    let (l, _) = self.line_col(sp.file, sp.lo)
    let path = diag.path_of(self.files, sp.file).replace("\\", "\\\\").replace("\"", "\\\"")
    "#line {l} \"{path}\""
}

// A `#line` counts on from itself: the C line after it is that line, the
// next one the line after. A statement's C takes several lines, so every
// line up to the next mark gets the mark again, and stays on the Limen
// line. A function's closing `\}` (alone at the start of a line) gets
// `#line 1 "<generated>"` instead, so the code the compiler adds between
// functions is not taken for Limen lines.
fn pin_lines(text: Str) -> Str {
    if !text.contains("#line ") {
        return text
    }
    let mut out: List[Str] = []
    let mut cur: Option[Str] = None
    for l in text.split("\n") {
        if l.starts_with("#line ") {
            cur = Some(l)
        } else {
            match cur {
                Some(_) if l == "\}" => {
                    out.push("#line 1 \"<generated>\"")
                    out.push(l)
                    cur = None
                },
                Some(d) => {
                    out.push(d)
                    out.push(l)
                },
                None => out.push(l),
            }
        }
    }
    out.join("\n")
}

// A pointer to the place `v` and `steps`, made unique on the way (the
// checks a loop hoisted are skipped): the C names `prefix`0_, `prefix`1_
// and so on, one per step. Returns the last and the place's type.
// The cast drops `volatile` from a variable a `defer` or guard needs
// volatile (see Cg.vols). The callee, a `mut` parameter or a runtime
// function such as List_push, takes a plain pointer, and giving it a
// volatile one would change every such function. It is safe in practice:
// the variable's address is taken, so it lives in memory; a write through
// the pointer reaches memory before any call that can panic, since that
// call might read it; and after a longjmp the caller reads the variable
// through its volatile name, from memory.
fn place_ptr(mut self: Cg, ind: Str, prefix: Str, v: ir.Var, steps: List[ir.Step]) -> (Str, types.Ty) {
    let vt = self.ctype(v.ty)
    self.line(ind, "  {vt}* {prefix}0_ = ({vt}*)&{var(v)};")
    let mut p = "{prefix}0_"
    let mut t = v.ty
    for (i, step) in steps.with_index() {
        let q = "{prefix}{i + 1}_"
        match step {
            PField(k) => {
                let ft = self.fields_of(t)[k].1
                let ct = self.ctype(ft)
                self.line(ind, "  {ct}* {q} = &({p}->f{k});")
                t = ft
            },
            PIndex(ia, sp) => match t {
                TList(el) => {
                    if !(i == 0 && self.uniq.contains(v.id)) {
                        let n = self.cname(t)
                        self.line(ind, "  {n}_unique({p});")
                    }
                    let proven = i == 0 && match ia {
                        V(iv) => self.inrange.contains((v.id, iv.id)),
                        _ => false,
                    }
                    let wh = self.where(sp)
                    let a = self.atom(ia)
                    let n = self.cname(t)
                    let ct = self.ctype(el)
                    if proven { self.line(ind, "  {ct}* {q} = &(*{p})->data[{a}];") } else { self.line(ind, "  {ct}* {q} = {n}_at(*{p}, {a}, {wh});") }
                    t = el
                },
                TArray(el, TLen(n)) => {
                    let wh = self.where(sp)
                    let a = self.atom(ia)
                    let ct = self.ctype(el)
                    self.line(ind, "  {ct}* {q} = &({p}->a[w_idx({a}, {n}, {wh})]);")
                    t = el
                },
                _ => panic("mutate index"),
            },
            PKey(k, sp) => match t {
                TMap(_, vt2) => {
                    let n = self.cname(t)
                    let wh = self.where(sp)
                    self.line(ind, "  {n}_unique({p});")
                    let a = self.atom(k)
                    let ct = self.ctype(vt2)
                    self.line(ind, "  {ct}* {q} = {n}_slot(*{p}, {a}, {wh});")
                    t = vt2
                },
                _ => panic("mutate key"),
            },
            PIndexU(_) => panic("mutate through unchecked index"),
        }
        p = q
    }
    (p, t)
}

fn mutate(mut self: Cg, ind: Str, v: ir.Var, steps: List[ir.Step], m: ir.Mutation) {
    self.release_moved(ind, ir.mut_atoms(m))
    self.line(ind, "\{")
    let (p, t) = self.place_ptr(ind, "p", v, steps)
    match m {
        MSet(x) => {
            if !is_scalar(t) {
                let n = self.cname(t)
                self.line(ind, "  {n}_drop(*{p});")
            }
            let a = self.atom(x)
            self.line(ind, "  *{p} = {a};")
        },
        MPush(x) => {
            let unchecked = steps.is_empty() && self.uniq.contains(v.id)
            let a = self.atom(x)
            let n = self.cname(t)
            self.line(ind, "  {n}_push{if unchecked { "_u" } else { "" }}({p}, {a});")
        },
        MPut(k, x) => {
            let xa = self.atom(x)
            let ka = self.atom(k)
            let n = self.cname(t)
            self.line(ind, "  {n}_put({p}, {ka}, {xa});")
        },
        MRemove(k) => {
            let ka = self.atom(k)
            let n = self.cname(t)
            self.line(ind, "  {n}_remove({p}, {ka});")
        },
    }
    self.line(ind, "}")
}

// A loop without slots, as C: the lists it keeps unique made unique once
// before it, then a fill in one go, a versioned loop, or a plain one.
fn plain_loop(mut self: Cg, ind: Str, idx: Int, body: List[ir.Stmt]) {
    // A list that the loop mutates but never shares (no retain, no move,
    // no reassignment) stays unique: make it unique once, here, and skip
    // the copy-on-write check on every write inside the loop.
    let saved = self.uniq
    let hoisted = hoist.mutated_lists(body).filter(|v| !saved.contains(v.id) && !hoist.escapes(v, body))
    for v in hoisted {
        let n = self.cname(v.ty)
        self.line(ind, "{n}_unique(&{var(v)});")
    }
    self.uniq = hoisted.map(|v| v.id) + saved
    match hoist.fill_loop(body) {
        Some(f) => {
            // Fill in one go: reserve once, then a plain store loop the C
            // compiler vectorises.
            let ln = self.cname(f.v.ty)
            let el = match f.v.ty {
                TList(e) => e,
                _ => TUnit,
            }
            self.line(ind, "\{")
            self.line(ind, "  int64_t cnt_;")
            let na = self.atom(f.n)
            self.line(ind, "  if (!__builtin_sub_overflow({na}, {var(f.i)}, &cnt_) && cnt_ < INT64_MAX - 1) \{")
            self.line(ind, "    cnt_ += {if f.inclusive { 1 } else { 0 }};")
            self.line(ind, "    int64_t want_;")
            self.line(ind, "    if (cnt_ > 0 && __builtin_add_overflow({var(f.v)}->len, cnt_, &want_)) w_oom();")
            self.line(ind, "    if (cnt_ > 0) \{")
            self.line(ind, "      {ln}_reserve(&{var(f.v)}, want_);")
            let ct = self.ctype(el)
            self.line(ind, "      {ct}* d_ = {var(f.v)}->data + {var(f.v)}->len;")
            let xa = self.atom(f.x)
            self.line(ind, "      for (int64_t k_ = 0; k_ < cnt_; k_++) d_[k_] = {xa};")
            self.line(ind, "      {var(f.v)}->len += cnt_; {var(f.i)} += cnt_;")
            self.line(ind, "    }")
            self.line(ind, "  } else \{")
            self.line(ind, "  for (;;) \{")
            self.loop_body(ind + "    ", idx, body)
            self.line(ind, "  }")
            self.line(ind, "  }")
            self.line(ind, "}")
        },
        None => match hoist.versionable(body) {
            Some(vs) => {
                // Loop versioning: one range check up front, no bounds
                // checks inside.
                let step = self.atom(vs.step)
                let n = self.atom(vs.n)
                let conds = ["{var(vs.m)} >= 0", "{step} >= 0", "{n} <= INT64_MAX - {step}"] + vs.lists.map(|v| "{n} {if vs.inclusive { "<" } else { "<=" }} {var(v)}->len")
                self.line(ind, "if ({conds.join(" && ")}) \{")
                let saved_r = self.inrange
                self.inrange = vs.lists.map(|v| (v.id, vs.m.id)) + self.inrange
                self.line(ind, "  for (;;) \{")
                self.loop_body(ind + "    ", idx, body)
                self.line(ind, "  }")
                self.inrange = saved_r
                self.line(ind, "} else \{")
                self.line(ind, "  for (;;) \{")
                self.loop_body(ind + "    ", idx, body)
                self.line(ind, "  }")
                self.line(ind, "}")
            },
            None => {
                self.line(ind, "for (;;) \{")
                self.loop_body(ind + "  ", idx, body)
                self.line(ind, "}")
            },
        },
    }
    self.loops = idx + 1 + count_loops(body)
    self.uniq = saved
}

// ---------- functions ----------

fn signature(mut self: Cg, f: ir.Fn) -> Str {
    let mut ps: List[Str] = if f.is_closure { ["WClo* self_"] } else { [] }
    for v in f.params {
        let ct = self.ctype(v.ty)
        ps.push(if v.by_ref { "{ct}* {var_name(v)}" } else { "{ct}{self.vol(v)} {var(v)}" })
    }
    let rt = self.ctype(f.ret)
    "static {rt} {f.fname}({if ps.is_empty() { "void" } else { ps.join(", ") }})"
}

fn atom_ids(xs: List[ir.Atom]) -> List[Int] {
    xs.flat_map(|a| match ir.atom_var(a) {
        Some(v) => [v.id],
        None => [],
    })
}

// The variables declared in statements, and those they use.
struct Uses {
    declared: List[Int],
    used: List[Int],
}

fn no_uses() -> Uses {
    Uses { declared: [], used: [] }
}

fn join_uses(a: Uses, b: Uses) -> Uses {
    Uses { declared: intset.union(a.declared, b.declared), used: intset.union(a.used, b.used) }
}

fn scan(ss: List[ir.Stmt]) -> Uses {
    ss.fold(no_uses(), |acc, s| join_uses(acc, scan1(s)))
}

fn rhs_ids(r: ir.Rhs) -> List[Int] {
    atom_ids(ir.consumed(r) + ir.borrowed(r))
}

fn scan1(s: ir.Stmt) -> Uses {
    match s {
        Let(v, r) => Uses { declared: [v.id], used: intset.of_list(rhs_ids(r)) },
        Decl(v) => Uses { declared: [v.id], used: [] },
        Init(v, r) | Set(v, r, _) => Uses { declared: [], used: intset.add(intset.of_list(rhs_ids(r)), v.id) },
        Mutate(v, steps, m) => Uses { declared: [], used: intset.add(intset.of_list(atom_ids(ir.step_atoms(steps) + ir.mut_atoms(m))), v.id) },
        If(cnd, a, b) => {
            let u = join_uses(scan(a), scan(b))
            Uses { declared: u.declared, used: intset.union(intset.of_list(atom_ids([cnd])), u.used) }
        },
        Loop(b) => scan(b),
        Return(a) => Uses { declared: [], used: intset.of_list(atom_ids([a])) },
        Drop(v) => Uses { declared: [], used: [v.id] },
        Guard(_, h, b) => join_uses(scan(h), scan(b)),
        Scope(_, b) => scan(b),
        Break | Continue | GuardEnd(_) | Line(_) => no_uses(),
    }
}

// The variables a guard needs volatile (see Cg.vols): those its deferred
// body uses, and those declared outside its guarded statements that those
// statements use (a write there changes a value or an owned flag that the
// frame's cleanups read after the longjmp). Variables declared inside the
// guarded statements are cleaned up by unwinding itself, before the jump.
fn guard_vols(body: List[ir.Stmt]) -> List[Int] {
    vols_in([], body)
}

fn vols_in(acc: List[Int], ss: List[ir.Stmt]) -> List[Int] {
    ss.fold(acc, |acc, s| match s {
        Guard(_, h, b) => {
            let hu = scan(h).used
            let bs = scan(b)
            vols_in(vols_in(intset.union(acc, intset.union(hu, intset.diff(bs.used, bs.declared))), h), b)
        },
        Scope(_, b) => {
            // the code after a stopped body reads what the body wrote
            let bs = scan(b)
            vols_in(intset.union(acc, intset.diff(bs.used, bs.declared)), b)
        },
        If(_, a, b) => vols_in(vols_in(acc, a), b),
        Loop(b) => vols_in(acc, b),
        _ => acc,
    })
}

fn fn_body(mut self: Cg, f: ir.Fn) {
    self.vols = guard_vols(f.body)
    (self.plan, self.slot) = pure.plan(self.pure, f, self.slot)
    self.loops = 0
    self.slotted = []
    let sig = self.signature(f)
    self.put(sig + " \{\n")
    // parameters are owned by the function (`mut` ones by the caller)
    for v in f.params {
        self.cell_decl("  ", v, true)
    }
    if !f.captures.is_empty() {
        self.put("  struct Env_{f.fname}* env_ = (struct Env_{f.fname}*)self_;\n")
        for (i, v) in f.captures.with_index() {
            let d = self.dup_of(v.ty, "env_->c{i}")
            let ct = self.ctype(v.ty)
            self.put("  {ct}{self.vol(v)} {var(v)} = {d};\n")
            self.cell_decl("  ", v, true)
        }
    }
    match self.prof_ids.get(f.fname) {
        Some(k) => {
            self.put("  W_PROF({k});\n")
        },
        None => {},
    }
    // a checkpoint on entry: deep recursion stops too
    self.put("  W_CHECK();\n")
    self.stmts("  ", f.body)
    self.put("  w_unreachable();\n}\n\n")
    self.vols = []
    self.plan = pure.no_plan()
}

// ---------- type definitions ----------

// The named types and arrays a type holds by value (lists, strings and
// closures are pointers).
fn by_value(t: types.Ty) -> List[types.Ty] {
    match t {
        TNamed(..) | TArray(..) => [t],
        _ => [],
    }
}

fn contents(self: Cg, t: types.Ty) -> List[types.Ty] {
    match t {
        TNamed(..) => self.parts(t).flat_map(by_value),
        TArray(e, _) => by_value(e),
        _ => [],
    }
}

// Whether `t` reaches itself through what it holds by value.
fn reaches_self(self: Cg, t: types.Ty) -> Bool {
    let mut seen: List[types.Ty] = []
    let mut todo = [t]
    // depth first, as the OCaml search goes
    while !todo.is_empty() {
        let u = todo[0]
        todo = todo.skip(1)
        let mut next: List[types.Ty] = []
        for w in self.contents(u) {
            if w == t {
                return true
            }
            if !seen.contains(w) {
                seen.push(w)
                next.push(w)
            }
        }
        todo = next + todo
    }
    false
}

fn compute_boxed(mut self: Cg) {
    let mut boxed: List[Str] = []
    for t in self.types {
        match t {
            TNamed(..) if self.is_enum(t) && self.reaches_self(t) => {
                let n = self.cname(t)
                boxed.push(n)
            },
            _ => {},
        }
    }
    self.boxed = boxed
}

fn is_boxed(self: Cg, t: types.Ty) -> Bool {
    match self.names.get(show(t)) {
        Some(n) => self.boxed.contains(n),
        None => false,
    }
}

// The named types and arrays, ordered so that every by-value dependency
// is defined first.
fn topo(self: Cg) -> List[types.Ty] {
    let mut done: List[types.Ty] = []
    let mut order: List[types.Ty] = []
    for t in self.types {
        match t {
            TNamed(..) | TArray(..) => {
                self.visit(t, [], mut done, mut order)
            },
            _ => {},
        }
    }
    order
}

fn visit(self: Cg, t: types.Ty, visiting: List[types.Ty], mut done: List[types.Ty], mut order: List[types.Ty]) {
    if done.contains(t) {
        return
    }
    if visiting.contains(t) {
        panic("recursive type needs an enum to break the cycle: " + show(t))
    }
    for u in self.contents(t) {
        if !self.is_boxed(u) {
            self.visit(u, visiting + [t], mut done, mut order)
        }
    }
    done.push(t)
    order.push(t)
}

fn list_depth(t: types.Ty) -> Int {
    match t {
        TList(e) => 1 + list_depth(e),
        _ => 0,
    }
}

fn acc_of(boxed: Bool) -> Str {
    if boxed { "->" } else { "." }
}

// The C definitions of the program's composite types and their
// functions, in pieces.
fn type_defs(mut self: Cg) -> List[Str] {
    self.compute_boxed()
    let mut out: List[Str] = []
    let lists = self.types.filter(|t| match t {
        TList(_) => true,
        _ => false,
    })
    let maps = self.types.filter(|t| match t {
        TMap(..) => true,
        _ => false,
    })
    let named = self.topo()
    // forward typedefs
    for t in lists + named {
        let n = self.cname(t)
        out.push(match t {
            TList(_) => "typedef struct {n} {n};",
            _ => if self.is_boxed(t) { "typedef struct {n}_box* {n};" } else { "typedef struct {n} {n};" },
        })
    }
    for t in maps {
        let n = self.cname(t)
        out.push("typedef struct {n} {n};")
    }
    for t in lists {
        match t {
            TList(e) => {
                let et = self.ctype(e)
                let n = self.cname(t)
                out.push("LIMEN_LIST_STRUCT({n}, {et})")
            },
            _ => {},
        }
    }
    for t in maps {
        match t {
            TMap(k, v) => {
                let vt = self.ctype(v)
                let kt = self.ctype(k)
                let n = self.cname(t)
                out.push("LIMEN_MAP_STRUCT({n}, {kt}, {vt})")
            },
            _ => {},
        }
    }
    // map prototypes: lists and structs of maps refer to them
    for t in maps {
        let n = self.cname(t)
        out.push("static {n}* {n}_dup({n}* m);\nstatic void {n}_drop({n}* m);\nstatic void {n}_share({n}* m);\nstatic bool {n}_eq({n}* a, {n}* b);\nstatic void {n}_show(WBuf* b, {n}* m, bool top);")
    }
    // struct bodies
    for t in named {
        let n = self.cname(t)
        match t {
            TArray(e, TLen(k)) => {
                let et = self.ctype(e)
                out.push("struct {n} \{ {et} a[{k.max(1)}]; };")
            },
            _ => if self.is_enum(t) {
                let vs = self.variants_of(t)
                let boxed = self.is_boxed(t)
                out.push("struct {n}{if boxed { "_box" } else { "" }} \{{if boxed { " int64_t rc;" } else { "" }} int32_t tag;")
                if vs.any(|v| !v.1.is_empty()) {
                    out.push("  union \{")
                    for (k, v) in vs.with_index() {
                        if !v.1.is_empty() {
                            let mut fs: List[Str] = []
                            for (i, pt) in v.1.with_index() {
                                let ct = self.ctype(pt)
                                fs.push("{ct} f{i};")
                            }
                            out.push("    struct \{ {fs.join(" ")} } v{k};")
                        }
                    }
                    out.push("  } u;")
                }
                out.push("};")
            } else {
                let mut fs: List[Str] = []
                for (i, f) in self.fields_of(t).with_index() {
                    let ct = self.ctype(f.1)
                    fs.push("{ct} f{i};")
                }
                out.push("struct {n} \{ {if fs.is_empty() { "char empty_;" } else { fs.join(" ") }} };")
            },
        }
    }
    // prototypes
    for t in named {
        let n = self.cname(t)
        let ct = self.ctype(t)
        out.push("static {ct} {n}_dup({ct} v);")
        out.push("static void {n}_drop({ct} v);")
        out.push("static bool {n}_eq({ct} a, {ct} b);")
        out.push("static void {n}_show(WBuf* b, {ct} v, bool top);")
        out.push("static void {n}_share({ct} v);")
        if self.is_boxed(t) {
            out.push("static void {n}_kids(void* o);")
        }
    }
    // enum constructors and accessors
    for t in named {
        if !self.is_enum(t) {
            continue
        }
        let n = self.cname(t)
        let boxed = self.is_boxed(t)
        let acc = acc_of(boxed)
        out.push("#define {n}_tag(v) ((v){acc}tag)")
        for (k, v) in self.variants_of(t).with_index() {
            for (i, _) in v.1.with_index() {
                out.push("#define {n}_p_{k}_{i}(v) ((v){acc}u.v{k}.f{i})")
            }
            let mut params: List[Str] = []
            for (i, pt) in v.1.with_index() {
                let ct = self.ctype(pt)
                params.push("{ct} a{i}")
            }
            out.push("static inline {n} {n}_mk_{k}({if params.is_empty() { "void" } else { params.join(", ") }}) \{")
            out.push(if boxed { "  {n} r = ({n})w_alloc_k(sizeof(struct {n}_box), WK_PLAIN); r->rc = 1; w_set_kids(r, {n}_kids);" } else { "  {n} r;" })
            out.push("  r{acc}tag = {k};")
            for (i, _) in v.1.with_index() {
                out.push("  r{acc}u.v{k}.f{i} = a{i};")
            }
            out.push("  return r;")
            out.push("}")
        }
    }
    // list functions, inner lists first
    for t in lists.sort_by(list_depth) {
        match t {
            TList(e) => {
                let en = self.cname(e)
                let et = self.ctype(e)
                let n = self.cname(t)
                out.push("LIMEN_LIST_FUNCS({n}, {et}, {en})")
                if e == TFloat {
                    out.push("LIMEN_LIST_SORT({n}, double, Float)")
                }
            },
            _ => {},
        }
    }
    for t in maps {
        match t {
            TMap(k, _) => {
                let _ = self.hash_prefix(k)
            },
            _ => {},
        }
    }
    for t in self.hash_tys {
        let ct = self.ctype(t)
        let n = self.cname(t)
        out.push("static uint64_t {n}_hash({ct} v);")
    }
    for t in maps {
        match t {
            TMap(k, v) => {
                let vn = self.cname(v)
                let vt = self.ctype(v)
                let kn = self.cname(k)
                let kt = self.ctype(k)
                let n = self.cname(t)
                out.push("LIMEN_MAP_FUNCS({n}, {kt}, {kn}, {vt}, {vn})")
            },
            _ => {},
        }
    }
    // dup/drop/eq/show definitions
    for t in named {
        let ls = self.value_fns(t)
        out = out + ls
    }
    let ls = self.cmp_defs()
    out + ls
}

// The dup, drop, share, eq and show functions of a named type or array.
fn value_fns(mut self: Cg, t: types.Ty) -> List[Str] {
    let n = self.cname(t)
    let ct = self.ctype(t)
    let mut out: List[Str] = []
    match t {
        TArray(e, TLen(k)) => {
            let en = self.cname(e)
            let each = |f: Str| if is_scalar(e) { [] } else { ["  for (int64_t i = 0; i < {k}; i++) {f};"] }
            out = out + ["static {ct} {n}_dup({ct} v) \{"] + each("v.a[i] = {en}_dup(v.a[i])") + ["  return v;\n}"]
            out = out + ["static void {n}_drop({ct} v) \{", "  (void)v;"] + each("{en}_drop(v.a[i])") + ["}"]
            out = out + ["static void {n}_share({ct} v) \{", "  (void)v;"] + each("{en}_share(v.a[i])") + ["}"]
            let eq = self.binop(Eq, e, "a.a[i]", "b.a[i]", diag.nowhere())
            out = out + ["static bool {n}_eq({ct} a, {ct} b) \{", "  for (int64_t i = 0; i < {k}; i++) if (!({eq})) return false;", "  (void)a; (void)b; return true;\n}"]
            out = out + ["static void {n}_show(WBuf* b, {ct} v, bool top) \{", "  (void)top; buf_puts(b, \"[\");", "  for (int64_t i = 0; i < {k}; i++) \{ if (i) buf_puts(b, \", \"); {en}_show(b, v.a[i], false); }", "  buf_puts(b, \"]\");\n}"]
        },
        _ => if self.is_enum(t) {
            let vs = self.variants_of(t)
            let boxed = self.is_boxed(t)
            let acc = acc_of(boxed)
            // one `case` per variant, with what `f` writes for each of its
            // payloads
            out.push("static {ct} {n}_dup({ct} v) \{")
            if boxed {
                out.push("  w_rc_inc(&v->rc);")
            } else {
                out.push("  switch (v.tag) \{")
                for (k, v) in vs.with_index() {
                    out.push("    case {k}: \{")
                    for (i, pt) in v.1.with_index() {
                        if !is_scalar(pt) {
                            let pn = self.cname(pt)
                            out.push("      v.u.v{k}.f{i} = {pn}_dup(v.u.v{k}.f{i});")
                        }
                    }
                    out.push("      break; }")
                }
                out.push("  }")
            }
            out.push("  return v;\n}")
            if boxed {
                out = out + ["static void {n}_kids(void* o) \{", "  {n} v = ({n})o;", "  switch (v->tag) \{"]
                for (k, v) in vs.with_index() {
                    out.push("    case {k}: \{")
                    for (i, pt) in v.1.with_index() {
                        if !is_scalar(pt) {
                            let pn = self.cname(pt)
                            out.push("      {pn}_drop(v->u.v{k}.f{i});")
                        }
                    }
                    out.push("      break; }")
                }
                out = out + ["  }", "}"]
            }
            out.push("static void {n}_drop({ct} v) \{")
            if boxed {
                // through w_release, which frees a long chain without recursing
                out.push("  if (!w_rc_dec(&v->rc)) return;")
                out.push("  w_release(v);")
            } else {
                out.push("  switch (v{acc}tag) \{")
                for (k, v) in vs.with_index() {
                    out.push("    case {k}: \{")
                    for (i, pt) in v.1.with_index() {
                        if !is_scalar(pt) {
                            let pn = self.cname(pt)
                            out.push("      {pn}_drop(v{acc}u.v{k}.f{i});")
                        }
                    }
                    out.push("      break; }")
                }
                out.push("  }")
            }
            out.push("}")
            // A boxed enum's share, == and show go through w_share, w_eq and
            // w_show, which recurse only so deep and keep the rest on a stack
            if boxed {
                out = out + ["static void {n}_share_kids(void* o) \{", "  {n} v = ({n})o;"]
            } else {
                out.push("static void {n}_share({ct} v) \{")
            }
            out.push("  switch (v{acc}tag) \{")
            for (k, v) in vs.with_index() {
                out.push("    case {k}: \{")
                for (i, pt) in v.1.with_index() {
                    if !is_scalar(pt) {
                        let pn = self.cname(pt)
                        out.push("      {pn}_share(v{acc}u.v{k}.f{i});")
                    }
                }
                out.push("      break; }")
            }
            out = out + ["  }", "}"]
            if boxed {
                out = out + ["static void {n}_share({ct} v) \{", "  if (w_rc_share(&v->rc)) w_share(v, {n}_share_kids);", "}"]
                out = out + ["static bool {n}_eq_kids(void* pa, void* pb, int64_t i) \{", "  {n} a = ({n})pa, b = ({n})pb;", "  (void)i;"]
            } else {
                out.push("static bool {n}_eq({ct} a, {ct} b) \{")
            }
            out.push("  if (a{acc}tag != b{acc}tag) return false;")
            out.push("  switch (a{acc}tag) \{")
            for (k, v) in vs.with_index() {
                out.push("    case {k}: \{")
                for (i, pt) in v.1.with_index() {
                    let eq = self.binop(Eq, pt, "a{acc}u.v{k}.f{i}", "b{acc}u.v{k}.f{i}", diag.nowhere())
                    out.push("      if (!({eq})) return false;")
                }
                out.push("      break; }")
            }
            out = out + ["  }", "  return true;\n}"]
            if boxed {
                out = out + ["static bool {n}_eq({ct} a, {ct} b) \{", "  return w_eq({n}_eq_kids, a, b, 0);", "}"]
                out = out + ["static void {n}_show_kids(WBuf* b, void* o, int64_t i) \{", "  {n} v = ({n})o;", "  (void)i;"]
            } else {
                out = out + ["static void {n}_show(WBuf* b, {ct} v, bool top) \{", "  (void)top;"]
            }
            out.push("  switch (v{acc}tag) \{")
            for (k, v) in vs.with_index() {
                out.push("    case {k}:")
                out.push("      buf_puts(b, {c_string(if v.1.is_empty() { v.0 } else { v.0 + "(" })});")
                for (i, pt) in v.1.with_index() {
                    if i > 0 {
                        out.push("      buf_puts(b, \", \");")
                    }
                    let pn = self.cname(pt)
                    out.push("      {pn}_show(b, v{acc}u.v{k}.f{i}, false);")
                }
                if !v.1.is_empty() {
                    out.push("      buf_puts(b, \")\");")
                }
                out.push("      break;")
            }
            out.push("  }\n}")
            if boxed {
                out = out + ["static void {n}_show(WBuf* b, {ct} v, bool top) \{", "  (void)top;", "  w_show(b, {n}_show_kids, v, 0);", "}"]
            }
        } else {
            let fs = self.fields_of(t)
            out.push("static {ct} {n}_dup({ct} v) \{")
            for (i, f) in fs.with_index() {
                if !is_scalar(f.1) {
                    let fn_ = self.cname(f.1)
                    out.push("  v.f{i} = {fn_}_dup(v.f{i});")
                }
            }
            out.push("  return v;\n}")
            out = out + ["static void {n}_drop({ct} v) \{", "  (void)v;"]
            for (i, f) in fs.with_index() {
                if !is_scalar(f.1) {
                    let fn_ = self.cname(f.1)
                    out.push("  {fn_}_drop(v.f{i});")
                }
            }
            out.push("}")
            out = out + ["static void {n}_share({ct} v) \{", "  (void)v;"]
            for (i, f) in fs.with_index() {
                if !is_scalar(f.1) {
                    let fn_ = self.cname(f.1)
                    out.push("  {fn_}_share(v.f{i});")
                }
            }
            out.push("}")
            out = out + ["static bool {n}_eq({ct} a, {ct} b) \{", "  (void)a; (void)b;"]
            for (i, f) in fs.with_index() {
                let eq = self.binop(Eq, f.1, "a.f{i}", "b.f{i}", diag.nowhere())
                out.push("  if (!({eq})) return false;")
            }
            out.push("  return true;\n}")
            out = out + ["static void {n}_show(WBuf* b, {ct} v, bool top) \{", "  (void)top; (void)v;"]
            let name = match t {
                TNamed(nm, _) => nm,
                _ => "",
            }
            let tuple = ast.is_tuple_name(name)
            out.push("  buf_puts(b, {c_string(if tuple { "(" } else { name + " \{ " })});")
            for (i, f) in fs.with_index() {
                out.push("  buf_puts(b, {c_string((if i > 0 { ", " } else { "" }) + if tuple { "" } else { f.0 + ": " })});")
                let fn_ = self.cname(f.1)
                out.push("  {fn_}_show(b, v.f{i}, false);")
            }
            out.push(if tuple { "  buf_puts(b, \")\");\n}" } else { "  buf_puts(b, \" }\");\n}" })
        },
    }
    out
}

// Part j of the key type `n`, at `x`, in its _hash_k
fn hash_part(mut self: Cg, n: Str, j: Int, e: types.Ty, x: Str) -> List[Str] {
    let hp = self.hash_prefix(e)
    if self.flat(e) {
        return ["  if (i <= {j}) h = w_hash_mix(h, {hp}_hash({x}));"]
    }
    let amp = if self.is_boxed(e) { "" } else { "&" }
    let lines = [
        "  if (i <= {j}) \{",
        "    uint64_t k_ = w_hash({hp}_hash_k, {amp}{x});",
        "    if (w_hash_susp) \{ w_hash_wait({n}_hash_k, o, {j}, h); return 0; }",
        "    h = w_hash_mix(h, k_);",
        "  }",
    ]
    lines
}

// An item of the list or boxed enum `n`, inside a block: when it put
// something on the stack, the rest goes on after it, from item `next`
// (empty: nothing follows)
fn cmp_item(mut self: Cg, n: Str, e: types.Ty, x: Str, y: Str, next: Str) -> List[Str] {
    let cp = self.cmp_prefix(e)
    let deep = next != "" && !self.flat(e)
    let mut lines: List[Str] = []
    if deep {
        lines.push("    int64_t m_ = w_cmp_n;")
    }
    lines.push("    int r_ = {cp}_cmp({x}, {y}); if (r_) return w_cmp_res(r_);")
    if deep {
        lines.push("    if (w_cmp_n != m_) \{ w_cmp_push({n}_cmp_k, a, b, {next}); return 0; }")
    }
    lines
}

// A type is flat when no enum that holds itself is inside it, so its
// values are only so deep: its order and hash are plain recursion (worked
// out once per type). Any other goes through w_cmp and w_hash
// (limen_rt.h): a list or boxed enum orders from item i on, so it can go on
// the stack and resume there, and a key hashes from part i on.
fn flat(self: Cg, t: types.Ty) -> Bool {
    match self.flats.get(show(t)) {
        Some(b) => b,
        None => {
            let mut memo = self.flats
            self.flat_in(t, [], mut memo)
        },
    }
}

// The answers for `ts` and the types inside them
fn flat_table(self: Cg, ts: List[types.Ty]) -> Map[Str, Bool] {
    let mut memo: Map[Str, Bool] = map()
    for t in ts {
        let _ = self.flat_in(t, [], mut memo)
    }
    memo
}

fn flat_in(self: Cg, t: types.Ty, seen: List[Str], mut memo: Map[Str, Bool]) -> Bool {
    match t {
        TInt | TFloat | TStr | TBytes | TBool | TUnit | TUInt(_) => true,
        TList(e) | TArray(e, _) => self.flat_in(e, seen, mut memo),
        TNamed(..) => {
            let n = show(t)
            match memo.get(n) {
                Some(b) => { return b },
                None => {},
            }
            if seen.contains(n) {
                return false
            }
            // a false answer found on the way is true of every type on it
            let mut r = !self.is_boxed(t)
            if r {
                for e in self.parts(t) {
                    let b = self.flat_in(e, seen + [n], mut memo)
                    if !b {
                        r = false
                        break
                    }
                }
            }
            memo[n] = r
            r
        },
        _ => true,
    }
}


// Order functions, item by item as the interpreter compares; and hash
// functions for tuple, struct and enum map keys.
fn cmp_defs(mut self: Cg) -> List[Str] {
    let mut out: List[Str] = []
    self.flats = self.flat_table(self.hash_tys + self.cmp_tys)
    for t in self.hash_tys {
        if !self.flat(t) {
            let n = self.cname(t)
            out.push("static uint64_t {n}_hash_k(void* o, int64_t i, uint64_t h);")
        }
    }
    for t in self.hash_tys {
        let n = self.cname(t)
        let ct = self.ctype(t)
        out.push("static uint64_t {n}_hash({ct} v) \{")
        if self.flat(t) {
            out.push("  uint64_t h = 0x2545F4914F6CDD1DULL; (void)v;")
            if self.is_enum(t) {
                let acc = acc_of(self.is_boxed(t))
                out.push("  h = w_hash_mix(h, Int_hash(v{acc}tag));")
                out.push("  switch (v{acc}tag) \{")
                for (k, v) in self.variants_of(t).with_index() {
                    out.push("    case {k}:")
                    for (i, pt) in v.1.with_index() {
                        let hp = self.hash_prefix(pt)
                        out.push("  h = w_hash_mix(h, {hp}_hash(v{acc}u.v{k}.f{i}));")
                    }
                    out.push("      break;")
                }
                out.push("  }")
            } else {
                for (i, f) in self.fields_of(t).with_index() {
                    let hp = self.hash_prefix(f.1)
                    out.push("  h = w_hash_mix(h, {hp}_hash(v.f{i}));")
                }
            }
            out.push("  return h;")
        } else {
            let arg = if self.is_boxed(t) { "v" } else { "&v" }
            out.push("  return w_hash_outer({n}_hash_k, {arg});")
        }
        out.push("}")
    }
    // the kids of the keys that are not flat, after every _hash
    for t in self.hash_tys {
        if self.flat(t) {
            continue
        }
        let n = self.cname(t)
        let ct = self.ctype(t)
        out.push("static uint64_t {n}_hash_k(void* o, int64_t i, uint64_t h) \{")
        if self.is_boxed(t) {
            out.push("  {ct} v = ({ct})o;")
        } else {
            out.push("  {ct}* v = ({ct}*)o;")
        }
        // part j: a flat one is hashed at once; any other through w_hash,
        // and if it went on the stack, this call waits for it there
        if self.is_enum(t) {
            out.push("  if (i <= 0) h = w_hash_mix(h, Int_hash(v->tag));")
            out.push("  switch (v->tag) \{")
            for (k, v) in self.variants_of(t).with_index() {
                out.push("    case {k}:")
                for (i, pt) in v.1.with_index() {
                    let lines = self.hash_part(n, i + 1, pt, "v->u.v{k}.f{i}")
                    out = out + lines
                }
                out.push("      break;")
            }
            out.push("  }")
        } else {
            for (i, f) in self.fields_of(t).with_index() {
                let lines = self.hash_part(n, i, f.1, "v->f{i}")
                out = out + lines
            }
        }
        out.push("  return h;")
        out.push("}")
    }
    for t in self.cmp_tys {
        let ct = self.ctype(t)
        let n = self.cname(t)
        out.push("static int {n}_cmp({ct} a, {ct} b);")
    }
    for t in self.cmp_tys {
        let n = self.cname(t)
        let ct = self.ctype(t)
        let fl = self.flat(t)
        // a difference: as it is in a flat type, else through w_cmp_res
        let ret = if fl { "r_" } else { "w_cmp_res(r_)" }
        let kids = match t {
            TList(_) => !fl,
            _ => !fl && self.is_enum(t) && self.is_boxed(t),
        }
        if kids {
            out.push("static int {n}_cmp_k(void* pa, void* pb, int64_t i) \{")
            out.push("  {ct} a = ({ct})pa;")
            out.push("  {ct} b = ({ct})pb;")
            match t {
                TList(e) => {
                    out.push("  int64_t n_ = a->len < b->len ? a->len : b->len;")
                    out.push("  for (; i < n_; i++) \{")
                    let lines = self.cmp_item(n, e, "a->data[i]", "b->data[i]", "i + 1")
                    out = out + lines
                    out.push("  }")
                    out.push("  return a->len == b->len ? 0 : w_cmp_res(a->len < b->len ? -1 : 1);")
                },
                _ => {
                    out.push("  if (a->tag != b->tag) return w_cmp_res(a->tag < b->tag ? -1 : 1);")
                    out.push("  switch (a->tag) \{")
                    for (k, v) in self.variants_of(t).with_index() {
                        out.push("    case {k}:")
                        for (i, pt) in v.1.with_index() {
                            let next = if i < v.1.len() - 1 { "{i + 1}" } else { "" }
                            out.push("  if (i <= {i}) \{")
                            let lines = self.cmp_item(n, pt, "a->u.v{k}.f{i}", "b->u.v{k}.f{i}", next)
                            out = out + lines
                            out.push("  }")
                        }
                        out.push("      break;")
                    }
                    out.push("  }")
                    out.push("  return 0;")
                },
            }
            out.push("}")
            out.push("static int {n}_cmp({ct} a, {ct} b) \{ return w_cmp({n}_cmp_k, a, b, 0); }")
            continue
        }
        out.push("static int {n}_cmp({ct} a, {ct} b) \{")
        out.push("  (void)a; (void)b;")
        match t {
            TList(e) => {
                out.push("  int64_t n_ = a->len < b->len ? a->len : b->len;")
                out.push("  for (int64_t i = 0; i < n_; i++)")
                let cp = self.cmp_prefix(e)
                out.push("  \{ int r_ = {cp}_cmp(a->data[i], b->data[i]); if (r_) return {ret}; }")
                out.push("  return a->len < b->len ? -1 : a->len > b->len;")
            },
            TArray(e, TLen(k)) => {
                out.push("  for (int64_t i = 0; i < {k}; i++)")
                let cp = self.cmp_prefix(e)
                out.push("  \{ int r_ = {cp}_cmp(a.a[i], b.a[i]); if (r_) return {ret}; }")
                out.push("  return 0;")
            },
            _ => if self.is_enum(t) {
                let acc = acc_of(self.is_boxed(t))
                let diff = "a{acc}tag < b{acc}tag ? -1 : 1"
                let r = if fl { diff } else { "w_cmp_res({diff})" }
                out.push("  if (a{acc}tag != b{acc}tag) return {r};")
                out.push("  switch (a{acc}tag) \{")
                for (k, v) in self.variants_of(t).with_index() {
                    out.push("    case {k}:")
                    for (i, pt) in v.1.with_index() {
                        let cp = self.cmp_prefix(pt)
                        out.push("  \{ int r_ = {cp}_cmp(a{acc}u.v{k}.f{i}, b{acc}u.v{k}.f{i}); if (r_) return {ret}; }")
                    }
                    out.push("      break;")
                }
                out.push("  }")
                out.push("  return 0;")
            } else {
                for (i, f) in self.fields_of(t).with_index() {
                    let cp = self.cmp_prefix(f.1)
                    out.push("  \{ int r_ = {cp}_cmp(a.f{i}, b.f{i}); if (r_) return {ret}; }")
                }
                out.push("  return 0;")
            },
        }
        out.push("}")
    }
    for t in self.sort_tys {
        match t {
            TList(e) => {
                let cp = self.cmp_prefix(e)
                let et = self.ctype(e)
                let n = self.cname(t)
                out.push("LIMEN_LIST_SORT({n}, {et}, {cp})")
            },
            _ => {},
        }
    }
    out
}

// ---------- the program ----------

// OCaml's `%S` of a root field's name: a plain identifier, quoted.
fn quoted(s: Str) -> Str {
    "\"" + s + "\""
}

// The program as C: `files` are the program's files (with the prelude's
// and the built-in methods'), so panics can say where they happened;
// `runtime` is the whole runtime (limen_sandbox.h, limen_rt.h, limen_rt.c).
pub fn program(ro: lower.Ro, files: List[diag.Source], prog: ir.Program, runtime: Str) -> Str {
    let mut c = Cg {
        ro,
        files,
        starts: files.map(|f| line_starts(f.text)),
        prof_ids: map(),
        names: map(),
        types: [],
        lits: map(),
        lit_order: [],
        boxed: [],
        uniq: [],
        task_tys: [],
        inrange: [],
        chan_tys: [],
        dyns: [],
        cell_tys: [],
        cmp_tys: [],
        sort_tys: [],
        hash_tys: [],
        flats: map(),
        csyms: [],
        sql_api: false,
        cstructs: [],
        wrappers: [],
        kepts: [],
        bjobs: [],
        vols: [],
        pure: pure.analyse(prog),
        plan: pure.no_plan(),
        slot: 0,
        loops: 0,
        slotted: [],
        scopes: 0,
        tls: false,
        out: [],
    }
    if ro.profile {
        for (i, f) in prog.fns.with_index() {
            c.prof_ids[f.fname] = i + 1
        }
    }
    // bodies first: this names every type and literal
    for f in prog.fns {
        c.fn_body(f)
    }
    let bodies = c.out.join("")
    let mut protos: List[Str] = []
    for f in prog.fns {
        let sig = c.signature(f)
        protos.push(sig + ";\n")
    }
    let mut envs: List[Str] = []
    for f in prog.fns {
        if f.captures.is_empty() {
            continue
        }
        let mut cs: List[Str] = []
        for (i, v) in f.captures.with_index() {
            let ct = c.ctype(v.ty)
            cs.push("{ct} c{i};")
        }
        envs.push("struct Env_{f.fname} \{ WClo base; {cs.join(" ")} };\n")
        for what in ["drop", "share"] {
            envs.push("static void Env_{f.fname}_{what}(WClo* k) \{\n  struct Env_{f.fname}* e = (struct Env_{f.fname}*)k;\n  (void)e;\n")
            for (i, v) in f.captures.with_index() {
                if !is_scalar(v.ty) {
                    let n = c.cname(v.ty)
                    envs.push("  {n}_{what}(e->c{i});\n")
                }
            }
            envs.push("}\n")
        }
    }
    let mut dynbuf: List[Str] = []
    // drop-through-pointer functions for owned locals
    for t in c.cell_tys {
        let ct = c.ctype(t)
        let n = c.cname(t)
        dynbuf.push("static void w_dp_{n}(void* p) \{ {n}_drop(*({ct}*)p); }\n")
    }
    for d in c.dyns {
        let ct = c.ctype(d.ty)
        let cn = c.cname(d.ty)
        let key = d.key
        let p = "((struct Dyn_{key}*)d)->val"
        dynbuf.push("struct Dyn_{key} \{ WDyn base; {ct} val; };\n")
        dynbuf.push("static void Dyn_{key}_drop(WDyn* d) \{ {if is_scalar(d.ty) { "(void)d;" } else { "{cn}_drop({p});" }} }\n")
        dynbuf.push("static void Dyn_{key}_share(WDyn* d) \{ {if is_scalar(d.ty) { "(void)d;" } else { "{cn}_share({p});" }} }\n")
        dynbuf.push("static void Dyn_{key}_show(WBuf* b, WDyn* d, bool top) \{ {cn}_show(b, {p}, top); }\n")
        for (k, m) in d.methods.with_index() {
            let mut params = ["WDyn* d"]
            for (j, pt) in m.params.with_index() {
                let pc = c.ctype(pt)
                params.push("{pc} a{j}")
            }
            let self_arg = if is_scalar(d.ty) { p } else { "{cn}_dup({p})" }
            let rc = c.ctype(m.ret)
            let args = [self_arg] + m.params.with_index().map(|q| "a{q.0}")
            dynbuf.push("static {rc} Dyn_{key}_m{k}({params.join(", ")}) \{ return {m.fname}({args.join(", ")}); }\n")
        }
        let slots = if d.methods.is_empty() { "NULL" } else { d.methods.with_index().map(|q| "(void*)Dyn_{key}_m{q.0}").join(", ") }
        dynbuf.push("static const struct \{ WVtHead h; void *m[{d.methods.len().max(1)}]; } Dyn_{key}_vt = \{ \{ Dyn_{key}_drop, Dyn_{key}_share, Dyn_{key}_show }, \{ {slots} } };\n")
    }
    let mut tasks: List[Str] = []
    for t in c.chan_tys {
        if !is_scalar(t) {
            let ct = c.ctype(t)
            let n = c.cname(t)
            tasks.push("static void chdrop_{n}(void* p) \{ {n}_drop(*({ct}*)p); }\nstatic void chshare_{n}(void* p) \{ {n}_share(*({ct}*)p); }\n")
        }
    }
    for t in c.task_tys {
        let mut share = ""
        if !is_scalar(t) {
            let n0 = c.cname(t)
            share = "{n0}_share(r);"
        }
        let ct = c.ctype(t)
        let n = c.cname(t)
        tasks.push("static void wtask_{n}(WTask* t) \{\n  {ct} r = (({ct} (*)(WClo*))t->fn->fn)(t->fn);\n  {share}\n  memcpy(t->slot, &r, sizeof r);\n  Clo_drop(t->fn);\n}\n")
    }
    let main = c.main_fn(prog)
    // callback wrappers, after the prototypes of the functions they call
    let mut cbdefs: List[Str] = []
    for w in c.wrappers {
        let d = c.ffi_callback_def(w)
        cbdefs.push(d)
    }
    for (i, ps) in c.kepts.with_index() {
        let d = c.kept_def(i, ps)
        cbdefs.push(d)
    }
    let defs = c.type_defs()
    let mut tys = defs.map(|l| l + "\n")
    for s in c.cstructs {
        let fields = s.fields.with_index().map(|q| {
            let (i, f) = q
            "{ffi.c_name(f.1)} c{i};"
        })
        tys.push("typedef struct \{ {fields.join(" ")} } {s.cname};\n")
    }
    let lits = c.lit_order.map(|p| "static WStr {p.0} = \{ 0, {p.1.len()}, (char*){c_string(p.1)} };\n")
    // each foreign C function under a private name, bound to its symbol by
    // an asm label, so it clashes with no header's declaration of it
    let mut externs = c.csyms.map(|sym| "extern void vf_{sym}(void) __asm__(W_CSYM(\"{sym}\"));\n")
    // the SQLite functions limen_sql_run calls, in the order of its table
    if c.sql_api {
        externs.push("static const void *const w_sql_api[] = \{ {ffi.sql_syms().map(|sym| "(const void *)vf_" + sym).join(", ")} };\n")
    }
    let program = ["/* ---- types ---- */", tys.join(""), "/* ---- literals ---- */", lits.join(""), "/* ---- closures ---- */", envs.join(""), tasks.join(""), "/* ---- functions ---- */", protos.join(""), externs.join(""), cbdefs.join("") + c.bjobs.join(""), "/* ---- dyn vtables ---- */", dynbuf.join(""), bodies, main]
    // Only a group with a deadline can cancel a task (the deadline cancels
    // the group, and a cancelled group's tasks are cancelled with it). In a
    // program with none, every checkpoint is a load of a counter that stays
    // 0: say so, so the C compiler drops them from loops.
    let program = if ro.lines { program.map(pin_lines) } else { program }
    let never_stops = if program.any(|part| part.contains("w_group_new_until(")) { [] } else { [no_checkpoints()] }
    (if c.tls { tls_marker() } else { "" }) + ([runtime] + never_stops + program).join("\n")
}

// `main` of the C program: a test binary's, or the one that runs the
// program's `main` as the main fiber and turns its result into the exit
// status.
fn main_fn(mut self: Cg, prog: ir.Program) -> Str {
    let mut m: List[Str] = []
    let rt = prog.main_ret
    if !prog.tests.is_empty() || !prog.benches.is_empty() {
        // test binary: `PROGRAM N` runs test N (each test in its own
        // process); `PROGRAM bench N NS ITERS` runs bench N, ITERS times,
        // or (ITERS = 0) as many times as fit in NS nanoseconds, and
        // reports on stderr
        let cap_args = |fields: List[Str]| fields.map(|f| "Cap_root_field(NULL, {quoted(f)})").join(", ")
        m.push("static int wtest_index_, wtest_bench_;")
        m.push("static int64_t wbench_budget_, wbench_fixed_;")
        if !prog.benches.is_empty() {
            m.push("static WCap* wbench_caps_[2];")
            for (i, b) in prog.benches.with_index() {
                m.push("static void wbench_{i}_(void) \{")
                for (k, _) in b.fields.with_index() {
                    m.push("  Cap_dup(wbench_caps_[{k}]);")
                }
                m.push("  {b.cname}({b.fields.with_index().map(|q| "wbench_caps_[{q.0}]").join(", ")});")
                m.push("}")
            }
            // Go's scaling: run once, then grow the count toward the time
            // budget, at most 100 times per round, until one round fills
            // the budget
            m = m + ["static void wbench_loop_(void (*body)(void)) \{", "  int64_t n = wbench_fixed_ > 0 ? wbench_fixed_ : 1;", "  for (;;) \{", "    int64_t a0 = __atomic_load_n(&w_allocs, __ATOMIC_RELAXED);", "    int64_t t0 = w_mono_ns();", "    for (int64_t i = 0; i < n; i++) body();", "    int64_t ns = w_mono_ns() - t0;", "    int64_t al = __atomic_load_n(&w_allocs, __ATOMIC_RELAXED) - a0;", "    if (wbench_fixed_ > 0 || ns >= wbench_budget_ || n >= 1000000000) \{", "      fflush(stdout);", "      fprintf(stderr, \"limen-bench: %lld %lld %lld\\n\", (long long)n, (long long)ns, (long long)al);", "      return;", "    }", "    int64_t next = ns > 0 ? (int64_t)(1.2 * (double)wbench_budget_ * (double)n / (double)ns) : n * 100;", "    if (next > n * 100) next = n * 100;", "    if (next <= n) next = n + 1;", "    if (next > 1000000000) next = 1000000000;", "    n = next;", "  }", "}"]
        }
        m = m + ["static void wtest_entry_(void* a) \{", "  (void)a;", "  if (!wtest_bench_) switch (wtest_index_) \{"]
        for (i, t) in prog.tests.with_index() {
            m.push("    case {i}: {t.cname}({cap_args(t.fields)}); break;")
        }
        m.push("  }")
        if !prog.benches.is_empty() {
            m.push("  else switch (wtest_index_) \{")
            for (i, b) in prog.benches.with_index() {
                m.push("    case {i}:")
                for (k, f) in b.fields.with_index() {
                    m.push("      wbench_caps_[{k}] = Cap_root_field(NULL, {quoted(f)});")
                }
                m.push("      wbench_loop_(wbench_{i}_);")
                for (k, _) in b.fields.with_index() {
                    m.push("      Cap_drop(wbench_caps_[{k}]);")
                }
                m.push("      break;")
            }
            m.push("  }")
        }
        m = m + ["  w_main_finished();", "}", "int main(int argc, char** argv) \{", "  if (argc < 2) return 2;", "  if (strcmp(argv[1], \"bench\") == 0) \{", "    if (argc < 5) return 2;", "    wtest_bench_ = 1;", "    wtest_index_ = atoi(argv[2]);", "    wbench_budget_ = atoll(argv[3]);", "    wbench_fixed_ = atoll(argv[4]);", "    w_init(argc - 4, argv + 4);   /* then `--grant fs=DIR` for a bench that takes Fs */", "  } else \{", "    wtest_index_ = atoi(argv[1]);"]
        // a test that takes `clock: virtual Clock` runs on virtual time,
        // from before any thread starts
        let virtual = prog.tests.with_index().filter(|q| {
            let (_, t) = q
            t.virtual
        }).map(|q| "case {q.0}:")
        if !virtual.is_empty() {
            m.push("    switch (wtest_index_) \{ {virtual.join(" ")} w_virtual_start(); }")
        }
        m = m + ["    w_init(argc - 1, argv + 1);   /* `--grant fs=DIR` for a test that takes Fs */", "  }", "  w_run(wtest_entry_, NULL);", "  fflush(stdout);", "  w_leakcheck();", "  return 0;", "}"]
    } else {
        // main runs as the main fiber, so it can wait on groups, channels
        // and sockets
        let ct = self.ctype(rt)
        m.push("static {ct} wmain_result_;")
        m.push("static void wmain_entry_(void* a) \{ (void)a; wmain_result_ = {prog.main}({if prog.main_takes_root { "w_root()" } else { "" }}); w_main_finished(); }")
        if self.ro.profile {
            // a function's name without the `wf_` C names start with
            let n = prog.fns.len() + 1
            let shown = prog.fns.map(|f| if f.fname.starts_with("wf_") { f.fname.slice(3, f.fname.len()) } else { f.fname })
            m.push("static const char *const w_prof_names_[{n}] = \{ \"(runtime and C)\"{shown.map(|x| ", \"{x}\"").join("")} };")
            m.push("static int64_t w_prof_calls_[{n}];")
            m.push("static int64_t w_prof_samples_[{n}];")
        }
        m = m + ["int main(int argc, char** argv) \{", "  w_init(argc, argv);"]
        if self.ro.profile {
            m.push("  w_prof_start(w_prof_names_, w_prof_calls_, w_prof_samples_, {prog.fns.len() + 1});")
        }
        m = m + ["  w_run(wmain_entry_, NULL);", "  {ct} r_ = wmain_result_;"]
        match rt {
            TNamed("Result", [_, et]) => {
                let te = self.tag_expr(rt, "r_")
                m.push("  if ({te} == 1) \{")
                m.push("    WBuf b_; buf_init(&b_); buf_puts(&b_, \"error: \");")
                match et {
                    TDyn("Error", []) => {
                        // a `dyn Error` is reported by its message: method
                        // 0 of its vtable
                        let d = self.payload_expr(rt, "r_", 1, 0)
                        m.push("    WStr* m_ = ((WStr* (*)(WDyn*))({d})->vt->m[0])({d});")
                        m.push("    Str_show(&b_, m_, true); Str_drop(m_);")
                    },
                    _ => {
                        let pe = self.payload_expr(rt, "r_", 1, 0)
                        let en = self.cname(et)
                        m.push("    {en}_show(&b_, {pe}, true);")
                    },
                }
                m.push("    buf_puts(&b_, \"\\n\"); fflush(stdout); fwrite(b_.p, 1, (size_t)b_.len, stderr); return 1;")
                m.push("  }")
            },
            _ => {},
        }
        // `main` returning Int (or Ok(Int)) chooses the exit status; the
        // OS keeps its low 8 bits
        let code = match rt {
            TInt => "(int)(r_ & 255)",
            TNamed("Result", [TInt, _]) => {
                let pe = self.payload_expr(rt, "r_", 0, 0)
                "(int)({pe} & 255)"
            },
            _ => "0",
        }
        m.push("  int code_ = {code};")
        if is_scalar(rt) {
            m.push("  (void)r_;")
        } else {
            let n = self.cname(rt)
            m.push("  {n}_drop(r_);")
        }
        m = m + ["  fflush(stdout);", "  w_leakcheck();", "  return code_;", "}"]
    }
    m.map(|l| l + "\n").join("")
}
