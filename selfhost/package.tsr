// tessera.toml, as src/package.ml reads it: the package's name, the
// program's own grants, its dependencies with the capabilities each may
// use, and the dependencies it trusts with C.
//
//     [package]
//     name = "app"
//
//     [grants]
//     fs = "data:ro"
//
//     [dependencies]
//     json = { path = "vendor/json" }
//     fetch = { path = "../fetch", caps = ["net"] }
//
//     [trust]
//     foreign = ["zlib"]
//
//     [embed]
//     roots = ["../assets"]
//
// Only the subset of TOML a manifest needs is read: tables, strings,
// string arrays and inline tables. Every problem is E0321, at the place in
// the file, with the OCaml reader's message.
use ast
use diag
use paths

pub struct Manifest {
    name: Str,
    // the path it was read from
    path: Str,
    deps: List[Dep],
    // the program's own grants: (kind, value) as `--grant KIND=VALUE`
    // would give them, an fs directory made relative to the manifest
    grants: List[(Str, Str)],
    // the dependencies that may call C
    trust: List[Str],
    // the directories besides the package whose files the program may
    // embed: each as written, the path it names (relative to the
    // manifest's directory), and its line
    embed_roots: List[(Str, Str, ast.Span)],
}

pub struct Dep {
    name: Str,
    // the directory holding NAME.tsr; "" for a git dependency, which only
    // fetching puts somewhere
    dir: Str,
    caps: List[Str],
    span: ast.Span,
    git: Option[Git],
}

// A dependency fetched with git: the repository and the revision, written
// as tessera.lock writes it, `tag:v1.0` or `commit:0a1b2c3`.
pub struct Git {
    url: Str,
    rev: Str,
}

// what [grants] can grant the program
fn grant_kinds() -> List[Str] {
    ["net", "fs", "listen", "env", "exec", "foreign"]
}

// what `caps` can grant a dependency
fn cap_grants() -> List[Str] {
    ["net", "fs", "listen", "stdout", "stderr", "clock", "rand", "stdin", "env", "exec"]
}

// ---------- the TOML subset ----------

enum Value {
    VStr(Str),
    VArr(List[Str]),
    VTable(List[(Str, Value)]),
}

// A table of the file: its name ("" for the keys before the first header),
// whether it was written [[name]], its header's span, and its keys.
struct Table {
    name: Str,
    array: Bool,
    span: ast.Span,
    keys: List[Key],
}

struct Key {
    name: Str,
    value: Value,
    // from the key to the end of its value
    span: ast.Span,
}

// The reader's place in the text.
struct Reader {
    src: Str,
    bytes: List[Int],
    pos: Int,
    file: Int,
}

type Read[T] = Result[(T, Reader), diag.Diag]

fn peek(self: Reader) -> Int {
    self.bytes.get(self.pos) ?? 0
}

fn at(self: Reader, c: Str) -> Bool {
    self.peek() == c.bytes()[0]
}

fn more(self: Reader) -> Bool {
    self.pos < self.bytes.len()
}

fn step(self: Reader) -> Reader {
    { self with pos: self.pos + 1 }
}

fn span(self: Reader, lo: Int, hi: Int) -> ast.Span {
    ast.Span { file: self.file, lo, hi }
}

// An error at byte `lo`, one byte wide (none at the end of the file).
fn fail(self: Reader, lo: Int, message: Str) -> diag.Diag {
    diag.error("E0321", self.span(lo, self.bytes.len().min(lo + 1)), message)
}

fn is_space(c: Int) -> Bool {
    c == 32 || c == 9 || c == 13
}

fn is_key_char(c: Int) -> Bool {
    (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 45
}

// Past spaces and tabs on this line.
fn skip_spaces(self: Reader) -> Reader {
    let mut r = self
    while is_space(r.peek()) {
        r = r.step()
    }
    r
}

fn skip_comment(self: Reader) -> Reader {
    let mut r = self
    while r.more() && !r.at("\n") {
        r = r.step()
    }
    r
}

// Past blank space, newlines and comments.
fn skip_blank(self: Reader) -> Reader {
    let mut r = self
    while true {
        if is_space(r.peek()) || r.at("\n") {
            r = r.step()
        } else if r.at("#") {
            r = r.skip_comment()
        } else {
            break
        }
    }
    r
}

// Nothing but a comment may follow on the line.
fn end_line(self: Reader) -> Result[Reader, diag.Diag] {
    let mut r = self.skip_spaces()
    if r.at("#") {
        r = r.skip_comment()
    }
    if r.more() && !r.at("\n") {
        return Err(r.fail(r.pos, "expected the end of the line"))
    }
    Ok(r)
}

fn key(self: Reader) -> Read[Str] {
    let lo = self.pos
    let mut r = self
    while r.more() && is_key_char(r.peek()) {
        r = r.step()
    }
    if r.pos == lo {
        return Err(r.fail(lo, "expected a key"))
    }
    Ok((r.src.slice(lo, r.pos), r))
}

fn string(self: Reader) -> Read[Str] {
    if !self.at("\"") {
        return Err(self.fail(self.pos, "expected a string in double quotes"))
    }
    let mut r = self.step()
    let mut out: List[Str] = []
    while !r.at("\"") {
        if !r.more() || r.at("\n") {
            return Err(r.fail(r.pos, "unterminated string"))
        }
        if r.at("\\") {
            r = r.step()
            let c = if r.at("\"") {
                "\""
            } else if r.at("\\") {
                "\\"
            } else if r.at("n") {
                "\n"
            } else {
                return Err(r.fail(r.pos, "unknown escape"))
            }
            out.push(c)
        } else {
            out.push(r.src.slice(r.pos, r.pos + 1))
        }
        r = r.step()
    }
    Ok((out.join(""), r.step()))
}

fn value(self: Reader) -> Read[Value] {
    let r = self.skip_spaces()
    if r.at("\"") {
        let (s, r) = r.string()?
        Ok((VStr(s), r))
    } else if r.at("[") {
        let mut r = r.step().skip_blank()
        let mut items: List[Str] = []
        while !r.at("]") {
            let (s, next) = r.string()?
            items.push(s)
            r = next.skip_blank()
            if r.at(",") {
                r = r.step().skip_blank()
            } else if !r.at("]") {
                return Err(r.fail(r.pos, "expected `,` or `]`"))
            }
        }
        Ok((VArr(items), r.step()))
    } else if r.at("\{") {
        let mut r = r.step().skip_spaces()
        let mut fields: List[(Str, Value)] = []
        while !r.at("\}") {
            let (k, next) = r.key()?
            r = next.skip_spaces()
            if !r.at("=") {
                return Err(r.fail(r.pos, "expected `=`"))
            }
            let (v, next) = r.step().value()?
            fields.push((k, v))
            r = next.skip_spaces()
            if r.at(",") {
                r = r.step().skip_spaces()
            } else if !r.at("\}") {
                return Err(r.fail(r.pos, "expected `,` or `\}`"))
            }
        }
        Ok((VTable(fields), r.step()))
    } else {
        Err(r.fail(r.pos, "expected a string, an array or an inline table"))
    }
}

fn tables(file: Int, src: Str) -> Result[List[Table], diag.Diag] {
    let mut r = Reader { src, bytes: src.bytes(), pos: 0, file }
    let mut done: List[Table] = []
    let mut cur = Table { name: "", array: false, span: r.span(0, 0), keys: [] }
    r = r.skip_blank()
    while r.more() {
        if r.at("[") {
            let lo = r.pos
            r = r.step()
            let array = r.at("[")
            if array {
                r = r.step()
            }
            let (name, next) = r.key()?
            r = next
            if !r.at("]") {
                return Err(r.fail(r.pos, "expected `]`"))
            }
            r = r.step()
            if array {
                if !r.at("]") {
                    return Err(r.fail(r.pos, "expected `]]`"))
                }
                r = r.step()
            }
            // the keys before the first header make a table only if any
            if cur.name != "" || !cur.keys.is_empty() {
                done.push(cur)
            }
            cur = Table { name, array, span: r.span(lo, r.pos), keys: [] }
            r = r.end_line()?
        } else {
            let lo = r.pos
            let (name, next) = r.key()?
            r = next.skip_spaces()
            if !r.at("=") {
                return Err(r.fail(r.pos, "expected `=`"))
            }
            let (value, next) = r.step().value()?
            let span = next.span(lo, next.pos)
            r = next.end_line()?
            cur.keys.push(Key { name, value, span })
        }
        r = r.skip_blank()
    }
    if cur.name != "" || !cur.keys.is_empty() {
        done.push(cur)
    }
    Ok(done)
}

// ---------- the manifest ----------

// Whether the tessera.toml text `src` (file number `file`) declares embed
// roots: the span of its [embed] table. A dependency's tessera.toml is
// otherwise never read, and one that cannot be read declares nothing.
pub fn declares_embed(file: Int, src: Str) -> Option[ast.Span] {
    match tables(file, src) {
        Ok(ts) => ts.find(|t| t.name == "embed" && !t.array).map(|t| t.span),
        Err(_) => None,
    }
}

// The manifest in `src`, read from `path`, file number `file`.
pub fn parse(file: Int, path: Str, src: Str) -> Result[Manifest, diag.Diag] {
    let dir = paths.dirname(path)
    let bad = |span: ast.Span, message: Str| diag.error("E0321", span, message)
    let mut m = Manifest { name: "", path, deps: [], grants: [], trust: [], embed_roots: [] }
    let mut has_roots = false
    for t in tables(file, src)? {
        let known = t.name == "" || ["package", "dependencies", "grants", "trust", "embed"].contains(t.name)
        if t.array || !known {
            let header = if t.array { "[[{t.name}]]" } else { "[{t.name}]" }
            return Err(bad(t.span, "unknown table {header}; tessera.toml has [package], [grants], [dependencies], [trust] and [embed]"))
        }
        for k in t.keys {
            m = match (t.name, k.value) {
                ("package", VStr(s)) if k.name == "name" => { m with name: s },
                ("package", VStr(_)) if k.name == "version" || k.name == "description" => m,
                ("package", _) => {
                    return Err(bad(k.span, "unknown or malformed key in [package]"))
                },
                ("dependencies", VTable(fields)) => {
                    let dep = dependency(k.name, fields, k.span, dir)?
                    if m.deps.any(|d| d.name == dep.name) {
                        return Err(bad(k.span, "dependency `{dep.name}` is listed twice"))
                    }
                    { m with deps: m.deps + [dep] }
                },
                ("dependencies", _) => {
                    return Err(bad(k.span, "write a dependency as `name = \{ path = \"DIR\", caps = [...] \}` or `name = \{ git = \"URL\", tag = \"v1.0.0\" \}`"))
                },
                ("grants", v) => { m with grants: m.grants + grant(k.name, v, k.span, dir, m.grants)? },
                ("trust", VArr(names)) if k.name == "foreign" => {
                    if !m.trust.is_empty() {
                        return Err(bad(k.span, "[trust] foreign is listed twice"))
                    }
                    if names.is_empty() {
                        return Err(bad(k.span, "an empty trust list trusts nothing; remove the line"))
                    }
                    { m with trust: names }
                },
                ("trust", _) => {
                    return Err(bad(k.span, "[trust] takes `foreign = [\"dependency\", ...]`: the dependencies that may call C"))
                },
                ("embed", VArr(roots)) if k.name == "roots" => {
                    if has_roots {
                        return Err(bad(k.span, "[embed] roots is listed twice"))
                    }
                    if roots.is_empty() {
                        return Err(bad(k.span, "an empty list of embed roots adds nothing; remove the line"))
                    }
                    for (i, r) in roots.with_index() {
                        if r == "" {
                            return Err(bad(k.span, "an embed root cannot be empty"))
                        }
                        if roots.take(i).contains(r) {
                            return Err(bad(k.span, "embed root `{r}` is listed twice"))
                        }
                    }
                    has_roots = true
                    { m with embed_roots: roots.map(|r| (r, if paths.is_relative(r) { paths.concat(dir, r) } else { r }, k.span)) }
                },
                ("embed", _) => {
                    return Err(bad(k.span, "[embed] takes `roots = [\"DIR\", ...]`: directories, relative to tessera.toml, whose files the program may embed"))
                },
                _ => {
                    return Err(bad(k.span, "keys belong in [package], [grants], [dependencies], [trust] or [embed]"))
                },
            }
        }
    }
    // the standard library's manifest trusts its own modules, not dependencies
    for name in m.trust {
        if !m.deps.any(|d| d.name == name) && path != "<std>/tessera.toml" {
            return Err(bad(ast.Span { file, lo: 0, hi: 0 }, "[trust] names `{name}`, which is not in [dependencies]"))
        }
    }
    Ok(m)
}

// `name = { path = "DIR", caps = [...] }` or `name = { git = "URL", tag = "v1" }`
fn dependency(name: Str, fields: List[(Str, Value)], span: ast.Span, dir: Str) -> Result[Dep, diag.Diag] {
    let bad = |message: Str| diag.error("E0321", span, message)
    // in this order, which decides which one a manifest with two bad
    // ones is told about
    let path = text_field(fields, "path", span)?
    let git_url = text_field(fields, "git", span)?
    let tag = text_field(fields, "tag", span)?
    let commit = text_field(fields, "commit", span)?
    let (dir, git) = match (path, git_url, tag, commit) {
        (Some(p), None, None, None) => (if paths.is_relative(p) { paths.concat(dir, p) } else { p }, None),
        (None, Some(url), _, _) => {
            if !git_url_ok(url) {
                return Err(bad("`git` must be an https://, http://, ssh://, git:// or file:// URL, or user@host:path"))
            }
            let rev = match (tag, commit) {
                (Some(t), None) => {
                    if !tag_ok(t) {
                        return Err(bad("bad tag"))
                    }
                    "tag:" + t
                },
                (None, Some(c)) => {
                    if !commit_ok(c) {
                        return Err(bad("`commit` is a commit hash in lowercase hex, at least 7 characters"))
                    }
                    "commit:" + c
                },
                _ => {
                    return Err(bad("a git dependency needs exactly one of `tag` and `commit`"))
                },
            }
            ("", Some(Git { url, rev }))
        },
        (Some(_), Some(_), _, _) => {
            return Err(bad("a dependency has `path` or `git`, not both"))
        },
        (None, None, _, _) => {
            return Err(bad("a dependency needs `path = \"DIR\"` or `git = \"URL\"` with a `tag` or `commit`"))
        },
        (Some(_), None, _, _) => {
            return Err(bad("`tag` and `commit` go with `git`, not `path`"))
        },
    }
    let caps = match fields.find(|x| x.0 == "caps") {
        Some((_, VArr(cs))) => cs,
        Some(_) => {
            return Err(bad("`caps` is a list of strings"))
        },
        None => [],
    }
    for c in caps {
        if c == "foreign" {
            return Err(bad("`caps` cannot grant foreign: calling C is full trust; name the dependency in [trust] instead: foreign = [\"{name}\"]"))
        }
        if !cap_grants().contains(c) {
            return Err(bad("unknown capability `{c}`; use {cap_grants().join(", ")}"))
        }
    }
    for f in fields {
        if !["path", "git", "tag", "commit", "caps"].contains(f.0) {
            return Err(bad("unknown dependency field `{f.0}`"))
        }
    }
    Ok(Dep { name, dir, caps, span, git })
}

// The string field `f` of a dependency, if it has one.
fn text_field(fields: List[(Str, Value)], f: Str, span: ast.Span) -> Result[Option[Str], diag.Diag] {
    match fields.find(|x| x.0 == f) {
        Some((_, VStr(v))) => Ok(Some(v)),
        Some(_) => Err(diag.error("E0321", span, "`{f}` is a string")),
        None => Ok(None),
    }
}

// A line of [grants]: its (kind, value) pairs.
fn grant(kind: Str, v: Value, span: ast.Span, dir: Str, before: List[(Str, Str)]) -> Result[List[(Str, Str)], diag.Diag] {
    let bad = |message: Str| diag.error("E0321", span, message)
    if !grant_kinds().contains(kind) {
        let kinds = grant_kinds().join(", ")
        return Err(bad(if cap_grants().contains(kind) { "`{kind}` is always granted; [grants] lists {kinds}" } else { "unknown grant `{kind}`; [grants] lists {kinds}" }))
    }
    if before.any(|g| g.0 == kind) {
        return Err(bad("grant `{kind}` is listed twice; give a list instead"))
    }
    let values = match v {
        VStr(s) => [s],
        VArr(items) => items,
        VTable(_) => {
            return Err(bad("a grant is a string or a list of strings"))
        },
    }
    if values.is_empty() {
        return Err(bad("an empty grant list grants nothing; remove the line"))
    }
    if kind == "fs" && values.len() > 1 {
        return Err(bad("fs takes one directory"))
    }
    // an fs directory is relative to the manifest, its `:ro` kept
    let values = if kind != "fs" {
        values
    } else {
        values.map(|v| {
            let (d, ro) = if v.ends_with(":ro") { (v.slice(0, v.len() - 3), ":ro") } else { (v, "") }
            (if paths.is_relative(d) { paths.concat(dir, d) } else { d }) + ro
        })
    }
    if values.any(|v| v == "") {
        return Err(bad("a grant cannot be empty"))
    }
    Ok(values.map(|v| (kind, v)))
}

// A URL that is safe to hand to `git clone`: no `-` in front (an option to
// git) and no `transport::address`, which can run commands.
fn git_url_ok(u: Str) -> Bool {
    let bs = u.bytes()
    if u == "" || u.starts_with("-") || bs.any(|c| c <= 32 || c >= 127) || u.contains("::") {
        return false
    }
    if ["https://", "http://", "ssh://", "git://", "file://"].any(|p| u.starts_with(p)) {
        return true
    }
    // scp-like, user@host:path
    match (u.index_of("@"), u.index_of(":")) {
        (Some(a), Some(c)) => a > 0 && c > a + 1 && !u.slice(0, c).contains("/"),
        _ => false,
    }
}

fn tag_ok(t: Str) -> Bool {
    t != "" && !t.starts_with("-") && !t.bytes().any(|c| c <= 32 || c == 127)
}

fn commit_ok(c: Str) -> Bool {
    c.len() >= 7 && c.len() <= 64 && c.bytes().all(|b| (b >= 48 && b <= 57) || (b >= 97 && b <= 102))
}
