// Renaming: what the module loader does to each item of each module so the
// checker sees one flat program, as src/modules.ml does it.
//
// - Every item of module `m` is renamed `m.item` (the main file keeps its
//   names), and every reference is rewritten to match, scope-aware: inside
//   module `m`, a name that is one of `m`'s items means that item unless a
//   local hides it, and `geo.area(...)`, `geo.Shape`, `geo.Point { ... }`,
//   `geo.Circle(...)` and the pattern `geo.Circle(r)` reach module `geo`,
//   which the file must `use`, and only its `pub` items.
// - Type aliases are expanded where they are used.
// - `x |> f(a)` becomes `f(x, a)`.
// - `let (a, b) = e`, `for (k, v) in xs` and `(x, p) = f(p)` become plain
//   lets, loops and assignments through a temporary.
// - `embed(...)`, `embed_bytes(...)` and `embed_dir(...)` become the
//   literals the loader read for them (selfhost/embeds.lmn).
//
// Renaming is pure: the loader hands it everything it needs, files read
// included. Its state (the problems found, a count for the temporaries'
// names, the next expression id) is a `mut` parameter of every function,
// `expr(mut st, cx, locals, e)`.
//
// The problems come out in the order the OCaml loader finds them, and that
// order is OCaml's: it evaluates the arguments of a function or a
// constructor last to first, so it renames `a + b` by renaming `b` first,
// an `if` from its `else` back to its condition, and a call's arguments
// before its callee. The temporaries are numbered in that order too.
use ast
use diag
use embeds

// A module of the program: the main file (named "") or one it uses.
pub struct Module {
    name: Str,
    // its path as the loader writes it: "./geo.lmn", "<std>/json.lmn"
    path: Str,
    // its number in the program's file table
    file: Int,
    items: List[ast.Item],
    uses: List[ast.Name],
    // the limen.toml dependency it belongs to
    package: Option[Str],
}

pub fn is_std(m: Module) -> Bool {
    m.path.starts_with("<std>")
}

// A standard library module's name in the standard library, its file's:
// the program calls it `std/NAME` when it has a module NAME of its own.
pub fn std_name(m: Module) -> Str {
    m.path.slice(6, m.path.len() - 4)
}

// What renaming needs to know, the same for a whole item.
pub struct Context {
    // the module being renamed
    module: Module,
    // every module by name
    mods: Map[Str, Module],
    // the module's items by name, methods left out
    own: Map[Str, ast.Item],
    // the type parameters in scope
    gens: List[Str],
    // what each `embed` call of the module found, by embeds.key
    found: Map[Str, embeds.Found],
    // the standard library modules whose C calls are trusted
    trusted: List[Str],
}

// A file `embed` read: the module (main for the main file), the path as
// written, and its size in bytes; `limen caps` lists them.
pub struct Embedded {
    module: Str,
    path: Str,
    size: Int,
}

pub struct State {
    // the problems found so far, in order
    errors: List[diag.Diag],
    // how many temporaries have been named, `tuple$N`, `item$N`, `$assignN`
    temps: Int,
    // the id the next expression made here gets
    next_id: Int,
    // the aliases reported as containing themselves, each reported once
    cyclic: List[Str],
    embedded: List[Embedded],
}

fn fail(mut self: State, d: diag.Diag) {
    self.errors = self.errors + [d]
}

// A new expression, with the next id.
fn node(mut self: State, desc: ast.ExprDesc, span: ast.Span) -> ast.Expr {
    let e = ast.Expr { desc, span, id: self.next_id }
    self.next_id = self.next_id + 1
    e
}

// The next temporary's number.
fn temp(mut self: State) -> Int {
    self.temps = self.temps + 1
    self.temps
}

// ---------- items ----------

// A method is a function whose first parameter is `self`; it is named
// `Type::name` and called as `value.name(...)`, never by its bare name.
pub fn is_method(i: ast.Item) -> Bool {
    match i {
        IFn(d) => d.test.is_none() && (d.params.first().map(|p| p.name == "self") ?? false),
        _ => false,
    }
}

pub fn item_name(i: ast.Item) -> Str {
    match i {
        IFn(d) => d.name,
        IStruct(s) => s.name,
        IEnum(e) => e.name,
        IIface(f) => f.name,
        IType(a) => a.name,
    }
}

pub fn item_span(i: ast.Item) -> ast.Span {
    match i {
        IFn(d) => d.span,
        IStruct(s) => s.span,
        IEnum(e) => e.span,
        IIface(f) => f.span,
        IType(a) => a.span,
    }
}

pub fn is_public(i: ast.Item) -> Bool {
    match i {
        IFn(d) => d.public,
        IStruct(s) => s.public,
        IEnum(e) => e.public,
        IIface(f) => f.public,
        IType(a) => a.public,
    }
}

// A module's items by name, methods left out; a later one wins.
pub fn own_items(items: List[ast.Item]) -> Map[Str, ast.Item] {
    let mut own: Map[Str, ast.Item] = map()
    for i in items {
        if !is_method(i) {
            own[item_name(i)] = i
        }
    }
    own
}

pub fn qual(m: Module, name: Str) -> Str {
    if m.name == "" { name } else { m.name + "." + name }
}

// ---------- modules ----------

fn uses(cx: Context, name: Str) -> Bool {
    cx.module.uses.any(|u| u.text == name)
}

// The module `name` names here, if the file uses it.
fn module_of(cx: Context, name: Str) -> Option[Module] {
    if uses(cx, name) { cx.mods.get(name) } else { None }
}

// Whether `name` names a module here: the file uses it and no local hides it.
fn is_module(cx: Context, locals: List[Str], name: Str) -> Bool {
    !locals.contains(name) && uses(cx, name)
}

// Item `name` of module `m`, used from another module: it must be pub.
fn member(mut st: State, m: Module, name: Str, span: ast.Span) -> Option[ast.Item] {
    match m.items.find(|i| item_name(i) == name && !is_method(i)) {
        Some(i) => {
            if !is_public(i) {
                let d = diag.error("E0402", span, "`{name}` is private to module `{m.name}`").note("mark it `pub fn`, `pub struct` or `pub enum` in {m.path} to export it")
                st.fail(d)
            }
            Some(i)
        },
        None => None,
    }
}

// The enum of `m` that has variant `v`.
fn variant_enum(m: Module, v: Str) -> Option[ast.EnumDecl] {
    for i in m.items {
        match i {
            IEnum(e) if e.variants.any(|x| x.name == v) => {
                return Some(e)
            },
            _ => {},
        }
    }
    None
}

fn no_member(mut st: State, m: Module, name: Str, span: ast.Span) {
    let exported = m.items.filter(|i| is_public(i) && !is_method(i)).map(item_name).sort()
    let d = diag.error("E0403", span, "module `{m.name}` has no `{name}`")
    st.fail(if exported.is_empty() { d } else { d.note("it exports: " + exported.join(", ")) })
}

fn unknown_module(mut st: State, name: Str, span: ast.Span) {
    st.fail(diag.error("E0401", span, "unknown module `{name}`; add `use {name}` at the top of the file"))
}

// `geo.Shape` as ("geo", "Shape"), split at the first dot.
fn split_qualified(n: Str) -> Option[(Str, Str)] {
    n.index_of(".").map(|i| (n.slice(0, i), n.slice(i + 1, n.len())))
}

// ---------- types ----------

// A type with module names resolved and aliases expanded. `seen`: the
// aliases being expanded around this one, to catch `type A = List[A]`.
pub fn ty(mut st: State, cx: Context, seen: List[Str], t: ast.TyExpr) -> ast.TyExpr {
    match t.desc {
        TyName(n, args) => {
            let args = tys(mut st, cx, seen, args)
            let named = |name: Str| { t with desc: TyName(name, args) }
            match split_qualified(n) {
                Some((a, b)) => match module_of(cx, a) {
                    Some(m) => {
                        let found = member(mut st, m, b, t.span)
                        match found {
                            Some(IType(alias)) => expand(mut st, cx, seen, m, alias, args, t),
                            Some(IStruct(_) | IEnum(_) | IIface(_)) => named(qual(m, b)),
                            _ => {
                                no_member(mut st, m, b, t.span)
                                named(n)
                            },
                        }
                    },
                    None => {
                        unknown_module(mut st, a, t.span)
                        named(n)
                    },
                },
                None => {
                    if cx.gens.contains(n) {
                        return named(n)
                    }
                    match cx.own.get(n) {
                        Some(IType(alias)) => expand(mut st, cx, seen, cx.module, alias, args, t),
                        Some(IStruct(_) | IEnum(_) | IIface(_)) => named(qual(cx.module, n)),
                        _ => named(n),
                    }
                },
            }
        },
        TyFn(params, ret) => {
            let ret = ty(mut st, cx, seen, ret)
            let params = tys(mut st, cx, seen, params)
            { t with desc: TyFn(params, ret) }
        },
        TyUnit | TyInt(_) => t,
    }
}

// Alias `alias` of module `m`, used at `t` with `args` (already resolved):
// its body, resolved in `m`, with the arguments put in for its parameters.
fn expand(mut st: State, cx: Context, seen: List[Str], m: Module, alias: ast.AliasDecl, args: List[ast.TyExpr], t: ast.TyExpr) -> ast.TyExpr {
    let key = qual(m, alias.name)
    let bad = { t with desc: TyName(key, []) }
    if seen.contains(key) {
        if st.cyclic.contains(key) {
            return bad
        }
        let d = diag.error("E0116", alias.span, "type alias `{alias.name}` refers to itself").note("an alias is only another name; for a type that contains itself, declare a struct or enum")
        st.fail(d)
        st.cyclic = st.cyclic + [key]
        return bad
    }
    let k = alias.generics.len()
    if args.len() != k {
        let s = if k == 1 { "" } else { "s" }
        st.fail(diag.error("E0109", t.span, "`{alias.name}` takes {k} type argument{s}, found {args.len()}"))
        return bad
    }
    let own = if m.name == cx.module.name { cx.own } else { own_items(m.items) }
    let alias_cx = { cx with module: m, own, gens: alias.generics }
    let body = ty(mut st, alias_cx, [key] + seen, alias.body)
    let pairs = alias.generics.zip(args)
    // errors about the expanded type point where the alias is used
    { subst(pairs, body) with span: t.span }
}

// `t` with the type parameters in `pairs` replaced by their arguments.
fn subst(pairs: List[(Str, ast.TyExpr)], t: ast.TyExpr) -> ast.TyExpr {
    match t.desc {
        TyName(g, []) if pairs.any(|p| p.0 == g) => pairs.find(|p| p.0 == g).map(|p| p.1) ?? t,
        TyName(n, args) => { t with desc: TyName(n, args.map(|a| subst(pairs, a))) },
        TyFn(params, ret) => { t with desc: TyFn(params.map(|p| subst(pairs, p)), subst(pairs, ret)) },
        TyUnit | TyInt(_) => t,
    }
}

fn tys(mut st: State, cx: Context, seen: List[Str], ts: List[ast.TyExpr]) -> List[ast.TyExpr] {
    let mut out: List[ast.TyExpr] = []
    for t in ts {
        out.push(ty(mut st, cx, seen, t))
    }
    out
}

fn types(mut st: State, cx: Context, ts: List[ast.TyExpr]) -> List[ast.TyExpr] {
    tys(mut st, cx, [], ts)
}

fn opt_ty(mut st: State, cx: Context, t: Option[ast.TyExpr]) -> Option[ast.TyExpr] {
    match t {
        Some(t) => Some(ty(mut st, cx, [], t)),
        None => None,
    }
}

fn bounds(mut st: State, cx: Context, bs: List[ast.Bound]) -> List[ast.Bound] {
    let mut out: List[ast.Bound] = []
    for b in bs {
        let ifaces = types(mut st, cx, b.ifaces)
        out.push({ b with ifaces })
    }
    out
}

// ---------- patterns ----------

// The names pattern `p` binds, added to `locals`.
fn binds(p: ast.Pat, locals: List[Str]) -> List[Str] {
    match p.desc {
        PBind(n) | PRest(Some(n)) => [n] + locals,
        PVariant(_, _, ps) | PTuple(ps) | PList(ps) | POr(ps) => ps.fold(locals, |acc, x| binds(x, acc)),
        PStruct(_, _, fields, _) => fields.fold(locals, |acc, f| binds(f.pat, acc)),
        PAs(q, n, _) => binds(q, [n] + locals),
        _ => locals,
    }
}

fn pat(mut st: State, cx: Context, locals: List[Str], p: ast.Pat) -> ast.Pat {
    match p.desc {
        PVariant(Some(q), v, ps) => {
            let ps = pats(mut st, cx, locals, ps)
            let q = if is_module(cx, locals, q) {
                match cx.mods.get(q) {
                    Some(m) => match variant_enum(m, v) {
                        Some(e) => {
                            let _ = member(mut st, m, e.name, p.span)
                            qual(m, e.name)
                        },
                        None => {
                            no_member(mut st, m, v, p.span)
                            q
                        },
                    },
                    None => q,
                }
            } else {
                match cx.own.get(q) {
                    Some(IEnum(_)) => qual(cx.module, q),
                    _ => q,
                }
            }
            { p with desc: PVariant(Some(q), v, ps) }
        },
        PVariant(None, v, ps) => {
            let ps = pats(mut st, cx, locals, ps)
            { p with desc: PVariant(None, v, ps) }
        },
        PTuple(ps) => {
            let ps = pats(mut st, cx, locals, ps)
            { p with desc: PTuple(ps) }
        },
        PList(ps) => {
            let ps = pats(mut st, cx, locals, ps)
            { p with desc: PList(ps) }
        },
        POr(ps) => {
            let ps = pats(mut st, cx, locals, ps)
            { p with desc: POr(ps) }
        },
        PStruct(n, nsp, fields, rest) => {
            let n = struct_name(mut st, cx, locals, n, nsp)
            let mut out: List[ast.FieldPat] = []
            for f in fields {
                let q = pat(mut st, cx, locals, f.pat)
                out.push({ f with pat: q })
            }
            { p with desc: PStruct(n, nsp, out, rest) }
        },
        PAs(q, n, nsp) => {
            let q = pat(mut st, cx, locals, q)
            { p with desc: PAs(q, n, nsp) }
        },
        _ => p,
    }
}

fn pats(mut st: State, cx: Context, locals: List[Str], ps: List[ast.Pat]) -> List[ast.Pat] {
    let mut out: List[ast.Pat] = []
    for x in ps {
        out.push(pat(mut st, cx, locals, x))
    }
    out
}

// ---------- expressions ----------

fn set(e: ast.Expr, desc: ast.ExprDesc) -> ast.Expr {
    { e with desc }
}

pub fn expr(mut st: State, cx: Context, locals: List[Str], e: ast.Expr) -> ast.Expr {
    match e.desc {
        EInt(_) | EFloat(_) | EBool(_) | EUnit => e,
        EStr(parts) => {
            let mut out: List[ast.StrPart] = []
            for part in parts {
                out.push(match part {
                    SPLit(_) => part,
                    SPExpr(x) => {
                        let x = expr(mut st, cx, locals, x)
                        SPExpr(x)
                    },
                })
            }
            set(e, EStr(out))
        },
        EVar(n) => {
            if locals.contains(n) {
                return e
            }
            match cx.own.get(n) {
                Some(IFn(_)) => set(e, EVar(qual(cx.module, n))),
                _ => {
                    if !is_module(cx, locals, n) {
                        return e
                    }
                    st.fail(diag.error("E0404", e.span, "module `{n}` is not a value; use one of its items, such as `{n}.name`"))
                    e
                },
            }
        },
        EList(items) => {
            let items = exprs(mut st, cx, locals, items)
            set(e, EList(items))
        },
        // `x |> f(a)` is `f(x, a)` from here on
        EPipe(x, rhs) => match pipe_call(mut st, x, rhs) {
            Some(call) => expr(mut st, cx, locals, { e with desc: call }),
            // the parser rejects it
            None => e,
        },
        EBin(o, a, b) => {
            let b = expr(mut st, cx, locals, b)
            let a = expr(mut st, cx, locals, a)
            set(e, EBin(o, a, b))
        },
        EUn(o, a) => {
            let a = expr(mut st, cx, locals, a)
            set(e, EUn(o, a))
        },
        ECall(callee, args) => match embed_name(cx, locals, callee) {
            Some(name) => embed(mut st, cx, e, name, args),
            None => {
                let args = exprs(mut st, cx, locals, args)
                let callee = expr(mut st, cx, locals, callee)
                set(e, ECall(callee, args))
            },
        },
        ENamed(n, span, a) => {
            let a = expr(mut st, cx, locals, a)
            set(e, ENamed(n, span, a))
        },
        EMut(a) => {
            let a = expr(mut st, cx, locals, a)
            set(e, EMut(a))
        },
        EDyn(a, iface) => {
            let a = expr(mut st, cx, locals, a)
            set(e, EDyn(a, iface))
        },
        EMethod(r, name, nsp, args) => method(mut st, cx, locals, e, r, name, nsp, args),
        EField(r, name, nsp) => field(mut st, cx, locals, e, r, name, nsp),
        EIndex(a, i) => {
            let i = expr(mut st, cx, locals, i)
            let a = expr(mut st, cx, locals, a)
            set(e, EIndex(a, i))
        },
        ETry(a, context) => {
            let context = opt_expr(mut st, cx, locals, context)
            let a = expr(mut st, cx, locals, a)
            set(e, ETry(a, context))
        },
        EIf(c, then, other) => {
            let other = opt_expr(mut st, cx, locals, other)
            let then = block(mut st, cx, locals, then)
            let c = expr(mut st, cx, locals, c)
            set(e, EIf(c, then, other))
        },
        EMatch(s, arms) => {
            let mut out: List[ast.Arm] = []
            for a in arms {
                let inner = binds(a.pat, locals)
                let body = expr(mut st, cx, inner, a.body)
                let guard = opt_expr(mut st, cx, inner, a.guard)
                let p = pat(mut st, cx, locals, a.pat)
                out.push(ast.Arm { pat: p, guard, body })
            }
            let s = expr(mut st, cx, locals, s)
            set(e, EMatch(s, out))
        },
        EBlock(b) => {
            let b = block(mut st, cx, locals, b)
            set(e, EBlock(b))
        },
        EClosure(params, body) => {
            let inner = params.fold(locals, |acc, p| [p.name] + acc)
            let body = expr(mut st, cx, inner, body)
            let mut out: List[ast.ClosureParam] = []
            for p in params {
                let t = opt_ty(mut st, cx, p.ty)
                out.push({ p with ty: t })
            }
            set(e, EClosure(out, body))
        },
        EStruct(n, span, fields) => {
            let n = struct_name(mut st, cx, locals, n, span)
            let fields = inits(mut st, cx, locals, fields)
            set(e, EStruct(n, span, fields))
        },
        EGroup(g, interleaved, until, b) => {
            let b = block(mut st, cx, [g] + locals, b)
            let until = match until {
                Some(d) => {
                    let ms = expr(mut st, cx, locals, d.ms)
                    let clock = expr(mut st, cx, locals, d.clock)
                    Some(ast.Deadline { clock, ms })
                },
                None => None,
            }
            set(e, EGroup(g, interleaved, until, b))
        },
        EWith(base, fields) => {
            let fields = inits(mut st, cx, locals, fields)
            let base = expr(mut st, cx, locals, base)
            set(e, EWith(base, fields))
        },
        ESafe(option, name, rest) => {
            let rest = expr(mut st, cx, [name] + locals, rest)
            let option = expr(mut st, cx, locals, option)
            set(e, ESafe(option, name, rest))
        },
        ESelect(arms) => {
            let mut out: List[ast.SelArm] = []
            for a in arms {
                out.push(sel_arm(mut st, cx, locals, a))
            }
            set(e, ESelect(out))
        },
    }
}

fn exprs(mut st: State, cx: Context, locals: List[Str], xs: List[ast.Expr]) -> List[ast.Expr] {
    let mut out: List[ast.Expr] = []
    for x in xs {
        out.push(expr(mut st, cx, locals, x))
    }
    out
}

fn opt_expr(mut st: State, cx: Context, locals: List[Str], x: Option[ast.Expr]) -> Option[ast.Expr] {
    match x {
        Some(x) => Some(expr(mut st, cx, locals, x)),
        None => None,
    }
}

fn inits(mut st: State, cx: Context, locals: List[Str], fields: List[ast.FieldInit]) -> List[ast.FieldInit] {
    let mut out: List[ast.FieldInit] = []
    for f in fields {
        let value = expr(mut st, cx, locals, f.value)
        out.push({ f with value })
    }
    out
}

fn sel_arm(mut st: State, cx: Context, locals: List[Str], a: ast.SelArm) -> ast.SelArm {
    let guard = opt_expr(mut st, cx, locals, a.guard)
    let (op, body) = match a.op {
        SelRecv(bound, ch) => {
            let inner = match bound {
                Some(b) => [b.text] + locals,
                None => locals,
            }
            let body = expr(mut st, cx, inner, a.body)
            let ch = expr(mut st, cx, locals, ch)
            (SelRecv(bound, ch), body)
        },
        SelSend(ch, v) => {
            let body = expr(mut st, cx, locals, a.body)
            let v = expr(mut st, cx, locals, v)
            let ch = expr(mut st, cx, locals, ch)
            (SelSend(ch, v), body)
        },
        SelAfter(clock, ms) => {
            let body = expr(mut st, cx, locals, a.body)
            let ms = expr(mut st, cx, locals, ms)
            let clock = expr(mut st, cx, locals, clock)
            (SelAfter(clock, ms), body)
        },
        SelDefault => {
            let body = expr(mut st, cx, locals, a.body)
            (SelDefault, body)
        },
    }
    { a with op, guard, body }
}

// `x |> rhs`: the call it stands for, with `x` as the first argument.
// `f(a)` and `r.m(a)` get it in front of their arguments, `f` and `r.m`
// become one-argument calls, and `rhs?` pipes into the call inside the
// `?`. None: nothing can be piped into `rhs`.
fn pipe_call(mut st: State, x: ast.Expr, rhs: ast.Expr) -> Option[ast.ExprDesc] {
    match rhs.desc {
        ECall(f, args) => Some(ECall(f, [x] + args)),
        EMethod(r, m, nsp, args) => Some(EMethod(r, m, nsp, [x] + args)),
        // `r.m` is a method, but `t.0` is a tuple's field
        EField(r, m, nsp) if !starts_with_digit(m) => Some(EMethod(r, m, nsp, [x])),
        EVar(_) | EClosure(..) => Some(ECall(rhs, [x])),
        ETry(inner, context) => match pipe_call(mut st, x, inner) {
            // the call is a new expression: `inner` may be its callee
            Some(call) => {
                let call = st.node(call, ast.merge(x.span, inner.span))
                Some(ETry(call, context))
            },
            None => None,
        },
        _ => None,
    }
}

fn starts_with_digit(s: Str) -> Bool {
    let c = s.slice(0, 1)
    c >= "0" && c <= "9"
}

fn own_enum(cx: Context, locals: List[Str], name: Str) -> Bool {
    if locals.contains(name) {
        return false
    }
    match cx.own.get(name) {
        Some(IEnum(_)) => true,
        _ => false,
    }
}

// `r.name(args)`: a function or a variant of a module when `r` names
// one, a variant of an enum of this module when `r` names that.
fn method(mut st: State, cx: Context, locals: List[Str], e: ast.Expr, r: ast.Expr, name: Str, nsp: ast.Span, args: List[ast.Expr]) -> ast.Expr {
    match r.desc {
        EVar(a) if is_module(cx, locals, a) => {
            let args = exprs(mut st, cx, locals, args)
            let m = match cx.mods.get(a) {
                Some(m) => m,
                None => {
                    return e
                },
            }
            let span = ast.merge(r.span, nsp)
            let found = member(mut st, m, name, nsp)
            match found {
                Some(IFn(_)) => {
                    let callee = st.node(EVar(qual(m, name)), span)
                    set(e, ECall(callee, args))
                },
                Some(_) => {
                    st.fail(diag.error("E0108", span, "`{a}.{name}` is a type, not a function"))
                    e
                },
                None => match variant_enum(m, name) {
                    Some(en) => {
                        let _ = member(mut st, m, en.name, nsp)
                        let recv = st.node(EVar(qual(m, en.name)), r.span)
                        set(e, EMethod(recv, name, nsp, args))
                    },
                    None => {
                        no_member(mut st, m, name, nsp)
                        e
                    },
                },
            }
        },
        EVar(en) if own_enum(cx, locals, en) => {
            let args = exprs(mut st, cx, locals, args)
            set(e, EMethod({ r with desc: EVar(qual(cx.module, en)) }, name, nsp, args))
        },
        _ => {
            let args = exprs(mut st, cx, locals, args)
            let r = expr(mut st, cx, locals, r)
            set(e, EMethod(r, name, nsp, args))
        },
    }
}

// `r.name`: a function or a variant of a module, or a variant of an enum
// of this module, as for `method`.
fn field(mut st: State, cx: Context, locals: List[Str], e: ast.Expr, r: ast.Expr, name: Str, nsp: ast.Span) -> ast.Expr {
    match r.desc {
        EVar(a) if is_module(cx, locals, a) => {
            let m = match cx.mods.get(a) {
                Some(m) => m,
                None => {
                    return e
                },
            }
            let found = member(mut st, m, name, nsp)
            match found {
                Some(IFn(_)) => set(e, EVar(qual(m, name))),
                Some(_) => {
                    st.fail(diag.error("E0404", ast.merge(r.span, nsp), "`{a}.{name}` is a type, not a value"))
                    e
                },
                None => match variant_enum(m, name) {
                    Some(en) => {
                        let _ = member(mut st, m, en.name, nsp)
                        let recv = st.node(EVar(qual(m, en.name)), r.span)
                        set(e, EField(recv, name, nsp))
                    },
                    None => {
                        no_member(mut st, m, name, nsp)
                        e
                    },
                },
            }
        },
        EVar(en) if own_enum(cx, locals, en) => set(e, EField({ r with desc: EVar(qual(cx.module, en)) }, name, nsp)),
        _ => {
            let r = expr(mut st, cx, locals, r)
            set(e, EField(r, name, nsp))
        },
    }
}

// The name of a struct literal: `geo.Point` reaches module `geo`, and a
// struct of this module gets its qualified name.
fn struct_name(mut st: State, cx: Context, locals: List[Str], n: Str, span: ast.Span) -> Str {
    match split_qualified(n) {
        Some((a, b)) => {
            let m = if locals.contains(a) { None } else { module_of(cx, a) }
            match m {
                Some(m) => {
                    let found = member(mut st, m, b, span)
                    match found {
                        Some(IStruct(_)) => qual(m, b),
                        _ => {
                            no_member(mut st, m, b, span)
                            n
                        },
                    }
                },
                None => {
                    unknown_module(mut st, a, span)
                    n
                },
            }
        },
        None => match cx.own.get(n) {
            Some(IStruct(_)) => qual(cx.module, n),
            _ => n,
        },
    }
}

// ---------- embed ----------

// `embed`, `embed_bytes` or `embed_dir` when `callee` names one of them
// and no local or item of the module hides it.
fn embed_name(cx: Context, locals: List[Str], callee: ast.Expr) -> Option[Str] {
    match callee.desc {
        EVar(n) if embeds.is_embed(n) && !locals.contains(n) && !cx.own.contains(n) => Some(n),
        _ => None,
    }
}

// A call of `embed`, `embed_bytes` or `embed_dir`, which becomes what the
// loader read for it: the text, the bytes, or a map of the files.
fn embed(mut st: State, cx: Context, e: ast.Expr, name: Str, args: List[ast.Expr]) -> ast.Expr {
    let sp = e.span
    if embeds.literal_path(args).is_none() {
        let d = diag.error("E0405", sp, "`{name}` takes one argument, a string literal with the path, as in `{name}(\"page.html\")`")
        st.fail(d)
        return set(e, EStr([]))
    }
    let path = embeds.literal_path(args) ?? ""
    let found = cx.found.get(embeds.key(sp)) ?? Problem("`{name}` was not read")
    match found {
        Text(text) => {
            st = { st with embedded: st.embedded + [Embedded { module: cx.module.name, path, size: text.len() }] }
            if name == "embed" {
                set(e, EStr([SPLit(text)]))
            } else {
                let text = st.node(EStr([SPLit(text)]), sp)
                set(e, EMethod(text, "to_bytes", sp, []))
            }
        },
        Files(files) => {
            for f in files {
                st = { st with embedded: st.embedded + [Embedded { module: cx.module.name, path: path + "/" + f.0, size: f.1.len() }] }
            }
            file_map(mut st, e, files)
        },
        Problem(message) => {
            st.fail(diag.error("E0405", sp, message))
            if name == "embed_dir" { file_map(mut st, e, [("", "")]) } else { set(e, EStr([])) }
        },
    }
}

// `map([("css/site.css", "...".to_bytes()), ...])`, the value of
// `embed_dir`. A failed one is a map of one empty file, so the checker
// still sees a Map[Str, Bytes] there.
fn file_map(mut st: State, e: ast.Expr, files: List[(Str, Str)]) -> ast.Expr {
    let sp = e.span
    let mut pairs: List[ast.Expr] = []
    for f in files {
        let key = st.node(EStr([SPLit(f.0)]), sp)
        let text = st.node(EStr([SPLit(f.1)]), sp)
        let bytes = st.node(EMethod(text, "to_bytes", sp, []), sp)
        let fields = [ast.FieldInit { name: "0", span: sp, value: key }, ast.FieldInit { name: "1", span: sp, value: bytes }]
        pairs.push(st.node(EStruct(ast.tuple_name(2), sp, fields), sp))
    }
    let list = st.node(EList(pairs), sp)
    let callee = st.node(EVar("map"), sp)
    set(e, ECall(callee, [list]))
}

// ---------- statements ----------

pub fn block(mut st: State, cx: Context, locals: List[Str], b: ast.Block) -> ast.Block {
    let stmts = expand_stmts(mut st, b.stmts)
    let mut inner = locals
    let mut out: List[ast.Stmt] = []
    for s in stmts {
        let desc = match s.desc {
            SLet(m, n, span, t, x) => {
                let x = expr(mut st, cx, inner, x)
                inner = [n] + inner
                let t = opt_ty(mut st, cx, t)
                SLet(m, n, span, t, x)
            },
            SAssign(a, b) => {
                let b = expr(mut st, cx, inner, b)
                let a = expr(mut st, cx, inner, a)
                SAssign(a, b)
            },
            SExpr(x) => {
                let x = expr(mut st, cx, inner, x)
                SExpr(x)
            },
            SReturn(x) => {
                let x = opt_expr(mut st, cx, inner, x)
                SReturn(x)
            },
            SWhile(c, body) => {
                let body = block(mut st, cx, inner, body)
                let c = expr(mut st, cx, inner, c)
                SWhile(c, body)
            },
            SFor(n, span, items, body) => {
                let body = block(mut st, cx, [n] + inner, body)
                let items = expr(mut st, cx, inner, items)
                SFor(n, span, items, body)
            },
            SDefer(body) => {
                let body = block(mut st, cx, inner, body)
                SDefer(body)
            },
            // SLetPat and SForPat are expanded already
            SBreak | SContinue | SLetPat(..) | SForPat(..) => s.desc,
        }
        out.push({ s with desc })
    }
    let tail = opt_expr(mut st, cx, inner, b.tail)
    { b with stmts: out, tail }
}

fn is_tuple_assign(s: ast.Stmt) -> Bool {
    match s.desc {
        SAssign(lhs, _) => match lhs.desc {
            EStruct(n, _, _) => ast.is_tuple_name(n),
            _ => false,
        },
        _ => false,
    }
}

fn needs_expanding(s: ast.Stmt) -> Bool {
    match s.desc {
        SLetPat(..) | SForPat(..) => true,
        _ => is_tuple_assign(s),
    }
}

// The statements with `let (a, b) = e`, `for (k, v) in xs { ... }` and
// `(a, b) = e` written out in plain statements.
fn expand_stmts(mut st: State, stmts: List[ast.Stmt]) -> List[ast.Stmt] {
    if !stmts.any(needs_expanding) {
        return stmts
    }
    let mut out: List[ast.Stmt] = []
    for s in stmts {
        let more = match s.desc {
            SAssign(lhs, e) if is_tuple_assign(s) => assign_parts(mut st, lhs, e, s.span),
            SLetPat(p, e) => unpack(mut st, p, e),
            // `for t in xs { let (k, v) = t; body }`
            SForPat(p, items, body) => {
                let n = st.temp()
                let tmp = "item$" + n.to_str()
                let v = st.node(EVar(tmp), p.span)
                let lets = unpack(mut st, p, v)
                [{ s with desc: SFor(tmp, p.span, items, { body with stmts: lets + body.stmts }) }]
            },
            _ => [s],
        }
        out = out + more
    }
    out
}

// `let (a, (b, _)) = e` as `let t = e; let a = t.0; let u = t.1;
// let b = u.0`. A struct pattern checks the value's type with a match that
// cannot fail: `let Point \{ x, y: (a, _) } = e` as
// `let t = match e \{ Point \{ x: _, y: _ } as s => s }; let x = t.x; ...`,
// so the checker reports a wrong type, an unknown field or a missing `..`
// at the pattern, as it does in `match`.
fn unpack(mut st: State, p: ast.Pat, e: ast.Expr) -> List[ast.Stmt] {
    let n = st.temp()
    let tmp = "tuple$" + n.to_str()
    match p.desc {
        PStruct(name, name_span, fields, rest) => {
            let whole = "struct$" + n.to_str()
            let wild = fields.map(|f| ast.FieldPat { name: f.name, span: f.span, pat: ast.Pat { desc: PWild, span: f.pat.span } })
            let shape = ast.Pat { desc: PStruct(name, name_span, wild, rest), span: p.span }
            let body = st.node(EVar(whole), p.span)
            let arm = ast.Arm { pat: ast.Pat { desc: PAs(shape, whole, p.span), span: p.span }, guard: None, body }
            let checked = st.node(EMatch(e, [arm]), p.span)
            let mut out = [ast.Stmt { desc: SLet(false, tmp, p.span, None, checked), span: p.span }]
            for f in fields {
                let more = unpack_part(mut st, tmp, f.name, f.pat, p.span)
                out = out + more
            }
            out
        },
        PTuple(parts) => {
            let mut out = [ast.Stmt { desc: SLet(false, tmp, p.span, None, e), span: p.span }]
            for (i, sub) in parts.with_index() {
                let more = unpack_part(mut st, tmp, i.to_str(), sub, p.span)
                out = out + more
            }
            out
        },
        PBind(name) => {
            let first = ast.Stmt { desc: SLet(false, tmp, p.span, None, e), span: p.span }
            let var = st.node(EVar(tmp), p.span)
            [first, ast.Stmt { desc: SLet(false, name, p.span, None, var), span: p.span }]
        },
        _ => [ast.Stmt { desc: SLet(false, tmp, p.span, None, e), span: p.span }],
    }
}

// The statements for the part `field` of the temporary `tmp`, taken apart
// by `sub`.
fn unpack_part(mut st: State, tmp: Str, field: Str, sub: ast.Pat, span: ast.Span) -> List[ast.Stmt] {
    let var = st.node(EVar(tmp), span)
    let part = st.node(EField(var, field, sub.span), span)
    match sub.desc {
        PBind(name) => [ast.Stmt { desc: SLet(false, name, sub.span, None, part), span: sub.span }],
        PWild => [],
        _ => unpack(mut st, sub, part),
    }
}

// `(a, (b, _)) = e` as `let $assign1 = e; a = $assign1.0;
// let $assign2 = $assign1.1; b = $assign2.0`: the right side first, then
// each target, left to right. Each `let` is annotated with the tuple's
// type name alone (`#tuple2`), which says how many parts the left side
// takes; the checker checks the right side against it.
fn assign_parts(mut st: State, lhs: ast.Expr, e: ast.Expr, span: ast.Span) -> List[ast.Stmt] {
    match lhs.desc {
        EStruct(n, _, targets) if ast.is_tuple_name(n) => {
            let k = st.temp()
            let tmp = "$assign" + k.to_str()
            let annotation = ast.TyExpr { desc: TyName(n, []), span: lhs.span }
            let mut out = [ast.Stmt { desc: SLet(false, tmp, lhs.span, Some(annotation), e), span }]
            for (i, f) in targets.with_index() {
                let target = f.value
                match target.desc {
                    EVar("_") => {},
                    _ => {
                        let var = st.node(EVar(tmp), target.span)
                        let part = st.node(EField(var, i.to_str(), target.span), target.span)
                        let more = assign_parts(mut st, target, part, target.span)
                        out = out + more
                    },
                }
            }
            out
        },
        _ => [ast.Stmt { desc: SAssign(lhs, e), span }],
    }
}

// ---------- items ----------

// Built-in types a file can add methods to; such a method belongs to its
// file, so it is named after the module too.
fn builtin_method_types() -> List[Str] {
    ["Int", "Float", "Bool", "Str", "Bytes", "List", "Map", "Option", "Result", "IoError"]
}

// Item `i` of the module in `cx`, renamed. Its parts are renamed in the
// order the OCaml loader renames them, which decides the order of the
// problems found.
pub fn item(mut st: State, cx: Context, i: ast.Item) -> ast.Item {
    match i {
        IFn(d) => {
            let cx = { cx with gens: d.generics }
            let mut params: List[ast.Param] = []
            for p in d.params {
                let t = ty(mut st, cx, [], p.ty)
                params.push({ p with ty: t })
            }
            let name = if d.test.is_some() {
                d.name
            } else if is_method(i) {
                match params[0].ty.desc {
                    TyName(t, _) if builtin_method_types().contains(t) => qual(cx.module, t + "::" + d.name),
                    TyName(t, _) => t + "::" + d.name,
                    // the checker reports the bad `self`
                    _ => qual(cx.module, d.name),
                }
            } else {
                qual(cx.module, d.name)
            }
            let bs = bounds(mut st, cx, d.bounds)
            let body = block(mut st, cx, d.params.map(|p| p.name), d.body)
            let ret = opt_ty(mut st, cx, d.ret)
            // a standard library module trusted with C (src/std/limen.toml [trust])
            let trusted = is_std(cx.module) && cx.trusted.contains(std_name(cx.module))
            let foreign = d.foreign.map(|f| { f with trusted })
            IFn({ d with name, params, bounds: bs, body, ret, foreign })
        },
        IStruct(s) => {
            let cx = { cx with gens: s.generics }
            let foreign = match s.foreign {
                Some(f) => {
                    let ts = types(mut st, cx, f.types)
                    Some({ f with types: ts })
                },
                None => None,
            }
            let bs = bounds(mut st, cx, s.bounds)
            // a C struct's Int32 fields are Ints to the rest of Limen, as
            // Int32 parameters are; the types as written stay in `foreign`
            let int32_as_int = |t: ast.TyExpr| match t.desc {
                TyName("Int32", []) if s.foreign.is_some() => { t with desc: TyName("Int", []) },
                _ => t,
            }
            let mut fields: List[ast.Field] = []
            for f in s.fields {
                let t = ty(mut st, cx, [], int32_as_int(f.ty))
                fields.push({ f with ty: t })
            }
            IStruct({ s with name: qual(cx.module, s.name), fields, foreign, bounds: bs })
        },
        IIface(f) => {
            let cx = { cx with gens: f.generics }
            let mut methods: List[ast.Method] = []
            for m in f.methods {
                let ret = opt_ty(mut st, cx, m.ret)
                let mut params: List[ast.Param] = []
                for p in m.params {
                    let t = ty(mut st, cx, [], p.ty)
                    params.push({ p with ty: t })
                }
                methods.push({ m with params, ret })
            }
            IIface({ f with name: qual(cx.module, f.name), methods })
        },
        IEnum(e) => {
            let cx = { cx with gens: e.generics }
            let bs = bounds(mut st, cx, e.bounds)
            let mut variants: List[ast.Variant] = []
            for v in e.variants {
                let payload = types(mut st, cx, v.payload)
                variants.push({ v with payload })
            }
            IEnum({ e with name: qual(cx.module, e.name), variants, bounds: bs })
        },
        // expanded where it is used, and kept, expanded, so the checker
        // checks its body even if nothing uses it
        IType(a) => {
            let cx = { cx with gens: a.generics }
            let name = qual(cx.module, a.name)
            let body = ty(mut st, cx, [name], a.body)
            IType({ a with name, body })
        },
    }
}
