// Renaming: what the module loader does to each item of each module so the
// checker sees one flat program, as src/modules.ml does it.
//
// - Every item of module `m` is renamed `m.item` (the main file keeps its
//   names), and every reference is rewritten to match, scope-aware: inside
//   module `m`, a name that is one of `m`'s items means that item unless a
//   local hides it, and `geo.area(...)`, `geo.Shape`, `geo.Point { ... }`,
//   `geo.Circle(...)` and the pattern `geo.Circle(r)` reach module `geo`,
//   which the file must `use`, and only its `pub` items.
// - Type aliases are expanded where they are used.
// - `x |> f(a)` becomes `f(x, a)`.
// - `let (a, b) = e`, `for (k, v) in xs` and `(x, p) = f(p)` become plain
//   lets, loops and assignments through a temporary.
// - `embed(...)`, `embed_bytes(...)` and `embed_dir(...)` become the
//   literals the loader read for them (selfhost/embeds.lmn).
//
// Renaming is pure: the loader hands it everything it needs, files read
// included. Its state (the problems found, a count for the temporaries'
// names, the next expression id) goes in and comes out of every function,
// `(expr, st) = expr(st, cx, locals, e)`.
//
// The problems come out in the order the OCaml loader finds them, and that
// order is OCaml's: it evaluates the arguments of a function or a
// constructor last to first, so it renames `a + b` by renaming `b` first,
// an `if` from its `else` back to its condition, and a call's arguments
// before its callee. The temporaries are numbered in that order too.
use ast
use diag
use embeds

// A module of the program: the main file (named "") or one it uses.
pub struct Module {
    name: Str,
    // its path as the loader writes it: "./geo.lmn", "<std>/json.lmn"
    path: Str,
    // its number in the program's file table
    file: Int,
    items: List[ast.Item],
    uses: List[ast.Name],
    // the limen.toml dependency it belongs to
    package: Option[Str],
}

pub fn is_std(m: Module) -> Bool {
    m.path.starts_with("<std>")
}

// A standard library module's name in the standard library, its file's:
// the program calls it `std/NAME` when it has a module NAME of its own.
pub fn std_name(m: Module) -> Str {
    m.path.slice(6, m.path.len() - 4)
}

// What renaming needs to know, the same for a whole item.
pub struct Context {
    // the module being renamed
    module: Module,
    // every module by name
    mods: Map[Str, Module],
    // the module's items by name, methods left out
    own: Map[Str, ast.Item],
    // the type parameters in scope
    gens: List[Str],
    // what each `embed` call of the module found, by embeds.key
    found: Map[Str, embeds.Found],
    // the standard library modules whose C calls are trusted
    trusted: List[Str],
}

// A file `embed` read: the module (main for the main file), the path as
// written, and its size in bytes; `limen caps` lists them.
pub struct Embedded {
    module: Str,
    path: Str,
    size: Int,
}

pub struct State {
    // the problems found so far, in order
    errors: List[diag.Diag],
    // how many temporaries have been named, `tuple$N`, `item$N`, `$assignN`
    temps: Int,
    // the id the next expression made here gets
    next_id: Int,
    // the aliases reported as containing themselves, each reported once
    cyclic: List[Str],
    embedded: List[Embedded],
}

fn fail(self: State, d: diag.Diag) -> State {
    { self with errors: self.errors + [d] }
}

// A new expression, with the next id.
fn node(self: State, desc: ast.ExprDesc, span: ast.Span) -> (ast.Expr, State) {
    (ast.Expr { desc, span, id: self.next_id }, { self with next_id: self.next_id + 1 })
}

// The next temporary's number.
fn temp(self: State) -> (Int, State) {
    (self.temps + 1, { self with temps: self.temps + 1 })
}

// ---------- items ----------

// A method is a function whose first parameter is `self`; it is named
// `Type::name` and called as `value.name(...)`, never by its bare name.
pub fn is_method(i: ast.Item) -> Bool {
    match i {
        IFn(d) => d.test.is_none() && (d.params.first().map(|p| p.name == "self") ?? false),
        _ => false,
    }
}

pub fn item_name(i: ast.Item) -> Str {
    match i {
        IFn(d) => d.name,
        IStruct(s) => s.name,
        IEnum(e) => e.name,
        IIface(f) => f.name,
        IType(a) => a.name,
    }
}

pub fn item_span(i: ast.Item) -> ast.Span {
    match i {
        IFn(d) => d.span,
        IStruct(s) => s.span,
        IEnum(e) => e.span,
        IIface(f) => f.span,
        IType(a) => a.span,
    }
}

pub fn is_public(i: ast.Item) -> Bool {
    match i {
        IFn(d) => d.public,
        IStruct(s) => s.public,
        IEnum(e) => e.public,
        IIface(f) => f.public,
        IType(a) => a.public,
    }
}

// A module's items by name, methods left out; a later one wins.
pub fn own_items(items: List[ast.Item]) -> Map[Str, ast.Item] {
    let mut own: Map[Str, ast.Item] = map()
    for i in items {
        if !is_method(i) {
            own[item_name(i)] = i
        }
    }
    own
}

pub fn qual(m: Module, name: Str) -> Str {
    if m.name == "" { name } else { m.name + "." + name }
}

// ---------- modules ----------

fn uses(cx: Context, name: Str) -> Bool {
    cx.module.uses.any(|u| u.text == name)
}

// The module `name` names here, if the file uses it.
fn module_of(cx: Context, name: Str) -> Option[Module] {
    if uses(cx, name) { cx.mods.get(name) } else { None }
}

// Whether `name` names a module here: the file uses it and no local hides it.
fn is_module(cx: Context, locals: List[Str], name: Str) -> Bool {
    !locals.contains(name) && uses(cx, name)
}

// Item `name` of module `m`, used from another module: it must be pub.
fn member(st: State, m: Module, name: Str, span: ast.Span) -> (Option[ast.Item], State) {
    match m.items.find(|i| item_name(i) == name && !is_method(i)) {
        Some(i) => {
            if is_public(i) {
                (Some(i), st)
            } else {
                let d = diag.error("E0402", span, "`{name}` is private to module `{m.name}`").note("mark it `pub fn`, `pub struct` or `pub enum` in {m.path} to export it")
                (Some(i), st.fail(d))
            }
        },
        None => (None, st),
    }
}

// The enum of `m` that has variant `v`.
fn variant_enum(m: Module, v: Str) -> Option[ast.EnumDecl] {
    for i in m.items {
        match i {
            IEnum(e) if e.variants.any(|x| x.name == v) => {
                return Some(e)
            },
            _ => {},
        }
    }
    None
}

fn no_member(st: State, m: Module, name: Str, span: ast.Span) -> State {
    let exported = m.items.filter(|i| is_public(i) && !is_method(i)).map(item_name).sort()
    let d = diag.error("E0403", span, "module `{m.name}` has no `{name}`")
    st.fail(if exported.is_empty() { d } else { d.note("it exports: " + exported.join(", ")) })
}

fn unknown_module(st: State, name: Str, span: ast.Span) -> State {
    st.fail(diag.error("E0401", span, "unknown module `{name}`; add `use {name}` at the top of the file"))
}

// `geo.Shape` as ("geo", "Shape"), split at the first dot.
fn split_qualified(n: Str) -> Option[(Str, Str)] {
    n.index_of(".").map(|i| (n.slice(0, i), n.slice(i + 1, n.len())))
}

// ---------- types ----------

// A type with module names resolved and aliases expanded. `seen`: the
// aliases being expanded around this one, to catch `type A = List[A]`.
pub fn ty(st: State, cx: Context, seen: List[Str], t: ast.TyExpr) -> (ast.TyExpr, State) {
    match t.desc {
        TyName(n, args) => {
            let (args, st) = each(st, args, |st, a| ty(st, cx, seen, a))
            let named = |name: Str| { t with desc: TyName(name, args) }
            match split_qualified(n) {
                Some((a, b)) => match module_of(cx, a) {
                    Some(m) => {
                        let (found, st) = member(st, m, b, t.span)
                        match found {
                            Some(IType(alias)) => expand(st, cx, seen, m, alias, args, t),
                            Some(IStruct(_) | IEnum(_) | IIface(_)) => (named(qual(m, b)), st),
                            _ => (named(n), no_member(st, m, b, t.span)),
                        }
                    },
                    None => (named(n), unknown_module(st, a, t.span)),
                },
                None => {
                    if cx.gens.contains(n) {
                        return (named(n), st)
                    }
                    match cx.own.get(n) {
                        Some(IType(alias)) => expand(st, cx, seen, cx.module, alias, args, t),
                        Some(IStruct(_) | IEnum(_) | IIface(_)) => (named(qual(cx.module, n)), st),
                        _ => (named(n), st),
                    }
                },
            }
        },
        TyFn(params, ret) => {
            let (ret, st) = ty(st, cx, seen, ret)
            let (params, st) = each(st, params, |st, p| ty(st, cx, seen, p))
            ({ t with desc: TyFn(params, ret) }, st)
        },
        TyUnit | TyInt(_) => (t, st),
    }
}

// Alias `alias` of module `m`, used at `t` with `args` (already resolved):
// its body, resolved in `m`, with the arguments put in for its parameters.
fn expand(st: State, cx: Context, seen: List[Str], m: Module, alias: ast.AliasDecl, args: List[ast.TyExpr], t: ast.TyExpr) -> (ast.TyExpr, State) {
    let key = qual(m, alias.name)
    let bad = { t with desc: TyName(key, []) }
    if seen.contains(key) {
        if st.cyclic.contains(key) {
            return (bad, st)
        }
        let d = diag.error("E0116", alias.span, "type alias `{alias.name}` refers to itself").note("an alias is only another name; for a type that contains itself, declare a struct or enum")
        return (bad, { st.fail(d) with cyclic: st.cyclic + [key] })
    }
    let k = alias.generics.len()
    if args.len() != k {
        let s = if k == 1 { "" } else { "s" }
        return (bad, st.fail(diag.error("E0109", t.span, "`{alias.name}` takes {k} type argument{s}, found {args.len()}")))
    }
    let own = if m.name == cx.module.name { cx.own } else { own_items(m.items) }
    let alias_cx = { cx with module: m, own, gens: alias.generics }
    let (body, st) = ty(st, alias_cx, [key] + seen, alias.body)
    let pairs = alias.generics.zip(args)
    // errors about the expanded type point where the alias is used
    ({ subst(pairs, body) with span: t.span }, st)
}

// `t` with the type parameters in `pairs` replaced by their arguments.
fn subst(pairs: List[(Str, ast.TyExpr)], t: ast.TyExpr) -> ast.TyExpr {
    match t.desc {
        TyName(g, []) if pairs.any(|p| p.0 == g) => pairs.find(|p| p.0 == g).map(|p| p.1) ?? t,
        TyName(n, args) => { t with desc: TyName(n, args.map(|a| subst(pairs, a))) },
        TyFn(params, ret) => { t with desc: TyFn(params.map(|p| subst(pairs, p)), subst(pairs, ret)) },
        TyUnit | TyInt(_) => t,
    }
}

fn types(st: State, cx: Context, ts: List[ast.TyExpr]) -> (List[ast.TyExpr], State) {
    each(st, ts, |st, t| ty(st, cx, [], t))
}

fn bounds(st: State, cx: Context, bs: List[ast.Bound]) -> (List[ast.Bound], State) {
    each(st, bs, |st, b| {
        let (ifaces, st) = types(st, cx, b.ifaces)
        ({ b with ifaces }, st)
    })
}

// ---------- patterns ----------

// The names pattern `p` binds, added to `locals`.
fn binds(p: ast.Pat, locals: List[Str]) -> List[Str] {
    match p.desc {
        PBind(n) | PRest(Some(n)) => [n] + locals,
        PVariant(_, _, ps) | PTuple(ps) | PList(ps) | POr(ps) => ps.fold(locals, |acc, x| binds(x, acc)),
        PStruct(_, _, fields, _) => fields.fold(locals, |acc, f| binds(f.pat, acc)),
        PAs(q, n, _) => binds(q, [n] + locals),
        _ => locals,
    }
}

fn pat(st: State, cx: Context, locals: List[Str], p: ast.Pat) -> (ast.Pat, State) {
    let sub = |st: State, ps: List[ast.Pat]| each(st, ps, |st, x| pat(st, cx, locals, x))
    match p.desc {
        PVariant(Some(q), v, ps) => {
            let (ps, st) = sub(st, ps)
            let (q, st) = if is_module(cx, locals, q) {
                match cx.mods.get(q) {
                    Some(m) => match variant_enum(m, v) {
                        Some(e) => {
                            let (_, st) = member(st, m, e.name, p.span)
                            (qual(m, e.name), st)
                        },
                        None => (q, no_member(st, m, v, p.span)),
                    },
                    None => (q, st),
                }
            } else {
                match cx.own.get(q) {
                    Some(IEnum(_)) => (qual(cx.module, q), st),
                    _ => (q, st),
                }
            }
            ({ p with desc: PVariant(Some(q), v, ps) }, st)
        },
        PVariant(None, v, ps) => {
            let (ps, st) = sub(st, ps)
            ({ p with desc: PVariant(None, v, ps) }, st)
        },
        PTuple(ps) => {
            let (ps, st) = sub(st, ps)
            ({ p with desc: PTuple(ps) }, st)
        },
        PList(ps) => {
            let (ps, st) = sub(st, ps)
            ({ p with desc: PList(ps) }, st)
        },
        POr(ps) => {
            let (ps, st) = sub(st, ps)
            ({ p with desc: POr(ps) }, st)
        },
        PStruct(n, nsp, fields, rest) => {
            let (n, st) = struct_name(st, cx, locals, n, nsp)
            let (fields, st) = each(st, fields, |st, f| {
                let (q, st) = pat(st, cx, locals, f.pat)
                ({ f with pat: q }, st)
            })
            ({ p with desc: PStruct(n, nsp, fields, rest) }, st)
        },
        PAs(q, n, nsp) => {
            let (q, st) = pat(st, cx, locals, q)
            ({ p with desc: PAs(q, n, nsp) }, st)
        },
        _ => (p, st),
    }
}

// ---------- expressions ----------

fn set(e: ast.Expr, desc: ast.ExprDesc, st: State) -> (ast.Expr, State) {
    ({ e with desc }, st)
}

pub fn expr(st: State, cx: Context, locals: List[Str], e: ast.Expr) -> (ast.Expr, State) {
    let ex = |st: State, x: ast.Expr| expr(st, cx, locals, x)
    let exs = |st: State, xs: List[ast.Expr]| each(st, xs, ex)
    match e.desc {
        EInt(_) | EFloat(_) | EBool(_) | EUnit => (e, st),
        EStr(parts) => {
            let (parts, st) = each(st, parts, |st, part| match part {
                SPLit(_) => (part, st),
                SPExpr(x) => {
                    let (x, st) = ex(st, x)
                    (SPExpr(x), st)
                },
            })
            set(e, EStr(parts), st)
        },
        EVar(n) => {
            if locals.contains(n) {
                return (e, st)
            }
            match cx.own.get(n) {
                Some(IFn(_)) => set(e, EVar(qual(cx.module, n)), st),
                _ => {
                    if !is_module(cx, locals, n) {
                        return (e, st)
                    }
                    (e, st.fail(diag.error("E0404", e.span, "module `{n}` is not a value; use one of its items, such as `{n}.name`")))
                },
            }
        },
        EList(items) => {
            let (items, st) = exs(st, items)
            set(e, EList(items), st)
        },
        // `x |> f(a)` is `f(x, a)` from here on
        EPipe(x, rhs) => match pipe_call(st, x, rhs) {
            (Some(call), st) => ex(st, { e with desc: call }),
            // the parser rejects it
            (None, st) => (e, st),
        },
        EBin(o, a, b) => {
            let (b, st) = ex(st, b)
            let (a, st) = ex(st, a)
            set(e, EBin(o, a, b), st)
        },
        EUn(o, a) => {
            let (a, st) = ex(st, a)
            set(e, EUn(o, a), st)
        },
        ECall(callee, args) => match embed_name(cx, locals, callee) {
            Some(name) => embed(st, cx, e, name, args),
            None => {
                let (args, st) = exs(st, args)
                let (callee, st) = ex(st, callee)
                set(e, ECall(callee, args), st)
            },
        },
        ENamed(n, span, a) => {
            let (a, st) = ex(st, a)
            set(e, ENamed(n, span, a), st)
        },
        EMut(a) => {
            let (a, st) = ex(st, a)
            set(e, EMut(a), st)
        },
        EDyn(a, iface) => {
            let (a, st) = ex(st, a)
            set(e, EDyn(a, iface), st)
        },
        EMethod(r, name, nsp, args) => method(st, cx, locals, e, r, name, nsp, args),
        EField(r, name, nsp) => field(st, cx, locals, e, r, name, nsp),
        EIndex(a, i) => {
            let (i, st) = ex(st, i)
            let (a, st) = ex(st, a)
            set(e, EIndex(a, i), st)
        },
        ETry(a, context) => {
            let (context, st) = maybe(st, context, ex)
            let (a, st) = ex(st, a)
            set(e, ETry(a, context), st)
        },
        EIf(c, then, other) => {
            let (other, st) = maybe(st, other, ex)
            let (then, st) = block(st, cx, locals, then)
            let (c, st) = ex(st, c)
            set(e, EIf(c, then, other), st)
        },
        EMatch(s, arms) => {
            let (arms, st) = each(st, arms, |st, a| {
                let inner = binds(a.pat, locals)
                let (body, st) = expr(st, cx, inner, a.body)
                let (guard, st) = maybe(st, a.guard, |st, g| expr(st, cx, inner, g))
                let (p, st) = pat(st, cx, locals, a.pat)
                (ast.Arm { pat: p, guard, body }, st)
            })
            let (s, st) = ex(st, s)
            set(e, EMatch(s, arms), st)
        },
        EBlock(b) => {
            let (b, st) = block(st, cx, locals, b)
            set(e, EBlock(b), st)
        },
        EClosure(params, body) => {
            let inner = params.fold(locals, |acc, p| [p.name] + acc)
            let (body, st) = expr(st, cx, inner, body)
            let (params, st) = each(st, params, |st, p| {
                let (t, st) = maybe(st, p.ty, |st, t| ty(st, cx, [], t))
                ({ p with ty: t }, st)
            })
            set(e, EClosure(params, body), st)
        },
        EStruct(n, span, fields) => {
            let (n, st) = struct_name(st, cx, locals, n, span)
            let (fields, st) = inits(st, cx, locals, fields)
            set(e, EStruct(n, span, fields), st)
        },
        EGroup(g, interleaved, until, b) => {
            let (b, st) = block(st, cx, [g] + locals, b)
            let (until, st) = maybe(st, until, |st, d| {
                let (ms, st) = ex(st, d.ms)
                let (clock, st) = ex(st, d.clock)
                (ast.Deadline { clock, ms }, st)
            })
            set(e, EGroup(g, interleaved, until, b), st)
        },
        EWith(base, fields) => {
            let (fields, st) = inits(st, cx, locals, fields)
            let (base, st) = ex(st, base)
            set(e, EWith(base, fields), st)
        },
        ESafe(option, name, rest) => {
            let (rest, st) = expr(st, cx, [name] + locals, rest)
            let (option, st) = ex(st, option)
            set(e, ESafe(option, name, rest), st)
        },
        ESelect(arms) => {
            let (arms, st) = each(st, arms, |st, a| sel_arm(st, cx, locals, a))
            set(e, ESelect(arms), st)
        },
    }
}

fn inits(st: State, cx: Context, locals: List[Str], fields: List[ast.FieldInit]) -> (List[ast.FieldInit], State) {
    each(st, fields, |st, f| {
        let (value, st) = expr(st, cx, locals, f.value)
        ({ f with value }, st)
    })
}

fn sel_arm(st: State, cx: Context, locals: List[Str], a: ast.SelArm) -> (ast.SelArm, State) {
    let ex = |st: State, x: ast.Expr| expr(st, cx, locals, x)
    let (guard, st) = maybe(st, a.guard, ex)
    let (op, body, st) = match a.op {
        SelRecv(bound, ch) => {
            let inner = match bound {
                Some(b) => [b.text] + locals,
                None => locals,
            }
            let (body, st) = expr(st, cx, inner, a.body)
            let (ch, st) = ex(st, ch)
            (SelRecv(bound, ch), body, st)
        },
        SelSend(ch, v) => {
            let (body, st) = ex(st, a.body)
            let (v, st) = ex(st, v)
            let (ch, st) = ex(st, ch)
            (SelSend(ch, v), body, st)
        },
        SelAfter(clock, ms) => {
            let (body, st) = ex(st, a.body)
            let (ms, st) = ex(st, ms)
            let (clock, st) = ex(st, clock)
            (SelAfter(clock, ms), body, st)
        },
        SelDefault => {
            let (body, st) = ex(st, a.body)
            (SelDefault, body, st)
        },
    }
    ({ a with op, guard, body }, st)
}

// `x |> rhs`: the call it stands for, with `x` as the first argument.
// `f(a)` and `r.m(a)` get it in front of their arguments, `f` and `r.m`
// become one-argument calls, and `rhs?` pipes into the call inside the
// `?`. None: nothing can be piped into `rhs`.
fn pipe_call(st: State, x: ast.Expr, rhs: ast.Expr) -> (Option[ast.ExprDesc], State) {
    match rhs.desc {
        ECall(f, args) => (Some(ECall(f, [x] + args)), st),
        EMethod(r, m, nsp, args) => (Some(EMethod(r, m, nsp, [x] + args)), st),
        // `r.m` is a method, but `t.0` is a tuple's field
        EField(r, m, nsp) if !starts_with_digit(m) => (Some(EMethod(r, m, nsp, [x])), st),
        EVar(_) | EClosure(..) => (Some(ECall(rhs, [x])), st),
        ETry(inner, context) => match pipe_call(st, x, inner) {
            // the call is a new expression: `inner` may be its callee
            (Some(call), st) => {
                let (call, st) = st.node(call, ast.merge(x.span, inner.span))
                (Some(ETry(call, context)), st)
            },
            (None, st) => (None, st),
        },
        _ => (None, st),
    }
}

fn starts_with_digit(s: Str) -> Bool {
    let c = s.slice(0, 1)
    c >= "0" && c <= "9"
}

fn own_enum(cx: Context, locals: List[Str], name: Str) -> Bool {
    if locals.contains(name) {
        return false
    }
    match cx.own.get(name) {
        Some(IEnum(_)) => true,
        _ => false,
    }
}

// `r.name(args)`: a function or a variant of a module when `r` names
// one, a variant of an enum of this module when `r` names that.
fn method(st: State, cx: Context, locals: List[Str], e: ast.Expr, r: ast.Expr, name: Str, nsp: ast.Span, args: List[ast.Expr]) -> (ast.Expr, State) {
    let ex = |st: State, x: ast.Expr| expr(st, cx, locals, x)
    match r.desc {
        EVar(a) if is_module(cx, locals, a) => {
            let (args, st) = each(st, args, ex)
            let m = match cx.mods.get(a) {
                Some(m) => m,
                None => {
                    return (e, st)
                },
            }
            let span = ast.merge(r.span, nsp)
            let (found, st) = member(st, m, name, nsp)
            match found {
                Some(IFn(_)) => {
                    let (callee, st) = st.node(EVar(qual(m, name)), span)
                    set(e, ECall(callee, args), st)
                },
                Some(_) => (e, st.fail(diag.error("E0108", span, "`{a}.{name}` is a type, not a function"))),
                None => match variant_enum(m, name) {
                    Some(en) => {
                        let (_, st) = member(st, m, en.name, nsp)
                        let (recv, st) = st.node(EVar(qual(m, en.name)), r.span)
                        set(e, EMethod(recv, name, nsp, args), st)
                    },
                    None => (e, no_member(st, m, name, nsp)),
                },
            }
        },
        EVar(en) if own_enum(cx, locals, en) => {
            let (args, st) = each(st, args, ex)
            set(e, EMethod({ r with desc: EVar(qual(cx.module, en)) }, name, nsp, args), st)
        },
        _ => {
            let (args, st) = each(st, args, ex)
            let (r, st) = ex(st, r)
            set(e, EMethod(r, name, nsp, args), st)
        },
    }
}

// `r.name`: a function or a variant of a module, or a variant of an enum
// of this module, as for `method`.
fn field(st: State, cx: Context, locals: List[Str], e: ast.Expr, r: ast.Expr, name: Str, nsp: ast.Span) -> (ast.Expr, State) {
    match r.desc {
        EVar(a) if is_module(cx, locals, a) => {
            let m = match cx.mods.get(a) {
                Some(m) => m,
                None => {
                    return (e, st)
                },
            }
            let (found, st) = member(st, m, name, nsp)
            match found {
                Some(IFn(_)) => set(e, EVar(qual(m, name)), st),
                Some(_) => (e, st.fail(diag.error("E0404", ast.merge(r.span, nsp), "`{a}.{name}` is a type, not a value"))),
                None => match variant_enum(m, name) {
                    Some(en) => {
                        let (_, st) = member(st, m, en.name, nsp)
                        let (recv, st) = st.node(EVar(qual(m, en.name)), r.span)
                        set(e, EField(recv, name, nsp), st)
                    },
                    None => (e, no_member(st, m, name, nsp)),
                },
            }
        },
        EVar(en) if own_enum(cx, locals, en) => set(e, EField({ r with desc: EVar(qual(cx.module, en)) }, name, nsp), st),
        _ => {
            let (r, st) = expr(st, cx, locals, r)
            set(e, EField(r, name, nsp), st)
        },
    }
}

// The name of a struct literal: `geo.Point` reaches module `geo`, and a
// struct of this module gets its qualified name.
fn struct_name(st: State, cx: Context, locals: List[Str], n: Str, span: ast.Span) -> (Str, State) {
    match split_qualified(n) {
        Some((a, b)) => {
            let m = if locals.contains(a) { None } else { module_of(cx, a) }
            match m {
                Some(m) => {
                    let (found, st) = member(st, m, b, span)
                    match found {
                        Some(IStruct(_)) => (qual(m, b), st),
                        _ => (n, no_member(st, m, b, span)),
                    }
                },
                None => (n, unknown_module(st, a, span)),
            }
        },
        None => match cx.own.get(n) {
            Some(IStruct(_)) => (qual(cx.module, n), st),
            _ => (n, st),
        },
    }
}

// ---------- embed ----------

// `embed`, `embed_bytes` or `embed_dir` when `callee` names one of them
// and no local or item of the module hides it.
fn embed_name(cx: Context, locals: List[Str], callee: ast.Expr) -> Option[Str] {
    match callee.desc {
        EVar(n) if embeds.is_embed(n) && !locals.contains(n) && !cx.own.contains(n) => Some(n),
        _ => None,
    }
}

// A call of `embed`, `embed_bytes` or `embed_dir`, which becomes what the
// loader read for it: the text, the bytes, or a map of the files.
fn embed(st: State, cx: Context, e: ast.Expr, name: Str, args: List[ast.Expr]) -> (ast.Expr, State) {
    let sp = e.span
    if embeds.literal_path(args).is_none() {
        let d = diag.error("E0405", sp, "`{name}` takes one argument, a string literal with the path, as in `{name}(\"page.html\")`")
        return set(e, EStr([]), st.fail(d))
    }
    let path = embeds.literal_path(args) ?? ""
    let found = cx.found.get(embeds.key(sp)) ?? Problem("`{name}` was not read")
    match found {
        Text(text) => {
            let st = { st with embedded: st.embedded + [Embedded { module: cx.module.name, path, size: text.len() }] }
            if name == "embed" {
                set(e, EStr([SPLit(text)]), st)
            } else {
                let (text, st) = st.node(EStr([SPLit(text)]), sp)
                set(e, EMethod(text, "to_bytes", sp, []), st)
            }
        },
        Files(files) => {
            let mut st = st
            for f in files {
                st = { st with embedded: st.embedded + [Embedded { module: cx.module.name, path: path + "/" + f.0, size: f.1.len() }] }
            }
            file_map(st, e, files)
        },
        Problem(message) => {
            let st = st.fail(diag.error("E0405", sp, message))
            if name == "embed_dir" { file_map(st, e, [("", "")]) } else { set(e, EStr([]), st) }
        },
    }
}

// `map([("css/site.css", "...".to_bytes()), ...])`, the value of
// `embed_dir`. A failed one is a map of one empty file, so the checker
// still sees a Map[Str, Bytes] there.
fn file_map(st: State, e: ast.Expr, files: List[(Str, Str)]) -> (ast.Expr, State) {
    let sp = e.span
    let (pairs, st) = each(st, files, |st, f| {
        let (key, st) = st.node(EStr([SPLit(f.0)]), sp)
        let (text, st) = st.node(EStr([SPLit(f.1)]), sp)
        let (bytes, st) = st.node(EMethod(text, "to_bytes", sp, []), sp)
        let fields = [ast.FieldInit { name: "0", span: sp, value: key }, ast.FieldInit { name: "1", span: sp, value: bytes }]
        st.node(EStruct(ast.tuple_name(2), sp, fields), sp)
    })
    let (list, st) = st.node(EList(pairs), sp)
    let (callee, st) = st.node(EVar("map"), sp)
    set(e, ECall(callee, [list]), st)
}

// ---------- statements ----------

pub fn block(st: State, cx: Context, locals: List[Str], b: ast.Block) -> (ast.Block, State) {
    let (stmts, st) = expand_stmts(st, b.stmts)
    let mut st = st
    let mut locals = locals
    let mut out: List[ast.Stmt] = []
    for s in stmts {
        let ex = |st: State, x: ast.Expr| expr(st, cx, locals, x)
        let (desc, after) = match s.desc {
            SLet(m, n, span, t, x) => {
                let (x, st) = ex(st, x)
                locals = [n] + locals
                let (t, st) = maybe(st, t, |st, t| ty(st, cx, [], t))
                (SLet(m, n, span, t, x), st)
            },
            SAssign(a, b) => {
                let (b, st) = ex(st, b)
                let (a, st) = ex(st, a)
                (SAssign(a, b), st)
            },
            SExpr(x) => {
                let (x, st) = ex(st, x)
                (SExpr(x), st)
            },
            SReturn(x) => {
                let (x, st) = maybe(st, x, ex)
                (SReturn(x), st)
            },
            SWhile(c, body) => {
                let (body, st) = block(st, cx, locals, body)
                let (c, st) = ex(st, c)
                (SWhile(c, body), st)
            },
            SFor(n, span, items, body) => {
                let (body, st) = block(st, cx, [n] + locals, body)
                let (items, st) = ex(st, items)
                (SFor(n, span, items, body), st)
            },
            SDefer(body) => {
                let (body, st) = block(st, cx, locals, body)
                (SDefer(body), st)
            },
            // SLetPat and SForPat are expanded already
            SBreak | SContinue | SLetPat(..) | SForPat(..) => (s.desc, st),
        }
        out.push({ s with desc })
        st = after
    }
    let (tail, st) = maybe(st, b.tail, |st, x| expr(st, cx, locals, x))
    ({ b with stmts: out, tail }, st)
}

fn is_tuple_assign(s: ast.Stmt) -> Bool {
    match s.desc {
        SAssign(lhs, _) => match lhs.desc {
            EStruct(n, _, _) => ast.is_tuple_name(n),
            _ => false,
        },
        _ => false,
    }
}

fn needs_expanding(s: ast.Stmt) -> Bool {
    match s.desc {
        SLetPat(..) | SForPat(..) => true,
        _ => is_tuple_assign(s),
    }
}

// The statements with `let (a, b) = e`, `for (k, v) in xs { ... }` and
// `(a, b) = e` written out in plain statements.
fn expand_stmts(st: State, stmts: List[ast.Stmt]) -> (List[ast.Stmt], State) {
    if !stmts.any(needs_expanding) {
        return (stmts, st)
    }
    let mut st = st
    let mut out: List[ast.Stmt] = []
    for s in stmts {
        let (more, after) = match s.desc {
            SAssign(lhs, e) if is_tuple_assign(s) => assign_parts(st, lhs, e, s.span),
            SLetPat(p, e) => unpack(st, p, e),
            // `for t in xs { let (k, v) = t; body }`
            SForPat(p, items, body) => {
                let (n, st) = st.temp()
                let tmp = "item$" + n.to_str()
                let (v, st) = st.node(EVar(tmp), p.span)
                let (lets, st) = unpack(st, p, v)
                ([{ s with desc: SFor(tmp, p.span, items, { body with stmts: lets + body.stmts }) }], st)
            },
            _ => ([s], st),
        }
        out = out + more
        st = after
    }
    (out, st)
}

// `let (a, (b, _)) = e` as `let t = e; let a = t.0; let u = t.1;
// let b = u.0`. A struct pattern checks the value's type with a match that
// cannot fail: `let Point \{ x, y: (a, _) } = e` as
// `let t = match e \{ Point \{ x: _, y: _ } as s => s }; let x = t.x; ...`,
// so the checker reports a wrong type, an unknown field or a missing `..`
// at the pattern, as it does in `match`.
fn unpack(st: State, p: ast.Pat, e: ast.Expr) -> (List[ast.Stmt], State) {
    let (n, st) = st.temp()
    let tmp = "tuple$" + n.to_str()
    match p.desc {
        PStruct(name, name_span, fields, rest) => {
            let whole = "struct$" + n.to_str()
            let wild = fields.map(|f| ast.FieldPat { name: f.name, span: f.span, pat: ast.Pat { desc: PWild, span: f.pat.span } })
            let shape = ast.Pat { desc: PStruct(name, name_span, wild, rest), span: p.span }
            let (body, st) = st.node(EVar(whole), p.span)
            let arm = ast.Arm { pat: ast.Pat { desc: PAs(shape, whole, p.span), span: p.span }, guard: None, body }
            let (checked, st) = st.node(EMatch(e, [arm]), p.span)
            let mut st = st
            let mut out = [ast.Stmt { desc: SLet(false, tmp, p.span, None, checked), span: p.span }]
            for f in fields {
                let (more, after) = unpack_part(st, tmp, f.name, f.pat, p.span)
                out = out + more
                st = after
            }
            (out, st)
        },
        PTuple(parts) => {
            let mut st = st
            let mut out = [ast.Stmt { desc: SLet(false, tmp, p.span, None, e), span: p.span }]
            for (i, sub) in parts.with_index() {
                let (more, after) = unpack_part(st, tmp, i.to_str(), sub, p.span)
                out = out + more
                st = after
            }
            (out, st)
        },
        PBind(name) => {
            let first = ast.Stmt { desc: SLet(false, tmp, p.span, None, e), span: p.span }
            let (var, st) = st.node(EVar(tmp), p.span)
            ([first, ast.Stmt { desc: SLet(false, name, p.span, None, var), span: p.span }], st)
        },
        _ => ([ast.Stmt { desc: SLet(false, tmp, p.span, None, e), span: p.span }], st),
    }
}

// The statements for the part `field` of the temporary `tmp`, taken apart
// by `sub`.
fn unpack_part(st: State, tmp: Str, field: Str, sub: ast.Pat, span: ast.Span) -> (List[ast.Stmt], State) {
    let (var, st) = st.node(EVar(tmp), span)
    let (part, st) = st.node(EField(var, field, sub.span), span)
    match sub.desc {
        PBind(name) => ([ast.Stmt { desc: SLet(false, name, sub.span, None, part), span: sub.span }], st),
        PWild => ([], st),
        _ => unpack(st, sub, part),
    }
}

// `(a, (b, _)) = e` as `let $assign1 = e; a = $assign1.0;
// let $assign2 = $assign1.1; b = $assign2.0`: the right side first, then
// each target, left to right. Each `let` is annotated with the tuple's
// type name alone (`#tuple2`), which says how many parts the left side
// takes; the checker checks the right side against it.
fn assign_parts(st: State, lhs: ast.Expr, e: ast.Expr, span: ast.Span) -> (List[ast.Stmt], State) {
    match lhs.desc {
        EStruct(n, _, targets) if ast.is_tuple_name(n) => {
            let (k, st) = st.temp()
            let tmp = "$assign" + k.to_str()
            let annotation = ast.TyExpr { desc: TyName(n, []), span: lhs.span }
            let mut st = st
            let mut out = [ast.Stmt { desc: SLet(false, tmp, lhs.span, Some(annotation), e), span }]
            for (i, f) in targets.with_index() {
                let target = f.value
                match target.desc {
                    EVar("_") => {},
                    _ => {
                        let (var, after) = st.node(EVar(tmp), target.span)
                        let (part, after) = after.node(EField(var, i.to_str(), target.span), target.span)
                        let (more, after) = assign_parts(after, target, part, target.span)
                        out = out + more
                        st = after
                    },
                }
            }
            (out, st)
        },
        _ => ([ast.Stmt { desc: SAssign(lhs, e), span }], st),
    }
}

// ---------- items ----------

// Built-in types a file can add methods to; such a method belongs to its
// file, so it is named after the module too.
fn builtin_method_types() -> List[Str] {
    ["Int", "Float", "Bool", "Str", "Bytes", "List", "Map", "Option", "Result", "IoError"]
}

// Item `i` of the module in `cx`, renamed. Its parts are renamed in the
// order the OCaml loader renames them, which decides the order of the
// problems found.
pub fn item(st: State, cx: Context, i: ast.Item) -> (ast.Item, State) {
    match i {
        IFn(d) => {
            let cx = { cx with gens: d.generics }
            let (params, st) = each(st, d.params, |st, p| {
                let (t, st) = ty(st, cx, [], p.ty)
                ({ p with ty: t }, st)
            })
            let name = if d.test.is_some() {
                d.name
            } else if is_method(i) {
                match params[0].ty.desc {
                    TyName(t, _) if builtin_method_types().contains(t) => qual(cx.module, t + "::" + d.name),
                    TyName(t, _) => t + "::" + d.name,
                    // the checker reports the bad `self`
                    _ => qual(cx.module, d.name),
                }
            } else {
                qual(cx.module, d.name)
            }
            let (bs, st) = bounds(st, cx, d.bounds)
            let (body, st) = block(st, cx, d.params.map(|p| p.name), d.body)
            let (ret, st) = maybe(st, d.ret, |st, t| ty(st, cx, [], t))
            // a standard library module trusted with C (src/std/limen.toml [trust])
            let trusted = is_std(cx.module) && cx.trusted.contains(std_name(cx.module))
            let foreign = d.foreign.map(|f| { f with trusted })
            (IFn({ d with name, params, bounds: bs, body, ret, foreign }), st)
        },
        IStruct(s) => {
            let cx = { cx with gens: s.generics }
            let (foreign, st) = maybe(st, s.foreign, |st, f| {
                let (ts, st) = types(st, cx, f.types)
                ({ f with types: ts }, st)
            })
            let (bs, st) = bounds(st, cx, s.bounds)
            // a C struct's Int32 fields are Ints to the rest of Limen, as
            // Int32 parameters are; the types as written stay in `foreign`
            let int32_as_int = |t: ast.TyExpr| match t.desc {
                TyName("Int32", []) if s.foreign.is_some() => { t with desc: TyName("Int", []) },
                _ => t,
            }
            let (fields, st) = each(st, s.fields, |st, f| {
                let (t, st) = ty(st, cx, [], int32_as_int(f.ty))
                ({ f with ty: t }, st)
            })
            (IStruct({ s with name: qual(cx.module, s.name), fields, foreign, bounds: bs }), st)
        },
        IIface(f) => {
            let cx = { cx with gens: f.generics }
            let (methods, st) = each(st, f.methods, |st, m| {
                let (ret, st) = maybe(st, m.ret, |st, t| ty(st, cx, [], t))
                let (params, st) = each(st, m.params, |st, p| {
                    let (t, st) = ty(st, cx, [], p.ty)
                    ({ p with ty: t }, st)
                })
                ({ m with params, ret }, st)
            })
            (IIface({ f with name: qual(cx.module, f.name), methods }), st)
        },
        IEnum(e) => {
            let cx = { cx with gens: e.generics }
            let (bs, st) = bounds(st, cx, e.bounds)
            let (variants, st) = each(st, e.variants, |st, v| {
                let (payload, st) = types(st, cx, v.payload)
                ({ v with payload }, st)
            })
            (IEnum({ e with name: qual(cx.module, e.name), variants, bounds: bs }), st)
        },
        // expanded where it is used, and kept, expanded, so the checker
        // checks its body even if nothing uses it
        IType(a) => {
            let cx = { cx with gens: a.generics }
            let name = qual(cx.module, a.name)
            let (body, st) = ty(st, cx, [name], a.body)
            (IType({ a with name, body }), st)
        },
    }
}

// ---------- lists and options with the state ----------

pub fn each[T, U](st: State, xs: List[T], f: fn(State, T) -> (U, State)) -> (List[U], State) {
    let mut st = st
    let mut out: List[U] = []
    for x in xs {
        let (y, after) = f(st, x)
        out.push(y)
        st = after
    }
    (out, st)
}

fn maybe[T, U](st: State, x: Option[T], f: fn(State, T) -> (U, State)) -> (Option[U], State) {
    match x {
        Some(v) => {
            let (v, st) = f(st, v)
            (Some(v), st)
        },
        None => (None, st),
    }
}
