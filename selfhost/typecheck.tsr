// Type-checking a loaded program, as src/check.ml's check_program does it:
// the declarations first (types, then fields and variants, then function
// signatures), then every function body (selfhost/checker.tsr), then the
// problems in order of position.
//
// The result is the program's items as the checker rewrote them, each
// expression's type and type arguments (in the State, by id), the
// problems, and what each function can do (its capabilities).
use ast
use builtins
use checker
use diag
use env
use exhaust
use ffi
use prelude
use types

pub struct Checked {
    // the program's own items, rewritten
    items: List[ast.Item],
    // sorted by position, each once
    diags: List[diag.Diag],
    // what was learned of every expression
    state: env.State,
    // what each of the program's functions can do
    infos: List[FnInfo],
}

// What `tessera caps` reports of a function: the capabilities its
// parameters mention (in the order of builtins.cap_names) and whether it
// runs code it is handed (a function parameter, or a bound whose methods
// it calls). The package checks (selfhost/caps.tsr) hold a dependency to
// the capabilities its tessera.toml line grants.
pub struct FnInfo {
    name: Str,
    span: ast.Span,
    caps: List[Str],
    callbacks: Bool,
}

// A function and its signature.
struct Fn {
    decl: ast.FnDecl,
    sig: env.Sig,
}

// What checking the declarations keeps track of besides the State.
struct Decls {
    // bound checks of the types in declarations, made once every method is
    // known: the bounds in force, and the checks
    deferred: List[(List[env.Bounds], List[env.Pending])],
    // bound failures already reported, so one written in several places of
    // a function is reported once
    reported: List[Str],
    // each function's extent, from its name to the end of its body
    extents: List[(Int, Int, Int)],
}

// `items` are the loaded program's items, `files` its files, `next_id` the
// first id free for new expressions, `methods` the text of
// src/std/methods.tsr, `forwarders` the methods struct embedding added.
pub fn check_program(items: List[ast.Item], files: List[diag.Source], next_id: Int, methods: Str, forwarders: List[Str]) -> Checked {
    let prelude_file = files.len()
    let methods_file = prelude_file + 1
    let files = files + [diag.Source { path: prelude.file_name(), text: prelude.text() }, diag.Source { path: prelude.methods_name(), text: methods }]
    let (pre, next_id) = prelude.items(prelude_file, methods, methods_file, next_id)
    let mut cx = env.empty_cx(files, prelude_file, methods_file, forwarders)
    let builtin_items = pre.filter(|i| item_file(i) == methods_file)
    for tn in ["Int", "Float", "Bool", "Str", "Bytes", "List", "Map", "Option", "Result", "IoError"] {
        cx.builtin_names[tn] = prelude.method_names(builtin_items, tn)
    }
    let mut st = env.start(next_id)
    let extents = items.flat_map(|i| match i {
        IFn(d) => [(d.span.file, d.span.lo, d.span.hi.max(d.body.span.hi))],
        _ => [],
    })
    let mut ds = Decls { deferred: [], reported: [], extents }
    let all = pre + items
    for b in builtins.bounds() {
        cx.ifaces[b] = []
    }
    (cx, st) = register_types(cx, st, all)
    (cx, st, ds) = type_bounds(cx, st, ds, all)
    (cx, st, ds) = iface_methods(cx, st, ds, all)
    (cx, st, ds) = fields_and_variants(cx, st, ds, all)
    st = no_self_containing(cx, st, all)
    let mut sigs: List[Fn] = []
    (cx, st, ds, sigs) = signatures(cx, st, ds, all)
    // the bounds of the types written in declarations
    for (bs, ps) in ds.deferred.reverse() {
        st.bounds = bs
        st.pending = ps
        (st, ds) = check_pending(cx, st, ds)
    }
    st = unique_tests(st, sigs)
    st = test_params(st, sigs)
    for f in sigs {
        if f.decl.name == "main" {
            st = check_main(st, f.decl, f.sig)
        }
    }
    // the bodies; the built-in methods written in Tessera only when called,
    // with those they call
    let builtin = |f: Fn| f.decl.span.file == methods_file
    for f in sigs {
        if f.decl.foreign.is_none() && !builtin(f) {
            (st, ds) = check_one(cx, st, ds, f)
        }
    }
    let mut checked: List[Str] = []
    while true {
        let todo = sigs.filter(|f| builtin(f) && st.used.contains(f.decl.name) && !checked.contains(f.decl.name))
        if todo.is_empty() {
            break
        }
        for f in todo {
            checked.push(f.decl.name)
            (st, ds) = check_one(cx, st, ds, f)
        }
    }
    // forwarders only pass their arguments on; the methods they call are reported
    let reported = sigs.filter(|f| f.decl.test.is_none() && f.decl.span.file != methods_file && f.decl.span.file != prelude_file && !cx.forwarders.contains(f.decl.name))
    let infos = reported.map(|f| fn_info(st, f))
    Checked { items: items.map(|i| rewritten_item(st, i)), diags: in_order(cx, st.diags), state: st, infos }
}

fn fn_info(st: env.State, f: Fn) -> FnInfo {
    let found = f.sig.params.fold([], |acc, t| st.subst.caps_in(t, acc))
    let callbacks = f.sig.params.any(|t| st.subst.has_fn(t)) || !f.decl.bounds.is_empty()
    FnInfo { name: f.decl.name, span: f.decl.span, caps: builtins.cap_names().filter(|c| found.contains(c)), callbacks }
}

fn item_file(i: ast.Item) -> Int {
    match i {
        IFn(d) => d.span.file,
        IStruct(s) => s.span.file,
        IEnum(e) => e.span.file,
        IIface(f) => f.span.file,
        IType(a) => a.span.file,
    }
}

// The problems sorted by file and position (a stable sort of OCaml's
// list, which has the latest first), and a table test's problem found in
// several of its cases said once, without naming a case.
fn in_order(cx: env.Cx, diags: List[diag.Diag]) -> List[diag.Diag] {
    let sorted = diags.reverse().sort_by(|d| (cx.path_of(d.span.file), d.span.lo))
    let mut out: List[diag.Diag] = []
    for d in sorted {
        let same = |e: diag.Diag| e.span == d.span && e.code == d.code && e.message == d.message
        if out.any(same) {
            out = out.map(|e| if same(e) { { e with notes: e.notes.filter(|n| !n.starts_with(case_note())) } } else { e })
        } else {
            out.push(d)
        }
    }
    out
}

fn case_note() -> Str {
    "in the table case "
}

// ---------- declarations ----------

fn type_defined(cx: env.Cx, n: Str) -> Bool {
    cx.structs.contains(n) || cx.enums.contains(n) || builtins.type_names().contains(n)
}

// 1. the names of types and interfaces
fn register_types(cx: env.Cx, st: env.State, items: List[ast.Item]) -> (env.Cx, env.State) {
    let mut cx = cx
    let mut st = st
    for i in items {
        match i {
            IStruct(s) => {
                if type_defined(cx, s.name) {
                    st = st.report(diag.error("E0106", s.span, "type `{s.name}` is defined more than once"))
                } else {
                    cx.structs[s.name] = s
                }
            },
            IEnum(e) => {
                if type_defined(cx, e.name) {
                    st = st.report(diag.error("E0106", e.span, "type `{e.name}` is defined more than once"))
                } else {
                    cx.enums[e.name] = e
                }
            },
            IIface(f) => {
                if builtins.bounds().contains(f.name) {
                    st = st.report(diag.error("E0106", f.span, "`{f.name}` is a built-in bound; name the interface something else"))
                } else if type_defined(cx, f.name) || cx.ifaces.contains(f.name) {
                    st = st.report(diag.error("E0106", f.span, "`{f.name}` is defined more than once"))
                } else {
                    cx.ifaces[f.name] = []
                    cx.iface_gen[f.name] = f.generics
                }
            },
            IFn(_) | IType(_) => {},
        }
    }
    (cx, st)
}

// Is `s` the struct registered under its name, not a duplicate?
fn registered_struct(cx: env.Cx, s: ast.StructDecl) -> Bool {
    cx.structs.get(s.name).map(|x| x.span == s.span) ?? false
}

fn registered_enum(cx: env.Cx, e: ast.EnumDecl) -> Bool {
    cx.enums.get(e.name).map(|x| x.span == e.span) ?? false
}

fn generic_env(gen: List[Str]) -> List[(Str, types.Ty)] {
    gen.map(|g| (g, TParam(g)))
}

// The bounds written on type parameters, resolved; the parameters with
// none left out.
fn resolve_bounds(cx: env.Cx, st: env.State, gen: List[Str], bounds: List[ast.Bound]) -> (List[env.Bounds], env.State) {
    let mut st = st
    let mut out: List[env.Bounds] = []
    for b in bounds {
        let mut bs: List[env.Bound] = []
        for te in b.ifaces {
            let (got, next) = st.resolve_bound(cx, generic_env(gen), te)
            st = next
            match got {
                Some(x) => bs.push(x),
                None => {},
            }
        }
        if !bs.is_empty() {
            out.push(env.Bounds { param: b.name, bounds: bs })
        }
    }
    (out, st)
}

fn take_pending(st: env.State, ds: Decls, bounds: List[env.Bounds]) -> (env.State, Decls) {
    let mut st = st
    let ds = { ds with deferred: [(bounds, st.pending)] + ds.deferred }
    st.pending = []
    (st, ds)
}

// 1b. bounds on the type parameters of structs and enums, before the
// interface methods, whose signatures can name those types
fn type_bounds(cx: env.Cx, st: env.State, ds: Decls, items: List[ast.Item]) -> (env.Cx, env.State, Decls) {
    let mut cx = cx
    let mut st = st
    let mut ds = ds
    for i in items {
        let (name, gen, bounds) = match i {
            IStruct(s) if registered_struct(cx, s) && !s.bounds.is_empty() => (s.name, s.generics, s.bounds),
            IEnum(e) if registered_enum(cx, e) && !e.bounds.is_empty() => (e.name, e.generics, e.bounds),
            _ => {
                continue
            },
        }
        let (bs, next) = resolve_bounds(cx, st, gen, bounds)
        st = next
        if !bs.is_empty() {
            cx.type_bounds[name] = (gen, bs)
        }
        (st, ds) = take_pending(st, ds, bs)
    }
    (cx, st, ds)
}

// 1c. the methods of interfaces
fn iface_methods(cx: env.Cx, st: env.State, ds: Decls, items: List[ast.Item]) -> (env.Cx, env.State, Decls) {
    let mut cx = cx
    let mut st = st
    let mut ds = ds
    for i in items {
        let f = match i {
            IIface(f) => f,
            _ => {
                continue
            },
        }
        let mut seen: List[Str] = []
        let mut ms: List[env.IfaceMethod] = []
        let genv = generic_env(f.generics)
        for m in f.methods {
            if seen.contains(m.name) {
                st = st.report(diag.error("E0106", m.span, "method `{m.name}` is declared twice in `{f.name}`"))
                continue
            }
            seen.push(m.name)
            cx.param_names[f.name + "::" + m.name] = m.params.map(|p| p.name)
            // OCaml makes the pair (params, result) result first
            let (ret, next) = match m.ret {
                Some(te) => st.resolve(cx, genv, te),
                None => (TUnit, st),
            }
            st = next
            let mut ps: List[types.Ty] = []
            for p in m.params {
                let (t, next) = st.resolve(cx, genv, p.ty)
                ps.push(t)
                st = next
            }
            ms.push(env.IfaceMethod { name: m.name, params: ps, ret })
        }
        cx.ifaces[f.name] = ms
        // the interface's own parameters have no bounds to check
        st.pending = st.pending.filter(|p| match st.repr(p.ty) {
            TParam(g) => !f.generics.contains(g),
            _ => true,
        })
        (st, ds) = take_pending(st, ds, [])
    }
    (cx, st, ds)
}

// 2. field and payload types; an alias's body, which every use already has
// in its place, only to report a type that does not exist
fn fields_and_variants(cx: env.Cx, st: env.State, ds: Decls, items: List[ast.Item]) -> (env.Cx, env.State, Decls) {
    let mut cx = cx
    let mut st = st
    let mut ds = ds
    for i in items {
        match i {
            IType(a) => {
                st.kinds = map()
                let genv = generic_env(a.generics)
                st = match a.body.desc {
                    // another name for an interface with its arguments, used
                    // as a bound: `type Ints = Container[Int]`
                    TyName(n, args) if cx.ifaces.contains(n) && !builtins.bounds().contains(n) => st.bound_args(cx, genv, n, args, a.body.span).1,
                    _ => st.resolve(cx, genv, a.body).1,
                }
                // an alias is checked where it is used, with its arguments there
                st.pending = []
            },
            IStruct(s) if registered_struct(cx, s) => {
                st.kinds = map()
                if s.foreign.is_some() {
                    match ffi.struct_fields(s) {
                        Err(es) => {
                            for (sp, m) in es {
                                st = st.report(diag.error("E0330", sp, m))
                            }
                        },
                        Ok(_) => {},
                    }
                }
                let genv = generic_env(s.generics)
                let mut seen: List[Str] = []
                let mut fs: List[(Str, types.Ty)] = []
                for f in s.fields {
                    if seen.contains(f.name) {
                        st = st.report(diag.error("E0106", f.span, "field `{f.name}` is declared twice"))
                        continue
                    }
                    seen.push(f.name)
                    let (t, next) = st.resolve(cx, genv, f.ty)
                    st = next.check_storable(f.ty.span, t)
                    if s.embeds.contains(f.name) {
                        match st.repr(t) {
                            TNamed(n, _) if cx.structs.contains(n) && !ast.is_tuple_name(n) => {},
                            TErr => {},
                            other => {
                                let d = diag.error("E0121", f.ty.span, "only a struct can be embedded, and `{st.show(other)}` is not one").note("give it a field name instead, as in `{f.name.to_lower()}: {st.show(other)}`")
                                st = st.report(d)
                            },
                        }
                    }
                    fs.push((f.name, t))
                }
                cx.sfields[s.name] = fs
                (st, ds) = take_pending(st, ds, own_bounds(cx, s.name))
            },
            IEnum(e) if registered_enum(cx, e) => {
                st.kinds = map()
                let genv = generic_env(e.generics)
                let mut vs: List[(Str, List[types.Ty])] = []
                for v in e.variants {
                    let prev = cx.owners.get(v.name) ?? []
                    if prev.contains(e.name) {
                        st = st.report(diag.error("E0106", v.span, "variant `{v.name}` is declared twice"))
                        continue
                    }
                    cx.owners[v.name] = prev + [e.name]
                    let mut ts: List[types.Ty] = []
                    for te in v.payload {
                        let (t, next) = st.resolve(cx, genv, te)
                        st = next.check_storable(te.span, t)
                        ts.push(t)
                    }
                    vs.push((v.name, ts))
                }
                cx.variants[e.name] = vs
                (st, ds) = take_pending(st, ds, own_bounds(cx, e.name))
            },
            _ => {},
        }
    }
    (cx, st, ds)
}

fn own_bounds(cx: env.Cx, n: Str) -> List[env.Bounds] {
    cx.type_bounds.get(n).map(|x| x.1) ?? []
}

// 2b. a struct cannot hold itself by value (it would be infinitely large);
// enums, lists and maps hold their contents indirectly, so recursion goes
// through them: `next: Option[Node]`
fn no_self_containing(cx: env.Cx, st: env.State, items: List[ast.Item]) -> env.State {
    let mut st = st
    for i in items {
        match i {
            IStruct(s) if registered_struct(cx, s) => {
                let start = TNamed(s.name, s.generics.map(|g| TParam(g)))
                match reaches(cx, st, s.name, [], start, []).0 {
                    Some(path) => {
                        let d = diag.error("E0114", s.span, "struct `{s.name}` contains itself through `{path.join(".")}`, so it would be infinitely large").note("hold the inner value in an `Option`, an enum or a `List`, as in `next: Option[{s.name}]`; those store it indirectly")
                        st = st.report(d)
                    },
                    None => {},
                }
            },
            _ => {},
        }
    }
    st
}

// The fields by which a value of type `t`, reached from struct `name`
// through `path`, holds `name` again; `seen` the types already entered.
fn reaches(cx: env.Cx, st: env.State, name: Str, path: List[Str], t: types.Ty, seen: List[Str]) -> (Option[List[Str]], List[Str]) {
    match st.repr(t) {
        TArray(a, _) => reaches(cx, st, name, path, a, seen),
        TNamed(n, args) if cx.sfields.contains(n) => {
            if n == name && !path.is_empty() {
                return (Some(path), seen)
            }
            let key = st.show(t)
            if seen.contains(key) {
                return (None, seen)
            }
            let mut seen = seen + [key]
            let inst = (cx.structs.get(n).map(|s| s.generics) ?? []).zip(args)
            for f in cx.sfields.get(n) ?? [] {
                let (found, next) = reaches(cx, st, name, path + [f.0], st.subst(inst, f.1), seen)
                seen = next
                if found.is_some() {
                    return (found, seen)
                }
            }
            (None, seen)
        },
        _ => (None, seen),
    }
}

// The bounds a function's parameter types give its type parameters: in
// `fn insert[T](self: Sorted[T], x: T)`, T has the bounds of `Sorted`'s
// parameter, since every `Sorted` value was checked where it was made.
fn implied_bounds(cx: env.Cx, st: env.State, gen: List[Str], ts: List[types.Ty]) -> List[env.Bounds] {
    let mut acc: List[env.Bounds] = []
    let mut todo = ts
    while !todo.is_empty() {
        let t = todo[0]
        todo = todo.skip(1)
        let inside = match st.repr(t) {
            TNamed(n, args) => {
                match cx.type_bounds.get(n) {
                    Some((tg, bs)) if tg.len() == args.len() => {
                        let inst = tg.zip(args)
                        for pb in bs {
                            let arg = inst.find(|x| x.0 == pb.param).map(|x| x.1) ?? TErr
                            match st.repr(arg) {
                                TParam(g) if gen.contains(g) => {
                                    for b in pb.bounds {
                                        let b = st.subst_bound(inst, b)
                                        let prev = acc.find(|x| x.param == g).map(|x| x.bounds) ?? []
                                        if !prev.contains(b) {
                                            acc = [env.Bounds { param: g, bounds: prev + [b] }] + acc.filter(|x| x.param != g)
                                        }
                                    }
                                },
                                _ => {},
                            }
                        }
                    },
                    _ => {},
                }
                args
            },
            TList(a) | TChan(a) | TGroup(a) | TArray(a, _) => [a],
            TMap(k, v) => [k, v],
            TFn(ps, r) => ps + [r],
            TDyn(_, xs) => xs,
            _ => [],
        }
        // depth first, as OCaml's walk goes
        todo = inside + todo
    }
    acc.reverse()
}

fn merge_bounds(a: List[env.Bounds], b: List[env.Bounds]) -> List[env.Bounds] {
    let mut acc = a
    for x in b {
        let prev = acc.find(|y| y.param == x.param).map(|y| y.bounds) ?? []
        let extra = x.bounds.filter(|y| !prev.contains(y))
        if acc.any(|y| y.param == x.param) {
            acc = acc.map(|y| if y.param == x.param { { y with bounds: y.bounds + extra } } else { y })
        } else {
            acc = acc + [{ x with bounds: extra }]
        }
    }
    acc
}

// 3. function signatures
fn signatures(cx: env.Cx, st: env.State, ds: Decls, items: List[ast.Item]) -> (env.Cx, env.State, Decls, List[Fn]) {
    let mut cx = cx
    let mut st = st
    let mut ds = ds
    let mut sigs: List[Fn] = []
    for i in items {
        let d = match i {
            IFn(d) => d,
            _ => {
                continue
            },
        }
        st.kinds = map()
        let genv = generic_env(d.generics)
        let mut ps: List[types.Ty] = []
        let mut ret = TUnit
        match d.foreign {
            None => {
                for p in d.params {
                    let (t, next) = st.resolve(cx, genv, p.ty)
                    ps.push(t)
                    st = next
                }
                match d.ret {
                    Some(te) => {
                        (ret, st) = st.resolve(cx, genv, te)
                    },
                    None => {},
                }
            },
            Some(_) => {
                // the Tessera type of a C function: Foreign first, Out
                // parameters moved to the result
                cx.foreign_fns[d.name] = true
                if d.name == "main" {
                    st = st.report(diag.error("E0330", d.span, "`main` cannot be a foreign function"))
                }
                match ffi.of_decl(d, cx.structs) {
                    Ok(cs) => {
                        ps = ffi.visible_params(cs)
                        ret = ffi.result_ty(cs)
                    },
                    Err(es) => {
                        for (sp, m) in es {
                            st = st.report(diag.error("E0330", sp, m))
                        }
                        ps = [TCap("Foreign")] + d.params.map(|_| TErr)
                        ret = TErr
                    },
                }
            },
        }
        let s = env.Sig { gen: d.generics, params: ps, ret }
        if d.foreign.is_none() && !cx.fns.contains(d.name) {
            cx.param_names[d.name] = d.params.map(|p| p.name)
        }
        st = check_self(cx, st, d, ps)
        let (declared, next) = resolve_bounds(cx, st, d.generics, d.bounds)
        st = next
        if !declared.is_empty() {
            cx.fn_bounds[d.name] = declared
        }
        let all = merge_bounds(declared, implied_bounds(cx, st, d.generics, ps))
        cx.fn_cur_bounds[d.name] = all
        cx.fn_kinds[d.name] = st.kinds.entries()
        (st, ds) = take_pending(st, ds, all)
        // a clash with a built-in method written in Tessera is reported by check_self
        let builtin_clash = match cx.method_owner.get(d.name) {
            Some((_, f)) => f == cx.methods_file,
            None => false,
        }
        if d.name.contains(":") && !builtin_clash {
            cx.method_owner[d.name] = (d.public, d.span.file)
        }
        if cx.fns.contains(d.name) {
            if !builtin_clash {
                st = st.report(diag.error("E0106", d.span, "function `{d.name}` is defined more than once"))
            }
        } else {
            cx.fns[d.name] = s
        }
        sigs.push(Fn { decl: d, sig: s })
    }
    for k in cx.fns.keys() {
        match k.index_of("::") {
            Some(i) => {
                let ty = k.slice(0, i)
                let base = match ty.last_index_of(".") {
                    Some(dot) => ty.slice(dot + 1, ty.len()),
                    None => ty,
                }
                let key = base + k.slice(i, k.len())
                cx.by_suffix[key] = (cx.by_suffix.get(key) ?? []) + [k]
            },
            None => {},
        }
    }
    (cx, st, ds, sigs)
}

// E0110: `self` is only the first parameter of a method on a struct or
// enum declared in the program, or on a built-in type that can have them.
fn check_self(cx: env.Cx, st: env.State, d: ast.FnDecl, ps: List[types.Ty]) -> env.State {
    let mut st = st
    for (i, p) in d.params.with_index() {
        if p.name == "self" && i > 0 {
            st = st.report(diag.error("E0110", p.span, "`self` can only be the first parameter, which makes the function a method"))
        }
    }
    let (p, t0) = match (d.params, ps) {
        ([p, ..], [t0, ..]) if p.name == "self" && d.test.is_none() => (p, t0),
        _ => {
            return st
        },
    }
    let builtin = |n: Str| ["Option", "Result", "IoError", "ProcessOutput", "HttpResponse", "Handle"].contains(n)
    match t0 {
        TNamed(n, _) if (cx.structs.contains(n) || cx.enums.contains(n)) && !builtin(n) => st,
        TErr => st,
        _ if d.span.file == cx.methods_file => st,
        t if builtins.type_name(st.repr(t)).is_some() => {
            // a method on a built-in type: private to its file, and no
            // clash with a built-in method
            let name = match d.name.last_index_of(":") {
                Some(i) => d.name.slice(i + 1, d.name.len()),
                None => d.name,
            }
            let tn = builtins.type_name(st.repr(t)) ?? ""
            if builtins.names(t).contains(name) || cx.builtin_methods(tn).contains(name) {
                st.report(diag.error("E0106", d.span, "`{st.show(t)}` already has a built-in method `{name}`"))
            } else if d.public {
                st.report(diag.error("E0110", d.span, "a method on built-in type `{st.show(t)}` cannot be `pub`: it is private to the file that defines it").note("export a plain function instead, as in `pub fn shout(s: Str) -> Str`"))
            } else {
                st
            }
        },
        t => st.report(diag.error("E0110", p.span, "methods can only be defined on struct and enum types and on Int, Float, Bool, Str, List, Map, Option, Result and IoError, not on `{st.show(t)}`").note("write a plain function that takes the value instead, and rename the parameter")),
    }
}

// Test names are unique, each kind on its own.
fn unique_tests(st: env.State, sigs: List[Fn]) -> env.State {
    let mut st = st
    let mut seen: List[(Str, Str)] = []
    for f in sigs {
        match f.decl.test {
            Some(n) => {
                let kind = if f.decl.bench { "bench" } else { "test" }
                if seen.contains((kind, n)) {
                    st = st.report(diag.error("E0106", f.decl.span, "{kind} \"{n}\" is defined more than once"))
                } else {
                    seen.push((kind, n))
                }
            },
            None => {},
        }
    }
    st
}

// E0306: a test's parameters are capabilities the runner provides.
fn test_params(st: env.State, sigs: List[Fn]) -> env.State {
    let mut st = st
    for f in sigs {
        let d = f.decl
        if d.test.is_some() {
            let mut seen: List[types.Ty] = []
            for (p, t) in d.params.zip(f.sig.params) {
                let t = st.repr(t)
                match t {
                    TCap("Fs") | TCap("Clock") if !seen.contains(t) => seen.push(t),
                    TErr => {},
                    _ => {
                        let message = if seen.contains(t) { "a test can take `{st.show(t)}` only once" } else { "a test cannot take `{st.show(t)}`" }
                        st = st.report(diag.error("E0306", p.span, message).note("a test can take `fs: Fs` (a fresh temporary directory) and `clock: Clock`; pass anything else through an interface"))
                    },
                }
            }
        }
        // a bench measures real time
        if d.bench && d.virtual {
            st = st.report(diag.error("E0306", d.span, "a bench cannot take a virtual clock").note("a bench is timed on the real clock; take `clock: Clock`"))
        }
    }
    st
}

// 4. main
fn check_main(st: env.State, d: ast.FnDecl, s: env.Sig) -> env.State {
    let ok_params = match s.params {
        [] => true,
        [t] => st.repr(t) == TCap("Root"),
        _ => false,
    }
    let unit_or_int = |t: types.Ty| match st.repr(t) {
        TUnit | TInt => true,
        _ => false,
    }
    let ok_ret = match st.repr(s.ret) {
        TUnit | TInt => true,
        TNamed("Result", [t, _]) => unit_or_int(t),
        _ => false,
    }
    if !s.gen.is_empty() || !(ok_params && ok_ret) {
        return st.report(diag.error("E0303", d.span, "`main` has the wrong signature").note("write `fn main(root: Root)`, `fn main(root: Root) -> Int` (the exit code) or `fn main(root: Root) -> Result[(), E]`"))
    }
    st
}

// ---------- bodies ----------

// A function's body; for a table test's copy, its problems say which case
// they come from.
fn check_one(cx: env.Cx, st: env.State, ds: Decls, f: Fn) -> (env.State, Decls) {
    let before = st.diags.len()
    let (st, ds) = check_fn(cx, st, ds, f.decl, f.sig)
    let c = match f.decl.table {
        Some(t) => t.cases,
        None => {
            return (st, ds)
        },
    }
    let note = case_note() + one_line(cx.text_of(c.span.file), c.span)
    let mut st = st
    st.diags = st.diags.with_index().map(|p| if p.0 >= before { p.1.note(note) } else { p.1 })
    (st, ds)
}

// The text at `span` on one line: runs of spaces and newlines become one
// space, as OCaml's Source.one_line writes it.
fn one_line(src: Str, span: ast.Span) -> Str {
    if span.lo < 0 || span.hi > src.len() || span.lo >= span.hi {
        return "?"
    }
    let text = src.slice(span.lo, span.hi)
    let mut words: List[Str] = []
    let mut start = 0
    let mut space = true
    let bs = text.bytes()
    for (i, b) in bs.with_index() {
        let blank = b == 32 || b == 10 || b == 9 || b == 13
        if blank && !space {
            words.push(text.slice(start, i))
        }
        if !blank && space {
            start = i
        }
        space = blank
    }
    if !space {
        words.push(text.slice(start, bs.len()))
    }
    words.join(" ")
}

fn check_fn(cx: env.Cx, st: env.State, ds: Decls, d: ast.FnDecl, s: env.Sig) -> (env.State, Decls) {
    let mut st = st
    st.bounds = cx.fn_cur_bounds.get(d.name) ?? []
    st.kinds = map()
    for (g, k) in cx.fn_kinds.get(d.name) ?? [] {
        st.kinds[g] = k
    }
    st.pending = []
    st.to_infer = []
    st.map_keys = []
    let genv = generic_env(d.generics)
    let mut scope = env.Scope { vars: map(), barrier: false }
    for (p, t) in d.params.zip(s.params) {
        scope.vars[p.name] = env.Var { ty: t, mutable: false, span: p.span, kind: KParam }
    }
    let fx = env.Fx { ret: s.ret, scopes: [scope], loops: 0, genv, in_group: 0, in_defer: 0, ret_te: d.ret }
    if st.subst.has_dyn(s.ret) {
        // the body's value becomes `dyn`, branch by branch
        st = checker.expect_block(st, cx, fx, d.body, s.ret)
        return check_pending(cx, st, ds)
    }
    let (bt, next) = checker.check_block(st, cx, fx, d.body)
    let (ok, next) = next.unify(s.ret, bt)
    st = next
    if !ok {
        let b = d.body
        let sp = match b.tail {
            Some(e) => e.span,
            None => { b.span with lo: b.span.hi - 1 },
        }
        let mut problem = diag.error("E0201", sp, "`{d.name}` returns `{st.show(s.ret)}`, but its body has type `{st.show(bt)}`")
        match (st.repr(s.ret), st.repr(bt)) {
            (TUnit, _) => {
                problem = problem.note("add `-> {st.show(bt)}` to the signature, or end the body with a statement")
            },
            (_, TUnit) => {
                problem = problem.note("the last expression of a body is its value; add it, or use `return`")
            },
            _ => {},
        }
        st = st.report(problem)
    }
    check_pending(cx, st, ds)
}

// The checks left for when the function's types are known: the key types
// of the maps it made, and the bounds of the generic functions and types
// it used.
fn check_pending(cx: env.Cx, st: env.State, ds: Decls) -> (env.State, Decls) {
    let mut st = st
    let mut ds = ds
    for (sp, k) in st.map_keys {
        match checker.unkeyable(st, cx, k) {
            Some(t) => {
                let shown = st.show(st.repr(k))
                let inner = if st.show(t) == shown { "" } else { " (it holds `{st.show(t)}`)" }
                let mut d = diag.error("E0113", sp, "`{shown}` cannot be a map key{inner}").note("keys are Int, Str, Bool, and tuples, structs and enums made of them; Float, List and Map cannot be keys")
                match t {
                    TParam(g) => {
                        d = d.note("a type parameter can be a key with the bound `[{g}: Key]`")
                    },
                    _ => {},
                }
                st = st.report(d)
            },
            None => {},
        }
    }
    st.map_keys = []
    let ps = st.pending.reverse()
    st.pending = []
    for p in ps {
        let i = p.bound.iface
        let key = "{p.span.file} {enclosing_fn(ds, p.span)} {st.show(st.repr(p.ty))} {st.show_bound(p.bound)} {p.param}"
        if ds.reported.contains(key) {
            continue
        }
        let why = match i {
            "Ordered" => checker.unordered_why(st, cx, p.ty),
            "Key" => checker.unkeyable(st, cx, p.ty).map(|u| "`{st.show(u)}` cannot be a map key: keys are Int, Str, Bytes, Bool, and tuples, structs and enums of them"),
            _ => {
                let (why, next) = checker.satisfies(st, cx, p.ty, p.bound)
                st = next
                why
            },
        }
        match why {
            Some(why) => {
                ds = { ds with reported: ds.reported + [key] }
                let shown = st.show(st.repr(p.ty))
                let message = if builtins.bounds().contains(i) {
                    "`{shown}` does not satisfy `{i}`, required of `{p.param}`"
                } else {
                    "`{shown}` does not satisfy interface `{st.show_bound(p.bound)}`, required of `{p.param}`"
                }
                let mut d = diag.error("E0111", p.span, message).note(why)
                match st.repr(p.ty) {
                    TParam(g) if builtins.bounds().contains(i) => {
                        d = d.note("add the bound: `[{g}: {i}]`")
                    },
                    _ => {},
                }
                st = st.report(d)
            },
            None => {},
        }
    }
    (st, ds)
}

// The start of the function `sp` lies in, or `sp`'s own start outside any.
fn enclosing_fn(ds: Decls, sp: ast.Span) -> Int {
    match ds.extents.find(|x| x.0 == sp.file && x.1 <= sp.lo && sp.hi <= x.2) {
        Some(x) => x.1,
        None => sp.lo,
    }
}

// ---------- the rewritten tree ----------

// The tree with each expression in its last form, as OCaml's writes into
// the tree leave it.
fn rewritten_item(st: env.State, i: ast.Item) -> ast.Item {
    match i {
        IFn(d) => {
            let table = d.table.map(|t| { t with cases: expr(st, t.cases) })
            IFn({ d with table, body: block(st, d.body) })
        },
        _ => i,
    }
}

fn block(st: env.State, b: ast.Block) -> ast.Block {
    { b with stmts: b.stmts.map(|s| stmt(st, s)), tail: b.tail.map(|e| expr(st, e)) }
}

fn stmt(st: env.State, s: ast.Stmt) -> ast.Stmt {
    let x = |e: ast.Expr| expr(st, e)
    let desc = match s.desc {
        SLet(m, n, nsp, t, e) => SLet(m, n, nsp, t, x(e)),
        SAssign(a, b) => SAssign(x(a), x(b)),
        SExpr(e) => SExpr(x(e)),
        SReturn(e) => SReturn(e.map(x)),
        SWhile(c, b) => SWhile(x(c), block(st, b)),
        SFor(n, nsp, e, b) => SFor(n, nsp, x(e), block(st, b)),
        SLetPat(p, e) => SLetPat(p, x(e)),
        SForPat(p, e, b) => SForPat(p, x(e), block(st, b)),
        SDefer(b) => SDefer(block(st, b)),
        SBreak | SContinue => s.desc,
    }
    { s with desc }
}

fn expr(st: env.State, e: ast.Expr) -> ast.Expr {
    let x = |e: ast.Expr| expr(st, e)
    let inits = |fs: List[ast.FieldInit]| fs.map(|f| { f with value: x(f.value) })
    let desc = match st.desc(e) {
        EInt(_) | EFloat(_) | EBool(_) | EUnit | EVar(_) => st.desc(e),
        EStr(parts) => EStr(parts.map(|p| match p {
            SPExpr(v) => SPExpr(x(v)),
            SPLit(_) => p,
        })),
        EList(es) => EList(es.map(x)),
        EBin(op, a, b) => EBin(op, x(a), x(b)),
        EUn(op, a) => EUn(op, x(a)),
        ECall(f, args) => ECall(x(f), args.map(x)),
        EMethod(r, m, msp, args) => EMethod(x(r), m, msp, args.map(x)),
        EField(r, n, nsp) => EField(x(r), n, nsp),
        EIndex(a, i) => EIndex(x(a), x(i)),
        ETry(a, c) => ETry(x(a), c.map(x)),
        EIf(c, b, other) => EIf(x(c), block(st, b), other.map(x)),
        EMatch(s, arms) => EMatch(x(s), arms.map(|a| { a with guard: a.guard.map(x), body: x(a.body) })),
        EBlock(b) => EBlock(block(st, b)),
        EClosure(ps, body) => EClosure(ps, x(body)),
        EStruct(n, nsp, fs) => EStruct(n, nsp, inits(fs)),
        EGroup(n, il, until, b) => EGroup(n, il, until.map(|d| ast.Deadline { clock: x(d.clock), ms: x(d.ms) }), block(st, b)),
        ESelect(arms) => ESelect(arms.map(|a| {
            let op = match a.op {
                SelRecv(b, c) => SelRecv(b, x(c)),
                SelSend(c, v) => SelSend(x(c), x(v)),
                SelAfter(c, ms) => SelAfter(x(c), x(ms)),
                SelDefault => SelDefault,
            }
            { a with op, guard: a.guard.map(x), body: x(a.body) }
        })),
        EPipe(a, b) => EPipe(x(a), x(b)),
        EWith(b, fs) => EWith(x(b), inits(fs)),
        ESafe(b, n, rest) => ESafe(x(b), n, x(rest)),
        ENamed(n, nsp, v) => ENamed(n, nsp, x(v)),
        EDyn(v, i) => EDyn(x(v), i),
    }
    { e with desc }
}
