// A tour of the newer features, one small section each.
// Run: vela run examples/tour.vela
// Native: vela run examples/tour.vela --native
// Tests: vela test examples/tour.vela
use errors

interface Shape {
    fn area(self) -> Float
    fn name(self) -> Str
}

struct Circle {
    r: Float,
}

struct Square {
    side: Float,
}

fn area(self: Circle) -> Float { 3.14159 * self.r * self.r }

fn name(self: Circle) -> Str { "circle" }

fn area(self: Square) -> Float { self.side * self.side }

fn name(self: Square) -> Str { "square" }

struct Point {
    x: Int,
    y: Int,
}

// a file can add its own methods to built-in types
fn shout(self: Str) -> Str { self.to_upper() + "!" }

fn pick(big: Bool) -> dyn Shape {
    // branches of different types become `dyn` where one is expected
    if big { Circle { r: 2.0 } } else { Square { side: 1.5 } }
}

// any type with a `message` method is an Error
struct BadPort {
    text: Str,
}

fn message(self: BadPort) -> Str { "not a port: {self.text}" }

fn parse_port(s: Str) -> Result[Int, BadPort] {
    match s.parse_int() {
        Some(n) => Ok(n),
        None => Err(BadPort { text: s }),
    }
}

// `?` converts any Error to `dyn Error`, and a string after it adds context
fn port(settings: Map[Str, Str]) -> Result[Int, dyn Error] {
    let raw = settings.get("port")? "no port set"
    let n = parse_port(raw)? "reading settings"
    Ok(n)
}

fn slow(clock: Clock, ms: Int, v: Int) -> Int {
    clock.sleep(ms)
    v
}

// main can return the program's exit code
fn main(root: Root) -> Int {
    let out = root.stdout
    let clock = root.clock

    out.print("-- language")
    let s = pick(true)
    out.print("{s.name()} {s.area().to_fixed(2)}")
    let sizes = [pick(true), pick(false)].map(|x| x.area())
    out.print("{sizes.sort()}")
    // ranges and characters
    let mut squares = []
    for i in 0..<5 {
        squares.push(i * i)
    }
    out.print("{squares} {"hola".chars()}")
    // method values: `p.area` without a call is a closure
    let c = Circle { r: 1.0 }
    let f = c.area
    out.print("bound method {f().to_fixed(3)}")
    out.print("vela".shout())
    // tuples and structs as map keys, and entries updated in place
    let mut grid: Map[Point, List[Str]] = map()
    grid[Point { x: 0, y: 0 }] = ["origin"]
    grid[Point { x: 0, y: 0 }].push("home")
    let mut seen: Map[(Int, Int), Int] = map()
    seen[(1, 2)] = 1
    seen[(1, 2)] = seen[(1, 2)] + 1
    out.print("{grid} {seen}")
    // structs and tuples sort field by field
    out.print("{[(2, "b"), (1, "z"), (1, "a")].sort()}")
    // binary data
    let b = "hi".to_bytes() + bytes([33])
    out.print("{b.len()} bytes: {b.to_str()}")
    // errors from different types, with context, walked with the errors module
    match port(map([("port", "80x")])) {
        Ok(n) => out.print("port {n}"),
        Err(e) => out.print(errors.report(e)),
    }
    out.print("{port(map([("port", "8080")])) ?? 0}")

    out.print("-- concurrency")
    // tasks returning () run for their effect and add nothing to the list
    let rs = group g {
        g.go(|| 1)
        g.go(|| out.print("a side task ran"))
        g.go(|| 2)
    }
    out.print("results {rs}")
    // a deadline cancels the stuck task: None in its place
    let timed = group g until clock.after(100) {
        g.go(|| slow(clock, 10, 1))
        g.go(|| slow(clock, 5000, 2))
    }
    out.print("with a deadline {timed}")
    // an unbuffered channel and a select that times out
    let ch: Chan[Str] = channel(0)
    let got = select {
        v = ch.recv() => v ?? "closed",
        clock.after(50) => "nobody sent anything",
    }
    out.print(got)

    // exit status 3: check it with `echo $?`
    3
}

test "areas" {
    assert(Square { side: 2.0 }.area() == 4.0)
    assert(pick(false).name() == "square")
}

test "ranges" {
    let mut n = 0
    for i in 1..<4 {
        n = n + i
    }
    assert(n == 6)
}
