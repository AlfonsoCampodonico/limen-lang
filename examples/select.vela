// select: wait on several channels; guards turn arms off; _ means don't wait.

// two producers feed a merger through select; a quit channel stops it
fn main(root: Root) {
    let out = root.stdout
    let nums: Chan[Int] = channel(4)
    let words: Chan[Str] = channel(4)
    let res = group g {
        g.go(|| {
                for i in [1, 2, 3, 4, 5] {
                    nums.send(i)
                }
                nums.close()
                "nums done"
            })
        g.go(|| {
                for w in ["a", "b", "c"] {
                    words.send(w)
                }
                words.close()
                "words done"
            })
        g.go(|| {
                let mut total = 0
                let mut letters = ""
                let mut nums_open = true
                let mut words_open = true
                while nums_open || words_open {
                    select {
                        n = nums.recv() if nums_open => match n {
                            Some(x) => {
                                total = total + x
                            },
                            None => {
                                nums_open = false
                            },
                        },
                        w = words.recv() if words_open => match w {
                            Some(s) => {
                                letters = letters + s
                            },
                            None => {
                                words_open = false
                            },
                        },
                    }
                }
                "total {total} letters {letters.len()}"
            })
    }
    out.print(res.join("; "))
    // `_` makes select non-blocking; the first ready arm wins
    let c: Chan[Int] = channel(1)
    let d: Chan[Int] = channel(1)
    let a = select {
        v = c.recv() => "got {v}",
        _ => "nothing ready",
    }
    let b = select {
        c.send(7) => "sent to c",
        d.send(8) => "sent to d",
    }
    let e = select {
        c.send(9) => "sent to c again",
        d.send(10) => "sent to d",
        _ => "both full",
    }
    let f = select {
        v = d.recv() => "d {v}",
        v = c.recv() => "c {v}",
    }
    out.print("{a} | {b} | {e} | {f}")
    c.close()
    let g2 = select {
        v = c.recv() => "after close: {v}",
    }
    out.print(g2)
    // a guard turns an arm off; with every arm off, select panics instead of hanging
    let none_on = catch(|| select {
            v = d.recv() if false => 1,
        })
    out.print("{none_on}")
}
