// A small report: dates from the clock, numbers lined up in columns.
// Run: limen run examples/report.lmn
use format
use time

struct Sale {
    day: Str,
    item: Str,
    amount: Float,
}

fn line(s: Sale) -> Str {
    let when = match time.parse_iso(s.day) {
        Ok(ms) => time.format(ms, "%a %d %b"),
        Err(e) => e,
    }
    format.align_left(when, 11) + format.align_left(s.item, 8) + format.align_right(format.grouped(s.amount.to_fixed(2), ","), 12)
}

fn main(root: Root) {
    let out = root.stdout
    let sales = [
        Sale { day: "2026-11-09", item: "café", amount: 1234.5 },
        Sale { day: "2026-11-10", item: "books", amount: 98.125 },
        Sale { day: "2026-11-11", item: "rent", amount: 1500000.0 },
    ]
    for s in sales {
        out.print(line(s))
    }
    let total = sales.fold(0.0, |a, s| a + s.amount)
    out.print(format.align_right(format.grouped(total.to_fixed(2), ","), 31))
    out.print("order #{format.zero_pad(42, 6)}, id 0x{format.hex(48879)}")
    let start = time.parse_iso("2026-11-01T09:30:00+01:00") ?? 0
    out.print("due {time.iso(time.add_months(start, 1))}, week {time.format(start, "%Y-%j")}")
    // the clock is a capability; everything above is pure
    let now = root.clock.now_ms()
    out.print("printed in {time.parts(now).year >= 2026}")
}
