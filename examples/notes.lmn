// A tiny notebook in SQLite: add notes, tag them, list them by tag.
//
//   limen run examples/notes.lmn --grant fs=. -- add groceries "oat milk"
//   limen run examples/notes.lmn --grant fs=. -- list groceries
//
// With no arguments it runs a short demo in memory. Values always go in as
// parameters (`?`), never pasted into the SQL text.
use sql
use text

fn setup(db: sql.Db) -> Result[(), IoError] {
    db.exec("CREATE TABLE IF NOT EXISTS notes (id INTEGER PRIMARY KEY, tag TEXT NOT NULL, body TEXT NOT NULL, stars INTEGER)
        ; CREATE INDEX IF NOT EXISTS notes_tag ON notes (tag)")?
    Ok(())
}

fn add(db: sql.Db, tag: Str, body: Str) -> Result[Int, IoError] {
    db.exec("INSERT INTO notes (tag, body) VALUES (?, ?)", [sql.Text(tag), sql.Text(body)])?
    db.last_id()
}

fn list(db: sql.Db, out: Stdout, tag: Str) -> Result[(), IoError] {
    let rows = db.query("SELECT id, body, stars FROM notes WHERE tag = ? ORDER BY id", [sql.Text(tag)])?
    for row in rows {
        let stars = match row.int("stars") {
            Some(n) => " " + text.repeat("*", n),
            None => "",
        }
        out.print("{row.int("id") ?? 0}. {row.text("body") ?? ""}{stars}")
    }
    if rows.is_empty() {
        out.print("no notes tagged {tag}")
    }
    Ok(())
}

fn demo(out: Stdout) -> Result[(), IoError] {
    let db = sql.memory()?
    setup(db)?
    add(db, "books", "The Left Hand of Darkness")?
    add(db, "books", "Robert'); DROP TABLE notes; --")?
    let id = add(db, "films", "Paris, Texas")?
    // star a note and move the others in one transaction: all or nothing
    db.transaction(|| {
        db.exec("UPDATE notes SET stars = ? WHERE id = ?", [sql.Int(3), sql.Int(id)])?
        db.exec("UPDATE notes SET tag = ? WHERE tag = ?", [sql.Text("reading"), sql.Text("books")])
    })?
    list(db, out, "reading")?
    list(db, out, "films")?
    match db.query_one("SELECT count(*) AS n FROM notes")? {
        Some(row) => out.print("{row.int("n") ?? 0} notes"),
        None => (),
    }
    db.close()
}

fn main(root: Root) -> Result[(), IoError] {
    let out = root.stdout
    let args = root.args()
    if args.is_empty() {
        return demo(out)
    }
    let db = sql.open(root.fs, "notes.db")?
    setup(db)?
    if args.len() == 3 && args[0] == "add" {
        out.print("added {add(db, args[1], args[2])?}")
    } else if args.len() == 2 && args[0] == "list" {
        list(db, out, args[1])?
    } else {
        out.print("usage: add TAG TEXT | list TAG")
    }
    db.close()
}
