// Digests of files or text, as shasum and md5sum print them, or HMACs
// under a key: the flags, hash, hex and base64 modules together.
//
//     limen run examples/checksum.lmn --grant fs=.:ro -- README.md SPEC.md
//     limen run examples/checksum.lmn -- --algo md5 --text "hello"
//     limen run examples/checksum.lmn -- --key secret --base64 --text "payload"
use base64
use flags
use hash
use hex

fn digest(algo: Str, key: Str, data: Bytes) -> Result[Bytes, Str] {
    let k = key.to_bytes()
    match (algo, key == "") {
        ("sha256", true) => Ok(hash.sha256(data)),
        ("sha256", false) => Ok(hash.hmac_sha256(k, data)),
        ("sha1", true) => Ok(hash.sha1(data)),
        ("sha1", false) => Ok(hash.hmac_sha1(k, data)),
        ("md5", true) => Ok(hash.md5(data)),
        ("md5", false) => Err("checksum: no HMAC with md5; use sha256 or sha1"),
        _ => Err("checksum: unknown algorithm `{algo}` (sha256, sha1 or md5)"),
    }
}

fn main(root: Root) -> Result[Int, dyn Error] {
    let spec = flags.spec("checksum", "Print a digest of each FILE, or of the text given with --text.")
        .option("algo", "a", "sha256, sha1 or md5").default("sha256")
        .option("key", "k", "print an HMAC under this key instead")
        .option("text", "t", "digest this text instead of files")
        .flag("base64", "b", "print digests in base64 instead of hex")
        .rest("FILE", "files to read")
    let p = spec.parse(root.args())?
    if p.help {
        root.stdout.write(spec.help())
        return Ok(0)
    }
    let show = |d: Bytes| if p.bool("base64") { base64.encode(d) } else { hex.encode(d) }
    let algo = p.str("algo")
    let key = p.str("key")
    match p.get("text") {
        Some(t) => root.stdout.print("{show(digest(algo, key, t.to_bytes())?)}  -"),
        None => {
            if p.rest().is_empty() {
                root.stderr.print(spec.usage())
                return Ok(2)
            }
            for name in p.rest() {
                let data = root.fs.read(name)? "reading {name}"
                root.stdout.print("{show(digest(algo, key, data.to_bytes())?)}  {name}")
            }
        },
    }
    Ok(0)
}
