// The standard library modules: json, list and text.
use json
use list
use text

struct P {
    name: Str,
    age: Int,
}

fn main(root: Root) {
    let out = root.stdout
    let src = "\{\"name\": \"Ada\", \"tags\": [\"x\", \"y\\u00e9\\ud83d\\ude00\"], \"n\": -12.5e1, \"ok\": true, \"none\": null, \"nested\": \{\"a\": [1, 2, \{\}]\}\}"
    match json.parse(src) {
        Ok(v) => {
            out.print(json.stringify(v))
            out.print(v.get("name").map(|n| n.as_str() ?? "?") ?? "missing")
            out.print("{v.get("n").map(|n| n.as_num() ?? 0.0) ?? 0.0}")
        },
        Err(e) => out.print("error: " + e),
    }
    for bad in ["[1,", "\{\"a\" 1\}", "tru", "\"abc", "[1] x", ""] {
        match json.parse(bad) {
            Ok(_) => out.print("parsed?!"),
            Err(e) => out.print(e),
        }
    }
    out.print(json.stringify(json.Obj([json.field("q", json.Str("a\"b\n" + 1.to_char())), json.field("xs", json.Arr([json.Num(1.0), json.Null, json.Bool(false)]))])))
    let ps = [P { name: "b", age: 30 }, P { name: "a", age: 25 }, P { name: "c", age: 30 }]
    let sorted = list.sort_by(ps, |x, y| x.age < y.age)
    out.print(sorted.map(|p| p.name).join(","))
    out.print("{list.range(0, 5)} {list.index_of([4, 5, 6], 6) ?? -1} {list.remove_at([1, 2, 3], 1)} {list.insert_at([1, 3], 1, 2)} {list.insert_at([1], 9, 2)}")
    out.print(text.pad_left("7", 3, "0") + "|" + text.pad_right("ab", 4, ".") + "|" + text.repeat("-", 3) + "|{text.count("banana", "an")}|{text.words("  hi  there\tyou ")}")
}
