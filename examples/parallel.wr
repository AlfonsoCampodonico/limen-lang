// Fetch several GitHub orgs at once. Each task gets the same narrowed Net
// capability; the group returns results in the order the tasks were started.
//
//   writ run --native examples/parallel.wr --grant net=api.github.com

fn main(root: Root) {
    let gh = root.net.only("api.github.com")
    let orgs = ["rust-lang", "ocaml", "golang", "python"]
    let results = group g {
        for org in orgs {
            g.go(|| count_repos(gh, org))
        }
    }
    let mut i = 0
    while i < orgs.len() {
        match results[i] {
            Ok(n) => root.stdout.print("{orgs[i]}: {n} public repos on the first page"),
            Err(e) => root.stdout.print("{orgs[i]}: {e}"),
        }
        i = i + 1
    }
}

fn count_repos(net: Net, org: Str) -> Result[Int, IoError] {
    let body = net.get("https://api.github.com/orgs/{org}/repos?per_page=100")?
    Ok(body.split("\"full_name\":").len() - 1)
}
