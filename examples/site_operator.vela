// A Kubernetes operator that serves static websites. You describe a site
// with a StaticSite resource (examples/k8s/), and for each one it keeps
// three objects in the cluster:
//
//   ConfigMap   NAME-html   the page, from spec.html
//   Deployment  NAME        nginx serving it, spec.replicas copies
//   Service     NAME        port 80 in front of them
//
// and writes status.readyReplicas, status.url and status.message back to
// the site. It is level-triggered: every few seconds it reads every site
// and applies what should exist with server-side apply, so an object that
// is already right is not touched and one changed by hand is put back.
// Deleting a site deletes its objects: they name the site as their owner,
// and Kubernetes collects them.
//
// It reaches the API server through `kubectl proxy`, which holds the
// credentials. That proxy is the only thing it can reach:
//
//   kind create cluster --name vela-demo                (kubectl now points at it)
//   kubectl apply -f examples/k8s/staticsite-crd.yaml
//   kubectl proxy --port 8001 &
//   vela run examples/site_operator.vela --grant net=127.0.0.1:8001
//   kubectl apply -f examples/k8s/hello-site.yaml       (in another terminal)
//
// `-- once` makes one pass and exits. The tests need no cluster:
//
//   vela test examples/site_operator.vela
use http
use json
use time

// ---------- the resource ----------

struct Site {
    namespace: Str,
    name: Str,
    uid: Str,
    html: Str,
    replicas: Int,
    status: Status,
}

struct Status {
    ready: Int,
    url: Str,
    message: Str,
}

// the value at a path of keys, like .metadata.name
fn dig(v: json.Value, keys: List[Str]) -> Option[json.Value] {
    let mut cur = v
    for k in keys {
        cur = cur.get(k) ?? { return None }
    }
    Some(cur)
}

fn str_at(v: json.Value, keys: List[Str]) -> Option[Str] {
    match dig(v, keys) {
        Some(x) => x.as_str(),
        None => None,
    }
}

fn int_at(v: json.Value, keys: List[Str]) -> Option[Int] {
    match dig(v, keys) {
        Some(x) => x.as_int(),
        None => None,
    }
}

fn parse_site(item: json.Value) -> Result[Site, Str] {
    let name = str_at(item, ["metadata", "name"]) ?? { return Err("a StaticSite without a name") }
    Ok(Site {
        namespace: str_at(item, ["metadata", "namespace"]) ?? "default",
        name,
        uid: str_at(item, ["metadata", "uid"]) ?? "",
        html: str_at(item, ["spec", "html"]) ?? "",
        replicas: int_at(item, ["spec", "replicas"]) ?? 1,
        status: Status {
            ready: int_at(item, ["status", "readyReplicas"]) ?? 0,
            url: str_at(item, ["status", "url"]) ?? "",
            message: str_at(item, ["status", "message"]) ?? "",
        },
    })
}

// What is wrong with a site, if anything. A wrong site gets no objects,
// only a status message saying why.
fn problem(s: Site) -> Option[Str] {
    if s.html.trim().is_empty() {
        Some("spec.html is empty")
    } else if s.replicas < 0 || s.replicas > 10 {
        Some("spec.replicas must be 0 to 10, not {s.replicas}")
    } else if s.name.len() > 58 {
        Some("the name is longer than 58 characters, too long for NAME-html")
    } else {
        None
    }
}

// ---------- what should exist ----------

fn obj(pairs: List[(Str, json.Value)]) -> json.Value {
    json.Obj(pairs.map(|p| json.field(p.0, p.1)))
}

fn str(s: Str) -> json.Value {
    json.Str(s)
}

fn num(n: Int) -> json.Value {
    json.Num(n.to_float())
}

fn one(v: json.Value) -> json.Value {
    json.Arr([v])
}

// An object the operator keeps, and where it lives in the API.
struct Object {
    kind: Str,
    name: Str,
    path: Str,
    body: json.Value,
}

fn labels(s: Site) -> json.Value {
    obj([("app.kubernetes.io/name", str("static-site")), ("vela.dev/site", str(s.name))])
}

fn metadata(s: Site, name: Str) -> json.Value {
    obj([
        ("name", str(name)),
        ("namespace", str(s.namespace)),
        ("labels", labels(s)),
        // the site owns it: deleting the site deletes it
        ("ownerReferences", one(obj([
            ("apiVersion", str("vela.dev/v1")),
            ("kind", str("StaticSite")),
            ("name", str(s.name)),
            ("uid", str(s.uid)),
            ("controller", json.Bool(true)),
        ]))),
    ])
}

// A short fingerprint of the page. It goes on the pods, so a new page
// rolls them instead of waiting for the ConfigMap to reach their disks.
fn fingerprint(text: Str) -> Str {
    let mut h = 17
    for b in text.bytes() {
        h = (h * 31 + b) % 1000000007
    }
    h.to_str()
}

fn page_name(s: Site) -> Str {
    "{s.name}-html"
}

fn config_map(s: Site) -> Object {
    let name = page_name(s)
    Object {
        kind: "ConfigMap",
        name,
        path: "/api/v1/namespaces/{s.namespace}/configmaps/{name}",
        body: obj([
            ("apiVersion", str("v1")),
            ("kind", str("ConfigMap")),
            ("metadata", metadata(s, name)),
            ("data", obj([("index.html", str(s.html))])),
        ]),
    }
}

fn pod(s: Site) -> json.Value {
    obj([
        ("metadata", obj([
            ("labels", labels(s)),
            ("annotations", obj([("vela.dev/page", str(fingerprint(s.html)))])),
        ])),
        ("spec", obj([
            ("containers", one(obj([
                ("name", str("nginx")),
                ("image", str("nginx:1.27-alpine")),
                ("ports", one(obj([("containerPort", num(80))]))),
                ("volumeMounts", one(obj([("name", str("page")), ("mountPath", str("/usr/share/nginx/html"))]))),
            ]))),
            ("volumes", one(obj([("name", str("page")), ("configMap", obj([("name", str(page_name(s)))]))]))),
        ])),
    ])
}

fn deployment(s: Site) -> Object {
    Object {
        kind: "Deployment",
        name: s.name,
        path: "/apis/apps/v1/namespaces/{s.namespace}/deployments/{s.name}",
        body: obj([
            ("apiVersion", str("apps/v1")),
            ("kind", str("Deployment")),
            ("metadata", metadata(s, s.name)),
            ("spec", obj([
                ("replicas", num(s.replicas)),
                ("selector", obj([("matchLabels", labels(s))])),
                ("template", pod(s)),
            ])),
        ]),
    }
}

fn service(s: Site) -> Object {
    Object {
        kind: "Service",
        name: s.name,
        path: "/api/v1/namespaces/{s.namespace}/services/{s.name}",
        body: obj([
            ("apiVersion", str("v1")),
            ("kind", str("Service")),
            ("metadata", metadata(s, s.name)),
            ("spec", obj([
                ("selector", labels(s)),
                ("ports", one(obj([("port", num(80)), ("targetPort", num(80))]))),
            ])),
        ]),
    }
}

fn desired(s: Site) -> List[Object] {
    [config_map(s), deployment(s), service(s)]
}

// The status a site should show, given its Deployment as the API returned it.
fn status_for(s: Site, deployment: json.Value) -> Status {
    let ready = int_at(deployment, ["status", "readyReplicas"]) ?? 0
    Status {
        ready,
        url: "http://{s.name}.{s.namespace}.svc.cluster.local",
        message: if ready == s.replicas { "ready" } else { "{ready} of {s.replicas} ready" },
    }
}

// What applying an object did, for the log, given the HTTP status and its
// version before and after. `None`: nothing changed, so nothing to say.
fn outcome(code: Int, before: Option[Str], after: Str) -> Option[Str] {
    if code == 201 {
        return Some("created")
    }
    match before {
        None => Some("in sync"),
        Some(v) if v != after => Some("updated"),
        Some(_) => None,
    }
}

// An object's version: its generation, which changes only when its spec
// does, or its resourceVersion when it has no generation (a ConfigMap).
fn version(v: json.Value) -> Str {
    match int_at(v, ["metadata", "generation"]) {
        Some(g) => g.to_str(),
        None => str_at(v, ["metadata", "resourceVersion"]) ?? "",
    }
}

// ---------- talking to the API server ----------

fn call(net: Net, base: Str, method: Str, path: Str, content_type: Str, body: Str) -> Result[(Int, json.Value), Str] {
    let mut headers = [http.Header { name: "Accept", value: "application/json" }]
    if !content_type.is_empty() {
        headers.push(http.Header { name: "Content-Type", value: content_type })
    }
    let r = match http.request(net, method, base + path, headers, body) {
        Ok(r) => r,
        Err(e) => { return Err("{method} {path}: {e}") },
    }
    let v = json.parse(r.body) ?? json.Null
    if r.status >= 300 {
        // the API server explains itself in a Status object
        let why = str_at(v, ["message"]) ?? r.body
        return Err("{method} {path}: {r.status} {why}")
    }
    Ok((r.status, v))
}

// Server-side apply: send the whole object as we want it. Fields we set are
// ours, so a change made to them by hand is reverted (`force`); fields we
// never set are left alone.
fn apply(net: Net, base: Str, o: Object) -> Result[(Int, json.Value), Str] {
    let query = "?fieldManager=vela-site-operator&force=true"
    call(net, base, "PATCH", o.path + query, "application/apply-patch+yaml", json.stringify(o.body))
}

fn set_status(net: Net, base: Str, s: Site, st: Status) -> Result[(), Str] {
    let path = "/apis/vela.dev/v1/namespaces/{s.namespace}/staticsites/{s.name}/status"
    let patch = obj([("status", obj([
        ("readyReplicas", num(st.ready)),
        ("url", str(st.url)),
        ("message", str(st.message)),
    ]))])
    call(net, base, "PATCH", path, "application/merge-patch+json", json.stringify(patch))?
    Ok(())
}

// ---------- the loop ----------

// Each pass gets the versions seen by the last one, keyed by "Kind ns/name",
// and returns the versions it saw.
fn sync(log: fn(Str) -> (), net: Net, base: Str, s: Site, seen: Map[Str, Str]) -> Result[Map[Str, Str], Str] {
    let mut now = map()
    let site = "{s.namespace}/{s.name}"
    let wanted = match problem(s) {
        Some(why) => Status { ready: 0, url: "", message: "invalid: {why}" },
        None => {
            let mut dep = json.Null
            for o in desired(s) {
                let (code, got) = apply(net, base, o)?
                let key = "{o.kind} {s.namespace}/{o.name}"
                let v = version(got)
                match outcome(code, seen.get(key), v) {
                    Some(what) => log("{site}: {o.kind} {o.name} {what}"),
                    None => (),
                }
                now[key] = v
                if o.kind == "Deployment" {
                    dep = got
                }
            }
            status_for(s, dep)
        },
    }
    if wanted != s.status {
        set_status(net, base, s, wanted)?
        log("{site}: {wanted.message}")
    }
    now["StaticSite {site}"] = ""
    Ok(now)
}

fn pass(log: fn(Str) -> (), net: Net, base: Str, seen: Map[Str, Str]) -> Result[Map[Str, Str], Str] {
    let (_, list) = call(net, base, "GET", "/apis/vela.dev/v1/staticsites", "", "")?
    let items = dig(list, ["items"]) ?? json.Arr([])
    let mut next = map()
    for item in items.as_list() ?? [] {
        match parse_site(item) {
            Err(e) => log("skipped: {e}"),
            Ok(s) => match sync(log, net, base, s, seen) {
                Ok(now) => {
                    for (k, v) in now.entries() {
                        next[k] = v
                    }
                },
                // one broken site does not stop the others; it is tried again next pass
                Err(e) => {
                    log("{s.namespace}/{s.name}: {e}")
                    next["StaticSite {s.namespace}/{s.name}"] = ""
                },
            },
        }
    }
    for k in seen.keys() {
        if k.starts_with("StaticSite ") && !next.contains(k) {
            log("{k.slice(11, k.len())}: deleted; Kubernetes removes its objects")
        }
    }
    Ok(next)
}

fn main(root: Root) -> Result[(), IoError] {
    let args = root.args()
    let once = args.contains("once")
    let net = root.net
    let base = "http://127.0.0.1:8001"
    let out = root.stdout
    let clock = root.clock
    let log = |line: Str| out.print("{time.format(clock.now_ms(), "%H:%M:%S")} {line}")
    log("watching StaticSites through {base}")
    let mut seen = map()
    while true {
        match pass(log, net, base, seen) {
            Ok(next) => { seen = next },
            Err(e) => {
                if once {
                    return Err(Failed(e))
                }
                log("pass failed, trying again: {e}")
            },
        }
        if once {
            return Ok(())
        }
        clock.sleep(3000)
    }
    Ok(())
}

// ---------- tests ----------
// The manifests and the decisions, with no cluster.

fn site(name: Str, html: Str, replicas: Int) -> Site {
    Site {
        namespace: "default",
        name,
        uid: "uid-1",
        html,
        replicas,
        status: Status { ready: 0, url: "", message: "" },
    }
}

// the first element of the list at a path
fn first(v: json.Value, keys: List[Str]) -> json.Value {
    (dig(v, keys) ?? json.Null).at(0) ?? json.Null
}

test "a site from the API" {
    let item = obj([
        ("metadata", obj([("name", str("hello")), ("namespace", str("web")), ("uid", str("u-7"))])),
        ("spec", obj([("html", str("<h1>hi</h1>")), ("replicas", num(2))])),
        ("status", obj([("readyReplicas", num(1))])),
    ])
    let want = Site {
        namespace: "web",
        name: "hello",
        uid: "u-7",
        html: "<h1>hi</h1>",
        replicas: 2,
        status: Status { ready: 1, url: "", message: "" },
    }
    assert_eq(parse_site(item), Ok(want))
    assert_eq(parse_site(obj([("spec", obj([]))])), Err("a StaticSite without a name"))
}

test "three objects, all owned by the site" {
    let objects = desired(site("hello", "<h1>hi</h1>", 2))
    assert_eq(objects.map(|o| "{o.kind} {o.name}"), ["ConfigMap hello-html", "Deployment hello", "Service hello"])
    for o in objects {
        assert_eq(str_at(o.body, ["metadata", "namespace"]), Some("default"))
        assert_eq(str_at(first(o.body, ["metadata", "ownerReferences"]), ["uid"]), Some("uid-1"))
    }
}

test "the deployment serves the page" {
    let d = deployment(site("hello", "<h1>hi</h1>", 3)).body
    assert_eq(int_at(d, ["spec", "replicas"]), Some(3))
    assert_eq(str_at(first(d, ["spec", "template", "spec", "volumes"]), ["configMap", "name"]), Some("hello-html"))
    assert_eq(str_at(config_map(site("hello", "<h1>hi</h1>", 3)).body, ["data", "index.html"]), Some("<h1>hi</h1>"))
}

test "a new page rolls the pods" {
    let before = deployment(site("hello", "<h1>hi</h1>", 1)).body
    let after = deployment(site("hello", "<h1>bye</h1>", 1)).body
    let page = ["spec", "template", "metadata", "annotations", "vela.dev/page"]
    assert(str_at(before, page) != str_at(after, page))
    assert_eq(str_at(before, page), str_at(deployment(site("hello", "<h1>hi</h1>", 5)).body, page))
}

test "invalid" for (s, why) in [
    (site("a", "  ", 1), "spec.html is empty"),
    (site("a", "x", -1), "spec.replicas must be 0 to 10, not -1"),
    (site("a", "x", 11), "spec.replicas must be 0 to 10, not 11"),
    (site(text_of(59), "x", 1), "the name is longer than 58 characters, too long for NAME-html"),
] {
    assert_eq(problem(s), Some(why))
}

fn text_of(n: Int) -> Str {
    let mut s = ""
    while s.len() < n {
        s = s + "a"
    }
    s
}

test "valid sites have no problem" {
    assert_eq(problem(site("hello", "x", 0)), None)
    assert_eq(problem(site(text_of(58), "x", 10)), None)
}

test "outcome" for (code, before, after, said) in [
    (201, None, "1", Some("created")),
    (200, None, "1", Some("in sync")),
    (200, Some("1"), "1", None),
    (200, Some("1"), "2", Some("updated")),
] {
    assert_eq(outcome(code, before, after), said)
}

test "status" {
    let s = site("hello", "x", 2)
    let dep = obj([("status", obj([("readyReplicas", num(1))]))])
    assert_eq(status_for(s, dep), Status { ready: 1, url: "http://hello.default.svc.cluster.local", message: "1 of 2 ready" })
    assert_eq(status_for(s, obj([("status", obj([("readyReplicas", num(2))]))])).message, "ready")
    assert_eq(status_for(s, json.Null).ready, 0)
}

test "version prefers the generation" {
    let meta = |fields| obj([("metadata", obj(fields))])
    assert_eq(version(meta([("generation", num(4)), ("resourceVersion", str("812"))])), "4")
    assert_eq(version(meta([("resourceVersion", str("812"))])), "812")
}
