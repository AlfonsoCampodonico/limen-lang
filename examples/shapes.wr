// Enums, exhaustive match, generics and closures. No I/O except printing.

enum Shape {
    Circle(Float),
    Rect(Float, Float),
    Point,
}

fn area(s: Shape) -> Float {
    match s {
        Circle(r) => 3.14159 * r * r,
        Rect(w, h) => w * h,
        Point => 0.0,
    }
}

fn largest[T](xs: List[T], score: fn(T) -> Float) -> Option[T] {
    let mut best: Option[T] = None
    let mut best_score = -1.0
    for x in xs {
        let s = score(x)
        if s > best_score {
            best = Some(x)
            best_score = s
        }
    }
    best
}

fn main(root: Root) {
    let out = root.stdout
    let shapes = [Circle(1.0), Rect(2.0, 3.0), Point, Shape.Circle(0.5)]
    let areas = shapes.map(|s| area(s))
    out.print("areas: {areas}")
    out.print("total: {areas.fold(0.0, |acc, a| acc + a)}")
    match largest(shapes, area) {
        Some(s) => out.print("largest: {s}"),
        None => out.print("no shapes"),
    }
    let big = shapes.filter(|s| area(s) > 1.0).len()
    out.print("{big} shapes have area > 1")
}
