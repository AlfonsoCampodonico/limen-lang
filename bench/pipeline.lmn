// filter / map / fold with closures over a 3M-element list, 30 rounds.
// Each stage builds a new list, as written.
fn main(root: Root) {
    let mut xs = []
    let mut i = 0
    while i < 3000000 {
        xs.push(i)
        i = i + 1
    }
    let mut total = 0
    let mut round = 0
    while round < 30 {
        let k = round
        total = total + xs.filter(|x| x % 2 == 0).map(|x| (x * x + k) % 1000).fold(0, |a, b| a + b)
        round = round + 1
    }
    root.stdout.print("{total}")
}
