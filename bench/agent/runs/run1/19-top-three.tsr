struct Score {
    name: Str,
    score: Int,
}

fn before(a: Score, b: Score) -> Bool {
    if a.score != b.score { a.score > b.score } else { a.name < b.name }
}

fn main(root: Root) {
    let mut xs = [
        Score { name: "ana", score: 81 },
        Score { name: "ben", score: 92 },
        Score { name: "cy", score: 77 },
        Score { name: "di", score: 92 },
        Score { name: "ed", score: 64 },
    ]
    let mut i = 1
    while i < xs.len() {
        let cur = xs[i]
        let mut j = i - 1
        while j >= 0 && before(cur, xs[j]) {
            xs[j + 1] = xs[j]
            j = j - 1
        }
        xs[j + 1] = cur
        i = i + 1
    }
    for s in xs.take(3) {
        root.stdout.print("{s.name} {s.score}")
    }
}
