fn merge(a: List[Int], b: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = 0
    let mut j = 0
    while i < a.len() && j < b.len() {
        if a[i] <= b[j] {
            out.push(a[i])
            i = i + 1
        } else {
            out.push(b[j])
            j = j + 1
        }
    }
    while i < a.len() {
        out.push(a[i])
        i = i + 1
    }
    while j < b.len() {
        out.push(b[j])
        j = j + 1
    }
    out
}

fn main(root: Root) {
    root.stdout.print("{merge([1, 4, 7, 10], [2, 3, 8, 9, 11])}")
}
