fn insertion_sort(xs: List[Int]) -> List[Int] {
    let mut a = xs
    let mut i = 1
    while i < a.len() {
        let cur = a[i]
        let mut j = i - 1
        while j >= 0 && a[j] > cur {
            a[j + 1] = a[j]
            j = j - 1
        }
        a[j + 1] = cur
        i = i + 1
    }
    a
}

fn main(root: Root) {
    root.stdout.print("{insertion_sort([3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5])}")
}
