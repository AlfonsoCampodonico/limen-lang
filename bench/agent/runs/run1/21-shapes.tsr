enum Shape {
    Circle(Float),
    Rect(Float, Float),
    Square(Float),
}

fn area(s: Shape) -> Float {
    match s {
        Circle(r) => 3.0 * r * r,
        Rect(w, h) => w * h,
        Square(a) => a * a,
    }
}

fn main(root: Root) {
    for s in [Circle(2.0), Rect(3.0, 4.5), Square(1.5)] {
        root.stdout.print("{area(s)}")
    }
}
