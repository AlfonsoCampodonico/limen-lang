fn main(root: Root) {
    let c: Chan[Int] = channel(3)
    let results = group g {
        g.go(|| {
            let mut i = 1
            while i <= 20 {
                c.send(i)
                i = i + 1
            }
            c.close()
            0
        })
        g.go(|| {
            let mut sum = 0
            let mut more = true
            while more {
                match c.recv() {
                    Some(v) => { if v % 2 == 0 { sum = sum + v } },
                    None => { more = false },
                }
            }
            sum
        })
    }
    root.stdout.print("{results[1]}")
}
