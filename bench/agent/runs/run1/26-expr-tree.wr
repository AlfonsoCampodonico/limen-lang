enum Expr {
    Num(Int),
    Add(Expr, Expr),
    Mul(Expr, Expr),
    Neg(Expr),
}

fn eval(e: Expr) -> Int {
    match e {
        Num(n) => n,
        Add(a, b) => eval(a) + eval(b),
        Mul(a, b) => eval(a) * eval(b),
        Neg(a) => -eval(a),
    }
}

fn main(root: Root) {
    let e = Mul(Add(Num(2), Num(3)), Neg(Add(Num(4), Num(1))))
    root.stdout.print("{eval(e)}")
}
