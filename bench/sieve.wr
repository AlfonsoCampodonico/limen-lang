// Primes up to 100 million: a 100M-element list built with push, then
// mutated in place by index. Exercises copy-on-write staying unique.
fn main(root: Root) {
    let n = 100000000
    let mut is_prime = []
    let mut i = 0
    while i <= n {
        is_prime.push(true)
        i = i + 1
    }
    is_prime[0] = false
    is_prime[1] = false
    let mut p = 2
    while p * p <= n {
        if is_prime[p] {
            let mut m = p * p
            while m <= n {
                is_prime[m] = false
                m = m + p
            }
        }
        p = p + 1
    }
    let mut count = 0
    for b in is_prime {
        if b { count = count + 1 }
    }
    root.stdout.print("{count}")
}
