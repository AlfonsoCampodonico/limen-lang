{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Limen",
  "scopeName": "source.limen",
  "fileTypes": [
    "lmn"
  ],
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string-multiline"
        },
        {
          "include": "#string"
        },
        {
          "include": "#test-block"
        },
        {
          "include": "#foreign-block"
        },
        {
          "include": "#fn-decl"
        },
        {
          "include": "#type-decl"
        },
        {
          "include": "#alias-decl"
        },
        {
          "include": "#use"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#capability"
        },
        {
          "include": "#type"
        },
        {
          "include": "#number"
        },
        {
          "include": "#call"
        },
        {
          "include": "#field"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.limen"
    },
    "string": {
      "name": "string.quoted.double.limen",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.limen"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.limen"
        }
      },
      "patterns": [
        {
          "match": "\\\\[ntr0\\\\\\\"{}]",
          "name": "constant.character.escape.limen"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.limen"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "string-multiline": {
      "name": "string.quoted.triple.limen",
      "begin": "\"\"\"(?=[ \\t\\r]*$)",
      "end": "^[ \\t]*\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.limen"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.limen"
        }
      },
      "patterns": [
        {
          "match": "\\\\$",
          "name": "constant.character.escape.line-continuation.limen"
        },
        {
          "match": "\\\\[ntr0\\\\\\\"{}]",
          "name": "constant.character.escape.limen"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.limen"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.limen",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.limen"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.limen"
        }
      },
      "contentName": "source.limen.embedded",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "#code"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.limen"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.limen"
        }
      },
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "#code"
        }
      ]
    },
    "test-block": {
      "match": "^\\s*\\b(test|bench)\\b(?=\\s+\\\")",
      "captures": {
        "1": {
          "name": "keyword.other.test.limen"
        }
      }
    },
    "foreign-block": {
      "match": "\\b(foreign)\\b(?=\\s+\\\")",
      "captures": {
        "1": {
          "name": "storage.modifier.foreign.limen"
        }
      }
    },
    "fn-decl": {
      "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.limen"
        },
        "2": {
          "name": "entity.name.function.limen"
        }
      }
    },
    "type-decl": {
      "match": "\\b(struct|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.$1.limen"
        },
        "2": {
          "name": "entity.name.type.limen"
        }
      }
    },
    "alias-decl": {
      "match": "^\\s*(?:pub\\s+)?(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.type.alias.limen"
        },
        "2": {
          "name": "entity.name.type.limen"
        }
      }
    },
    "use": {
      "match": "\\b(use)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.other.use.limen"
        },
        "2": {
          "name": "entity.name.namespace.limen"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(if|else|match|for|in|while|return|break|continue|select|defer|group|until)\\b",
          "name": "keyword.control.limen"
        },
        {
          "match": "\\b(let|fn|struct|enum|interface)\\b",
          "name": "storage.type.limen"
        },
        {
          "match": "\\b(mut|pub|dyn)\\b",
          "name": "storage.modifier.limen"
        },
        {
          "match": "\\b(with|as)\\b",
          "name": "keyword.other.with.limen"
        },
        {
          "match": "\\b(virtual)\\b",
          "name": "storage.modifier.limen"
        },
        {
          "match": "\\b(use)\\b",
          "name": "keyword.other.use.limen"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.limen"
        },
        {
          "match": "\\bself\\b",
          "name": "variable.language.self.limen"
        }
      ]
    },
    "capability": {
      "match": "\\b(Root|Net|Fs|Listen|Listener|Conn|Env|Exec|Foreign|Revoker|Stdout|Stderr|Stdin|Clock|Rand)\\b",
      "name": "support.type.capability.limen"
    },
    "type": {
      "patterns": [
        {
          "match": "\\b(Some|None|Ok|Err)\\b",
          "name": "support.function.variant.limen"
        },
        {
          "match": "\\b(Int|Int32|Float|Bool|Str|Bytes|List|Map|Option|Result|Chan|Error|Handle)\\b",
          "name": "support.type.builtin.limen"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.limen"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*([eE][+-]?\\d+)?|[eE][+-]?\\d+)\\b",
          "name": "constant.numeric.float.limen"
        },
        {
          "match": "\\b\\d[\\d_]*\\b",
          "name": "constant.numeric.integer.limen"
        }
      ]
    },
    "call": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "name": "entity.name.function.call.limen"
        },
        {
          "match": "(?<=\\.)([a-z_][A-Za-z0-9_]*)(?=\\s*\\{\\s*\\|)",
          "name": "entity.name.function.call.limen"
        }
      ]
    },
    "field": {
      "match": "(?<=\\.)([a-z_][A-Za-z0-9_]*)\\b",
      "name": "variable.other.member.limen"
    },
    "operator": {
      "patterns": [
        {
          "match": "\\|>",
          "name": "keyword.operator.pipe.limen"
        },
        {
          "match": "\\?\\?|\\?\\.|\\?",
          "name": "keyword.operator.option.limen"
        },
        {
          "match": "\\.\\.<|\\.\\.",
          "name": "keyword.operator.range.limen"
        },
        {
          "match": "=>|->",
          "name": "keyword.operator.arrow.limen"
        },
        {
          "match": "<<|>>",
          "name": "keyword.operator.bitwise.limen"
        },
        {
          "match": "==|!=|<=|>=|&&|\\|\\||[<>!]",
          "name": "keyword.operator.comparison.limen"
        },
        {
          "match": "[-+*/%]",
          "name": "keyword.operator.arithmetic.limen"
        },
        {
          "match": "[&^~]",
          "name": "keyword.operator.bitwise.limen"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.limen"
        },
        {
          "match": "\\|",
          "name": "punctuation.definition.closure.limen"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[,;]",
          "name": "punctuation.separator.limen"
        },
        {
          "match": "::|:",
          "name": "punctuation.separator.type.limen"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.limen"
        }
      ]
    }
  }
}
