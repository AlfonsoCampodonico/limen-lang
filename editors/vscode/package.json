{
  "name": "tessera",
  "displayName": "Tessera",
  "description": "Tessera language support: syntax highlighting, and errors, hover, go to definition, rename and completion from `tessera lsp`.",
  "version": "0.1.0",
  "publisher": "tessera-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/tessera.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tessera",
        "aliases": [
          "Tessera",
          "tessera"
        ],
        "extensions": [
          ".tsr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tessera",
        "scopeName": "source.tessera",
        "path": "./syntaxes/tessera.tmLanguage.json"
      },
      {
        "scopeName": "markdown.tessera.codeblock",
        "path": "./syntaxes/tessera.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.tessera": "tessera"
        }
      }
    ],
    "configuration": {
      "title": "Tessera",
      "properties": {
        "tessera.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `tessera` executable, set in your user settings (a workspace cannot set it). When empty, `tessera` on the PATH is used, or else, in a trusted folder only, the build in that folder (`_build/default/bin/main.exe`).",
          "scope": "machine"
        },
        "tessera.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start `tessera lsp` for errors, hover, go to definition, references, rename and completion."
        }
      }
    },
    "commands": [
      {
        "command": "tessera.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Tessera"
      }
    ],
    "configurationDefaults": {
      "[tessera]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository --skip-license -o tessera.vsix",
    "test": "node test/grammar.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.2.1",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.1.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you have not trusted, the extension does not run the folder's own build of `tessera`; highlighting and `tessera` from your PATH or user settings still work.",
      "restrictedConfigurations": [
        "tessera.path"
      ]
    },
    "virtualWorkspaces": false
  }
}
