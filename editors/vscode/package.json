{
  "name": "limen",
  "displayName": "Limen",
  "description": "Limen language support: syntax highlighting, and errors, hover, go to definition, rename and completion from `limen lsp`.",
  "version": "0.1.0",
  "publisher": "limen-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/limen.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "limen",
        "aliases": [
          "Limen",
          "limen"
        ],
        "extensions": [
          ".lmn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "limen",
        "scopeName": "source.limen",
        "path": "./syntaxes/limen.tmLanguage.json"
      },
      {
        "scopeName": "markdown.limen.codeblock",
        "path": "./syntaxes/limen.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.limen": "limen"
        }
      }
    ],
    "configuration": {
      "title": "Limen",
      "properties": {
        "limen.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `limen` executable, set in your user settings (a workspace cannot set it). When empty, `limen` on the PATH is used, or else, in a trusted folder only, the build in that folder (`_build/default/bin/main.exe`).",
          "scope": "machine"
        },
        "limen.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start `limen lsp` for errors, hover, go to definition, references, rename and completion."
        }
      }
    },
    "commands": [
      {
        "command": "limen.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Limen"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "capability",
        "superType": "type",
        "description": "A built-in capability, such as Net or Fs: authority a function must be given."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "capability",
        "description": "Holds authority: a type, field, parameter or variable whose type holds a capability."
      },
      {
        "id": "mutable",
        "description": "A variable declared with `let mut`."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "limen",
        "scopes": {
          "capability": [
            "support.type.capability.limen"
          ],
          "namespace": [
            "entity.name.namespace.limen"
          ],
          "struct.capability": [
            "support.type.capability.limen"
          ],
          "enum.capability": [
            "support.type.capability.limen"
          ],
          "parameter.capability": [
            "variable.parameter.capability.limen"
          ],
          "variable.capability": [
            "variable.other.capability.limen"
          ],
          "property.capability": [
            "variable.other.member.capability.limen"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[limen]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository --skip-license -o limen.vsix",
    "test": "node test/grammar.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.2.1",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.1.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you have not trusted, the extension does not run the folder's own build of `limen`; highlighting and `limen` from your PATH or user settings still work.",
      "restrictedConfigurations": [
        "limen.path"
      ]
    },
    "virtualWorkspaces": false
  }
}
